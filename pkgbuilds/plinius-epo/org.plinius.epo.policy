<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The switch "Faster GPS Fix" in GNOME Settings > Privacy > Location runs
     pkexec /usr/lib/plinius-epo/plinius-epo-set on|off. Either way only orbit files are
     fetched or removed: no password. -->
<policyconfig>
  <vendor>Plinius</vendor>

  <action id="org.plinius.epo.set">
    <description>Switch the download of GPS orbit predictions</description>
    <message>Authentication is required to change the download of GPS orbit predictions</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/plinius-epo/plinius-epo-set</annotate>
  </action>
</policyconfig>
