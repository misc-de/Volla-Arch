+ * You should have received a copy of the GNU Lesser General Public
+ * License along with vkmark. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "wayland_overlay.h"
+
+#include "log.h"
+
+#include <cairo.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace
+{
+
+char const* const font_family = "sans-serif";
+
+// Logical pixels
+double constexpr status_bar_height = 52.0;
+double constexpr status_pill_height = 28.0;
+double constexpr status_margin = 14.0;
+double constexpr status_font_size = 13.0;
+
+void rounded_rectangle(cairo_t* cr, double x, double y, double w, double h, double r)
+{
+    r = std::min({r, w / 2, h / 2});
+    cairo_new_sub_path(cr);
+    cairo_arc(cr, x + w - r, y + r, r, -M_PI / 2, 0);
+    cairo_arc(cr, x + w - r, y + h - r, r, 0, M_PI / 2);
+    cairo_arc(cr, x + r, y + h - r, r, M_PI / 2, M_PI);
+    cairo_arc(cr, x + r, y + r, r, M_PI, 3 * M_PI / 2);
+    cairo_close_path(cr);
+}
+
+void set_font(cairo_t* cr, double size, bool bold = false)
+{
+    cairo_select_font_face(cr, font_family, CAIRO_FONT_SLANT_NORMAL,
+                           bold ? CAIRO_FONT_WEIGHT_BOLD : CAIRO_FONT_WEIGHT_NORMAL);
+    cairo_set_font_size(cr, size);
+}
+
+double text_width(cairo_t* cr, std::string const& text)
+{
+    cairo_text_extents_t e;
+    cairo_text_extents(cr, text.c_str(), &e);
+    return e.x_advance;
+}
+
+// The text cut to max_width, with an ellipsis where it was cut
+std::string fit_text(cairo_t* cr, std::string text, double max_width)
+{
+    if (text_width(cr, text) <= max_width)
+        return text;
+
+    std::string const ellipsis = "…";
+    while (!text.empty() && text_width(cr, text + ellipsis) > max_width)
+    {
+        // Drop the last character, all bytes of its UTF-8 sequence
+        while ((static_cast<unsigned char>(text.back()) & 0xc0) == 0x80 && text.size() > 1)
+            text.pop_back();
+        text.pop_back();
+    }
+    return text + ellipsis;
+}
+
+// Text whose vertical middle is at y
+void show_text_centered_v(cairo_t* cr, double x, double y, std::string const& text)
+{
+    cairo_font_extents_t fe;
+    cairo_font_extents(cr, &fe);
+    cairo_move_to(cr, x, y + (fe.ascent - fe.descent) / 2);
+    cairo_show_text(cr, text.c_str());
+}
+
+
+// The bar at the bottom: width x height logical pixels
+void paint_status(cairo_t* cr, double width, double height, std::string const& scene,
+                  unsigned int fps, unsigned int index, unsigned int count)
+{
+    char numbers[96];
+    if (fps > 0)
+        snprintf(numbers, sizeof numbers, "  ·  %u fps  ·  %.1f ms  ·  %u/%u",
+                 fps, 1000.0 / fps, index, count);
+    else
+        snprintf(numbers, sizeof numbers, "  ·  – fps  ·  %u/%u", index, count);
+
+    set_font(cr, status_font_size);
+    auto const padding = status_pill_height / 2;
+    auto const max_text = width - 2 * status_margin - 2 * padding;
+    auto const tail = std::string{numbers};
+    auto const head = fit_text(cr, scene, std::max(0.0, max_text - text_width(cr, tail)));
+    auto const text = head + tail;
+
+    auto const pill_w = text_width(cr, text) + 2 * padding;
+    auto const pill_x = (width - pill_w) / 2;
+    auto const pill_y = height - status_margin - status_pill_height;
+
+    rounded_rectangle(cr, pill_x, pill_y, pill_w, status_pill_height, status_pill_height / 2);
+    cairo_set_source_rgba(cr, 0, 0, 0, 0.45);
+    cairo_fill(cr);
+
+    cairo_set_source_rgba(cr, 1, 1, 1, 0.92);
+    show_text_centered_v(cr, pill_x + padding, pill_y + status_pill_height / 2, text);
+}
+
+// The result over the whole window
+void paint_result(cairo_t* cr, double width, double height, unsigned int score,
+                  std::vector<std::pair<std::string, unsigned int>> const& results)
+{
+    cairo_set_source_rgba(cr, 0, 0, 0, 0.6);
+    cairo_paint(cr);
+
+    auto const card_w = std::min(width - 32, 360.0);
+    auto const pad = 24.0;
+    auto const head_h = 28.0 + 18.0 + 68.0 + 20.0;
+    auto const foot_h = 20.0 + 18.0 + 22.0;
+    auto row_h = 22.0;
+    auto const rows = static_cast<double>(results.size());
+    // Rows closer together where the card would not fit
+    if (head_h + rows * row_h + foot_h > height - 32 && rows > 0)
+        row_h = std::max(12.0, (height - 32 - head_h - foot_h) / rows);
+    auto const row_font = std::min(13.0, row_h * 0.62);
+    auto const card_h = std::min(height - 16, head_h + rows * row_h + foot_h);
+    auto const card_x = (width - card_w) / 2;
+    auto const card_y = (height - card_h) / 2;
+
+    rounded_rectangle(cr, card_x, card_y, card_w, card_h, 22);
+    cairo_set_source_rgba(cr, 0.11, 0.11, 0.13, 0.94);
+    cairo_fill(cr);
+
+    auto y = card_y + 28.0;
+
+    set_font(cr, 14);
+    cairo_set_source_rgba(cr, 1, 1, 1, 0.6);
+    std::string const title = "vkmark Score";
+    show_text_centered_v(cr, card_x + (card_w - text_width(cr, title)) / 2, y + 9, title);
+    y += 18;
+
+    set_font(cr, 60, true);
+    auto const score_text = std::to_string(score);
+    cairo_set_source_rgb(cr, 0x17 / 255.0, 0x93 / 255.0, 0xd1 / 255.0);
+    show_text_centered_v(cr, card_x + (card_w - text_width(cr, score_text)) / 2, y + 34, score_text);
+    y += 68 + 10;
+
+    cairo_set_source_rgba(cr, 1, 1, 1, 0.12);
+    cairo_rectangle(cr, card_x + pad, y, card_w - 2 * pad, 1);
+    cairo_fill(cr);
+    y += 10;
+
+    set_font(cr, row_font);
+    for (auto const& r : results)
+    {
+        char fps[32];
+        snprintf(fps, sizeof fps, "%u fps", r.second);
+        auto const fps_w = text_width(cr, fps);
+        auto const name = fit_text(cr, r.first, card_w - 2 * pad - fps_w - 12);
+
+        cairo_set_source_rgba(cr, 1, 1, 1, 0.75);
+        show_text_centered_v(cr, card_x + pad, y + row_h / 2, name);
+        cairo_set_source_rgba(cr, 1, 1, 1, 0.95);
+        show_text_centered_v(cr, card_x + card_w - pad - fps_w, y + row_h / 2, fps);
+        y += row_h;
+    }
+
+    set_font(cr, 12);
+    cairo_set_source_rgba(cr, 1, 1, 1, 0.45);
+    std::string const hint = "Tap to close";
+    show_text_centered_v(cr, card_x + (card_w - text_width(cr, hint)) / 2,
+                         card_y + card_h - 22 - 9, hint);
+}
+
+}
+
+wl_buffer_listener const WaylandOverlay::buffer_listener{
+    WaylandOverlay::handle_buffer_release
+};
+
+WaylandOverlay::WaylandOverlay(
+    wl_compositor* compositor, wl_subcompositor* subcompositor,
+    wl_shm* shm, wp_viewporter* viewporter, wl_surface* parent,
+    int32_t logical_width, int32_t logical_height, double pixel_ratio)
+    : compositor{compositor}, shm{shm}, parent{parent},
+      logical_width{logical_width}, logical_height{logical_height},
+      pixel_ratio{pixel_ratio},
+      surface{wl_compositor_create_surface(compositor)},
+      subsurface{wl_subcompositor_get_subsurface(subcompositor, surface, parent)},
+      viewport{viewporter ? wp_viewporter_get_viewport(viewporter, surface) : nullptr},
+      position_y{0}
+{
+    // Updated on its own, not with the parent's frames
+    wl_subsurface_set_desync(subsurface);
+    wl_subsurface_place_above(subsurface, parent);
+
+    if (!viewport)
+        wl_surface_set_buffer_scale(surface, std::max(1, static_cast<int>(std::lround(pixel_ratio))));
+
+    // Touches go through to the benchmark until the result is shown
+    auto const empty = wl_compositor_create_region(compositor);
+    wl_surface_set_input_region(surface, empty);
+    wl_region_destroy(empty);
+}
+
+WaylandOverlay::~WaylandOverlay()
+{
+    for (auto b : std::set<Buffer*>{buffers})
+        free_buffer(b);
+    if (viewport)
+        wp_viewport_destroy(viewport);
+    wl_subsurface_destroy(subsurface);
+    wl_surface_destroy(surface);
+}
+
+void WaylandOverlay::show_status(
+    std::string const& scene, unsigned int fps, unsigned int index, unsigned int count)
+{
+    draw(static_cast<int32_t>(logical_height - status_bar_height),
+         static_cast<int32_t>(status_bar_height),
+         [&] (cairo_t* cr, double width, double height)
+         { paint_status(cr, width, height, scene, fps, index, count); });
+}
+
+void WaylandOverlay::show_result(
+    unsigned int score, std::vector<std::pair<std::string, unsigned int>> const& results)
+{
+    // The whole window now takes the touch that closes it
+    wl_surface_set_input_region(surface, nullptr);
+
+    draw(0, logical_height,
+         [&] (cairo_t* cr, double width, double height)
+         { paint_result(cr, width, height, score, results); });
+
+    // The position is the parent's state, and the parent shows no more frames
+    wl_surface_commit(parent);
+}
+
+void WaylandOverlay::draw(int32_t y, int32_t height, Painter const& paint)
+{
+    auto const width_px = std::max(1, static_cast<int>(std::ceil(logical_width * pixel_ratio)));
+    auto const height_px = std::max(1, static_cast<int>(std::ceil(height * pixel_ratio)));
+    auto const stride = cairo_format_stride_for_width(CAIRO_FORMAT_ARGB32, width_px);
+    auto const size = static_cast<size_t>(stride) * height_px;
+
+    auto const fd = memfd_create("vkmark-overlay", MFD_CLOEXEC);
+    if (fd < 0 || ftruncate(fd, size) < 0)
+    {
+        if (fd >= 0)
+            close(fd);
+        Log::debug("WaylandOverlay: no shm buffer\n");
+        return;
+    }
+    auto const data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (data == MAP_FAILED)
+    {
+        close(fd);
+        Log::debug("WaylandOverlay: no shm mapping\n");
+        return;
+    }
+
+    auto const cs = cairo_image_surface_create_for_data(
+        static_cast<unsigned char*>(data), CAIRO_FORMAT_ARGB32, width_px, height_px, stride);
+    auto const cr = cairo_create(cs);
+    cairo_scale(cr, static_cast<double>(width_px) / logical_width,
+                static_cast<double>(height_px) / height);
+    paint(cr, logical_width, height);
+    cairo_destroy(cr);
+    cairo_surface_flush(cs);
+    cairo_surface_destroy(cs);
+
+    auto const pool = wl_shm_create_pool(shm, fd, size);
+    auto const buffer = new Buffer{
+        this,
+        wl_shm_pool_create_buffer(pool, 0, width_px, height_px, stride, WL_SHM_FORMAT_ARGB8888),
+        data, size};
+    wl_shm_pool_destroy(pool);
+    close(fd);
+    wl_buffer_add_listener(buffer->buffer, &buffer_listener, buffer);
+    buffers.insert(buffer);
+
+    if (y != position_y)
+    {
+        wl_subsurface_set_position(subsurface, 0, y);
+        position_y = y;
+    }
+    if (viewport)
+        wp_viewport_set_destination(viewport, logical_width, height);
+    wl_surface_attach(surface, buffer->buffer, 0, 0);
+    wl_surface_damage(surface, 0, 0, logical_width, height);
+    wl_surface_commit(surface);
+}
+
+void WaylandOverlay::free_buffer(Buffer* buffer)
+{
+    buffers.erase(buffer);
+    wl_buffer_destroy(buffer->buffer);
+    munmap(buffer->data, buffer->size);
+    delete buffer;
+}
+
+void WaylandOverlay::handle_buffer_release(void* data, wl_buffer* /*buffer*/)
+{
+    auto const b = static_cast<Buffer*>(data);
+    b->overlay->free_buffer(b);
+}
