+void WaylandNativeSystem::show_status(
+    std::string const& scene, unsigned int fps, unsigned int index, unsigned int count)
+{
+#ifdef VKMARK_WAYLAND_OVERLAY
+    if (create_overlay())
+        overlay->show_status(scene, fps, index, count);
+#else
+    (void)scene; (void)fps; (void)index; (void)count;
+#endif
+}
+
+void WaylandNativeSystem::show_result(
+    unsigned int score, std::vector<std::pair<std::string, unsigned int>> const& results)
+{
+#ifdef VKMARK_WAYLAND_OVERLAY
+    if (!create_overlay())
+        return;
+
+    overlay->show_result(score, results);
+    showing_result = true;
+
+    // Until a tap, a click or a key, or the window is closed
+    while (!dismissed && !should_quit_)
+    {
+        if (wl_display_dispatch(display) < 0)
+            break;
+    }
+#else
+    (void)score; (void)results;
+#endif
+}
+
+bool WaylandNativeSystem::create_overlay()
+{
+#ifdef VKMARK_WAYLAND_OVERLAY
+    if (overlay)
+        return true;
+    if (!overlay_requested || overlay_failed)
+        return false;
+
+    if (!subcompositor || !shm || logical_width <= 0 || logical_height <= 0)
+    {
+        Log::warning("Wayland overlay: the compositor lacks wl_subcompositor or wl_shm\n");
+        overlay_failed = true;
+        return false;
+    }
+
+    // Buffer pixels per logical pixel, as the benchmark's
+    auto const pixel_ratio = viewport ?
+        static_cast<double>(vk_extent.width) / logical_width :
+        static_cast<double>(buffer_scale);
+
+    overlay = std::make_unique<WaylandOverlay>(
+        compositor, subcompositor, shm, viewporter, surface,
+        logical_width, logical_height, pixel_ratio);
+    return true;
+#else
+    return false;
+#endif
+}
