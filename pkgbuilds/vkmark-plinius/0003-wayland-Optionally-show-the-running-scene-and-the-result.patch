+// The scene with the options the benchmark set, e.g. "shading phong"
+// (an option named as its scene) or "texture anisotropy=16"
+std::string scene_label(Scene const& scene)
+{
+    std::string label = scene.name();
+
+    for (auto const& kv : scene.options())
+    {
+        if (!kv.second.set || kv.first == "duration")
+            continue;
+        label += " ";
+        if (kv.first != scene.name())
+            label += kv.first + "=";
+        label += kv.second.value;
+    }
+
+    return label;
+}
+
+uint64_t constexpr status_interval_us = 500000;
+
 template <typename T>
 void advance_iter(T& iter, T const& start, T const& end, bool run_forever)
 {
@@ -87,6 +108,14 @@ void MainLoop::run()
 {
     auto const& benchmarks = bc.benchmarks();
 
+    unsigned int scene_count = 0;
+    for (auto const& b : benchmarks)
+    {
+        if (!b->scene().name().empty() && b->scene().is_valid())
+            ++scene_count;
+    }
+    unsigned int scene_index = 0;
+
     for (auto iter = benchmarks.begin();
          iter != benchmarks.end();
          advance_iter(iter, benchmarks.begin(), benchmarks.end(), options.run_forever))
@@ -117,8 +146,16 @@ void MainLoop::run()
 
         bool should_quit = false;
 
+        auto const label = scene_label(scene);
+        // Counting again with --run-forever
+        scene_index = scene_count ? scene_index % scene_count + 1 : scene_index + 1;
+        ws.show_status(label, 0, scene_index, scene_count);
+
         scene.start();
 
+        auto status_time = Util::get_timestamp_us();
+        unsigned int status_frames = 0;
+
         while (scene.is_running() &&
                !(should_quit = ws.should_quit()) &&
                !should_stop)
@@ -126,6 +163,16 @@ void MainLoop::run()
             ws.present_vulkan_image(
                 scene.draw(ws.next_vulkan_image()));
             scene.update();
+
+            ++status_frames;
+            auto const now = Util::get_timestamp_us();
+            if (now - status_time >= status_interval_us)
+            {
+                ws.show_status(label, status_frames * 1000000ull / (now - status_time),
+                               scene_index, scene_count);
+                status_time = now;
+                status_frames = 0;
+            }
         }
 
         auto const scene_fps = scene.average_fps();
@@ -134,6 +181,7 @@ void MainLoop::run()
 
         total_fps += scene_fps;
         ++total_benchmarks;
+        results_.emplace_back(label, scene_fps);
 
         if (should_quit || should_stop)
             break;
@@ -153,3 +201,8 @@ unsigned int MainLoop::score()
 {
     return total_benchmarks == 0 ? 0 : (total_fps / total_benchmarks);
 }
+
+std::vector<std::pair<std::string, unsigned int>> const& MainLoop::results() const
+{
+    return results_;
+}
