+ */
+
+#pragma once
+
+#include "viewporter-client-protocol.h"
+
+#include <wayland-client.h>
+
+#include <functional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+typedef struct _cairo cairo_t;
+
+/*
+ * Text on top of the benchmark: the running scene with its frame rate in a
+ * small bar at the bottom, and the result at the end. It is a sub-surface
+ * with shm buffers drawn by cairo, so the compositor blends it and the
+ * scenes' GPU work stays the same.
+ */
+class WaylandOverlay
+{
+public:
+    // pixel_ratio: buffer pixels per logical pixel, as the parent's
+    WaylandOverlay(wl_compositor* compositor, wl_subcompositor* subcompositor,
+                   wl_shm* shm, wp_viewporter* viewporter, wl_surface* parent,
+                   int32_t logical_width, int32_t logical_height,
+                   double pixel_ratio);
+    ~WaylandOverlay();
+
+    void show_status(std::string const& scene, unsigned int fps,
+                     unsigned int index, unsigned int count);
+    // Covers the whole window, which then takes input to be dismissed
+    void show_result(unsigned int score,
+                     std::vector<std::pair<std::string, unsigned int>> const& results);
+
+private:
+    struct Buffer
+    {
+        WaylandOverlay* overlay;
+        wl_buffer* buffer;
+        void* data;
+        size_t size;
+    };
+
+    using Painter = std::function<void(cairo_t*, double width, double height)>;
+
+    void draw(int32_t y, int32_t height, Painter const& paint);
+    void free_buffer(Buffer* buffer);
+    static void handle_buffer_release(void* data, wl_buffer* buffer);
+    static wl_buffer_listener const buffer_listener;
+
+    wl_compositor* const compositor;
+    wl_shm* const shm;
+    wl_surface* const parent;
+    int32_t const logical_width;
+    int32_t const logical_height;
+    double const pixel_ratio;
+
+    wl_surface* surface;
+    wl_subsurface* subsurface;
+    wp_viewport* viewport;
+    int32_t position_y;
+    std::set<Buffer*> buffers;
+};
