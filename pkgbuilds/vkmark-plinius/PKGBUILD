# Maintainer: misc-de <misc-de@users.noreply.github.com>
# Based on Arch's vkmark (Sven-Hendrik Haase)

pkgname=vkmark-plinius
_pkgname=vkmark
pkgver=2025.01
pkgrel=2
epoch=1
pkgdesc="Vulkan benchmark, filling the screen at a fractional output scale and in portrait, with an on-screen result"
url="https://github.com/vkmark/vkmark"
arch=(aarch64)
license=(LGPL-2.1-only)
depends=(vulkan-icd-loader assimp cairo)
makedepends=(vulkan-headers meson ninja wayland-protocols glm xcb-util-wm xorgproto wayland)
optdepends=(
	'xcb-util-wm: for X11 support'
	'wayland: for Wayland support'
)
provides=("$_pkgname=$epoch:$pkgver")
conflicts=("$_pkgname")
# An update takes vkmark-plinius in place of vkmark by itself (--noconfirm answers a plain
# conflict with no)
replaces=("$_pkgname")
source=(
	"$_pkgname-$pkgver.tar.gz::https://github.com/vkmark/vkmark/archive/refs/tags/$pkgver.tar.gz"
	# Fullscreen took the output mode with wl_output.scale 3 at a fractional scale of 2.27:
	# the image covered 76 % in the top left corner; 800x600 at scale 3 cost the connection
	0001-wayland-Use-the-size-the-compositor-configures.patch
	# In portrait (1080x2400) the horse and the cat were cut off at the sides
	0002-scenes-Fit-the-models-into-portrait-outputs.patch
	# Started from the app grid there is no terminal: the scene and its frame rate at the
	# bottom, the score at the end until a tap (--winsys-options wayland-overlay=true)
	0003-wayland-Optionally-show-the-running-scene-and-the-result.patch
	com.github.vkmark.vkmark.desktop
	com.github.vkmark.vkmark.svg
)
sha256sums=('1ae362844344d0f9878b7a3f13005f77eae705108892a4e8abf237d452d37edc'
            '28a8acea881d7ed5e213aed745daee8179177e39595c2a7e133b446d183ca049'
            '84fa5236a5fa52fe08bdb9069fb9e0662ae6360a56963954c515118fbbd70b2f'
            'bb7a77118a55fe20a41cba9c75982e5f3f6be61b25934827c2ec43be2cb5a47e'
            '03aca9878d7e4c4ff637745c6ec9c0143c0d7e38c42ad1918c74a6dc7a9aca24'
            '08c6b3e6a5180d7970ee6710caf1f58297284f0f32a8f2f50fe2533014bee769')

prepare() {
	cd $_pkgname-$pkgver
	local p
	for p in "$srcdir"/0*.patch; do
		patch -Np1 -i "$p"
	done
}

build() {
	cd $_pkgname-$pkgver
	meson setup --prefix=/usr --buildtype=plain build
	ninja -C build
}

package() {
	cd $_pkgname-$pkgver
	DESTDIR="$pkgdir" ninja -C build install
	# The app id vkmark gives its window, so the overview shows the icon
	install -Dm644 "$srcdir"/com.github.vkmark.vkmark.desktop -t "$pkgdir"/usr/share/applications
	install -Dm644 "$srcdir"/com.github.vkmark.vkmark.svg -t "$pkgdir"/usr/share/icons/hicolor/scalable/apps
}
