[Desktop Entry]
Type=Application
Name=Vulkan Benchmark
Name[de]=Vulkan-Benchmark
Comment=Measure the graphics performance with Vulkan
Comment[de]=Grafikleistung mit Vulkan messen
Exec=vkmark --winsys wayland --fullscreen --winsys-options wayland-overlay=true
