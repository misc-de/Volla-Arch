+++ b/src/meson.build
@@ -126,6 +126,20 @@ if build_wayland_ws
         output: 'xdg-shell-protocol.c',
         )
 
+    viewporter_xml_path = wayland_protocols_dir + '/stable/viewporter/viewporter.xml'
+    viewporter_client_header = custom_target(
+        'viewporter client-header',
+        command: [ wayland_scanner, 'client-header', '@INPUT@', '@OUTPUT@' ],
+        input: viewporter_xml_path,
+        output: 'viewporter-client-protocol.h',
+        )
+    viewporter_private_code = custom_target(
+        'viewporter private-code',
+        command: [ wayland_scanner, 'private-code', '@INPUT@', '@OUTPUT@' ],
+        input: viewporter_xml_path,
+        output: 'viewporter-protocol.c',
+        )
+
     wayland_ws = shared_module(
         'wayland',
         'ws/wayland_window_system_plugin.cpp',
@@ -133,6 +147,8 @@ if build_wayland_ws
         'ws/swapchain_window_system.cpp',
         xdg_shell_client_header,
         xdg_shell_private_code,
+        viewporter_client_header,
+        viewporter_private_code,
         dependencies : [vulkan_dep, wayland_client_dep],
         name_prefix : '',
         install : true,
diff --git a/src/ws/wayland_native_system.cpp b/src/ws/wayland_native_system.cpp
index 1b9809c..431f561 100644
--- a/src/ws/wayland_native_system.cpp
+++ b/src/ws/wayland_native_system.cpp
@@ -24,6 +24,8 @@
 
 #include "vulkan_state.h"
 
