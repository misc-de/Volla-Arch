[Unit]
Description=Android GNSS HAL to NMEA socket for geoclue
# The device package adds After= on the Android container service via drop-in
Before=geoclue.service

[Service]
ExecStart=/usr/bin/gnss-nmea-bridge
RuntimeDirectory=gnss-nmea-bridge
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

# Sandbox (docs/DIENSTE-HAERTEN.md): the bridge only needs the binder device and its socket.
# No root: a system user in the group geoclue, which gets the socket (0660). Android's
# servicemanager and the GNSS HAL accept the caller without root (measured 2026-11-07).
# A static system user, not DynamicUser=: the servicemanager in the Waydroid container
# refuses addService from app UIDs (10000 and above), and dynamic users get 61184 and up.
User=gnss-nmea-bridge
Group=gnss-nmea-bridge
SupplementaryGroups=geoclue
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
PrivateIPC=yes
# PrivateDevices= would hide /dev/binderfs; /dev/binder is a link to it
DevicePolicy=closed
DeviceAllow=/dev/binderfs/binder rw
# GNSS for Android in the Waydroid container
DeviceAllow=/dev/binderfs/anbox-binder rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
