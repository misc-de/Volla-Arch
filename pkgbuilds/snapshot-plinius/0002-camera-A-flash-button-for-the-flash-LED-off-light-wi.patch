diff --git a/src/torch.rs b/src/torch.rs
new file mode 100644
index 0000000..7547b55
--- /dev/null
+++ b/src/torch.rs
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! The phone's flash LED, lit by the camera as a lamp or as a flash.
+//!
+//! The LED is a `leds` class device named like `white:torch` or `*:flash`, the
+//! names Phosh looks for. It is switched through logind's
+//! `Session.SetBrightness`, which the user of the graphical session may call
+//! without further rights; Phosh's torch toggle follows the change.
+use std::cell::Cell;
+
+use gtk::{gio, glib, prelude::*};
+
+const LOGIND: &str = "org.freedesktop.login1";
+const SESSION_PATH: &str = "/org/freedesktop/login1/session/auto";
+const SESSION_IFACE: &str = "org.freedesktop.login1.Session";
+const CALL_TIMEOUT_MS: i32 = 2000;
+
+#[derive(Debug)]
+pub struct Torch {
+    name: String,
+    max_brightness: u32,
+    bus: gio::DBusConnection,
+    /// The brightness last set by us. Starts at 0, so a lamp switched on in
+    /// Phosh before the camera opened stays as it is until the user picks a
+    /// mode here.
+    brightness: Cell<u32>,
+}
+
+impl Torch {
+    /// Finds the first torch LED; `None` on machines without one, where the
+    /// camera shows no flash button.
+    pub fn find() -> Option<Self> {
+        let mut entries: Vec<_> = std::fs::read_dir("/sys/class/leds")
+            .ok()?
+            .flatten()
+            .collect();
+        // read_dir() has no order; pick the same LED on every start
+        entries.sort_by_key(|entry| entry.file_name());
+        let (name, max_brightness) = entries.iter().find_map(|entry| {
+            let name = entry.file_name().into_string().ok()?;
+            if !name.contains(":torch") && !name.contains(":flash") {
+                return None;
+            }
+            let max = std::fs::read_to_string(entry.path().join("max_brightness")).ok()?;
+            let max = max.trim().parse::<u32>().ok().filter(|max| *max > 0)?;
+            Some((name, max))
+        })?;
+
+        let bus = gio::bus_get_sync(gio::BusType::System, gio::Cancellable::NONE)
+            .inspect_err(|err| log::warn!("No system bus for the torch: {err}"))
+            .ok()?;
+
+        log::debug!("Torch LED {name}, {max_brightness} levels");
+        Some(Self {
+            name,
+            max_brightness,
+            bus,
+            brightness: Cell::new(0),
+        })
+    }
+
+    pub fn max_brightness(&self) -> u32 {
+        self.max_brightness
+    }
+
+    fn args(&self, brightness: u32) -> glib::Variant {
+        ("leds", self.name.as_str(), brightness).to_variant()
+    }
+
+    /// Sets the brightness without waiting. The call goes out at once, so
+    /// calls in a row, e.g. while dragging the slider, arrive in order.
+    pub fn set_brightness(&self, brightness: u32) {
+        let brightness = brightness.min(self.max_brightness);
+        if self.brightness.replace(brightness) == brightness {
+            return;
+        }
+
+        self.bus.call(
+            Some(LOGIND),
+            SESSION_PATH,
+            SESSION_IFACE,
+            "SetBrightness",
+            Some(&self.args(brightness)),
+            None,
+            gio::DBusCallFlags::NONE,
+            CALL_TIMEOUT_MS,
+            gio::Cancellable::NONE,
+            move |res| {
+                if let Err(err) = res {
+                    log::warn!("Could not set the torch to {brightness}: {err}");
+                }
+            },
+        );
+    }
+
+    /// Switches a lamp we lit off and waits for it, for when the app quits
+    /// and no main loop runs anymore to send the call.
+    pub fn switch_off_now(&self) {
+        if self.brightness.replace(0) == 0 {
+            return;
+        }
+
+        if let Err(err) = self.bus.call_sync(
+            Some(LOGIND),
+            SESSION_PATH,
+            SESSION_IFACE,
+            "SetBrightness",
+            Some(&self.args(0)),
+            None,
+            gio::DBusCallFlags::NONE,
+            CALL_TIMEOUT_MS,
+            gio::Cancellable::NONE,
+        ) {
+            log::warn!("Could not switch the torch off: {err}");
+        }
+    }
+}
