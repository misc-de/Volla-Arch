diff --git a/src/application.rs b/src/application.rs
index 4e16964..8f5d267 100644
--- a/src/application.rs
+++ b/src/application.rs
@@ -100,6 +100,17 @@ mod imp {
             app.setup_gactions();
             app.setup_accels();
         }
+
+        fn shutdown(&self) {
+            // Quitting (Ctrl+Q) does not close the windows: a lamp lit by
+            // the camera goes out here
+            for window in self.obj().windows() {
+                if let Some(window) = window.downcast_ref::<crate::Window>() {
+                    window.switch_off_light();
+                }
+            }
+            self.parent_shutdown();
+        }
     }
 
     impl GtkApplicationImpl for Application {}
