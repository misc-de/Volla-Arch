diff --git a/src/camera_bridge.rs b/src/camera_bridge.rs
index c7c3239..02e36e0 100644
--- a/src/camera_bridge.rs
+++ b/src/camera_bridge.rs
@@ -5,14 +5,14 @@
 //! offers them as PipeWire nodes named `hal_camera_<id>`. Their stream carries
 //! preview frames, far smaller than what the sensor gives. The bridge takes a
 //! real photo through the HAL on `org.plinius.CameraBridge.TakePicture` and
-//! writes it where asked; it also sets the HAL's scene mode and white balance
-//! for all its cameras.
+//! writes it where asked; it also sets the HAL's scene mode, white balance,
+//! exposure compensation and multi-frame noise reduction for all its cameras.
 use gtk::{gio, glib, prelude::*};
 
 const BRIDGE: &str = "org.plinius.CameraBridge";
 const BRIDGE_PATH: &str = "/org/plinius/CameraBridge";
 const NODE_PREFIX: &str = "hal_camera_";
-/// The HAL needs about 1.4 s for the largest photos
+/// A photo takes up to about 2 s, with noise reduction in the dark
 const PICTURE_TIMEOUT_MS: i32 = 15000;
 const CALL_TIMEOUT_MS: i32 = 2000;
 
@@ -65,7 +65,8 @@ impl CameraBridge {
             .map(|_| ())
     }
 
-    /// Sets a bridge setting (`SceneMode`, `WhiteBalance`) without waiting
+    /// Sets a bridge setting (`SceneMode`, `WhiteBalance`,
+    /// `ExposureCompensation`, `NoiseReduction`) without waiting
     pub fn set(&self, property: &'static str, value: &str) {
         let value = value.to_owned();
         self.bus.call(
diff --git a/src/widgets/camera.rs b/src/widgets/camera.rs
index dd9e250..c7311ff 100644
--- a/src/widgets/camera.rs
+++ b/src/widgets/camera.rs
@@ -705,8 +705,9 @@ impl Camera {
         self.update_flash_button();
     }
 
-    /// Scene mode and white balance of camera-hal-bridge, offered for its
-    /// cameras only and kept in the settings; the bridge forgets them when it
+    /// Scene mode, white balance, exposure and noise reduction of
+    /// camera-hal-bridge, offered for its cameras only and kept in the
+    /// settings; the bridge forgets them when it
     /// restarts, so they go out again with each camera picked
     fn setup_bridge(&self) {
         let imp = self.imp();
@@ -719,6 +720,8 @@ impl Camera {
         let actions = gio::SimpleActionGroup::new();
         actions.add_action(&settings.create_action("scene-mode"));
         actions.add_action(&settings.create_action("white-balance"));
+        actions.add_action(&settings.create_action("exposure-compensation"));
+        actions.add_action(&settings.create_action("noise-reduction"));
         self.insert_action_group("camera", Some(&actions));
 
         settings.connect_changed(
@@ -727,7 +730,10 @@ impl Camera {
                 #[weak(rename_to = obj)]
                 self,
                 move |_, key| {
-                    if key == "scene-mode" || key == "white-balance" {
+                    if matches!(
+                        key,
+                        "scene-mode" | "white-balance" | "exposure-compensation" | "noise-reduction"
+                    ) {
                         obj.send_bridge_settings();
                     }
                 }
@@ -765,6 +771,17 @@ impl Camera {
         if is_bridge_camera {
             bridge.set("SceneMode", &scene);
             bridge.set("WhiteBalance", &settings.string("white-balance"));
+            bridge.set(
+                "ExposureCompensation",
+                &settings.string("exposure-compensation"),
+            );
+            // Auto leaves it to the HAL when several frames help
+            let noise_reduction = if settings.boolean("noise-reduction") {
+                "auto"
+            } else {
+                "off"
+            };
+            bridge.set("NoiseReduction", noise_reduction);
         }
     }
 
