 data/resources/ui/camera.ui            | 34 ++++++++++++++++++++++++++
 po/de.po                               |  8 ++++++
 po/es.po                               |  8 ++++++
 po/fr.po                               |  8 ++++++
 po/it.po                               |  8 ++++++
 po/nl.po                               |  8 ++++++
 po/pl.po                               |  8 ++++++
 po/pt.po                               |  8 ++++++
 po/ru.po                               |  8 ++++++
 src/camera_bridge.rs                   |  9 ++++---
 src/widgets/camera.rs                  | 23 ++++++++++++++---
 12 files changed, 140 insertions(+), 7 deletions(-)

diff --git a/data/org.gnome.Snapshot.gschema.xml.in b/data/org.gnome.Snapshot.gschema.xml.in
index 75969b0..ae8380d 100644
--- a/data/org.gnome.Snapshot.gschema.xml.in
+++ b/data/org.gnome.Snapshot.gschema.xml.in
@@ -99,6 +99,23 @@
       <summary>White balance</summary>
       <description>The camera HAL's white balance, for cameras of camera-hal-bridge</description>
     </key>
+    <key name="exposure-compensation" type="s">
+      <choices>
+        <choice value="-2" />
+        <choice value="-1" />
+        <choice value="0" />
+        <choice value="+1" />
+        <choice value="+2" />
+      </choices>
+      <default>"0"</default>
+      <summary>Exposure compensation</summary>
+      <description>How much brighter or darker than metered pictures come out, in EV, for cameras of camera-hal-bridge</description>
+    </key>
+    <key name="noise-reduction" type="b">
+      <default>true</default>
+      <summary>Noise reduction</summary>
+      <description>Whether the camera HAL may combine several frames into one photo against noise, for cameras of camera-hal-bridge. Slower, and fine detail comes out softer</description>
+    </key>
     <key name="last-camera-id" type="s">
       <default>""</default>
       <summary>Last Camera Used ID</summary>
