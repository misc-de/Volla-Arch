+        /// The shorter side of the camera's format, 0 for the best one; the
+        /// stream starts again with the new format
+        fn set_video_size(&self, value: u32) {
+            let obj = self.obj();
+
+            if value == self.video_size.replace(value) {
+                return;
+            }
+            obj.notify_video_size();
+
+            let Some(camera) = self.camera.borrow().clone() else {
+                return;
+            };
+            if !matches!(obj.state(), ViewfinderState::Ready)
+                || self.is_taking_picture.get()
+                || self.is_recording_video.borrow().is_some()
+            {
+                log::error!("Could not change the video size now, it applies with the next camera");
+                return;
+            }
+            let streaming = obj.is_realized()
+                && matches!(
+                    self.camerabin().current_state(),
+                    gst::State::Playing | gst::State::Paused
+                );
+            if streaming {
+                obj.stop_stream();
+            }
+            if let Err(err) = obj.setup_camera_element(&camera) {
+                log::error!("Could not reconfigure camera element: {err}");
+                self.set_state(ViewfinderState::Error);
+                return;
+            }
+            if streaming {
+                obj.start_stream();
+            }
+        }
+
         fn set_enable_hw_encoding(&self, value: bool) {
             let obj = self.obj();
 
