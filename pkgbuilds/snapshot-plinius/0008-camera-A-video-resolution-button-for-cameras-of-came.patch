index fbe0f06..7d4492c 100644
--- a/aperture/src/camera.rs
+++ b/aperture/src/camera.rs
@@ -151,6 +151,28 @@ impl Camera {
         Ok(element)
     }
 
+    /// The shorter sides of the camera's formats with a fixed size, from the
+    /// smallest: 720 and 1080 for a camera that offers 1280x720 and 1920x1080
+    pub fn short_sides(&self) -> Vec<u32> {
+        self.caps()
+            .map(|caps| utils::caps::short_sides(&caps))
+            .unwrap_or_default()
+    }
+
+    /// The camera's format whose shorter side is `short_side`; the best caps
+    /// when it is 0 or not on offer
+    pub(crate) fn caps_for_size(&self, short_side: u32) -> gst::Caps {
+        if short_side > 0
+            && let Some(caps) = self
+                .caps()
+                .and_then(|caps| utils::caps::with_short_side(&caps, short_side))
+        {
+            log::debug!("Using caps for {short_side}p: {caps:#?}");
+            return caps;
+        }
+        self.best_caps()
+    }
+
     pub(crate) fn best_caps(&self) -> gst::Caps {
         let caps = self
             .caps()
diff --git a/aperture/src/utils.rs b/aperture/src/utils.rs
index 72ab13b..fd4ba4c 100644
--- a/aperture/src/utils.rs
+++ b/aperture/src/utils.rs
@@ -29,6 +29,38 @@ pub(crate) mod caps {
         caps.intersect_with_mode(&crate::SUPPORTED_CAPS, gst::CapsIntersectMode::First)
     }
 
+    /// The fixed size of a structure, if it has one
+    fn fixed_size(structure: &gst::StructureRef) -> Option<(i32, i32)> {
+        Some((
+            structure.get::<i32>("width").ok()?,
+            structure.get::<i32>("height").ok()?,
+        ))
+    }
+
+    /// The first format whose shorter side is `short_side` (720 for 1280x720
+    /// either way round), if there is one
+    pub(crate) fn with_short_side(caps: &gst::Caps, short_side: u32) -> Option<gst::Caps> {
+        let structure = caps.iter().find(|s| {
+            fixed_size(s).is_some_and(|(w, h)| u32::try_from(w.min(h)) == Ok(short_side))
+        })?;
+        let mut found = gst::Caps::new_empty();
+        found.get_mut()?.append_structure(structure.to_owned());
+        Some(found)
+    }
+
+    /// The shorter sides of the formats with a fixed size, from the smallest,
+    /// each once
+    pub(crate) fn short_sides(caps: &gst::Caps) -> Vec<u32> {
+        let mut sides: Vec<u32> = caps
+            .iter()
+            .filter_map(fixed_size)
+            .filter_map(|(w, h)| u32::try_from(w.min(h)).ok())
+            .collect();
+        sides.sort_unstable();
+        sides.dedup();
+        sides
+    }
+
     pub(crate) fn best_mode(caps: &gst::Caps) -> Option<Size> {
         const MIN_WIDTH: i32 = 640;
         const MIN_HEIGHT: i32 = 480;
