+
+    /// The video resolutions on offer, as shorter sides from the smallest:
+    /// those of the camera's formats, for cameras of camera-hal-bridge only
+    /// (others keep the format they choose themselves). 4K only with the
+    /// hardware encoder: software encoding cannot keep up with it.
+    fn video_resolutions(&self) -> Vec<u32> {
+        let Some(camera) = self.imp().viewfinder.camera() else {
+            return Vec::new();
+        };
+        if CameraBridge::node(&camera).is_none() {
+            return Vec::new();
+        }
+        let hardware = gst::ElementFactory::find("pliniush264enc").is_some();
+        camera
+            .short_sides()
+            .into_iter()
+            .filter(|&side| side <= 1080 || hardware)
+            .collect()
+    }
+
+    /// The resolution videos get: the chosen one, else the largest smaller
+    /// one on offer, else the smallest; 0 without a choice
+    fn video_resolution(&self, sizes: &[u32]) -> u32 {
+        let wanted = self.imp().settings().uint("video-resolution");
+        sizes
+            .iter()
+            .rev()
+            .find(|&&side| side <= wanted)
+            .or(sizes.first())
+            .copied()
+            .unwrap_or(0)
+    }
+
+    /// In video mode the stream takes the format of the video resolution, the
+    /// button beside the scene button shows it; photos come from the HAL at
+    /// full size anyway, so the stream keeps the camera's default for them
+    fn update_video_resolution(&self) {
+        let imp = self.imp();
+        let sizes = self.video_resolutions();
+        let side = self.video_resolution(&sizes);
+        let video = matches!(self.capture_mode(), crate::CaptureMode::Video);
+        imp.resolution_button.set_visible(video && sizes.len() > 1);
+        imp.resolution_button.set_label(&resolution_label(side));
+        imp.resolution_button
+            .set_sensitive(!imp.viewfinder.is_recording());
+        imp.viewfinder.set_video_size(if video { side } else { 0 });
+    }
+
+    /// The button goes on to the next resolution on offer, after the largest
+    /// back to the smallest
+    fn next_video_resolution(&self) {
+        let sizes = self.video_resolutions();
+        let current = self.video_resolution(&sizes);
+        let next = sizes
+            .iter()
+            .find(|&&side| side > current)
+            .or(sizes.first())
+            .copied();
+        if let Some(next) = next {
+            self.imp()
+                .settings()
+                .set_uint("video-resolution", next)
+                .unwrap();
+        }
     }
 
     fn send_bridge_settings(&self) {
@@ -1000,3 +1084,11 @@ async fn stream() -> anyhow::Result<OwnedFd> {
 fn id_from_pw(camera: &aperture::Camera) -> glib::GString {
     camera.display_name()
 }
+
+/// 720p, 1080p, and 4K for 2160
+fn resolution_label(short_side: u32) -> String {
+    match short_side {
+        2160 => "4K".to_string(),
+        side => format!("{side}p"),
+    }
+}
