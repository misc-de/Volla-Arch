new file mode 100644
index 0000000..c7c3239
--- /dev/null
+++ b/src/camera_bridge.rs
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Real photos and scene settings for cameras of camera-hal-bridge.
+//!
+//! On phones whose cameras come from an Android camera HAL, camera-hal-bridge
+//! offers them as PipeWire nodes named `hal_camera_<id>`. Their stream carries
+//! preview frames, far smaller than what the sensor gives. The bridge takes a
+//! real photo through the HAL on `org.plinius.CameraBridge.TakePicture` and
+//! writes it where asked; it also sets the HAL's scene mode and white balance
+//! for all its cameras.
+use gtk::{gio, glib, prelude::*};
+
+const BRIDGE: &str = "org.plinius.CameraBridge";
+const BRIDGE_PATH: &str = "/org/plinius/CameraBridge";
+const NODE_PREFIX: &str = "hal_camera_";
+/// The HAL needs about 1.4 s for the largest photos
+const PICTURE_TIMEOUT_MS: i32 = 15000;
+const CALL_TIMEOUT_MS: i32 = 2000;
+
+#[derive(Debug)]
+pub struct CameraBridge {
+    bus: gio::DBusConnection,
+}
+
+impl CameraBridge {
+    /// Connects to the session bus; `None` without one. Whether the bridge
+    /// runs shows only once it is called.
+    pub fn new() -> Option<Self> {
+        let bus = gio::bus_get_sync(gio::BusType::Session, gio::Cancellable::NONE)
+            .inspect_err(|err| log::warn!("No session bus for the camera bridge: {err}"))
+            .ok()?;
+        Some(Self { bus })
+    }
+
+    /// The bridge's node name of `camera`, if it is one of its cameras
+    pub fn node(camera: &aperture::Camera) -> Option<String> {
+        camera
+            .properties()
+            .get("node.name")
+            .and_then(|value| value.get::<String>().ok())
+            .filter(|name| name.starts_with(NODE_PREFIX))
+    }
+
+    /// Takes a photo with the streaming camera `node` as a JPEG at `path`;
+    /// returns once the file is written
+    pub async fn take_picture(
+        &self,
+        node: &str,
+        path: &std::path::Path,
+    ) -> Result<(), glib::Error> {
+        let path = path.to_str().ok_or_else(|| {
+            glib::Error::new(gio::IOErrorEnum::InvalidFilename, "path is not UTF-8")
+        })?;
+        self.bus
+            .call_future(
+                Some(BRIDGE),
+                BRIDGE_PATH,
+                BRIDGE,
+                "TakePicture",
+                Some(&(node, path).to_variant()),
+                None,
+                gio::DBusCallFlags::NONE,
+                PICTURE_TIMEOUT_MS,
+            )
+            .await
+            .map(|_| ())
+    }
+
+    /// Sets a bridge setting (`SceneMode`, `WhiteBalance`) without waiting
+    pub fn set(&self, property: &'static str, value: &str) {
+        let value = value.to_owned();
+        self.bus.call(
+            Some(BRIDGE),
+            BRIDGE_PATH,
+            "org.freedesktop.DBus.Properties",
+            "Set",
+            Some(&(BRIDGE, property, value.to_variant()).to_variant()),
+            None,
+            gio::DBusCallFlags::NO_AUTO_START,
+            CALL_TIMEOUT_MS,
+            gio::Cancellable::NONE,
+            move |res| {
+                if let Err(err) = res {
+                    log::warn!("Could not set the camera bridge's {property} to {value}: {err}");
+                }
+            },
+        );
+    }
+}
