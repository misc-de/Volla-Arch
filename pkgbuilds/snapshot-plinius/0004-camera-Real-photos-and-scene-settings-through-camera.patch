+    /// Scene mode and white balance of camera-hal-bridge, offered for its
+    /// cameras only and kept in the settings; the bridge forgets them when it
+    /// restarts, so they go out again with each camera picked
+    fn setup_bridge(&self) {
+        let imp = self.imp();
+        let Some(bridge) = CameraBridge::new() else {
+            return;
+        };
+        imp.bridge.set(bridge).unwrap();
+
+        let settings = imp.settings();
+        let actions = gio::SimpleActionGroup::new();
+        actions.add_action(&settings.create_action("scene-mode"));
+        actions.add_action(&settings.create_action("white-balance"));
+        self.insert_action_group("camera", Some(&actions));
+
+        settings.connect_changed(
+            None,
+            glib::clone!(
+                #[weak(rename_to = obj)]
+                self,
+                move |_, key| {
+                    if key == "scene-mode" || key == "white-balance" {
+                        obj.send_bridge_settings();
+                    }
+                }
+            ),
+        );
+        imp.viewfinder.connect_camera_notify(glib::clone!(
+            #[weak(rename_to = obj)]
+            self,
+            move |_| {
+                obj.send_bridge_settings();
+            }
+        ));
+        self.send_bridge_settings();
+    }
+
+    fn send_bridge_settings(&self) {
+        let imp = self.imp();
+        let Some(bridge) = imp.bridge.get() else {
+            return;
+        };
+        let settings = imp.settings();
+        let scene = settings.string("scene-mode");
+        let is_bridge_camera = imp
+            .viewfinder
+            .camera()
+            .as_ref()
+            .and_then(CameraBridge::node)
+            .is_some();
+        imp.scene_button.set_visible(is_bridge_camera);
+        imp.scene_button.set_icon_name(match scene.as_str() {
+            "hdr" => "camera-hdr-symbolic",
+            "night" => "weather-clear-night-symbolic",
+            _ => "camera-scene-symbolic",
+        });
+        if is_bridge_camera {
+            bridge.set("SceneMode", &scene);
+            bridge.set("WhiteBalance", &settings.string("white-balance"));
+        }
+    }
