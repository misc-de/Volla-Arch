# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-sar
pkgver=0.1
pkgrel=11
pkgdesc="SAR back-off: lowers the modem's transmit power while a body is near (MTK sensor hub to mtkradioex)"
arch=(aarch64 x86_64)
license=(MIT)
depends=(glib2 libgbinder)
backup=(etc/plinius-sar.conf)
source=(plinius-sar.c
	plinius-sar.service
	plinius-sar.conf
	LICENSE)
sha256sums=('50d606021e026330885d2a894d57a56cacb1a3318d17d056de752834ccf90ab9'
	'b3672fe02d0ec8c2922bcf33e000643d8150355c3ebddc63caa1ef0cef93011d'
	'd796379262a39f4ec33a37d96ba68c239132c455e12d363c4b1c63f27c4ea504'
	'1f18c6c362e3c14577e914c06d551c588720f91959e6aa99a121b86863ffd076')

build() {
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o plinius-sar plinius-sar.c $(pkg-config --cflags --libs gio-2.0 libgbinder) $LDFLAGS
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 plinius-sar -t "$pkgdir/usr/bin"
	install -Dm644 plinius-sar.conf "$pkgdir/etc/plinius-sar.conf"
	install -Dm644 plinius-sar.service -t "$pkgdir/usr/lib/systemd/system"
	# On from the start, without a session: the limit must hold whenever the modem transmits
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-sar.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
}
