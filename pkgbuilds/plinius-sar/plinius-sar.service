[Unit]
Description=SAR: lower the modem's transmit power while a body is near
# The radio extension lives in the Android container; the daemon waits for it anyway
After=lxc-android-config.service

[Service]
ExecStart=/usr/bin/plinius-sar
Restart=on-failure
RestartSec=5
# Reads the sensor hub (/dev/hf_manager) and talks to the vendor RIL over binder
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/binder rw
# By its driver, not its path: the container's ueventd creates the node after this unit starts,
# and a path that does not exist yet is left out of the device policy. The first open then
# failed with EPERM instead of ENOENT, past the daemon's wait for the node (measured 2026-11-14).
DeviceAllow=char-hf_manager rw
# More sandbox (docs/DIENSTE-HAERTEN.md): no capabilities
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
PrivateIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
