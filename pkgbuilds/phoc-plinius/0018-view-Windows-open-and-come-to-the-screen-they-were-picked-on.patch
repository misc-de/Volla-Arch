diff --git a/src/view.c b/src/view.c
index 3f6c180..fb87122 100644
--- a/src/view.c
+++ b/src/view.c
@@ -276,6 +276,46 @@ handle_toplevel_handle_request_maximize (struct wl_listener *listener, void *dat
 }
 
 
+/*
+ * The output where the seat's last button press or touch began. A touch
+ * does not move the cursor, so with a phone and a second screen this, not
+ * the cursor, tells which screen the user is on.
+ */
+static PhocOutput *
+view_output_of_last_press (PhocSeat *seat)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+
+  if (seat == NULL || !seat->has_last_press)
+    return NULL;
+
+  return phoc_desktop_layout_get_output (desktop, seat->last_press_lx, seat->last_press_ly);
+}
+
+/*
+ * A task bar on one screen or the overview on another activates a window
+ * through foreign-toplevel: the window comes to the screen where the
+ * click or the tap for that happened.
+ */
+static void
+view_move_to_output_of_last_press (PhocView *self, PhocSeat *seat)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  PhocOutput *target, *current;
+
+  if (wl_list_length (&desktop->outputs) < 2)
+    return;
+
+  target = view_output_of_last_press (seat);
+  current = phoc_view_get_output (self);
+  if (target == NULL || target == current)
+    return;
+
+  g_debug ("Moving activated view %p to %s", self, phoc_output_get_name (target));
+  phoc_view_move_to_output (self, target);
+}
+
+
 static void
 handle_toplevel_handle_request_activate (struct wl_listener *listener, void *data)
 {
@@ -288,8 +328,11 @@ handle_toplevel_handle_request_activate (struct wl_listener *listener, void *dat
     PhocSeat *seat = PHOC_SEAT (elem->data);
 
     g_assert (PHOC_IS_SEAT (seat));
-    if (event->seat == seat->seat)
-      phoc_seat_set_focus_view (seat, self);
+    if (event->seat != seat->seat)
+      continue;
+
+    view_move_to_output_of_last_press (self, seat);
+    phoc_seat_set_focus_view (seat, self);
   }
 }
 
@@ -1127,11 +1170,8 @@ phoc_view_move_to_next_output (PhocView *self, enum wlr_direction direction)
 {
   PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
   struct wlr_output_layout *layout = desktop->layout;
-  const struct wlr_output_layout_output *l_output;
   PhocOutput *output;
   struct wlr_output *new_output;
-  struct wlr_box usable_area;
-  double x, y;
 
   output = phoc_view_get_output (self);
   if (!output)
@@ -1143,9 +1183,35 @@ phoc_view_move_to_next_output (PhocView *self, enum wlr_direction direction)
   if (!new_output)
     return false;
 
-  output = PHOC_OUTPUT (new_output->data);
+  phoc_view_move_to_output (self, PHOC_OUTPUT (new_output->data));
+  return true;
+}
+
+/**
+ * phoc_view_move_to_output:
+ * @self: The view
+ * @output: The output to move the view to
+ *
+ * Moves the view to the given output: a floating view is centered on it,
+ * a maximized, tiled or fullscreen view takes that state on the new output.
+ */
+void
+phoc_view_move_to_output (PhocView *self, PhocOutput *output)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+  const struct wlr_output_layout_output *l_output;
+  struct wlr_output *new_output;
+  struct wlr_box usable_area;
+  double x, y;
+
+  g_assert (PHOC_IS_VIEW (self));
+  g_assert (PHOC_IS_OUTPUT (output));
+
+  new_output = output->wlr_output;
   usable_area = output->usable_area;
   l_output = wlr_output_layout_get (desktop->layout, new_output);
+  if (!l_output)
+    return;
 
   /* Update saved position to the new output */
   x = usable_area.x + l_output->x + usable_area.width / 2 - self->saved.width / 2;
@@ -1155,12 +1221,11 @@ phoc_view_move_to_next_output (PhocView *self, enum wlr_direction direction)
   self->saved.y = y;
 
   if (phoc_view_is_fullscreen (self)) {
-    phoc_view_set_fullscreen (self, true, PHOC_OUTPUT (new_output->data));
-    return true;
+    phoc_view_set_fullscreen (self, true, output);
+    return;
   }
 
   phoc_view_arrange (self, output, TRUE);
-  return true;
 }
 
 
@@ -1272,6 +1337,10 @@ view_center (PhocView *self, PhocOutput *output)
     return false;
   cursor = phoc_seat_get_cursor (seat);
 
+  /* Where the user last clicked or tapped, then where the cursor is */
+  if (!output)
+    output = view_output_of_last_press (seat);
+
   if (!output) {
     struct wlr_output *wlr_output = wlr_output_layout_output_at (desktop->layout,
                                                                  cursor->cursor->x,
@@ -1536,6 +1605,34 @@ phoc_view_set_initial_focus (PhocView *self)
   phoc_seat_set_focus_view (seat, self);
 }
 
+/*
+ * A new window opens on the screen where the user last clicked or tapped,
+ * a dialog on the one of its parent. That also holds for a window that is
+ * maximized or fullscreen from the start (e.g. Firefox restoring its
+ * state), which would otherwise stay where it was created.
+ */
+static void
+view_place_initially (PhocView *self)
+{
+  PhocInput *input = phoc_server_get_input (phoc_server_get_default ());
+  PhocOutput *target = NULL;
+
+  if (self->parent)
+    target = phoc_view_get_output (self->parent);
+
+  if (phoc_view_is_floating (self)) {
+    view_center (self, target);
+    return;
+  }
+
+  if (!target)
+    target = view_output_of_last_press (phoc_input_get_last_active_seat (input));
+
+  if (target && target != phoc_view_get_output (self))
+    phoc_view_move_to_output (self, target);
+}
+
+
 /**
  * phoc_view_setup:
  * @self: The view to setup
@@ -1552,7 +1649,7 @@ phoc_view_setup (PhocView *self)
   view_create_foreign_toplevel_handle (self);
   phoc_view_set_initial_focus (self);
 
-  view_center (self, NULL);
+  view_place_initially (self);
   view_update_scale (self);
 
   view_update_output (self, NULL);
