diff --git a/src/seat.h b/src/seat.h
index db9d405..2f9c7c1 100644
--- a/src/seat.h
+++ b/src/seat.h
@@ -46,6 +46,10 @@ typedef struct _PhocSeat {
   int32_t                         touch_id;
