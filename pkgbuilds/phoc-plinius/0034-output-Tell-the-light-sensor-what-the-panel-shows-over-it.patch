@@ -0,0 +1,67 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include <glib.h>
+#include <pixman.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/util/box.h>
+
+G_BEGIN_DECLS
+
+#define PHOC_LIGHT_SENSOR_MAX_CELLS 64
+/* In the runtime directory */
+#define PHOC_LIGHT_SENSOR_FILE "plinius-als-color"
+
+/**
+ * PhocLightSensorConfig:
+ * @box: The part of the screen the light sensor behind the panel sees, in buffer pixels
+ * @cols: Columns of the grid @box is split into
+ * @rows: Rows of that grid
+ * @weights: How much each cell of the grid counts, row by row
+ * @gain: The colour value the sensor's firmware wants for a full white, over 255
+ *
+ * A light sensor behind an OLED panel sees the panel's own light too. Its firmware takes that
+ * off when it knows the brightness and the colour of what the panel shows over it.
+ */
+typedef struct _PhocLightSensorConfig {
+  struct wlr_box box;
+  guint          cols, rows;
+  float          weights[PHOC_LIGHT_SENSOR_MAX_CELLS];
+  float          gain;
+} PhocLightSensorConfig;
+
+typedef struct _PhocLightSensor PhocLightSensor;
+typedef struct _PhocOutput PhocOutput;
+
+void             phoc_light_sensor_config_init          (PhocLightSensorConfig *config);
+gboolean         phoc_light_sensor_config_parse_box     (PhocLightSensorConfig *config,
+                                                         const char            *value);
+gboolean         phoc_light_sensor_config_parse_weights (PhocLightSensorConfig *config,
+                                                         const char            *value);
+gboolean         phoc_light_sensor_config_parse_gain    (PhocLightSensorConfig *config,
+                                                         const char            *value);
+
+gboolean         phoc_light_sensor_color_from_pixels    (const PhocLightSensorConfig *config,
+                                                         const guint8          *pixels,
+                                                         guint32                format,
+                                                         int                    stride,
+                                                         int                    color[3]);
+
+PhocLightSensor *phoc_light_sensor_new                  (PhocOutput            *output,
+                                                         const PhocLightSensorConfig *config,
+                                                         const char            *path);
+void             phoc_light_sensor_free                 (PhocLightSensor       *self);
+void             phoc_light_sensor_damage               (PhocLightSensor       *self,
+                                                         const pixman_region32_t *damage);
+void             phoc_light_sensor_rendered             (PhocLightSensor       *self,
+                                                         struct wlr_buffer     *buffer);
+void             phoc_light_sensor_publish              (PhocLightSensor       *self,
+                                                         const int              color[3]);
+void             phoc_light_sensor_forget               (PhocLightSensor       *self);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (PhocLightSensor, phoc_light_sensor_free)
+
+G_END_DECLS
