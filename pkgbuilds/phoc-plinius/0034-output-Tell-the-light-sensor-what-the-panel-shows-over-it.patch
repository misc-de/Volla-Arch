diff --git a/src/light-sensor.c b/src/light-sensor.c
new file mode 100644
index 00000000..b6a01ac6
--- /dev/null
+++ b/src/light-sensor.c
@@ -0,0 +1,445 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+/*
+ * Plinius: the light sensor behind the panel sees the panel's own light. Its firmware takes the
+ * panel's light off, from the brightness and from the colour shown over the sensor; under
+ * Android the system tells it that colour. Without it a white page read as a brighter room and
+ * a black one as a darker room, and auto brightness followed the picture.
+ *
+ * After a frame whose damage touches the sensor's part of the screen, this reads that part back
+ * (at most four times a second) and averages it the way the sensor does: in linear light, each
+ * cell of a grid weighted by how much the sensor sees of it. The colour goes to a file in the
+ * runtime directory; a service of the device writes it to the driver.
+ */
+
+#define G_LOG_DOMAIN "phoc-light-sensor"
+
+#include "phoc-config.h"
+
+#include "light-sensor.h"
+#include "output.h"
+
+#include <drm_fourcc.h>
+#include <errno.h>
+#include <glib/gstdio.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wlr/render/wlr_renderer.h>
+#include <wlr/render/wlr_texture.h>
+
+/* At most this often: the sensor's firmware takes about half a second itself (measured) */
+#define LIGHT_SENSOR_INTERVAL_MS 250
+/* sRGB is close enough: the firmware's own correction follows (c/255)^2.2 (measured) */
+#define LIGHT_SENSOR_GAMMA 2.2
+
+struct _PhocLightSensor {
+  PhocOutput           *output; /* (unowned): owns this */
+  PhocLightSensorConfig config;
+  char                 *path;
+  guint8               *pixels;
+
+  gint64                last_us;
+  gboolean              dirty;
+  guint                 timeout_id;
+  int                   color[3]; /* last published, -1: none */
+  gboolean              warned;
+};
+
+
+void
+phoc_light_sensor_config_init (PhocLightSensorConfig *config)
+{
+  *config = (PhocLightSensorConfig) {
+    .cols = 1,
+    .rows = 1,
+    .weights = { 1.0 },
+    .gain = 1.0,
+  };
+}
+
+/**
+ * phoc_light_sensor_config_parse_box:
+ * @config: The config
+ * @value: `x,y,width,height` in buffer pixels
+ *
+ * Returns: Whether @value was a box
+ */
+gboolean
+phoc_light_sensor_config_parse_box (PhocLightSensorConfig *config, const char *value)
+{
+  g_auto (GStrv) parts = g_strsplit (value, ",", -1);
+  int v[4];
+
+  if (g_strv_length (parts) != 4)
+    return FALSE;
+
+  for (int i = 0; i < 4; i++) {
+    char *end;
+    long n = strtol (parts[i], &end, 10);
+
+    while (g_ascii_isspace (*end))
+      end++;
+    if (end == parts[i] || *end || n < 0 || n > G_MAXINT16)
+      return FALSE;
+    v[i] = n;
+  }
+  if (v[2] == 0 || v[3] == 0)
+    return FALSE;
+
+  config->box = (struct wlr_box) { .x = v[0], .y = v[1], .width = v[2], .height = v[3] };
+  return TRUE;
+}
+
+/**
+ * phoc_light_sensor_config_parse_weights:
+ * @config: The config
+ * @value: The weights of the cells, a row's cells separated by `,`, the rows by `;`
+ *
+ * Every row needs the same number of cells. The weights need not add up to anything.
+ *
+ * Returns: Whether @value was a grid of weights
+ */
+gboolean
+phoc_light_sensor_config_parse_weights (PhocLightSensorConfig *config, const char *value)
+{
+  g_auto (GStrv) rows = g_strsplit (value, ";", -1);
+  float weights[PHOC_LIGHT_SENSOR_MAX_CELLS];
+  guint n_rows = g_strv_length (rows), n_cols = 0, n = 0;
+  float sum = 0;
+
+  if (n_rows == 0)
+    return FALSE;
+
+  for (guint r = 0; r < n_rows; r++) {
+    g_auto (GStrv) cells = g_strsplit (rows[r], ",", -1);
+    guint len = g_strv_length (cells);
+
+    if (r == 0)
+      n_cols = len;
+    if (len == 0 || len != n_cols || n + len > PHOC_LIGHT_SENSOR_MAX_CELLS)
+      return FALSE;
+
+    for (guint c = 0; c < len; c++) {
+      char *end;
+      double w = g_ascii_strtod (cells[c], &end);
+
+      while (g_ascii_isspace (*end))
+        end++;
+      if (end == cells[c] || *end || !isfinite (w) || w < 0)
+        return FALSE;
+      weights[n++] = w;
+      sum += w;
+    }
+  }
+  if (sum <= 0)
+    return FALSE;
+
+  config->cols = n_cols;
+  config->rows = n_rows;
+  for (guint i = 0; i < n; i++)
+    config->weights[i] = weights[i] / sum;
+  return TRUE;
+}
+
+/**
+ * phoc_light_sensor_config_parse_gain:
+ * @config: The config
+ * @value: The colour value for a full white over 255, more than 0 and at most 1
+ *
+ * Returns: Whether @value was a gain
+ */
+gboolean
+phoc_light_sensor_config_parse_gain (PhocLightSensorConfig *config, const char *value)
+{
+  char *end;
+  double gain = g_ascii_strtod (value, &end);
+
+  while (g_ascii_isspace (*end))
+    end++;
+  if (end == value || *end || !isfinite (gain) || gain <= 0 || gain > 1)
+    return FALSE;
+
+  config->gain = gain;
+  return TRUE;
+}
+
+
+static const float *
+get_linear_table (void)
+{
+  static float table[256];
+  static gsize done;
+
+  if (g_once_init_enter (&done)) {
+    for (int i = 0; i < 256; i++)
+      table[i] = pow (i / 255.0, LIGHT_SENSOR_GAMMA);
+    g_once_init_leave (&done, 1);
+  }
+  return table;
+}
+
+/**
+ * phoc_light_sensor_color_from_pixels:
+ * @config: The sensor
+ * @pixels: The pixels of the sensor's box
+ * @format: Their format: DRM_FORMAT_[AX]RGB8888 or DRM_FORMAT_[AX]BGR8888
+ * @stride: Bytes from one row to the next
+ * @color:(out): The colour for the sensor's firmware, red, green and blue, each 0 to 255
+ *
+ * Returns: Whether @format is one of those
+ */
+gboolean
+phoc_light_sensor_color_from_pixels (const PhocLightSensorConfig *config,
+                                     const guint8                *pixels,
+                                     guint32                      format,
+                                     int                          stride,
+                                     int                          color[3])
+{
+  const float *linear = get_linear_table ();
+  const int width = config->box.width, height = config->box.height;
+  double sums[PHOC_LIGHT_SENSOR_MAX_CELLS][3] = { 0 };
+  guint counts[PHOC_LIGHT_SENSOR_MAX_CELLS] = { 0 };
+  double light[3] = { 0 }, weight = 0;
+  int r, g, b;
+
+  switch (format) {
+  case DRM_FORMAT_ARGB8888:
+  case DRM_FORMAT_XRGB8888:
+    /* Little endian: blue first */
+    r = 2, g = 1, b = 0;
+    break;
+  case DRM_FORMAT_ABGR8888:
+  case DRM_FORMAT_XBGR8888:
+    r = 0, g = 1, b = 2;
+    break;
+  default:
+    return FALSE;
+  }
+
+  for (int y = 0; y < height; y++) {
+    const guint8 *row = pixels + (gsize)y * stride;
+    guint cell_row = (guint)y * config->rows / height;
+
+    for (int x = 0; x < width; x++) {
+      const guint8 *p = row + x * 4;
+      guint cell = cell_row * config->cols + (guint)x * config->cols / width;
+
+      sums[cell][0] += linear[p[r]];
+      sums[cell][1] += linear[p[g]];
+      sums[cell][2] += linear[p[b]];
+      counts[cell]++;
+    }
+  }
+
+  /* A cell smaller than a pixel has none: the others count for it */
+  for (guint i = 0; i < config->cols * config->rows; i++) {
+    if (!counts[i])
+      continue;
+    for (int ch = 0; ch < 3; ch++)
+      light[ch] += config->weights[i] * sums[i][ch] / counts[i];
+    weight += config->weights[i];
+  }
+
+  for (int ch = 0; ch < 3; ch++) {
+    double l = weight > 0 ? light[ch] / weight : 0;
+
+    color[ch] = CLAMP (lround (config->gain * 255.0 * pow (l, 1 / LIGHT_SENSOR_GAMMA)), 0, 255);
+  }
+  return TRUE;
+}
+
+
+/**
+ * phoc_light_sensor_new:
+ * @output: The output whose panel the sensor is behind
+ * @config: The sensor
+ * @path: Where the colour goes
+ *
+ * Returns: (transfer full): The sensor
+ */
+PhocLightSensor *
+phoc_light_sensor_new (PhocOutput *output, const PhocLightSensorConfig *config, const char *path)
+{
+  PhocLightSensor *self = g_new0 (PhocLightSensor, 1);
+
+  self->output = output;
+  self->config = *config;
+  self->path = g_strdup (path);
+  self->pixels = g_malloc ((gsize)config->box.width * config->box.height * 4);
+  self->color[0] = self->color[1] = self->color[2] = -1;
+  /* The first frame tells it */
+  self->dirty = TRUE;
+
+  return self;
+}
+
+
+void
+phoc_light_sensor_free (PhocLightSensor *self)
+{
+  g_clear_handle_id (&self->timeout_id, g_source_remove);
+  /* Nobody tells the colour any more: the device's default applies again */
+  phoc_light_sensor_forget (self);
+  g_free (self->path);
+  g_free (self->pixels);
+  g_free (self);
+}
+
+/**
+ * phoc_light_sensor_damage:
+ * @self: The sensor
+ * @damage: The damage of the frame about to be drawn, in buffer pixels
+ *
+ * Notes whether the frame changes what the sensor sees.
+ */
+void
+phoc_light_sensor_damage (PhocLightSensor *self, const pixman_region32_t *damage)
+{
+  pixman_box32_t box = {
+    .x1 = self->config.box.x,
+    .y1 = self->config.box.y,
+    .x2 = self->config.box.x + self->config.box.width,
+    .y2 = self->config.box.y + self->config.box.height,
+  };
+
+  if (pixman_region32_contains_rectangle ((pixman_region32_t *)damage, &box) != PIXMAN_REGION_OUT)
+    self->dirty = TRUE;
+}
+
+
+static gboolean
+on_interval_over (gpointer data)
+{
+  PhocLightSensor *self = data;
+
+  self->timeout_id = 0;
+  /* Draws the sensor's part again, the frame then reads it */
+  phoc_output_damage_buffer_box (self->output, &self->config.box);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+warn_once (PhocLightSensor *self, const char *what)
+{
+  if (self->warned)
+    return;
+
+  g_warning ("Light sensor: %s", what);
+  self->warned = TRUE;
+}
+
+/**
+ * phoc_light_sensor_rendered:
+ * @self: The sensor
+ * @buffer: The frame just drawn, before it goes out
+ *
+ * Reads what the sensor sees from @buffer if that changed and it is time.
+ */
+void
+phoc_light_sensor_rendered (PhocLightSensor *self, struct wlr_buffer *buffer)
+{
+  struct wlr_renderer *renderer = self->output->wlr_output->renderer;
+  const struct wlr_box *box = &self->config.box;
+  struct wlr_texture *texture;
+  guint32 format;
+  gint64 now, wait_ms;
+  int color[3];
+  gboolean ok;
+
+  if (!self->dirty)
+    return;
+
+  now = g_get_monotonic_time ();
+  wait_ms = LIGHT_SENSOR_INTERVAL_MS - (now - self->last_us) / 1000;
+  if (self->last_us && wait_ms > 0) {
+    /* Too soon: the last change must not get lost when nothing draws later */
+    if (!self->timeout_id)
+      self->timeout_id = g_timeout_add (wait_ms, on_interval_over, self);
+    return;
+  }
+
+  if (box->x + box->width > buffer->width || box->y + box->height > buffer->height) {
+    warn_once (self, "its box lies outside the screen");
+    self->dirty = FALSE;
+    return;
+  }
+
+  texture = wlr_texture_from_buffer (renderer, buffer);
+  if (!texture) {
+    warn_once (self, "cannot read the screen");
+    return;
+  }
+
+  format = wlr_texture_preferred_read_format (texture);
+  if (format != DRM_FORMAT_ARGB8888 && format != DRM_FORMAT_XRGB8888 &&
+      format != DRM_FORMAT_XBGR8888)
+    format = DRM_FORMAT_ABGR8888;
+
+  ok = wlr_texture_read_pixels (texture, &(struct wlr_texture_read_pixels_options) {
+      .data = self->pixels,
+      .format = format,
+      .stride = box->width * 4,
+      .src_box = *box,
+    });
+  wlr_texture_destroy (texture);
+
+  self->dirty = FALSE;
+  self->last_us = now;
+
+  if (!ok) {
+    warn_once (self, "reading the screen failed");
+    return;
+  }
+
+  if (phoc_light_sensor_color_from_pixels (&self->config, self->pixels, format, box->width * 4, color))
+    phoc_light_sensor_publish (self, color);
+}
+
+/**
+ * phoc_light_sensor_publish:
+ * @self: The sensor
+ * @color: Red, green and blue for the sensor's firmware
+ *
+ * Writes the colour in the driver's own format (`A:255R:<r>G:<g>B:<b>`, without a newline) to
+ * the sensor's file, if it changed. The file is replaced as a whole, never seen half written.
+ */
+void
+phoc_light_sensor_publish (PhocLightSensor *self, const int color[3])
+{
+  g_autoptr (GError) err = NULL;
+  g_autofree char *text = NULL;
+
+  if (memcmp (color, self->color, sizeof (self->color)) == 0)
+    return;
+
+  text = g_strdup_printf ("A:255R:%dG:%dB:%d", color[0], color[1], color[2]);
+  if (!g_file_set_contents (self->path, text, -1, &err)) {
+    warn_once (self, err->message);
+    return;
+  }
+  memcpy (self->color, color, sizeof (self->color));
+}
+
+/**
+ * phoc_light_sensor_forget:
+ * @self: The sensor
+ *
+ * What the panel shows is not known (a client's buffer goes out directly): the device's default
+ * colour applies until a frame is drawn again.
+ */
+void
+phoc_light_sensor_forget (PhocLightSensor *self)
+{
+  self->dirty = TRUE;
+  if (self->color[0] < 0)
+    return;
+
+  if (g_unlink (self->path) < 0 && errno != ENOENT)
+    warn_once (self, g_strerror (errno));
+  self->color[0] = self->color[1] = self->color[2] = -1;
+}
