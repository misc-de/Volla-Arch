+  g_clear_pointer (&priv->light_sensor, phoc_light_sensor_free);
   g_clear_pointer (&priv->color_transform, wlr_color_transform_unref);
 
   G_OBJECT_CLASS (phoc_output_parent_class)->finalize (object);
@@ -2048,6 +2069,22 @@ phoc_output_damage_box (PhocOutput *self, const struct wlr_box *box)
   return TRUE;
 }
 
+/**
+ * phoc_output_damage_buffer_box:
+ * @self: The output
+ * @box: The damage box in buffer pixels, whatever the output's transform
+ *
+ * Adds the damage and schedules a frame.
+ */
+void
+phoc_output_damage_buffer_box (PhocOutput *self, const struct wlr_box *box)
+{
+  PhocOutputPrivate *priv = phoc_output_get_instance_private (self);
+
+  wlr_damage_ring_add_box (&priv->damage_ring, box);
+  wlr_output_schedule_frame (self->wlr_output);
+}
+
 
