+static void
+test_phoc_light_sensor_parse (void)
+{
+  PhocLightSensorConfig config;
+
+  phoc_light_sensor_config_init (&config);
+  g_assert_cmpint (config.box.width, ==, 0);
+  g_assert_cmpuint (config.cols, ==, 1);
+  g_assert_cmpuint (config.rows, ==, 1);
+  g_assert_cmpfloat (config.weights[0], ==, 1.0);
+  g_assert_cmpfloat (config.gain, ==, 1.0);
+
+  g_assert_true (phoc_light_sensor_config_parse_box (&config, "608, 0, 136 ,150"));
+  g_assert_cmpint (config.box.x, ==, 608);
+  g_assert_cmpint (config.box.y, ==, 0);
+  g_assert_cmpint (config.box.width, ==, 136);
+  g_assert_cmpint (config.box.height, ==, 150);
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "1,2,3"));
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "1,2,3,4,5"));
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "1,2,0,4"));
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "-1,2,3,4"));
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "1,2,3,x"));
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "1,2,3,"));
+  g_assert_false (phoc_light_sensor_config_parse_box (&config, "1,2,3,99999"));
+  /* A refused value changes nothing */
+  g_assert_cmpint (config.box.x, ==, 608);
+
+  g_assert_true (phoc_light_sensor_config_parse_weights (&config, "15,35;44,106"));
+  g_assert_cmpuint (config.cols, ==, 2);
+  g_assert_cmpuint (config.rows, ==, 2);
+  g_assert_cmpfloat_with_epsilon (config.weights[0], 0.075, 1e-6);
+  g_assert_cmpfloat_with_epsilon (config.weights[3], 0.53, 1e-6);
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, "1,2;3"));
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, "1,-2"));
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, "0,0"));
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, "1,x"));
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, "1;;2"));
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, ""));
+  g_assert_false (phoc_light_sensor_config_parse_weights (&config, "nan"));
+  {
+    /* 65 cells: more than fit */
+    g_autoptr (GString) many = g_string_new ("1");
+
+    for (int i = 0; i < PHOC_LIGHT_SENSOR_MAX_CELLS; i++)
+      g_string_append (many, ",1");
+    g_assert_false (phoc_light_sensor_config_parse_weights (&config, many->str));
+  }
+  g_assert_cmpuint (config.cols, ==, 2);
+
+  g_assert_true (phoc_light_sensor_config_parse_gain (&config, " 0.88 "));
+  g_assert_cmpfloat_with_epsilon (config.gain, 0.88, 1e-6);
+  g_assert_false (phoc_light_sensor_config_parse_gain (&config, "0"));
+  g_assert_false (phoc_light_sensor_config_parse_gain (&config, "1.5"));
+  g_assert_false (phoc_light_sensor_config_parse_gain (&config, "x"));
+  g_assert_false (phoc_light_sensor_config_parse_gain (&config, "inf"));
+}
+
+
+static void
+test_phoc_light_sensor_config_file (void)
+{
+  PhocOutputConfig *oc;
+
+  g_autoptr (PhocConfig) config = phoc_config_new_from_data (
+    "[output:DSI-1]\n"
+    "light-sensor = 608,0,136,150\n"
+    "light-sensor-weights = 15,35;44,106\n"
+    "light-sensor-gain = 0.88\n"
+    "[output:DSI-2]\n"
+    "scale = 2\n");
+
+  for (GSList *l = config->outputs; l; l = l->next) {
+    oc = l->data;
+    if (g_str_equal (oc->name, "DSI-1")) {
+      g_assert_cmpint (oc->light_sensor.box.width, ==, 136);
+      g_assert_cmpuint (oc->light_sensor.rows, ==, 2);
+      g_assert_cmpfloat_with_epsilon (oc->light_sensor.gain, 0.88, 1e-6);
+    } else {
+      /* No sensor */
+      g_assert_cmpint (oc->light_sensor.box.width, ==, 0);
+      g_assert_cmpfloat (oc->light_sensor.gain, ==, 1.0);
+    }
+  }
+}
+
+
+static guint8 *
+fill (const PhocLightSensorConfig *config, guint8 r, guint8 g, guint8 b, gboolean bgr_order)
+{
+  int n = config->box.width * config->box.height;
+  guint8 *pixels = g_malloc (n * 4);
+
+  for (int i = 0; i < n; i++) {
+    pixels[i * 4 + 0] = bgr_order ? b : r;
+    pixels[i * 4 + 1] = g;
+    pixels[i * 4 + 2] = bgr_order ? r : b;
+    pixels[i * 4 + 3] = 0xff;
+  }
+  return pixels;
+}
+
+
+static void
+test_phoc_light_sensor_color (void)
+{
+  PhocLightSensorConfig config;
+  g_autofree guint8 *white = NULL, *grey = NULL, *red = NULL, *half = NULL;
+  int color[3];
+
+  phoc_light_sensor_config_init (&config);
+  config.box = (struct wlr_box) { .width = 8, .height = 6 };
+
+  /* Uniform: the value itself, times the gain */
+  white = fill (&config, 255, 255, 255, FALSE);
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, white, DRM_FORMAT_ABGR8888, 32, color));
+  g_assert_cmpint (color[0], ==, 255);
+  g_assert_cmpint (color[2], ==, 255);
+  config.gain = 0.88;
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, white, DRM_FORMAT_XBGR8888, 32, color));
+  g_assert_cmpint (color[1], ==, 224);
+  grey = fill (&config, 128, 128, 128, FALSE);
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, grey, DRM_FORMAT_ABGR8888, 32, color));
+  g_assert_cmpint (color[0], ==, 113);
+
+  /* Byte order: red is the third byte for [AX]RGB8888 */
+  config.gain = 1.0;
+  red = fill (&config, 255, 0, 0, TRUE);
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, red, DRM_FORMAT_ARGB8888, 32, color));
+  g_assert_cmpint (color[0], ==, 255);
+  g_assert_cmpint (color[1], ==, 0);
+  g_assert_cmpint (color[2], ==, 0);
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, red, DRM_FORMAT_XRGB8888, 32, color));
+  g_assert_cmpint (color[0], ==, 255);
+  g_assert_false (phoc_light_sensor_color_from_pixels (&config, red, DRM_FORMAT_RGB565, 32, color));
+
+  /* Half white, half black, averaged in linear light: brighter than 128 */
+  half = fill (&config, 0, 0, 0, FALSE);
+  for (int y = 0; y < 6; y++)
+    memset (half + y * 32, 255, 16);
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, half, DRM_FORMAT_ABGR8888, 32, color));
+  g_assert_cmpint (color[0], ==, 186);
+
+  /* Weighted: only the left column counts, which is white */
+  g_assert_true (phoc_light_sensor_config_parse_weights (&config, "1,0;1,0"));
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, half, DRM_FORMAT_ABGR8888, 32, color));
+  g_assert_cmpint (color[0], ==, 255);
+  g_assert_true (phoc_light_sensor_config_parse_weights (&config, "0,1"));
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, half, DRM_FORMAT_ABGR8888, 32, color));
+  g_assert_cmpint (color[0], ==, 0);
+
+  /* More cells than pixels: the empty ones don't count */
+  config.box.width = 1;
+  g_assert_true (phoc_light_sensor_config_parse_weights (&config, "1,1"));
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, white, DRM_FORMAT_ABGR8888, 4, color));
+  g_assert_cmpint (color[0], ==, 255);
+  g_assert_true (phoc_light_sensor_config_parse_weights (&config, "0,1"));
+  g_assert_true (phoc_light_sensor_color_from_pixels (&config, white, DRM_FORMAT_ABGR8888, 4, color));
+  g_assert_cmpint (color[0], ==, 0);
+}
+
+
+static void
+test_phoc_light_sensor_publish (void)
+{
+  PhocLightSensorConfig config;
+  g_autofree char *dir = g_dir_make_tmp ("phoc-light-sensor-XXXXXX", NULL);
+  g_autofree char *path = g_build_filename (dir, PHOC_LIGHT_SENSOR_FILE, NULL);
+  g_autofree char *text = NULL;
+  PhocLightSensor *sensor;
+
+  phoc_light_sensor_config_init (&config);
+  config.box = (struct wlr_box) { .width = 4, .height = 4 };
+  sensor = phoc_light_sensor_new (NULL, &config, path);
+
+  /* Nothing told yet: forgetting leaves no file behind */
+  phoc_light_sensor_forget (sensor);
+  g_assert_false (g_file_test (path, G_FILE_TEST_EXISTS));
+
+  phoc_light_sensor_publish (sensor, (int[3]) { 224, 113, 0 });
+  g_assert_true (g_file_get_contents (path, &text, NULL, NULL));
+  /* The driver's format, without a newline */
+  g_assert_cmpstr (text, ==, "A:255R:224G:113B:0");
+
+  /* The same again: not written */
+  g_assert_cmpint (g_unlink (path), ==, 0);
+  phoc_light_sensor_publish (sensor, (int[3]) { 224, 113, 0 });
+  g_assert_false (g_file_test (path, G_FILE_TEST_EXISTS));
+  phoc_light_sensor_publish (sensor, (int[3]) { 1, 2, 3 });
+  g_clear_pointer (&text, g_free);
+  g_assert_true (g_file_get_contents (path, &text, NULL, NULL));
+  g_assert_cmpstr (text, ==, "A:255R:1G:2B:3");
+
+  /* Forgotten: the file goes, the device's default applies */
+  phoc_light_sensor_forget (sensor);
+  g_assert_false (g_file_test (path, G_FILE_TEST_EXISTS));
+  phoc_light_sensor_publish (sensor, (int[3]) { 1, 2, 3 });
+  g_assert_true (g_file_test (path, G_FILE_TEST_EXISTS));
+
+  /* Freeing removes the file */
+  phoc_light_sensor_free (sensor);
+  g_assert_false (g_file_test (path, G_FILE_TEST_EXISTS));
+
+  /* A directory that isn't there: a warning once, nothing else */
+  sensor = phoc_light_sensor_new (NULL, &config, "/nonexistent/dir/" PHOC_LIGHT_SENSOR_FILE);
+  g_test_expect_message ("phoc-light-sensor", G_LOG_LEVEL_WARNING, "Light sensor: *");
+  phoc_light_sensor_publish (sensor, (int[3]) { 1, 2, 3 });
+  phoc_light_sensor_publish (sensor, (int[3]) { 4, 5, 6 });
+  g_test_assert_expected_messages ();
+  phoc_light_sensor_free (sensor);
+
+  g_assert_cmpint (g_rmdir (dir), ==, 0);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+  g_test_init (&argc, &argv, NULL);
+
+  g_test_add_func ("/phoc/light-sensor/parse", test_phoc_light_sensor_parse);
+  g_test_add_func ("/phoc/light-sensor/config-file", test_phoc_light_sensor_config_file);
+  g_test_add_func ("/phoc/light-sensor/color", test_phoc_light_sensor_color);
+  g_test_add_func ("/phoc/light-sensor/publish", test_phoc_light_sensor_publish);
+
+  return g_test_run ();
+}
