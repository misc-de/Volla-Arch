From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Wed, 4 Nov 2026 11:31:25 +0100
Subject: [PATCH] server: A virtual output on request

A screen shown through a VNC server needs a compositor output. Creating
one with WLR_BACKENDS and WLR_HEADLESS_OUTPUTS at startup keeps it for
the whole session: every client sees two screens all the time, whether
somebody is connected or not. Switching it off over output management
hides it from layouts but keeps the head and the wl_output around.

phoc now adds an empty headless backend when the backend is a multi
backend, which costs nothing, and offers mobi.phosh.Phoc.VirtualOutput
on the session bus: Create adds the output with the given size, scale
and position, Destroy removes it. It also goes away with the bus
connection that created it, so a crashed client doesn't leave the
session with a screen nobody can see. Windows on it move to the
remaining outputs through the layout change, as on an unplugged monitor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dbus/meson.build                       |   1 +
 src/dbus/mobi.phosh.Phoc.VirtualOutput.xml |  42 +++++
 src/meson.build                            |   2 +
 src/output.c                               |  20 +++
 src/output.h                               |   1 +
 src/server.c                               |  16 ++
 src/virtual-output.c                       | 241 +++++++++++++++++++++++++++++
 src/virtual-output.h                       |  22 +++
 8 files changed, 345 insertions(+)

diff --git a/src/dbus/meson.build b/src/dbus/meson.build
index aacecf6..8d5353f 100644
--- a/src/dbus/meson.build
+++ b/src/dbus/meson.build
@@ -16,6 +16,7 @@ phoc_dbus_client_protos = []
 phoc_dbus_server_protos = [
   # Sorted by xml filename:
   ['phoc-dbus-debug-control', 'mobi.phosh.Phoc.DebugControl.xml', 'mobi.phosh.Phoc'],
+  ['phoc-dbus-virtual-output', 'mobi.phosh.Phoc.VirtualOutput.xml', 'mobi.phosh.Phoc'],
 ]
 
 foreach p : phoc_dbus_client_protos + phoc_dbus_server_protos
diff --git a/src/dbus/mobi.phosh.Phoc.VirtualOutput.xml b/src/dbus/mobi.phosh.Phoc.VirtualOutput.xml
new file mode 100644
index 0000000..aef6153
--- /dev/null
+++ b/src/dbus/mobi.phosh.Phoc.VirtualOutput.xml
@@ -0,0 +1,42 @@
+<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
+"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
+<node xmlns:doc="http://www.freedesktop.org/dbus/1.0/doc.dtd">
+
+  <!--
+      mobi.phosh.Phoc.VirtualOutput:
+
+      A screen without a panel behind it, e.g. shown through a VNC server. It exists from
+      Create until Destroy, or until the bus connection that created it is gone, so a crashed
+      client never leaves the session with a screen nobody can see.
+  -->
+
+  <interface name="mobi.phosh.Phoc.VirtualOutput">
+    <!--
+        Create:
+        @width: Width in pixels
+        @height: Height in pixels
+        @scale: The output's scale
+        @x: Position in the layout (logical pixels)
+        @y: Position in the layout (logical pixels)
+        @name: The name of the new output
+
+        Creates the virtual output. There is at most one: fails if it already exists.
+    -->
+    <method name="Create">
+      <arg direction="in" name="width" type="u"/>
+      <arg direction="in" name="height" type="u"/>
+      <arg direction="in" name="scale" type="d"/>
+      <arg direction="in" name="x" type="i"/>
+      <arg direction="in" name="y" type="i"/>
+      <arg direction="out" name="name" type="s"/>
+    </method>
+
+    <!--
+        Destroy:
+
+        Removes the virtual output; its windows move to the remaining outputs. Does nothing
+        when there is none.
+    -->
+    <method name="Destroy"/>
+  </interface>
+</node>
diff --git a/src/meson.build b/src/meson.build
index a6d624f..914c841 100644
--- a/src/meson.build
+++ b/src/meson.build
