diff --git a/src/server.c b/src/server.c
index 32319f8..a0c331d 100644
--- a/src/server.c
+++ b/src/server.c
@@ -18,6 +18,7 @@
 #include "surface.h"
 #include "toplevel-identifier.h"
 #include "utils.h"
+#include "virtual-output.h"
 #include "xdg-dialog.h"
 #include "xdg-toplevel.h"
 #include "xdg-toplevel-decoration.h"
@@ -26,6 +27,8 @@
 
 #include <glib-unix.h>
 
+#include <wlr/backend/headless.h>
+#include <wlr/backend/multi.h>
 #include <wlr/types/wlr_drm.h>
 #include <wlr/types/wlr_ext_data_control_v1.h>
 #include <wlr/types/wlr_ext_image_capture_source_v1.h>
@@ -73,6 +76,7 @@ typedef struct _PhocServer {
   GStrv log_domains;
   PhocServerDebugFlags debug_flags;
   PhocDebugControl    *debug_control;
+  PhocVirtualOutput   *virtual_output;
 
   PhocRenderer        *renderer;
   PhocDesktop         *desktop;
@@ -469,6 +473,17 @@ phoc_server_initable_init (GInitable    *initable,
     return FALSE;
   }
 
+  /* An empty headless backend costs nothing: virtual outputs come on request */
+  if (wlr_backend_is_multi (self->backend)) {
+    struct wlr_backend *headless;
+
+    headless = wlr_headless_backend_create (wl_display_get_event_loop (self->wl_display));
+    if (headless && wlr_multi_backend_add (self->backend, headless))
+      self->virtual_output = phoc_virtual_output_new (headless);
+    else
+      g_warning ("Could not add a headless backend, no virtual outputs");
+  }
+
   self->renderer = phoc_renderer_new (self->backend, error);
   if (self->renderer == NULL)
     return FALSE;
@@ -569,6 +584,7 @@ phoc_server_dispose (GObject *object)
   }
 
   g_clear_object (&self->debug_control);
+  g_clear_object (&self->virtual_output);
 
   G_OBJECT_CLASS (phoc_server_parent_class)->dispose (object);
 }
diff --git a/src/virtual-output.c b/src/virtual-output.c
new file mode 100644
index 0000000..9a3f3eb
--- /dev/null
+++ b/src/virtual-output.c
@@ -0,0 +1,241 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phoc-virtual-output"
+
+#include "phoc-config.h"
+#include "output.h"
+#include "virtual-output.h"
+
+#include <wlr/backend/headless.h>
+#include <wlr/types/wlr_output.h>
+
+#include <gio/gio.h>
+
+#define VIRTUAL_OUTPUT_DBUS_PATH "/mobi/phosh/Phoc/VirtualOutput"
+#define VIRTUAL_OUTPUT_DBUS_NAME "mobi.phosh.Phoc.VirtualOutput"
+
+/* wlroots' renderer and the VNC viewers do not go beyond this */
+#define VIRTUAL_OUTPUT_MAX_SIZE 8192
+
+/**
+ * PhocVirtualOutput:
+ *
+ * A virtual screen on request, over DBus. Keeping one around all the time would make every
+ * client see two screens: Phosh's settings list both, and a pointer docks the shell.
+ */
+struct _PhocVirtualOutput {
+  PhocDBusVirtualOutputSkeleton parent;
+
+  struct wlr_backend           *backend;
+  struct wlr_output            *wlr_output;
+  struct wl_listener            output_destroy;
+
+  guint                         dbus_name_id;
+  guint                         owner_watch_id;
+};
+
+static void phoc_dbus_virtual_output_iface_init (PhocDBusVirtualOutputIface *iface);
+
+G_DEFINE_TYPE_WITH_CODE (PhocVirtualOutput, phoc_virtual_output,
+                         PHOC_DBUS_TYPE_VIRTUAL_OUTPUT_SKELETON,
+                         G_IMPLEMENT_INTERFACE (PHOC_DBUS_TYPE_VIRTUAL_OUTPUT,
+                                                phoc_dbus_virtual_output_iface_init))
+
+
+/* The output is gone, whoever removed it */
+static void
+handle_output_destroy (struct wl_listener *listener, void *data)
+{
+  PhocVirtualOutput *self = wl_container_of (listener, self, output_destroy);
+
+  wl_list_remove (&self->output_destroy.link);
+  self->wlr_output = NULL;
+  g_clear_handle_id (&self->owner_watch_id, g_bus_unwatch_name);
+}
+
+
+static void
+phoc_virtual_output_remove (PhocVirtualOutput *self)
+{
+  if (!self->wlr_output)
+    return;
+
+  g_debug ("Removing virtual output %s", self->wlr_output->name);
+  /* Runs handle_output_destroy, and the layout change moves the windows to the other outputs */
+  wlr_output_destroy (self->wlr_output);
+}
+
+
+static void
+on_owner_vanished (GDBusConnection *connection, const char *name, gpointer user_data)
+{
+  PhocVirtualOutput *self = PHOC_VIRTUAL_OUTPUT (user_data);
+
+  g_debug ("Owner %s of the virtual output is gone", name);
+  phoc_virtual_output_remove (self);
+}
+
+
+static gboolean
+handle_create (PhocDBusVirtualOutput *object,
+               GDBusMethodInvocation *invocation,
+               guint                  width,
+               guint                  height,
+               gdouble                scale,
+               gint                   x,
+               gint                   y)
+{
+  PhocVirtualOutput *self = PHOC_VIRTUAL_OUTPUT (object);
+  struct wlr_output_state pending;
+  PhocOutput *output;
+  bool ok;
+
+  if (self->wlr_output) {
+    g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_FAILED,
+                                           "The virtual output %s already exists",
+                                           self->wlr_output->name);
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+  }
+
+  if (width == 0 || height == 0 || width > VIRTUAL_OUTPUT_MAX_SIZE ||
+      height > VIRTUAL_OUTPUT_MAX_SIZE || scale < 0.5 || scale > 4.0 || x < 0 || y < 0) {
+    g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS,
+                                           "Invalid size, scale or position");
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+  }
+
+  /* Emits new_output: PhocDesktop sets up the PhocOutput before this returns */
+  self->wlr_output = wlr_headless_add_output (self->backend, width, height);
+  if (!self->wlr_output || !self->wlr_output->data) {
+    g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_FAILED,
+                                           "Failed to add a headless output");
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+  }
+
+  self->output_destroy.notify = handle_output_destroy;
+  wl_signal_add (&self->wlr_output->events.destroy, &self->output_destroy);
+
+  /* A saved state of an earlier virtual output must not win over what was asked for */
+  wlr_output_state_init (&pending);
+  wlr_output_state_set_enabled (&pending, true);
+  wlr_output_state_set_custom_mode (&pending, width, height, 0);
+  wlr_output_state_set_scale (&pending, scale);
+  ok = wlr_output_commit_state (self->wlr_output, &pending);
+  wlr_output_state_finish (&pending);
+  if (!ok) {
+    phoc_virtual_output_remove (self);
+    g_dbus_method_invocation_return_error (invocation, G_DBUS_ERROR, G_DBUS_ERROR_FAILED,
+                                           "Failed to set up the output");
+    return G_DBUS_METHOD_INVOCATION_HANDLED;
+  }
+
+  output = PHOC_OUTPUT (self->wlr_output->data);
+  phoc_output_set_position (output, x, y);
+
+  self->owner_watch_id =
+    g_bus_watch_name_on_connection (g_dbus_method_invocation_get_connection (invocation),
+                                    g_dbus_method_invocation_get_sender (invocation),
+                                    G_BUS_NAME_WATCHER_FLAGS_NONE,
+                                    NULL,
+                                    on_owner_vanished,
+                                    self,
+                                    NULL);
+
+  g_message ("Virtual output %s: %ux%u, scale %.2f, at %d,%d",
+             self->wlr_output->name, width, height, scale, x, y);
+  phoc_dbus_virtual_output_complete_create (object, invocation, self->wlr_output->name);
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+
+static gboolean
+handle_destroy (PhocDBusVirtualOutput *object, GDBusMethodInvocation *invocation)
+{
+  PhocVirtualOutput *self = PHOC_VIRTUAL_OUTPUT (object);
+
+  phoc_virtual_output_remove (self);
+  phoc_dbus_virtual_output_complete_destroy (object, invocation);
+  return G_DBUS_METHOD_INVOCATION_HANDLED;
+}
+
+
+static void
+phoc_dbus_virtual_output_iface_init (PhocDBusVirtualOutputIface *iface)
+{
+  iface->handle_create = handle_create;
+  iface->handle_destroy = handle_destroy;
+}
+
+
+static void
+on_bus_acquired (GDBusConnection *connection, const char *name, gpointer user_data)
+{
+  PhocVirtualOutput *self = PHOC_VIRTUAL_OUTPUT (user_data);
+  g_autoptr (GError) err = NULL;
+
+  if (!g_dbus_interface_skeleton_export (G_DBUS_INTERFACE_SKELETON (self), connection,
+                                         VIRTUAL_OUTPUT_DBUS_PATH, &err)) {
+    g_warning ("Failed to export on %s: %s", VIRTUAL_OUTPUT_DBUS_NAME, err->message);
+  }
+}
+
+
+static void
+phoc_virtual_output_dispose (GObject *object)
+{
+  PhocVirtualOutput *self = PHOC_VIRTUAL_OUTPUT (object);
+
+  /* Only stop answering: on shutdown the backend takes its outputs with it */
+  if (self->wlr_output) {
+    wl_list_remove (&self->output_destroy.link);
+    self->wlr_output = NULL;
+  }
+  g_clear_handle_id (&self->owner_watch_id, g_bus_unwatch_name);
+  if (g_dbus_interface_skeleton_get_object_path (G_DBUS_INTERFACE_SKELETON (self)))
+    g_dbus_interface_skeleton_unexport (G_DBUS_INTERFACE_SKELETON (self));
+  g_clear_handle_id (&self->dbus_name_id, g_bus_unown_name);
+
+  G_OBJECT_CLASS (phoc_virtual_output_parent_class)->dispose (object);
+}
+
+
+static void
+phoc_virtual_output_class_init (PhocVirtualOutputClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = phoc_virtual_output_dispose;
+}
+
+
+static void
+phoc_virtual_output_init (PhocVirtualOutput *self)
+{
+}
+
+
+/**
+ * phoc_virtual_output_new:
+ * @backend: A headless backend that is part of the server's backend
+ *
+ * Returns: (transfer full): The object, which takes its name on the session bus.
+ */
+PhocVirtualOutput *
+phoc_virtual_output_new (struct wlr_backend *backend)
+{
+  PhocVirtualOutput *self = g_object_new (PHOC_TYPE_VIRTUAL_OUTPUT, NULL);
+
+  self->backend = backend;
+  self->dbus_name_id = g_bus_own_name (G_BUS_TYPE_SESSION,
+                                       VIRTUAL_OUTPUT_DBUS_NAME,
+                                       G_BUS_NAME_OWNER_FLAGS_ALLOW_REPLACEMENT |
+                                       G_BUS_NAME_OWNER_FLAGS_REPLACE,
+                                       on_bus_acquired,
+                                       NULL,
+                                       NULL,
+                                       self,
+                                       NULL);
+  return self;
+}
diff --git a/src/virtual-output.h b/src/virtual-output.h
new file mode 100644
index 0000000..01b9574
--- /dev/null
+++ b/src/virtual-output.h
@@ -0,0 +1,22 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include "phoc-dbus-virtual-output.h"
+
+#include <wlr/backend.h>
+
+#include <glib-object.h>
+
+G_BEGIN_DECLS
+
+#define PHOC_TYPE_VIRTUAL_OUTPUT (phoc_virtual_output_get_type ())
+
+G_DECLARE_FINAL_TYPE (PhocVirtualOutput, phoc_virtual_output, PHOC, VIRTUAL_OUTPUT,
+                      PhocDBusVirtualOutputSkeleton)
+
+PhocVirtualOutput *phoc_virtual_output_new (struct wlr_backend *backend);
+
+G_END_DECLS
