diff --git a/src/output.c b/src/output.c
index 6e524e6..6f53273 100644
--- a/src/output.c
+++ b/src/output.c
@@ -2279,6 +2279,26 @@ phoc_output_is_awake (PhocOutput *self)
            wlr_drm_connector_get_doze (self->wlr_output));
 }
 
+/**
+ * phoc_output_set_position:
+ * @self: The output
+ * @x: The position in the layout
+ * @y: The position in the layout
+ *
+ * Moves an enabled output in the layout and tells the output management clients.
+ */
+void
+phoc_output_set_position (PhocOutput *self, int x, int y)
+{
+  PhocDesktop *desktop = phoc_server_get_desktop (phoc_server_get_default ());
+
+  wlr_output_layout_add (desktop->layout, self->wlr_output, x, y);
+  self->lx = x;
+  self->ly = y;
+  update_output_manager_config (desktop);
+}
+
+
 /**
  * phoc_output_is_builtin:
  *
