prepare() {
	# Place the subprojects where phoc's .wrap files expect them (no download during build)
	cp -a wlroots phoc/subprojects/wlroots-0.20.x
	cp -a gvdb phoc/subprojects/gvdb
	# phoc's own wlroots patches, in the order of its wlroots.wrap: text-input-v3 version 2 (GTK 4
	# apps ask for the OSK only on a tap) and the revert for Phosh's home bar of height 0
	local _p
	for _p in text-input-v2/0001-text-input-v3-Introduce-version.patch \
		text-input-v2/0002-text-input-Add-version-2-events.patch \
		text-input-v2/0003-text-input-v3-Add-version-2-requests.patch \
		text-input-v2/0004-text-input-v3-Bump-protocol-version-to-2.patch \
		0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch; do
		patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "../packagefiles/wlroots/$_p"
	done
	# Mali through libhybris: KMS must not scan out frames the GPU is still drawing (docs/GRAFIK.md)
	patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "$srcdir/0001-render-gles2-wait-for-the-GPU-without-implicit-sync.patch"
	# 0002, 0012, 0017 (the OSK only after a tap) are gone: since 0.58 phoc does that itself for
	# text-input-v3 version 2 (GTK 4); tested without them since 10.11.2026, GTK 3 and Firefox too
	# Displays: 90/120 Hz were set back to the preferred 60 Hz (upstream bug from phoc 4709966, phoc!771)
	patch -d phoc -Np1 -i "$srcdir/0003-output-Use-the-picked-mode-whether-it-is-preferred-or-not.patch"
	# While the session starts: the device's logo (device package) instead of the spinner
	patch -d phoc -Np1 -i "$srcdir/0004-output-shield-Show-the-device-s-logo-instead-of-the-spinner.patch"
	# Night light: the MediaTek display cannot set a gamma LUT (legacy KMS, ENOSYS); wlroots reports
	# none and its GLES2 renderer applies the LUT, phoc hands it over (docs/GRAFIK.md)
	patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "$srcdir/0005-render-gles2-Gamma-LUTs-when-the-CRTC-cannot-set-them.patch"
	patch -d phoc -Np1 -i "$srcdir/0006-output-Apply-gamma-LUTs-in-the-renderer-when-the-output-has-none.patch"
	# The logo while the session starts takes the accent color from GNOME Settings
	patch -d phoc -Np1 -i "$srcdir/0007-spinner-The-logo-in-the-accent-color.patch"
	# Accent color: a color of the user's choice from GNOME Settings (org.plinius.appearance,
	# schema in phosh-plinius)
	patch -d phoc -Np1 -i "$srcdir/0008-style-manager-A-custom-accent-color-from-the-settings.patch"
	# 0009 (crash on a tap on the home bar) is gone: fixed upstream (a9e2c3d, phoc 0.58)
	# plinius-ambient's effect (snow, rain, ...) is drawn with each of Phosh's backgrounds: under
	# the windows, under the app grid and on the lock screen; it gets frames only while it is seen
	patch -d phoc -Np1 -i "$srcdir/0010-render-Draw-plinius-ambient-s-effect-with-Phosh-s-background.patch"
	# Phosh's top panel grows to the full screen after start-up; it stays folded instead of
	# sliding in from margin 0, which showed the quick settings over the lock screen
	patch -d phoc -Np1 -i "$srcdir/0011-layer-shell-effects-Keep-a-folded-surface-folded-whe.patch"
	# Every suspend ended the Phosh session: wlroots destroyed the outputs when logind paused the
	# session and re-created them on resume; Phosh rebuilt its shell for the "new" output and GTK 3
	# committed a buffer at the wrong scale meanwhile. The outputs stay now (docs/STANDBY.md)
	patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "$srcdir/0013-backend-drm-Keep-the-outputs-over-a-session-pause.patch"
	# After a Phosh restart (crash, "Restart UI") the home bar lay below the screen and could not
	# be dragged: the layout shrank the folded home surface, which then got no frame callbacks
	# to draw the new size. Layer surfaces get them now wherever they are
	patch -d phoc -Np1 -i "$srcdir/0014-output-Frame-callbacks-for-layer-surfaces-off-the-output.patch"
	# Always-on display: the OLED keeps showing Phosh's clock in its low-power mode (MediaTek
	# DOZE_ACTIVE), the CRTC goes off between frames and the SoC can suspend. Phosh asks for it
	# with the power mode "doze", a Plinius extension of wlr-output-power-management
	# (-25: each change of doze is a commit of its own without a page-flip event; MediaTek skips the
	# plane update of such a commit and its event, wlroots then waited forever and the panel stayed dark)
	patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "$srcdir/0015-backend-drm-Doze-for-an-always-on-display.patch"
	patch -d phoc -Np1 -i "$srcdir/0016-output-Doze-as-an-always-on-display.patch"
	# A second screen (e.g. virtual over VNC): new windows open on the screen of the last click or
	# tap, a window picked in a task bar there or in Phosh's overview on the phone comes to it
	patch -d phoc -Np1 -i "$srcdir/0018-view-Windows-open-and-come-to-the-screen-they-were-picked-on.patch"
	# Switching a headless output on again (wlr-randr --on) aborted phoc on assert(found): the
	# client had bound while it was off and got no virtual mode
	patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "$srcdir/0019-output-management-A-virtual-mode-for-every-client-of-a-head.patch"
	# With a second screen the phone still shows windows maximized; on the second screen an app
	# floats with the size and position it had there the last time (per app id, kept on disk)
	patch -d phoc -Np1 -i "$srcdir/0020-view-The-phone-stays-a-phone-a-second-screen-floats-as-last-time.patch"
	# The same when the app grid or a notification activates a running app (xdg-activation,
	# gtk-shell), not only for the overview and task bars
	patch -d phoc -Np1 -i "$srcdir/0021-view-An-app-picked-in-the-app-grid-comes-to-that-screen-too.patch"
	# While dozing only the always-on display gets frame callbacks: plinius-ambient and Phosh drew
	# on under it (30 per second), so the CRTC never went off and the phone could not suspend
	patch -d phoc -Np1 -i "$srcdir/0022-output-Only-the-always-on-display-draws-while-dozing.patch"
	# The lock screen coming up while dozing no longer flashes up: the panel only gets the always-on
	# display and keeps its picture until that is back on top
	patch -d phoc -Np1 -i "$srcdir/0023-output-A-dozing-panel-only-gets-the-always-on-display.patch"
	# The screen behind VNC exists only on request, over DBus (plinius-desktop): an output that is
	# there all the time, even switched off, makes every client see two screens
	patch -d phoc -Np1 -i "$srcdir/0024-server-A-virtual-output-on-request.patch"
	# A window moved to the phone hung across both screens
	patch -d phoc -Np1 -i "$srcdir/0025-view-A-window-moved-to-another-screen-is-scaled-for-that-screen.patch"
	# An app started on the phone fills it with a second screen too
	patch -d phoc -Np1 -i "$srcdir/0026-view-An-app-started-on-the-phone-is-maximized-with-a-second-screen-too.patch"
	# Turning the phone or coming back from the desktop left an app shrunken for good
	patch -d phoc -Np1 -i "$srcdir/0027-view-A-window-s-scale-starts-over-when-it-gets-arranged-anew.patch"
	# The start-up logo from the first frame on, even over a modeset shield, with its step below
	patch -d phoc -Np1 -i "$srcdir/0028-output-shield-The-start-up-logo-from-the-first-frame.patch"
	# The on-screen keyboard shrank Settings to 0.81 and switched it to two columns: a plain
	# resize did not count as a pending configure
	patch -d phoc -Np1 -i "$srcdir/0029-xdg-toplevel-A-plain-resize-counts-as-a-pending-configure-too.patch"
	patch -d phoc -Np1 -i "$srcdir/0030-output-A-doze-ends-with-the-shell-that-asked-for-it.patch"
	# The OSK stays on top of a fullscreen window also when the window has no input method (games
	# through SDL, DOSBox): it was unfolded behind it and only showed while the screen was touched
	patch -d phoc -Np1 -i "$srcdir/0031-output-A-shown-OSK-stays-on-top-of-a-fullscreen-view.patch"
	# The bell of the apps (GTK's error bell, a terminal's bell) did nothing: it goes to feedbackd
	# as bell-window-system, whose sound and vibration Settings sets (Sounds and Vibration >
	# Alert Sound, gnome-control-center-plinius 0097)
	patch -d phoc -Np1 -i "$srcdir/0032-gtk-shell-The-bell-of-the-apps-goes-to-feedbackd.patch"
	# 120 Hz in the settings kept the panel at 60 Hz: MediaTek switches the timing through its
	# CRTC property DISP_MODE_IDX, not through MODE_ID alone
	patch -d phoc/subprojects/wlroots-0.20.x -Np1 -i "$srcdir/0033-backend-drm-MediaTek-runs-the-panel-timing-of-DISP_MODE_IDX.patch"
	# Auto brightness followed the picture: the light sensor behind the OLED sees the panel's light,
	# and its firmware only takes that off when it knows the colour shown over the sensor. phoc
	# reads that part of the screen back and writes the colour to $XDG_RUNTIME_DIR; the sensor's
	# box and weights come from phoc.ini (device package), plinius-backlight-wake hands it on
	patch -d phoc -Np1 -i "$srcdir/0034-output-Tell-the-light-sensor-what-the-panel-shows-over-it.patch"
	# Back from the VNC desktop an app could stay at half size in its desktop layout: a maximized
	# window whose screen went away kept that screen's size and scale-to-fit took it as the answer
	patch -d phoc -Np1 -i "$srcdir/0035-desktop-A-maximized-window-whose-screen-went-away-is.patch"
	# A window dragged under a panel (top bar, the desktop's task bar) keeps half its title bar
	# out of it, so it can be grabbed again
	patch -d phoc -Np1 -i "$srcdir/0036-cursor-A-dragged-window-keeps-half-its-title-bar-out.patch"
	# The desktop's task bar minimizes a window that is in front, phoc ignored that request
	patch -d phoc -Np1 -i "$srcdir/0037-view-Windows-can-be-minimized.patch"
	# The OSK stays on the phone with the desktop over VNC: its layer surface goes to the built-in
	# panel, not under the cursor, and a field on the desktop (typed into with the PC's keyboard)
	# does not unfold it
	patch -d phoc -Np1 -i "$srcdir/0038-input-method-relay-The-OSK-only-for-the-phone-s-own-.patch"
}

build() {
	arch-meson phoc build \
		-Dembed-wlroots=enabled \
		-Ddefault_library=static \
		-Dtests=false \
		-Dman=false
	meson compile -C build
}

package() {
	# Only phoc itself; do not install the embedded wlroots/gvdb (conflicts with wlroots0.20)
	meson install -C build --destdir "$pkgdir" --skip-subprojects
}
