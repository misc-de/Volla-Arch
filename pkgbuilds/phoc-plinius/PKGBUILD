# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=phoc-plinius
pkgver=0.59.0
pkgrel=9
pkgdesc="Phosh compositor with embedded, patched wlroots 0.20.2 as upstream intends"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
url="https://gitlab.gnome.org/World/Phosh/phoc"
license=(GPL-3.0-or-later MIT)
# Runtime deps as ALARM's phoc, plus those of the statically embedded wlroots
depends=(
	cairo dconf glib2 gnome-desktop gsettings-desktop-schemas hicolor-icon-theme
	json-glib libgmobile libinput libxcb libxkbcommon mutter pango pixman
	systemd-libs wayland xorg-xwayland
	libdrm libdisplay-info libliftoff seatd libglvnd mesa vulkan-icd-loader lcms2
	xcb-util-errors xcb-util-renderutil xcb-util-wm
)
# feedbackd plays the bell of the apps (0032); without it the bell stays silent as before
optdepends=('feedbackd: the bell of the apps as a sound or a vibration')
makedepends=(git meson glib2-devel wayland-protocols xorgproto hwdata glslang vulkan-headers)
# Why not phoc from ALARM: our patches (always-on display, night light, second screen, ...).
# Since 0.59 Arch also embeds wlroots with phoc's own wlroots patches (the revert "layer-shell:
# error on 0 dimension without anchors" and text-input-v3 version 2); same here.
provides=("phoc=$pkgver")
conflicts=(phoc)
# Commits of tag v$pkgver and of wlroots tag 0.20.2: a tag can be moved later, a commit hash cannot
_commit=caebbe49fc18ae34af73e8517ced4313000ab65c
