From 4a14255a09582a74958161420bc8f5714e5c22de Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 31 Oct 2026 21:40:34 +0100
Subject: [PATCH] egl: the driver's shader cache on disk, as Android's
 framework sets it up for apps

---
 hybris/egl/egl.c | 58 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/hybris/egl/egl.c b/hybris/egl/egl.c
index 9f381b4..23c7514 100644
--- a/hybris/egl/egl.c
+++ b/hybris/egl/egl.c
@@ -17,6 +17,10 @@
 
 #include "config.h"
 
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE /* program_invocation_short_name */
+#endif
+
 #include <android-config.h>
 
 /* EGL function pointers */
@@ -31,6 +35,10 @@
 #include <stdint.h>
 #include <stdlib.h>
 #include <malloc.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <sys/stat.h>
 #include "ws.h"
 #include "helper.h"
 #include <assert.h>
@@ -87,10 +95,60 @@ static void (*_glEGLImageTargetRenderbufferStorageOES) (GLenum target, GLeglImag
 
 static __eglMustCastToProperFunctionPointerType (*_eglGetProcAddress)(const char *procname) = NULL;
 
+/*
+ * The driver's compiled shaders on disk, as Android's framework sets up for every app
+ * (egl_set_cache_filename() before the first EGL call): without it, every process compiles all its
+ * shaders again, which costs a GTK app 100-300 ms of stalled frames whenever something is drawn
+ * the first time. One file per program, $XDG_CACHE_HOME/hybris/egl/<program>.cache; Android's
+ * EGL checks it on loading (checksum) and saves it a few seconds after new shaders.
+ * HYBRIS_EGL_CACHE=0 switches it off, HYBRIS_EGL_CACHE=FILE names the file.
+ */
+static void _init_egl_cache(void *handle)
+{
+	static int done;
+	void (*set_cache_filename)(const char *);
+	const char *env = getenv("HYBRIS_EGL_CACHE");
+	const char *base = getenv("XDG_CACHE_HOME");
+	const char *home = getenv("HOME");
+	char dir[PATH_MAX], file[PATH_MAX];
+
+	if (done || handle == NULL)
+		return;
+	done = 1;
+	if (env != NULL && strcmp(env, "0") == 0)
+		return;
+
+	set_cache_filename = android_dlsym(handle, "_ZN7android22egl_set_cache_filenameEPKc");
+	if (set_cache_filename == NULL)
+		return;
+
+	if (env != NULL && env[0] != '\0') {
+		snprintf(file, sizeof(file), "%s", env);
+	} else {
+		/* Only below a cache directory of the process' own user */
+		if (base != NULL && base[0] == '/')
+			snprintf(dir, sizeof(dir), "%s/hybris", base);
+		else if (home != NULL && home[0] == '/')
+			snprintf(dir, sizeof(dir), "%s/.cache/hybris", home);
+		else
+			return;
+		mkdir(dir, 0700);
+		strncat(dir, "/egl", sizeof(dir) - strlen(dir) - 1);
+		if (mkdir(dir, 0700) != 0 && errno != EEXIST)
+			return;
+		if (snprintf(file, sizeof(file), "%s/%s.cache", dir, program_invocation_short_name) >= (int) sizeof(file))
+			return;
+	}
+
+	set_cache_filename(file);
+	HYBRIS_DEBUG_LOG(EGL, "shader cache in %s", file);
+}
+
 static void _init_androidegl()
 {
 	egl_handle = (void *) android_dlopen(getenv("LIBEGL") ? getenv("LIBEGL") : "libEGL.so", RTLD_LAZY);
 	glesv2_handle = (void *) android_dlopen(getenv("LIBGLESV2") ? getenv("LIBGLESV2") : "libGLESv2.so", RTLD_LAZY);
+	_init_egl_cache(egl_handle);
 }
 
 static inline void hybris_egl_initialize()
