prepare() {
	cd libhybris
	# On Arch libcamera.so/.pc belong to the libcamera package (tools/check-conflicts.py)
	patch -Np1 -i ../0001-camera-rename-libcamera-to-libcamera-hybris.patch
	# wlroots on real KMS: GBM platform and dma-buf import for buffers of hybris-gbm (docs/GRAFIK.md)
	patch -Np1 -i ../0002-egl-gbm-platform-and-dma-buf-import-of-hybris_gbm-buffers.patch
	# GPU for Wayland clients: dma-buf import of their buffers, which they send via linux-dmabuf
	patch -Np1 -i ../0003-egl-import-any-dma-buf-through-the-driver-report-dma.patch
	patch -Np1 -i ../0004-wayland-hand-buffers-over-with-linux-dmabuf-without-.patch
	# Firefox swaps with eglSwapBuffersWithDamageKHR; unwrapped it never reached the compositor
	patch -Np1 -i ../0005-egl-route-eglSwapBuffersWithDamageKHR-through-the-wi.patch
	# The driver's compiled shaders on disk per program (~/.cache/hybris/egl), as Android does for
	# apps; otherwise every start compiles them again and the first frames stall
	patch -Np1 -i ../0006-egl-the-driver-s-shader-cache-on-disk-as-Android-s-framework.patch
	cd hybris
	# test_audio is built with -std=c99, where glibc hides strdup, which the
	# Halium header system/audio.h uses. GCC >= 14 errors out on implicit
	# declarations. Only this test program is affected.
	sed -i 's/^test_audio_CFLAGS = -std=c99/test_audio_CFLAGS = -std=gnu99/' tests/Makefile.am
	autoreconf -fi
}

build() {
	cd libhybris/hybris
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--enable-wayland \
		--disable-wayland_serverside_buffers \
		--with-android-headers=/usr/include/android \
		--enable-property-cache \
		--enable-experimental \
		--enable-glvnd \
		--enable-arch=arm64 \
		--enable-mali-quirks \
		--enable-adreno-quirks
	make
	# Keeps glibc's static TLS off bionic's slots (see the source)
	${CC:-gcc} $CFLAGS $LDFLAGS -shared -fPIC -o ../../libhybris-tls-padding.so ../../hybris-tls-padding.c
}

package() {
	cd libhybris/hybris
	make DESTDIR="$pkgdir" install
	install -Dm755 ../../libhybris-tls-padding.so -t "$pkgdir/usr/lib"

	cd "$pkgdir"
	# libglvnd, mesa and opencl-headers ship these files; libhybris only hooks in
	# as a glvnd vendor (/usr/share/glvnd/egl_vendor.d/*libhybris*.json).
	rm -rf usr/include/{GLES,GLES2,GLES3,EGL,KHR,VG,CL}
	rm -f usr/lib/lib{EGL,GLESv2,GLESv1_CM,OpenCL}.so*
	rm -f usr/lib/pkgconfig/{egl,glesv1_cm,glesv2,OpenCL}.pc
	find usr/lib -name '*.la' -delete
}
