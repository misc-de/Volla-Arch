pkgname=libhybris
pkgver=0.1.0.20260624
pkgrel=8
pkgdesc="Use Android (bionic) drivers from glibc userspace (upstream, glvnd vendor)"
arch=(aarch64)
url="https://github.com/libhybris/libhybris"
license=(Apache-2.0 BSD-2-Clause)
depends=(glibc gcc-libs wayland libglvnd)
makedepends=(git android-headers python wayland-protocols)
# Upstream master, no tag: commit pin; pkgver = upstream version + commit date
_commit=7079712a42ea2754adf747e70c6cc75764c8596e
source=(
	"git+$url.git#commit=$_commit"
	0001-camera-rename-libcamera-to-libcamera-hybris.patch
	0002-egl-gbm-platform-and-dma-buf-import-of-hybris_gbm-buffers.patch
	0003-egl-import-any-dma-buf-through-the-driver-report-dma.patch
	0004-wayland-hand-buffers-over-with-linux-dmabuf-without-.patch
	0005-egl-route-eglSwapBuffersWithDamageKHR-through-the-wi.patch
	0006-egl-the-driver-s-shader-cache-on-disk-as-Android-s-framework.patch
	hybris-tls-padding.c
)
