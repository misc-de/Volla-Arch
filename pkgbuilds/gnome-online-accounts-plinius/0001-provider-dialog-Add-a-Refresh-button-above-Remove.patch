+/* Fetches the account's calendars, contacts and tasks again. A separate program, because this library
+ * does not link evolution-data-server (see plinius-goa-refresh). */
+#define PLINIUS_GOA_REFRESH "/usr/lib/plinius/plinius-goa-refresh"
+
+static void
+sync_account_finish (GoaProviderDialog *self,
+                     GError            *error)
+{
+  AdwToast *toast;
+
+  if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  if (error != NULL)
+    g_warning ("Could not refresh account: %s", error->message);
+
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->sync_button), _("Re_fresh"));
+  gtk_widget_set_sensitive (self->sync_button,
+                            !goa_account_get_attention_needed (goa_object_peek_account (self->object)));
+
+  toast = adw_toast_new (error == NULL ? _("Account refreshed")
+                                       : _("Could not refresh the account"));
+  goa_provider_dialog_add_toast (self, toast);
+
+  if (self->state != GOA_DIALOG_DONE)
+    goa_provider_dialog_set_state (self, GOA_DIALOG_READY);
+}
+
+static void
+sync_account_subprocess_cb (GObject      *source_object,
+                            GAsyncResult *result,
+                            gpointer      user_data)
+{
+  g_autoptr(GoaProviderDialog) self = GOA_PROVIDER_DIALOG (user_data);
+  g_autoptr(GError) error = NULL;
+
+  g_subprocess_wait_check_finish (G_SUBPROCESS (source_object), result, &error);
+  sync_account_finish (self, error);
+}
+
+static void
+sync_account_credentials_cb (GObject      *source_object,
+                             GAsyncResult *result,
+                             gpointer      user_data)
+{
+  g_autoptr(GoaProviderDialog) self = GOA_PROVIDER_DIALOG (user_data);
+  g_autoptr(GSubprocess) subprocess = NULL;
+  g_autoptr(GError) error = NULL;
+
+  /* A rejected password also sets attention-needed: the dialog then offers to sign in again */
+  if (!goa_account_call_ensure_credentials_finish (GOA_ACCOUNT (source_object), NULL, result, &error))
+    {
+      sync_account_finish (self, error);
+      return;
+    }
+
+  subprocess = g_subprocess_new (G_SUBPROCESS_FLAGS_NONE,
+                                 &error,
+                                 PLINIUS_GOA_REFRESH,
+                                 goa_account_get_id (GOA_ACCOUNT (source_object)),
+                                 NULL);
+  if (subprocess == NULL)
+    {
+      sync_account_finish (self, error);
+      return;
+    }
+
+  g_subprocess_wait_check_async (subprocess,
+                                 self->cancellable,
+                                 sync_account_subprocess_cb,
+                                 g_steal_pointer (&self));
+}
+
+static void
+on_sync_activated (GoaProviderDialog *self)
+{
+  /* The state does not show on this page: the row itself tells that something is going on */
+  gtk_widget_set_sensitive (self->sync_button, FALSE);
+  adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->sync_button), _("Refreshing…"));
+  goa_provider_dialog_set_state (self, GOA_DIALOG_BUSY);
+  goa_account_call_ensure_credentials (goa_object_peek_account (self->object),
+                                       self->cancellable,
+                                       sync_account_credentials_cb,
+                                       g_object_ref (self));
+}
