build() {
	# -g: libbpf reads the map definitions from the BTF
	# The BTF's line info names the source without the build directory
	clang -target bpf -O2 -g -fdebug-prefix-map="$srcdir"=. -Wall -I. \
		-c appaccess.bpf.c -o appaccess.bpf.o
	# Without DWARF, only the BTF is needed
	llvm-strip -g appaccess.bpf.o
	# shellcheck disable=SC2086,SC2046
	${CC:-cc} $CPPFLAGS $CFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter -I. \
		-o plinius-appaccessd plinius-appaccessd.c $(pkg-config --cflags --libs gio-unix-2.0 libbpf) $LDFLAGS
	# shellcheck disable=SC2086,SC2046
	${CC:-cc} $CPPFLAGS $CFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o plinius-appaccess-agent plinius-appaccess-agent.c $(pkg-config --cflags --libs gio-unix-2.0) $LDFLAGS
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	install -Dm755 plinius-appaccessd plinius-appaccess-agent -t "$pkgdir/usr/lib/plinius-appaccess"
	install -Dm644 appaccess.bpf.o -t "$pkgdir/usr/lib/plinius-appaccess"
	install -Dm644 plinius-appaccessd.service -t "$pkgdir/usr/lib/systemd/system"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-appaccessd.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# The question, in the session of whoever is signed in
	install -Dm644 plinius-appaccess-agent.service -t "$pkgdir/usr/lib/systemd/user"
	install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
	ln -s ../plinius-appaccess-agent.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
	install -Dm644 org.plinius.AppAccess1.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 org.plinius.AppAccess1.service -t "$pkgdir/usr/share/dbus-1/system-services"
	install -d -m755 "$pkgdir/etc/plinius-appaccess"
	# The microphone: the hook in WirePlumber, its decisions as a library (require)
	install -Dm644 plinius-appaccess-microphone.lua -t "$pkgdir/usr/share/wireplumber/scripts/lib"
	install -Dm644 find-plinius-microphone-access.lua -t "$pkgdir/usr/share/wireplumber/scripts/plinius"
	install -Dm644 70-plinius-microphone-access.conf -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-appaccess.mo"
	done
}
