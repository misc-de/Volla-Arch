# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-appaccess
pkgver=0.2
pkgrel=9
pkgdesc="Per app: cameras, security keys, network and microphone allowed, refused or asked for, with the attempts counted (cgroup BPF, WirePlumber), for GNOME Settings"
arch=(aarch64 x86_64)
# The daemon and the agent are MIT; the BPF programs are GPL-2.0-only (the kernel's helpers ask for it)
license=(MIT GPL-2.0-only)
# Kernel: CONFIG_CGROUP_BPF, CONFIG_BPF_SYSCALL, ring buffers (5.8), cgroup v2; no BPF LSM (on
# arm64, 6.1 cannot attach BPF to kernel functions). The app pages of gnome-control-center-plinius
# ask over D-Bus (org.plinius.AppAccess1); the agent asks the user in the session. The microphone
# is decided in WirePlumber (find-plinius-microphone-access.lua: permission managers, ProcUtils,
# Conf of a single file, file-monitor-api).
depends=(glib2 libbpf systemd)
# The questions in Phosh's access dialog with its three buttons (0109); without it notifications
optdepends=("phosh-plinius>=0.59.0-21: the questions in Phosh's access dialog"
	"wireplumber>=0.5.19: the microphone per app")
makedepends=(clang llvm)
_langs=(de es fr it nl pl pt ru)
source=(appaccess.h
	appaccess.bpf.c
	plinius-appaccessd.c
	plinius-appaccess-agent.c
	plinius-appaccessd.service
	plinius-appaccess-agent.service
	org.plinius.AppAccess1.conf
	org.plinius.AppAccess1.service
	plinius-appaccess-microphone.lua
	find-plinius-microphone-access.lua
	70-plinius-microphone-access.conf
	LICENSE
	"${_langs[@]/%/.po}")
