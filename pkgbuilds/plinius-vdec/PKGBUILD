build() {
	# The plugin: the decoder in the app, each frame's MDP conversion through plinius-vdec-mdpd
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -fPIC -shared \
		-o libgstpliniusvdec.so gstpliniusvdec.c mdp-client.c \
		$(pkg-config --cflags --libs gstreamer-1.0 gstreamer-video-1.0 gstreamer-allocators-1.0 gio-2.0) $LDFLAGS
	# The encoder plugin: frames from dma-bufs into the MediaTek encoder
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -fPIC -shared \
		-o libgstpliniusvenc.so gstpliniusvenc.c \
		$(pkg-config --cflags --libs gstreamer-1.0 gstreamer-video-1.0) $LDFLAGS
	# The daemon with libdpframework through libhybris
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers \
		-o plinius-vdec-mdpd mdpd.c mdp.c $(pkg-config --cflags --libs gio-2.0) -ldl $LDFLAGS
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 libgstpliniusvdec.so libgstpliniusvenc.so -t "$pkgdir/usr/lib/gstreamer-1.0"
	install -Dm644 73-plinius-vdec.rules -t "$pkgdir/usr/lib/udev/rules.d"
	install -Dm755 plinius-vdec-mdpd -t "$pkgdir/usr/lib/plinius-vdec"
	install -Dm644 plinius-vdec-mdpd.service plinius-vdec-mdpd.socket -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 plinius-vdec.sysusers "$pkgdir/usr/lib/sysusers.d/plinius-vdec.conf"
	install -d "$pkgdir/usr/lib/systemd/system/sockets.target.wants"
	ln -s ../plinius-vdec-mdpd.socket "$pkgdir/usr/lib/systemd/system/sockets.target.wants/"
}
