# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-vdec
pkgver=0.2
pkgrel=9
pkgdesc="Hardware video decoding (H.264, H.265, VP9) and H.264 encoding for GStreamer on the Volla Phone Plinius: MediaTek decoder plus MDP colour conversion in a service of its own, MediaTek encoder"
arch=(aarch64)  # needs the vendor's libdpframework through libhybris
license=(MIT)
depends=(gstreamer gst-plugins-base-libs glib2 libhybris systemd)
install=plinius-vdec.install
source=(gstpliniusvdec.c
	gstpliniusvenc.c
	mdp.c
	mdp.h
	mdp-proto.h
	mdp-client.c
	mdpd.c
	plinius-vdec-mdpd.service
	plinius-vdec-mdpd.socket
	plinius-vdec.sysusers
	73-plinius-vdec.rules
	LICENSE)
sha256sums=('61a88165e190b117dde5cb948a1bcdb49be2893bc31dfeb1a9563c921a5d1a7a'
	'8a334437b5358e4866e8d4dbff2a8b6e31527d70121345adb1b63df952ddb746'
	'b21196d4d3fe49116066e76dded4660a5ea6b4ebd1c57bccbcce24502c130eac'
