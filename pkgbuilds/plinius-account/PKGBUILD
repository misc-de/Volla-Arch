build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 plinius-rename-user plinius-add-user -t "$pkgdir/usr/bin"
	install -Dm755 rename-user-boot dconf-rename -t "$pkgdir/usr/lib/plinius-account"
	install -Dm644 org.plinius.account.policy -t "$pkgdir/usr/share/polkit-1/actions"
	# Lingering (services without a session) only for administrators
	install -Dm644 60-plinius-account-linger.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
	install -Dm644 plinius-account-rename.service -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 plinius-account-dconf.service -t "$pkgdir/usr/lib/systemd/user"
	# Both units do nothing without a pending request (ConditionPathExists), so always enabled
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants" \
		"$pkgdir/usr/lib/systemd/user/default.target.wants"
	ln -s ../plinius-account-rename.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	ln -s ../plinius-account-dconf.service "$pkgdir/usr/lib/systemd/user/default.target.wants/"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-account.mo"
	done
}
