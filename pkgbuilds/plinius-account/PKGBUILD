# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-account
pkgver=0.6
pkgrel=2
pkgdesc="Rename your own user account including home directory and all references, add local accounts (backends for GNOME Settings)"
arch=(any)
license=(MIT)
# UI: Accounts > Local Accounts in gnome-control-center-plinius (Username on one's own page, Add in
# the header bar)
# Error messages of plinius-rename-user and plinius-add-user are English, translated in *.po (template
# plinius-account.pot); GNOME Settings shows them in a toast.
depends=(bash shadow procps-ng findutils grep sed util-linux polkit dconf gettext systemd)
makedepends=(gettext)
# Takes video, audio and radio from accounts without administrator rights that 0.6-1 added
install=plinius-account.install
_langs=(de es fr it nl pl pt ru)
source=(plinius-rename-user
	plinius-add-user
	rename-user-boot
	dconf-rename
	org.plinius.account.policy
	60-plinius-account-linger.rules
	plinius-account-rename.service
	plinius-account-dconf.service
	"${_langs[@]/%/.po}"
	LICENSE)
sha256sums=('5129d9ef61b2e0d7a49fed0f3ee69e74a80ce8ae76a9c654a13f66fdd3699f03'
	'f34905e7e7123c76dc88cab4ecc9340b5fa807186a927fb3276b4e09ca17298a'
	'6b7afead06f606572155e4be70b06619af575c2fd193d2333c7f314eb3fbb1fa'
