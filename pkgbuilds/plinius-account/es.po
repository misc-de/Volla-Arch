#: plinius-rename-user:38
msgid "usage: plinius-rename-user OLD NEW | --status | --cancel"
msgstr "uso: plinius-rename-user ANTIGUO NUEVO | --status | --cancel"

#: plinius-rename-user:40
msgid "must be run as root"
msgstr "debe ejecutarse como root"

#: plinius-rename-user:43
msgid "only your own account can be renamed"
msgstr "solo se puede renombrar la propia cuenta"

#: plinius-rename-user:45
#, sh-printf-format
msgid "user %s does not exist"
msgstr "el usuario %s no existe"

#: plinius-rename-user:46
#, sh-printf-format
msgid "%s is not a regular user"
msgstr "%s no es un usuario normal"

#: plinius-rename-user:48
msgid "invalid name: lower case letters, digits, _ and -, starting with a letter or _, at most 32 characters"
msgstr "nombre no válido: minúsculas, dígitos, _ y -, empezando por una letra o _, como máximo 32 caracteres"

#: plinius-rename-user:49
#, sh-printf-format
msgid "user %s already exists"
msgstr "el usuario %s ya existe"

#: plinius-rename-user:50
#, sh-printf-format
msgid "group %s already exists"
msgstr "el grupo %s ya existe"

#: plinius-rename-user:51
#, sh-printf-format
msgid "%s already exists"
msgstr "%s ya existe"

#: plinius-add-user:37
msgid "usage: plinius-add-user USER FULL-NAME [--admin] < password"
msgstr "uso: plinius-add-user USUARIO NOMBRE-COMPLETO [--admin] < contraseña"

#: plinius-add-user:47
msgid "the full name is longer than 64 characters"
msgstr "el nombre completo tiene más de 64 caracteres"

#: plinius-add-user:50
msgid "a password is needed"
msgstr "se necesita una contraseña"

#: plinius-add-user:60
#, sh-printf-format
msgid "no free user ID between %s and %s"
msgstr "no hay ningún ID de usuario libre entre %s y %s"

#: plinius-add-user:73
msgid "the account could not be created"
msgstr "no se pudo crear la cuenta"

#: plinius-add-user:79
msgid "the password could not be set, the account was removed again"
msgstr "no se pudo establecer la contraseña, la cuenta se ha eliminado de nuevo"
