#: plinius-rename-user:38
msgid "usage: plinius-rename-user OLD NEW | --status | --cancel"
msgstr "gebruik: plinius-rename-user OUD NIEUW | --status | --cancel"

#: plinius-rename-user:40
msgid "must be run as root"
msgstr "moet als root worden uitgevoerd"

#: plinius-rename-user:43
msgid "only your own account can be renamed"
msgstr "alleen je eigen account kan worden hernoemd"

#: plinius-rename-user:45
#, sh-printf-format
msgid "user %s does not exist"
msgstr "gebruiker %s bestaat niet"

#: plinius-rename-user:46
#, sh-printf-format
msgid "%s is not a regular user"
msgstr "%s is geen gewone gebruiker"

#: plinius-rename-user:48
msgid "invalid name: lower case letters, digits, _ and -, starting with a letter or _, at most 32 characters"
msgstr "ongeldige naam: kleine letters, cijfers, _ en -, beginnend met een letter of _, hoogstens 32 tekens"

#: plinius-rename-user:49
#, sh-printf-format
msgid "user %s already exists"
msgstr "gebruiker %s bestaat al"

#: plinius-rename-user:50
#, sh-printf-format
msgid "group %s already exists"
msgstr "groep %s bestaat al"

#: plinius-rename-user:51
#, sh-printf-format
msgid "%s already exists"
msgstr "%s bestaat al"

#: plinius-add-user:37
msgid "usage: plinius-add-user USER FULL-NAME [--admin] < password"
msgstr "gebruik: plinius-add-user GEBRUIKER VOLLEDIGE-NAAM [--admin] < wachtwoord"

#: plinius-add-user:47
msgid "the full name is longer than 64 characters"
msgstr "de volledige naam is langer dan 64 tekens"

#: plinius-add-user:50
msgid "a password is needed"
msgstr "er is een wachtwoord nodig"

#: plinius-add-user:60
#, sh-printf-format
msgid "no free user ID between %s and %s"
msgstr "geen vrije gebruikers-ID tussen %s en %s"

#: plinius-add-user:73
msgid "the account could not be created"
msgstr "het account kon niet worden aangemaakt"

#: plinius-add-user:79
msgid "the password could not be set, the account was removed again"
msgstr "het wachtwoord kon niet worden ingesteld, het account is weer verwijderd"
