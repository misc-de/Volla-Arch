#: plinius-rename-user:38
msgid "usage: plinius-rename-user OLD NEW | --status | --cancel"
msgstr "Aufruf: plinius-rename-user ALT NEU | --status | --cancel"

#: plinius-rename-user:40
msgid "must be run as root"
msgstr "nur als root"

#: plinius-rename-user:43
msgid "only your own account can be renamed"
msgstr "nur das eigene Konto lässt sich umbenennen"

#: plinius-rename-user:45
#, sh-printf-format
msgid "user %s does not exist"
msgstr "Benutzer %s gibt es nicht"

#: plinius-rename-user:46
#, sh-printf-format
msgid "%s is not a regular user"
msgstr "%s ist kein normaler Benutzer"

#: plinius-rename-user:48
msgid "invalid name: lower case letters, digits, _ and -, starting with a letter or _, at most 32 characters"
msgstr "ungültiger Name: Kleinbuchstaben, Ziffern, _ und -, beginnend mit Buchstabe oder _, höchstens 32 Zeichen"

#: plinius-rename-user:49
#, sh-printf-format
msgid "user %s already exists"
msgstr "Benutzer %s gibt es schon"

#: plinius-rename-user:50
#, sh-printf-format
msgid "group %s already exists"
msgstr "Gruppe %s gibt es schon"

#: plinius-rename-user:51
#, sh-printf-format
msgid "%s already exists"
msgstr "%s gibt es schon"

#: plinius-add-user:37
msgid "usage: plinius-add-user USER FULL-NAME [--admin] < password"
msgstr "Aufruf: plinius-add-user NAME VOLLER-NAME [--admin] < Passwort"

#: plinius-add-user:47
msgid "the full name is longer than 64 characters"
msgstr "der vollständige Name ist länger als 64 Zeichen"

#: plinius-add-user:50
msgid "a password is needed"
msgstr "ein Passwort ist nötig"

#: plinius-add-user:60
#, sh-printf-format
msgid "no free user ID between %s and %s"
msgstr "keine freie Benutzerkennung zwischen %s und %s"

#: plinius-add-user:73
msgid "the account could not be created"
msgstr "das Konto ließ sich nicht anlegen"

#: plinius-add-user:79
msgid "the password could not be set, the account was removed again"
msgstr "das Passwort ließ sich nicht setzen, das Konto wurde wieder entfernt"
