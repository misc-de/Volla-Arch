#: plinius-rename-user:38
msgid "usage: plinius-rename-user OLD NEW | --status | --cancel"
msgstr "использование: plinius-rename-user СТАРОЕ НОВОЕ | --status | --cancel"

#: plinius-rename-user:40
msgid "must be run as root"
msgstr "нужно запускать от имени root"

#: plinius-rename-user:43
msgid "only your own account can be renamed"
msgstr "переименовать можно только собственную учётную запись"

#: plinius-rename-user:45
#, sh-printf-format
msgid "user %s does not exist"
msgstr "пользователь %s не существует"

#: plinius-rename-user:46
#, sh-printf-format
msgid "%s is not a regular user"
msgstr "%s не является обычным пользователем"

#: plinius-rename-user:48
msgid "invalid name: lower case letters, digits, _ and -, starting with a letter or _, at most 32 characters"
msgstr "недопустимое имя: строчные латинские буквы, цифры, _ и -, начинается с буквы или _, не более 32 символов"

#: plinius-rename-user:49
#, sh-printf-format
msgid "user %s already exists"
msgstr "пользователь %s уже существует"

#: plinius-rename-user:50
#, sh-printf-format
msgid "group %s already exists"
msgstr "группа %s уже существует"

#: plinius-rename-user:51
#, sh-printf-format
msgid "%s already exists"
msgstr "%s уже существует"

#: plinius-add-user:37
msgid "usage: plinius-add-user USER FULL-NAME [--admin] < password"
msgstr "использование: plinius-add-user ПОЛЬЗОВАТЕЛЬ ПОЛНОЕ-ИМЯ [--admin] < пароль"

#: plinius-add-user:47
msgid "the full name is longer than 64 characters"
msgstr "полное имя длиннее 64 символов"

#: plinius-add-user:50
msgid "a password is needed"
msgstr "нужен пароль"

#: plinius-add-user:60
#, sh-printf-format
msgid "no free user ID between %s and %s"
msgstr "нет свободного идентификатора пользователя между %s и %s"

#: plinius-add-user:73
msgid "the account could not be created"
msgstr "не удалось создать учётную запись"

#: plinius-add-user:79
msgid "the password could not be set, the account was removed again"
msgstr "не удалось задать пароль, учётная запись удалена"
