#: plinius-rename-user:38
msgid "usage: plinius-rename-user OLD NEW | --status | --cancel"
msgstr "użycie: plinius-rename-user STARA NOWA | --status | --cancel"

#: plinius-rename-user:40
msgid "must be run as root"
msgstr "należy uruchomić jako root"

#: plinius-rename-user:43
msgid "only your own account can be renamed"
msgstr "można zmienić nazwę tylko własnego konta"

#: plinius-rename-user:45
#, sh-printf-format
msgid "user %s does not exist"
msgstr "użytkownik %s nie istnieje"

#: plinius-rename-user:46
#, sh-printf-format
msgid "%s is not a regular user"
msgstr "%s nie jest zwykłym użytkownikiem"

#: plinius-rename-user:48
msgid "invalid name: lower case letters, digits, _ and -, starting with a letter or _, at most 32 characters"
msgstr "nieprawidłowa nazwa: małe litery, cyfry, _ i -, na początku litera lub _, najwyżej 32 znaki"

#: plinius-rename-user:49
#, sh-printf-format
msgid "user %s already exists"
msgstr "użytkownik %s już istnieje"

#: plinius-rename-user:50
#, sh-printf-format
msgid "group %s already exists"
msgstr "grupa %s już istnieje"

#: plinius-rename-user:51
#, sh-printf-format
msgid "%s already exists"
msgstr "%s już istnieje"

#: plinius-add-user:37
msgid "usage: plinius-add-user USER FULL-NAME [--admin] < password"
msgstr "użycie: plinius-add-user UŻYTKOWNIK PEŁNA-NAZWA [--admin] < hasło"

#: plinius-add-user:47
msgid "the full name is longer than 64 characters"
msgstr "pełna nazwa jest dłuższa niż 64 znaki"

#: plinius-add-user:50
msgid "a password is needed"
msgstr "potrzebne jest hasło"

#: plinius-add-user:60
#, sh-printf-format
msgid "no free user ID between %s and %s"
msgstr "brak wolnego identyfikatora użytkownika między %s a %s"

#: plinius-add-user:73
msgid "the account could not be created"
msgstr "nie można utworzyć konta"

#: plinius-add-user:79
msgid "the password could not be set, the account was removed again"
msgstr "nie można ustawić hasła, konto zostało ponownie usunięte"
