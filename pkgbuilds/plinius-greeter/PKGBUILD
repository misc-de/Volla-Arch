build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	install -Dm755 plinius-greeter plinius-greeter-config plinius-greeter-session \
		-t "$pkgdir/usr/lib/plinius-greeter"
	install -Dm644 plinius_greeter_accounts.py -t "$pkgdir/usr/lib/plinius-greeter"
	install -Dm644 greetd-plinius-greeter.conf "$pkgdir/usr/lib/systemd/system/greetd.service.d/plinius-greeter.conf"
	install -Dm644 plinius-greeter-login.path plinius-greeter-login.service plinius-greeter-password.path \
		plinius-greeter-password.service -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 plinius-greeter.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/plinius-greeter.conf"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-greeter.mo"
	done
}
