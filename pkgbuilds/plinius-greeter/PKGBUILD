# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-greeter
pkgver=0.1
pkgrel=4
pkgdesc="Account picker in front of Phosh for phones with more than one account (greetd)"
arch=(any)
license=(MIT)
# With one login account the phone logs in at once as before (greetd's initial_session from
# /etc/greetd/config.toml); with more, greetd starts in the greeter, a tap starts that account's
# Phosh, which locks itself (PIN or pattern as usual). An account without a password yet (an image
# for everybody, Plinius Boot) is asked once for a PIN or a password in the greeter, the PIN on its
# own keypad, a password with Stevia. After a session ends the greeter shows
# instead of agreety. New accounts: Accounts > Local Accounts > Add in gnome-control-center-plinius
# (plinius-account's plinius-add-user). Strings are English, translated in *.po (template
# plinius-greeter.pot).
depends=(greetd phoc python python-gobject gtk4 libadwaita accountsservice systemd dbus cryptsetup shadow)
# The on-screen keyboard for a first password
optdepends=(stevia)
makedepends=(gettext)
_langs=(de es fr it nl pl pt ru)
source=(plinius-greeter
	plinius_greeter_accounts.py
	plinius-greeter-config
	plinius-greeter-session
	greetd-plinius-greeter.conf
	plinius-greeter-login.path
	plinius-greeter-login.service
	plinius-greeter-password.path
	plinius-greeter-password.service
	plinius-greeter.tmpfiles
	"${_langs[@]/%/.po}"
	LICENSE)
sha256sums=('f99509e3462fde4ce944ac4245d0efab06127ae2af3a555c421b83cba2d7ba8a'
