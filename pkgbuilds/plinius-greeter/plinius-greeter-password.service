# Sets the first PIN or password of an account that has none yet, never the password of the
# encryption, then starts its session (plinius-greeter-config password). Reads and removes the
# greeter's file at once.
[Unit]
Description=Set the first password asked for in the greeter

[Service]
Type=oneshot
ExecStart=/usr/lib/plinius-greeter/plinius-greeter-config password
StateDirectory=plinius-greeter
StateDirectoryMode=0755
ProtectSystem=strict
# chpasswd writes /etc/shadow; cryptsetup checks the password against the open encryption, hence
# the devices
ReadWritePaths=/run /etc
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
