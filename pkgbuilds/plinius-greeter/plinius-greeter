    def show_mode(self):
        """The first start in the installation's look without a clock, else the account picker."""
        first = bool(self.first)
        if first:
            self.add_css_class("first-start")
        else:
            self.remove_css_class("first-start")
        self.clock.set_visible(not first)
        self.date.set_visible(not first)
        self.column.set_margin_top(COLUMN_TOP_FIRST if first else COLUMN_TOP)
        self.subtitle.set_margin_bottom(12 if first else 24)
        self.first_box.set_visible(first)
        self.installation_bg.set_visible(first)
        if self.dust is not None:
            self.dust.set_visible(first)
            self.dust.set_running(first and not self.blanked)

    # ----- accounts -----

    def load_accounts(self):
        self.accounts = base_accounts()
        self.fill()
        if AccountsService is None or TEST:
            return
        # AccountsService knows the pictures and the locked accounts; it can come late or not at all
        manager = AccountsService.UserManager.get_default()
        if manager.props.is_loaded:
            self.from_accounts_service(manager)
        else:
            manager.connect("notify::is-loaded", lambda m, _p: self.from_accounts_service(m))

    def from_accounts_service(self, manager):
        if not manager.props.is_loaded or manager.no_service():
            return
        known = {u.get_user_name(): u for u in manager.list_users()}
        result = []
        for account in self.accounts:
            user = known.get(account.name)
            if user is not None and user.is_loaded():
                if user.get_locked():
                    continue
                icon = user.get_icon_file()
                if icon and os.path.isfile(icon):
                    account.icon = icon
            result.append(account)
        self.accounts = result
        self.fill()

    def fill(self):
        if self.choosing:
            return
        if self.first:
            # One question instead of the accounts: nothing to pick, nothing logged in by itself
            self.title.set_label(_("Protect your phone"))
            self.subtitle.set_label(_("Choose how to unlock it. Settings and every other question for the password "
                                      "ask for the same."))
            return
        while (child := self.rows.get_first_child()) is not None:
            self.rows.remove(child)
        self.tiles = {}
        account_list = ordered(self.accounts, self.last)
        # A single account to offer (the others locked) is no choice: log it in without showing it.
        # Only once: after a failed start its tile shows, to try again by hand.
        single = len(account_list) == 1 and not self.failed
        self.title.set_visible(not single)
        self.subtitle.set_visible(not single)
        if single:
            GLib.idle_add(self.choose, account_list[0])
            return
        row = None
        for i, account in enumerate(account_list):
            if i % 2 == 0:
                row = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, homogeneous=True)
                self.rows.append(row)
            tile = self.make_tile(account, account.name == self.last and len(account_list) > 1)
            self.tiles[account.name] = tile
            row.append(tile)

    def make_tile(self, account, last):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        ring = Gtk.Box(halign=Gtk.Align.CENTER, css_classes=["avatar-ring"])
        avatar = Adw.Avatar(size=88, text=account.name, show_initials=True)
        if account.icon:
            try:
                avatar.set_custom_image(Gdk.Texture.new_from_filename(account.icon))
            except GLib.Error:
                pass
        ring.append(avatar)
        box.append(ring)
        name = Gtk.Label(label=account.name, css_classes=["user-name"], ellipsize=Pango.EllipsizeMode.END,
                         max_width_chars=12)
        box.append(name)

        button = Gtk.Button(child=box, css_classes=["user-tile"], width_request=156)
        if last:
            button.add_css_class("last")
        button.update_property([Gtk.AccessibleProperty.LABEL], [account.name])
        button.connect("clicked", lambda _b: (feedback(), self.choose(account)))
        return button

    # ----- the first start -----

    def make_first_start(self):
        """The question of the first start laid out as Phosh's unlock page: the status, the PIN, the
        keypad with the keyboard bottom left and delete bottom right, the button below it."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, halign=Gtk.Align.CENTER)
        self.first_prompt = Gtk.Label(css_classes=["unlock-status"], wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.first_prompt)

        # The PIN: dots, the keypad and the button to go on
        self.pin_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, halign=Gtk.Align.CENTER)
        self.dots = Gtk.Label(css_classes=["pin-dots"])
        self.dots.set_margin_top(12)
        self.dots.set_margin_bottom(12)
        self.pin_box.append(self.dots)
        # Rows exactly as tall as the keys, as on the lock screen: GTK 4 aligns the baselines of labels in
        # a row of the grid (homogeneous ones even more), which makes rows taller than their keys. Each
        # key sits in a box of its own, which gives no baseline.
        keypad = Gtk.Grid(row_spacing=KEYPAD_SPACING, column_spacing=KEYPAD_SPACING, halign=Gtk.Align.CENTER)
        keypad.set_margin_top(12)
        keypad.set_margin_bottom(12)
        keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "password", "0", "back"]
        self.keys = {}
        for i, key in enumerate(keys):
            if key == "back":
                button = Gtk.Button(icon_name="edit-clear-symbolic", **KEY_PROPS)
                button.update_property([Gtk.AccessibleProperty.LABEL], [_("Delete")])
                # As on the lock screen: a long press clears the PIN
                hold = Gtk.GestureLongPress()
                hold.connect("pressed", lambda *_a: self.on_key("clear"))
                button.add_controller(hold)
            elif key == "password":
                button = Gtk.Button(icon_name="input-keyboard-symbolic", **KEY_PROPS)
                button.update_property([Gtk.AccessibleProperty.LABEL], [_("Password")])
            else:
                button = Gtk.Button(label=key, **KEY_PROPS)
            button.connect("clicked", lambda _b, k=key: self.on_key(k))
            self.keys[key] = button
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            cell.append(button)
            keypad.attach(cell, i % 3, i // 3, 1, 1)
        self.pin_box.append(keypad)
        self.pin_next = Gtk.Button(label=_("Continue"), css_classes=["pin-submit"], halign=Gtk.Align.CENTER,
                                   sensitive=False)
        self.pin_next.connect("clicked", lambda _b: self.on_key("next"))
        self.keys["next"] = self.pin_next
        self.pin_box.append(self.pin_next)
        box.append(self.pin_box)

        # The password: two fields and the on-screen keyboard instead of the keypad, as on the lock
        # screen; the keypad button goes back to the PIN
        self.password_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, visible=False, width_request=300)
        self.password_box.set_margin_top(12)
        self.secret = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text=_("Password"))
        self.again = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text=_("Repeat password"))
        self.again.connect("activate", lambda _e: self.submit_password())
        self.secret.connect("activate", lambda _e: self.again.grab_focus())
        self.password_box.append(self.secret)
        self.password_box.append(self.again)
        row = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER)
        row.set_margin_top(12)
        self.pin_mode = Gtk.Button(icon_name="input-dialpad-symbolic", css_classes=["pin-mode"], valign=Gtk.Align.CENTER)
        self.pin_mode.update_property([Gtk.AccessibleProperty.LABEL], [_("PIN")])
        self.pin_mode.connect("clicked", lambda _b: (feedback(), self.set_kind("pin")))
        row.append(self.pin_mode)
        self.password_next = Gtk.Button(label=_("Continue"), css_classes=["pin-submit"], valign=Gtk.Align.CENTER)
        self.password_next.connect("clicked", lambda _b: self.submit_password())
        row.append(self.password_next)
        self.password_box.append(row)
        box.append(self.password_box)
        self.update_first_prompt()
        return box

    def fit_keypad(self, width, height):
        """Keypad buttons and digits as big as on Phosh's lock screen of this size."""
        if width <= 0 or height <= 0:
            return
        if self.keypad_css is None:
            self.keypad_css = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.keypad_css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.keypad_css.load_from_string(keypad_css(keypad_button_size(width, height)))

    def set_kind(self, kind):
        if self.kind == kind:
            return
        self.kind, self.digits, self.first_pin = kind, "", None
        self.pin_box.set_visible(kind == "pin")
        self.password_box.set_visible(kind == "password")
        self.status.set_opacity(0)
        self.update_first_prompt()
        if kind == "password":
            self.start_keyboard()
            self.secret.grab_focus()

    def update_first_prompt(self):
        if self.kind == "pin":
            self.first_prompt.set_label(_("Repeat the PIN.") if self.first_pin is not None
                                        else _("Choose a PIN of 4 to 12 digits."))
            self.dots.set_label("●" * len(self.digits))
            self.pin_next.set_sensitive(bool(self.digits))
        else:
            self.first_prompt.set_label(_("Choose a password of at least 6 characters."))

    def on_key(self, key):
        if self.password_timeout:
            return
        feedback()
        if key == "password":
            self.set_kind("password")
            return
        if key == "back":
            self.digits = self.digits[:-1]
        elif key == "clear":
            self.digits = ""
        elif key == "next":
            self.next_pin()
            return
        elif len(self.digits) < PIN_DIGITS[1]:
            self.digits += key
        self.update_first_prompt()

    def next_pin(self):
        if self.first_pin is None:
            problem = secret_problem("pin", self.digits, self.digits)
            if problem:
                self.show_status(problem, error=True)
                return
            self.first_pin, self.digits = self.digits, ""
            self.status.set_opacity(0)
            self.update_first_prompt()
            return
        problem = secret_problem("pin", self.first_pin, self.digits)
        if problem:
            self.first_pin, self.digits = None, ""
            self.update_first_prompt()
            self.show_status(problem, error=True)
            return
        self.submit(self.first_pin)

    def submit_password(self):
        if self.password_timeout:
            return
        feedback()
        secret, again = self.secret.get_text(), self.again.get_text()
        problem = secret_problem("password", secret, again)
        if problem:
            self.show_status(problem, error=True)
            return
        self.submit(secret)

    def start_keyboard(self):
        """Stevia for the password: greetd's session has no Phosh to start it. GSettings of its own, with the
        keyboard turned on (the greeter's are in memory only)."""
        if self.keyboard is not None or TEST or not os.access(KEYBOARD, os.X_OK):
            return
        config = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "plinius-greeter-keyboard")
        try:
            os.makedirs(os.path.join(config, "glib-2.0/settings"), mode=0o700, exist_ok=True)
            with open(os.path.join(config, "glib-2.0/settings/keyfile"), "w", encoding="utf-8") as f:
                f.write("[org/gnome/desktop/a11y/applications]\nscreen-keyboard-enabled=true\n")
            # XDG_SESSION_CLASS: Stevia offers no settings in a greeter (stevia-plinius 0014)
            env = dict(os.environ, GSETTINGS_BACKEND="keyfile", XDG_CONFIG_HOME=config,
                       XDG_SESSION_CLASS="greeter")
            self.keyboard = subprocess.Popen([KEYBOARD], env=env, stdin=subprocess.DEVNULL)
        except OSError as e:
            print(f"plinius-greeter: on-screen keyboard: {e}", file=sys.stderr)

    def result_stamp(self):
        try:
            st = os.stat(PASSWORD_RESULT)
            return st.st_mtime_ns, st.st_ino
        except OSError:
            return None

    def submit(self, secret):
        """Hands the PIN or password to root (plinius-greeter-config password) and waits for its answer."""
        self.result_before = self.result_stamp()
        try:
            if TEST:
                print(f"plinius-greeter: first {self.kind} for {self.first}", flush=True)
            else:
                tmp = os.path.join(REQUEST_DIR, "password.tmp")
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, "w") as f:
                    json.dump({"user": self.first, "secret": secret}, f)
                os.replace(tmp, os.path.join(REQUEST_DIR, "password"))
        except OSError as e:
            print(f"plinius-greeter: cannot hand over the password: {e}", file=sys.stderr)
            self.password_failed(_("The password could not be set. Please try again."))
            return
        self.first_box.set_sensitive(False)
        self.show_status(_("Setting it up…"), busy=True)
        self.waited = 0
        self.password_timeout = GLib.timeout_add(500, self.check_result)

    def check_result(self):
        self.waited += 500
        stamp = self.result_stamp()
        if stamp is None or stamp == self.result_before:
            if self.waited >= PASSWORD_TIMEOUT_SECONDS * 1000:
                self.password_timeout = 0
                self.password_failed(_("The password could not be set. Please try again."))
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE
        self.password_timeout = 0
        try:
            with open(PASSWORD_RESULT, encoding="utf-8") as f:
                result = f.read(64).strip()
        except OSError:
            result = "failed"
        if result == "ok":
            # Root logs the account in now; as after a tap, try again should it not start
            self.choosing = Account(self.first)
            self.show_status(_("Starting…"), busy=True)
            self.start_timeout = GLib.timeout_add_seconds(START_TIMEOUT_SECONDS, self.fail)
        elif result == "same":
            self.password_failed(_("That is the password of the encryption. Choose another one: it is typed in "
                                   "view of others many times a day."))
        elif result == "invalid":
            self.password_failed(_("That cannot be used. A PIN has 4 to 12 digits, a password at least 6 characters."))
        else:
            self.password_failed(_("The password could not be set. Please try again."))
        return GLib.SOURCE_REMOVE

    def password_failed(self, text):
        self.first_box.set_sensitive(True)
        self.digits, self.first_pin = "", None
        self.secret.set_text("")
        self.again.set_text("")
        self.update_first_prompt()
        self.show_status(text, error=True)

    # ----- logging in -----

    def choose(self, account):
        if self.choosing:
            return GLib.SOURCE_REMOVE
        self.choosing = account
        for name, tile in self.tiles.items():
            tile.set_can_target(False)
            tile.add_css_class("chosen" if name == account.name else "dimmed")
        self.show_status(_("Starting…"), busy=True)
        try:
            self.write_request(account.name)
        except OSError as e:
            print(f"plinius-greeter: cannot hand over {account.name}: {e}", file=sys.stderr)
            self.fail()
            return GLib.SOURCE_REMOVE
        # greetd ends this session once the account's session starts; if it does not, try again
        self.start_timeout = GLib.timeout_add_seconds(START_TIMEOUT_SECONDS, self.fail)
        return GLib.SOURCE_REMOVE

    def write_request(self, name):
        if TEST:
            print(f"plinius-greeter: request {name}", flush=True)
            return
        tmp = os.path.join(REQUEST_DIR, "request.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(name + "\n")
        os.replace(tmp, os.path.join(REQUEST_DIR, "request"))

    def fail(self):
        self.start_timeout = 0
        self.choosing = None
        self.failed = True
        # The password is set by now (root removed first-start): the account is a tile from here on
        self.first = read_first_start()
        self.show_mode()
        self.first_box.set_sensitive(True)
        self.title.set_label(_("Who is using the phone?"))
        self.subtitle.set_label(_("Tap your account, then unlock it as usual."))
        self.fill()
        self.show_status(_("The phone could not start this account. Please try again."), error=True)
        # The idle timer may have run out while the account started (on_idle leaves the screen on
        # then): dark again after IDLE_SECONDS without a touch
        if not self.blanked:
            self.restart_idle()
        return GLib.SOURCE_REMOVE

    def show_status(self, text, busy=False, error=False):
        self.status_label.set_label(text)
        self.spinner.set_visible(busy)
        if error:
            self.status_label.add_css_class("error")
        else:
            self.status_label.remove_css_class("error")
        self.status.set_opacity(1)

    # ----- clock -----

    def update_clock(self):
        now = GLib.DateTime.new_now_local()
        self.clock.set_label(now.format(self.time_format).strip())
        # Translators: the date below the clock (GLib's strftime codes), e.g. "%A, %-d. %B" in German
        self.date.set_label(now.format(_("%A, %B %-d")))
        return GLib.SOURCE_CONTINUE

    # ----- power -----

    def make_power_menu(self):
        """Phosh's power menu without what only a session has (screenshot, restarting Phosh, lock,
        log out): a card over the darkened screen, the close button at its top right, Power Off and
        Restart one below the other."""
        backdrop = Gtk.Box(css_classes=["power-menu"], visible=False, can_target=True)
        # The close button's circle (40 px) sits on the card's corner, 3 px in from it
        holder = Gtk.Overlay(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, hexpand=True, vexpand=True)
        self.power_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=17, css_classes=["power-card"])
        for side in ("top", "bottom", "start", "end"):
            getattr(self.power_card, f"set_margin_{side}")(17)
        holder.set_child(self.power_card)
        close = Gtk.Button(child=Gtk.Image(icon_name="window-close-symbolic", pixel_size=20),
                           css_classes=["power-close"], halign=Gtk.Align.END, valign=Gtk.Align.START)
        close.update_property([Gtk.AccessibleProperty.LABEL], [_("_Cancel").replace("_", "")])
        close.connect("clicked", lambda _b: (feedback(), self.hide_power_menu()))
        holder.add_overlay(close)
        self.power_entries = {}
        for method, icon, label in (("PowerOff", "system-shutdown-symbolic", _("_Power Off")),
                                    ("Reboot", "system-reboot-symbolic", _("_Restart"))):
            row = Gtk.Box(spacing=12, halign=Gtk.Align.START, hexpand=True)
            row.set_margin_start(22)
            row.set_margin_end(22)
            row.append(Gtk.Image(icon_name=icon, pixel_size=24))
            row.append(Gtk.Label(label=label, use_underline=True))
            button = Gtk.Button(child=row, css_classes=["entry"])
            button.update_property([Gtk.AccessibleProperty.LABEL], [label.replace("_", "")])
            button.connect("clicked", lambda _b, m=method: self.power(m))
            self.power_entries[method] = button
            self.power_card.append(button)
        backdrop.append(holder)
        # A tap beside the card closes the menu
        tap = Gtk.GestureClick()
        tap.connect("released", lambda _g, _n, x, y: self.on_power_menu_tap(x, y))
        backdrop.add_controller(tap)
        return backdrop

    def show_power_menu(self):
        self.power_menu.set_visible(True)

    def hide_power_menu(self):
        self.power_menu.set_visible(False)

    def on_power_menu_tap(self, x, y):
        ok, bounds = self.power_card.compute_bounds(self.power_menu)
        if not ok or not bounds.contains_point(Graphene.Point().init(x, y)):
            self.hide_power_menu()

    def power(self, method):
        """Powers off or restarts at once, as asked in the menu (logind)."""
        feedback()
        self.hide_power_menu()
        if TEST:
            print(f"plinius-greeter: {method}", flush=True)
            return
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        bus.call("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                 method, GLib.Variant("(b)", (False,)), None, Gio.DBusCallFlags.NONE, -1, None, None)

    # ----- dark screen -----

    def on_any_event(self, _controller, _event):
        if not self.blanked:
            self.restart_idle()
        return False

    def restart_idle(self):
        if self.idle_timeout:
            GLib.source_remove(self.idle_timeout)
        self.idle_timeout = GLib.timeout_add_seconds(IDLE_SECONDS, self.on_idle)

    def on_idle(self):
        self.idle_timeout = 0
        if not self.choosing:
            self.blank_screen()
        return GLib.SOURCE_REMOVE

    def blank_screen(self):
        if self.blanked:
            return
        self.blanked = True
        self.blank.set_visible(True)
        self.hide_power_menu()
        if self.dust is not None:
            self.dust.set_running(False)
        self.saved_brightness = set_backlight(0)

    def wake(self):
        if not self.blanked:
            return
        self.blanked = False
        self.blank.set_visible(False)
        if self.dust is not None:
            self.dust.set_running(bool(self.first))
        if self.saved_brightness is not None:
            set_backlight(self.saved_brightness)
            self.saved_brightness = None
        self.restart_idle()

    def on_key_pressed(self, _controller, keyval, _keycode, _state):
        if keyval == Gdk.KEY_Escape and self.power_menu.get_visible():
            self.hide_power_menu()
            return True
        if keyval != Gdk.KEY_PowerOff:
            return False
        if not self.power_key_timeout:
            self.power_key_long = False
            self.power_key_timeout = GLib.timeout_add(POWER_KEY_LONG_MS, self.on_power_key_long)
        return True

    def on_power_key_long(self):
        self.power_key_timeout = 0
        self.power_key_long = True
        self.wake()
        feedback()
        self.show_power_menu()
        return GLib.SOURCE_REMOVE

    def on_key_released(self, _controller, keyval, _keycode, _state):
        if keyval != Gdk.KEY_PowerOff:
            return
        if self.power_key_timeout:
            GLib.source_remove(self.power_key_timeout)
            self.power_key_timeout = 0
        if self.power_key_long:
            return
        # A short press turns the screen off and on, as on the lock screen
        if self.blanked:
            self.wake()
        else:
            self.blank_screen()


def backlight_device():
    """(subsystem, name) of the panel's light: the Plinius has an LED class device."""
    for subsystem in ("backlight", "leds"):
        base = f"/sys/class/{subsystem}"
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        if subsystem == "leds":
            names = [n for n in names if n == "lcd-backlight"]
        for name in names:
            if os.path.exists(os.path.join(base, name, "brightness")):
                return subsystem, name
    return None


def set_backlight(value):
    """Sets the panel's brightness through logind (allowed for the active session); returns the
    brightness before, None if there is no such device or logind refused."""
    if TEST:
        return None
    device = backlight_device()
    if device is None:
        return None
    subsystem, name = device
    try:
        with open(f"/sys/class/{subsystem}/{name}/brightness", encoding="ascii") as f:
            before = int(f.read().strip())
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        bus.call_sync("org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                      "org.freedesktop.login1.Session", "SetBrightness",
                      GLib.Variant("(ssu)", (subsystem, name, value)), None, Gio.DBusCallFlags.NONE, 2000, None)
        return before
    except (OSError, ValueError, GLib.Error) as e:
        print(f"plinius-greeter: brightness: {e}", file=sys.stderr)
        return None


def main():
    setup_locale()
    setup_feedback()
    app = Adw.Application(application_id="org.plinius.Greeter", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(application):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider()
        look = installation_look()
        provider.load_from_string(make_css(look))
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        window = Greeter(application, look)
        if not os.environ.get("PLINIUS_GREETER_WINDOWED"):
            window.fullscreen()
        window.present()

    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
