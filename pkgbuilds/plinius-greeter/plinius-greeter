# Phosh's keypad (phosh-plinius 0012): at most this share of the screen's height and its width
# less the side margins, three columns and four rows 6 px apart, buttons of 80 to 120 px with the
# digit growing along (32 px at 80); KEYPAD_EXTRA the status, the PIN and the unlock button
KEYPAD_SIDE_MARGIN = 24
KEYPAD_HEIGHT_SHARE = 0.55
KEYPAD_BUTTON = (80, 120)
KEYPAD_SPACING = 6
KEYPAD_EXTRA = 150


