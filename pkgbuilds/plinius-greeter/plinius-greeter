        self.password_button.connect("toggled", lambda b: b.get_active() and self.set_kind("password"))
        kinds.append(self.pin_button)
        kinds.append(self.password_button)
        box.append(kinds)
        self.first_prompt = Gtk.Label(css_classes=["greeter-subtitle"], wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.first_prompt)

        # The PIN: dots and the keypad
        self.pin_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, halign=Gtk.Align.CENTER)
        self.dots = Gtk.Label(css_classes=["pin-dots"])
        self.pin_box.append(self.dots)
        keypad = Gtk.Grid(row_spacing=12, column_spacing=18, halign=Gtk.Align.CENTER)
        keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "back", "0", "next"]
        self.keys = {}
        for i, key in enumerate(keys):
