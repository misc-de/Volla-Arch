def keypad_button_size(width, height):
    """The size of a keypad button on a screen of width x height, as Phosh's lock screen has it."""
    room_width = width - 2 * KEYPAD_SIDE_MARGIN
    room_height = height * KEYPAD_HEIGHT_SHARE
    button = min((room_width - 2 * KEYPAD_SPACING) // 3, int((room_height - KEYPAD_EXTRA - 3 * KEYPAD_SPACING) // 4))
    return min(max(button, KEYPAD_BUTTON[0]), KEYPAD_BUTTON[1])


def keypad_css(button):
    return (f"button.key {{ min-width: {button}px; min-height: {button}px; }}\n"
            f"button.key label {{ font-size: {32 * button // KEYPAD_BUTTON[0]}px; }}\n")


@dataclasses.dataclass
class Look:
    """The installation's look: background colour, the picture over it (or None), accent colour,
    plinius-ambient's effect and its density."""
    background: str = BACKGROUND
    picture: str = None
    accent: str = ACCENT
    effect: str = "dust"
    density: str = "medium"


def installation_look(source=None):
    """The look a new account starts with: the schemas' defaults with the installation's overrides
    (device-volla-ansuz's 90-plinius.gschema.override, the Phosh sections for XDG_CURRENT_DESKTOP),
    never an account's own settings. Anything missing or unusable keeps the value of Look()."""
    if source is None:
        source = Gio.SettingsSchemaSource.get_default()

    def default(schema_id, key):
        schema = source.lookup(schema_id, True) if source is not None else None
        if schema is None or not schema.has_key(key):
            return None
        return schema.get_key(key).get_default_value().unpack()

    def color(value):
        # Only #rgb and #rrggbb: the value goes into the CSS
        return value if isinstance(value, str) and re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", value) else None

    look = Look()
    # Phosh's custom accent (phosh-plinius), else GNOME's own colour has no hex value to use
    look.accent = color(default("org.plinius.appearance", "accent-color")) or look.accent
    look.background = color(default("org.gnome.desktop.background", "primary-color")) or look.background
    if (default("org.gnome.desktop.background", "picture-options") or "none") != "none":
        # The greeter is always dark
        for key in ("picture-uri-dark", "picture-uri"):
            uri = default("org.gnome.desktop.background", key)
            path = Gio.File.new_for_uri(uri).get_path() if uri else None
            if path and os.path.isfile(path):
                look.picture = path
                break
    look.effect = default("org.plinius.ambient", "effect") or "none"
    density = default("org.plinius.ambient", "density")
    if density in DustField.COUNTS:
        look.density = density
    return look


# ----- plinius-ambient's dust, for the first start -----

def smoothstep(e0, e1, x):
    t = min(max((x - e0) / (e1 - e0), 0.0), 1.0)
    return t * t * (3 - 2 * t)


class DustField:
    """plinius-ambient's dust (effects.c, dust_*) with its numbers: motes drifting in a beam of
    light from the upper left, a few big ones out of focus in front of the lens. Sizes in logical
    pixels of a screen width by height; sprites() says what to draw."""

    COUNTS = {"low": 70, "medium": 140, "high": 240}
    FOCUS_DEPTH = 0.45
    FOREGROUND_MAX = 1.7
    FOREGROUND_SHARE = 0.07
    BEAM_DIR = (0.42, 0.91)
    SHARPNESS_LEVELS = 4  # the sharp motes' glow comes in this many textures (glow_pixels)

    def __init__(self, width, height, density="medium", rng=None):
        self.rng = rng or random.Random()
        self.width, self.height = width, height
        self.time = 0.0
        area = width * height / (360.0 * 800.0)
        self.motes = [self.make_mote() for _ in range(max(1, int(self.COUNTS[density] * min(max(area, 0.25), 4.0))))]

    def unit(self):
        w = min(self.width, self.height)
        return w / 360.0 if w > 0 else 1.0

    def random_depth(self):
        if self.rng.random() < self.FOREGROUND_SHARE:
            return self.rng.uniform(1.0, self.FOREGROUND_MAX)
        z = self.rng.random()
        return z * z  # more far motes than near ones

    def blur_of(self, z):
        return min(max((z - self.FOCUS_DEPTH) / (self.FOREGROUND_MAX - self.FOCUS_DEPTH) * 1.4, 0.0), 1.0)

    def make_mote(self):
        z = self.random_depth()
        size = (0.8 + 2.2 * z if z <= 1 else 5 + 9 * (z - 1) / (self.FOREGROUND_MAX - 1)) * self.unit()
        return {"x": self.rng.random() * self.width, "y": self.rng.random() * self.height, "vx": 0.0, "vy": 0.0,
                "z": z, "size": size, "phase": self.rng.random() * 2 * math.pi, "freq": self.rng.uniform(0.6, 2.0)}

    def resize(self, width, height):
        sx = width / self.width if self.width else 1.0
        sy = height / self.height if self.height else 1.0
        for m in self.motes:
            m["x"] *= sx
            m["y"] *= sy
        self.width, self.height = width, height

    def step(self, dt):
        """Brownian drift with a little warm air rising, damped so it stays a float; nearer motes
        seem to move faster (parallax)."""
        u = self.unit()
        self.time += dt
        damp = math.exp(-0.8 * dt)
        for m in self.motes:
            near = 0.5 + m["z"]
            m["vx"] = (m["vx"] + self.rng.uniform(-1, 1) * 18 * near * u * dt) * damp
            m["vy"] = (m["vy"] + (self.rng.uniform(-1, 1) * 18 - 1.5) * near * u * dt) * damp
            m["x"] = (m["x"] + (m["vx"] + 2 * near * u) * dt) % self.width
            m["y"] = (m["y"] + m["vy"] * dt) % self.height

    def beam_distance(self, x, y):
        dx, dy = self.BEAM_DIR
        return abs((x - 0.2 * self.width) * dy - y * dx)

    def beam(self):
        """(centre x, centre y, half width, half length, angle in degrees, opacity): the beam's
        texture (top row at its source) turned around its centre."""
        dx, dy = self.BEAM_DIR
        length = math.hypot(self.width, self.height)
        breathe = 0.85 + 0.15 * math.sin(self.time * 0.25)
        angle = math.atan2(dx, -dy) + math.pi
        return (0.2 * self.width + dx * length * 0.5, dy * length * 0.5, 0.32 * self.width, length * 0.55,
                math.degrees(angle), 0.17 * breathe)

    def sprites(self):
        """(kind, centre x, centre y, half size, opacity) per mote; kind "bokeh" or the level of
        sharpness 0 (sharp) .. SHARPNESS_LEVELS - 1."""
        beam_half = 0.32 * self.width
        result = []
        for m in self.motes:
            # Lit inside the beam, barely visible outside of it
            lit = 0.18 + 0.82 * min(max(1.2 - self.beam_distance(m["x"], m["y"]) / beam_half, 0.0), 1.0)
            b = lit * (0.55 + 0.45 * math.sin(self.time * m["freq"] + m["phase"]))
            if m["z"] > 1:
                # In front of the lens: a faint disc of light
                result.append(("bokeh", m["x"], m["y"], m["size"], 0.3 * b))
            else:
                level = round(self.blur_of(m["z"]) * (self.SHARPNESS_LEVELS - 1))
                result.append((level, m["x"], m["y"], m["size"] * 3, b))
        return result


MOTE_COLOR = (1.0, 0.93, 0.78)
BEAM_COLOR = (1.0, 0.853, 0.588)  # plinius-ambient's (0.17, 0.145, 0.10) at full strength


def glow_pixels(kind, size):
    """RGBA, premultiplied, of a size x size sprite of kind "bokeh", "beam" (size wide, 4 x size
    high, the source at the top) or a sharpness level (DustField.sprites()); the profiles of
    plinius-ambient's glow shader."""
    height = size * 4 if kind == "beam" else size
    color = BEAM_COLOR if kind == "beam" else MOTE_COLOR
    if isinstance(kind, int):
        q = 0.6 - 0.5 * kind / (DustField.SHARPNESS_LEVELS - 1)
    out = bytearray(size * height * 4)
    for row in range(height):
        v = 1 - 2 * (row + 0.5) / height
        for col in range(size):
            u = 2 * (col + 0.5) / size - 1
            r2 = u * u + v * v
            if kind == "beam":
                a = math.exp(-u * u * 2.2) * (1 - u * u) * smoothstep(-1.0, 0.2, v)
            elif r2 > 1:
                continue
            elif kind == "bokeh":
                r = math.sqrt(r2)
                a = smoothstep(1.0, 0.86, r) * (0.6 + 0.4 * smoothstep(0.45, 0.95, r))
            else:
                a = (math.exp(-r2 * (6 + 54 * q)) + math.exp(-r2 * 5) * 0.25) * (1 - r2)
            a = min(max(a, 0.0), 1.0)
            i = (row * size + col) * 4
            out[i:i + 4] = bytes((round(color[0] * a * 255), round(color[1] * a * 255), round(color[2] * a * 255),
                                  round(a * 255)))
    return bytes(out)


class DustArea(Gtk.Widget):
    """Draws a DustField over the background at DUST_FPS frames a second while running."""

    def __init__(self, density="medium"):
        super().__init__(can_target=False, hexpand=True, vexpand=True)
        self.density = density
        self.field = None
        self.textures = None
        self.tick = 0
        self.last = None

    def set_running(self, running):
        if running and not self.tick:
            self.last = None
            self.tick = self.add_tick_callback(self.on_tick)
        elif not running and self.tick:
            self.remove_tick_callback(self.tick)
            self.tick = 0

    def on_tick(self, _widget, clock):
        now = clock.get_frame_time() / 1e6
        if self.last is None:
            self.last = now
        elif now - self.last >= 1 / DUST_FPS - 0.004:
            if self.field is not None:
                self.field.step(min(now - self.last, 0.1))
            self.last = now
            self.queue_draw()
        return GLib.SOURCE_CONTINUE

    @staticmethod
    def texture(kind, size):
        height = size * 4 if kind == "beam" else size
        return Gdk.MemoryTexture.new(size, height, Gdk.MemoryFormat.R8G8B8A8_PREMULTIPLIED,
                                     GLib.Bytes.new(glow_pixels(kind, size)), size * 4)

    def do_snapshot(self, snapshot):
        width, height = self.get_width(), self.get_height()
        if width <= 0 or height <= 0:
            return
        if self.field is None:
            self.field = DustField(width, height, self.density)
        elif (width, height) != (self.field.width, self.field.height):
            self.field.resize(width, height)
        if self.textures is None:
            self.textures = {"beam": self.texture("beam", 48), "bokeh": self.texture("bokeh", 128)}
            for level in range(DustField.SHARPNESS_LEVELS):
                self.textures[level] = self.texture(level, 64)
        cx, cy, half_w, half_l, angle, opacity = self.field.beam()
        snapshot.save()
        snapshot.translate(Graphene.Point().init(cx, cy))
        snapshot.rotate(angle)
        snapshot.push_opacity(opacity)
        snapshot.append_texture(self.textures["beam"], Graphene.Rect().init(-half_w, -half_l, 2 * half_w, 2 * half_l))
        snapshot.pop()
        snapshot.restore()
        for kind, x, y, half, opacity in self.field.sprites():
            if opacity <= 0.004:
                continue
            snapshot.push_opacity(min(opacity, 1.0))
            snapshot.append_texture(self.textures[kind], Graphene.Rect().init(x - half, y - half, 2 * half, 2 * half))
            snapshot.pop()


def setup_feedback():
    """Connects libfeedback to feedbackd (started on the greeter's session bus when first asked);
    without it the greeter works the same, only without vibration."""
    if Lfb is None:
        return
    try:
        Lfb.init("org.plinius.Greeter")
    except GLib.Error as e:
        print(f"plinius-greeter: feedback: {e.message}", file=sys.stderr)


def feedback(event="button-pressed"):
    """A short vibration from feedbackd's theme for the event: "button-pressed" is a tap."""
    if Lfb is None or not Lfb.is_initted():
        return

    def done(ev, result):
        try:
            ev.trigger_feedback_finish(result)
        except GLib.Error as e:
            print(f"plinius-greeter: feedback: {e.message}", file=sys.stderr)
    Lfb.Event.new(event).trigger_feedback_async(None, done)


def setup_locale():
    """greetd starts the greeter without LANG: take the system's (as the other screens before login)."""
    if not os.environ.get("LANG"):
        try:
            with open("/etc/locale.conf", encoding="utf-8") as f:
                for line in f:
                    key, _, value = line.strip().partition("=")
                    if key.startswith("LANG") or key.startswith("LC_"):
                        os.environ.setdefault(key, value.strip().strip('"'))
        except OSError:
            pass
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        locale.setlocale(locale.LC_ALL, "C.UTF-8")
    gettext.bindtextdomain("plinius-greeter", "/usr/share/locale")
    gettext.textdomain("plinius-greeter")


