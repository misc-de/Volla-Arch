    # ----- accounts -----

    def load_accounts(self):
        self.accounts = base_accounts()
        self.fill()
        if AccountsService is None or TEST:
            return
        # AccountsService knows the pictures and the locked accounts; it can come late or not at all
        manager = AccountsService.UserManager.get_default()
        if manager.props.is_loaded:
            self.from_accounts_service(manager)
        else:
            manager.connect("notify::is-loaded", lambda m, _p: self.from_accounts_service(m))

    def from_accounts_service(self, manager):
        if not manager.props.is_loaded or manager.no_service():
            return
        known = {u.get_user_name(): u for u in manager.list_users()}
        result = []
        for account in self.accounts:
            user = known.get(account.name)
            if user is not None and user.is_loaded():
                if user.get_locked():
                    continue
                icon = user.get_icon_file()
                if icon and os.path.isfile(icon):
                    account.icon = icon
            result.append(account)
        self.accounts = result
        self.fill()

    def fill(self):
        if self.choosing:
            return
        if self.first:
            # One question instead of the accounts: nothing to pick, nothing logged in by itself
            self.title.set_label(_("Protect your phone"))
            self.subtitle.set_label(_("Choose how to unlock it. Settings and every other question for the password "
                                      "ask for the same."))
            return
        while (child := self.rows.get_first_child()) is not None:
            self.rows.remove(child)
        self.tiles = {}
        account_list = ordered(self.accounts, self.last)
        # A single account to offer (the others locked) is no choice: log it in without showing it.
        # Only once: after a failed start its tile shows, to try again by hand.
        single = len(account_list) == 1 and not self.failed
        self.title.set_visible(not single)
        self.subtitle.set_visible(not single)
        if single:
            GLib.idle_add(self.choose, account_list[0])
            return
        row = None
        for i, account in enumerate(account_list):
            if i % 2 == 0:
                row = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, homogeneous=True)
                self.rows.append(row)
            tile = self.make_tile(account, account.name == self.last and len(account_list) > 1)
            self.tiles[account.name] = tile
            row.append(tile)

    def make_tile(self, account, last):
