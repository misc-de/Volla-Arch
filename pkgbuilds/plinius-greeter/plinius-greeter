def setup_locale():
    """greetd starts the greeter without LANG: take the system's (as the other screens before login)."""
    if not os.environ.get("LANG"):
        try:
            with open("/etc/locale.conf", encoding="utf-8") as f:
                for line in f:
                    key, _, value = line.strip().partition("=")
                    if key.startswith("LANG") or key.startswith("LC_"):
                        os.environ.setdefault(key, value.strip().strip('"'))
        except OSError:
            pass
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        locale.setlocale(locale.LC_ALL, "C.UTF-8")
    gettext.bindtextdomain("plinius-greeter", "/usr/share/locale")
    gettext.textdomain("plinius-greeter")


_ = gettext.gettext


class Account:
    """An account as the greeter shows it: its picture and its username, never the full name."""

    def __init__(self, name, icon=None):
        self.name = name
        self.icon = icon


def read_last_user():
    if TEST:
        return os.environ.get("PLINIUS_GREETER_LAST", "")
    try:
        with open(LAST_USER, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def base_accounts():
    if TEST and os.environ.get("PLINIUS_GREETER_USERS"):
        result = []
        for item in os.environ["PLINIUS_GREETER_USERS"].split(","):
            result.append(Account(item.partition(":")[0].strip()))
        return result
    result = []
    for entry in accounts.login_users():
        icon = os.path.join(ICON_DIR, entry.pw_name)
        result.append(Account(entry.pw_name, icon if os.path.isfile(icon) else None))
    return result


def ordered(account_list, last):
    """The account used last first, the others by name."""
    rest = sorted((a for a in account_list if a.name != last), key=lambda a: a.name)
    first = [a for a in account_list if a.name == last]
    return first + rest


def read_first_start():
    """The account that has no password yet, or ""."""
    if TEST:
        return os.environ.get("PLINIUS_GREETER_FIRST", "")
    try:
        with open(FIRST_START, encoding="utf-8") as f:
            return f.read(256).strip()
    except OSError:
        return ""


def secret_problem(kind, secret, again):
    """Why the first PIN or password cannot be used, or "" (root checks the same, plinius-greeter-config)."""
    if kind == "pin":
        if not secret.isascii() or not secret.isdigit() or not PIN_DIGITS[0] <= len(secret) <= PIN_DIGITS[1]:
            return _("A PIN has 4 to 12 digits.")
        if secret != again:
            return _("The PINs do not match. Please enter it again.")
        return ""
    if not PASSWORD_LENGTH[0] <= len(secret) <= PASSWORD_LENGTH[1] or any(ord(c) < 0x20 or ord(c) == 0x7F
                                                                         for c in secret):
        return _("A password has at least 6 characters.")
    if secret.isascii() and secret.isdigit():
        return _("A password of digits only is a PIN: choose PIN above.")
    if secret != again:
        return _("The passwords do not match. Please enter them again.")
    return ""


def time_format():
    try:
        t_fmt = locale.nl_langinfo(locale.T_FMT)
    except (AttributeError, ValueError):
        t_fmt = "%H:%M:%S"
    return "%-l:%M" if ("%p" in t_fmt or "%I" in t_fmt or "%r" in t_fmt) else "%H:%M"


