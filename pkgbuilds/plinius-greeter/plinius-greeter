        ring = Gtk.Box(halign=Gtk.Align.CENTER, css_classes=["avatar-ring"])
        avatar = Adw.Avatar(size=88, text=account.name, show_initials=True)
        if account.icon:
            try:
                avatar.set_custom_image(Gdk.Texture.new_from_filename(account.icon))
            except GLib.Error:
                pass
        ring.append(avatar)
        box.append(ring)
        name = Gtk.Label(label=account.name, css_classes=["user-name"], ellipsize=Pango.EllipsizeMode.END,
                         max_width_chars=12)
        box.append(name)

        button = Gtk.Button(child=box, css_classes=["user-tile"], width_request=156)
        if last:
            button.add_css_class("last")
        button.update_property([Gtk.AccessibleProperty.LABEL], [account.name])
        button.connect("clicked", lambda _b: self.choose(account))
        return button

    # ----- the first start -----

    def make_first_start(self):
