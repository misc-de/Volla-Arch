                button.update_property([Gtk.AccessibleProperty.LABEL], [_("Continue")])
            else:
                button = Gtk.Button(label=key, css_classes=["key"])
            button.connect("clicked", lambda _b, k=key: self.on_key(k))
            self.keys[key] = button
            keypad.attach(button, i % 3, i // 3, 1, 1)
        self.pin_box.append(keypad)
        box.append(self.pin_box)

        # The password: two fields and the on-screen keyboard
        self.password_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, visible=False, width_request=300)
        self.secret = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text=_("Password"))
        self.again = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text=_("Repeat password"))
        self.again.connect("activate", lambda _e: self.submit_password())
        self.secret.connect("activate", lambda _e: self.again.grab_focus())
        self.password_box.append(self.secret)
        self.password_box.append(self.again)
        self.password_next = Gtk.Button(label=_("Continue"), css_classes=["suggested-action", "pill"],
                                        halign=Gtk.Align.CENTER)
        self.password_next.connect("clicked", lambda _b: self.submit_password())
        self.password_box.append(self.password_next)
        box.append(self.password_box)
        self.update_first_prompt()
        return box

    def set_kind(self, kind):
        if self.kind == kind:
            return
        self.kind, self.digits, self.first_pin = kind, "", None
        self.pin_box.set_visible(kind == "pin")
        self.password_box.set_visible(kind == "password")
        self.update_first_prompt()
        if kind == "password":
            self.start_keyboard()
            self.secret.grab_focus()

    def update_first_prompt(self):
        if self.kind == "pin":
            self.first_prompt.set_label(_("Repeat the PIN.") if self.first_pin is not None
                                        else _("Choose a PIN of 4 to 12 digits."))
            self.dots.set_label("●" * len(self.digits))
        else:
            self.first_prompt.set_label(_("Choose a password of at least 6 characters."))

    def on_key(self, key):
        if self.password_timeout:
            return
        if key == "back":
            self.digits = self.digits[:-1]
        elif key == "next":
            self.next_pin()
            return
        elif len(self.digits) < PIN_DIGITS[1]:
            self.digits += key
        self.update_first_prompt()

    def next_pin(self):
        if self.first_pin is None:
            problem = secret_problem("pin", self.digits, self.digits)
            if problem:
                self.show_status(problem, error=True)
                return
            self.first_pin, self.digits = self.digits, ""
            self.status.set_opacity(0)
            self.update_first_prompt()
            return
        problem = secret_problem("pin", self.first_pin, self.digits)
        if problem:
            self.first_pin, self.digits = None, ""
            self.update_first_prompt()
            self.show_status(problem, error=True)
            return
        self.submit(self.first_pin)

    def submit_password(self):
        if self.password_timeout:
            return
        secret, again = self.secret.get_text(), self.again.get_text()
        problem = secret_problem("password", secret, again)
        if problem:
            self.show_status(problem, error=True)
            return
        self.submit(secret)

    def start_keyboard(self):
        """Stevia for the password: greetd's session has no Phosh to start it. GSettings of its own, with the
        keyboard turned on (the greeter's are in memory only)."""
        if self.keyboard is not None or TEST or not os.access(KEYBOARD, os.X_OK):
            return
        config = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "plinius-greeter-keyboard")
        try:
            os.makedirs(os.path.join(config, "glib-2.0/settings"), mode=0o700, exist_ok=True)
            with open(os.path.join(config, "glib-2.0/settings/keyfile"), "w", encoding="utf-8") as f:
                f.write("[org/gnome/desktop/a11y/applications]\nscreen-keyboard-enabled=true\n")
            # XDG_SESSION_CLASS: Stevia offers no settings in a greeter (stevia-plinius 0014)
            env = dict(os.environ, GSETTINGS_BACKEND="keyfile", XDG_CONFIG_HOME=config,
                       XDG_SESSION_CLASS="greeter")
            self.keyboard = subprocess.Popen([KEYBOARD], env=env, stdin=subprocess.DEVNULL)
        except OSError as e:
            print(f"plinius-greeter: on-screen keyboard: {e}", file=sys.stderr)

    def result_stamp(self):
        try:
            st = os.stat(PASSWORD_RESULT)
            return st.st_mtime_ns, st.st_ino
        except OSError:
            return None

    def submit(self, secret):
        """Hands the PIN or password to root (plinius-greeter-config password) and waits for its answer."""
        self.result_before = self.result_stamp()
        try:
            if TEST:
                print(f"plinius-greeter: first {self.kind} for {self.first}", flush=True)
            else:
                tmp = os.path.join(REQUEST_DIR, "password.tmp")
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
                with os.fdopen(fd, "w") as f:
                    json.dump({"user": self.first, "secret": secret}, f)
                os.replace(tmp, os.path.join(REQUEST_DIR, "password"))
        except OSError as e:
            print(f"plinius-greeter: cannot hand over the password: {e}", file=sys.stderr)
            self.password_failed(_("The password could not be set. Please try again."))
            return
        self.first_box.set_sensitive(False)
        self.show_status(_("Setting it up…"), busy=True)
        self.waited = 0
        self.password_timeout = GLib.timeout_add(500, self.check_result)

    def check_result(self):
        self.waited += 500
        stamp = self.result_stamp()
        if stamp is None or stamp == self.result_before:
            if self.waited >= PASSWORD_TIMEOUT_SECONDS * 1000:
                self.password_timeout = 0
                self.password_failed(_("The password could not be set. Please try again."))
                return GLib.SOURCE_REMOVE
            return GLib.SOURCE_CONTINUE
        self.password_timeout = 0
        try:
            with open(PASSWORD_RESULT, encoding="utf-8") as f:
                result = f.read(64).strip()
        except OSError:
            result = "failed"
        if result == "ok":
            # Root logs the account in now; as after a tap, try again should it not start
            self.choosing = Account(self.first)
            self.show_status(_("Starting…"), busy=True)
            self.start_timeout = GLib.timeout_add_seconds(START_TIMEOUT_SECONDS, self.fail)
        elif result == "same":
            self.password_failed(_("That is the password of the encryption. Choose another one: it is typed in "
                                   "view of others many times a day."))
        elif result == "invalid":
            self.password_failed(_("That cannot be used. A PIN has 4 to 12 digits, a password at least 6 characters."))
        else:
            self.password_failed(_("The password could not be set. Please try again."))
        return GLib.SOURCE_REMOVE

    def password_failed(self, text):
        self.first_box.set_sensitive(True)
        self.digits, self.first_pin = "", None
        self.secret.set_text("")
        self.again.set_text("")
        self.update_first_prompt()
        self.show_status(text, error=True)

    # ----- logging in -----

    def choose(self, account):
        if self.choosing:
            return GLib.SOURCE_REMOVE
        self.choosing = account
        for name, tile in self.tiles.items():
            tile.set_can_target(False)
            tile.add_css_class("chosen" if name == account.name else "dimmed")
        self.show_status(_("Starting…"), busy=True)
        try:
            self.write_request(account.name)
        except OSError as e:
            print(f"plinius-greeter: cannot hand over {account.name}: {e}", file=sys.stderr)
            self.fail()
            return GLib.SOURCE_REMOVE
        # greetd ends this session once the account's session starts; if it does not, try again
        self.start_timeout = GLib.timeout_add_seconds(START_TIMEOUT_SECONDS, self.fail)
        return GLib.SOURCE_REMOVE

    def write_request(self, name):
        if TEST:
            print(f"plinius-greeter: request {name}", flush=True)
            return
        tmp = os.path.join(REQUEST_DIR, "request.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(name + "\n")
        os.replace(tmp, os.path.join(REQUEST_DIR, "request"))

    def fail(self):
        self.start_timeout = 0
        self.choosing = None
        self.failed = True
        # The password is set by now (root removed first-start): the account is a tile from here on
        self.first = read_first_start()
        self.first_box.set_visible(bool(self.first))
        self.first_box.set_sensitive(True)
        self.title.set_label(_("Who is using the phone?"))
        self.subtitle.set_label(_("Tap your account, then unlock it as usual."))
        self.fill()
        self.show_status(_("The phone could not start this account. Please try again."), error=True)
        # The idle timer may have run out while the account started (on_idle leaves the screen on
        # then): dark again after IDLE_SECONDS without a touch
        if not self.blanked:
            self.restart_idle()
        return GLib.SOURCE_REMOVE

    def show_status(self, text, busy=False, error=False):
        self.status_label.set_label(text)
        self.spinner.set_visible(busy)
        if error:
            self.status_label.add_css_class("error")
        else:
            self.status_label.remove_css_class("error")
        self.status.set_opacity(1)

    # ----- clock -----

    def update_clock(self):
        now = GLib.DateTime.new_now_local()
        self.clock.set_label(now.format(self.time_format).strip())
        # Translators: the date below the clock (GLib's strftime codes), e.g. "%A, %-d. %B" in German
        self.date.set_label(now.format(_("%A, %B %-d")))
        return GLib.SOURCE_CONTINUE

    # ----- power -----

    def ask_power(self):
        dialog = Adw.AlertDialog(heading=_("Power"), body=_("Restart the phone or power it off?"))
        dialog.add_response("cancel", _("_Cancel"))
        dialog.add_response("restart", _("_Restart"))
        dialog.add_response("off", _("_Power Off"))
        dialog.set_response_appearance("off", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", self.on_power_response)
        dialog.present(self)

    def on_power_response(self, _dialog, response):
        method = {"restart": "Reboot", "off": "PowerOff"}.get(response)
        if not method:
            return
        if TEST:
            print(f"plinius-greeter: {method}", flush=True)
            return
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        bus.call("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                 method, GLib.Variant("(b)", (False,)), None, Gio.DBusCallFlags.NONE, -1, None, None)

    # ----- dark screen -----

    def on_any_event(self, _controller, _event):
        if not self.blanked:
            self.restart_idle()
        return False

    def restart_idle(self):
        if self.idle_timeout:
            GLib.source_remove(self.idle_timeout)
        self.idle_timeout = GLib.timeout_add_seconds(IDLE_SECONDS, self.on_idle)

    def on_idle(self):
        self.idle_timeout = 0
        if not self.choosing:
            self.blank_screen()
        return GLib.SOURCE_REMOVE

    def blank_screen(self):
        if self.blanked:
            return
        self.blanked = True
        self.blank.set_visible(True)
        self.saved_brightness = set_backlight(0)

    def wake(self):
        if not self.blanked:
            return
        self.blanked = False
        self.blank.set_visible(False)
        if self.saved_brightness is not None:
            set_backlight(self.saved_brightness)
            self.saved_brightness = None
        self.restart_idle()

    def on_key_pressed(self, _controller, keyval, _keycode, _state):
        if keyval != Gdk.KEY_PowerOff:
            return False
        if not self.power_key_timeout:
            self.power_key_long = False
            self.power_key_timeout = GLib.timeout_add(POWER_KEY_LONG_MS, self.on_power_key_long)
        return True

    def on_power_key_long(self):
        self.power_key_timeout = 0
        self.power_key_long = True
        self.wake()
        self.ask_power()
        return GLib.SOURCE_REMOVE

    def on_key_released(self, _controller, keyval, _keycode, _state):
        if keyval != Gdk.KEY_PowerOff:
            return
        if self.power_key_timeout:
            GLib.source_remove(self.power_key_timeout)
            self.power_key_timeout = 0
        if self.power_key_long:
            return
        # A short press turns the screen off and on, as on the lock screen
        if self.blanked:
            self.wake()
        else:
            self.blank_screen()


def backlight_device():
    """(subsystem, name) of the panel's light: the Plinius has an LED class device."""
    for subsystem in ("backlight", "leds"):
        base = f"/sys/class/{subsystem}"
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        if subsystem == "leds":
            names = [n for n in names if n == "lcd-backlight"]
        for name in names:
            if os.path.exists(os.path.join(base, name, "brightness")):
                return subsystem, name
    return None


def set_backlight(value):
    """Sets the panel's brightness through logind (allowed for the active session); returns the
    brightness before, None if there is no such device or logind refused."""
    if TEST:
        return None
    device = backlight_device()
    if device is None:
        return None
    subsystem, name = device
    try:
        with open(f"/sys/class/{subsystem}/{name}/brightness", encoding="ascii") as f:
            before = int(f.read().strip())
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        bus.call_sync("org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                      "org.freedesktop.login1.Session", "SetBrightness",
                      GLib.Variant("(ssu)", (subsystem, name, value)), None, Gio.DBusCallFlags.NONE, 2000, None)
        return before
    except (OSError, ValueError, GLib.Error) as e:
        print(f"plinius-greeter: brightness: {e}", file=sys.stderr)
        return None


def main():
    setup_locale()
    app = Adw.Application(application_id="org.plinius.Greeter", flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(application):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        window = Greeter(application)
        if not os.environ.get("PLINIUS_GREETER_WINDOWED"):
            window.fullscreen()
        window.present()

    app.connect("activate", activate)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
