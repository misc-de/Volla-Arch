# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=buffybox
pkgver=3.6.0
pkgrel=16
pkgdesc="Framebuffer/DRM tools from postmarketOS: unl0kr (disk unlocker with on-screen keyboard), buffyboard"
arch=(aarch64 x86_64)
url="https://gitlab.postmarketos.org/postmarketOS/buffybox"
# Adwaita Sans (OFL-1.1) in the fonts of the on-screen keys
license=(GPL-3.0-or-later OFL-1.1)
depends=(glibc libinih libinput systemd-libs libxkbcommon libdrm libevdev)
makedepends=(git meson scdoc python)
# Commit of tag $pkgver: a tag can be moved later, a commit hash cannot
