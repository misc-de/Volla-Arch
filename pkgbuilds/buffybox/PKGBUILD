prepare() {
	cd buffybox
	git submodule init
	git config submodule.lvgl.url "$srcdir/lvgl"
	git -c protocol.file.allow=always submodule update
	# Easier to see blinking cursor in the password field
	git apply "$srcdir/0001-themes-make-the-text-cursor-of-the-Breezy-themes-2-d.patch"
	# Translatable placeholder of the password field (unl0kr --placeholder, used by plinius-crypt)
	git apply "$srcdir/0002-unl0kr-add-placeholder-for-the-text-of-the-empty-pas.patch"
	# Cyrillic in the built-in font (same patch in pkgbuilds/plinius-progress)
	git apply "$srcdir/0003-fonts-add-Cyrillic-U-0400-U-04FF-to-the-built-in-fon.patch"
	# Russian on-screen keyboard
	git apply "$srcdir/0004-unl0kr-add-a-Russian-keyboard-layout.patch"
	# Glass look: theme plinius-glass and [theme] background (same patches in plinius-progress)
	git apply "$srcdir/0005-themes-add-a-glass-look-and-a-background-image.patch"
	# Translatable shutdown confirmation (--shutdown-title/-yes/-no, used by plinius-crypt;
	# same patch in plinius-progress)
	git apply "$srcdir/0006-unl0kr-add-options-for-the-texts-of-the-shutdown-con.patch"
	# Wider keys in plinius-glass, less space beside them (same patch in plinius-progress)
	git apply "$srcdir/0007-themes-wider-keys-in-plinius-glass.patch"
	# The look of Phosh's keyboard: theme plinius-original, sizes and font of its keys, accent
	# color from the configuration (same patch in plinius-progress)
	git apply "$srcdir/0008-themes-Stevia-s-look-for-the-keys-an-accent-color-fr.patch"
	# Larger opened keyboard layout list (only unl0kr has one, not in plinius-progress)
	git apply "$srcdir/0009-unl0kr-a-keyboard-layout-list-that-fits-a-phone-disp.patch"
	# Key presses vibrate where the driver refuses FF_RUMBLE (Awinic in the Volla: FF_CONSTANT
	# only); plinius-progress does not vibrate, so the patch is not copied there
	git apply "$srcdir/0010-shared-haptic-feedback-with-FF_CONSTANT-where-FF_RUM.patch"
	# No panel behind the buttons at the top in the Plinius themes, as Phosh's top bar (plinius-progress
	# has no header, so the patch is not copied there)
	git apply "$srcdir/0011-themes-a-transparent-header-in-the-Plinius-themes.patch"
	# Password field centered between header and keyboard, the reveal button inside the field,
	# "?!#" instead of "123" on the key to the symbols (only unl0kr, not in plinius-progress)
	git apply "$srcdir/0012-unl0kr-the-password-field-in-the-middle-the-eye-insi.patch"
	# A smooth scaling of the background, for the tiny one of the phone's ramdisk (same patch in
	# plinius-progress)
	git apply "$srcdir/0013-shared-a-smooth-scaling-of-the-background-image.patch"
	# Touches in any slot of the touchscreen: the Volla's firmware puts some taps into slot 9,
	# only slots 0 and 1 counted (same patch in plinius-progress)
	git apply "$srcdir/0014-shared-touches-in-any-slot-of-the-touchscreen.patch"
}

build() {
	arch-meson buffybox build \
		-Dlvgl_backends=framebuffer,drm \
		-Dman=true \
		-Dsystemd=false
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 buffybox/shared/fonts/AdwaitaSans-LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	# Plinius: characters the on-screen keyboard of unl0kr can type (all layouts), one per line;
	# plinius-encrypt accepts only new passwords made of them
	install -d "$pkgdir/usr/share/buffybox"
	python3 "$srcdir/unl0kr-keycaps.py" buffybox/unl0kr/sq2lv_layouts.c \
		> "$pkgdir/usr/share/buffybox/unl0kr-keycaps"
}
