+/* Glass look: surfaces become translucent over the window's background image. Themes without
+ * it leave this zeroed and keep opaque surfaces. */
+typedef struct {
+    /* If false, all surfaces are opaque and the other values are ignored */
+    bool enabled;
+    /* Opacity of keys, buttons, the text area and the dropdown button */
+    uint8_t surface_opa;
+    /* Opacity of pressed keys and buttons */
+    uint8_t pressed_opa;
+    /* Opacity of the borders of all surfaces */
+    uint8_t border_opa;
+    /* Opacity of the header and of the keyboard panel behind the keys */
+    uint8_t panel_opa;
+} bbx_theme_glass;
+
 /* Full theme */
 typedef struct {
