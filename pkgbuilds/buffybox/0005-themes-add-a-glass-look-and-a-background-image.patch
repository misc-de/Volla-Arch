diff --git a/shared/background.c b/shared/background.c
new file mode 100644
index 0000000..e800e26
--- /dev/null
+++ b/shared/background.c
@@ -0,0 +1,175 @@
+/**
+ * Copyright 2026 misc-de
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+
+#include "background.h"
+
+#include "log.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+/**
+ * Static variables
+ */
+
+/* The scaled background; referenced by the screen's style, so it must outlive it */
+static lv_image_dsc_t background;
+
+
+/**
+ * Static prototypes
+ */
+
+/**
+ * Read a whole file into memory.
+ *
+ * @param path path of the file
+ * @param size set to the number of bytes read
+ * @return the contents (to be freed by the caller) or NULL on failure
+ */
+static uint8_t *read_file(const char *path, size_t *size);
+
+/**
+ * Scale an XRGB8888 image to cover a larger area, centred and cropped (bilinear).
+ *
+ * @param src source pixels
+ * @param sw source width
+ * @param sh source height
+ * @param src_stride bytes per source row
+ * @param dw target width
+ * @param dh target height
+ * @return the target pixels (dw * dh, to be freed by the caller) or NULL on failure
+ */
+static uint32_t *scale_to_cover(const uint8_t *src, int32_t sw, int32_t sh, uint32_t src_stride,
+    int32_t dw, int32_t dh);
+
+
+/**
+ * Static functions
+ */
+
+static uint8_t *read_file(const char *path, size_t *size) {
+    FILE *file = fopen(path, "rb");
+    if (!file) {
+        return NULL;
+    }
+
+    uint8_t *data = NULL;
+    long length = -1;
+    if (fseek(file, 0, SEEK_END) == 0) {
+        length = ftell(file);
+    }
+    if (length > 0 && fseek(file, 0, SEEK_SET) == 0) {
+        data = malloc(length);
+        if (data && fread(data, 1, length, file) != (size_t)length) {
+            free(data);
+            data = NULL;
+        }
+    }
+    fclose(file);
+
+    *size = data ? (size_t)length : 0;
+    return data;
+}
+
+static uint32_t *scale_to_cover(const uint8_t *src, int32_t sw, int32_t sh, uint32_t src_stride,
+        int32_t dw, int32_t dh) {
+    uint32_t *dst = malloc((size_t)dw * dh * sizeof(uint32_t));
+    if (!dst) {
+        return NULL;
+    }
+
+    /* The larger of both factors covers the area; the source rectangle that remains visible is
+     * centred */
+    float scale = (float)dw / sw > (float)dh / sh ? (float)dw / sw : (float)dh / sh;
+    float offset_x = (sw - dw / scale) / 2;
+    float offset_y = (sh - dh / scale) / 2;
+
+    for (int32_t y = 0; y < dh; y++) {
+        float fy = (y + 0.5f) / scale + offset_y - 0.5f;
+        fy = fy < 0 ? 0 : (fy > sh - 1 ? sh - 1 : fy);
+        int32_t y0 = (int32_t)fy;
+        int32_t y1 = y0 + 1 < sh ? y0 + 1 : y0;
+        uint32_t wy = (uint32_t)((fy - y0) * 256);
+        const uint8_t *row0 = src + (size_t)y0 * src_stride;
+        const uint8_t *row1 = src + (size_t)y1 * src_stride;
+
+        for (int32_t x = 0; x < dw; x++) {
+            float fx = (x + 0.5f) / scale + offset_x - 0.5f;
+            fx = fx < 0 ? 0 : (fx > sw - 1 ? sw - 1 : fx);
+            int32_t x0 = (int32_t)fx;
+            int32_t x1 = x0 + 1 < sw ? x0 + 1 : x0;
+            uint32_t wx = (uint32_t)((fx - x0) * 256);
+
+            /* Blend the four neighbours per channel (B, G, R in memory order), X stays opaque */
+            uint32_t pixel = 0xFF000000;
+            for (int c = 0; c < 3; c++) {
+                uint32_t top = row0[x0 * 4 + c] * (256 - wx) + row0[x1 * 4 + c] * wx;
+                uint32_t bottom = row1[x0 * 4 + c] * (256 - wx) + row1[x1 * 4 + c] * wx;
+                uint32_t value = (top * (256 - wy) + bottom * wy) >> 16;
+                pixel |= value << (8 * c);
+            }
+            dst[(size_t)y * dw + x] = pixel;
+        }
+    }
+
+    return dst;
+}
+
+
+/**
+ * Public functions
+ */
+
+bool bbx_background_apply(lv_obj_t *screen, const char *path) {
+    size_t size = 0;
+    uint8_t *data = read_file(path, &size);
+    if (!data) {
+        bbx_log(BBX_LOG_LEVEL_WARNING, "Could not read background image %s", path);
+        return false;
+    }
+
+    lv_image_header_t header;
+    bool valid = size >= sizeof(header);
+    if (valid) {
+        memcpy(&header, data, sizeof(header));
+        valid = header.magic == LV_IMAGE_HEADER_MAGIC
+            && header.cf == LV_COLOR_FORMAT_XRGB8888
+            && header.w > 0 && header.h > 0
+            && header.stride >= header.w * 4
+            && size >= sizeof(header) + (size_t)header.stride * header.h;
+    }
+    if (!valid) {
+        bbx_log(BBX_LOG_LEVEL_WARNING, "Background image %s is not an XRGB8888 LVGL image", path);
+        free(data);
+        return false;
+    }
+
+    lv_display_t *disp = lv_obj_get_display(screen);
+    int32_t width = lv_display_get_horizontal_resolution(disp);
+    int32_t height = lv_display_get_vertical_resolution(disp);
+    uint32_t *pixels = scale_to_cover(data + sizeof(header), header.w, header.h, header.stride,
+        width, height);
+    free(data);
+    if (!pixels) {
+        bbx_log(BBX_LOG_LEVEL_WARNING, "Not enough memory for the background image");
+        return false;
+    }
+
+    memset(&background, 0, sizeof(background));
+    background.header.magic = LV_IMAGE_HEADER_MAGIC;
+    background.header.cf = LV_COLOR_FORMAT_XRGB8888;
+    background.header.w = width;
+    background.header.h = height;
+    background.header.stride = width * 4;
+    background.data_size = (uint32_t)width * height * 4;
+    background.data = (const uint8_t *)pixels;
+
+    lv_obj_set_style_bg_image_src(screen, &background, LV_PART_MAIN);
+    return true;
+}
diff --git a/shared/background.h b/shared/background.h
new file mode 100644
index 0000000..98a32c8
--- /dev/null
+++ b/shared/background.h
@@ -0,0 +1,27 @@
+/**
+ * Copyright 2026 misc-de
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+
+#ifndef BBX_BACKGROUND_H
+#define BBX_BACKGROUND_H
+
+#include "lvgl/lvgl.h"
+
+#include <stdbool.h>
+
+/**
+ * Show an image file as the background of a screen, scaled to cover it.
+ *
+ * The file is an LVGL binary image (lv_image_header_t followed by XRGB8888 pixels), usually much
+ * smaller than the display, e.g. a blurred wallpaper. It is scaled up once (bilinear, centred,
+ * the overflow cropped) and kept in memory for the lifetime of the program.
+ *
+ * @param screen the screen object
+ * @param path path of the image file
+ * @return true on success, false if the file is missing or invalid (the screen keeps its colour)
+ */
+bool bbx_background_apply(lv_obj_t *screen, const char *path);
+
+#endif /* BBX_BACKGROUND_H */
