From 8bfecc427ba163ea41791fe4ad11eb4a7366b652 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Wed, 28 Oct 2026 08:47:30 +0100
Subject: [PATCH] themes: make the text cursor of the Breezy themes 2 dp wide

With 1 dp the blinking cursor in the password field is hard to see, in
particular on low-DPI displays where it is a single pixel. The other
themes (postmarketOS, Adwaita, Nord) already use 2 dp.
---
 shared/themes.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/shared/themes.c b/shared/themes.c
index e48513c..a8c0e15 100644
--- a/shared/themes.c
+++ b/shared/themes.c
@@ -111,7 +111,7 @@ static const bbx_theme breezy_light = {
         .pad = 5,
         .placeholder_color = 0x7f8c8d,
         .cursor = {
-            .width = 1,
+            .width = 2,
             .color = 0x232629,
             .period = 700
         }
@@ -266,7 +266,7 @@ static const bbx_theme breezy_dark = {
         .pad = 5,
         .placeholder_color = 0x7f8c8d,
         .cursor = {
-            .width = 1,
+            .width = 2,
             .color = 0xeff0f1,
             .period = 700
         }
