From 9fa9b62f1e7018bfb9dc61a85e3d0db6468acedf Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Wed, 11 Nov 2026 19:58:00 +0100
Subject: [PATCH] unl0kr: the password field in the middle, the eye inside it,
 "?!#" on the symbols key

The message and the password field sat right above the keyboard. They are now centered
vertically between the header and the keyboard, as before only when the keyboard was hidden.

The button that reveals the password was a separate square beside the field. It now sits
inside the field at its right end, without a surface of its own, the text of the field stops
before it, and the eye closes while the password is shown.

The key that opens the page with the symbols said "123", but the numbers are on the top row
of every letter layout already. It says "?!#" now, in all layouts. sq2lv_layouts.c is not
regenerated from squeekboard, so the label is changed in the generated file.
---
 unl0kr/main.c          | 33 +++++++++++++++++++++++++--------
 unl0kr/sq2lv_layouts.c | 36 ++++++++++++++++++------------------
 2 files changed, 43 insertions(+), 26 deletions(-)

diff --git a/unl0kr/main.c b/unl0kr/main.c
index ccdf265..952b406 100644
--- a/unl0kr/main.c
+++ b/unl0kr/main.c
@@ -45,6 +45,7 @@ static bool is_keyboard_hidden = false;
 
 static lv_obj_t *container;
 static lv_obj_t *keyboard;
+static lv_obj_t *toggle_pw_btn_label;
 
 static int32_t content_height_with_kb;
 static int32_t content_height_without_kb;
@@ -242,6 +243,8 @@ static void toggle_password_obscured(void) {
 static void set_password_obscured(bool is_obscured) {
     lv_obj_t *textarea = lv_keyboard_get_textarea(keyboard);
     lv_textarea_set_password_mode(textarea, is_obscured);
+    /* The eye shows what a tap does: open = reveal the password, closed = hide it again */
+    lv_label_set_text(toggle_pw_btn_label, is_obscured? LV_SYMBOL_EYE_OPEN : LV_SYMBOL_EYE_CLOSE);
 }
 
 static void toggle_kb_btn_clicked_cb(lv_event_t *event) {
@@ -579,26 +582,40 @@ int main(int argc, char *argv[]) {
     lv_obj_update_layout(textarea);
     const int32_t textarea_height = lv_obj_get_height(textarea);
 
-    /* Reveal / obscure password button */
+    /* Reveal / obscure password button inside the field at its right end: floating, so the field
+     * takes the whole row, without a surface of its own, and the text of the field stops before it */
     lv_obj_t *toggle_pw_btn = lv_button_create(textarea_container);
+    lv_obj_add_flag(toggle_pw_btn, LV_OBJ_FLAG_FLOATING);
     lv_obj_set_size(toggle_pw_btn, textarea_height, textarea_height);
-    lv_obj_t *toggle_pw_btn_label = lv_label_create(toggle_pw_btn);
+    lv_obj_align(toggle_pw_btn, LV_ALIGN_RIGHT_MID, 0, 0);
+    static const lv_style_selector_t pw_btn_states[] = { LV_STATE_DEFAULT, LV_STATE_PRESSED };
+    for (size_t i = 0; i < sizeof(pw_btn_states) / sizeof(pw_btn_states[0]); i++) {
+        lv_obj_set_style_bg_opa(toggle_pw_btn, LV_OPA_TRANSP, LV_PART_MAIN | pw_btn_states[i]);
+        lv_obj_set_style_border_opa(toggle_pw_btn, LV_OPA_TRANSP, LV_PART_MAIN | pw_btn_states[i]);
+        lv_obj_set_style_shadow_opa(toggle_pw_btn, LV_OPA_TRANSP, LV_PART_MAIN | pw_btn_states[i]);
+    }
+    lv_obj_set_style_text_opa(toggle_pw_btn, LV_OPA_50, LV_PART_MAIN | LV_STATE_PRESSED);
+    lv_obj_set_style_pad_right(textarea, textarea_height, LV_PART_MAIN);
+    toggle_pw_btn_label = lv_label_create(toggle_pw_btn);
     lv_obj_center(toggle_pw_btn_label);
-    lv_label_set_text(toggle_pw_btn_label, LV_SYMBOL_EYE_OPEN);
+    lv_label_set_text(toggle_pw_btn_label, is_password_obscured? LV_SYMBOL_EYE_OPEN : LV_SYMBOL_EYE_CLOSE);
     lv_obj_add_event_cb(toggle_pw_btn, toggle_pw_btn_clicked_cb, LV_EVENT_CLICKED, NULL);
 
-    /* The bottom pad is used to center content when the keyboard is hidden */
-    content_pad_bottom_with_kb = padding;
-
+    /* The bottom pad centers the message and the field vertically between the header and the
+     * keyboard (or the bottom of the screen when the keyboard is hidden) */
     int32_t content_native_height = textarea_height;
     if (cli_opts.message) {
         lv_obj_update_layout(message_label);
         content_native_height += content_pad_row + lv_obj_get_height(message_label);
     }
 
+    content_pad_bottom_with_kb = (content_height_with_kb - content_native_height) / 2;
+    if (content_pad_bottom_with_kb < padding)
+        content_pad_bottom_with_kb = padding;
+
     content_pad_bottom_without_kb = (content_height_without_kb - content_native_height) / 2;
-    if (content_pad_bottom_without_kb < content_pad_bottom_with_kb)
-        content_pad_bottom_without_kb = content_pad_bottom_with_kb;
+    if (content_pad_bottom_without_kb < padding)
+        content_pad_bottom_without_kb = padding;
 
     lv_obj_set_style_pad_bottom(container, is_keyboard_hidden? content_pad_bottom_without_kb : content_pad_bottom_with_kb, LV_PART_MAIN);
 
