From 7aa4b568e198a8413f9eefd7a5518560f24d4fb3 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Wed, 28 Oct 2026 09:28:25 +0100
Subject: [PATCH] unl0kr: add a Russian keyboard layout

Generated from squeekboard's ru.yaml (commit 27c359c4ccd7) and added to
the existing layouts, which stay as they are: regenerating them from
current squeekboard would change them as well. squeek2lvgl now knows
squeekboard's BackSpace-wide key, which current layouts use on the
number and symbol views.
---
 squeek2lvgl/squeek2lvgl.py   |   2 +
 unl0kr/regenerate-layouts.sh |   2 +
 unl0kr/sq2lv_layouts.c       | 205 ++++++++++++++++++++++++++++++++++-
 unl0kr/sq2lv_layouts.h       |   3 +-
 4 files changed, 208 insertions(+), 4 deletions(-)

diff --git a/squeek2lvgl/squeek2lvgl.py b/squeek2lvgl/squeek2lvgl.py
index 26ef69c..816ccb5 100644
--- a/squeek2lvgl/squeek2lvgl.py
+++ b/squeek2lvgl/squeek2lvgl.py
@@ -312,6 +312,7 @@ keycap_for_key = {
     '←': 'LV_SYMBOL_LEFT',
     '→': 'LV_SYMBOL_RIGHT',
     'BackSpace': 'LV_SYMBOL_BACKSPACE',
+    'BackSpace-wide': 'LV_SYMBOL_BACKSPACE',
     'show_upper': 'SQ2LV_SYMBOL_SHIFT',
     'Return': 'LV_SYMBOL_OK',
     'Up': 'LV_SYMBOL_UP',
@@ -334,6 +335,7 @@ def key_is_modifier(key, data_buttons):
 
 repeatable_keys = {
     'BackSpace',
+    'BackSpace-wide',
     'Del',
     'PageUp',
     'PageDown',
diff --git a/unl0kr/regenerate-layouts.sh b/unl0kr/regenerate-layouts.sh
index 8a4e5f5..403aa54 100755
--- a/unl0kr/regenerate-layouts.sh
+++ b/unl0kr/regenerate-layouts.sh
@@ -15,6 +15,8 @@ pipenv run python squeek2lvgl.py \
       --name "Español" \
     --input fr.yaml \
       --name "Français" \
+    --input ru.yaml \
+      --name "Русский" \
     --extra-top-row-base "1 2 3 4 5 6 7 8 9 0" \
     --extra-top-row-upper "! @ # $ % ^ & * ( )" \
     --output ../unl0kr \
