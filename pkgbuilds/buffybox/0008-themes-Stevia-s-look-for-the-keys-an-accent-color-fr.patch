+         * letters */
+        key = &(current_theme.keyboard.keys.key_char);
     } else if ((btnm->ctrl_bits[dsc->id1] & SQ2LV_CTRL_NON_CHAR) == SQ2LV_CTRL_NON_CHAR) {
         key = &(current_theme.keyboard.keys.key_non_char);
     } else {
@@ -367,12 +381,19 @@ static void keyboard_draw_task_added_cb(lv_event_t *event) {
     lv_draw_label_dsc_t *label_dsc = lv_draw_task_get_label_dsc(draw_task);
     if (label_dsc) {
         label_dsc->color = lv_color_hex((pressed ? key->pressed : key->normal).fg_color);
+        const lv_font_t *font = key == &(current_theme.keyboard.keys.key_char)
+            ? current_theme.keyboard.keys.font_char : current_theme.keyboard.keys.font_other;
+        if (font) {
+            label_dsc->font = font;
