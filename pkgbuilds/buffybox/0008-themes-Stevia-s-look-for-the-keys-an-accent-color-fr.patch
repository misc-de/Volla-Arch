     }
 
     lv_draw_fill_dsc_t *fill_dsc = lv_draw_task_get_fill_dsc(draw_task);
     if (fill_dsc) {
         fill_dsc->color = lv_color_hex((pressed ? key->pressed : key->normal).bg_color);
-        if (pressed && current_theme.glass.enabled) {
+        /* In glass, an active modifier looks like a pressed key */
+        if (current_theme.glass.enabled
+                && (pressed || key == &(current_theme.keyboard.keys.key_mod_act))) {
             fill_dsc->opa = current_theme.glass.pressed_opa;
         }
     }
@@ -411,3 +432,40 @@ void bbx_theme_apply(const bbx_theme *theme) {
     lv_obj_report_style_change(NULL); /* Update existing objects */
     lv_display_set_theme(NULL, &lv_theme); /* Set a theme for future objects */
 }
+
+void bbx_theme_set_accent(bbx_theme *theme, uint32_t color) {
+    if (!theme->accent_configurable) {
+        return;
+    }
+
+    /* Accent a little darker while pressed, as Stevia's shade(accent, 0.8) */
+    const uint32_t darker = ((((color >> 16) & 0xFF) * 4 / 5) << 16)
+        | ((((color >> 8) & 0xFF) * 4 / 5) << 8)
+        | ((color & 0xFF) * 4 / 5);
+
+    bbx_theme_keys *keys = &(theme->keyboard.keys);
+    if (theme->glass.enabled) {
+        /* Every key takes the accent while pressed, an active modifier also at rest */
+        bbx_theme_key *all[] = { &keys->key_char, &keys->key_non_char, &keys->key_mod_act, &keys->key_mod_inact };
+        for (size_t i = 0; i < sizeof(all) / sizeof(all[0]); i++) {
+            all[i]->pressed.bg_color = color;
+            all[i]->pressed.border_color = color;
+        }
+        keys->key_mod_act.normal.bg_color = color;
+        keys->key_mod_act.normal.border_color = color;
+    }
+    if (keys->has_key_confirm) {
+        keys->key_confirm.normal.bg_color = color;
+        keys->key_confirm.normal.border_color = color;
+        keys->key_confirm.pressed.bg_color = darker;
+        keys->key_confirm.pressed.border_color = darker;
+    }
+
+    theme->button.pressed.bg_color = color;
+    theme->button.pressed.border_color = color;
+    theme->dropdown.button.pressed.bg_color = color;
+    theme->dropdown.button.pressed.border_color = color;
+    theme->dropdown.list.selection_bg_color = color;
+    theme->bar.border_color = color;
+    theme->bar.indicator.bg_color = color;
+}
