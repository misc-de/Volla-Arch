diff --git a/shared/fonts/regenerate-keys.sh b/shared/fonts/regenerate-keys.sh
new file mode 100755
index 0000000..ec04b49
--- /dev/null
+++ b/shared/fonts/regenerate-keys.sh
@@ -0,0 +1,23 @@
+#!/bin/sh -ex
+
+# Copyright 2026 misc-de
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+# Fonts of the on-screen keys in the Plinius themes: Adwaita Sans, as Phosh's keyboard Stevia, at
+# the size of its labels. Only the characters the layouts show (unl0kr-keycaps of pkgbuilds/buffybox);
+# icons and anything else come from the fallback bbx_font_32.
+#
+# Adwaita Sans is a variable font, lv_font_conv needs static weights (adwaita-fonts 51.0, license
+# in AdwaitaSans-LICENSE):
+#   fonttools varLib.instancer AdwaitaSans-Regular.ttf wght=400 -o AdwaitaSans-KeyRegular.ttf
+#   fonttools varLib.instancer AdwaitaSans-Regular.ttf wght=700 -o AdwaitaSans-KeyBold.ttf
+
+ranges='0x0020-0x007E,0x00A1,0x00A3,0x00A5,0x00A7,0x00A9,0x00AB,0x00AE,0x00B0,0x00B2-0x00B7,0x00BB,0x00BF-0x00C2,0x00C4,0x00C7-0x00CA,0x00CC-0x00CF,0x00D1-0x00D4,0x00D6-0x00D7,0x00D9-0x00DC,0x00DF-0x00E2,0x00E4,0x00E6-0x00EF,0x00F1-0x00F4,0x00F6-0x00F7,0x00F9-0x00FC,0x0153,0x03C0,0x03C4,0x0401,0x0410-0x044F,0x0451,0x201C,0x201E,0x20AC,0x221A'
+
+npx lv_font_conv --bpp 4 --size 44 --no-compress --format lvgl --lv-fallback bbx_font_32 \
+    --lv-font-name bbx_font_key_regular -o font_key_regular.c \
+    --font AdwaitaSans-KeyRegular.ttf --range "$ranges"
+
+npx lv_font_conv --bpp 4 --size 44 --no-compress --format lvgl --lv-fallback bbx_font_32 \
+    --lv-font-name bbx_font_key_bold -o font_key_bold.c \
+    --font AdwaitaSans-KeyBold.ttf --range "$ranges"
