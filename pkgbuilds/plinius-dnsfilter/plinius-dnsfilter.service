[Unit]
Description=DNS filter for the phone, its hotspot and USB clients (Settings > Network & VPN > DNS Filter)
# The servers come from NetworkManager; /run/plinius-dns comes from tmpfiles
After=NetworkManager.service systemd-tmpfiles-setup.service dbus.service
Wants=nss-lookup.target
Before=nss-lookup.target

[Service]
Type=dbus
BusName=org.plinius.DnsFilter
ExecStart=/usr/bin/plinius-dnsfilter
# Also after a crash: the phone gets NetworkManager's DNS back, our firewall rules go
ExecStopPost=/usr/bin/plinius-dnsfilter --cleanup
Restart=on-failure
RestartSec=2
StateDirectory=plinius-dnsfilter
# The query log, statistics and own servers are private (the stub resolv.conf is written 0644
# on purpose)
StateDirectoryMode=0700
# No GSettings (no session, no dconf) and no proxy lookup: the filter talks to servers directly
Environment=GSETTINGS_BACKEND=memory GIO_USE_PROXY_RESOLVER=dummy

# Sandbox (docs/DIENSTE-HAERTEN.md). Root for the firewall rules (iptables-legacy needs
# NET_ADMIN and NET_RAW for its raw socket), port 53 (NET_BIND_SERVICE), and SO_BINDTODEVICE to
# ask a network's servers through its own interface (NET_RAW). It reads the hotspot's leases in
# /var/lib/NetworkManager and writes only its state, the resolv.conf link in /run/plinius-dns
# and iptables' lock file (created by tmpfiles, so it exists).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/plinius-dns /run/xtables.lock
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
UMask=0077
# Root without DAC capabilities can still read root's 0600 files: the secrets of others stay
# out of reach (the hotspot's leases in /var/lib/NetworkManager are read, its secret_key not)
InaccessiblePaths=-/etc/shadow -/etc/gshadow -/etc/ssh -/etc/NetworkManager/system-connections
InaccessiblePaths=-/var/lib/NetworkManager/secret_key -/var/lib/bluetooth -/var/lib/biomd
InaccessiblePaths=-/var/lib/plinius-face -/var/lib/plinius-pinguard -/var/lib/plinius-netlog
InaccessiblePaths=-/var/lib/plinius-crypt -/var/lib/plinius-energy -/var/lib/iwd
# Throttled and reclaimed from here on, before MemoryMax ends the service (and with it the filter)
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=multi-user.target
