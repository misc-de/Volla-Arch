# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-dnsfilter
pkgver=0.1
pkgrel=15
pkgdesc="DNS filter of the Volla Phone Plinius: blocklists, own rules, own DNS servers (also DoT/DoH), statistics and a query log, for the phone, its hotspot and USB clients"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
license=(MIT)
# glib-networking: TLS for DNS over TLS/HTTPS and list downloads. iptables-legacy: redirects
# of hotspot/USB DNS (the GKI kernel has no nf_tables). NetworkManager: the network's servers.
depends=(glib2 glib-networking libsoup3 iptables networkmanager systemd)
install=plinius-dnsfilter.install
source=(plinius-dnsfilter.c
	appid.c
	appid.h
	dnsmsg.c
	dnsmsg.h
	filter.c
	filter.h
	test-dnsfilter.c
	plinius-dnsfilter.service
	org.plinius.DnsFilter.conf
	org.plinius.DnsFilter.service
	plinius-dnsfilter.tmpfiles
	LICENSE)
sha256sums=('092d2caffec5a57c4ed266dc4bb97f0a8bb45614f09cb10bff240945295cde21'
	'7a32877b6a6f03dfd2b9b0cba38639c44e8073e1ee14938ee9d51153fbc187d2'
