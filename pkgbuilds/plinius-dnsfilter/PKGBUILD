_cflags() {
	echo -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -Wno-type-limits
}

build() {
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS $(_cflags) -o plinius-dnsfilter plinius-dnsfilter.c appid.c dnsmsg.c filter.c \
		$(pkg-config --cflags --libs gio-unix-2.0 libsoup-3.0) $LDFLAGS
}

check() {
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS $(_cflags) -o test-dnsfilter test-dnsfilter.c appid.c dnsmsg.c filter.c \
		$(pkg-config --cflags --libs gio-2.0) $LDFLAGS
	./test-dnsfilter
}

package() {
	install -Dm755 plinius-dnsfilter -t "$pkgdir/usr/bin"
	install -Dm644 plinius-dnsfilter.service -t "$pkgdir/usr/lib/systemd/system"
	# Enabled by the package; with the filter off it leaves after two minutes
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-dnsfilter.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	install -Dm644 org.plinius.DnsFilter.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 org.plinius.DnsFilter.service -t "$pkgdir/usr/share/dbus-1/system-services"
	install -Dm644 plinius-dnsfilter.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/plinius-dnsfilter.conf"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
