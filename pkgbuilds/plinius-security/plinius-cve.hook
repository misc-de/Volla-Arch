# The list of known vulnerabilities follows package changes at once. Also gives a first list
# right after installing plinius-security; its file name sorts after 30-systemd-sysusers.hook,
# so the user plinius-cve exists by then.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Comparing packages with known vulnerabilities...
When = PostTransaction
Exec = /usr/bin/systemctl start --no-block plinius-cve-match.service
