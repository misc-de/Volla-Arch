[Unit]
Description=PIN checks with waiting time after wrong PINs
Requires=plinius-pinguard.socket

[Service]
ExecStart=/usr/lib/plinius-pinguard/plinius-pinguard
# The counters of wrong PINs, root only
StateDirectory=plinius-pinguard
StateDirectoryMode=0700
# Reads /etc/shadow (root's own file, no capability needed), writes its state; nothing else
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX
