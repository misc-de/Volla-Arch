From 57056789575596488d0f09829f80c6d7e1da0a66 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 22 Nov 2026 08:17:06 +0100
Subject: [PATCH 1/3] Pass EGLAttrib lists to eglGetPlatformDisplay

eglGetPlatformDisplay takes EGLAttrib (pointer-sized) attributes; the
loader's typedef and the two HYBRIS callers used EGLint, which GCC 14 and
later reject as incompatible pointer types.
---
 src/gl/loader.h   | 2 +-
 src/glx/glx.c     | 2 +-
 src/glx/hardext.c | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/gl/loader.h b/src/gl/loader.h
index 065949cf..a87a4f1b 100644
--- a/src/gl/loader.h
+++ b/src/gl/loader.h
@@ -29,7 +29,7 @@ typedef EGLContext (*eglGetCurrentContext_PTR)();
 typedef EGLDisplay (*eglGetCurrentDisplay_PTR)();
 typedef EGLSurface (*eglGetCurrentSurface_PTR)(EGLint readdraw);
 typedef EGLDisplay (*eglGetDisplay_PTR)(EGLNativeDisplayType display_id);
-typedef EGLDisplay (*eglGetPlatformDisplay_PTR)(EGLenum platform, void * native_display, const EGLint * attrib_list);
+typedef EGLDisplay (*eglGetPlatformDisplay_PTR)(EGLenum platform, void * native_display, const EGLAttrib * attrib_list);
 typedef EGLint (*eglGetError_PTR)();
 typedef __eglMustCastToProperFunctionPointerType (*eglGetProcAddress_PTR)(const char * procname);
 typedef EGLBoolean (*eglInitialize_PTR)(EGLDisplay dpy, EGLint * major, EGLint * minor);
diff --git a/src/glx/glx.c b/src/glx/glx.c
index cea831c5..07d066da 100644
--- a/src/glx/glx.c
+++ b/src/glx/glx.c
@@ -389,7 +389,7 @@ static void init_display(Display *display) {
     }
 
 #ifdef HYBRIS
-    EGLint attribs[] = { EGL_NONE };
+    EGLAttrib attribs[] = { EGL_NONE };
     eglDisplay = egl_eglGetPlatformDisplay(EGL_PLATFORM_ANDROID_KHR, EGL_DEFAULT_DISPLAY, attribs);
 #endif
 
diff --git a/src/glx/hardext.c b/src/glx/hardext.c
index e8d66c4e..32ae593d 100644
--- a/src/glx/hardext.c
+++ b/src/glx/hardext.c
@@ -256,7 +256,7 @@ void GetHardwareExtensions(int notest)
 #endif
 #ifdef HYBRIS
     {
-        EGLint attribs[] = { EGL_NONE };
+        EGLAttrib attribs[] = { EGL_NONE };
         eglDisplay = egl_eglGetPlatformDisplay(EGL_PLATFORM_ANDROID_KHR, EGL_DEFAULT_DISPLAY, attribs);
     }
 #else
-- 
