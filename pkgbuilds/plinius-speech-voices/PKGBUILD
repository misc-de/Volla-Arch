# Nothing to strip; the ONNX files hardly compress
options=(!strip !debug)

# _voice <id> <name> <language> <locale> <default> <license>
_voice() {
	depends=(plinius-speech)
	local dir="$pkgdir/usr/share/plinius-speech/voices/$1"
	install -Dm644 "$1.onnx" "$dir/$1.onnx"
	install -Dm644 "$1.onnx.json" "$dir/$1.onnx.json"
	install -Dm644 "$1.MODEL_CARD" "$pkgdir/usr/share/licenses/$pkgname/MODEL_CARD"
	printf '{"id": "%s", "name": "%s", "language": "%s", "locale": "%s", "model": "%s.onnx", "config": "%s.onnx.json", "quality": "medium", "license": "%s", "default": %s}\n' \
		"$1" "$2" "$3" "$4" "$1" "$1" "$6" "$5" >"$dir/voice.json"
}

package_plinius-speech-voice-de-de-thorsten() {
	pkgdesc="German voice Thorsten for the Plinius speech output (Piper, medium quality)"
	license=(CC0-1.0)
	_voice de_DE-thorsten-medium "Thorsten" de de_DE true "CC0-1.0"
}

