package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm644 50-plinius.conf -t "$pkgdir/etc/ssh/sshd_config.d"
	install -Dm644 90-plinius.gschema.override -t "$pkgdir/usr/share/glib-2.0/schemas"
	# The accent color (Arch blue, see the override) for libadwaita apps of new users
	install -Dm644 skel-gtk.css "$pkgdir/etc/skel/.config/gtk-4.0/gtk.css"
	# Default wallpaper (see the override), also offered in Settings
	install -Dm644 arch-black.png -t "$pkgdir/usr/share/backgrounds/plinius"
	install -Dm644 plinius-backgrounds.xml "$pkgdir/usr/share/gnome-background-properties/plinius.xml"
	install -Dm644 50-plinius.gbinder.conf "$pkgdir/etc/gbinder.d/50-plinius.conf"
	install -Dm644 bootcheck.list "$pkgdir/usr/lib/plinius-bootcheck.d/ansuz.list"
	# udev's v4l_id opens every video device; opening the camera's imgsys node while the camera HAL in
	# the Android container uses it hits a kernel BUG in mtk_imgsys_v4l2_fh_open (list corruption,
	# panic and reboot, seen 2026-10-28). Ubuntu Touch disables the rules file for the same reason.
	install -d "$pkgdir/etc/udev/rules.d"
	ln -s /dev/null "$pkgdir/etc/udev/rules.d/60-persistent-v4l.rules"
	# Device access for the active session (uaccess) only where /dev holds ACLs: without them the
	# builtin only logs errors, so plinius-dev-acl then puts a 73-seat-late.rules without it in /run
	install -Dm644 73-plinius-seat-late-noacl.rules "$pkgdir/usr/lib/plinius/udev/73-seat-late-noacl.rules"
	install -Dm755 plinius-dev-acl -t "$pkgdir/usr/lib/plinius"
	install -Dm644 plinius-dev-acl.service -t "$pkgdir/usr/lib/systemd/system"
	install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
	ln -s ../plinius-dev-acl.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/"
	# Halium overlay: mount-halium-overlay binds these over the files of the Android image
	# (vendor/etc/init/*.rc: replaced or switched off; see each file)
	local o="$pkgdir/usr/share/halium-overlay"
	install -Dm644 halium-vndservicemanager.rc "$o/vendor/etc/init/vndservicemanager.rc"
	install -Dm644 halium-usb-gadget.rc "$o/vendor/etc/init/android.hardware.usb.gadget-aidl-service.mediatek.rc"
	install -Dm644 halium-bluetooth-1.1.rc "$o/vendor/etc/init/android.hardware.bluetooth@1.1-service-mediatek.rc"
	install -Dm644 halium-livedisplay.rc "$o/vendor/etc/init/vendor.lineage.livedisplay-service.sysfs.rc"
	install -Dm644 halium-hwcomposer.rc "$o/vendor/etc/init/android.hardware.graphics.composer@3.2-service.rc"
	install -Dm644 halium-gralloc.rc "$o/vendor/etc/init/android.hardware.graphics.allocator-V2-service-mediatek.rc"
	install -Dm644 halium-prop.halium "$o/system/etc/prop.halium"
	# android-off: services without a client on the Linux side, see halium-android-off.rc
	local f
	for f in system/etc/init/{mediaextractor,mediametrics,idmap2d,credstore,storaged,gpuservice,wificond,incidentd,installd,perfetto}.rc \
		system/etc/init/hw/{drmserver,mediaserver}.zygote64{,_32}.rc \
		vendor/etc/init/android.hardware.drm-service.clearkey.rc \
		vendor/etc/init/android.hardware.media.c2@1.2-mediatek-64b.rc; do
		install -Dm644 halium-android-off.rc "$o/$f"
	done
	install -Dm644 halium-android-off-apex.rc "$o/vendor/etc/init/cas-default.rc"
	install -Dm644 halium-camera-service.rc "$o/system/etc/init/camera_service.rc"
	install -Dm644 halium-neuralnetworks-shim.rc "$o/vendor/etc/init/android.hardware.neuralnetworks-shim-service-mtk.rc"
	install -Dm644 50-plinius-powerkey.conf -t "$pkgdir/usr/lib/systemd/logind.conf.d"
	# Phosh session: display scale, GL without Vulkan for apps
	install -Dm644 phoc.ini -t "$pkgdir/etc/phosh"
	# Processor name and scale steps for GNOME Settings (gnome-control-center-plinius)
	install -Dm644 device.conf -t "$pkgdir/usr/share/plinius"
	# Panel of the built-in display in gmobile's format (camera cutout as Android's overlay
	# describes it: 30x36 dp at 480 dpi, centered); phosh-plinius lays the top bar out from it
	install -Dm644 display-panel.json -t "$pkgdir/usr/share/plinius"
	# PIN rules for GNOME Settings' password dialog (libpwquality): at least 6 digits
	install -Dm644 50-plinius-pin.conf -t "$pkgdir/etc/security/pwquality.conf.d"
	install -Dm644 60-plinius-render.conf -t "$pkgdir/usr/lib/environment.d"
	# libgbm looks for a backend named after the DRM driver (mediatek) before its own
	install -d "$pkgdir/usr/lib/gbm"
	ln -s hybris_gbm.so "$pkgdir/usr/lib/gbm/mediatek_gbm.so"
	# Every process: keeps glibc's static TLS off the bionic slots Mali uses (libhybris)
	install -Dm644 ld.so.preload -t "$pkgdir/etc"
	# GPU clock floor while rendering (GED has no frame hints without SurfaceFlinger), set once
	# the vendor modules have made GED's files
	install -Dm644 plinius-gpu.service -t "$pkgdir/usr/lib/systemd/system"
	install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
	ln -s ../plinius-gpu.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/"
	# Owners and modes of the vendor device nodes (the container's ueventd cannot set them),
	# with the Android IDs as host users; generated by tools/ueventd2udev.py
	install -Dm644 70-plinius-android.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# The touch controller's pen input as no tablet: no pen works on it (Graphics Tablets hidden)
	install -Dm644 61-plinius-pen.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# No log of the touches with their coordinates (PIN, typed text)
	install -Dm644 61-plinius-touch-log.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# The hardware video encoder for the session (v4l2h264enc), after 70-plinius-android.rules
	install -Dm644 71-plinius-vcodec.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# The camera's nodes for the HAL only, before 73-seat-late.rules (see the file)
	install -Dm644 72-plinius-camera-no-uaccess.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# Touch, keys and pen not for every program of the session, two devices for its services
	install -Dm644 72-plinius-input-session.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# The phone's own partitions and Android's images stay out of Files, after 80-udisks2.rules
	install -Dm644 82-plinius-hide-storage.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# Attaching a disk image takes the PIN, so no app can mount a prepared filesystem unseen
	install -Dm644 50-plinius-udisks-loop.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
	# Audio HAL nodes from init.mt6878.rc (/dev/usip: speech parameters to the modem)
	install -Dm644 71-plinius-audio.rules -t "$pkgdir/usr/lib/udev/rules.d"
	# Hall sensor (flip cover) as a key no app sees and phoc does not wake on
	install -Dm644 61-plinius-keys.hwdb -t "$pkgdir/usr/lib/udev/hwdb.d"
	# Logo while the session starts, instead of phoc's spinner (phoc-plinius 0004): the Arch Linux
	# logo (trademark: https://terms.archlinux.org/docs/trademark-policy/), mark and wordmark
	install -Dm644 boot-logo-mark.png "$pkgdir/usr/share/plinius/boot-logo/mark.png"
	install -Dm644 boot-logo-wordmark.png "$pkgdir/usr/share/plinius/boot-logo/wordmark.png"
	install -Dm644 plinius-android.sysusers "$pkgdir/usr/lib/sysusers.d/plinius-android.conf"
	# WLAN: driver from vendor_dlkm, NVRAM from the container, then power on
	install -Dm755 plinius-wlan -t "$pkgdir/usr/lib/plinius"
	install -Dm644 plinius-wlan.service -t "$pkgdir/usr/lib/systemd/system"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-wlan.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	install -Dm644 50-plinius-nm.conf -t "$pkgdir/usr/lib/NetworkManager/conf.d"
	# NetworkManager's connection check off or with another server, from Settings > Privacy >
	# Automatic Connections (pkexec, no password; writes /etc/NetworkManager/conf.d)
	install -Dm755 plinius-connectivity-set -t "$pkgdir/usr/lib/plinius"
	install -Dm644 org.plinius.connectivity.policy -t "$pkgdir/usr/share/polkit-1/actions"
	# Mobile data on a new phone at once: the first access point of a SIM from oFono's context
	install -Dm755 plinius-mobile-data -t "$pkgdir/usr/lib/plinius"
	install -Dm644 plinius-mobile-data.service -t "$pkgdir/usr/lib/systemd/system"
	ln -s ../plinius-mobile-data.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# Chip and firmware versions for Settings > System > Hardware, collected as root at boot
	install -Dm755 plinius-hardware-info -t "$pkgdir/usr/lib/plinius"
	install -Dm644 plinius-hardware-info.service -t "$pkgdir/usr/lib/systemd/system"
	ln -s ../plinius-hardware-info.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# Bluetooth: bluebinder after the container, address from NVRAM
	install -Dm755 droid-get-bt-address.sh -t "$pkgdir/usr/bin/droid"
	install -Dm644 bluebinder-plinius.conf "$pkgdir/usr/lib/systemd/system/bluebinder.service.d/plinius.conf"
	# Play, pause and next from a car or headset (AVRCP) reach the media players: BlueZ only knows
	# players registered with it, and mpris-proxy does that for MPRIS. Arch ships the unit disabled
	install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
	ln -s ../mpris-proxy.service "$pkgdir/usr/lib/systemd/user/default.target.wants/"
	# Smart cards and the smart card part of security keys: pcscd starts on first use through its
	# socket. Arch ships the socket disabled
	install -d "$pkgdir/usr/lib/systemd/system/sockets.target.wants"
	ln -s ../pcscd.socket "$pkgdir/usr/lib/systemd/system/sockets.target.wants/"
	# Mobile network: ofono-binder-plugin on the AIDL radio HAL, ofono after the container
	install -Dm644 ofono-binder.conf "$pkgdir/etc/ofono/binder.conf"
	# Mobile data on the SIM that is there, with two slots oFono picks none by itself
	install -Dm644 ofono-main.conf "$pkgdir/etc/ofono/main.conf"
	install -Dm644 ofono-plinius.conf "$pkgdir/usr/lib/systemd/system/ofono.service.d/plinius.conf"
	# biomd goes down and up with the Android container, whose fingerprint HAL it uses
	install -Dm644 biomd-plinius.conf "$pkgdir/usr/lib/systemd/system/biomd.service.d/plinius.conf"
	# NFC: nfcd after the container, adapter powered on start
	install -Dm755 plinius-nfc-power -t "$pkgdir/usr/lib/plinius"
	install -Dm644 nfcd-plinius.conf "$pkgdir/usr/lib/systemd/system/nfcd.service.d/plinius.conf"
	# Sandboxes for the services that parse input from outside (docs/DIENSTE-HAERTEN.md)
	local _unit
	for _unit in nfcd bluebinder ofono cups biomd; do
		install -Dm644 $_unit-sandbox.conf \
			"$pkgdir/usr/lib/systemd/system/$_unit.service.d/10-plinius-sandbox.conf"
	done
	install -Dm755 plinius-display-nfc "$pkgdir/usr/lib/plinius/display.d/50-nfc"
	# GPS: gnss-nmea-bridge after the container
	install -Dm644 gnss-nmea-bridge-plinius.conf \
		"$pkgdir/usr/lib/systemd/system/gnss-nmea-bridge.service.d/plinius.conf"
	# Audio: audio-hal-bridge with the HAL in the vendor namespace, raw ALSA card hidden
	install -Dm644 audio-hal-bridge-plinius.conf \
		"$pkgdir/usr/lib/systemd/user/audio-hal-bridge.service.d/plinius.conf"
	install -Dm644 50-plinius-audio.conf -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"
	# Role based volumes (media, notifications, calls, alarms, ringtones, alerts), each a share
	# of the output; Arch builds feedbackd without its media-roles option
	install -Dm644 55-plinius-media-roles.conf -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d"
	# A Bluetooth or USB audio device that connects becomes the default
	install -Dm644 plinius-new-device-default.lua "$pkgdir/usr/share/wireplumber/scripts/plinius/new-device-default.lua"
	# Hands-free on a Bluetooth headset only while audio-hal-bridge needs it
	install -Dm644 plinius-bt-hands-free-profile.lua "$pkgdir/usr/share/wireplumber/scripts/plinius/bt-hands-free-profile.lua"
	# Call audio (callaudiod's D-Bus API) from audio-hal-bridge
	install -Dm644 org.mobian_project.CallAudio.service -t "$pkgdir/usr/share/plinius/dbus-1/services"
	install -Dm644 50-plinius-callaudio.conf -t "$pkgdir/usr/lib/environment.d"
	# Sensors: sensor-proxy-bridge after the container
	install -Dm644 sensor-proxy-bridge-plinius.conf \
		"$pkgdir/usr/lib/systemd/system/sensor-proxy-bridge.service.d/plinius.conf"
	# libhybris environment: user sessions, login shells, system services
	install -Dm644 50-plinius-hybris.conf -t "$pkgdir/usr/lib/environment.d"
	install -Dm644 plinius-hybris.sh -t "$pkgdir/etc/profile.d"
	# Bash prompt: the user name in the accent color, sourced by /etc/bash.bashrc (see .install)
	install -Dm644 plinius-prompt.sh "$pkgdir/usr/lib/plinius/bash-prompt.sh"
	# Default aliases (ll, l, .., rm -i ...), sourced by /etc/bash.bashrc the same way
	install -Dm644 plinius-aliases.sh "$pkgdir/usr/lib/plinius/bash-aliases.sh"
	# Keyring prompt at boot in phosh's style instead of gcr's bare window: a session service of
	# the same name that waits for phosh, found first like the call audio one below
	install -Dm755 keyring-prompter-wait -t "$pkgdir/usr/lib/plinius"
	install -Dm644 org.gnome.keyring.SystemPrompter.service -t "$pkgdir/usr/share/plinius/dbus-1/services"
	# iBus stays installed for gnome-shell and libibus, but no longer starts
	install -Dm644 org.freedesktop.IBus.service org.freedesktop.portal.IBus.service \
		-t "$pkgdir/usr/share/plinius/dbus-1/services"
	install -Dm644 50-plinius-hybris-system.conf "$pkgdir/usr/lib/systemd/system.conf.d/50-plinius-hybris.conf"
	install -Dm644 mount-android-partitions-plinius.conf \
		"$pkgdir/usr/lib/systemd/system/mount-android-partitions.service.d/plinius.conf"
	# Container start without the 5 s wait for keystore2 in Android's init.rc
	install -Dm755 plinius-android-initrc -t "$pkgdir/usr/lib/plinius"
	install -Dm644 lxc-android-config-plinius.conf \
		"$pkgdir/usr/lib/systemd/system/lxc-android-config.service.d/plinius.conf"
	# Login without waiting for NetworkManager (network.target)
	install -Dm755 plinius-user-sessions-generator -t "$pkgdir/usr/lib/systemd/system-generators"
	# polkit password checks: the kernel (6.1) lacks the pidfd sockets of polkit's agent helper
	# socket, so it is masked and a pacman hook makes the helper setuid (see the script)
	install -d "$pkgdir/etc/systemd/system"
	ln -s /dev/null "$pkgdir/etc/systemd/system/polkit-agent-helper.socket"
	install -Dm755 plinius-polkit-helper -t "$pkgdir/usr/share/libalpm/scripts"
	install -Dm644 plinius-polkit-helper.hook -t "$pkgdir/usr/share/libalpm/hooks"
	# No setuid bit on programs the phone does not use (ksu, mount.cifs, lxc-user-nic, chfn, chsh)
	install -Dm644 plinius-drop-setuid.hook -t "$pkgdir/usr/share/libalpm/hooks"
	install -Dm755 plinius-drop-setuid -t "$pkgdir/usr/share/libalpm/scripts"
	# No binder for services that read the network or the radio and do not need it
	local unit
	for unit in cups bluetooth wpa_supplicant ModemManager geoclue plinius-netlogd; do
		install -Dm644 90-plinius-no-binder.conf -t "$pkgdir/usr/lib/systemd/system/$unit.service.d"
	done
	# Launchers other packages pull in (developer tools, stoken via openconnect, CUPS's web
	# interface) hidden from the app grid, on every install and upgrade of those packages
	install -Dm755 plinius-hide-apps -t "$pkgdir/usr/share/libalpm/scripts"
	install -Dm644 plinius-hide-apps.hook -t "$pkgdir/usr/share/libalpm/hooks"
	# Updates that touch udev rules: no error from drivers that refuse "change" (see the script)
	install -Dm755 plinius-udev-reload -t "$pkgdir/usr/share/libalpm/scripts"
	install -Dm644 35-systemd-udev-reload.hook -t "$pkgdir/etc/pacman.d/hooks"
	# Not on this phone. iio-sensor-proxy: sensor-proxy-bridge owns its bus name, systemd refused
	# the pair at every boot. IBus: Stevia is the input method, its daemons took 22 MB. bluez.conf
	# only loads crypto_user, which this kernel does not have.
	install -d "$pkgdir/etc/systemd/user" "$pkgdir/etc/modules-load.d"
	ln -s /dev/null "$pkgdir/etc/systemd/system/iio-sensor-proxy.service"
	ln -s /dev/null "$pkgdir/etc/systemd/user/org.freedesktop.IBus.session.GNOME.service"
	ln -s /dev/null "$pkgdir/etc/modules-load.d/bluez.conf"
	# Kernel hardening without a cost in daily use (Lynis audit, docs/SICHERHEIT.md) and the
	# free memory the kernel keeps at hand (60-plinius-memory.conf)
	install -Dm644 60-plinius-hardening.conf 60-plinius-memory.conf -t "$pkgdir/usr/lib/sysctl.d"
	# No connections from the internet over mobile data (the IMS interface for VoLTE stays open);
	# also before the connection is up, through pre-up.d
	install -Dm755 plinius-mobile-firewall "$pkgdir/usr/lib/NetworkManager/dispatcher.d/10-plinius-mobile-firewall"
	install -d "$pkgdir/usr/lib/NetworkManager/dispatcher.d/pre-up.d"
	ln -s ../10-plinius-mobile-firewall "$pkgdir/usr/lib/NetworkManager/dispatcher.d/pre-up.d/"
	# Journal size on the memory card
	install -Dm644 50-plinius-journald.conf -t "$pkgdir/usr/lib/systemd/journald.conf.d"
	# What our services write to stdout and stderr stays in the journal (stored at notice)
	install -Dm644 50-plinius-log-level.conf -t "$pkgdir/usr/lib/systemd/system/plinius-.service.d"
	install -Dm644 50-plinius-log-level.conf -t "$pkgdir/usr/lib/systemd/user/plinius-.service.d"
	for _unit in gnss-nmea-bridge sensor-proxy-bridge vibrator-ff-bridge; do
		install -Dm644 50-plinius-log-level.conf -t "$pkgdir/usr/lib/systemd/system/$_unit.service.d"
	done
	for _unit in audio-hal-bridge camera-hal-bridge mmsd-sim-gate firefox-preload; do
		install -Dm644 50-plinius-log-level.conf -t "$pkgdir/usr/lib/systemd/user/$_unit.service.d"
	done
	# Files phoc reads at start, into the page cache before the container keeps the card busy
	install -Dm644 plinius-preload.service -t "$pkgdir/usr/lib/systemd/system"
	install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
	ln -s ../plinius-preload.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/"
}
