# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=device-volla-ansuz
pkgver=0.5
pkgrel=96
pkgdesc="Device configuration for Volla Phone Plinius (ansuz): binder, Android container, boot chain check, SSH over USB"
arch=(any)
license=(MIT)
# plinius-freigabe: holds back updates of coupled packages; depended on by the device package so
# it does not disappear together with a removable app (docs/PAKETIERUNG.md)
# plinius-backlight-wake: the panel driver leaves the backlight dark after the display was off
# plinius-usb: the USB gadget (network for SSH, file sharing), up to 0.5-38 an NCM-only gadget here
# ccid: driver of USB smart card readers and of the smart card part of security keys (YubiKey
#   OpenPGP/PIV); pcscd (pcsclite) starts through its socket, linked below
# plinius-epo: orbit predictions for MediaTek's GNSS daemon, a GPS fix in seconds (on by default,
#   Settings > Privacy > Location > Faster GPS Fix); here, so updated phones get it too
# plinius-greeter: greetd shows it instead of agreety after a session ends (Log Out), so the phone
#   logs in again instead of a black screen; image/mkimage.sh installs it, here for updated phones
# plinius-datawatch: reconnects mobile data that is up but carries nothing (after a cell change),
#   instead of the user switching it off and on; image/mkimage.sh installs it, here for updated phones
# plinius-speech: the speech service (caller announcement in a Bluetooth headset, Settings > Sound >
#   Speech Output); image/mkimage.sh installs it, here for updated phones. The voices stay a download
# plinius-kmsg: the kernel log into the journal without the vendor drivers' status lines
#   (50-plinius-journald.conf: ReadKMsg=no)
# libhybris >= 5: TLS padding preloaded below. hybris-gbm: GBM backend for wlroots on the GPU (linked below under the DRM driver's name)
depends=(systemd openssh python networkmanager modemmanager 'libhybris>=0.1.0.20260624-5' plinius-freigabe 'plinius-bootcheck>=0.2' lxc-android-halium 'plinius-backlight-wake>=0.3' hybris-gbm plinius-usb bluez-utils ccid plinius-epo plinius-greeter plinius-datawatch plinius-speech plinius-kmsg)
# The hook that hides pulled-in launchers came from plinius-apps up to 0.11-5
conflicts=('plinius-apps<0.11-6')
# Adds the lines to /etc/bash.bashrc that source the prompt and the aliases
install=device-volla-ansuz.install
backup=(etc/ssh/sshd_config.d/50-plinius.conf etc/security/pwquality.conf.d/50-plinius-pin.conf etc/gbinder.d/50-plinius.conf etc/profile.d/plinius-hybris.sh etc/phosh/phoc.ini etc/ld.so.preload etc/ofono/binder.conf etc/ofono/main.conf)
