# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-charge
pkgver=0.1
pkgrel=3
pkgdesc="Battery charging options for the Volla Phone Plinius: stop at 80 % and fast charging"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
license=(MIT)
depends=(glib2)
source=(plinius-charge.c
	plinius-charge.service
	org.plinius.Charge.conf
	LICENSE)
sha256sums=('e07f6da8fbc978265a2ea951f053f254812e94a29ef95133fc3cf865fc51fc6d'
	'ae1d0c3835c744cce007bc4d740a742422cee2ce20ac8b5a1469516978466991'
	'a690095c292506baae98b228c37c8d4cc0d68414ed37b2961c4e092a443547cf'
	'1f18c6c362e3c14577e914c06d551c588720f91959e6aa99a121b86863ffd076')

build() {
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o plinius-charge plinius-charge.c \
		$(pkg-config --cflags --libs gio-unix-2.0) $LDFLAGS
}

package() {
	install -Dm755 plinius-charge -t "$pkgdir/usr/bin"
	install -Dm644 plinius-charge.service -t "$pkgdir/usr/lib/systemd/system"
	# Enabled by the package: the limit must keep working after every boot
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-charge.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	install -Dm644 org.plinius.Charge.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
