msgstr "Geen app-catalogus"

#: plinius-software:1070
msgid ""
"The catalog could not be loaded. Is the package archlinux-appstream-data "
"missing?"
msgstr ""
"De catalogus kon niet worden geladen. Ontbreekt het pakket archlinux-"
"appstream-data?"

#: plinius-software:1125
#, python-brace-format
msgid "{n} app"
msgid_plural "{n} apps"
msgstr[0] "{n} app"
