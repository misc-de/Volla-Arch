# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-software
pkgver=0.12
pkgrel=27
pkgdesc="Install phone-ready apps and update the whole system, without partial upgrades"
arch=(any)
# The app icon is GNOME Software's (GPL-2.0-or-later), renamed so it does not clash with an
# installed gnome-software
license=(MIT GPL-2.0-or-later)
_gs=51.1
# Catalog: Arch's AppStream data (archlinux-appstream-data), filtered to the packages in the
# installed sync database; its icons are JPEG XL (glycin). Screenshots via libsoup3.
# Update check: checkupdates (pacman-contrib, needs fakeroot). No PackageKit,
# see docs/PAKETIERUNG.md. UI strings are English, translated in *.po (template
# plinius-software.pot; gettext).
# Since 0.12-8 Settings (gnome-control-center-plinius 51.1-43) has the same pages: Apps with
# Explore, Installed and Settings, Updates on System and Security. The app is no longer in the
# app grid (NoDisplay); Settings uses its root helper and "plinius-software --updates-json", the
# update notification opens Settings.
# Since 0.12-9 an update ends with the restart it needs: plinius-restart finds the running
# programs that still use replaced files and sorts them by their control group (nothing, apps,
# the user interface in place, or a reboot); Settings and the app offer that restart.
# Since 0.12-15 plinius-pkg switches [plinius] between the channels stable and beta
# (channel-beta, channel-stable); Settings → Apps → Settings has the switch.
# Since 0.12-16 FuriHub (https://furihub.github.io/repo/, Flatpak apps of the FuriLabs user
# community) can be turned on next to Flathub (furihub-enable, furihub-disable). It has no
# runtimes, so Flathub comes with it and stays on while FuriHub is; flatpak-install takes an app
# from FuriHub if it has it. --updates-json names the remote of each Flatpak update.
# Since 0.12-20 plinius.xml adds the apps of [plinius] to the catalog (Arch's data does not know
# them), first plinius-games and plinius-dos-installer; an entry only shows while the repository
# has its package.
# 0.12-21: the catalog names RetroArch by its name and lists the DOS Installer.
# 0.12-22: RetroArch and the DOS Installer are one entry, plinius-retro-games, which pulls in
# both and is rated for phones (apps.conf); it is offered under "Recommended", not preinstalled.
# Also since 0.12-16 updates waiting for approval (plinius-freigabe) are no longer shown: the
# list then has no system packages, and upgrade puts the sync databases back and only updates
# the Flatpak apps instead of failing with exit 8.
# Since 0.12-17 an upgrade that pacman refuses only because of files no package owns, each
# brought by a package of [plinius], is repeated with --overwrite for exactly those files (copy
# in /var/lib/plinius-pkg/overwritten); otherwise such leftovers would block every update.
# 0.12-23: the stamp names the database
# (db_sha256, sig_sha256, tools/lib.sh write_stamp). plinius-repo-stamp compares it with the
# database pacman fetched, in the update check and in plinius-pkg upgrade between -Sy and -Su
# (exit 12 if it does not match; the sync databases are put back). The stamps seen are kept
# system-wide in /var/lib/plinius-pkg (by root). A stamp that cannot be had (no answer, HTTP
# error, none on the server) is a warning and the upgrade goes on; a wrong or badly signed one
# also stops plinius-pkg upgrade (exit 12), plinius-revoked counts. Updates held back by plinius-freigabe are reported again:
# "held" in --updates-json and a notification, at the start and after 7 days.
# 0.12-24: a database plinius-repo-stamp cannot read here is "unreadable" (exit 1), no longer
# a "mismatch" with the server.
# 0.12-25: when fetching once more after a stamp that did not match yet fails, plinius-pkg
# upgrade says so and ends as a failed sync (exit 1, or 4 for a 404), not as exit 12. Closing
# the window while an operation runs keeps it open with a toast again (the close handler's
# arguments hid gettext's _).
depends=(python python-gobject gtk4 libadwaita appstream archlinux-appstream-data libsoup3 glycin
	pacman pacman-contrib fakeroot polkit systemd util-linux plinius-freigabe gnupg)
makedepends=(gettext)
_langs=(de fr es it pt nl pl ru)
source=(plinius-software
	plinius-pkg
	plinius-restart
	plinius-repo-stamp
	apps.conf
	plinius.xml
	org.plinius.Software.desktop
	org.plinius.Software.service
	org.plinius.software.policy
	plinius-software-check.service
	plinius-software-check.timer
	90-plinius-software-check
	"org.plinius.Software.svg::https://gitlab.gnome.org/GNOME/gnome-software/-/raw/$_gs/data/icons/hicolor/scalable/org.gnome.Software.svg"
	"org.plinius.Software-symbolic.svg::https://gitlab.gnome.org/GNOME/gnome-software/-/raw/$_gs/data/icons/hicolor/symbolic/org.gnome.Software-symbolic.svg"
	de.po fr.po es.po it.po pt.po nl.po pl.po ru.po
	LICENSE)
