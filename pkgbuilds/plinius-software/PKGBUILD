# Compile the translations; --check catches broken format strings in *.po
build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	# Due at the first connection, not only by the daily timer
	install -Dm755 90-plinius-software-check -t "$pkgdir/usr/lib/NetworkManager/dispatcher.d"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 plinius-software -t "$pkgdir/usr/bin"
	install -Dm755 plinius-pkg plinius-restart plinius-repo-stamp -t "$pkgdir/usr/lib/plinius-software"
	install -Dm644 apps.conf -t "$pkgdir/usr/share/plinius-software"
	install -Dm644 plinius.xml -t "$pkgdir/usr/share/swcatalog/xml"
	install -Dm644 org.plinius.Software.desktop -t "$pkgdir/usr/share/applications"
	install -Dm644 org.plinius.Software.service -t "$pkgdir/usr/share/dbus-1/services"
	install -Dm644 org.plinius.Software.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
	install -Dm644 org.plinius.Software-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"
	install -Dm644 org.plinius.software.policy -t "$pkgdir/usr/share/polkit-1/actions"
	install -Dm644 plinius-software-check.service plinius-software-check.timer \
		-t "$pkgdir/usr/lib/systemd/user"
	install -d "$pkgdir/usr/lib/systemd/user/timers.target.wants"
	ln -s ../plinius-software-check.timer "$pkgdir/usr/lib/systemd/user/timers.target.wants/"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-software.mo"
	done
}
