msgstr "Последний успешный поиск: {when}"

#: plinius-software:1216
#, python-brace-format
msgid "{n} update available"
msgid_plural "{n} updates available"
msgstr[0] "Доступно {n} обновление"
msgstr[1] "Доступно {n} обновления"
msgstr[2] "Доступно {n} обновлений"

#: plinius-software:1219
msgid "The whole system is always updated at once."
msgstr "Система всегда обновляется целиком."

