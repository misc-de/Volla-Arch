def load_shown():
    """Ratings that "Explore" shows, from the settings file (EXTRA keys)."""
    shown = {PHONE, SCALED}
    keyfile = GLib.KeyFile()
    try:
        keyfile.load_from_file(SETTINGS, GLib.KeyFileFlags.NONE)
    except GLib.Error:
        return shown
    for key, (rating, _label) in EXTRA.items():
        try:
            if keyfile.get_boolean("Anzeige", key):
                shown.add(rating)
        except GLib.Error:
            pass
    return shown


def save_shown(shown):
    """Store the EXTRA choices of the menu in the settings file."""
    keyfile = GLib.KeyFile()
    for key, (rating, _label) in EXTRA.items():
        keyfile.set_boolean("Anzeige", key, rating in shown)
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    keyfile.save_to_file(SETTINGS)


