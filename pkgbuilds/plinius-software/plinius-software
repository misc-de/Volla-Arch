def load_ratings():
    """apps.conf as {AppStream ID: (rating, translated note or "")}; invalid lines are skipped."""
    ratings = {}
    try:
        with open(RATINGS) as f:
            for line in f:
                parts = line.split(None, 2)
                if len(parts) < 2 or parts[0].startswith("#") or parts[1] not in LABELS:
                    continue
                note = parts[2].strip() if len(parts) > 2 else ""
                ratings[parts[0]] = (parts[1], _(note) if note else "")
    except OSError:
        pass
    return ratings


def classify(cpt):
    """Rating from the app's own AppStream data: the smallest required/recommended/supported
    display_length on the shorter side decides; otherwise Purism's form_factor hint."""
    widths = []
    for rel in cpt.get_requires() + cpt.get_recommends() + cpt.get_supports():
        if rel.get_item_kind() != AppStream.RelationItemKind.DISPLAY_LENGTH:
            continue
        if rel.get_display_side_kind() == AppStream.DisplaySideKind.LONGEST:
            continue
        px = rel.get_value_px()
        if px <= 0:
            continue
        if rel.get_compare() == AppStream.RelationCompare.GE:
            widths.append(px)
        elif rel.get_compare() == AppStream.RelationCompare.GT:
            widths.append(px + 1)
    if widths:
        return PHONE if min(widths) <= PHONE_WIDTH else DESKTOP
    if cpt.get_custom_value("Purism::form_factor") == "mobile":
        return PHONE
    return UNKNOWN


def icon_file(cpt, size):
    """Catalog icon whose size comes closest to size."""
    best = None
    for icon in cpt.get_icons():
        if icon.get_kind() == AppStream.IconKind.CACHED and icon.get_filename():
            if best is None or abs(icon.get_width() - size) < abs(best.get_width() - size):
                best = icon
    return best.get_filename() if best else None


def icon_name(cpt):
    """Name of the icon in the icon theme; it usually only exists once the app is installed."""
    for icon in cpt.get_icons():
        if icon.get_kind() == AppStream.IconKind.STOCK:
            return icon.get_name()
    return None


def screenshot_urls(cpt, width=624):
    """One image per screenshot: the smallest thumbnail at least width wide, else the original."""
    urls = []
    for shot in cpt.get_screenshots_all():
        if shot.get_media_kind() != AppStream.ScreenshotMediaKind.IMAGE:
            continue
        images = [i for i in shot.get_images_all() if i.get_url() and i.get_locale() in (None, "", "C")]
        thumbs = [i for i in images
                  if i.get_kind() == AppStream.ImageKind.THUMBNAIL and i.get_width() >= width]
        sources = [i for i in images if i.get_kind() == AppStream.ImageKind.SOURCE]
        if thumbs:
            urls.append(min(thumbs, key=lambda i: i.get_width()).get_url())
        elif sources:
            urls.append(sources[0].get_url())
    return urls


class Loader:
    """Loads images one after another in its own thread; results arrive in the main thread.
    Requests for the same key while it is loading share one load."""

    def __init__(self, keep):
        self.keep = keep  # cache icons, not screenshots (large, rarely needed twice)
        self.cache = {}
        self.waiting = {}
        self.jobs = queue.Queue()
        threading.Thread(target=self.work, daemon=True).start()

    def get(self, key, load, callback):
        """Call callback(texture or None) with load(key), from the cache if possible."""
        if key in self.cache:
            callback(self.cache[key])
        elif key in self.waiting:
            self.waiting[key].append(callback)
        else:
            self.waiting[key] = [callback]
            self.jobs.put((key, load))

    def work(self):
        while True:
            key, load = self.jobs.get()
            try:
                texture = load(key)
            except (GLib.Error, OSError):
                texture = None
            GLib.idle_add(self.done, key, texture)

    def done(self, key, texture):
        if self.keep:
            self.cache[key] = texture
        for callback in self.waiting.pop(key, []):
            callback(texture)


def load_file(path):
    # Arch ships the catalog icons as JPEG XL. Since GTK 4.24, Gtk.IconTheme no longer loads
    # them from a file (empty image), but Gdk.Texture via glycin does.
    return Gdk.Texture.new_from_filename(path)


# One Soup.Session per thread; sessions must not be shared between threads
_session = threading.local()


def load_url(url):
    """Download an image (screenshot) as a texture; None on an invalid URL or HTTP error."""
    # The URLs come from the AppStream data of each app: only https, so nobody on the network
    # can swap the image or see which app is being looked at
    if not url.startswith("https://"):
        return None
    if not hasattr(_session, "soup"):
        _session.soup = Soup.Session(timeout=30, user_agent="plinius-software")
    message = Soup.Message.new("GET", url)
    if message is None:
        return None
    data = _session.soup.send_and_read(message, None)
    if message.get_status() != Soup.Status.OK:
        return None
    return Gdk.Texture.new_from_bytes(data)


ICONS = Loader(keep=True)
SCREENSHOTS = Loader(keep=False)


def set_icon(image, app, size):
    """Show the theme icon or a placeholder at once, then the catalog icon. icon_key guards
    against recycled list rows getting the icon of a previous app."""
    theme = Gtk.IconTheme.get_for_display(image.get_display())
    name = app.icon_name if app.icon_name and theme.has_icon(app.icon_name) else "application-x-executable"
    image.set_from_icon_name(name)
    image.icon_key = path = icon_file(app.cpt, size)
    if path:
        def show(texture):
            if texture and image.icon_key == path:
                image.set_from_paintable(texture)
        ICONS.get(path, load_file, show)


class App(GObject.Object):
    """One catalog entry (pacman package or Flatpak ref) with everything the UI shows."""

    def __init__(self, cpt, source, pkg, version, rating, installed):
        super().__init__()
        self.cpt = cpt
        self.id = cpt.get_id()
        self.name = cpt.get_name() or self.id
        self.summary = cpt.get_summary() or ""
        self.source = source
        self.pkg = pkg  # pacman: package name, Flatpak: ref (app/ID/arch/branch)
        # flatpak knows the app by the ID from the ref; the AppStream ID may differ
        self.flatpak_id = pkg.split("/")[1] if source == FLATPAK else None
        self.version = version
        self.installed = installed
        self.removal = None  # packages to remove, None = cannot be removed (load_catalog)
        self.recommended = False
        self.rating, note = rating or (classify(cpt), "")
        self.note = note or NOTES[self.rating]
        self.search = " ".join([self.name, self.summary, pkg, *cpt.get_keywords()]).casefold()
        self.categories = set(cpt.get_categories())
        self.icon_name = icon_name(cpt)
        launchable = cpt.get_launchable(AppStream.LaunchableKind.DESKTOP_ID)
        entries = launchable.get_entries() if launchable else []
        self.desktop_id = entries[0] if entries else None
        # Installed, but not in the app grid (NoDisplay, OnlyShowIn), e.g. helper programs
        # pulled in as a dependency
        info = desktop_info(self.desktop_id) if installed else None
        self.hidden = bool(info) and not info.should_show()


def lines(*command):
    """stdout of command as a list of lines; empty if it cannot be started."""
    try:
        return subprocess.run(command, capture_output=True, text=True).stdout.splitlines()
    except OSError:
        return []


def pacman_lines(*args):
    return lines("pacman", *args)


def flathub_enabled():
    return "flathub" in lines("flatpak", "remotes", "--system", "--columns=name")


# How the Flatpak remotes are shown; FuriHub (plinius-pkg furihub-enable) only comes with Flathub
REMOTE_TITLES = {"flathub": "Flathub", "furihub": "FuriHub"}


def remote_title(remote):
    return REMOTE_TITLES.get(remote, remote or "Flatpak")


def release_version(cpt):
    """Version of the newest release in the catalog, "" if none (Flatpak apps)."""
    releases = cpt.get_releases_plain()
    return releases.index_safe(0).get_version() if releases and releases.get_size() else ""


def load_catalog():
    """Runs in the background: AppStream catalog and package state from the installed sync
    database; with Flathub on, also its catalog (/var/lib/flatpak/appstream)."""
    flathub = flathub_enabled()
    pool = AppStream.Pool()
    flags = AppStream.PoolFlags.LOAD_OS_CATALOG
    if flathub:
        flags |= AppStream.PoolFlags.LOAD_FLATPAK
    pool.set_flags(flags)
    pool.load(None)
    available = {}
    for line in pacman_lines("-Sl"):
        parts = line.split()
        if len(parts) >= 3:
            available.setdefault(parts[1], parts[2])  # first repo wins, as in pacman
    installed = set(pacman_lines("-Qq"))
    required, provider = package_info()
    recommended = load_recommended()
    flatpaks = set(lines("flatpak", "list", "--system", "--app", "--columns=application")) if flathub else set()
    ratings = load_ratings()
    apps = {}
    box = pool.get_components_by_kind(AppStream.ComponentKind.DESKTOP_APP)
    for i in range(box.get_size()):
        cpt = box.index_safe(i)
        rating = ratings.get(cpt.get_id())
        bundle = cpt.get_bundle(AppStream.BundleKind.FLATPAK)
        if bundle:
            ref = bundle.get_id()
            app = App(cpt, FLATPAK, ref, release_version(cpt), rating, ref.split("/")[1] in flatpaks)
            app.removal = [app.flatpak_id] if app.installed else None
        else:
            pkg = cpt.get_pkgname()
            # The catalog comes from Arch x86_64; only show what actually exists in this state
            if pkg not in available:
                continue
            # A custom build is installed instead of the Arch package (provides): that one counts
            if pkg not in installed and pkg in provider:
                pkg = provider[pkg]
            app = App(cpt, PACMAN, pkg, available.get(pkg, ""), rating, pkg in installed)
            app.recommended = pkg in recommended
            if app.installed:
                app.removal = removal(pkg, required)
        # If an app is in both sources, the installed one wins, otherwise the one from the repositories
        old = apps.get(app.id)
        if old is None or (app.installed, app.source == PACMAN) > (old.installed, old.source == PACMAN):
            apps[app.id] = app
    return sorted(apps.values(), key=lambda a: a.name.casefold())


# A versioned conflict such as "glibc>2.44-1" (name, operator, version)
CONSTRAINT = re.compile(r"^([^<>=]+)(<=|>=|<|>|=)(.+)$")


def vercmp(a, b):
    """pacman version comparison: < 0, 0 or > 0, like strcmp."""
    return int(subprocess.run(["vercmp", a, b], capture_output=True, text=True).stdout or 0)


def approval_limits(db):
    """Version limits from plinius-freigabe (conflicts), taken from the version that will be
    installed after an -Syu: the higher of the installed one and the one in checkupdates'
    database copy."""
    best = None
    for args in (["-Qi"], ["-Si", "--dbpath", db]):
        info = {}
        for line in lines("env", "LC_ALL=C", "pacman", *args, "plinius-freigabe"):
            key, _, value = line.partition(":")
            info.setdefault(key.strip(), value.strip())
        if "Version" in info and (best is None or vercmp(info["Version"], best["Version"]) > 0):
            best = info
    value = best.get("Conflicts With", "None") if best else "None"
    return [] if value == "None" else [m.groups() for m in map(CONSTRAINT.match, value.split()) if m]


def held_by_approval(packages, db):
    """The limits in plinius-freigabe that would make the -Syu fail, as (name, version after the
    update, operator, limit). pacman then refuses the whole update; pacman -Su --print does not
    check such conflicts, so they are computed here. What counts is the version after the
    update: the new one, otherwise the installed one (a new approval can constrain a package
    that is already beyond its limit)."""
    limits = approval_limits(db)
    if not limits:
        return []
    after = {name: version for name, version in
             (line.split()[:2] for line in pacman_lines("-Q", *{n for n, _o, _v in limits}) if " " in line)}
    after.update({name: new for name, _old, new in packages})
    held = []
    for name, op, version in limits:
        if name in after:
            c = vercmp(after[name], version)
            if {"<": c < 0, "<=": c <= 0, ">": c > 0, ">=": c >= 0, "=": c == 0}[op]:
                held.append((name, after[name], op, version))
    return held


def held_since(held):
    """When the current hold by plinius-freigabe was first seen (Unix time, HELD_SINCE), None
    without a hold. The time stays while the hold lasts, whichever packages it names."""
    if not held:
        try:
            os.remove(HELD_SINCE)
        except OSError:
            pass
        return None
    try:
        with open(HELD_SINCE, encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        pass
    now = int(time.time())
    os.makedirs(os.path.dirname(HELD_SINCE), exist_ok=True)
    with open(HELD_SINCE, "w", encoding="utf-8") as f:
        f.write(str(now))
    return now


def checkupdates_db():
    """checkupdates works on its own copy of the databases (CHECKUPDATES_DB); the system's stay
    untouched. App and timer share it."""
    return os.path.join(GLib.get_user_runtime_dir(), "plinius-software", "db")


def find_updates():
    """Runs in the background (app and timer): (checkupdates exit code, packages as
    (name, old, new), Flatpak updates as (name, version, remote), hold).
    checkupdates exits 0 with updates, 2 without; anything else is a failure.
    While a package waits for approval (plinius-freigabe), pacman refuses the whole -Syu, so no
    system update can be installed yet: then packages is empty and hold says why, as a dict
    with "limits" (held_by_approval), "packages" (the system updates that wait) and "since"
    (held_since); otherwise hold is None. Flatpak apps are updated regardless.
    Flathub's answer does not depend on pacman's, so both servers are asked at the same time."""
    flatpaks = []
    flatpak_check = threading.Thread(target=lambda: flatpaks.extend(flatpak_updates()), daemon=True)
    flatpak_check.start()
    db = checkupdates_db()
    os.makedirs(db, exist_ok=True)
    try:
        # App and timer share the copy; running at the same time, checkupdates would fail on its lock
        with open(os.path.join(db, "..", "check.lock"), "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            r = subprocess.run(["checkupdates"], capture_output=True, text=True,
                               env=dict(os.environ, CHECKUPDATES_DB=db))
        code, output = r.returncode, r.stdout
    except OSError:
        code, output = 1, ""
    packages = [(p[0], p[1], p[3]) for p in (line.split() for line in output.splitlines())
                if len(p) >= 4] if code == 0 else []
    hold = None
    if code in (0, 2):
        held = held_by_approval(packages, db)
        since = held_since(held)
        if held:
            hold = {"limits": held, "packages": packages, "since": since}
            packages = []
    flatpak_check.join()
    if code in (0, 2):
        touch_last_check()
    return code, packages, flatpaks, hold


def flatpak_updates():
    """Updates of the system's Flatpak apps as (name, version, remote); none without Flathub."""
    if not flathub_enabled():
        return []
    return [tuple((line.split("\t") + ["", ""])[:3]) for line in
            lines("flatpak", "remote-ls", "--updates", "--system", "--columns=application,version,origin")]


def hold_days(hold):
    """Whole days the hold by plinius-freigabe has lasted (0 without a start, or one ahead)."""
    return max(int((time.time() - hold["since"]) // 86400), 0) if hold.get("since") else 0


def hold_texts(hold):
    """(title, description) of a hold by plinius-freigabe (find_updates), localized. Written for
    the user, who can do nothing about it: no package names (they are in "limits" of
    --updates-json), only that it is being tested and comes by itself; after HELD_ALARM_DAYS
    also that security updates wait with it."""
    title = _("A system update is being tested")
    text = _("New versions from Arch Linux are first tested with the Plinius adaptations and installed "
             "once they work together. You do not need to do anything.")
    if hold_days(hold) >= HELD_ALARM_DAYS:
        text += " " + _("Security updates are waiting too.")
    if hold.get("since"):
        text += "\n" + _("Waiting since {when}").format(when=when_text(hold["since"]))
    return title, text


def hold_json(hold):
    """The hold for --updates-json: as find_updates has it, plus "days", "title" and "text"."""
    if not hold:
        return None
    title, text = hold_texts(hold)
    return {"limits": hold["limits"], "packages": hold["packages"], "since": hold.get("since"),
            "days": hold_days(hold), "title": title, "text": text}


def check_repo_stamp():
    """The verdict of STAMP_CHECK on the stamp of [plinius] and the database checkupdates just
    fetched (a dict, see there), or None if the helper gave none."""
    try:
        r = subprocess.run([STAMP_CHECK, "check", "--db", os.path.join(checkupdates_db(), "sync", "plinius.db"),
                            "--user-state", STAMP_STATE], capture_output=True, text=True, timeout=180)
        verdict = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    return verdict if isinstance(verdict, dict) else None


def stamp_warning(verdict):
    """The warning for the user about a verdict of check_repo_stamp, None if there is none."""
    result = verdict.get("result") if verdict else None
    if result in ("ok", "skip", "none"):
        return None
    if result == "unreachable":
        return _("The update server did not hand out its signed state. Updates may be held back.")
    if result == "unsigned":
        return _("The update server's state is not signed by Plinius. Updates are not trustworthy.")
    if result == "channel":
        return _("The update server offers the updates of another channel ({got} instead of "
                 "{want}).").format(got=verdict.get("got"), want=verdict.get("want"))
    if result == "replay":
        return _("The update server offers an older state than before. Updates may be held back.")
    if result == "unhashed":
        return _("The update server's signed state does not vouch for its package list. "
                 "Updates may be held back.")
    if result == "mismatch":
        return _("The update server's package list does not match its signed state. Updates may "
                 "be held back or come from another channel.")
    if result == "unreadable":
        return _("The package list could not be read to check it against the update server's "
                 "signed state.")
    if result == "stale":
        days = verdict.get("days", 0)
        return ngettext("The update server's state is {n} day old. Updates may be held back.",
                        "The update server's state is {n} days old. Updates may be held back.",
                        days).format(n=days)
    # missing, http, malformed, or the helper failed
    return _("The update server gives no proof of how current its updates are.")


def check_all():
    """One update check with the stamp (app-less callers: --updates-json and the timer):
    (code, packages, flatpaks, hold, repo warning). Only a check that reached the servers says
    anything about the stamp. A database that does not match it may be an upload in progress:
    both are fetched once more before that is a warning."""
    code, packages, flatpaks, hold = find_updates()
    if code not in (0, 2):
        return code, packages, flatpaks, hold, None
    verdict = check_repo_stamp()
    if verdict and verdict.get("result") == "mismatch":
        time.sleep(STAMP_RETRY_DELAY)
        code, packages, flatpaks, hold = find_updates()
        if code not in (0, 2):
            return code, packages, flatpaks, hold, None
        verdict = check_repo_stamp()
    return code, packages, flatpaks, hold, stamp_warning(verdict)


def updates_json():
    """Settings' Updates page (--updates-json): one check, printed as JSON. "last_check" is
    the localized time of the last successful check (last_check_text), or null; "repo_warning"
    a warning about the update server (check_all), or null; "held" null, or the updates that
    plinius-freigabe holds back (hold_json: "packages" as [name, old, new] like "packages",
    "limits" as [name, version, operator, limit], "since" Unix time, "days", and the localized
    "title" and "text" to show instead of "up to date")."""
    code, packages, flatpaks, hold, warning = check_all()
    print(json.dumps({"code": code, "packages": packages,
                      "flatpaks": flatpaks, "last_check": last_check_text(),
                      "repo_warning": warning, "held": hold_json(hold)}))
    return 0


def notify_once(name, key, summary, body):
    """Timer: sends a notification unless the last one under name had the same key (it stays
    until the key changes); key None forgets it."""
    state = os.path.join(GLib.get_user_state_dir(), "plinius-software", name)
    if not key:
        if os.path.exists(state):
            os.remove(state)
        return
    try:
        with open(state, encoding="utf-8") as f:
            if f.read() == key:
                return
    except OSError:
        pass
    os.makedirs(os.path.dirname(state), exist_ok=True)
    with open(state, "w", encoding="utf-8") as f:
        f.write(key)
    send_update_notification(summary, body)


def notify_repo_warning(warning):
    """Timer: the warning of check_all, once per text."""
    notify_once("repo-warning", warning, _("Updates could not be verified"), warning)


def notify_hold(hold):
    """Timer: a hold by plinius-freigabe that has lasted HELD_ALARM_DAYS, once; security updates
    wait with it. A hold that has just started is not notified: the user cannot do anything about
    it, and it usually ends before anyone would miss an update."""
    days = hold_days(hold) if hold else 0
    if days < HELD_ALARM_DAYS:
        notify_once("held-notified", None, None, None)
        return
    body = ngettext("System updates have been on hold for {n} day. Security updates wait too.",
                    "System updates have been on hold for {n} days. Security updates wait too.",
                    days).format(n=days)
    notify_once("held-notified", "long", _("System updates are on hold"), body)


def notify_updates():
    """Timer (plinius-software --check-updates): notifies once per new set of updates (packages
    waiting for approval are not among them, see find_updates; notify_hold tells about them),
    and about a warning on the update server."""
    code, packages, flatpaks, hold, warning = check_all()
    state = os.path.join(GLib.get_user_state_dir(), "plinius-software", "notified")
    items = [f"{n} {new}" for n, _old, new in packages] + [f"{n} {v}" for n, v, _r in flatpaks]
    if code not in (0, 2):
        return 0
    notify_repo_warning(warning)
    notify_hold(hold)
    if not items:
        if os.path.exists(state):
            os.remove(state)
        return 0
    text = "\n".join(items)
    try:
        with open(state) as f:
            if f.read() == text:
                return 0
    except OSError:
        pass
    with open(state, "w") as f:
        f.write(text)
    n = len(items)
    send_update_notification(_("System update available"),
                             ngettext("{n} package can be updated.", "{n} packages can be updated.",
                                      n).format(n=n))
    return 0


def open_updates_panel(bus):
    """Opens Settings on its Updates panel through its D-Bus action "launch-panel" (D-Bus
    activation starts Settings if it is not running). Not by running "gnome-control-center
    updates": that child would live in this process' systemd unit, which is stopped, child
    included, as soon as this process exits, so the panel request was lost on the way."""
    try:
        bus.call_sync("org.gnome.Settings", "/org/gnome/Settings", "org.freedesktop.Application",
                      "ActivateAction",
                      GLib.Variant("(sava{sv})", ("launch-panel",
                                                  [GLib.Variant("(sav)", ("updates", []))], {})),
                      None, Gio.DBusCallFlags.NONE, 30000)
    except GLib.Error as e:
        print(f"plinius-software: could not open Settings on Updates: {e.message}", file=sys.stderr)


def send_update_notification(summary, body):
    """Sends the update notification and waits until it is tapped, dismissed or the
    notification server goes away. Phosh does not open apps itself: tapping a notification
    only sends ActionInvoked("default") back to the sender, so this process has to stay and
    open Settings on its Updates page (gnome-control-center starts it, or hands the panel to
    the running instance)."""
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    loop = GLib.MainLoop()
    notification = {}

    def on_signal(_bus, _sender, _path, _iface, signal, params):
        if params[0] != notification.get("id"):
            return
        try:
            if signal == "ActionInvoked" and params[1] == "default":
                open_updates_panel(bus)
        finally:
            loop.quit()

    for signal in ("ActionInvoked", "NotificationClosed"):
        bus.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", signal,
                             "/org/freedesktop/Notifications", None, Gio.DBusSignalFlags.NONE, on_signal)
    # Phosh restarted (session ended): the notification is gone, nobody will tap it
    Gio.bus_watch_name_on_connection(bus, "org.freedesktop.Notifications", Gio.BusNameWatcherFlags.NONE,
                                     None, lambda *_: loop.quit())
    # Shown as coming from Settings. The hint is needed: on a tap Phosh activates that app itself
    # with an xdg-activation token, and only that brings the window to the front (without it
    # Settings switched the panel but stayed small in the overview). Phosh sends its Activate
    # before ActionInvoked, so the panel request from open_updates_panel() arrives after it.
    hints = {"desktop-entry": GLib.Variant("s", "org.gnome.Settings")}
    reply = bus.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                          "org.freedesktop.Notifications", "Notify",
                          GLib.Variant("(susssasa{sv}i)", (_("Software"), 0, "software-update-available-symbolic",
                                                           summary, body,
                                                           ["default", _("Go to Updates")], hints, -1)),
                          GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, -1)
    notification["id"] = reply[0]
    loop.run()


def show_in_phosh(app):
    """Phosh's app overview only shows apps with X-Purism-FormFactor=Mobile in its mobile
    filter. Apps rated phone-ready here are added to force-adaptive, or they would be missing."""
    if app.rating not in (PHONE, SCALED) or not app.desktop_id:
        return
    source = Gio.SettingsSchemaSource.get_default()
    # mobi.phosh.shell since Phosh 0.59, sm.puri.phosh before
    schema = source and (source.lookup("mobi.phosh.shell", True) or source.lookup("sm.puri.phosh", True))
    if not schema:
        return
    info = desktop_info(app.desktop_id)
    if info:
        factors = f"{info.get_string('X-Purism-FormFactor')};{info.get_string('X-KDE-FormFactor')}"
        if "mobile" in factors.casefold():
            return
    settings = Gio.Settings.new_full(schema, None, None)
    ids = settings.get_strv("force-adaptive")
    if app.desktop_id not in ids:
        settings.set_strv("force-adaptive", ids + [app.desktop_id])


def launch(app):
    """Start an installed app via its launcher, for new Flatpak apps via flatpak run."""
    info = desktop_info(app.desktop_id)
    if info:
        info.launch([], None)
    elif app.source == FLATPAK:
        # The running session only finds the launchers of new Flatpak apps after the next login
        Gio.Subprocess.new(["flatpak", "run", app.flatpak_id], Gio.SubprocessFlags.NONE)


def restart_apply(level):
    """Restart the apps, or the user interface and the apps (plinius-restart apply), in a scope
    of its own: it may close this app too."""
    Gio.Subprocess.new(["systemd-run", "--user", "--scope", "--collect", "--quiet", "--",
                        RESTART, "apply", level, RESTART_RESULT], Gio.SubprocessFlags.NONE)


def restart_app_names(result):
    """Names of this user's apps that a restart closes and opens again, comma-separated."""
    names = []
    for app in result.get("apps", []):
        if app.get("uid") != os.getuid() or not app.get("id"):
            continue
        info = desktop_info(app["id"] + ".desktop")
        name = info.get_display_name() if info else app["id"]
        if name not in names:
            names.append(name)
    return ", ".join(names)


def offer_restart(page, title):
    """After an update: offer the restart it needs (none, apps, ui or reboot, see
    plinius-restart). Without an answer: a reboot. Returns True if a button was added."""
    try:
        with open(RESTART_RESULT) as f:
            result = json.load(f)
    except (OSError, ValueError):
        result = {}
    level = result.get("level", "reboot")
    apps = restart_app_names(result)
    if level == "none" or (level == "apps" and not apps):
        page.finish(True, title, _("Everything that is running already uses the new versions."))
        return False
    if level == "apps":
        page.finish(True, title, _("Restart {apps} to use the new versions. Unsaved changes "
                                   "in them are lost.").format(apps=apps))
        page.add_button(_("Restart Apps"), lambda: restart_apply("apps"), "suggested-action")
        return True
    if level == "ui":
        text = _("Restart Phosh to use the new versions. The phone locks; open apps stay open.")
        if apps:
            text += " " + _("{apps} also restart. Unsaved changes in them are lost.").format(apps=apps)
        page.finish(True, title, text)
        page.add_button(_("Restart Phosh"), lambda: restart_apply("ui"), "suggested-action")
        return True
    # Only offer the restart; back is at the top left
    page.finish(True, title, _("Restart the phone to run the new versions."))
    page.add_button(_("Restart Phone"), reboot, "suggested-action")
    return True


def reboot():
    """Reboot via logind (interactive=True: polkit may ask)."""
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM)
    bus.call_sync("org.freedesktop.login1", "/org/freedesktop/login1",
                  "org.freedesktop.login1.Manager", "Reboot", GLib.Variant("(b)", (True,)),
                  None, Gio.DBusCallFlags.NONE, -1)


def plain_row(title, subtitle=None, **props):
