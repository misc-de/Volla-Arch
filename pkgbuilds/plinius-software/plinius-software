class Window(Adw.ApplicationWindow):
    """Main window: Explore, Installed and Updates tabs; operations are pushed as pages."""

    def __init__(self, app):
        super().__init__(application=app, title=_("Software"), default_width=360, default_height=720)
        self.busy = False
        self.shown = load_shown()
        self.store = Gio.ListStore(item_type=App)
        self.connect("close-request", self.on_close)

        self.stack = Adw.ViewStack()
        self.stack.add_titled_with_icon(self.build_explore(), "explore", _("Explore"),
                                        "system-search-symbolic")
        self.stack.add_titled_with_icon(self.build_installed(), "installed", _("Installed"),
                                        "view-list-symbolic")
        self.updates_page = self.stack.add_titled_with_icon(self.build_updates(), "updates", _("Updates"),
                                                            "software-update-available-symbolic")
        header = Adw.HeaderBar()
        search_button = Gtk.ToggleButton(icon_name="system-search-symbolic", tooltip_text=_("Search"))
        search_button.bind_property("active", self.search_bar, "search-mode-enabled",
                                    GObject.BindingFlags.BIDIRECTIONAL)
        search_button.connect("toggled", self.on_search_toggled)
        header.pack_start(search_button)
        header.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=self.build_menu(),
                                       tooltip_text=_("Menu")))
        view = Adw.ToolbarView(content=self.stack)
        view.add_top_bar(header)
        view.add_bottom_bar(Adw.ViewSwitcherBar(stack=self.stack, reveal=True))
        self.main_page = Adw.NavigationPage(title=_("Software"), child=view, tag="main")
        self.nav = Adw.NavigationView()
        self.nav.add(self.main_page)
        self.toasts = Adw.ToastOverlay(child=self.nav)
        self.set_content(self.toasts)

        self.reload()
        self.check_updates()

    def build_menu(self):
        """Menu at the top right: extra ratings under "Explore" and the Flathub switch."""
        section = Gio.Menu()
        for key, (rating, label) in EXTRA.items():
            action = Gio.SimpleAction.new_stateful(key, None, GLib.Variant("b", rating in self.shown))
            action.connect("change-state", self.on_shown_changed, rating)
            self.add_action(action)
            section.append(label, f"win.{key}")
        menu = Gio.Menu()
        menu.append_section(_("Also show under “Explore”"), section)

        self.flathub = Gio.SimpleAction.new_stateful("flathub", None, GLib.Variant("b", flathub_enabled()))
        self.flathub.connect("change-state", self.on_flathub_changed)
        self.add_action(self.flathub)
        sources = Gio.Menu()
        sources.append("Flathub", "win.flathub")
        menu.append_section(_("Software Sources"), sources)
        return menu

    def on_flathub_changed(self, _action, value):
        # The check mark only follows the result of plinius-pkg
        if value.get_boolean():
            dialog = Adw.AlertDialog(
                heading=_("Turn On Flathub?"),
                body=_("Flathub is an app store for Flatpak apps, independent of system updates. "
                       "The apps run in a sandbox and bring their own runtimes, so the first app "
                       "downloads a few hundred MB.\n\nOn the Plinius, Flatpak apps do not yet have "
                       "graphics acceleration via libhybris; they render in software and run slower."))
            dialog.add_response("cancel", _("Cancel"))
            dialog.add_response("enable", _("Turn On"))
            dialog.set_response_appearance("enable", Adw.ResponseAppearance.SUGGESTED)
            dialog.connect("response", lambda _d, r: r == "enable" and self.enable_flathub())
            dialog.present(self)
        else:
            self.disable_flathub()

    def enable_flathub(self):
        def done(code, page):
            self.flathub.set_state(GLib.Variant("b", code == 0))
            if code == 0:
                page.finish(True, _("Flathub is on"),
                            _("Apps from Flathub appear under “Explore” marked “Flathub”. The app "
                              "grid shows their launchers after you log in again."))
            elif not self.common_failure(code, page):
                page.finish(False, _("Could not turn on Flathub"), _("See “Details” for more information"))
        self.run_helper(["flathub-enable"], _("Turning on Flathub"),
                        [DOWNLOAD, CHECK, INSTALL, HOOKS, FLATHUB_CATALOG], done)

    def disable_flathub(self):
        def done(code, page):
            self.flathub.set_state(GLib.Variant("b", code != 0))
            if code == 0:
                page.finish(True, _("Flathub is off"))
            elif code == FLATHUB_IN_USE:
                page.finish(False, _("Apps from Flathub are still installed"),
                            _("Remove them under “Installed” first."))
            elif self.common_failure(code, page):
                pass
            else:
                page.finish(False, _("Could not turn off Flathub"), _("See “Details” for more information"))
        self.run_helper(["flathub-disable"], _("Turning off Flathub"), None, done)

    def on_shown_changed(self, action, value, rating):
        action.set_state(value)
        if value.get_boolean():
            self.shown.add(rating)
        else:
            self.shown.discard(rating)
        save_shown(self.shown)
        self.filter.changed(Gtk.FilterChange.DIFFERENT)
        self.update_explore()

    # Lists

    def app_list(self, model, removable=False):
        """Scrollable list of model; activating a row opens its DetailPage."""
        on_remove = self.confirm_remove if removable else None
        factory = Gtk.SignalListItemFactory()
        factory.connect("setup", lambda _f, item: item.set_child(AppRow(on_remove)))
        factory.connect("bind", lambda _f, item: item.get_child().bind(item.get_item()))
        view = Gtk.ListView(model=Gtk.NoSelection(model=model), factory=factory,
                            single_click_activate=True)
        view.add_css_class("navigation-sidebar")
        view.connect("activate", lambda _v, pos: self.nav.push(DetailPage(self, model.get_item(pos))))
        return Gtk.ScrolledWindow(child=view, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)

    def build_explore(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        # The magnifier at the top left opens the search; without a search term "Explore" shows the categories
        self.search = Gtk.SearchEntry(placeholder_text=_("Search apps"), hexpand=True)
        self.search_bar = Gtk.SearchBar(child=Adw.Clamp(child=self.search, maximum_size=600))
        self.search_bar.connect_entry(self.search)
        box.append(self.search_bar)

        self.filter = Gtk.CustomFilter.new(self.explore_visible)
        self.explore_model = Gtk.FilterListModel(model=self.store, filter=self.filter)
        self.explore_stack = Gtk.Stack()
        self.explore_stack.add_named(Adw.Spinner(), "loading")
        self.explore_stack.add_named(self.build_categories(), "categories")
        self.explore_stack.add_named(self.app_list(self.explore_model), "list")
        self.explore_stack.add_named(Adw.StatusPage(icon_name="system-search-symbolic",
                                                    title=_("No Results")), "empty")
        self.explore_stack.add_named(Adw.StatusPage(
            icon_name="dialog-warning-symbolic", title=_("No App Catalog"),
            description=_("The catalog could not be loaded. Is the package "
                          "archlinux-appstream-data missing?")), "nocatalog")
        box.append(self.explore_stack)

        def changed(*_):
            self.filter.changed(Gtk.FilterChange.DIFFERENT)
            self.update_explore()
        self.search.connect("search-changed", changed)
        self.store.connect("items-changed", lambda *_: self.update_explore())
        return box

    def build_categories(self):
        # One category per row: icon, name, number of apps, arrow
        group = Adw.PreferencesGroup()
        self.category_rows = []
        for title, icon, categories in CATEGORIES:
            row = plain_row(title=title, activatable=True)
            row.add_prefix(Gtk.Image(icon_name=icon, pixel_size=24))
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated", lambda _r, t=title, c=categories:
                        self.nav.push(CategoryPage(self, t, c)))
            group.add(row)
            self.category_rows.append((row, categories))
        return scrolled(group)

    def offered(self, app):
        """What "Explore" offers: not installed, rating selected (menu at the top right)."""
        return not app.installed and app.rating in self.shown

    def searching(self):
        return self.search_bar.get_search_mode() and self.search.get_text().strip()

    def explore_visible(self, app):
        words = self.search.get_text().casefold().split()
        return self.offered(app) and all(w in app.search for w in words)

    def on_search_toggled(self, button):
        if button.get_active():
            self.stack.set_visible_child_name("explore")
        else:
            self.search.set_text("")
        self.update_explore()

    def update_explore(self):
        """Switch "Explore" between categories, results and empty state; update the counts."""
        if not self.store.get_n_items():
            return  # still loading, or no catalog (set_apps)
        if self.searching():
            self.explore_stack.set_visible_child_name(
                "list" if self.explore_model.get_n_items() else "empty")
            return
        offered = [a for a in (self.store.get_item(i) for i in range(self.store.get_n_items()))
                   if self.offered(a)]
        for row, categories in self.category_rows:
            n = sum(1 for a in offered if in_category(a, categories))
            row.set_subtitle(ngettext("{n} app", "{n} apps", n).format(n=n))
            # Hide empty groups, e.g. "Recommended" once everything is installed
            row.set_visible(n > 0)
        self.explore_stack.set_visible_child_name("categories")

    def build_installed(self):
        # All installed apps from the catalog, including the bundled ones (plinius-apps), as far
        # as they are in the app grid; a trash button on all that no other package needs
        model = Gtk.FilterListModel(model=self.store, filter=Gtk.CustomFilter.new(
            lambda a: a.installed and (a.removal or not a.hidden)))
        stack = Gtk.Stack()
        stack.add_named(self.app_list(model, removable=True), "list")
        stack.add_named(Adw.StatusPage(
            icon_name="view-list-symbolic", title=_("No Apps Installed"),
            description=_("Apps you install from “Explore” appear here.")), "empty")
        model.connect("items-changed", lambda m, *_: stack.set_visible_child_name(
            "list" if m.get_n_items() else "empty"))
        stack.set_visible_child_name("empty")
        return stack

    def reload(self):
        """Reload the catalog in the background, e.g. after an operation."""
        def work():
            try:
                apps = load_catalog()
            except Exception:
                # Otherwise "Explore" would be stuck at the spinner; details go to the journal
                traceback.print_exc()
                apps = []
            GLib.idle_add(self.set_apps, apps)
        threading.Thread(target=work, daemon=True).start()

    def set_apps(self, apps):
        self.store.splice(0, self.store.get_n_items(), apps)
        if not apps:
            self.explore_stack.set_visible_child_name("nocatalog")

    # Updates

    def build_updates(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.update_status = StatusHeader("software-update-available-symbolic", _("Checking for updates…"))
        box.append(self.update_status)
        # "Check Again" first, "Update Now" below it, as in Settings
        self.check_button = pill(_("Check Again"), self.check_updates)
        # One empty line above it, so that it does not read as part of the status
        self.check_button.set_margin_top(24)
        box.append(self.check_button)
        self.upgrade_button = pill(_("Update Now"), self.upgrade, "suggested-action")
        self.upgrade_button.set_visible(False)
        box.append(self.upgrade_button)
        self.update_list = Adw.PreferencesGroup(title=_("Packages"), visible=False)
        box.append(self.update_list)
        self.update_rows = []
        return scrolled(box)

    def check_updates(self):
        """Check for updates in the background; the result goes to on_updates."""
        self.check_button.set_sensitive(False)
        self.update_status.set_title(_("Checking for updates…"))
        self.update_status.set_description(None)

        def work():
            GLib.idle_add(self.on_updates, *find_updates())
        threading.Thread(target=work, daemon=True).start()

    def on_updates(self, code, packages, flatpaks, hold):
        """Show the result of find_updates on the Updates tab. "Update Now" stays available
        when the check failed: the upgrade fetches fresh databases itself. Updates held back by
        plinius-freigabe are named as such, not as "up to date"."""
        self.check_button.set_sensitive(True)
        for row in self.update_rows:
            self.update_list.remove(row)
        self.update_rows = []
        last = last_check_text()
        updates = [(name, f"{old} → {new}") for name, old, new in packages]
        updates += [(name, f"{remote_title(remote)} {version}".strip()) for name, version, remote in flatpaks]
        if code not in (0, 2) and not updates:
            self.update_status.set_title(_("Check failed"))
            self.update_status.set_description(
                _("No connection to the server? You can still update.")
                + ("\n" + _("Last successful check: {when}").format(when=last) if last else ""))
        elif hold:
            title, text = hold_texts(hold)
            self.update_status.set_title(title)
            self.update_status.set_description(text)
        elif updates:
            self.update_status.set_title(ngettext("{n} update available", "{n} updates available",
                                                  len(updates)).format(n=len(updates)))
            self.update_status.set_description(
                _("The whole system is always updated at once.")
                + ("\n" + _("Checked: {when}").format(when=last) if last and code in (0, 2) else ""))
        else:
            self.update_status.set_title(_("The system is up to date"))
            self.update_status.set_description(_("Last checked: {when}").format(when=last) if last else None)
        for title, subtitle in updates:
            row = plain_row(title=title, subtitle=subtitle)
            self.update_list.add(row)
            self.update_rows.append(row)
        self.update_list.set_visible(bool(updates))
        self.upgrade_button.set_visible(bool(updates) or code not in (0, 2))
        self.updates_page.set_badge_number(len(updates))
        self.updates_page.set_needs_attention(bool(updates))

    # Package operations

    def run_helper(self, args, title, steps, done):
        """Run plinius-pkg via pkexec, with progress on an OperationPage. done(code, page) sets
        the result; if it returns True, the "Done" button is left out."""
        self.busy = True
        page = OperationPage(title, steps)
        self.nav.push(page)

        def on_line(stream, result):
            try:
                line, _length = stream.read_line_finish_utf8(result)
            except GLib.Error:
                line = "�"  # not valid UTF-8, but the line has been consumed anyway
            if line is None:
                proc.wait_async(None, on_exit)
                return
            page.add_line(line)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        def on_exit(proc, result):
            proc.wait_finish(result)
            self.busy = False
            code = proc.get_exit_status()
            if code in PKEXEC_CANCELLED:
                page.set_can_pop(True)
                self.nav.pop()
                return
            # Back leads to the overview; detail pages would show an outdated state after the operation
            self.nav.replace([self.main_page, page])
            if not done(code, page):
                page.add_button(_("Done"), lambda: self.nav.pop_to_tag("main"))
            self.reload()

        try:
            proc = Gio.Subprocess.new(["pkexec", HELPER, *args],
                                      Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as e:
            self.busy = False
            page.finish(False, _("Could not start"), e.message)
            page.add_button(_("Done"), lambda: self.nav.pop_to_tag("main"))
            return
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    def stale(self, page):
        """The installed database state is outdated (STALE_DB, STALE_FILE): send to Updates."""
        page.finish(False, _("Update the system first"),
                    _("The app belongs to a newer state than the installed system."))
        page.add_button(_("Go to Updates"), self.show_updates, "suggested-action")

    def common_failure(self, code, page):
        """Failures any operation can have; True if code is one of them."""
        if code == BUSY:
            page.finish(False, _("Another operation is running"),
                        _("Wait until it has finished and try again."))
        elif code in (STALE_DB, STALE_FILE):
            self.stale(page)
        else:
            return False
        return True

    def show_updates(self):
        self.nav.pop_to_tag("main")
        self.stack.set_visible_child_name("updates")

    def install(self, app):
        def done(code, page):
            if code == 0:
                show_in_phosh(app)
                page.finish(True, _("{name} is installed").format(name=app.name))
                if app.desktop_id or app.source == FLATPAK:
                    page.add_button(_("Open"), lambda: launch(app), "suggested-action")
            elif code == HELD:
                page.finish(False, _("Waiting for approval"),
                            _("{name} needs packages that are still being tested with the Plinius "
                              "adaptations. It can be installed once they are approved.").format(name=app.name))
            elif not self.common_failure(code, page):
                page.finish(False, _("Installation failed"), _("See “Details” for more information"))
        args = ["flatpak-install", app.pkg] if app.source == FLATPAK else ["install", app.pkg]
        steps = None if app.source == FLATPAK else [DOWNLOAD, CHECK, INSTALL, HOOKS]
        self.run_helper(args, _("Installing {name}").format(name=app.name), steps, done)

    def confirm_remove(self, app):
        """Ask before removing app."""
        dialog = Adw.AlertDialog(heading=_("Remove {name}?").format(name=app.name),
                                 body=_("The app and dependencies that are no longer needed will be "
                                        "removed. Your files and settings are kept."))
        dialog.add_response("cancel", _("Cancel"))
        dialog.add_response("remove", _("Remove"))
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", lambda _d, r: r == "remove" and self.remove(app))
        dialog.present(self)

    def remove(self, app):
        def done(code, page):
            if code == 0:
                page.finish(True, _("{name} has been removed").format(name=app.name))
            elif not self.common_failure(code, page):
                page.finish(False, _("Removal failed"), _("See “Details” for more information"))
        args = ["flatpak-remove" if app.source == FLATPAK else "remove", *app.removal]
        steps = None if app.source == FLATPAK else [REMOVE, HOOKS]
        self.run_helper(args, _("Removing {name}").format(name=app.name), steps, done)

    def upgrade(self):
        """Update the whole system (pacman -Syu, then Flatpak apps if Flathub is on)."""
        def done(code, page):
            self.check_updates()
            if code == 0:
                return offer_restart(page, _("The system has been updated"))
            if code == NOTHING_TO_DO:
                page.finish(True, _("The system is already up to date"))
            elif code == ONLY_FLATPAK:
                return offer_restart(page, _("The Flatpak apps have been updated"))
            elif code == LOW_BATTERY:
                page.finish(False, _("Battery too low"),
                            _("Connect the charger or charge the phone to at least 10 %, then update. "
                              "An update interrupted by an empty battery can leave the system unable to start."))
            elif code == REPO_UNVERIFIED:
                page.finish(False, _("Updates could not be verified"),
                            _("The update server's package list does not match its signed state. "
                              "Nothing was changed. Try again later."))
            elif not self.common_failure(code, page):
                page.finish(False, _("Update failed"), _("See “Details” for more information"))
        steps = [SYNC, DOWNLOAD, CHECK, INSTALL, HOOKS]
        if self.flathub.get_state().get_boolean():
            steps.append(FLATPAK_UPDATE)
        self.run_helper(["upgrade"], _("Updating the system"), steps, done)

    def on_close(self, *_args):
        """Keep the window open while an operation runs."""
        if self.busy:
            self.toasts.add_toast(Adw.Toast(title=_("Please wait until the operation has finished")))
            return True
        return False


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        # Opened from the update notification (send_update_notification)
        action = Gio.SimpleAction.new("show-updates", None)
        action.connect("activate", self.on_show_updates)
        self.add_action(action)

    def do_activate(self):
        (self.get_active_window() or Window(self)).present()

    def on_show_updates(self, *_):
        window = self.get_active_window() or Window(self)
        window.show_updates()
        window.present()


if __name__ == "__main__":
    if sys.argv[1:] == ["--check-updates"]:
        sys.exit(notify_updates())
    if sys.argv[1:] == ["--updates-json"]:
        sys.exit(updates_json())
    sys.exit(Application().run(sys.argv))
