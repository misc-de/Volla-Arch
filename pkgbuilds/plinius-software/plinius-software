    def screenshots(self, urls):
        """Screenshots from the network, as linked in AppStream (the respective app's server)."""
        carousel = Adw.Carousel(spacing=12, allow_scroll_wheel=False)
        for url in urls:
            stack = Gtk.Stack(height_request=320, hexpand=True)
            stack.add_named(Adw.Spinner(), "loading")
            picture = Gtk.Picture(content_fit=Gtk.ContentFit.CONTAIN, can_shrink=True)
            stack.add_named(picture, "picture")
            failed = Gtk.Label(label=_("Image not available"))
            failed.add_css_class("dim-label")
            stack.add_named(failed, "failed")
            carousel.append(stack)

            def show(texture, stack=stack, picture=picture):
                if texture:
                    picture.set_paintable(texture)
                stack.set_visible_child_name("picture" if texture else "failed")
            SCREENSHOTS.get(url, load_url, show)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(carousel)
        if len(urls) > 1:
            box.append(Adw.CarouselIndicatorDots(carousel=carousel))
