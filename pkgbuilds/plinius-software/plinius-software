        for w in (self.icon, self.status, self.step, self.bar, self.detail, self.buttons, self.details):
            box.append(w)
        view = Adw.ToolbarView(content=scrolled(box))
        view.add_top_bar(Adw.HeaderBar())
        self.set_child(view)

    def add_line(self, text):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), text + "\n")
        if not self.progress:
            self.bar.pulse()
            return
        self.progress.feed(text)
        p = self.progress
        if p.index < 0:
            return
        self.step.set_text(_("Step {current} of {total}: {title}").format(
            current=p.index + 1, total=len(p.steps), title=p.steps[p.index][1]))
        n, total = p.count()
        self.detail.set_text(_("{done} of {total}").format(done=n, total=total) if total else "")
        self.bar.set_fraction(p.fraction())

    def finish(self, ok, title, text=""):
        """Show the result; the log stays reachable under "Details" on failure."""
        self.set_can_pop(True)
        self.icon.set_from_icon_name("object-select-symbolic" if ok else "dialog-warning-symbolic")
        self.icon.remove_css_class("dim-label")
        self.icon.add_css_class("success" if ok else "error")
        self.status.set_text(title)
        self.step.set_text(text)
        self.step.set_visible(bool(text))
        self.bar.set_visible(False)
        self.detail.set_visible(False)
        self.details.set_visible(not ok)

    def add_button(self, label, callback, style=None):
        self.buttons.append(pill(label, callback, style))


class DetailPage(Adw.NavigationPage):
