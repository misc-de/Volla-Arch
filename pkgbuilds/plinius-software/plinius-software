        if app.source == FLATPAK:
            extra += " · Flathub"
        self.badge.set_text(LABELS[app.rating] + extra)


# Steps of an operation: (key, title, weight in the overall progress)
SYNC = ("sync", _("Fetching package lists"), 1)
DOWNLOAD = ("download", _("Downloading packages"), 4)
CHECK = ("check", _("Checking packages"), 1)
INSTALL = ("install", _("Installing packages"), 4)
REMOVE = ("install", _("Removing packages"), 2)
HOOKS = ("hooks", _("Finishing up"), 1)
FLATPAK_UPDATE = ("flatpak", _("Updating Flatpak apps"), 3)
FLATHUB_CATALOG = ("flathub", _("Loading the Flathub catalog"), 3)

# pacman output with LC_ALL=C and --noprogressbar (plinius-pkg): sections and counters
MARKERS = [
    (re.compile(r"^:: Synchronizing package databases"), "sync"),
    (re.compile(r"^:: Retrieving packages"), "download"),
    (re.compile(r"^(checking keyring|checking package integrity|loading package files|"
                r"checking for file conflicts|checking available disk space)"), "check"),
    (re.compile(r"^:: Processing package changes"), "install"),
    (re.compile(r"^:: Running post-transaction hooks"), "hooks"),
    (re.compile(r"^::plinius:: (\w+)"), None),  # plinius-pkg's own sections
]
TOTAL = re.compile(r"^Packages \((\d+)\)")
DOWNLOADED = re.compile(r"^ \S+ downloading\.\.\.$")
CHANGED = re.compile(r"^(installing|upgrading|reinstalling|downgrading|removing) \S+\.\.\.$")
NUMBERED = re.compile(r"^\(\s*(\d+)/(\d+)\)")


class Progress:
    """Progress from the output of plinius-pkg: current step and how far along it is."""

    def __init__(self, steps):
        self.steps = steps
        self.index = -1
        self.done = 0  # done in the current step
        self.total = 0  # packages according to "Packages (N)"
        self.hooks = 0  # hooks according to "(i/N)"

    def feed(self, line):
        """Process one output line: a section marker switches steps, other lines count."""
        for pattern, key in MARKERS:
            m = pattern.match(line)
            if m:
                self.enter(key or m.group(1))
                return
        m = TOTAL.match(line)
        if m:
            self.total = int(m.group(1))
        elif self.key() == "download" and DOWNLOADED.match(line):
            self.done += 1
        elif self.key() == "install" and CHANGED.match(line):
            self.done += 1
        elif self.key() == "hooks":
            m = NUMBERED.match(line)
            if m:
                self.done, self.hooks = int(m.group(1)), int(m.group(2))

    def enter(self, key):
        # Skipped steps (e.g. nothing to download) count as done; never go backwards
        for i, step in enumerate(self.steps):
            if step[0] == key and i > self.index:
                self.index, self.done = i, 0
                return

    def key(self):
        return self.steps[self.index][0] if self.index >= 0 else None

    def count(self):
        """(done, total) in the current step, total 0 = unknown."""
        key = self.key()
        if key in ("download", "install"):
            return self.done, self.total
        if key == "hooks":
            return self.done, self.hooks
        return self.done, 0

    def fraction(self):
        """Overall progress 0..1: finished steps by weight plus the share of the current one."""
        weights = [w for _k, _t, w in self.steps]
        done = sum(weights[:max(self.index, 0)])
        n, total = self.count()
        if self.index >= 0 and total:
            done += weights[self.index] * min(n / total, 1)
        return done / sum(weights)


