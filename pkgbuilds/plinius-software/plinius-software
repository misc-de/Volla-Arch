def in_category(app, categories):
    """Whether app belongs to a CATEGORIES group (None, "recommended" or a set of categories)."""
    if categories is None:
        return True
    if categories == "recommended":
        return app.recommended
    return bool(app.categories & categories)


def last_check_text():
    """Text like "today at 14:05", "yesterday at ..." or "on 10/27/26 at ..." (localized) for
    the last check, None if there was none."""
    try:
        return when_text(int(os.path.getmtime(LAST_CHECK)))
    except OSError:
        return None


def when_text(timestamp):
    """Unix time as "today at 14:05", "yesterday at ..." or "on 10/27/26 at ..." (localized)."""
    when = GLib.DateTime.new_from_unix_local(timestamp)
    days = GLib.DateTime.new_now_local().get_day_of_year() - when.get_day_of_year()
    same_year = GLib.DateTime.new_now_local().get_year() == when.get_year()
    time = when.format("%H:%M")
    if same_year and days == 0:
        return _("today at {time}").format(time=time)
    if same_year and days == 1:
        return _("yesterday at {time}").format(time=time)
    return _("on {date} at {time}").format(date=when.format("%x"), time=time)


def touch_last_check():
    """Record now as the time of the last successful check (mtime of LAST_CHECK)."""
    os.makedirs(os.path.dirname(LAST_CHECK), exist_ok=True)
    with open(LAST_CHECK, "a"):
        os.utime(LAST_CHECK)


def package_info():
    """From pacman -Qi: package -> packages that need it ("Required By"), and provided
    name -> installed package ("Provides", e.g. gnome-control-center -> gnome-control-center-plinius)."""
    required, provider, name, field = {}, {}, None, None
    for line in lines("env", "LC_ALL=C", "pacman", "-Qi"):
        if line.startswith(" "):
            # Continuation line of a long field
            values = line.split()
        else:
            key, _, value = line.partition(":")
            field = key.strip()
            if field == "Name":
                name = value.strip()
                continue
            values = [] if value.strip() == "None" else value.split()
        if field == "Required By":
            required.setdefault(name, []).extend(values)
        elif field == "Provides":
            for v in values:
                provider.setdefault(v.split("=")[0], name)
    return required, provider


def removal(pkg, required):
    """Packages removed together with pkg, or None if another package needs it (e.g.
    plinius-apps). Add-ons such as firefox-i18n-de (pkg-..., not needed otherwise) go along."""
    extra = []
    for other in required.get(pkg, []):
        if not other.startswith(pkg + "-") or required.get(other):
            return None
        extra.append(other)
    return [pkg, *extra]


