     def schedule_retry(self, transaction_id, content_location, sender, info, uuid, attempt=0):
         if attempt >= len(FETCH_RETRY_DELAYS):
             mmsd_print(f"Giving up on downloading message {uuid} after {attempt} retries", self.verbose)
+            self.pending.discard(content_location)
             self.settle_incoming(uuid, 'download_failed')
             return
 
