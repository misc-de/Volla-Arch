From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Wed, 18 Nov 2026 14:43:15 +0100
Subject: [PATCH] ofono_push_notification: confirm a fetched message, fetch
 each one once

- After a message is fetched, m-notifyresp.ind with X-Mms-Status
  Retrieved goes to the MMSC (OMA-MMS-ENC 1.2, 6.2). Without it the
  MMSC takes the message as undelivered, sends the notification again
  and never reports delivery to the sender.
- A notification for a Content-Location that is being fetched, waits
  for a retry or is already stored (location= in the .status file) is
  ignored; each repeat used to store the message once more.
- An m-retrieve-conf with an X-Mms-Retrieve-Status error is neither
  stored nor confirmed; a transient error is tried again, a permanent
  one is not.
- A notification is an SMS anyone can send. Its Content-Location is only
  fetched over http or https and not from an address of this device or
  its link (loopback, link-local, multicast, unspecified), and a message
  is read up to 5 MiB. MMSD_ALLOW_LOOPBACK_MMSC=1 lets a test run its
  MMSC on 127.0.0.1.
- Only m-notification-ind is fetched; an error while fetching (oFono
  restarting, say) leads to a retry instead of an unhandled exception.

- A notification that is skipped (a repeat, too large, not an
  m-notification-ind) is not announced as downloading; one that is
  refused later is marked download_failed instead of staying in
  downloading.
---
 mmsd/ofono_push_notification.py | 198 +++++++++++++++++++++++++++++---
 1 file changed, 183 insertions(+), 15 deletions(-)

diff --git a/mmsd/ofono_push_notification.py b/mmsd/ofono_push_notification.py
index 8d9f31a..16a1f9e 100644
--- a/mmsd/ofono_push_notification.py
+++ b/mmsd/ofono_push_notification.py
@@ -6,10 +6,11 @@ from aiohttp import ClientSession, ClientTimeout
 from array import array
 from uuid import uuid4
 from re import sub, compile
-from os import listdir
+from os import environ, listdir
 from typing import Optional
 from urllib.parse import urlparse
 import asyncio
+import ipaddress
 
 from dbus_fast.service import ServiceInterface, method
 from dbus_fast import Variant
@@ -32,6 +33,35 @@ FETCH_TIMEOUT = 120
 # download_failed. Each try brings the MMS context up, so it must not go on
 # for ever; retrying for ever also left the message invisible.
 FETCH_RETRY_DELAYS = (30, 60, 120, 300, 600, 1800)
+# Carriers cap MMS at about 300 kB to 1 MB; anything far beyond that is not a
+# message and would only be held in memory.
+MAX_MESSAGE_SIZE = 5 * 1024 * 1024
+# A notification is an SMS anyone can send, and its Content-Location is
+# fetched over a route set up for it. Addresses of this device or its link
+# are never an MMSC. tools/mms-standin.py runs its MMSC on 127.0.0.1.
+ALLOW_LOOPBACK = environ.get('MMSD_ALLOW_LOOPBACK_MMSC', '') == '1'
+
+class FetchRefused(Exception):
+    """A message that is not fetched, now or later."""
+
+def unsafe_address(ip):
+    try:
+        address = ipaddress.ip_address(ip.split('%')[0])
+    except ValueError:
+        return True
+    if address.is_loopback:
+        return not ALLOW_LOOPBACK
+    return address.is_unspecified or address.is_link_local or address.is_multicast
+
+def notify_response(transaction_id):
+    """m-notifyresp.ind with X-Mms-Status Retrieved (OMA-MMS-ENC 1.2, 6.2).
+    Without it the MMSC takes the message as not delivered: it sends the
+    notification again and tells the sender nothing."""
+    pdu = bytearray([0x8C, 0x83])                # X-Mms-Message-Type: m-notifyresp-ind
+    pdu += b'\x98' + transaction_id.encode('ascii', 'ignore') + b'\x00'  # X-Mms-Transaction-ID
+    pdu += bytes([0x8D, 0x92])                   # X-Mms-MMS-Version: 1.2
+    pdu += bytes([0x95, 0x81])                   # X-Mms-Status: Retrieved
+    return bytes(pdu)
 
