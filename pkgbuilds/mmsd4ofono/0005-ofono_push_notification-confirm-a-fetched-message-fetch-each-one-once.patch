-    async def fetch_mms_content(self, url: str, proxy: Optional[str]):
+    async def read_limited(self, response):
+        if response.content_length and response.content_length > MAX_MESSAGE_SIZE:
+            raise FetchRefused(f"the MMSC announces {response.content_length} bytes")
+
+        content = bytearray()
+        async for chunk in response.content.iter_chunked(65536):
+            content += chunk
+            if len(content) > MAX_MESSAGE_SIZE:
+                raise FetchRefused(f"more than {MAX_MESSAGE_SIZE} bytes")
+        return bytes(content)
+
+    def retrieved(self, content):
+        """An MMSC can answer 200 with an m-retrieve-conf that carries an error
+        instead of the message. That is neither stored nor confirmed; a
+        transient one is tried again later."""
+        try:
+            status = MMSMessage.from_data(content).headers.get('MMS-Retrieve-Status')
+        except Exception as e:
+            mmsd_print(f"Failed to decode the fetched message: {e}", self.verbose)
+            return False
+
+        if status in (None, 'Ok'):
+            return True
+        if status.startswith('Error-permanent'):
+            raise FetchRefused(f"the MMSC answers {status}")
+        mmsd_print(f"The MMSC answers {status}", self.verbose)
+        return False
+
+    async def mmsc_targets(self, mmsc, candidate_proxies):
+        """Where m-notifyresp.ind goes: (url, proxy) pairs and the addresses
+        that need a route."""
+        if not mmsc:
+            return [], []
+
+        if candidate_proxies != [None]:
+            return [(mmsc, f"http://{proxy}") for proxy in candidate_proxies], []
+
+        mmsc_parts = urlparse(mmsc)
+        mmsc_ips = await resolve_host(mmsc_parts.hostname, self.verbose) if mmsc_parts.hostname else []
+        targets = [
+            (mmsc_parts._replace(
+                netloc=(f"[{ip}]" if ":" in ip else ip)
+                + (f":{mmsc_parts.port}" if mmsc_parts.port else "")
+            ).geturl(), None)
+            for ip in mmsc_ips
+        ]
+        return targets, mmsc_ips
+
+    async def send_notify_response(self, session, mmsc, targets, transaction_id):
+        if not targets or not transaction_id:
+            mmsd_print("No MMSC or transaction ID, not confirming the message", self.verbose)
+            return
+
+        headers = {
+            'Host': urlparse(mmsc).netloc,
+            'Content-Type': 'application/vnd.wap.mms-message',
+        }
+        pdu = notify_response(transaction_id)
+        for url, proxy in targets:
+            try:
+                async with session.post(url, data=pdu, headers=headers, proxy=proxy) as response:
+                    mmsd_print(f"m-notifyresp.ind to {url}: HTTP {response.status}", self.verbose)
+                    if 200 <= response.status < 300:
+                        return
+            except Exception as e:
+                mmsd_print(f"Failed to send m-notifyresp.ind to {url}: {e}", self.verbose)
+
+    async def fetch_mms_content(self, url: str, transaction_id: Optional[str] = None):
+        proxy, mmsc = await self.get_mms_context_info()
         needed_ips = []
         resolved_proxy = None
 
