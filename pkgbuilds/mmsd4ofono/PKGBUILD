pkgname=mmsd4ofono
pkgver=1.3.2.20261116
pkgrel=2
pkgdesc="MMS daemon on top of oFono with the mmsd-tng D-Bus API, so Chatty can send and receive MMS"
arch=(any)
url="https://github.com/FuriLabs/mmsd4ofono"
license=(GPL-2.0-only)
# glib2: gdbus in ExecStartPre of the user unit; ofono-sailfish: PushNotification and the
# MMS context
depends=(glib2 ofono-sailfish python python-aiohttp python-dbus python-dbus-fast python-gobject
	python-pyroute2 python-tenacity)
makedepends=(git)
optdepends=('chatty: sending and reading MMS'
	'gnome-control-center-plinius: the MMS switch of each SIM (Mobile Network)')
install=mmsd4ofono.install
# Both own org.ofono.mms on the session bus
conflicts=(mmsd-tng)
# No release tags: commit pin on the forky branch, pkgver = version in main.py + commit date
_commit=2e6f76d64a110297adfddd3165852bed575fb485
