 MAX_MESSAGE_SIZE = 5 * 1024 * 1024
+# Each notification with a new Content-Location brings up to MAX_MESSAGE_SIZE: no new fetch once
+# the stored messages take this much, and at most this many fetches at once (with their retries)
+MAX_STORE_BYTES = 50 * 1024 * 1024
+MAX_PENDING = 8
 # A notification is an SMS anyone can send, and its Content-Location is
