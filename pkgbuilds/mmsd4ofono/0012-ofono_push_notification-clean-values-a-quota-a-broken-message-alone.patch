+def status_value(value):
+    """A value for one line of a .status or .headers file: without line breaks or other control
+    characters, which would add lines of their own (a Transaction-Id 'T1\\nstate=sent' turned the
+    message into a sent one at the next start)."""
+    return sub(r'[\x00-\x1f\x7f]+', '', str(value))
+
+
+def smil_text(data):
+    """The SMIL part as text: invalid UTF-8 is replaced instead of failing after the files were
+    written and the MMSC was told the message arrived (and again at each start, in the export)."""
+    return data.decode('utf-8', 'replace').replace("\n", "").replace("\r", "")
+
