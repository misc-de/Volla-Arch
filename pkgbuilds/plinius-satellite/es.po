msgid "Calls, messages and data work, slower than usual."
msgstr "Llamadas, mensajes y datos funcionan, más lentos de lo habitual."

msgid "Calls and text messages work."
msgstr "Llamadas y SMS funcionan."

msgid "Text messages and some apps work, slower than usual."
msgstr "Los SMS y algunas apps funcionan, más lentos de lo habitual."

msgid "Some apps work, slower than usual."
msgstr "Algunas apps funcionan, más lentas de lo habitual."

msgid "Only text messages work."
msgstr "Solo funcionan los SMS."

#, c-format
msgid "Connected via satellite (%s)"
msgstr "Conectado por satélite (%s)"

msgid "Connected via satellite"
msgstr "Conectado por satélite"

msgid "Stay outdoors with a clear view of the sky. Sending can take a few minutes."
msgstr "Quédese al aire libre con el cielo despejado a la vista. El envío puede tardar unos minutos."

msgid "Satellite"
msgstr "Satélite"
