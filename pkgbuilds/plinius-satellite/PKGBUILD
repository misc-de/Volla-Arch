build() {
	for prog in plinius-satellite plinius-satellite-notify; do
		# shellcheck disable=SC2046
		${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
			-o $prog $prog.c $(pkg-config --cflags --libs gio-unix-2.0) $LDFLAGS
	done
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	install -Dm755 plinius-satellite plinius-satellite-notify -t "$pkgdir/usr/bin"
	install -Dm644 plinius-satellite.service -t "$pkgdir/usr/lib/systemd/system"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-satellite.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# The notification, in the session of whoever is signed in
	install -Dm644 plinius-satellite-notify.service -t "$pkgdir/usr/lib/systemd/user"
	install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
	ln -s ../plinius-satellite-notify.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
	install -Dm644 org.plinius.Satellite.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 providers.conf -t "$pkgdir/usr/share/plinius-satellite"
	install -Dm644 satellite.conf -t "$pkgdir/etc/plinius-satellite"
	install -d "$pkgdir/etc/plinius-satellite/providers.d"
	install -Dm644 plinius-satellite-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/status"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-satellite.mo"
	done
}
