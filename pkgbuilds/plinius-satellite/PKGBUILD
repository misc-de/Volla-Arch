# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-satellite
pkgver=0.2
pkgrel=3
pkgdesc="Satellite mode: tells when the phone is on a satellite network (Starlink Direct to Cell and alike), meters the connection, tells the user what works and scans for networks with a forecast"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
license=(MIT)
# Talks to oFono (network registration) and NetworkManager (metered connection) over the
# system bus only; it follows them when they come and go and works on without them
depends=(glib2)
makedepends=(gettext)
# Phosh shows a satellite instead of the signal bars (patch 0073)
optdepends=('phosh-plinius>=0.57.0-82: satellite icon in the top bar')
backup=(etc/plinius-satellite/satellite.conf)
_langs=(de es fr it nl pl pt ru)
source=(plinius-satellite.c
	plinius-satellite-notify.c
	plinius-satellite.service
	plinius-satellite-notify.service
	org.plinius.Satellite.conf
	providers.conf
	satellite.conf
	plinius-satellite-symbolic.svg
	"${_langs[@]/%/.po}"
	LICENSE)
sha256sums=('5bec601ce70123756edcd7c3e60a12a0fd39f383e5291e1bd1d670e8611a4ed2'
