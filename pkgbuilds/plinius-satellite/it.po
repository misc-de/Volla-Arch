msgid "Calls, messages and data work, slower than usual."
msgstr "Chiamate, messaggi e dati funzionano, più lentamente del solito."

msgid "Calls and text messages work."
msgstr "Chiamate e SMS funzionano."

msgid "Text messages and some apps work, slower than usual."
msgstr "Gli SMS e alcune app funzionano, più lentamente del solito."

msgid "Some apps work, slower than usual."
msgstr "Alcune app funzionano, più lentamente del solito."

msgid "Only text messages work."
msgstr "Funzionano solo gli SMS."

#, c-format
msgid "Connected via satellite (%s)"
msgstr "Connesso via satellite (%s)"

msgid "Connected via satellite"
msgstr "Connesso via satellite"

msgid "Stay outdoors with a clear view of the sky. Sending can take a few minutes."
msgstr "Resta all’aperto con il cielo libero in vista. L’invio può richiedere alcuni minuti."

msgid "Satellite"
msgstr "Satellite"
