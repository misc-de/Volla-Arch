msgid "Calls, messages and data work, slower than usual."
msgstr "Chamadas, mensagens e dados funcionam, mais lentos que o habitual."

msgid "Calls and text messages work."
msgstr "Chamadas e SMS funcionam."

msgid "Text messages and some apps work, slower than usual."
msgstr "SMS e algumas apps funcionam, mais lentos que o habitual."

msgid "Some apps work, slower than usual."
msgstr "Algumas apps funcionam, mais lentas que o habitual."

msgid "Only text messages work."
msgstr "Só os SMS funcionam."

