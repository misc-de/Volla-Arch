[Unit]
Description=Satellite connection: detect it and treat it with care
# oFono and NetworkManager come when they come, the daemon follows them on the bus
After=dbus.service

[Service]
Type=dbus
BusName=org.plinius.Satellite
ExecStart=/usr/bin/plinius-satellite
Restart=on-failure
RestartSec=5
# Which modem's roaming data it switched on, to undo it after a crash or a reboot
StateDirectory=plinius-satellite

# Sandbox (docs/DIENSTE-HAERTEN.md): only talks over the system bus. Root for oFono's and
# NetworkManager's bus policies (SetProperty, Reapply), but without any capability.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
