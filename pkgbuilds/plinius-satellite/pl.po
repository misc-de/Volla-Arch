msgid "Calls, messages and data work, slower than usual."
msgstr "Połączenia, wiadomości i dane działają, wolniej niż zwykle."

msgid "Calls and text messages work."
msgstr "Połączenia i SMS-y działają."

msgid "Text messages and some apps work, slower than usual."
msgstr "SMS-y i niektóre aplikacje działają, wolniej niż zwykle."

msgid "Some apps work, slower than usual."
msgstr "Niektóre aplikacje działają, wolniej niż zwykle."

msgid "Only text messages work."
msgstr "Działają tylko SMS-y."

