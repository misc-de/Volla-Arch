msgstr "Подключено через спутник (%s)"

msgid "Connected via satellite"
msgstr "Подключено через спутник"

msgid "Stay outdoors with a clear view of the sky. Sending can take a few minutes."
msgstr "Оставайтесь на открытом месте с хорошим обзором неба. Отправка может занять несколько минут."

msgid "Satellite"
msgstr "Спутник"
