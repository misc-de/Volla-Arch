[Unit]
Description=Mobile data watch: reconnect a mobile connection that carries nothing
# Waits for NetworkManager on the bus by itself
After=dbus.service

[Service]
ExecStart=/usr/bin/plinius-datawatch
Restart=on-failure
RestartSec=5
# Root without capabilities: NetworkManager lets uid 0 activate connections without polkit.
# Talks to the system bus only (a socket file, so PrivateNetwork= does not cut it off).
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
# More sandbox (docs/DIENSTE-HAERTEN.md): no capabilities
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
PrivateIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
