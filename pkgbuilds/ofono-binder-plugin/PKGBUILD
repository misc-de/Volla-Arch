# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=ofono-binder-plugin
pkgver=1.1.42
pkgrel=1
pkgdesc="ofono plugin for the Android radio HAL over binder (HIDL and AIDL), with libofonobinderpluginext"
arch=(aarch64 x86_64)
url="https://github.com/mer-hybris/ofono-binder-plugin"
license=(GPL-2.0-only)
depends=(ofono-sailfish glib2 libglibutil libgbinder libgbinder-radio libmce-glib)
provides=(libofonobinderpluginext)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz"
	0001-ofono-binder-Finish-the-SIM-status-transaction-for-c.patch
	0003-ofono-binder-Report-only-registration-failures-with-the-display-off.patch
	0004-ofono-binder-Send-the-IMS-data-profile-with-IWLAN-allowed.patch
	0005-ofono-binder-Set-up-emergency-numbers-with-emergencyDial.patch
	0006-ofono-binder-Keep-the-IRadio-version-of-calls-that-the-ext-also-reports.patch)
sha256sums=('474bae214f92e3aa684e5970fccc793da2b04a525fe8eda95b6ef3c161cec6be'
	'c515fe870b6a4756adc719f5798fe61d658103374ce162bf71fa3a1d236c2180'
	'789273c44a85e89b3ebf98e4d54e71a87c84877639cfad7d179da5e4910806ea'
	'692c5ea427eea91a42ced87e5325c23b42431d88b1485c40b5fd83a5e6ba755b'
	'e74566a4dddba89b42ad871a168379d58a0063026cf4a67875e1145d594230f6'
	'43528ca9c5ef57d1a11496c6ffbb5325f5c10b0814c26ceb09d2c3688935baa4')

prepare() {
	# eSIM without an enabled profile: otherwise all SIM requests of its slot wait forever
	patch -d "$pkgname-$pkgver" -Np1 -i "$srcdir/0001-ofono-binder-Finish-the-SIM-status-transaction-for-c.patch"
	# (0002, the APDU request on logical channels freed twice, is upstream since 1.1.38: bffd545)
	# Display off and no charger: only registration failures, as Android (docs/STANDBY.md);
	# otherwise the modem reports signal strength every 5 s and wakes a suspended phone
	patch -d "$pkgname-$pkgver" -Np1 -i "$srcdir/0003-ofono-binder-Report-only-registration-failures-with-the-display-off.patch"
	# IMS data profile with IWLAN allowed, as Android: the modem hands IMS over to Wi-Fi only
	# then (docs/VOWIFI.md)
	patch -d "$pkgname-$pkgver" -Np1 -i "$srcdir/0004-ofono-binder-Send-the-IMS-data-profile-with-IWLAN-allowed.patch"
	# Emergency numbers go out with emergencyDial, falling back to IMS and to an ordinary dial
	# (docs/NOTRUF.md)
	patch -d "$pkgname-$pkgver" -Np1 -i "$srcdir/0005-ofono-binder-Set-up-emergency-numbers-with-emergencyDial.patch"
	# Takes back upstream's 3bfe33b: ext-mtk flags all of its calls as incoming, so its version
	# of an outgoing VoLTE or emergency call must not replace the one from IRadio
	patch -d "$pkgname-$pkgver" -Np1 -i "$srcdir/0006-ofono-binder-Keep-the-IRadio-version-of-calls-that-the-ext-also-reports.patch"
}

build() {
	cd "$pkgname-$pkgver"
	local plugindir=$(pkg-config ofono --variable=plugindir)
	make PLUGINDIR="$plugindir" KEEP_SYMBOLS=1 release
	make -C lib LIBDIR=/usr/lib KEEP_SYMBOLS=1 release pkgconfig
}

package() {
	cd "$pkgname-$pkgver"
	local plugindir=$(pkg-config ofono --variable=plugindir)
	make DESTDIR="$pkgdir" PLUGINDIR="$plugindir" install
	make -C lib DESTDIR="$pkgdir" LIBDIR=/usr/lib install install-dev
	# /etc/ofono/binder.conf with the device values is shipped by the device package
	install -Dm644 binder.conf -t "$pkgdir/usr/share/doc/$pkgname"
}
