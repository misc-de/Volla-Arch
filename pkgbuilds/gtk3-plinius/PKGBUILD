# Maintainer: misc-de <misc-de@users.noreply.github.com>
# Based on Arch's gtk3 (Jan Alexander Steffens (heftig) <heftig@archlinux.org>, Ionut Biru <ibiru@archlinux.org>)

pkgname=gtk3-plinius
pkgver=3.24.52
pkgrel=5
epoch=1
pkgdesc="GObject-based multi-platform GUI toolkit, with touch drags that follow the finger while the content moves"
url="https://www.gtk.org/"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
# Debug symbols in a -debug package (ALARM's makepkg.conf has !debug): perf names Phosh's functions
options=(debug)
license=(LGPL-2.1-or-later)
# As Arch's gtk3
depends=(
	adwaita-fonts
	adwaita-icon-theme
	at-spi2-core
	cairo
	dconf
	desktop-file-utils
