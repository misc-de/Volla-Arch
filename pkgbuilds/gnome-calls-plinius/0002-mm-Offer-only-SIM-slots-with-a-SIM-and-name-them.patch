   const char * const *numbers = NULL;
+  guint slot;
 
   numbers = mm_modem_get_own_numbers (modem);
+  slot = modem_get_sim_slot (modem);
+
+  /* Name a SIM slot after its number and what's in it: "SIM 1 · Operator", "SIM 2 · No SIM" */
+  if (slot > 0) {
+    const char *detail = NULL;
+
+    if (!modem_has_sim (modem))
+      detail = _("No SIM");
+    else if (numbers && g_strv_length ((char **) numbers) > 0)
+      detail = numbers[0];
+    else if (modem_3gpp)
+      detail = mm_modem_3gpp_get_operator_name (modem_3gpp);
+
+    if (STR_IS_NULL_OR_EMPTY (detail))
+      return g_strdup_printf (_("SIM %u"), slot);
+
+    /* Translators: SIM slot number and its operator, own number or "No SIM" */
+    return g_strdup_printf (_("SIM %u · %s"), slot, detail);
+  }
+
   if (numbers && g_strv_length ((char **) numbers) > 0) {
     name = g_strdup (numbers[0]);
     return name;
@@ -1127,6 +1179,26 @@ modem_get_name (MMModem *modem)
 }
 
 
+/* The name follows the SIM and the network: notify the origin list when it changes */
+static void
+update_name (CallsMMOrigin *self)
+{
+  MMModem *modem = mm_object_peek_modem (self->mm_obj);
+  g_autofree char *name = NULL;
+
+  if (!modem)
+    return;
+
+  name = modem_get_name (modem, self->modem_3gpp);
+  if (g_strcmp0 (name, self->name) == 0)
+    return;
+
+  g_free (self->name);
+  self->name = g_steal_pointer (&name);
+  g_object_notify (G_OBJECT (self), "name");
+}
