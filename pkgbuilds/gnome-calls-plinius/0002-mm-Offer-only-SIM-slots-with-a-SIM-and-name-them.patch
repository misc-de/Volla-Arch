+static void
+forget_modem (CallsMMProvider *self,
+              guint            index)
+{
+  MMObject *mm_obj = g_ptr_array_index (self->modems, index);
+  MMModem *modem = mm_object_peek_modem (mm_obj);
+
+  if (modem)
+    g_signal_handlers_disconnect_by_func (modem, update_origins, self);
+
+  g_ptr_array_remove_index (self->modems, index);
+}
+
+
+static void
+forget_modems (CallsMMProvider *self)
+{
+  while (self->modems->len > 0)
+    forget_modem (self, self->modems->len - 1);
 }
 
 
