+/*
+ * oFono's ril plugin names every modem "binder", so two SIM slots looked the
+ * same in the origin list. Returns the slot number (1-based) for a modem whose
+ * device is oFono's /ril_<n> (as oFono2MM reports it), 0 otherwise.
+ */
+static guint
+modem_get_sim_slot (MMModem *modem)
+{
+  const char *device = mm_modem_get_device (modem);
+  guint64 index;
+
+  if (!device || !g_str_has_prefix (device, "/ril_"))
+    return 0;
+
+  if (!g_ascii_string_to_unsigned (device + sizeof ("/ril_") - 1, 10, 0, G_MAXUINT - 1, &index, NULL))
+    return 0;
+
+  return (guint) index + 1;
+}
+
+
+/* A modem in state "failed" has no usable SIM (missing, or an eSIM without a profile) */
+static gboolean
+modem_has_sim (MMModem *modem)
+{
+  return mm_modem_get_state (modem) != MM_MODEM_STATE_FAILED;
+}
