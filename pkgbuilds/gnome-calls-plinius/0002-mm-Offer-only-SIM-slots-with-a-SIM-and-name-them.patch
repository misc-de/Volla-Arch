@@ -1438,6 +1524,41 @@ calls_mm_origin_new (MMObject   *mm_obj,
                        NULL);
 }
 
+/**
+ * calls_mm_origin_has_sim:
+ *
+ * Whether the modem has a usable SIM. An empty slot (or an eSIM without a
+ * profile) can't place a normal call.
+ */
+gboolean
+calls_mm_origin_has_sim (CallsMMOrigin *self)
+{
+  MMModem *modem;
+
+  g_return_val_if_fail (CALLS_IS_MM_ORIGIN (self), FALSE);
+
+  modem = mm_object_peek_modem (self->mm_obj);
+  return modem && modem_has_sim (modem);
+}
+
+
+/**
+ * calls_mm_origin_get_device:
+ *
+ * The modem's device (oFono's /ril_<n> with oFono2MM), for a stable order.
+ */
+const char *
+calls_mm_origin_get_device (CallsMMOrigin *self)
+{
+  MMModem *modem;
+
+  g_return_val_if_fail (CALLS_IS_MM_ORIGIN (self), NULL);
+
+  modem = mm_object_peek_modem (self->mm_obj);
+  return modem ? mm_modem_get_device (modem) : NULL;
+}
+
+
 gboolean
 calls_mm_origin_matches (CallsMMOrigin *self,
                          MMObject      *mm_obj)
