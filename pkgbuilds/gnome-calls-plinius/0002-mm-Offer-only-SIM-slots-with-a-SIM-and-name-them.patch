+/*
+ * Calls dials through the first suitable origin, and the dial pad selects the
+ * first one. With two SIM slots the empty one (oFono's eSIM without a profile)
+ * came first at random and every call failed with NotAvailable. Put modems
+ * with a SIM first, then go by device (SIM slot) for a stable order.
+ */
+static int
+compare_origins (gconstpointer a,
+                 gconstpointer b,
+                 gpointer      user_data)
+{
+  CallsMMOrigin *origin_a = CALLS_MM_ORIGIN ((gpointer) a);
+  CallsMMOrigin *origin_b = CALLS_MM_ORIGIN ((gpointer) b);
+  gboolean sim_a = calls_mm_origin_has_sim (origin_a);
+  gboolean sim_b = calls_mm_origin_has_sim (origin_b);
+
+  if (sim_a != sim_b)
+    return sim_a ? -1 : 1;
+
+  return g_strcmp0 (calls_mm_origin_get_device (origin_a),
+                    calls_mm_origin_get_device (origin_b));
+}
+
+
+/*
+ * Only modems with a SIM are offered as origins: an empty slot can't place a
+ * call, and offering it made Calls dial through it. If no modem has a SIM,
+ * all of them are offered, so that an emergency call is still possible.
+ *
+ * An origin is never moved or added twice (CallsManager connects to every
+ * origin added to the list): a modem that gets or loses its SIM gets a new
+ * origin, or loses its origin. One with a call up is kept until the call ends.
+ */
+static void
+update_origins (CallsMMProvider *self)
+{
+  gboolean any_sim = FALSE;
+
+  for (guint i = 0; i < self->modems->len; i++) {
+    if (mm_object_has_sim (g_ptr_array_index (self->modems, i))) {
+      any_sim = TRUE;
+      break;
+    }
+  }
+
+  for (guint i = 0; i < self->modems->len; i++) {
+    MMObject *mm_obj = g_ptr_array_index (self->modems, i);
+    gboolean wanted = !any_sim || mm_object_has_sim (mm_obj);
+    guint position;
+    gboolean listed = find_origin (self, mm_obj, &position);
+
+    if (wanted && !listed) {
+      g_autoptr (MMModem3gpp) modem_3gpp = mm_object_get_modem_3gpp (mm_obj);
+      g_autoptr (CallsMMOrigin) origin = NULL;
+
+      g_debug ("Offering modem `%s'",
+               g_dbus_object_get_object_path (G_DBUS_OBJECT (mm_obj)));
+
+      origin = calls_mm_origin_new (mm_obj,
+                                    modem_3gpp ? mm_modem_3gpp_get_imei (modem_3gpp) : NULL);
+      /* A modem kept for its call is dropped once the call is gone */
+      g_signal_connect_object (origin, "call-removed",
+                               G_CALLBACK (update_origins), self,
+                               G_CONNECT_SWAPPED);
+      g_list_store_insert_sorted (self->origins, origin, compare_origins, NULL);
+    } else if (!wanted && listed) {
+      g_autoptr (CallsOrigin) origin = g_list_model_get_item (G_LIST_MODEL (self->origins), position);
+      GList *calls = calls_origin_get_calls (origin);
+
+      if (calls) {
+        g_list_free (calls);
+        continue;
+      }
+
+      g_debug ("No longer offering modem `%s' without a SIM",
+               g_dbus_object_get_object_path (G_DBUS_OBJECT (mm_obj)));
+      g_list_store_remove (self->origins, position);
+    }
+  }
+
+  update_status (self);
+}
+
