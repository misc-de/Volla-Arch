+    # -- the Plinius additions: device class, display, music, a reboot -----
+
+    def test_a_car_kit_is_not_dialled_even_though_it_says_headset(self):
+        """BlueZ gives the car kit the Icon "audio-headset" as well; its
+        class is hands-free (0x240408, measured on the Plinius)."""
+        system = ReconnectBus(cls=0x240408)
+        rc = self.build(system)
+        out = io.StringIO()
+        with redirect_stdout(out):
+            rc.on_disconnected("/org/bluez/hci0/dev_9C_DF_03_BB_8D_31")
+        self.assertIsNone(rc.candidate)
+        self.assertIn("not headphones", out.getvalue())
+        self.assertFalse(os.path.exists(self.state_file))
+
+    def test_a_device_without_a_class_is_left_alone(self):
+        rc = self.build(ReconnectBus(cls=None))
+        self.drop(rc)
+        self.assertIsNone(rc.candidate)
+
+    def test_headphones_by_class(self):
+        self.assertTrue(reconnect.is_headphones(
+            ReconnectBus(cls=0x240418), "/x"))      # minor 6, headphones
+        self.assertFalse(reconnect.is_headphones(
+            ReconnectBus(cls=0x240414), "/x"))      # minor 5, loudspeaker
+        self.assertFalse(reconnect.is_headphones(
+            ReconnectBus(cls=0x000504), "/x"))      # a peripheral
+
+    def display(self, rc, state):
+        with redirect_stdout(io.StringIO()):
+            rc.on_display(None, None, None, None, None, FakeVariant([state]))
+
+    def test_the_display_coming_on_dials_the_candidate(self):
+        system = ReconnectBus(connected=False)
+        rc = self.build(system, active=True)
+        self.drop(rc)
+        self.display(rc, "off")
+        self.assertEqual(system.connects, [])
+        self.display(rc, "on")
+        self.assertEqual(system.connects,
+                         ["/org/bluez/hci0/dev_F4_9D_8A_00_00_01"])
+
+    def test_display_and_unlock_together_are_one_attempt(self):
+        """The display comes on, and a moment later logind says the session
+        is no longer idle: the same event, seen twice."""
+        system = ReconnectBus(connected=False)
+        rc = self.build(system, active=True)
+        self.drop(rc)
+        self.display(rc, "on")
+        system.answer(ok=False)
+        self.now += 2
+        with redirect_stdout(io.StringIO()):
+            rc.on_wakeup()
+        self.assertEqual(len(system.connects), 1)
+
+    def play(self, rc, status="Playing",
+             iface="org.mpris.MediaPlayer2.Player"):
+        with redirect_stdout(io.StringIO()):
+            rc.on_player_props(None, None, None, None, None, FakeVariant(
+                [iface, {"PlaybackStatus": status}, []]))
+
+    def test_music_starting_dials_the_candidate(self):
+        """Earbuds taken out of their case with the phone already in hand:
+        no wake-up, no display change - pressing play is the occasion."""
+        system = ReconnectBus(connected=False)
+        rc = self.build(system, active=True)
+        self.drop(rc)
+        self.play(rc, "Paused")
+        self.play(rc, "Playing", iface="org.mpris.MediaPlayer2")
+        self.assertEqual(system.connects, [])
+        self.play(rc)
+        self.assertEqual(len(system.connects), 1)
+
+    def test_a_playlist_is_not_a_poller(self):
+        system = ReconnectBus(connected=False)
+        rc = self.build(system, active=True)
+        self.drop(rc)
+        self.play(rc)
+        system.answer(ok=False)
+        self.now += reconnect.MUSIC_MIN_GAP_S / 2.0
+        self.play(rc)
+        self.assertEqual(len(system.connects), 1)
+        self.now += reconnect.MUSIC_MIN_GAP_S
+        self.play(rc)
+        self.assertEqual(len(system.connects), 2)
+
+    def test_music_on_connected_earbuds_dials_nothing(self):
+        system = ReconnectBus()
+        rc = self.build(system, active=True)
+        self.drop(rc)
+        with redirect_stdout(io.StringIO()):
+            rc.on_connected("/org/bluez/hci0/dev_F4_9D_8A_00_00_01")
+        self.now += reconnect.KEPT_S + 1
+        self.play(rc)
+        self.assertEqual(system.connects, [])
+
+    def test_the_candidate_survives_a_restart(self):
+        """Earbuds put away before a reboot, taken out after it."""
+        system = ReconnectBus(connected=False)
+        rc = self.build(system, active=True)
+        self.drop(rc)
+        self.assertTrue(os.path.exists(self.state_file))
+
+        again = self.build(system, active=True)
+        with redirect_stdout(io.StringIO()):
+            again.restore()
+        self.assertIsNotNone(again.candidate)
+        self.assertEqual(again.candidate.attempts_left, 0,
+                         "a restart is not a new disconnect")
+        self.assertEqual(system.connects, [], "restoring dials nothing")
+        self.display(again, "on")
+        self.assertEqual(system.connects,
+                         ["/org/bluez/hci0/dev_F4_9D_8A_00_00_01"])
+
+    def test_a_remembered_candidate_still_expires(self):
+        system = ReconnectBus(connected=False)
+        self.drop(self.build(system, active=True))
+        saved = reconnect.time.time
+        reconnect.time.time = lambda: saved() + reconnect.CANDIDATE_TTL_S + 5
+        try:
+            again = self.build(system)
+            with redirect_stdout(io.StringIO()):
+                again.restore()
+        finally:
+            reconnect.time.time = saved
+        self.assertIsNone(again.candidate)
+        self.assertFalse(os.path.exists(self.state_file))
+
+    def test_a_remembered_device_that_was_unpaired_is_dropped(self):
+        system = ReconnectBus(connected=False)
+        self.drop(self.build(system, active=True))
+        system.connected = None          # BlueZ: no such device
+        again = self.build(system)
+        with redirect_stdout(io.StringIO()):
+            again.restore()
+        self.assertIsNone(again.candidate)
+        self.assertFalse(os.path.exists(self.state_file))
+
+    def test_bluez_not_up_yet_at_boot_is_not_an_unpairing(self):
+        system = ReconnectBus(connected=False, bluez=False)
+        self.drop(self.build(system, active=True))
+        again = self.build(system)
+        with redirect_stdout(io.StringIO()):
+            again.restore()
+        self.assertIsNone(again.candidate)
+        self.assertTrue(os.path.exists(self.state_file), "kept for later")
+        self.assertEqual(len(self.timers), 1, "asks again")
+        system.bluez = True
+        self.fire_next_timer(again)
+        self.assertIsNotNone(again.candidate)
+
+    def test_a_connected_remembered_device_is_not_taken_over(self):
+        system = ReconnectBus(connected=False)
+        self.drop(self.build(system, active=True))
+        system.connected = True
+        again = self.build(system)
+        with redirect_stdout(io.StringIO()):
+            again.restore()
+        self.assertIsNone(again.candidate)
+
+    def test_a_broken_state_file_is_ignored(self):
+        with open(self.state_file, "w", encoding="utf-8") as f:
+            f.write("{not json")
+        rc = self.build(ReconnectBus(connected=False))
+        with redirect_stdout(io.StringIO()):
+            rc.restore()
+        self.assertIsNone(rc.candidate)
+
 
