@@ -27,17 +27,41 @@ by occasions, of which there are two:
                    the lock screen - you picked the phone up, so you are
                    there, and so, probably, are the earbuds.
 
+  display on       one attempt when the display is switched on, as MCE
+                   announces it (MCE_SIGNAL_IFACE). Earlier than the lock
+                   screen going away, and it also happens on a phone without
+                   a lock screen.
+
+  music starts     one attempt when a media player starts playing (MPRIS).
+                   Taking the earbuds out of their case with the phone already
+                   in hand is no occasion at all otherwise, and pressing play
+                   is the moment the earbuds are wanted.
+
+Earbuds do try to connect themselves when they leave their case, and mostly it
+works. Measured on the Plinius on 2026-11-11 with a pair of earbuds: out
+of the case at 13:24:48, connected the same second, nothing dialled. An hour
+earlier the same earbuds came out of the same case and nothing arrived at the
+phone's BlueZ at all - their own attempt is short, and when it misses, it is not
+repeated. The occasions are for that.
+
 Between the occasions it does nothing at all, which is the point: a phone that
 pages a device every thirty seconds all night to find it switched off has
 spent the battery this repository has spent months protecting.
 
-The candidate is only ever a device this service watched disconnect. Paired
-audio devices on this phone include a car kit and an OBD adapter, and paging
-those because somebody's headset is missing would be noise on the air and a
-car radio switching on in a parked car. Nothing is dialled that was not there
-a moment ago.
+The candidate is only ever a device this service watched disconnect - and,
+since a reboot would forget it, one it watched disconnect before the reboot
+(STATE_FILE). Paired audio devices on this phone include a car kit and an OBD
+adapter, and paging those because somebody's headset is missing would be noise
+on the air and a car radio switching on in a parked car. A car kit calls itself
+an audio headset in BlueZ's Icon as well, so the device class decides: only
+headphones and wearable headsets are dialled (is_headphones). Nothing is
+dialled that was not there a moment ago.
 """
 
+import json
+import os
+import time
+
 import gi
 
 gi.require_version("Gio", "2.0")
@@ -78,6 +102,44 @@ KEPT_S = 30
 # because it stops by itself after four.
 WAKE_MIN_GAP_S = 300
 
+# The shortest gap before an attempt because music started. Shorter than the
+# one for waking up, because pressing play is something somebody did on
+# purpose, and there are not dozens of those an hour - but not none, because a
+# player that skips through a playlist reports Playing for every track.
+MUSIC_MIN_GAP_S = 60
+
+# The display state as MCE broadcasts it: display_status_ind("on" | "dimmed" |
+# "off") on the system bus, the interface Sailfish OS uses and ofono listens
+# to. On the Plinius it comes from plinius-mce, which is told by
+# plinius-backlight-wake - the always-on clock counting as off. Nothing else on
+# phosh publishes the display state. Without an MCE the signal never arrives
+# and this occasion simply does not happen.
+MCE_SERVICE = "com.nokia.mce"
+MCE_SIGNAL_PATH = "/com/nokia/mce/signal"
+MCE_SIGNAL_IFACE = "com.nokia.mce.signal"
+
+# Where the candidate is kept across a restart of this service or the phone:
+# earbuds that went into their case before a reboot are just as worth dialling
+# after it, and without this a reboot is a day of nothing being dialled.
+STATE_FILE = os.path.join(
+    os.environ.get("XDG_STATE_HOME")
+    or os.path.join(os.path.expanduser("~"), ".local", "state"),
+    "furios-audio", "bt-reconnect.json")
+RESTORE_TRIES = 6
+RESTORE_RETRY_S = 10
+
+# Bluetooth class of device: major class Audio/Video, and the minor classes
+# that are something worn on the head. A car kit is Audio/Video too, with the
+# minor class hands-free (2) or car audio (8) - and BlueZ gives it the same
+# Icon "audio-headset" as earbuds, so the Icon cannot tell them apart.
+# Measured on the Plinius: earbuds 0x248404 (minor 1), the
+# car kit 0x240408 (minor 2).
+CLASS_MAJOR_AUDIO_VIDEO = 4
+HEADPHONE_MINOR_CLASSES = (
+    1,      # wearable headset
+    6,      # headphones
+)
+
 # How long a device stays worth dialling after it went. Earbuds left in a
 # drawer over a weekend must not be paged on every unlock for the rest of the
 # month; after a day of nothing, the next connection can be made by hand.
@@ -151,6 +213,93 @@ def is_trusted(system, path):
         return False
 
 
+def is_headphones(system, path):
+    """Is this something worn on the head - not a car kit, not a speaker?
+
+    By the class of device, see HEADPHONE_MINOR_CLASSES. A device without a
+    class (BLE only, or never seen in an inquiry) is left alone: doubt means
+    leave it alone here, as in carries_audio.
+    """
+    try:
+        cls = system.call_sync(
+            "org.bluez", path, "org.freedesktop.DBus.Properties", "Get",
+            GLib.Variant("(ss)", ("org.bluez.Device1", "Class")),
+            GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 1000, None,
+        ).unpack()[0]
+    except GLib.Error:
+        return False
+    if not isinstance(cls, int):
+        return False
+    return ((cls >> 8) & 0x1f == CLASS_MAJOR_AUDIO_VIDEO
+            and (cls >> 2) & 0x3f in HEADPHONE_MINOR_CLASSES)
+
+
+def bluez_answers(system):
+    """Is bluetoothd on the bus? Asked of the bus, not of BlueZ."""
+    try:
+        return bool(system.call_sync(
+            "org.freedesktop.DBus", "/org/freedesktop/DBus",
+            "org.freedesktop.DBus", "NameHasOwner",
+            GLib.Variant("(s)", ("org.bluez",)), GLib.VariantType("(b)"),
+            Gio.DBusCallFlags.NONE, 1000, None,
+        ).unpack()[0])
+    except GLib.Error:
+        return False
+
+
+def save_candidate(path, name, state_file=None):
+    """Remember the candidate on disk, with the wall-clock time it went.
+
+    Wall clock and not monotonic, because the point is to survive a reboot,
+    and the monotonic clock starts again at zero with every boot. Failing to
+    write is said and otherwise ignored: the service works as before, it only
+    forgets the candidate at the next restart.
+    """
+    state_file = state_file or STATE_FILE
+    try:
+        os.makedirs(os.path.dirname(state_file), exist_ok=True)
+        tmp = state_file + ".tmp"
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump({"path": path, "name": name, "gone_at": time.time()}, f)
+        os.replace(tmp, state_file)
+    except OSError as err:
+        print("could not remember %s: %s" % (name, err), flush=True)
+
+
+def forget_candidate(state_file=None):
+    try:
+        os.unlink(state_file or STATE_FILE)
+    except FileNotFoundError:
+        pass
+    except OSError as err:
+        print("could not forget the candidate: %s" % err, flush=True)
+
+
+def load_candidate(state_file=None):
+    """(path, name, seconds since it went), or None.
+
+    None for anything that is not a candidate any more: no file, a file that
+    cannot be read, older than CANDIDATE_TTL_S, or from the future - a clock
+    that was wrong when it was written says nothing about how long ago that
+    was.
+    """
+    try:
+        with open(state_file or STATE_FILE, encoding="utf-8") as f:
+            data = json.load(f)
+        path = str(data["path"])
+        name = str(data["name"])
+        age = time.time() - float(data["gone_at"])
+    except FileNotFoundError:
+        return None
+    except (OSError, ValueError, KeyError, TypeError) as err:
+        print("could not read the remembered candidate: %s" % err,
+              flush=True)
+        return None
+    if not path.startswith("/org/bluez/") or age < 0 or age > CANDIDATE_TTL_S:
+        return None
+    return path, name, age
+
+
 def in_a_call(session):
     """Is callaudiod switching the card for a call right now?
 
@@ -256,9 +405,10 @@ class Reconnector:
     killswitch indicator on 2026-09-14. Keep the connection, keep the signal.
     """
 
-    def __init__(self, system, session):
+    def __init__(self, system, session, state_file=None):
         self.system = system
         self.session = session
+        self.state_file = state_file or STATE_FILE
         self.candidate = None
         self.last_attempt = 0.0    # monotonic, any attempt, any occasion
         # Is the phone in someone's hand? Read from logind at startup and
@@ -377,10 +527,15 @@ class Reconnector:
             print("%s disconnected, but it is not trusted - leaving it alone"
                   % name, flush=True)
             return
+        if not is_headphones(self.system, path):
+            print("%s disconnected, but it is not headphones - leaving it "
+                  "to call back itself" % name, flush=True)
+            return
 
         if cand is not None:
             cand.cancel_timer()
         self.candidate = Candidate(path, name)
+        save_candidate(path, name, self.state_file)
 
         # Who hung up? There is no way to ask - BlueZ does not pass the
         # disconnect reason to D-Bus - but there is a good proxy. If the phone
@@ -416,6 +571,7 @@ class Reconnector:
         if cand is not None and cand.path == path:
             cand.cancel_timer()
             self.candidate = None
+            forget_candidate(self.state_file)
             print("%s is gone from BlueZ - nothing to reconnect"
                   % cand.name, flush=True)
 
@@ -527,6 +683,37 @@ class Reconnector:
         measured on this phone the first time the service ran. Without the
         gap, this occasion would be a poller with extra steps.
         """
+        self.occasion("phone back in use", WAKE_MIN_GAP_S)
+
+    def on_display(self, _conn, _sender, _path, _iface, _signal, params):
+        """MCE: the display was switched on, dimmed or off.
+
+        Only "on" is an occasion. The rate limit is the one for waking up,
+        because it is the same event seen earlier: the display comes on, and
+        a moment later logind may say the session is no longer idle - the gap
+        makes that one attempt and not two.
+        """
+        try:
+            state = params.unpack()[0]
+        except (TypeError, IndexError, AttributeError):
+            return
+        if state == "on":
+            self.occasion("display on", WAKE_MIN_GAP_S)
+
+    def on_player_props(self, _conn, _sender, _path, _iface, _signal,
+                        params):
+        """MPRIS: a media player started playing."""
+        try:
+            iface, changed, _invalidated = params.unpack()
