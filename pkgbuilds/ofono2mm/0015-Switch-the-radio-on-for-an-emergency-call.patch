From: misc-de <misc-de@users.noreply.github.com>
Date: Tue, 03 Nov 2026 22:30:00 +0100
Subject: [PATCH] Switch the radio on for an emergency call

In flight mode oFono refuses every dial with -ENETDOWN. If the number is one
of oFono's emergency numbers, set the modem online first. It stays on, as on
Android. An error while doing so doesn't stop the dial from being tried.
---
--- a/ofono2mm/mm_modem_voice.py	2026-11-03 22:10:15.141224263 +0100
+++ b/ofono2mm/mm_modem_voice.py	2026-11-03 22:19:28.244266710 +0100
@@ -132,6 +132,24 @@
             else:
                 self.props['EmergencyOnly'] = Variant('b', False)
 
+    async def bring_online_for_emergency(self, number):
+        # oFono refuses to dial with the radio off (flight mode). An emergency number has to go
+        # out anyway: switch the radio on as Android does, it stays on afterwards. Whatever goes
+        # wrong here must not keep the dial from being tried.
+        try:
+            manager_props = await self.ofono_interfaces['org.ofono.VoiceCallManager'].call_get_properties()
+            if 'EmergencyNumbers' not in manager_props or number not in manager_props['EmergencyNumbers'].value:
+                return
+
+            modem_props = await self.ofono_modem.call_get_properties()
+            if modem_props['Online'].value:
+                return
+
+            Logger.info("Emergency number with the radio off, switching it on")
+            await self.ofono_modem.call_set_property('Online', Variant('b', True))
+        except Exception as e:
+            Logger.error("Could not bring the modem online for an emergency call: %s", e)
+
     @method()
     async def CreateCall(self, properties: 'a{sv}') -> 'o':
         global call_i
@@ -140,6 +158,7 @@
         else:
             self.props['EmergencyOnly'] = Variant('b', False)
 
+        await self.bring_online_for_emergency(properties['number'].value)
         await self.ofono_interfaces['org.ofono.VoiceCallManager'].call_dial(properties['number'].value, 'disabled')
         call_i += 1
         mm_call_interface = MMCallInterface(self.index, self.bus, self.ofono_client, self.modem_name, self.ofono_modem, self.ofono_props, self.ofono_interfaces, self.ofono_interface_props)
