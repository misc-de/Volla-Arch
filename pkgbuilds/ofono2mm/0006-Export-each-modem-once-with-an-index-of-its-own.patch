From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Fri, 30 Oct 2026 10:10:07 +0100
Subject: [PATCH] Export each modem once, with an index of its own

oFono's ModemAdded can arrive while the modems from GetModems are still
being exported, even for one of them. export_new_modem took its index from
self.i and only counted it up after a dozen awaits, so two exports could
share an index: the second one raised on exporting
ModemManager1/SIM/<index> again, and ModemManager1 was never requested
(systemd timed the service out, GNOME Settings waited 25 s for it at
start). self.i was also reset only after GetModems had returned.

Claim the modem path and the index before the first await, skip modems
that are already exported, and reset both at the start of
find_ofono_modems.
---
 main.py | 25 +++++++++++++++++++------
 1 file changed, 19 insertions(+), 6 deletions(-)

diff --git a/main.py b/main.py
index c5917a5..a640ddb 100755
--- a/main.py
+++ b/main.py
@@ -39,6 +39,8 @@ class MMInterface(ServiceInterface):
         self.dbus_client = DBus(bus)
         self.mm_modem_interfaces = []
         self.mm_modem_objects = []
+        self.i = 0
+        self.exported_paths = set()
         self.loop.create_task(self.check_ofono_presence())
 
     @dbus_property(access=PropertyAccess.READ)
@@ -79,6 +81,9 @@ class MMInterface(ServiceInterface):
 
         self.mm_modem_objects = []
         self.mm_modem_intefaces = []
+        # Reset before the first await: oFono's ModemAdded may already be on its way
+        self.i = 0
+        self.exported_paths = set()
 
         if not self.ofono_manager_interface:
             return
@@ -94,8 +99,6 @@ class MMInterface(ServiceInterface):
             except DBusError:
                 pass
 
-        self.i = 0
-
         for modem in self.ofono_modem_list:
             await self.export_new_modem(modem[0], modem[1])
 
@@ -117,11 +120,21 @@ class MMInterface(ServiceInterface):
             pass
 
     async def export_new_modem(self, path, mprops):
-        mm_modem_interface = MMModemInterface(self.loop, self.i, self.bus, self.ofono_client, path)
+        # ModemAdded can arrive while the modems from GetModems are still being exported, even for
+        # one of them. Claim the modem and its index before the first await, so that no modem is
+        # exported twice and no two modems share an index (the second export of
+        # ModemManager1/SIM/<index> raised and ModemManager1 was never requested).
+        if path in self.exported_paths:
+            return
+        self.exported_paths.add(path)
+        index = self.i
+        self.i += 1
+
+        mm_modem_interface = MMModemInterface(self.loop, index, self.bus, self.ofono_client, path)
         mm_modem_interface.ofono_props = mprops
         self.ofono_client["ofono_modem"][path]['org.ofono.Modem'].on_property_changed(mm_modem_interface.ofono_changed)
         await mm_modem_interface.init_ofono_interfaces()
-        self.bus.export(f'/org/freedesktop/ModemManager1/Modem/{self.i}', mm_modem_interface)
+        self.bus.export(f'/org/freedesktop/ModemManager1/Modem/{index}', mm_modem_interface)
         mm_modem_interface.set_props()
         await mm_modem_interface.init_mm_sim_interface()
         await mm_modem_interface.init_mm_3gpp_interface()
@@ -138,10 +151,10 @@ class MMInterface(ServiceInterface):
         await mm_modem_interface.init_mm_location_interface()
         await mm_modem_interface.init_mm_voice_interface()
         self.mm_modem_interfaces.append(mm_modem_interface)
-        self.mm_modem_objects.append(f'/org/freedesktop/ModemManager1/Modem/{self.i}')
-        self.i += 1
+        self.mm_modem_objects.append(f'/org/freedesktop/ModemManager1/Modem/{index}')
 
     def ofono_modem_removed(self, path):
+        self.exported_paths.discard(path)
         for mm_object in self.mm_modem_objects:
             try:
                 if mm_object.modem_name == path:
