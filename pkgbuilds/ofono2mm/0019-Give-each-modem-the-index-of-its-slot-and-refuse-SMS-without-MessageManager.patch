From 8123ebaa7637aa8211d8ebd0c0065077fc279a9c Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Wed, 11 Nov 2026 07:39:46 +0100
Subject: [PATCH] Give each modem the index of its slot, refuse SMS without
 MessageManager

The index of a modem came from the order its export started. At boot the
slot with the SIM is ready first; after a restart of ofono2mm the empty
second slot came first and became Modem/0. Chatty takes the first modem:
Messaging.Create on it had no MessageManager, returned an SMS object and
sent nothing, so the SMS looked sent and never left.

- /ril_N is Modem/N; other paths, or a slot index taken already, get the
  next free index.
- Messaging.Create raises Unsupported when oFono's MessageManager is
  missing, and InvalidArgs without number or text, instead of a success.
---
 main.py                        | 23 ++++++++++++++++++++---
 ofono2mm/mm_modem_messaging.py | 13 +++++++++----
 2 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/main.py b/main.py
index e1873be..9bc4900 100755
--- a/main.py
+++ b/main.py
@@ -7,6 +7,7 @@ from dbus_next.constants import PropertyAccess
 from dbus_next import DBusError, BusType, Message, MessageType, MessageFlag, Variant
 
 import asyncio
+import re
 from argparse import ArgumentParser
 
 from ofono2mm import MMModemInterface, Ofono, DBus
@@ -290,8 +291,9 @@ class MMInterface(ServiceInterface):
         self.mm_modem_interfaces = []
         self.mm_modem_objects = []
         self.i = 0
-        # oFono modem path -> task exporting it
+        # oFono modem path -> task exporting it, and the index it got
         self.modem_exports = {}
+        self.modem_indexes = {}
         self.loop.create_task(self.check_ofono_presence())
 
     @dbus_property(access=PropertyAccess.READ)
@@ -333,6 +335,7 @@ class MMInterface(ServiceInterface):
         # Reset before the first await: oFono's ModemAdded may already be on its way
         self.i = 0
         self.modem_exports = {}
+        self.modem_indexes = {}
 
         if not self.ofono_manager_interface:
             return
@@ -382,6 +385,21 @@ class MMInterface(ServiceInterface):
         except Exception as e:
             pass
 
+    def modem_index(self, path):
+        # The index of oFono's slot (/ril_0 → Modem/0, /ril_1 → Modem/1), so it does not depend on
+        # which modem is ready first. Clients such as Chatty take the first modem: after a restart
+        # of ofono2mm the empty second slot came first, Modem/0 had no MessageManager, and SMS
+        # went nowhere. Other paths, or a slot index taken already, get the next free one.
+        taken = {export_index for export_index in self.modem_indexes.values()}
+        match = re.fullmatch(r'/ril_(\d+)', path)
+        if match and int(match.group(1)) not in taken:
+            index = int(match.group(1))
+        else:
+            index = max(taken | {self.i - 1, len(taken) - 1}) + 1
+        self.modem_indexes[path] = index
+        self.i = max(self.i, index + 1)
+        return index
+
     async def export_new_modem(self, path, mprops):
         # ModemAdded can arrive while the modems from GetModems are still being exported, even for
         # one of them. Claim the modem and its index before the first await, so that no modem is
@@ -390,8 +408,7 @@ class MMInterface(ServiceInterface):
         # caller waits for the export that is running.
         export = self.modem_exports.get(path)
         if export is None:
-            index = self.i
-            self.i += 1
+            index = self.modem_index(path)
             export = self.loop.create_task(self.export_modem(path, mprops, index))
             self.modem_exports[path] = export
         try:
diff --git a/ofono2mm/mm_modem_messaging.py b/ofono2mm/mm_modem_messaging.py
index a2d779c..cce28fd 100644
--- a/ofono2mm/mm_modem_messaging.py
+++ b/ofono2mm/mm_modem_messaging.py
@@ -1,7 +1,7 @@
 from dbus_next.service import (ServiceInterface,
                                method, dbus_property, signal)
 from dbus_next.constants import PropertyAccess
-from dbus_next import Variant
+from dbus_next import DBusError, Variant
 
 from ofono2mm.mm_sms import MMSmsInterface
 
@@ -70,7 +70,13 @@ class MMModemMessagingInterface(ServiceInterface):
     async def Create(self, properties: 'a{sv}') -> 'o':
         global message_i
         if 'number' not in properties or 'text' not in properties:
-            return
+            raise DBusError('org.freedesktop.ModemManager1.Error.Core.InvalidArgs',
+                            'an SMS needs a number and a text')
+        # Without oFono's MessageManager (no SIM in this slot, or not ready yet) nothing would be
+        # sent, while the caller got a new SMS object and took it for sent
+        if 'org.ofono.MessageManager' not in self.ofono_interfaces:
+            raise DBusError('org.freedesktop.ModemManager1.Error.Core.Unsupported',
+                            'this modem cannot send SMS now')
 
         mm_sms_interface = MMSmsInterface(self.index, self.bus, self.ofono_client, self.modem_name, self.ofono_modem, self.ofono_props, self.ofono_interfaces, self.ofono_interface_props)
         mm_sms_interface.props.update({
@@ -86,8 +92,7 @@ class MMModemMessagingInterface(ServiceInterface):
         self.Added(bus_path, True)
         message_i += 1
 
-        if 'org.ofono.MessageManager' in self.ofono_interfaces:
-            ofono_sms_path = await self.ofono_interfaces['org.ofono.MessageManager'].call_send_message(properties['number'].value, properties['text'].value)
+        ofono_sms_path = await self.ofono_interfaces['org.ofono.MessageManager'].call_send_message(properties['number'].value, properties['text'].value)
 
         return bus_path
 
