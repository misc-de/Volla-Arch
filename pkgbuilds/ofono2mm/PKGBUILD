# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=ofono2mm
pkgver=1.0.1.20260109
pkgrel=27
pkgdesc="ModemManager D-Bus API on top of ofono, so gnome-calls, chatty and NetworkManager work unchanged"
arch=(any)
url="https://github.com/droidian/oFono2MM"
license=(BSD-3-Clause)
# modemmanager stays installed: its unit (redirected to ofono2mm via drop-in), libmm-glib
depends=(python python-dbus-next python-gobject geoclue modemmanager ofono-sailfish polkit)
makedepends=(git)
# Droidian original; the FuriLabs offshoot has more fixes but counts as a fork (docs/HARDWARE.md).
# Last tag 1.0.1 is from 2023: commit pin on the droidian branch, pkgver = tag + commit date
_commit=97a792d2d6ae43be039d69ed2caabd34c1693412
