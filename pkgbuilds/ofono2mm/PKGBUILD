prepare() {
	# Without it Phosh shows no modem at random: a SIM came first in GetManagedObjects
	patch -d oFono2MM -Np1 -i "$srcdir/0001-Only-list-modems-in-GetManagedObjects.patch"
	# Without it the second SIM slot is missing after boot (oFono registers it later)
	patch -d oFono2MM -Np1 -i "$srcdir/0002-Export-modems-that-oFono-adds-later.patch"
	# Without a network the call barring query held back every SIM request of the slot for
	# 5 minutes (eSIM management included), and oFono2MM missed SIM changes meanwhile
	patch -d oFono2MM -Np1 -i "$srcdir/0003-Don-t-query-the-supplementary-service-interfaces.patch"
	# After boot the eSIM slot's modem stayed "disabled" instead of "sim-missing"
	patch -d oFono2MM -Np1 -i "$srcdir/0004-Update-the-modem-state-for-interfaces-added-later.patch"
	# A PUK-blocked SIM was reported as "PIN required" (no way to enter the PUK), and the SIM PIN
	# lock always showed as off (no way to turn the PIN off or change it)
	patch -d oFono2MM -Np1 -i "$srcdir/0005-Report-the-lock-oFono-names-and-the-enabled-PIN-lock.patch"
	# At boot a modem added while the first ones were exported got the same index; exporting its
	# SIM again raised and ModemManager1 never came up (GNOME Settings waited 25 s at start)
	patch -d oFono2MM -Np1 -i "$srcdir/0006-Export-each-modem-once-with-an-index-of-its-own.patch"
	# At boot oFono powers the modems up while they are being exported; that change was lost and
	# an empty SIM slot stayed "disabled" instead of "sim-missing" (GNOME Settings showed SIM options)
	patch -d oFono2MM -Np1 -i "$srcdir/0007-Read-the-modem-s-properties-again-once-changes-arrive.patch"
	# At boot ModemAdded came before the reply to GetModems: no one requested ModemManager1,
	# systemd stopped it after 45 s and geoclue hung in its start (90 s) waiting for it
	patch -d oFono2MM -Np1 -i "$srcdir/0008-Request-the-bus-name-once-any-modem-is-exported.patch"
	# A SIM inserted into an empty slot left the modem offline: NetworkManager does not enable
	# a modem that leaves "failed" (sim-missing), mobile data hung in "prepare"
	patch -d oFono2MM -Np1 -i "$srcdir/0009-Enable-the-modem-once-a-SIM-is-inserted.patch"
	# At boot oFono read the SIM while ofono2mm was reading the SimManager: the change was lost,
	# the modem stayed "sim-missing" with a working SIM (no mobile data, no calls)
	patch -d oFono2MM -Np1 -i "$srcdir/0010-Subscribe-to-an-interface-s-changes-before-reading-i.patch"
	# CallWaitingQuery returned nothing: GNOME Calls got a signature error and showed the call
	# waiting state as unknown
	patch -d oFono2MM -Np1 -i "$srcdir/0011-Answer-CallWaitingQuery-and-CallWaitingSetup-through.patch"
	# Warnings over cell broadcast (EU-Alert/DE-Alert) reached oFono but no one showed them:
	# Phosh and cellbroadcastd read them from ModemManager's CellBroadcast interface
	patch -d oFono2MM -Np1 -i "$srcdir/0012-Add-the-CellBroadcast-interface-on-top-of-oFono-s-Ce.patch"
	# Hanging up reported "Operation failed" for every call that ended (MediaTek RIL): GNOME Calls
	# logged an error, and a car hanging up through PipeWire waited for an answer
	patch -d oFono2MM -Np1 -i "$srcdir/0013-Don-t-report-a-failed-hangup-for-a-call-that-ends.patch"
	# dbus-next sent InterfacesAdded from the modem's path: NetworkManager missed every modem
	# exported after ModemManager1 appeared (after a restart: no mobile data until reboot).
	# Now each modem reaches a client once and complete: ModemManager1 comes once all modems
	# are exported, a later modem in one signal (a second InterfacesAdded left NetworkManager on
	# stale proxies, the modem "failed"). EAGAIN on the bus socket no longer ends ofono2mm
	patch -d oFono2MM -Np1 -i "$srcdir/0014-Announce-each-modem-once-when-it-is-complete.patch"
	# In flight mode an emergency number could not be dialed (docs/NOTRUF.md)
	patch -d oFono2MM -Np1 -i "$srcdir/0015-Switch-the-radio-on-for-an-emergency-call.patch"
	# The wrong call was removed when one ended, and removing one that was over could end the
	# emergency call dialed after it (docs/NOTRUF.md)
	patch -d oFono2MM -Np1 -i "$srcdir/0016-Keep-track-of-which-call-ended.patch"
	# oFono never picked a data SIM with an eSIM chip without a profile in the phone: on a new
	# system mobile data hung in "prepare"
	patch -d oFono2MM -Np1 -i "$srcdir/0017-Select-a-data-SIM-if-oFono-has-none.patch"
	# ofono2mm never asked polkit: every local user, even "nobody", could read and send SMS,
	# dial, read the location or enter the SIM PUK. Now each call needs the action ModemManager
	# asks for; emergency calls never wait for polkit
	patch -d oFono2MM -Np1 -i "$srcdir/0018-Ask-polkit-before-every-ModemManager-call-that-needs-it.patch"
	# After a restart of ofono2mm the empty second slot became Modem/0, Chatty sent SMS there and
	# they vanished as "sent": the index is the slot's, and Create fails without a MessageManager
	patch -d oFono2MM -Np1 -i "$srcdir/0019-Give-each-modem-the-index-of-its-slot-and-refuse-SMS-without-MessageManager.patch"
	# One failing call in the polkit queue of 0018 left the calls behind it unanswered
	patch -d oFono2MM -Np1 -i "$srcdir/0020-Answer-every-queued-call-when-one-of-them-fails.patch"
	# 0018 let emergency requests of any uid past polkit: "nobody" could dial 112 (radio on despite
	# airplane mode) or end the user's emergency call. Now root, the active session and group radio
	patch -d oFono2MM -Np1 -i "$srcdir/0021-Emergency-calls-only-for-the-session-root-and-the-group-radio.patch"
	# Any uid could read the caller's number (call properties) and the last position (Location),
	# and GetLocation blocked the whole event loop, emergency calls included, until geoclue's fix
	patch -d oFono2MM -Np1 -i "$srcdir/0022-Keep-the-caller-s-number-and-the-location-to-those-allowed.patch"
	# After boot Phosh showed "no SIM" while the SIM had mobile data: GetManagedObjects waited for
	# an async USSD getter, a PropertiesChanged meanwhile went out first and GLib dropped it
	patch -d oFono2MM -Np1 -i "$srcdir/0023-Answer-GetManagedObjects-without-waiting-for-oFono.patch"
}

package() {
	cd oFono2MM
	install -Dm755 main.py -t "$pkgdir/usr/lib/ofono2mm"
	cp -r ofono2mm "$pkgdir/usr/lib/ofono2mm/"
	install -m644 dbus.xml ofono.xml ofono_modem.xml ofono_operator.xml ofono_context.xml \
		"$pkgdir/usr/lib/ofono2mm/"
	install -d "$pkgdir/usr/bin"
	ln -s ../lib/ofono2mm/main.py "$pkgdir/usr/bin/ofono2mm"
	install -Dm644 systemd/10-ofono2mm.conf -t "$pkgdir/usr/lib/systemd/system/ModemManager.service.d"
	install -Dm644 ../20-ofono2mm-restart.conf -t "$pkgdir/usr/lib/systemd/system/ModemManager.service.d"
	install -Dm644 ../50-ofono2mm-radio.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
	# ModemManager's bus policy lacks CellBroadcast: without it only root could list warnings
	install -Dm644 ../ofono2mm-cellbroadcast.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 ../ofono2mm.sysusers "$pkgdir/usr/lib/sysusers.d/ofono2mm.conf"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
