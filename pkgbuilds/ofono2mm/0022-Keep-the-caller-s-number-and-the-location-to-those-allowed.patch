From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Thu, 12 Nov 2026 20:12:37 +0100
Subject: [PATCH] Keep the caller's number and the location to those allowed

Any local process could read who is calling: CallAdded tells everyone the
call's path, and Properties.Get/GetAll on it needed no authorization.
Properties of call objects now need Voice, as their methods do.

The Location property held the result of the last GetLocation for
anyone to read (GetManagedObjects, GetAll). It now carries a position
only while SignalsLocation is on (Setup, Device.Control), as in
ModemManager.

GetLocation called geoclue synchronously in the event loop: until the
first fix ofono2mm answered nothing else, emergency calls included. It
now runs in a worker thread, at most 30 s.
---
 ofono2mm/authorization.py     | 10 +++++++++-
 ofono2mm/mm_modem_location.py | 27 +++++++++++++++++++--------
 2 files changed, 28 insertions(+), 9 deletions(-)

diff --git a/ofono2mm/authorization.py b/ofono2mm/authorization.py
index 66e7cee..8fe7546 100644
--- a/ofono2mm/authorization.py
+++ b/ofono2mm/authorization.py
@@ -29,7 +29,11 @@
 # Deviations from ModemManager:
 # - Properties of SMS objects (sender, text) need Messaging. ModemManager hands them to anyone
 #   who knows the object path; here the path comes from Messaging.List anyway, so a client
-#   allowed to list may read, and nobody else.
+#   allowed to list may read, and nobody else. Properties of call objects (the caller's number)
+#   need Voice in the same way: CallAdded tells every client the path.
+# - The Location property of Modem.Location only carries a position while a client allowed to
+#   (Device.Control) switched on SignalsLocation with Setup, as in ModemManager. It held the
+#   result of the last GetLocation for anyone to read (GetManagedObjects, Properties.GetAll).
 # - No interactive authorization: a background service must not raise a password dialog. The
 #   actions a session needs are allowed without one (allow_active=yes), Control and Firmware
 #   (auth_admin) stay with root.
@@ -46,6 +50,7 @@ import time
 PREFIX = 'org.freedesktop.ModemManager1.'
 MANAGER = 'org.freedesktop.ModemManager1'
 SMS_PATH_PREFIX = '/org/freedesktop/ModemManager1/SMS/'
+CALL_PATH_PREFIX = '/org/freedesktop/ModemManager1/Call/'
 
 UNAUTHORIZED = 'org.freedesktop.ModemManager1.Error.Core.Unauthorized'
 
@@ -113,6 +118,9 @@ def required_action(interface, member, path):
         # Sender and text of an SMS are as private as the list of them
         if path and path.startswith(SMS_PATH_PREFIX):
             return MESSAGING
+        # The number of a caller is as private as the calls themselves
+        if path and path.startswith(CALL_PATH_PREFIX):
+            return VOICE
         return None
 
     actions = ACTIONS.get(interface)
diff --git a/ofono2mm/mm_modem_location.py b/ofono2mm/mm_modem_location.py
index 4e9f946..87326d7 100644
--- a/ofono2mm/mm_modem_location.py
+++ b/ofono2mm/mm_modem_location.py
@@ -2,10 +2,25 @@ from dbus_next.service import ServiceInterface, method, dbus_property, signal
 from dbus_next.constants import PropertyAccess
 from dbus_next import Variant
 from datetime import datetime
+import asyncio
 import gi
 gi.require_version('Geoclue', '2.0')
 from gi.repository import Geoclue
 
+# A position takes this long at most; geoclue waits for its first fix otherwise
+LOCATION_TIMEOUT = 30
+
+
+def _locate():
+    """geoclue, synchronously: run in a worker thread, not in ofono2mm's event loop. There it
+    blocked every other request until the first fix, an emergency call included."""
+    geoclue = Geoclue.Simple.new_sync('ModemManager', Geoclue.AccuracyLevel.NEIGHBORHOOD, None)
+    location = geoclue.get_location()
+    # geoclue has issues, it returns lat and long in place of each other
+    return (location.get_property('longitude'), location.get_property('latitude'),
+            location.get_property('altitude'))
+
+
 class MMModemLocationInterface(ServiceInterface):
     def __init__(self, modem):
         super().__init__('org.freedesktop.ModemManager1.Modem.Location')
@@ -38,13 +53,8 @@ class MMModemLocationInterface(ServiceInterface):
 
     @method()
     async def GetLocation(self) -> 'a{uv}':
-        geoclue = Geoclue.Simple.new_sync('ModemManager', Geoclue.AccuracyLevel.NEIGHBORHOOD, None)
-        location = geoclue.get_location()
-
-        # geoclue has issues, it returns lat and long in place of each other
-        longitude = location.get_property('latitude')
-        latitude = location.get_property('longitude')
-        altitude = location.get_property('altitude')
+        latitude, longitude, altitude = await asyncio.wait_for(
+            asyncio.get_running_loop().run_in_executor(None, _locate), LOCATION_TIMEOUT)
         utc_time = datetime.utcnow().isoformat()
 
         self.location = {
@@ -88,7 +98,8 @@ class MMModemLocationInterface(ServiceInterface):
 
     @dbus_property(access=PropertyAccess.READ)
     def Location(self) -> 'a{uv}':
-        return self.location
+        # Only while signalled (Setup), as in ModemManager: else it is anyone's to read
+        return self.location if self.props['SignalsLocation'].value else {}
 
     @dbus_property(access=PropertyAccess.READ)
     def SuplServer(self) -> 's':
