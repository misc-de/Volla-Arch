diff --git a/ofono2mm/mm_cbm.py b/ofono2mm/mm_cbm.py
new file mode 100644
index 0000000..247c738
--- /dev/null
+++ b/ofono2mm/mm_cbm.py
@@ -0,0 +1,44 @@
+from dbus_next.service import ServiceInterface, dbus_property
+from dbus_next.constants import PropertyAccess
+from dbus_next import Variant
+
+# MMCbmState
+MM_CBM_STATE_RECEIVED = 2
+
+
+class MMCbmInterface(ServiceInterface):
+    """
+    org.freedesktop.ModemManager1.Cbm: one cell broadcast message.
+
+    oFono reports a message only once all its pages arrived, so it is always complete.
+    """
+
+    def __init__(self, text, channel, message_code=0, update=0):
+        super().__init__('org.freedesktop.ModemManager1.Cbm')
+        self.props = {
+            'State': Variant('u', MM_CBM_STATE_RECEIVED),
+            'Text': Variant('s', text),
+            'Channel': Variant('u', channel),
+            'MessageCode': Variant('u', message_code),
+            'Update': Variant('u', update),
+        }
+
+    @dbus_property(access=PropertyAccess.READ)
+    def State(self) -> 'u':
+        return self.props['State'].value
+
+    @dbus_property(access=PropertyAccess.READ)
+    def Text(self) -> 's':
+        return self.props['Text'].value
+
+    @dbus_property(access=PropertyAccess.READ)
+    def Channel(self) -> 'u':
+        return self.props['Channel'].value
+
+    @dbus_property(access=PropertyAccess.READ)
+    def MessageCode(self) -> 'u':
+        return self.props['MessageCode'].value
+
+    @dbus_property(access=PropertyAccess.READ)
+    def Update(self) -> 'u':
+        return self.props['Update'].value
