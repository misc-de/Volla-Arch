# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-nfc-lab
pkgver=0.1
pkgrel=2
pkgdesc="Look at NFC tags and cards and talk to them (nfcd): NDEF, memory, APDUs, raw frames"
arch=(any)
license=(MIT)
depends=(python python-gobject gtk4 libadwaita nfcd)
source=(nfc-lab.py
	org.plinius.NfcLab.desktop
	org.plinius.NfcLab.svg
	org.plinius.NfcLab-symbolic.svg
	LICENSE)
sha256sums=('6f6b1dccf969f4ab42ed91feaba111b0c2d745b93b20bc933ca7d3f7170fb3ec'
	'81935531751ab45abefad3f0dcf141a646ce9524e89eec35197b3f990acec70b'
	'918ba466f88955baf431a8eddff93db3ce64bdaceeead1837d4b2553130ef4a0'
	'80f49d6a60319ff95ed0291c9a8d21d9769ac7941c7827bddd9bbf539c1b8b18'
	'1f18c6c362e3c14577e914c06d551c588720f91959e6aa99a121b86863ffd076')

package() {
	install -Dm755 nfc-lab.py "$pkgdir/usr/bin/plinius-nfc-lab"
	install -Dm644 org.plinius.NfcLab.desktop -t "$pkgdir/usr/share/applications"
	install -Dm644 org.plinius.NfcLab.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
	install -Dm644 org.plinius.NfcLab-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
