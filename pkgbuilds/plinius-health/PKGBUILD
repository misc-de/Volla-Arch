# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-health
pkgver=0.2
pkgrel=3
pkgdesc="Phone self-test after boot: container, display on the GPU, audio, modem, Wi-Fi, Bluetooth"
arch=(any)
license=(MIT)
# Checks the layers an update can break (docs/PAKETIERUNG.md, "Gerätetest und Freigabe").
# Notification via org.freedesktop.Notifications using gdbus (glib2); a tap opens Settings →
# System → Self-Test (gnome-control-center-plinius), whose "Check Again" runs
# "pkexec plinius-health check" (polkit). Strings English, translated in *.po.
depends=(bash coreutils gawk grep procps-ng systemd util-linux lxc pipewire modemmanager glib2 gettext polkit)
makedepends=(gettext)
_langs=(de es fr it nl pl pt ru)
source=(plinius-health
	notify
	plinius-health.service
	plinius-health.timer
	plinius-health-notify.service
	org.plinius.health.policy
	"${_langs[@]/%/.po}"
	LICENSE)
sha256sums=('6fa0ae501cf7b7e877ef957234fce60e22dbd6e17310fc9c34c4e0f3d7178d08'
	'678117954f9ce824d65c22cb5b0282db7c8ce3e1a7bbc66bd8290361208577cb'
	'1b3a85e7e0d194a818924e9ff8887a5621a3f82f6c2e4adbd9d747a082eaea36'
	'6000275f636c382067f5f62fc9d8d44ec2ed25cdeafaf3258165591242b87e5e'
	'53387a0cf7f924e571fb6044bf94218b0e9577f5da244f187cd1bc375613f75b'
	'afaee7de3bd4a6b49f746915843e07e79173b740b56ce399fa1d233cc13bd805'
	'd7939fbfb6a7345222991db9b6d421a73f06b38e9a1bc8ed393ae0b4948616a7'
	'3ecca2a0b4e38cac9dbc531b5a50c556bcfb8c603ff13147d0746fe70dac445f'
	'313815af3b7402d200386ef69b71b395126e83acbeaa008bbb3dd15339feda56'
