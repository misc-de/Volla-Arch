build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 plinius-health -t "$pkgdir/usr/bin"
	install -Dm755 notify -t "$pkgdir/usr/lib/plinius-health"
	install -Dm644 plinius-health.service plinius-health.timer -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 plinius-health-notify.service -t "$pkgdir/usr/lib/systemd/user"
	install -Dm644 org.plinius.health.policy -t "$pkgdir/usr/share/polkit-1/actions"
	# A self-test that has to be switched on would be missing exactly when it is needed
	install -d "$pkgdir/usr/lib/systemd/system/timers.target.wants" \
		"$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
	ln -s ../plinius-health.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/"
	ln -s ../plinius-health-notify.service \
		"$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-health.mo"
	done
}
