+		}
 		g_free(vcard);
 	}
 
-	DBG("collected %d contacts", count);
+	DBG("collected %d contacts of %d address books", count,
+							data->n_books);
 
-	data->count += count;
-	g_slist_free_full(contacts, (GDestroyNotify) g_object_unref);
+	data->count = count;
 
 done:
-	if (data->queued_calls == 0) {
-		GString *buf = data->buf;
-		data->buf = NULL;
+	g_slist_free(contacts);
+
+	buf = data->buf;
+	data->buf = NULL;
 
-		data->contacts_cb(buf->str, buf->len, data->count, 0, TRUE,
+	data->contacts_cb(buf->str, buf->len, data->count, 0, TRUE,
 							      data->user_data);
-		g_string_free(buf, TRUE);
-	}
+	g_string_free(buf, TRUE);
 
 	return;
 
 canceled:
+	g_slist_free(contacts);
 	if (data->queued_calls == 0)
 		free_query_context(data);
 }
@@ -426,12 +643,8 @@ int phonebook_pull_read(void *request)
 
 	DBG("retrieving all contacts");
 
