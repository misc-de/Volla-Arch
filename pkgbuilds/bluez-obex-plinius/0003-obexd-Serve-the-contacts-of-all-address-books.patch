From 2f837011bbbae87e6c6b3469b8209706be22fa6a Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Tue, 10 Nov 2026 16:29:38 +0100
Subject: [PATCH] obexd: Serve the contacts of all address books

The ebook phone book only read the default address book. With a CardDAV
account the contacts are spread over several books (a Nextcloud has
"Contacts" and e.g. "FamilyContacts"), and the car showed only the
contacts of one of them.

Read every enabled address book, the default one first and the others
in a fixed order, so that offsets and handles stay the same between
requests. The id of a cached entry names its address book, so that a
single vCard is read from the book it came from. Entries with only a
display name now get a name in the vCard listing too, as in the pull.

Contacts without a phone number are left out: the car cannot call them,
and the "Accounts" book of a Nextcloud (its users) would only add names.
---
 obexd/plugins/phonebook-ebook.c | 423 ++++++++++++++++++++++++--------
 1 file changed, 327 insertions(+), 96 deletions(-)

diff --git a/obexd/plugins/phonebook-ebook.c b/obexd/plugins/phonebook-ebook.c
index b3f1fa4d9..e3d7cab86 100644
--- a/obexd/plugins/phonebook-ebook.c
+++ b/obexd/plugins/phonebook-ebook.c
@@ -48,9 +48,17 @@
 #define PB_FORMAT_VCARD30	1
 #define PB_FORMAT_NONE		2
 
+/*
+ * The car gets the contacts of every enabled address book, not only of the
+ * default one: with a CardDAV account the contacts are often spread over
+ * several books (e.g. "Contacts" and "FamilyContacts" of a Nextcloud).
+ * An entry id is "<source uid>/<contact uid>", so that a single vCard can be
+ * read from the book it came from even if two books use the same UID.
+ */
+#define ID_SEPARATOR '/'
+
 ESourceRegistry *registry;
-ESource *address_book;
-EBookClient *book_client;
+static GHashTable *book_clients;	/* source uid -> EBookClient */
 
 struct query_context {
 	const struct apparam_field *params;
@@ -59,6 +67,9 @@ struct query_context {
 	phonebook_cache_ready_cb ready_cb;
 	gchar *query;
 	unsigned int count;
+	GSList **results;	/* contacts per address book */
+	char **book_uids;	/* source uid per address book */
+	unsigned int n_books;
 	GString *buf;
 	char *uid;
 	unsigned queued_calls;
@@ -99,8 +110,21 @@ static const char *attribute_mask[] = {
 		NULL
 };
 
+struct book_call {
+	struct query_context *data;
+	unsigned int index;
+};
+
 static void free_query_context(struct query_context *data)
 {
+	unsigned int i;
+
+	for (i = 0; data->results && i < data->n_books; i++)
+		g_slist_free_full(data->results[i],
+					(GDestroyNotify) g_object_unref);
+	g_free(data->results);
+	g_strfreev(data->book_uids);
+
 	g_free(data->uid);
 
 	if (data->buf != NULL)
@@ -112,6 +136,203 @@ static void free_query_context(struct query_context *data)
 	g_free(data);
 }
 
+static gint compare_books(gconstpointer a, gconstpointer b,
+							gpointer user_data)
+{
+	ESource *sa = E_SOURCE((gpointer) a), *sb = E_SOURCE((gpointer) b);
+	const char *def = user_data;
+	const char *ua = e_source_get_uid(sa), *ub = e_source_get_uid(sb);
+
+	/* The default address book first, the others in a fixed order */
+	if (g_strcmp0(ua, def) == 0)
+		return -1;
+	if (g_strcmp0(ub, def) == 0)
+		return 1;
+
+	return g_strcmp0(ua, ub);
+}
+
+/*
+ * Connect to every enabled address book (once, the clients are kept) and
+ * remember their source uids in data. Returns the clients, default first.
+ */
+static GPtrArray *connect_books(struct query_context *data)
+{
+	GList *sources, *l;
+	ESource *def;
+	char *def_uid = NULL;
+	GPtrArray *clients, *uids;
+	unsigned int i;
+
+	def = e_source_registry_ref_default_address_book(registry);
+	if (def) {
+		def_uid = g_strdup(e_source_get_uid(def));
+		g_object_unref(def);
+	}
+
+	sources = e_source_registry_list_enabled(registry,
+					E_SOURCE_EXTENSION_ADDRESS_BOOK);
+	sources = g_list_sort_with_data(sources, compare_books, def_uid);
+
+	clients = g_ptr_array_new_with_free_func(g_object_unref);
+	uids = g_ptr_array_new();
+
+	for (l = sources; l; l = g_list_next(l)) {
+		ESource *source = l->data;
+		const char *uid = e_source_get_uid(source);
+		EClient *client = g_hash_table_lookup(book_clients, uid);
+		GError *gerr = NULL;
+
+		if (client == NULL) {
+			client = e_book_client_connect_sync(source,
+					CONNECTION_TIMEOUT, NULL, &gerr);
+			if (client == NULL) {
+				error("Cannot connect to address book %s: %s",
+					uid, gerr ? gerr->message : "NULL");
+				g_clear_error(&gerr);
+				continue;
+			}
+			g_hash_table_insert(book_clients, g_strdup(uid),
+								client);
+		}
+
+		DBG("address book %s (%s)", uid,
+					e_source_get_display_name(source));
+		g_ptr_array_add(clients, g_object_ref(client));
+		g_ptr_array_add(uids, g_strdup(uid));
+	}
+
+	g_list_free_full(sources, g_object_unref);
+	g_free(def_uid);
+
+	/* A request asks again: forget what the last call collected */
+	for (i = 0; data->results && i < data->n_books; i++)
+		g_slist_free_full(data->results[i],
+					(GDestroyNotify) g_object_unref);
+	g_free(data->results);
+	g_strfreev(data->book_uids);
+
+	data->n_books = clients->len;
+	data->results = g_new0(GSList *, clients->len);
+	g_ptr_array_add(uids, NULL);
+	data->book_uids = (char **) g_ptr_array_free(uids, FALSE);
+
+	return clients;
+}
+
+/* Ask every address book for the contacts of data->query */
+static int query_books(struct query_context *data, GAsyncReadyCallback cb)
+{
+	GPtrArray *clients = connect_books(data);
+	unsigned int i;
+
+	for (i = 0; i < clients->len; i++) {
+		struct book_call *call = g_new0(struct book_call, 1);
+
+		call->data = data;
+		call->index = i;
+		e_book_client_get_contacts(clients->pdata[i], data->query,
+							NULL, cb, call);
+		data->queued_calls++;
+	}
+
+	g_ptr_array_unref(clients);
+
+	return data->queued_calls ? 0 : -ENOENT;
+}
+
+/* Whether a contact has a phone number that is not just blanks */
+static gboolean has_number(EContact *contact)
+{
+	GList *a, *v;
+
+	for (a = e_vcard_get_attributes(E_VCARD(contact)); a;
+							a = g_list_next(a)) {
+		EVCardAttribute *attrib = a->data;
+
+		if (!attrib || g_ascii_strcasecmp(
+				e_vcard_attribute_get_name(attrib), EVC_TEL))
+			continue;
+
+		for (v = e_vcard_attribute_get_values(attrib); v;
+							v = g_list_next(v)) {
+			const char *value = v->data;
+
+			while (value && g_ascii_isspace(*value))
+				value++;
+			if (value && *value)
+				return TRUE;
+		}
+	}
+
+	return FALSE;
+}
+
+/*
+ * The car can only call contacts with a number. Address books like the
+ * "Accounts" of a Nextcloud (its users, mostly without a number) would
+ * only fill its list with names. Pull and listing both use this, so
+ * that offsets and handles stay the same.
+ */
+static GSList *drop_contacts_without_number(GSList *contacts)
+{
+	GSList *l = contacts, *next;
+
+	while (l) {
+		next = g_slist_next(l);
+		if (!has_number(E_CONTACT(l->data))) {
+			g_object_unref(l->data);
+			contacts = g_slist_delete_link(contacts, l);
+		}
+		l = next;
+	}
+
+	return contacts;
+}
+
+/* Contacts of all address books in order, NULL while calls are queued */
+static GSList *collect_results(struct book_call *call, GObject *source,
+						GAsyncResult *result)
+{
+	struct query_context *data = call->data;
+	GSList *contacts = NULL, *all = NULL;
+	GError *gerr = NULL;
+	unsigned int i;
+
+	data->queued_calls--;
+
+	if (!e_book_client_get_contacts_finish(E_BOOK_CLIENT(source),
+					result, &contacts, &gerr)) {
+		error("Getting contacts failed: %s",
+					gerr ? gerr->message : "NULL");
+		g_clear_error(&gerr);
+	} else
+		data->results[call->index] =
+				drop_contacts_without_number(contacts);
+
+	g_free(call);
+
+	if (data->queued_calls > 0 || data->canceled)
+		return NULL;
+
+	for (i = 0; i < data->n_books; i++)
+		all = g_slist_concat(all, g_slist_copy(data->results[i]));
+
+	return all;
+}
+
+/* The address book a contact of collect_results() came from */
+static const char *book_uid_of(struct query_context *data, EContact *contact)
+{
+	unsigned int i;
+
+	for (i = 0; i < data->n_books; i++)
+		if (g_slist_find(data->results[i], contact))
+			return data->book_uids[i];
+
+	return "";
+}
