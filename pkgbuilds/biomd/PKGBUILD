prepare() {
	cd biomd
	local p
	for p in ../0*.patch; do
		git apply "$p"
	done
	install -Dm644 ../fart_enums.h "$srcdir/fart-include/fart/fart_enums.h"
	# Arch: programs go to /usr/bin, helpers to /usr/lib/biomd instead of libexec
	sed -i 's|/usr/libexec/|/usr/lib/biomd/|' data/10-biomd.conf data/biomd-session.service
	sed -i 's|^ExecStart=/usr/sbin/biomd$|ExecStart=/usr/bin/biomd|' debian/biomd.biomd.service
}

build() {
	cd biomd
	make WITH_FACE=0 PREFIX=/usr LIBDIR=/usr/lib \
		ENV_CFLAGS="$CFLAGS -I$srcdir/fart-include" ENV_LDFLAGS="$LDFLAGS"
}

_install() {
	cd "$srcdir/biomd"
	make WITH_FACE=0 PREFIX=/usr LIBDIR=/usr/lib DESTDIR="$srcdir/root" install
}

package_biomd() {
	depends=(glib2 'libgbinder>=1.1.48' sqlite openssl)
	optdepends=('python-dbus: biomdctl' 'python-gobject: biomdctl')
	_install
	cd "$srcdir/root"
	install -Dm755 usr/sbin/biomd -t "$pkgdir/usr/bin"
	install -Dm755 usr/bin/biomdctl -t "$pkgdir/usr/bin"
	install -Dm644 usr/share/dbus-1/system.d/io.FuriOS.Biomd.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 usr/include/biomd/biomd_enums.h -t "$pkgdir/usr/include/biomd"
	# As in Debian/LuneOS; the device package redirects After=lxc@android.service to the container service
	install -Dm644 "$srcdir/biomd/debian/biomd.biomd.service" "$pkgdir/usr/lib/systemd/system/biomd.service"
}

package_biomd-fprintd() {
	pkgdesc="fprintd D-Bus interface (net.reactivated.Fprint) provided by biomd"
	depends=(biomd fprintd glib2)
	_install
	cd "$srcdir/root"
	install -Dm755 usr/libexec/biomd-fprintd -t "$pkgdir/usr/lib/biomd"
	install -Dm644 usr/lib/systemd/system/fprintd.service.d/10-biomd.conf \
		-t "$pkgdir/usr/lib/systemd/system/fprintd.service.d"
}

package_biomd-pam() {
	pkgdesc="PAM module for fingerprint authentication with biomd"
	depends=(biomd pam glib2)
	_install
	install -Dm644 "$srcdir/root/usr/lib/security/pam_biomd.so" -t "$pkgdir/usr/lib/security"
}

package_biomd-session() {
	pkgdesc="biomd user-session agent: unlocks Phosh via logind after a fingerprint match"
	depends=(biomd glib2 gstreamer)
	_install
	cd "$srcdir/root"
	install -Dm755 usr/libexec/biomd-session -t "$pkgdir/usr/lib/biomd"
	install -Dm644 usr/lib/systemd/user/biomd-session.service -t "$pkgdir/usr/lib/systemd/user"
	# As in debian/biomd.links: starts with the GNOME/Phosh session
	install -d "$pkgdir/usr/lib/systemd/user/gnome-session.target.wants"
	ln -s ../biomd-session.service "$pkgdir/usr/lib/systemd/user/gnome-session.target.wants/biomd-session.service"
}
