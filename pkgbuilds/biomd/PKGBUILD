# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgbase=biomd
pkgname=(biomd biomd-fprintd biomd-pam biomd-session)
pkgver=1.4.0.20261116
pkgrel=2
pkgdesc="Biometrics daemon talking to the Android fingerprint HAL over binder (HIDL and AIDL)"
arch=(aarch64 x86_64)
url="https://github.com/FuriLabs/biomd"
license=(GPL-2.0-only)
makedepends=(git glib2 'libgbinder>=1.1.48' sqlite openssl pam gstreamer)
# FuriLabs' own project (not a fork), GPL-2.0-only per the SPDX headers and debian/copyright.
# Upstream main; pkgver = version on the FLX1 (1.4.0) + commit date. The patches from LuneOS
# (Makefile overrides, WITH_FACE=0, free-form finger names, the AIDL backend) are upstream since
# 2026-11-13, and so are the own references to the AIDL services (formerly part of 0001).
_commit=84055a18c8a5c06a7ffe319395c5380ac77d72ae
# Without face recognition (WITH_FACE=0) only biomd-session still needs fart_enums.h from
# libfart (FuriLabs face-analysis-recognition-toolkit, GPL-2.0-only); libfart is not linked.
_fart=c9a664c71927d6d1862fee40f04ea47b8fc6af61
# 0001 (ours): non-null marker of the AIDL parcelables (otherwise no enrollment); needs
# gbinder_*_start_parcelable from libgbinder 1.1.48.
# 0002 (ours): sensor location and touch reports for under-display sensors (Plinius: optical,
# Goodix), which only capture after onPointerDown/onUiReady; plinius-udfps does the UI part.
# 0003 (ours): biomd-session takes the user's display session instead of the one on VT 7
# (greetd starts Phosh on VT 1), otherwise fingerprint unlock never starts.
# 0004 (ours): escaped logind session path (session "1" is .../_31; the bare id never gets the
# LockedHint changes), and an unlock attempt when the session is already locked at start.
# 0005 (ours): wait up to 60 s for the fingerprint HAL; it is registered seconds after the
# container is up, and biomd started before that stayed without a sensor until restarted.
# 0006 (ours): a rejected finger (AIDL onAuthenticationFailed) keeps identifying instead of
# ending the operation, which left the lock screen without the sensor after one wrong finger.
# 0007 (ours): biomd-fprintd is idle right after StopIdentify/StopEnroll, not only after the
# StateChanged signal; GNOME Settings could not enroll another finger (AlreadyInUse).
# 0008 (ours): Release ends a running enrollment or verification, as in fprintd; a cancelled
# enrollment in GNOME Settings kept the touch target up until the HAL timed out.
# 0009 (ours): biomd-session forgets a stopped identification even when biomd answers that it had
# already ended; after unlocking with the PIN or a pattern the fingerprint never came back.
# 0010 (ours): no biometrics before the session was unlocked once with the PIN or pattern.
# 0011 (ours): biomd-fprintd reports 100 enrollment stages (percent) instead of a fixed 13.
source=("git+$url.git#commit=$_commit"
	"fart_enums.h::https://raw.githubusercontent.com/FuriLabs/face-analysis-recognition-toolkit/$_fart/include/fart_enums.h"
	0001-fingerprint-aidl-fix-parcelable-wire-format.patch
	0002-fingerprint-report-touches-on-an-under-display-sensor.patch
	0003-session-find-the-user-s-display-session-on-any-VT.patch
	0004-session-use-logind-s-escaped-session-path-start-when-already-locked.patch
	0005-fingerprint-wait-for-the-HAL-to-be-registered-at-start.patch
	0006-fingerprint-aidl-a-rejected-finger-keeps-identifying.patch
	0007-fprintd-idle-right-after-stopping-identification-or-enrollment.patch
	0008-fprintd-stop-what-is-running-when-the-device-is-released.patch
	0009-session-the-fingerprint-comes-back-after-unlocking-without-it.patch
	0010-session-no-fingerprint-before-the-first-PIN-unlock.patch
	0011-fprintd-stages-are-the-percent-of-the-enrollment.patch)
sha256sums=('SKIP'
	'16815e35b144f061ab4e36e5a5f36cacd36504526eebb2cdcc189b9154f784de'
