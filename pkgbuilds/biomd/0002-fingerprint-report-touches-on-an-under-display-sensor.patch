From 3100f357fc76bbe5ca5e01155b8c441a50981474 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Thu, 29 Oct 2026 17:14:41 +0100
Subject: [PATCH] fingerprint: report touches on an under-display sensor to the
 AIDL HAL

An under-display sensor has no idea where the finger is: Android's UI
draws the target, tells the HAL about a finger landing on it and lifting
off (ISession::onPointerDown/onPointerUp) and, for an optical sensor,
when the illumination is on screen (onUiReady). Without those the Goodix
optical HAL of the Volla Phone Plinius never captures an image and
enrollment ends in a timeout.

Read the sensor type and location out of getSensorProps and offer them
as the SensorType and SensorLocation properties, and forward the new
PointerDown, PointerUp and UiReady methods to the session, so a UI in
the user session can do Android's part. The backend hooks are optional;
the HIDL backend leaves them NULL.
---
 include/fingerprint_backend.h     |  63 +++++++++++++++
 include/fingerprint_binder_aidl.h |  33 ++++++++
 include/introspect.h              |  13 +++
 src/fingerprint.c                 |  50 +++++++++++-
 src/fingerprint_aidl_backend.c    |  34 +++++++-
 src/fingerprint_binder_aidl.c     | 130 +++++++++++++++++++++++++++++-
 6 files changed, 320 insertions(+), 3 deletions(-)

diff --git a/include/fingerprint_backend.h b/include/fingerprint_backend.h
index 5256615..3e7a368 100644
--- a/include/fingerprint_backend.h
+++ b/include/fingerprint_backend.h
@@ -121,6 +121,16 @@ typedef struct {
     * @param self The backend instance
     */
    void (*cleanup)(FingerprintBackend *self);
+
+   /*
+    * Optional, for sensors under the display; NULL in backends without them.
+    * See fingerprint_aidl_pointer_down() for why they exist.
+    */
+   gboolean (*get_sensor_location)(FingerprintBackend *self, gint32 *type,
+                                   gint32 *x, gint32 *y, gint32 *radius);
+   gboolean (*pointer_down)(FingerprintBackend *self, gint32 x, gint32 y);
+   gboolean (*pointer_up)(FingerprintBackend *self);
+   gboolean (*ui_ready)(FingerprintBackend *self);
 } FingerprintBackendVTable;
 
 struct _FingerprintBackend {
@@ -241,4 +251,57 @@ fingerprint_backend_cleanup(FingerprintBackend *backend)
    backend->vtable.cleanup(backend);
 }
 
+/**
+* Type and position of an under-display sensor
+* @return FALSE if the backend cannot tell
+*/
+static inline gboolean
+fingerprint_backend_get_sensor_location(FingerprintBackend *backend, gint32 *type,
+                                        gint32 *x, gint32 *y, gint32 *radius)
+{
+   g_return_val_if_fail(backend != NULL, FALSE);
+   if (!backend->vtable.get_sensor_location)
+       return FALSE;
+   return backend->vtable.get_sensor_location(backend, type, x, y, radius);
+}
+
+/**
+* A finger touched an under-display sensor at x, y
+* @return FALSE if the backend has no such sensor or the HAL refused
+*/
+static inline gboolean
+fingerprint_backend_pointer_down(FingerprintBackend *backend, gint32 x, gint32 y)
+{
+   g_return_val_if_fail(backend != NULL, FALSE);
+   if (!backend->vtable.pointer_down)
+       return FALSE;
+   return backend->vtable.pointer_down(backend, x, y);
+}
+
+/**
+* The finger left an under-display sensor
+* @return FALSE if the backend has no such sensor or the HAL refused
+*/
+static inline gboolean
+fingerprint_backend_pointer_up(FingerprintBackend *backend)
+{
+   g_return_val_if_fail(backend != NULL, FALSE);
+   if (!backend->vtable.pointer_up)
+       return FALSE;
+   return backend->vtable.pointer_up(backend);
+}
+
+/**
+* The illumination for an optical under-display sensor is on screen
+* @return FALSE if the backend has no such sensor or the HAL refused
+*/
+static inline gboolean
+fingerprint_backend_ui_ready(FingerprintBackend *backend)
+{
+   g_return_val_if_fail(backend != NULL, FALSE);
+   if (!backend->vtable.ui_ready)
+       return FALSE;
+   return backend->vtable.ui_ready(backend);
+}
+
 #endif // FINGERPRINT_BACKEND_H
diff --git a/include/fingerprint_binder_aidl.h b/include/fingerprint_binder_aidl.h
index f9f0563..a5ec2c2 100644
--- a/include/fingerprint_binder_aidl.h
+++ b/include/fingerprint_binder_aidl.h
@@ -127,6 +127,39 @@ fingerprint_aidl_cancel_operation(BiomFingerprintAidl *aidl);
 gboolean
 fingerprint_aidl_remove_fingerprint(BiomFingerprintAidl *aidl, guint32 finger_id);
 
+/**
+ * Type and position of the sensor as the HAL reports them
+ * @param aidl The AIDL instance
+ * @param type FingerprintSensorType (3 = under-display optical)
+ * @param x, y Centre on the display in pixels
+ * @param radius Radius in pixels, 0 if the HAL reports no location
+ * @return TRUE if the HAL is available
+ */
+gboolean
+fingerprint_aidl_get_sensor_location(BiomFingerprintAidl *aidl, gint32 *type,
+                                     gint32 *x, gint32 *y, gint32 *radius);
+
+/**
+ * Under-display sensors: a finger touched the sensor area at x, y
+ * @return TRUE if the HAL took it
+ */
+gboolean
+fingerprint_aidl_pointer_down(BiomFingerprintAidl *aidl, gint32 x, gint32 y);
+
+/**
+ * Under-display sensors: the finger left the sensor area
+ * @return TRUE if the HAL took it
+ */
+gboolean
+fingerprint_aidl_pointer_up(BiomFingerprintAidl *aidl);
+
+/**
+ * Optical under-display sensors: the illumination is on screen
+ * @return TRUE if the HAL took it
+ */
+gboolean
+fingerprint_aidl_ui_ready(BiomFingerprintAidl *aidl);
+
 /**
  * Clean up AIDL resources
  * @param aidl The AIDL instance to clean up
