# At every start of the phone's Halium system: confirms a new password prompt on trial (written into
# vendor_boot and init_boot once the system is up) or drops it, and starts the trial of one that
# waited for a kernel trial of older plinius-kernel versions (halium-rebuild --boot)
[Unit]
Description=Confirm or drop a new password prompt on trial (plinius-crypt)
ConditionPathExists=|/var/lib/plinius-crypt/halium/trial
ConditionPathExists=|/var/lib/plinius-crypt/halium/waiting
After=multi-user.target plinius-kernel-boot.service

[Service]
# simple, not oneshot: the script waits for the end of the start, which a oneshot unit in the start
# transaction would itself hold up
Type=simple
ExecStart=/usr/lib/plinius-crypt/halium-rebuild --boot
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
