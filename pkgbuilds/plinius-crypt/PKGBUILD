build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
		# Lookup table for the hook: English text TAB translation, one message per line
		msgcat --no-wrap "$l.po" | awk '
			function unq(s) { s = substr(s, 2, length(s) - 2); gsub(/\\"/, "\"", s); return s }
			/^msgid "/  { id = unq(substr($0, 7)) }
			/^msgstr "/ { tr = unq(substr($0, 8)); if (id != "" && tr != "") print id "\t" tr }
		' > "l10n-$l"
	done

	# shellcheck disable=SC2086
	cc $CPPFLAGS $CFLAGS -fPIC -shared -o pam_plinius_crypt.so pam_plinius_crypt.c $LDFLAGS -lpam -lcryptsetup

	# Background of the glass theme: Phosh's wallpaper (dark variant), blurred
	python3 glass-background.py /usr/share/backgrounds/gnome/blobs-d.svg glass-background.bin
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm644 hook "$pkgdir/usr/lib/initcpio/hooks/plinius-crypt"
	install -Dm644 install "$pkgdir/usr/lib/initcpio/install/plinius-crypt"
	install -Dm644 mkinitcpio.conf -t "$pkgdir/usr/share/plinius-crypt"
	install -Dm644 50-plinius.conf -t "$pkgdir/etc/unl0kr.conf.d"
	install -Dm755 plinius-encrypt -t "$pkgdir/usr/bin"
	install -Dm644 glass-background.bin -t "$pkgdir/usr/share/plinius-crypt"
	# Wallpaper and look of the keyboard for the password prompt: watcher in the session, root
	# helpers, initramfs rebuild
	install -Dm755 background-sync background-install look-install -t "$pkgdir/usr/lib/plinius-crypt"
	install -Dm644 org.plinius.crypt.background.policy -t "$pkgdir/usr/share/polkit-1/actions"
	install -Dm644 org.plinius.CryptBackground.desktop -t "$pkgdir/etc/xdg/autostart"
	# look-files: what the prompt takes from the system, for mkinitcpio and the Halium ramdisk;
	# halium-rebuild renews that part of the Halium ramdisk (configured in /var/lib/plinius-crypt/halium),
	# on the card or in vendor_boot (boot-image takes that apart and puts it together)
	install -Dm755 rebuild-initramfs look-files halium-rebuild boot-image -t "$pkgdir/usr/lib/plinius-crypt"
	# New ramdisk scripts (boot-image) go through a trial start like new programs
	install -Dm644 96-plinius-crypt-scripts.hook -t "$pkgdir/usr/share/libalpm/hooks"
	# The unlock script that scripts/halium calls in the phone's Halium ramdisk; plinius-crypt-ramdisk
	# takes it into its archive
	install -Dm644 halium-unlock -t "$pkgdir/usr/lib/plinius-crypt"
	install -Dm644 plinius-crypt-initramfs.service plinius-crypt-locale.path plinius-crypt-strength.service \
		plinius-crypt-halium.service -t "$pkgdir/usr/lib/systemd/system"
	# A new password prompt from plinius-crypt-ramdisk starts on trial; confirmed or dropped at the
	# next start (the unit runs only while there is one)
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-crypt-halium.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# Rating of a password set in the initramfs, from /run into /var/lib
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-crypt-strength.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# Rebuild the initramfs when the system language or keyboard layout changes: enabled by the
	# package (the unit itself only runs if the initramfs runs the hook)
	install -d "$pkgdir/usr/lib/systemd/system/paths.target.wants"
	ln -s ../plinius-crypt-locale.path "$pkgdir/usr/lib/systemd/system/paths.target.wants/"
	# plinius-encrypt for GNOME Settings (pkexec) and its check against the screen lock PIN
	install -Dm644 org.plinius.crypt.manage.policy -t "$pkgdir/usr/share/polkit-1/actions"
	install -Dm755 login-password-check -t "$pkgdir/usr/lib/plinius-crypt"
	# The other way round: a new PIN (passwd) must differ from the encryption password
	install -Dm755 pam_plinius_crypt.so -t "$pkgdir/usr/lib/security"
	install -Dm644 /dev/stdin "$pkgdir/usr/share/licenses/$pkgname/glass-background" <<-EOF
		usr/share/plinius-crypt/glass-background.bin is derived from blobs-d.svg of
		gnome-backgrounds (GNOME Design Team, https://gitlab.gnome.org/GNOME/gnome-backgrounds):
		cropped, blurred and darkened by glass-background.py. Licensed under CC-BY-SA-3.0,
		https://creativecommons.org/licenses/by-sa/3.0/
	EOF
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-crypt.mo"
		install -Dm644 "l10n-$l" "$pkgdir/usr/share/plinius-crypt/l10n/$l"
	done
}
