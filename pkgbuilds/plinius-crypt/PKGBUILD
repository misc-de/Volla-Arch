# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-crypt
pkgver=0.13
pkgrel=15
pkgdesc="Optional full-disk encryption for Plinius: initramfs hook with unl0kr and plinius-progress, offline in-place encryption on request"
# Native for pam_plinius_crypt.so (a new PIN must differ from the encryption password)
arch=(aarch64 x86_64)
# glass-background.bin is derived from GNOME's "blobs" wallpaper (gnome-backgrounds)
license=(MIT CC-BY-SA-3.0)
# Messages are English, translated in *.po (template plinius-crypt.pot): plinius-encrypt uses
# gettext; the initramfs has no gettext, so the hook gets a plain lookup table per language.
# xgettext takes only one text argument per keyword, so the template is extracted twice
# (title and explanation of show_message) and merged:
#   x="xgettext -L Shell --from-code=UTF-8 --package-name=plinius-crypt -k -kt -kgettext -ktr_msg -kask_pass
#      -kwith_progress -kset_hint"
#   $x -kshow_message:1 -o a.pot plinius-encrypt hook halium-unlock; $x -kshow_message:2 -o b.pot plinius-encrypt hook
#   msgcat --use-first -o plinius-crypt.pot a.pot b.pot
# python-gobject, gdk-pixbuf2, polkit: background-sync and background-install (the wallpaper as
# background of the password prompt); python, libxcrypt: login-password-check (encryption
# password differs from the screen lock PIN); polkit also for GNOME Settings (plinius-encrypt)
# buffybox 3.6.0-9: themes plinius-original and plinius-glass with an accent color
# lz4: halium-rebuild packs the prompt's part of the phone's Halium ramdisk
depends=(cryptsetup "buffybox>=3.6.0-9" "plinius-progress>=0.1-7" e2fsprogs mkinitcpio util-linux gettext
	python python-gobject gdk-pixbuf2 polkit libxcrypt pam lz4)
# The glass background is made from Phosh's wallpaper when the package is built
makedepends=(gettext gnome-backgrounds librsvg python-pillow)
_langs=(de es fr it nl pl pt ru)
# On the phone: the programs of the prompt for its Halium ramdisk, which an update brings along
depends_aarch64=(plinius-crypt-ramdisk)
# plinius-security: the strength of the encryption password for GNOME Settings
optdepends=('plinius-security: rate the encryption password for the Device Security page')
backup=(etc/unl0kr.conf.d/50-plinius.conf)
# Lists pam_plinius_crypt.so in /etc/pam.d/passwd
install=plinius-crypt.install
source=(hook install mkinitcpio.conf 50-plinius.conf plinius-encrypt glass-background.py
	background-sync background-install look-install org.plinius.crypt.background.policy
	org.plinius.CryptBackground.desktop plinius-crypt-initramfs.service
	rebuild-initramfs look-files halium-rebuild boot-image plinius-crypt-locale.path login-password-check org.plinius.crypt.manage.policy
	plinius-crypt-strength.service halium-unlock plinius-crypt-halium.service
	pam_plinius_crypt.c
	"${_langs[@]/%/.po}"
	LICENSE
	96-plinius-crypt-scripts.hook)
sha256sums=('60925324f9058721c5124f9d9ab26ca73bd61811e605815fc892ff9a71b4bca3'
