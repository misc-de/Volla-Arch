msgctxt "name"
msgid "Send to TV"
msgstr "Wyślij do telewizora"

#. Shown in the add-ons manager, at most 132 characters
msgctxt "description"
msgid "Plays YouTube videos on the TV the phone casts to: hold a video link or tap the button in the address bar."
msgstr "Odtwarza filmy z YouTube na telewizorze, do którego nadaje telefon: przytrzymaj link lub dotknij przycisku na pasku adresu."

#. Context menu entry and address bar button
msgctxt "playOnTv"
msgid "Play on TV"
msgstr "Odtwórz na telewizorze"

#. $1 is the name of the TV
msgctxt "playOn"
msgid "Play on “$1”"
msgstr "Odtwórz na „$1”"

#. Context menu entry, greyed out
msgctxt "notConnected"
msgid "Play on TV – no TV connected"
msgstr "Odtwórz na telewizorze – brak połączonego telewizora"

#. $1 is the name of the TV
msgctxt "noLinks"
msgid "“$1” cannot play links"
msgstr "„$1” nie może odtwarzać linków"

#. Notification; $1 is the name of the TV
msgctxt "playing"
msgid "Playing on “$1”."
msgstr "Odtwarzanie na „$1”."

#. Notification; $1 is the name of the TV
msgctxt "starting"
msgid "Starting on “$1”…"
msgstr "Uruchamianie na „$1”…"

#. Notification; $1 is the name of the TV. Cast is the quick setting of Phosh, named as there
msgctxt "code"
msgid "“$1” shows a code: enter it in the Cast quick setting."
msgstr "„$1” wyświetla kod: wpisz go w szybkim ustawieniu Przesyłaj."

#. Notification. Cast is the quick setting of Phosh, named as there
msgctxt "noTv"
msgid "No TV is connected. Connect one in the Cast quick setting first."
msgstr "Nie połączono telewizora. Najpierw połącz go w szybkim ustawieniu Przesyłaj."

#. Notification
msgctxt "notAVideo"
msgid "This is not a link to a YouTube video."
msgstr "To nie jest link do filmu w YouTube."

#. Notification; $1 is the reason Schwupp gives
msgctxt "failed"
msgid "The TV could not play it: $1"
msgstr "Telewizor nie mógł tego odtworzyć: $1"

#. Reason when Schwupp gives none
msgctxt "unknownError"
msgid "unknown error"
msgstr "nieznany błąd"

#. Notification
msgctxt "noHost"
msgid "Send to TV cannot reach Schwupp: the package plinius-send-to-tv is missing."
msgstr "„Wyślij do telewizora” nie może połączyć się ze Schwupp: brak pakietu plinius-send-to-tv."

#. Stands for the TV's name when Schwupp has none
msgctxt "theTv"
msgid "TV"
msgstr "Telewizor"
