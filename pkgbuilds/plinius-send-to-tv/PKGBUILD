check() {
	python3 make-xpi.py --check . "send-to-tv-$_xpiver.xpi"
}

package() {
	install -Dm755 send-to-tv-host -t "$pkgdir/usr/lib/plinius-send-to-tv"
	install -Dm644 de.cais.send_to_tv.json -t "$pkgdir/usr/lib/mozilla/native-messaging-hosts"
	# Firefox finds system add-ons by their ID as file name
	install -Dm644 "send-to-tv-$_xpiver.xpi" \
		"$pkgdir/usr/lib/firefox/browser/extensions/send-to-tv@de.cais.xpi"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
