# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-send-to-tv
pkgver=0.1
pkgrel=1
_xpiver=0.1.0
pkgdesc="Firefox: play YouTube links on the TV that Schwupp casts to (context menu, address bar)"
arch=(any)
license=(MIT)
# The add-on (send-to-tv@de.cais) hands the link to send-to-tv-host over native messaging, the
# host to Schwupp (PlayLink on the active device); the TV plays the video in its YouTube app.
# Firefox release only loads add-ons signed by Mozilla: send-to-tv-$_xpiver.xpi is the copy AMO
# signed (unlisted) from what make-xpi.py builds out of the sources here. check() makes sure it
# holds exactly these sources. A change to the add-on: raise _xpiver and "version" in
# manifest.json, build with make-xpi.py, have it signed, put the signed copy here.
# mobile-config-firefox installs and enables it for every profile (policies.json, from the path
# below). Firefox is optional, as there.
depends=(schwupp python python-gobject)
optdepends=('firefox: the browser it extends')
source=(send-to-tv-host
	de.cais.send_to_tv.json
	make-xpi.py
	manifest.json
	background.js
	send-to-tv.svg
	send-to-tv.pot
	de.po es.po fr.po it.po nl.po pl.po pt.po ru.po
	"send-to-tv-$_xpiver.xpi"
	LICENSE)
noextract=("send-to-tv-$_xpiver.xpi")
sha256sums=('a1b9b7a85f4d5d8cdf6e0fff3f768366c4f41d661c5a66905a85f67767112448'
	'6fa7d8816abfb2e73634803b00784190e8eb08b08cf9330f4514dbfd242530ca'
