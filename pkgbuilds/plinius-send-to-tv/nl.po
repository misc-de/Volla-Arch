msgctxt "name"
msgid "Send to TV"
msgstr "Naar tv sturen"

#. Shown in the add-ons manager, at most 132 characters
msgctxt "description"
msgid "Plays YouTube videos on the TV the phone casts to: hold a video link or tap the button in the address bar."
msgstr "Speelt YouTube-video’s af op de tv waarnaar de telefoon cast: houd een videolink ingedrukt of tik op de knop in de adresbalk."

#. Context menu entry and address bar button
msgctxt "playOnTv"
msgid "Play on TV"
msgstr "Afspelen op tv"

#. $1 is the name of the TV
msgctxt "playOn"
msgid "Play on “$1”"
msgstr "Afspelen op ‘$1’"

#. Context menu entry, greyed out
msgctxt "notConnected"
msgid "Play on TV – no TV connected"
msgstr "Afspelen op tv – geen tv verbonden"

#. $1 is the name of the TV
msgctxt "noLinks"
msgid "“$1” cannot play links"
msgstr "‘$1’ kan geen links afspelen"

#. Notification; $1 is the name of the TV
msgctxt "playing"
msgid "Playing on “$1”."
msgstr "Speelt af op ‘$1’."

#. Notification; $1 is the name of the TV
msgctxt "starting"
msgid "Starting on “$1”…"
msgstr "Starten op ‘$1’…"

#. Notification; $1 is the name of the TV. Cast is the quick setting of Phosh, named as there
msgctxt "code"
msgid "“$1” shows a code: enter it in the Cast quick setting."
msgstr "‘$1’ toont een code: voer die in bij de snelinstelling Casten."

#. Notification. Cast is the quick setting of Phosh, named as there
msgctxt "noTv"
msgid "No TV is connected. Connect one in the Cast quick setting first."
msgstr "Er is geen tv verbonden. Verbind er eerst een via de snelinstelling Casten."

#. Notification
msgctxt "notAVideo"
msgid "This is not a link to a YouTube video."
msgstr "Dit is geen link naar een YouTube-video."

#. Notification; $1 is the reason Schwupp gives
msgctxt "failed"
msgid "The TV could not play it: $1"
msgstr "De tv kon het niet afspelen: $1"

#. Reason when Schwupp gives none
msgctxt "unknownError"
msgid "unknown error"
msgstr "onbekende fout"

#. Notification
msgctxt "noHost"
msgid "Send to TV cannot reach Schwupp: the package plinius-send-to-tv is missing."
msgstr "‘Naar tv sturen’ kan Schwupp niet bereiken: het pakket plinius-send-to-tv ontbreekt."

#. Stands for the TV's name when Schwupp has none
msgctxt "theTv"
msgid "TV"
msgstr "Tv"
