msgctxt "name"
msgid "Send to TV"
msgstr "Envoyer au téléviseur"

#. Shown in the add-ons manager, at most 132 characters
msgctxt "description"
msgid "Plays YouTube videos on the TV the phone casts to: hold a video link or tap the button in the address bar."
msgstr "Lit les vidéos YouTube sur le téléviseur où diffuse le téléphone : appui long sur un lien ou bouton de la barre d’adresse."

#. Context menu entry and address bar button
msgctxt "playOnTv"
msgid "Play on TV"
msgstr "Lire sur le téléviseur"

#. $1 is the name of the TV
msgctxt "playOn"
msgid "Play on “$1”"
msgstr "Lire sur « $1 »"

#. Context menu entry, greyed out
msgctxt "notConnected"
msgid "Play on TV – no TV connected"
msgstr "Lire sur le téléviseur – aucun téléviseur connecté"

#. $1 is the name of the TV
msgctxt "noLinks"
msgid "“$1” cannot play links"
msgstr "« $1 » ne peut pas lire de liens"

#. Notification; $1 is the name of the TV
msgctxt "playing"
msgid "Playing on “$1”."
msgstr "Lecture sur « $1 »."

#. Notification; $1 is the name of the TV
msgctxt "starting"
msgid "Starting on “$1”…"
msgstr "Démarrage sur « $1 »…"

#. Notification; $1 is the name of the TV. Cast is the quick setting of Phosh, named as there
msgctxt "code"
msgid "“$1” shows a code: enter it in the Cast quick setting."
msgstr "« $1 » affiche un code : saisissez-le dans le réglage rapide Diffuser."

#. Notification. Cast is the quick setting of Phosh, named as there
msgctxt "noTv"
msgid "No TV is connected. Connect one in the Cast quick setting first."
msgstr "Aucun téléviseur n’est connecté. Connectez-en d’abord un dans le réglage rapide Diffuser."

#. Notification
msgctxt "notAVideo"
msgid "This is not a link to a YouTube video."
msgstr "Ce n’est pas un lien vers une vidéo YouTube."

#. Notification; $1 is the reason Schwupp gives
msgctxt "failed"
msgid "The TV could not play it: $1"
msgstr "Le téléviseur n’a pas pu le lire : $1"

#. Reason when Schwupp gives none
msgctxt "unknownError"
msgid "unknown error"
msgstr "erreur inconnue"

#. Notification
msgctxt "noHost"
msgid "Send to TV cannot reach Schwupp: the package plinius-send-to-tv is missing."
msgstr "« Envoyer au téléviseur » ne peut pas joindre Schwupp : le paquet plinius-send-to-tv est absent."

#. Stands for the TV's name when Schwupp has none
msgctxt "theTv"
msgid "TV"
msgstr "Téléviseur"
