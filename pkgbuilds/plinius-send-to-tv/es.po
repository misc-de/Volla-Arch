msgctxt "name"
msgid "Send to TV"
msgstr "Enviar al televisor"

#. Shown in the add-ons manager, at most 132 characters
msgctxt "description"
msgid "Plays YouTube videos on the TV the phone casts to: hold a video link or tap the button in the address bar."
msgstr "Reproduce vídeos de YouTube en el televisor al que transmite el teléfono: mantén pulsado un enlace o toca el botón de la barra."

#. Context menu entry and address bar button
msgctxt "playOnTv"
msgid "Play on TV"
msgstr "Reproducir en el televisor"

#. $1 is the name of the TV
msgctxt "playOn"
msgid "Play on “$1”"
msgstr "Reproducir en «$1»"

#. Context menu entry, greyed out
msgctxt "notConnected"
msgid "Play on TV – no TV connected"
msgstr "Reproducir en el televisor – ningún televisor conectado"

#. $1 is the name of the TV
msgctxt "noLinks"
msgid "“$1” cannot play links"
msgstr "«$1» no puede reproducir enlaces"

#. Notification; $1 is the name of the TV
msgctxt "playing"
msgid "Playing on “$1”."
msgstr "Reproduciendo en «$1»."

#. Notification; $1 is the name of the TV
msgctxt "starting"
msgid "Starting on “$1”…"
msgstr "Iniciando en «$1»…"

#. Notification; $1 is the name of the TV. Cast is the quick setting of Phosh, named as there
msgctxt "code"
msgid "“$1” shows a code: enter it in the Cast quick setting."
msgstr "«$1» muestra un código: introdúcelo en el ajuste rápido Transmitir."

#. Notification. Cast is the quick setting of Phosh, named as there
msgctxt "noTv"
msgid "No TV is connected. Connect one in the Cast quick setting first."
msgstr "No hay ningún televisor conectado. Conecta uno primero en el ajuste rápido Transmitir."

#. Notification
msgctxt "notAVideo"
msgid "This is not a link to a YouTube video."
msgstr "Esto no es un enlace a un vídeo de YouTube."

#. Notification; $1 is the reason Schwupp gives
msgctxt "failed"
msgid "The TV could not play it: $1"
msgstr "El televisor no pudo reproducirlo: $1"

#. Reason when Schwupp gives none
msgctxt "unknownError"
msgid "unknown error"
msgstr "error desconocido"

#. Notification
msgctxt "noHost"
msgid "Send to TV cannot reach Schwupp: the package plinius-send-to-tv is missing."
msgstr "«Enviar al televisor» no puede comunicarse con Schwupp: falta el paquete plinius-send-to-tv."

#. Stands for the TV's name when Schwupp has none
msgctxt "theTv"
msgid "TV"
msgstr "Televisor"
