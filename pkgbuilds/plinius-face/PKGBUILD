prepare() {
	# The landmarker bundle is a zip; plinius-face only needs its landmark model
	bsdtar -xf face_landmarker.task face_landmarks_detector.tflite
}

build() {
	local camera=() libs=() flags=(-std=gnu11 -Wall -Wextra -Wno-unused-parameter)
	if [[ $CARCH == aarch64 ]]; then
		camera=(-DFACE_WITH_CAMERA face-camera.c)
		libs=(-lcamera-hybris -lEGL -lGLESv2 -lpthread)
	fi
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS "${flags[@]}" \
		-o plinius-face-probe plinius-face-probe.c face-pipeline.c "${camera[@]}" \
		$(pkg-config --cflags --libs plinius-tflite) "${libs[@]}" -lm $LDFLAGS
	# The service needs the camera
	[[ $CARCH == aarch64 ]] || return 0
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS "${flags[@]}" \
		-o plinius-faced plinius-faced.c face-pipeline.c face-camera.c \
		$(pkg-config --cflags --libs plinius-tflite gio-unix-2.0) "${libs[@]}" -lm $LDFLAGS
}

package() {
	install -Dm755 plinius-face-probe -t "$pkgdir/usr/bin"
	install -Dm644 face_detection_yunet_2023mar_float32.tflite face_landmarks_detector.tflite \
		face_recognition_sface_2021dec_float32.tflite -t "$pkgdir/usr/share/plinius-face"
	install -Dm644 LICENSE mediapipe-LICENSE yunet-LICENSE sface-LICENSE \
		-t "$pkgdir/usr/share/licenses/$pkgname"
	[[ $CARCH == aarch64 ]] || return 0
	install -Dm755 plinius-faced -t "$pkgdir/usr/bin"
	# From boot (watches the lock screen when face unlock is on, else ends after two idle
	# minutes) and on demand through D-Bus (GNOME Settings)
	install -Dm644 plinius-faced.service -t "$pkgdir/usr/lib/systemd/system"
	# Device units for mali0 and apusys, which the service waits for
	install -Dm644 71-plinius-face.rules -t "$pkgdir/usr/lib/udev/rules.d"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-faced.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	install -Dm644 org.plinius.Face.service -t "$pkgdir/usr/share/dbus-1/system-services"
	install -Dm644 org.plinius.Face.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	# Enrolling and switching face unlock on ask for the user's PIN
	install -Dm644 org.plinius.face.policy -t "$pkgdir/usr/share/polkit-1/actions"
}
