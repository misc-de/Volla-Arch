# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-face
pkgver=0.3
pkgrel=11
pkgdesc="Face recognition for unlocking the Plinius, on its NPU (YuNet, Face Mesh, SFace)"
arch=(aarch64 x86_64)  # x86_64 only the probe without the camera, for tests with saved frames
license=(MIT Apache-2.0)  # own code and YuNet MIT; Face Mesh (MediaPipe) and SFace Apache-2.0
depends=(glibc plinius-tflite)
depends_aarch64=(libhybris libglvnd glib2 polkit)
# Models: MediaPipe's face landmarker v2 as published (TFLite); YuNet and SFace from OpenCV Zoo
# are only published as ONNX: tools/face-models.sh converts them (reproducibly) next to this
# file, SFace is too large for the repository.
_mediapipe=https://storage.googleapis.com/mediapipe-models
_zoo=https://raw.githubusercontent.com/opencv/opencv_zoo/48b10fa505aeb51fbd127fc60a5c660040e823b7/models
source=(face-pipeline.h
	face-pipeline.c
	face-camera.h
	face-camera.c
	plinius-face-probe.c
	plinius-faced.c
	plinius-faced.service
	71-plinius-face.rules
	org.plinius.Face.service
	org.plinius.Face.conf
	org.plinius.face.policy
	LICENSE
	"$_mediapipe/face_landmarker/face_landmarker/float16/1/face_landmarker.task"
	face_detection_yunet_2023mar_float32.tflite
	face_recognition_sface_2021dec_float32.tflite
	"mediapipe-LICENSE::https://raw.githubusercontent.com/google-ai-edge/mediapipe/v0.10.35/LICENSE"
	"yunet-LICENSE::$_zoo/face_detection_yunet/LICENSE"
	"sface-LICENSE::$_zoo/face_recognition_sface/LICENSE")
noextract=(face_landmarker.task)
