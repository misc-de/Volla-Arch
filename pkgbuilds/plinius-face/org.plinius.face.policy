<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- plinius-face: enrolling a face, switching face unlock on or making it less strict needs the
     user's own PIN, so that nobody holding the unlocked phone can add their face or loosen the
     check. Kept for a few minutes, so enrolling and switching on ask only once. -->
<policyconfig>
  <vendor>Plinius</vendor>
  <action id="org.plinius.face.enroll">
    <description>Set up face unlock or make it less strict</description>
    <message>Authentication is required to set up face unlock or make it less strict</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
