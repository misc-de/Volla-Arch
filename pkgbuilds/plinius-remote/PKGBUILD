# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-remote
pkgver=0.7
pkgrel=1
pkgdesc="Use the phone as Bluetooth touchpad and keyboard for a computer, tablet or TV (HID over GATT), or for its own desktop on a TV"
arch=(any)
license=(MIT)
depends=(python python-gobject gtk4 libadwaita bluez python-evdev gtk4-layer-shell)
source=(plinius-remote.py
	org.plinius.Remote.desktop
	org.plinius.Remote.svg
	org.plinius.Remote-symbolic.svg
	LICENSE
	70-plinius-remote-uinput.rules)
sha256sums=('e70710d494d7e2b750936081672a7d820f61e99efac9c60e4b736edb1d00d433'
	'e3d4354bfb1a8994406eb82f3ecf70b6c6fb6468054106a4444f3dc5a824d2c7'
	'1d2404cb0bac5da02b1e6c51577d78a7c543f162e6939ce824d2ccb15cacd320'
	'dad335939cf64898e4c8fa3035445862363ff53194c06780c5a2188f0033d2c2'
	'1f18c6c362e3c14577e914c06d551c588720f91959e6aa99a121b86863ffd076'
	'8c02a178ccb4323b41ead78f214b79821c889d08f062e618eb0952758f38de3d')

package() {
	install -Dm755 plinius-remote.py "$pkgdir/usr/bin/plinius-remote"
	install -Dm644 org.plinius.Remote.desktop -t "$pkgdir/usr/share/applications"
	install -Dm644 org.plinius.Remote.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
	install -Dm644 org.plinius.Remote-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	# --desktop: the virtual mouse and keyboard (uinput) for the user at the phone
	install -Dm644 70-plinius-remote-uinput.rules -t "$pkgdir/usr/lib/udev/rules.d"
}
