--- a/src/pos-style-manager.c
+++ b/src/pos-style-manager.c
@@ -15,10 +15,34 @@
 
 #include <gtk/gtk.h>
 #include <gdesktop-enums.h>
+#include <glib/gstdio.h>
+
+#include <stdio.h>
+#include <string.h>
 
 #define IF_KEY_ACCENT_COLOR     "accent-color"
+#define IF_KEY_COLOR_SCHEME     "color-scheme"
 #define IF_SCHEMA_NAME          "org.gnome.desktop.interface"
 
+/* Plinius: a custom accent color from GNOME Settings (gnome-control-center-plinius) */
+#define PLINIUS_SCHEMA_NAME     "org.plinius.appearance"
+#define PLINIUS_KEY_ACCENT_COLOR "accent-color"
+
+/* Plinius: the wallpaper behind the glass keys */
+#define BG_SCHEMA_NAME          "org.gnome.desktop.background"
+#define BG_KEY_PICTURE_URI      "picture-uri"
+#define BG_KEY_PICTURE_URI_DARK "picture-uri-dark"
+#define BG_KEY_PICTURE_OPTIONS  "picture-options"
+/* The whole screen is shrunk to this width, scaled up again it is blurred like the
+ * background of the password prompt at startup */
+#define GLASS_BLUR_WIDTH        54
+/* Part of the screen's height at the bottom that the keyboard covers */
+#define GLASS_KEYBOARD_PART     0.4
+/* Width of the stored image; scaled up in steps of two, one big step leaves edges */
+#define GLASS_IMAGE_WIDTH       216
+/* Portrait aspect ratio (width / height) if there is no monitor yet */
+#define GLASS_DEFAULT_ASPECT    (9.0 / 20.0)
+
 /* Accent colors from gnome-shell src/st/st-theme-context.c */
 #define ACCENT_COLOR_BLUE       "#3584e4"
 #define ACCENT_COLOR_TEAL       "#2190a4"
@@ -54,14 +78,42 @@ struct _PosStyleManager {
   GtkCssProvider *accent_css_provider;
 
   GSettings      *interface_settings;
+  GSettings      *plinius_settings;
+
+  /* Plinius: the blurred wallpaper as background of the glass keyboard */
+  GSettings      *background_settings;
+  GtkCssProvider *glass_css_provider;
+  GCancellable   *glass_cancel;
+  char           *glass_file;
+  guint           glass_serial;
 };
 G_DEFINE_TYPE (PosStyleManager, pos_style_manager, G_TYPE_OBJECT)
 
 
+/* The custom accent color, if one is set as "#rrggbb" */
+static char *
+get_custom_accent_color (PosStyleManager *self)
+{
+  g_autofree char *value = NULL;
+  unsigned int r, g, b;
+  int end = 0;
+
+  if (!self->plinius_settings)
+    return NULL;
+
+  value = g_settings_get_string (self->plinius_settings, PLINIUS_KEY_ACCENT_COLOR);
+  if (sscanf (value, "#%2x%2x%2x%n", &r, &g, &b, &end) != 3 || value[end] != '\0')
+    return NULL;
+
+  return g_steal_pointer (&value);
+}
+
+
 static void
 on_accent_color_changed (PosStyleManager *self)
 {
   const char *color;
+  g_autofree char *custom = NULL;
   g_autofree char *css  = NULL;
   g_autoptr (GtkCssProvider) provider = gtk_css_provider_new ();
 
@@ -74,6 +126,13 @@ on_accent_color_changed (PosStyleManager *self)
   if (g_strcmp0 (self->theme_name, "Adwaita") != 0)
     return;
 
+  /* Plinius: the custom color wins; GNOME's key then holds the color nearest to it */
+  custom = get_custom_accent_color (self);
+  if (custom) {
+    color = custom;
+    goto out;
+  }
+
   switch (g_settings_get_enum (self->interface_settings, IF_KEY_ACCENT_COLOR)) {
   case G_DESKTOP_ACCENT_COLOR_TEAL:
     color = ACCENT_COLOR_TEAL;
@@ -104,6 +163,7 @@ on_accent_color_changed (PosStyleManager *self)
     color = ACCENT_COLOR_BLUE;
   }
 
+ out:
   g_debug ("Setting accent bg color to %s, accent fg color to %s",
            color, ACCENT_COLOR_FOREGROUND);
 
@@ -114,7 +174,283 @@ on_accent_color_changed (PosStyleManager *self)
   gtk_style_context_add_provider_for_screen (gdk_screen_get_default (),
                                              GTK_STYLE_PROVIDER (provider),
                                              GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 1);
-  g_set_object (&self->css_provider, provider);
+  /* Plinius: upstream stored it in css_provider, so a change of the color stacked providers */
+  g_set_object (&self->accent_css_provider, provider);
+}
+
+
+/* Plinius: first picture of a GNOME slideshow (XML), or NULL */
+static char *
+get_slideshow_first (const char *path)
+{
+  g_autofree char *contents = NULL;
+  const char *start, *end, *file;
+  g_autofree char *node = NULL;
+  const char *last;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return NULL;
+
+  /* The <file> of the first <static> part, else the first <file> at all */
+  start = strstr (contents, "<static>");
+  file = strstr (start ?: contents, "<file>");
+  if (!file)
+    return NULL;
+  file += strlen ("<file>");
+  end = strstr (file, "</file>");
+  if (!end)
+    return NULL;
+  node = g_strndup (file, end - file);
+
+  /* Either a path, or several <size> elements with one path each: take the largest (last) */
+  last = g_strrstr (node, "</size>");
+  if (last) {
+    const char *begin = g_strrstr_len (node, last - node, ">");
+
+    if (!begin)
+      return NULL;
+    return g_strstrip (g_strndup (begin + 1, last - begin - 1));
+  }
+
+  return g_strstrip (g_strdup (node));
+}
+
+
+/* Plinius: path of the wallpaper Phosh shows (the dark variant with a dark color scheme),
+ * or NULL if there is none */
+static char *
+get_wallpaper_path (PosStyleManager *self)
+{
+  g_autofree char *uri = NULL;
+  g_autofree char *path = NULL;
+  g_autoptr (GFile) file = NULL;
+  gboolean dark;
+
+  if (g_settings_get_enum (self->background_settings, BG_KEY_PICTURE_OPTIONS) ==
+      G_DESKTOP_BACKGROUND_STYLE_NONE)
+    return NULL;
+
+  dark = g_settings_get_enum (self->interface_settings, IF_KEY_COLOR_SCHEME) ==
+    G_DESKTOP_COLOR_SCHEME_PREFER_DARK;
+  uri = g_settings_get_string (self->background_settings,
+                               dark ? BG_KEY_PICTURE_URI_DARK : BG_KEY_PICTURE_URI);
+  if (!uri || !*uri) {
+    g_free (uri);
+    uri = g_settings_get_string (self->background_settings, BG_KEY_PICTURE_URI);
+  }
+  if (!uri || !*uri)
+    return NULL;
+
+  file = strstr (uri, "://") ? g_file_new_for_uri (uri) : g_file_new_for_path (uri);
+  path = g_file_get_path (file);
+  if (path && g_str_has_suffix (path, ".xml"))
+    return get_slideshow_first (path);
+
+  return g_steal_pointer (&path);
+}
+
+
+typedef struct {
+  char   *wallpaper;
+  char   *target;
+  double  aspect;
+} GlassJob;
+
+
+static void
+glass_job_free (GlassJob *job)
+{
+  g_free (job->wallpaper);
+  g_free (job->target);
+  g_free (job);
+}
+
+
+/* Plinius: renders the bottom part of the wallpaper small and blurred into a PNG (in a thread,
+ * decoding a large picture takes a while) */
+static void
+render_glass_background (GTask        *task,
+                         gpointer      source_object,
+                         gpointer      task_data,
+                         GCancellable *cancellable)
+{
+  GlassJob *job = task_data;
+  g_autoptr (GdkPixbuf) pixbuf = NULL;
+  g_autoptr (GdkPixbuf) cropped = NULL;
+  g_autoptr (GdkPixbuf) tiny = NULL;
+  g_autoptr (GdkPixbuf) part = NULL;
+  g_autoptr (GdkPixbuf) image = NULL;
+  GError *error = NULL;
+  int w, h, cw, ch, tw, th, ph;
+
+  pixbuf = gdk_pixbuf_new_from_file (job->wallpaper, &error);
+  if (!pixbuf) {
+    g_task_return_error (task, error);
+    return;
+  }
+
+  /* Centre crop to the screen's aspect ratio, as Phosh's "zoom" */
+  w = gdk_pixbuf_get_width (pixbuf);
+  h = gdk_pixbuf_get_height (pixbuf);
+  if (w > h * job->aspect) {
+    cw = MAX (1, (int)(h * job->aspect));
+    ch = h;
+  } else {
+    cw = w;
+    ch = MAX (1, (int)(w / job->aspect));
+  }
+  cropped = gdk_pixbuf_new_subpixbuf (pixbuf, (w - cw) / 2, (h - ch) / 2, cw, ch);
+
+  /* Shrink the whole screen, then keep the part the keyboard covers */
+  tw = GLASS_BLUR_WIDTH;
+  th = MAX (2, (int)(GLASS_BLUR_WIDTH / job->aspect));
+  tiny = gdk_pixbuf_scale_simple (cropped, tw, th, GDK_INTERP_HYPER);
+  ph = MAX (1, (int)(th * GLASS_KEYBOARD_PART));
+  part = gdk_pixbuf_new_subpixbuf (tiny, 0, th - ph, tw, ph);
+
+  /* Up in steps of two, bilinear: smooth like a blur */
+  image = g_object_ref (part);
+  while (gdk_pixbuf_get_width (image) < GLASS_IMAGE_WIDTH) {
+    GdkPixbuf *larger = gdk_pixbuf_scale_simple (image,
+                                                 gdk_pixbuf_get_width (image) * 2,
+                                                 gdk_pixbuf_get_height (image) * 2,
+                                                 GDK_INTERP_BILINEAR);
+    g_object_unref (image);
+    image = larger;
+  }
+
+  if (g_task_return_error_if_cancelled (task))
+    return;
+
+  if (!gdk_pixbuf_save (image, job->target, "png", &error, NULL)) {
+    g_task_return_error (task, error);
+    return;
+  }
+
+  g_task_return_boolean (task, TRUE);
+}
+
+
+/* Plinius: background of the keyboard surface; file NULL for the plain color */
+static void
+set_glass_background (PosStyleManager *self, const char *file)
+{
+  g_autoptr (GtkCssProvider) provider = gtk_css_provider_new ();
+  g_autofree char *uri = NULL;
+  g_autofree char *css = NULL;
+
+  if (self->glass_css_provider) {
+    gtk_style_context_remove_provider_for_screen (gdk_screen_get_default (),
+                                                  GTK_STYLE_PROVIDER (self->glass_css_provider));
+    g_clear_object (&self->glass_css_provider);
+  }
+
+  /* The previous picture is no longer referenced */
+  if (self->glass_file && g_strcmp0 (self->glass_file, file) != 0)
+    g_unlink (self->glass_file);
+  g_free (self->glass_file);
+  self->glass_file = g_strdup (file);
+
+  if (!file)
+    return;
+
+  uri = g_filename_to_uri (file, NULL, NULL);
+  if (!uri)
+    return;
+
+  /* Darkened as the panel of the password prompt: the background there is darkened to 85 %
+   * and the panel adds 25 % black */
+  css = g_strdup_printf ("pos-input-surface {\n"
+                         "  background-color: @pos_bg_color;\n"
+                         "  background-image: linear-gradient(alpha(black, 0.36), alpha(black, 0.36)),"
+                         " url(\"%s\");\n"
+                         "  background-size: auto, cover;\n"
+                         "  background-position: center, center;\n"
+                         "  background-repeat: no-repeat;\n"
+                         "}\n",
+                         uri);
+  gtk_css_provider_load_from_data (provider, css, -1, NULL);
+  gtk_style_context_add_provider_for_screen (gdk_screen_get_default (),
+                                             GTK_STYLE_PROVIDER (provider),
+                                             GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 1);
+  g_set_object (&self->glass_css_provider, provider);
+}
+
+
+static void
+on_glass_background_rendered (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  PosStyleManager *self = POS_STYLE_MANAGER (source_object);
+  GlassJob *job = g_task_get_task_data (G_TASK (res));
+  g_autoptr (GError) err = NULL;
+  gboolean success;
+
+  success = g_task_propagate_boolean (G_TASK (res), &err);
+
+  /* A newer wallpaper is on its way (or the manager is gone) */
+  if (g_cancellable_is_cancelled (g_task_get_cancellable (G_TASK (res)))) {
+    g_unlink (job->target);
+    return;
+  }
+
+  if (!success) {
+    g_warning ("Could not render the wallpaper %s: %s", job->wallpaper, err->message);
+    g_unlink (job->target);
+    set_glass_background (self, NULL);
+    return;
+  }
+
+  set_glass_background (self, job->target);
+}
+
+
+/* Plinius: (re)render the background of the glass keyboard from the current wallpaper */
+static void
+on_wallpaper_changed (PosStyleManager *self)
+{
+  g_autoptr (GTask) task = NULL;
+  g_autofree char *wallpaper = NULL;
+  g_autofree char *dir = NULL;
+  g_autofree char *name = NULL;
+  GdkDisplay *display = gdk_display_get_default ();
+  GdkMonitor *monitor = display ? gdk_display_get_monitor (display, 0) : NULL;
+  GlassJob *job;
+
+  g_cancellable_cancel (self->glass_cancel);
+  g_clear_object (&self->glass_cancel);
+
+  /* High contrast keeps its plain keyboard */
+  wallpaper = pos_style_manager_is_high_contrast (self) ? NULL : get_wallpaper_path (self);
+  if (!wallpaper) {
+    set_glass_background (self, NULL);
+    return;
+  }
+
+  dir = g_build_filename (g_get_user_runtime_dir (), "stevia", NULL);
+  if (g_mkdir_with_parents (dir, 0700) != 0) {
+    g_warning ("Could not create %s", dir);
+    set_glass_background (self, NULL);
+    return;
+  }
+
+  job = g_new0 (GlassJob, 1);
+  job->wallpaper = g_steal_pointer (&wallpaper);
+  /* A new name for every picture: GTK's style may still use the previous one */
+  name = g_strdup_printf ("glass-background-%u.png", ++self->glass_serial);
+  job->target = g_build_filename (dir, name, NULL);
+  job->aspect = GLASS_DEFAULT_ASPECT;
+  if (monitor) {
+    GdkRectangle geometry;
+
+    gdk_monitor_get_geometry (monitor, &geometry);
+    if (geometry.width > 0 && geometry.height > 0)
+      job->aspect = (double)MIN (geometry.width, geometry.height) / MAX (geometry.width, geometry.height);
+  }
+
+  self->glass_cancel = g_cancellable_new ();
+  task = g_task_new (self, self->glass_cancel, on_glass_background_rendered, NULL);
+  g_task_set_task_data (task, job, (GDestroyNotify) glass_job_free);
+  g_task_run_in_thread (task, render_glass_background);
 }
 
 
@@ -148,6 +484,9 @@ on_gtk_theme_name_changed (PosStyleManager *self, GParamSpec *pspec, GtkSettings
 
   /* Refresh accent color */
   on_accent_color_changed (self);
+  /* Plinius: high contrast has no wallpaper behind the keys */
+  if (self->background_settings)
+    on_wallpaper_changed (self);
 
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_THEME_NAME]);
 }
@@ -182,6 +521,15 @@ pos_style_manager_dispose (GObject *object)
   g_clear_object (&self->accent_css_provider);
 
   g_clear_object (&self->interface_settings);
+  g_clear_object (&self->plinius_settings);
+
+  g_cancellable_cancel (self->glass_cancel);
+  g_clear_object (&self->glass_cancel);
+  g_clear_object (&self->background_settings);
+  g_clear_object (&self->glass_css_provider);
+  if (self->glass_file)
+    g_unlink (self->glass_file);
+  g_clear_pointer (&self->glass_file, g_free);
 
   G_OBJECT_CLASS (pos_style_manager_parent_class)->dispose (object);
 }
@@ -208,6 +556,7 @@ static void
 pos_style_manager_init (PosStyleManager *self)
 {
   GtkSettings *gtk_settings = gtk_settings_get_default ();
+  g_autoptr (GSettingsSchema) schema = NULL;
 
   g_object_set (G_OBJECT (gtk_settings), "gtk-application-prefer-dark-theme", TRUE, NULL);
 
@@ -217,6 +566,28 @@ pos_style_manager_init (PosStyleManager *self)
                             "changed::" IF_KEY_ACCENT_COLOR,
                             G_CALLBACK (on_accent_color_changed),
                             self);
+
+  /* Plinius: the schema comes with phosh-plinius, without it GNOME's colors only */
+  schema = g_settings_schema_source_lookup (g_settings_schema_source_get_default (),
+                                            PLINIUS_SCHEMA_NAME, TRUE);
+  if (schema) {
+    self->plinius_settings = g_settings_new (PLINIUS_SCHEMA_NAME);
+    g_signal_connect_swapped (self->plinius_settings,
+                              "changed::" PLINIUS_KEY_ACCENT_COLOR,
+                              G_CALLBACK (on_accent_color_changed),
+                              self);
+  }
+
+  /* Plinius: the wallpaper behind the glass keys follows Phosh's */
+  self->background_settings = g_settings_new (BG_SCHEMA_NAME);
+  g_signal_connect_swapped (self->background_settings,
+                            "changed",
+                            G_CALLBACK (on_wallpaper_changed),
+                            self);
+  g_signal_connect_swapped (self->interface_settings,
+                            "changed::" IF_KEY_COLOR_SCHEME,
+                            G_CALLBACK (on_wallpaper_changed),
+                            self);
   g_signal_connect_swapped (gtk_settings,
                             "notify::gtk-theme-name",
                             G_CALLBACK (on_gtk_theme_name_changed),
diff --git a/src/stylesheet/adwaita-dark.css b/src/stylesheet/adwaita-dark.css
index a7717bb..2f39c82 100644
--- a/src/stylesheet/adwaita-dark.css
+++ b/src/stylesheet/adwaita-dark.css
@@ -8,3 +8,6 @@
 pos-key {
   box-shadow:0 1px 1px 0 rgba(0,0,0,0.2);
 }
+
