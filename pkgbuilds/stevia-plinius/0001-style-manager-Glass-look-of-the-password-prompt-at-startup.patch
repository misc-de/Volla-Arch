diff --git a/src/stylesheet/plinius-glass.css b/src/stylesheet/plinius-glass.css
new file mode 100644
index 0000000..a4891e4
--- /dev/null
+++ b/src/stylesheet/plinius-glass.css
@@ -0,0 +1,131 @@
+/*
+ * Plinius: the glass look of the password prompt at startup (unl0kr's theme
+ * plinius-glass) - white glass keys with thin translucent borders, darker glass for
+ * the other keys, the accent color while pressed, over the blurred wallpaper that
+ * PosStyleManager sets as background of pos-input-surface.
+ *
+ * Loaded after common.css, so these rules win.
+ */
+
+@define-color pos_bg_color #16141f;
+@define-color pos_glass_key alpha(white, 0.2);
+@define-color pos_glass_sys alpha(black, 0.2);
+@define-color pos_glass_border alpha(white, 0.3);
+@define-color pos_glass_pressed alpha(@theme_selected_bg_color, 0.85);
+@define-color pos_glass_popup #2b2838;
+@define-color pos_glass_popup_border #4a4558;
+
+/* The wallpaper (if any) lies on the surface, the keyboard shows it through */
+pos-osk-widget,
+pos-completion-bar,
+pos-shortcuts-bar,
+pos-keypad,
+pos-emoji-picker {
+  background: transparent;
+}
+
+/* Keys: less space beside each other than above, which makes them wider */
+pos-key {
+  color: white;
+  background: @pos_glass_key;
+  border: 1px solid @pos_glass_border;
+  border-radius: 5px;
+  margin: 2px 1px;
+  box-shadow: none;
+  font-weight: normal;
+}
+
+pos-key:disabled {
+  color: alpha(white, 0.5);
+}
+
+pos-key.sys,
+pos-key.toggle,
+pos-key.return {
+  color: white;
+  background: @pos_glass_sys;
+}
+
+pos-key.pressed,
+pos-key.sys.pressed,
+pos-key.toggle.pressed,
+pos-key.return.pressed {
+  color: white;
+  background: @pos_glass_pressed;
+  border-color: @pos_glass_pressed;
+}
+
+/* Popups over the keys: the dropdown list of the password prompt */
+pos-char-popup,
+pos-indicator-popup {
+  color: white;
+  background: @pos_glass_popup;
+  border: 1px solid @pos_glass_popup_border;
+}
+
+pos-char-popup button {
+  color: white;
+  background: none;
+}
+
+pos-char-popup button:hover {
+  background: alpha(white, 0.1);
+}
+
+pos-char-popup button:active {
+  background: @pos_glass_pressed;
+}
+
+pos-indicator-popup label {
+  font-weight: normal;
+}
+
+/* Bars above the keys */
+pos-completion-bar button {
+  color: white;
+  font-weight: normal;
+}
+
+pos-completion-bar button:active,
+pos-shortcuts-bar button:active,
+pos-emoji-picker button.action:active {
+  background: @pos_glass_pressed;
+}
+
+pos-shortcuts-bar button,
+pos-shortcuts-bar button:hover,
+pos-emoji-picker button.action {
+  color: white;
+  background: @pos_glass_sys;
+  border: 1px solid @pos_glass_border;
+  border-radius: 5px;
+}
+
+pos-shortcuts-bar button.toggle:checked {
+  background: @pos_glass_pressed;
+  border-color: @pos_glass_pressed;
+}
+
+/* Keypad (PIN and number fields) */
+pos-keypad button {
+  color: white;
+  background: @pos_glass_key;
+  border: 1px solid @pos_glass_border;
+  border-radius: 5px;
+  margin: 2px 1px;
+  box-shadow: none;
+}
+
+pos-keypad button.sys,
+pos-keypad button.return {
+  color: white;
+  background: @pos_glass_sys;
+}
+
+pos-keypad button:active,
+pos-keypad button.sys:active,
+pos-keypad button.return:active {
+  color: white;
+  background: @pos_glass_pressed;
+  border-color: @pos_glass_pressed;
+}
