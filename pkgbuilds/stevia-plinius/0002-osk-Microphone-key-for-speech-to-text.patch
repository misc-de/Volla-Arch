--- a/src/pos-osk-widget.c
+++ b/src/pos-osk-widget.c
@@ -158,6 +158,10 @@ struct _PosOskWidget {
 
   PosIndicatorPopup   *indicator_popup;
 
+  /* Speech to text: the microphone key is shown and/or on */
+  gboolean             dictation;
+  gboolean             dictation_active;
+
   /* Cursor movement */
   GtkGesture          *cursor_drag;
   double               last_x, last_y;
@@ -519,6 +523,89 @@ add_common_keys_pre (PosOskWidget      *self,
 }
 
 
+/* Width of the microphone key while it is shown */
+#define DICTATION_KEY_WIDTH 1.0
+
+static gboolean
+is_dictation_key (PosOskKey *key)
+{
+  return pos_osk_key_get_use (key) == POS_OSK_KEY_USE_ACTION &&
+    g_strcmp0 (pos_osk_key_get_action_name (key), "dictate") == 0;
+}
+
+/*
+ * The microphone key for speech to text goes left of the space key in the bottom row.
+ * It is always part of the layout so that switching dictation on and off does not need
+ * a new layout: while off it has a width of 0 and the space key gets its room
+ * (see apply_dictation()). Rows without an expanding space key get none.
+ */
+static void
+add_dictation_key (PosOskWidgetRow *row, gint rownum, guint max_rows)
+{
+  PosOskKey *key;
+
+  if (rownum != max_rows - 1)
+    return;
+
+  for (guint k = 0; k < row->keys->len; k++) {
+    PosOskKey *space = g_ptr_array_index (row->keys, k);
+
+    if (!pos_osk_key_get_expand (space))
+      continue;
+
+    key = g_object_new (POS_TYPE_OSK_KEY,
+                        "use", POS_OSK_KEY_USE_ACTION,
+                        "action-name", "dictate",
+                        "icon", "audio-input-microphone-symbolic",
+                        "width", DICTATION_KEY_WIDTH,
+                        "style", "sys",
+                        NULL);
+    row->width += pos_osk_key_get_width (key);
+    g_ptr_array_insert (row->keys, k, key);
+    return;
+  }
+}
+
+
+/* Show or hide the microphone key: its width moves to or from the space key */
+static void
+apply_dictation (PosOskWidget *self)
+{
+  for (int l = 0; l <= POS_OSK_WIDGET_LAST_LAYER; l++) {
+    PosOskWidgetKeyboardLayer *layer = pos_osk_widget_get_keyboard_layer (self, l);
+    PosOskWidgetRow *row;
+    PosOskKey *mic = NULL, *space = NULL;
+    double width;
+
+    if (layer->n_rows == 0)
+      continue;
+
+    row = pos_osk_widget_get_layer_row (self, l, layer->n_rows - 1);
+    if (row->keys == NULL)
+      continue;
+
+    for (guint k = 0; k < row->keys->len; k++) {
