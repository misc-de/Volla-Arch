+  /* Speech to text through plinius-dictated (org.plinius.Dictate1) */
+  GSettings                  *dictate_settings;  /* NULL without plinius-dictate */
+  GDBusConnection            *session_bus;
+  guint                       dictate_text_id;
+  guint                       dictate_state_id;
+  GCancellable               *dictate_cancel;
+  gboolean                    dictate_shown;     /* microphone key visible */
+  gboolean                    dictating;         /* microphone on (or being switched on) */
+  gboolean                    dictate_accept;    /* text may still go to the focused field */
 };
 
 
