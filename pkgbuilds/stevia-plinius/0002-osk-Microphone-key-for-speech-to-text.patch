 src/pos-input-surface.c | 258 ++++++++++++++++++++++++++++++++++++++++++++++++
 src/pos-osk-key.c       |  56 ++++++++++-
 src/pos-osk-key.h       |   2 +
 src/pos-osk-widget.c    | 172 ++++++++++++++++++++++++++++++++
 src/pos-osk-widget.h    |   2 +
 6 files changed, 490 insertions(+), 3 deletions(-)

