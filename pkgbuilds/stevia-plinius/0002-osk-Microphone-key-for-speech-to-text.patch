 }
 
 
+/* ---- speech to text ------------------------------------------------------------------ */
+
+#define DICTATE_BUS_NAME "org.plinius.Dictate1"
+#define DICTATE_PATH "/org/plinius/Dictate1"
+#define DICTATE_IFACE "org.plinius.Dictate1"
+#define DICTATE_SCHEMA "org.plinius.dictate"
+/* zwp_text_input_v3 content hints (PosInputMethodHint lists them as plain values) */
+#define CONTENT_HINT_HIDDEN_TEXT 0x40
+#define CONTENT_HINT_SENSITIVE_DATA 0x80
+
+static void
+set_dictation_active (PosInputSurface *self, gboolean active)
+{
+  for (guint i = 0; i < self->osks->len; i++)
+    pos_osk_widget_set_dictation_active (g_ptr_array_index (self->osks, i), active);
+}
+
+
+static void
+on_dictate_stop_done (GObject *source, GAsyncResult *res, gpointer data)
+{
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+
+  ret = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (ret == NULL && !g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_debug ("Stopping dictation failed: %s", err->message);
+}
+
+
+static void
+dictate_stop (PosInputSurface *self)
+{
+  if (!self->dictating)
+    return;
+
+  self->dictating = FALSE;
+  g_cancellable_cancel (self->dictate_cancel);
+  g_clear_object (&self->dictate_cancel);
+  set_dictation_active (self, FALSE);
+  /* Text of the last utterance may still follow; it goes to the same field */
+  g_dbus_connection_call (self->session_bus, DICTATE_BUS_NAME, DICTATE_PATH, DICTATE_IFACE,
+                          "Stop", NULL, NULL, G_DBUS_CALL_FLAGS_NO_AUTO_START, -1,
+                          NULL, on_dictate_stop_done, NULL);
+}
+
+
+static void
+on_dictate_start_done (GObject *source, GAsyncResult *res, gpointer data)
+{
+  PosInputSurface *self;
+  g_autoptr (GVariant) ret = NULL;
+  g_autoptr (GError) err = NULL;
+
+  ret = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (ret != NULL)
+    return;
+  if (g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  self = POS_INPUT_SURFACE (data);
+  g_warning ("Starting dictation failed: %s", err->message);
+  self->dictating = FALSE;
+  self->dictate_accept = FALSE;
+  set_dictation_active (self, FALSE);
+}
+
+
+static void
+dictate_start (PosInputSurface *self)
+{
+  if (self->dictating || self->session_bus == NULL)
+    return;
+
+  self->dictating = TRUE;
+  self->dictate_accept = TRUE;
+  /* Light the key at once; the service confirms with StateChanged or the call fails */
+  set_dictation_active (self, TRUE);
+  g_clear_object (&self->dictate_cancel);
+  self->dictate_cancel = g_cancellable_new ();
+  /* The first start activates the service; it loads the model while the user speaks */
+  g_dbus_connection_call (self->session_bus, DICTATE_BUS_NAME, DICTATE_PATH, DICTATE_IFACE,
+                          "Start", NULL, NULL, G_DBUS_CALL_FLAGS_NONE, 30000,
+                          self->dictate_cancel, on_dictate_start_done, self);
+}
+
+
+static void
+dictate_activated (GSimpleAction *action, GVariant *parameter, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  if (self->dictating)
+    dictate_stop (self);
+  else if (self->dictate_shown)
+    dictate_start (self);
+}
+
+
+/* Recognized text: commit it to the focused field, with a space to the previous word */
+static void
+on_dictate_text (GDBusConnection *bus, const char *sender, const char *path, const char *iface,
+                 const char *signal, GVariant *params, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+  g_autofree char *before = NULL;
+  g_autofree char *text = NULL;
+  const char *recognized;
+  const char *surrounding;
+  guint anchor, cursor;
+  gboolean space = FALSE;
+
+  if (!g_variant_is_of_type (params, G_VARIANT_TYPE ("(s)")))
+    return;
+  g_variant_get (params, "(&s)", &recognized);
+
+  /* The field lost focus since dictation started: drop the text */
+  if (!self->dictate_accept || !pos_input_method_get_active (self->input_method))
+    return;
+
+  pos_input_surface_submit_current_preedit (self);
+
+  surrounding = pos_input_method_get_surrounding_text (self->input_method, &anchor, &cursor);
+  if (surrounding != NULL && cursor > 0) {
+    before = g_strndup (surrounding, cursor);
+    space = !g_unichar_isspace (g_utf8_get_char (g_utf8_prev_char (before + strlen (before))));
+  }
+  /* No space before punctuation the model put at the start */
+  if (g_unichar_ispunct (g_utf8_get_char (recognized)))
+    space = FALSE;
+
+  text = g_strconcat (space ? " " : "", recognized, NULL);
+  g_debug ("Dictated: '%s'", text);
+  pos_input_method_send_string (self->input_method, text, TRUE);
+}
+
+
+static void
+on_dictate_state (GDBusConnection *bus, const char *sender, const char *path, const char *iface,
+                  const char *signal, GVariant *params, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+  const char *state;
+
+  if (!g_variant_is_of_type (params, G_VARIANT_TYPE ("(s)")))
+    return;
+  g_variant_get (params, "(&s)", &state);
+
+  /* The service stopped by itself (long silence, microphone gone) */
+  if (g_strcmp0 (state, "listening") != 0 && self->dictating) {
+    self->dictating = FALSE;
+    set_dictation_active (self, FALSE);
+  }
+}
+
+
+/* Microphone key only where speech makes sense: not in passwords, PINs, numbers, terminals */
+static gboolean
+dictation_allowed (PosInputSurface *self)
+{
+  PosInputMethodPurpose purpose;
+  guint hint;
+
+  if (self->dictate_settings == NULL || self->session_bus == NULL ||
+      !g_settings_get_boolean (self->dictate_settings, "enabled"))
+    return FALSE;
+
+  purpose = pos_input_method_get_purpose (self->input_method);
+  if (purpose != POS_INPUT_METHOD_PURPOSE_NORMAL &&
+      purpose != POS_INPUT_METHOD_PURPOSE_ALPHA &&
+      purpose != POS_INPUT_METHOD_PURPOSE_NAME)
+    return FALSE;
+
+  hint = pos_input_method_get_hint (self->input_method);
+  return !(hint & (CONTENT_HINT_HIDDEN_TEXT | CONTENT_HINT_SENSITIVE_DATA));
+}
+
+
+static void
+update_dictation (PosInputSurface *self)
+{
+  self->dictate_shown = dictation_allowed (self);
+
+  for (guint i = 0; i < self->osks->len; i++)
+    pos_osk_widget_set_dictation (g_ptr_array_index (self->osks, i), self->dictate_shown);
+
+  if (!self->dictate_shown)
+    dictate_stop (self);
+}
+
+
+static void
+setup_dictation (PosInputSurface *self)
+{
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = NULL;
+  g_autoptr (GError) err = NULL;
+
+  /* Optional: only with plinius-dictate installed */
+  if (source)
+    schema = g_settings_schema_source_lookup (source, DICTATE_SCHEMA, TRUE);
+  if (schema == NULL)
+    return;
+
+  self->session_bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &err);
+  if (self->session_bus == NULL) {
+    g_warning ("No session bus for dictation: %s", err->message);
+    return;
+  }
+
+  self->dictate_settings = g_settings_new (DICTATE_SCHEMA);
+  g_signal_connect_swapped (self->dictate_settings, "changed::enabled",
+                            G_CALLBACK (update_dictation), self);
+  /* The service sends its signals to the caller only */
+  self->dictate_text_id =
+    g_dbus_connection_signal_subscribe (self->session_bus, DICTATE_BUS_NAME, DICTATE_IFACE,
+                                        "Text", DICTATE_PATH, NULL, G_DBUS_SIGNAL_FLAGS_NONE,
+                                        on_dictate_text, self, NULL);
+  self->dictate_state_id =
+    g_dbus_connection_signal_subscribe (self->session_bus, DICTATE_BUS_NAME, DICTATE_IFACE,
+                                        "StateChanged", DICTATE_PATH, NULL,
+                                        G_DBUS_SIGNAL_FLAGS_NONE, on_dictate_state, self, NULL);
+}
+
+
 static void
 on_im_active_changed (PosInputSurface *self, GParamSpec *pspec, PosInputMethod *im)
 {
@@ -1578,6 +1816,14 @@ on_im_active_changed (PosInputSurface *self, GParamSpec *pspec, PosInputMethod *
   active = pos_input_method_get_active (im);
   g_debug ("IM active: %d", active);
 
+  if (active) {
+    /* Purpose and hints of the new field may equal the old ones (no notify) */
+    update_dictation (self);
+  } else {
+    dictate_stop (self);
+    self->dictate_accept = FALSE;
+  }
+
   if (active) {
     /* TODO: Reset buffered commit_string, delete_surrounding_text */
     if (pos_input_surface_is_completer_active (self))
@@ -1676,6 +1922,14 @@ pos_input_surface_finalize (GObject *object)
   g_clear_object (&self->input_settings);
   g_clear_object (&self->osk_settings);
   g_clear_object (&self->xkbinfo);
+  if (self->session_bus) {
+    g_dbus_connection_signal_unsubscribe (self->session_bus, self->dictate_text_id);
+    g_dbus_connection_signal_unsubscribe (self->session_bus, self->dictate_state_id);
+  }
+  g_cancellable_cancel (self->dictate_cancel);
+  g_clear_object (&self->dictate_cancel);
+  g_clear_object (&self->dictate_settings);
+  g_clear_object (&self->session_bus);
   g_clear_object (&self->clipboard_manager);
   g_clear_object (&self->completer);
   pos_input_surface_set_completer_manager (self, NULL);
@@ -2064,6 +2318,8 @@ insert_osk (PosInputSurface   *self,
                           (GDestroyNotify)pos_completion_info_free);
 
   g_debug ("Adding osk for layout '%s'", name);
+  pos_osk_widget_set_dictation (osk_widget, self->dictate_shown);
+  pos_osk_widget_set_dictation_active (osk_widget, self->dictating);
   gtk_widget_set_visible (GTK_WIDGET (osk_widget), TRUE);
   g_object_connect (osk_widget,
                     "swapped-signal::key-cancelled", G_CALLBACK (on_osk_key_cancelled), self,
@@ -2357,6 +2613,7 @@ static GActionEntry entries[] =
     .change_state = select_layout_change_state },
   { .name = "menu", .parameter_type = "(ii)", .activate = menu_activated },
   { .name = "speech-input", .state = "false", .change_state = speech_input_change_state },
+  { .name = "dictate", .activate = dictate_activated },
 };
 
 
@@ -2395,6 +2652,7 @@ pos_input_surface_init (PosInputSurface *self)
   self->xkbinfo = gnome_xkb_info_new ();
   self->input_settings = g_settings_new ("org.gnome.desktop.input-sources");
   self->osk_settings = g_settings_new ("mobi.phosh.osk");
+  setup_dictation (self);
   g_signal_connect_swapped (self->osk_settings, "changed::completion-mode",
                             G_CALLBACK (on_completion_mode_changed),
                             self);
