+/**
+ * pos_osk_widget_set_dictation:
+ * @self: The osk widget
+ * @dictation: Whether to show the microphone key
+ *
+ * Shows or hides the key for speech to text left of the space key.
+ */
+void
+pos_osk_widget_set_dictation (PosOskWidget *self, gboolean dictation)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  dictation = !!dictation;
+  if (self->dictation == dictation)
+    return;
+
+  self->dictation = dictation;
+  apply_dictation (self);
+}
+
+/**
+ * pos_osk_widget_set_dictation_active:
+ * @self: The osk widget
+ * @active: Whether speech to text is listening
+ *
+ * Highlights the microphone key (in the accent color, like the return key) while the
+ * microphone is on.
+ */
+void
+pos_osk_widget_set_dictation_active (PosOskWidget *self, gboolean active)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  active = !!active;
+  if (self->dictation_active == active)
+    return;
+  self->dictation_active = active;
+
+  for (int l = 0; l <= POS_OSK_WIDGET_LAST_LAYER; l++) {
+    PosOskWidgetKeyboardLayer *layer = pos_osk_widget_get_keyboard_layer (self, l);
+    PosOskWidgetRow *row;
+
+    if (layer->n_rows == 0)
+      continue;
+    row = pos_osk_widget_get_layer_row (self, l, layer->n_rows - 1);
+    if (row->keys == NULL)
+      continue;
+
+    for (guint k = 0; k < row->keys->len; k++) {
+      PosOskKey *key = g_ptr_array_index (row->keys, k);
+
+      if (is_dictation_key (key))
+        pos_osk_key_set_style (key, active ? "return" : "sys");
+    }
+  }
+
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
