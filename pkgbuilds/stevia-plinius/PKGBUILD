prepare() {
	# Keys as unl0kr's theme plinius-glass (pkgbuilds/buffybox): glass over the blurred
	# wallpaper, wider character keys, the custom accent color of phosh-plinius
	patch -d stevia -Np1 -i "$srcdir/0001-style-manager-Glass-look-of-the-password-prompt-at-startup.patch"
	# Microphone key left of the space bar for speech to text (plinius-dictate, optional:
	# only shown when its settings schema is installed and dictation is switched on)
	patch -d stevia -Np1 -i "$srcdir/0002-osk-Microphone-key-for-speech-to-text.patch"
	# Glass look or Stevia's original one, chosen in GNOME Settings > Keyboard
	# (org.plinius.keyboard style); switches at once
	patch -d stevia -Np1 -i "$srcdir/0003-style-manager-Glass-look-or-the-original-one-as-a-setting.patch"
	# The rows of the 123 and ={< views reach both edges, as the letters' first row does
	patch -d stevia -Np1 -i "$srcdir/0004-osk-widget-Symbol-rows-fill-the-whole-width.patch"
	# ABC side by side touches the edges of its key, so one letter per line
	patch -d stevia -Np1 -i "$srcdir/0005-osk-widget-ABC-key-with-one-letter-per-line.patch"
	# A second, virtual output (VNC) must not shrink the keyboard to its default height
	patch -d stevia -Np1 -i "$srcdir/0006-size-manager-A-virtual-output-doesn-t-cost-the-keyboard-its-height.patch"
	# Start along with Phosh: right after a reboot the keyring prompt comes before Phosh is ready
	patch -d stevia -Np1 -i "$srcdir/0007-data-Start-along-with-Phosh.patch"
	# The microphone key also when the keyboard was opened by hand: without an active input
	# method the text is typed through the virtual keyboard, like emoji
	patch -d stevia -Np1 -i "$srcdir/0008-input-surface-Dictation-also-without-an-active-input-method.patch"
	# The microphone key animates for what dictation does (plinius-dictate 0.2 Activity and
	# Level): a ring that follows the voice, an arc while loading or recognizing
	patch -d stevia -Np1 -i "$srcdir/0009-osk-The-microphone-key-shows-what-dictation-does.patch"
	# Held backspace speeds up over two seconds; without an input method whole words after three
	patch -d stevia -Np1 -i "$srcdir/0010-input-surface-Held-backspace-gets-faster.patch"
	# With one input source per window, a layout picked in the menu stays with the app;
	# an app without one gets the first input source
	patch -d stevia -Np1 -i "$srcdir/0011-osk-Remember-the-layout-per-application.patch"
	# Holding the microphone key listens until it is let go; a tap still switches it on and off
	patch -d stevia -Np1 -i "$srcdir/0012-osk-Hold-the-microphone-key-to-dictate.patch"
	# Switching the microphone on buzzes with its first sound, not on the press
	patch -d stevia -Np1 -i "$srcdir/0013-osk-The-microphone-key-buzzes-once-it-really-listens.patch"
	# No settings from the keyboard's menu in a greeter: its session is never locked, yet
	# nobody has logged in (plinius-greeter)
	patch -d stevia -Np1 -i "$srcdir/0014-input-surface-No-settings-from-the-keyboard-of-a-greeter.patch"
}

build() {
	# As Arch: uim and govarnam are not in the repos
	arch-meson stevia build \
		-D uim=disabled \
		-D govarnam=disabled
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	# Look of the keyboard; GNOME Settings shows its choice only with this schema
	install -Dm644 "$srcdir/org.plinius.keyboard.gschema.xml" -t "$pkgdir/usr/share/glib-2.0/schemas"
	# Pulled in along with Phosh, see 0007
	install -Dm644 "$srcdir/plinius-osk-early.conf" -t "$pkgdir/usr/lib/systemd/user/mobi.phosh.Shell.service.d"
}
