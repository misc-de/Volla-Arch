+/* Plinius: word suggestions switched on or off in GNOME Settings */
+static void
+on_word_suggestions_changed (PosInputSurface *self)
+{
+  gboolean enable = FALSE;
+
+  if (update_word_suggestions (self))
+    return;
+
+  /* Back to Stevia's own completion mode: in manual mode off until switched on in the menu */
