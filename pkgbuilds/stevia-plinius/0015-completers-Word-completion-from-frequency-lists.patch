+/* zwp_text_input_v3 content hints: the input method's hint holds the protocol's bits */
+#define WORDS_HINT_HIDDEN_TEXT    0x40
+#define WORDS_HINT_SENSITIVE_DATA 0x80
+
+/*
+ * Plinius: word suggestions in every field of purpose "normal" (org.plinius.keyboard
+ * word-suggestions), not only where an app asks for them, which hardly any does. A hidden or
+ * sensitive field never gets them: the words completer learns what it completes. Returns
+ * whether the setting decides; switched off, Stevia's completion-mode does.
+ */
+static gboolean
+update_word_suggestions (PosInputSurface *self)
+{
+  guint hint = 0;
+
+  if (!g_settings_get_boolean (self->words_settings, "word-suggestions"))
+    return FALSE;
+
+  if (self->input_method)
+    hint = pos_input_method_get_hint (self->input_method);
+  pos_input_surface_set_completion_enabled (self,
+                                            !(hint & (WORDS_HINT_HIDDEN_TEXT |
+                                                      WORDS_HINT_SENSITIVE_DATA)));
+  return TRUE;
+}
