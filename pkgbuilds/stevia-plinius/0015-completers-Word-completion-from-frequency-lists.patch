new file mode 100644
index 0000000..428d0db
--- /dev/null
+++ b/src/completers/pos-completer-words.h
@@ -0,0 +1,23 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
