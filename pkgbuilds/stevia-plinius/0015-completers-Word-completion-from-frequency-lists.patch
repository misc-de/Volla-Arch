diff --git a/src/completers/pos-completer-words.c b/src/completers/pos-completer-words.c
new file mode 100644
index 0000000..e7ea1aa
--- /dev/null
+++ b/src/completers/pos-completer-words.c
@@ -0,0 +1,535 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "pos-completer-words"
+
+#include "pos-config.h"
+
+#include "pos-completer-base.h"
+#include "pos-completer-priv.h"
+#include "pos-completer-words.h"
+#include "pos-words.h"
+
+#include <gio/gio.h>
+#include <glib/gstdio.h>
+
+#include <errno.h>
+
+#define MAX_COMPLETIONS 3
+#define MAX_ADDITIONAL_RESULTS 3
+/* Learned words reach the disk this long after the last one */
+#define SAVE_DELAY_S 10
+
+#define KEYBOARD_SCHEMA "org.plinius.keyboard"
+#define FORGET_KEY "forget-learned-words"
+
+enum {
+  PROP_0,
+  PROP_NAME,
+  PROP_PREEDIT,
+  PROP_COMPLETIONS,
+  PROP_MODE_NAME,
+  PROP_MODE_SYMBOL,
+  PROP_MODE_MENU,
+  PROP_MODE_ACTIONS,
+  PROP_LAST_PROP
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+/**
+ * PosCompleterWords:
+ *
+ * Completes the word being typed from a list of the language's words by frequency
+ * (plinius-words, see pos-words.c): from three characters on, the most frequent words that
+ * start with them, words the user typed often before those. The list loads in a thread, so
+ * a language switch never waits for it; until it is there, nothing is suggested.
+ *
+ * Learned words go to $XDG_DATA_HOME/stevia/words/<lang>.learned. GNOME Settings forgets
+ * them: it removes the files and raises org.plinius.keyboard forget-learned-words.
+ */
+struct _PosCompleterWords {
+  PosCompleterBase  parent;
+
+  char             *name;
+  GString          *preedit;
+  GStrv             completions;
+  guint             max_completions;
+
+  char             *lang;      /* of the list loaded or loading */
+  PosWords         *words;     /* NULL while it loads */
+  GCancellable     *loading;
+  gboolean          dirty;     /* learned words not saved yet */
+  guint             save_id;
+  GSettings        *settings;  /* NULL without the schema */
+};
+
+
+static void pos_completer_words_interface_init (PosCompleterInterface *iface);
+static void pos_completer_words_initable_interface_init (GInitableIface *iface);
+
+G_DEFINE_TYPE_WITH_CODE (PosCompleterWords, pos_completer_words, POS_TYPE_COMPLETER_BASE,
+                         G_IMPLEMENT_INTERFACE (POS_TYPE_COMPLETER,
+                                                pos_completer_words_interface_init)
+                         G_IMPLEMENT_INTERFACE (G_TYPE_INITABLE,
+                                                pos_completer_words_initable_interface_init))
+
+
+static char *
+learned_path (const char *lang)
+{
+  g_autofree char *name = g_strdup_printf ("%s.learned", lang);
+
+  return g_build_filename (g_get_user_data_dir (), "stevia", "words", name, NULL);
+}
+
+
+static void
+save_learned (PosCompleterWords *self)
+{
+  g_autoptr (GError) err = NULL;
+  g_autofree char *path = NULL;
+
+  g_clear_handle_id (&self->save_id, g_source_remove);
+  if (!self->dirty || self->words == NULL)
+    return;
+
+  path = learned_path (self->lang);
+  if (!pos_words_save_learned (self->words, path, &err))
+    g_warning ("Saving learned words failed: %s", err->message);
+  self->dirty = FALSE;
+}
+
+
+static gboolean
+on_save_timeout (gpointer data)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (data);
+
+  self->save_id = 0;
+  save_learned (self);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+learn (PosCompleterWords *self, const char *word)
+{
+  if (self->words == NULL || !pos_words_learn (self->words, word))
+    return;
+
+  self->dirty = TRUE;
+  g_clear_handle_id (&self->save_id, g_source_remove);
+  self->save_id = g_timeout_add_seconds (SAVE_DELAY_S, on_save_timeout, self);
+}
+
+
+static void
+on_forget_learned_words (PosCompleterWords *self)
+{
+  g_autofree char *path = NULL;
+
+  g_debug ("Forgetting learned words");
+  g_clear_handle_id (&self->save_id, g_source_remove);
+  self->dirty = FALSE;
+  if (self->words)
+    pos_words_forget_learned (self->words);
+  /* GNOME Settings removed them already; a list that was still loading may have read it */
+  if (self->lang) {
+    path = learned_path (self->lang);
+    if (g_unlink (path) != 0 && errno != ENOENT)
+      g_warning ("Removing %s failed: %s", path, g_strerror (errno));
+  }
+}
+
+
+static void
+pos_completer_words_set_completions (PosCompleter *iface, GStrv completions)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (iface);
+  g_auto (GStrv) additional_results = NULL;
+  g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+
+  additional_results = pos_completer_base_get_additional_results (POS_COMPLETER_BASE (self),
+                                                                  self->preedit->str,
+                                                                  MAX_ADDITIONAL_RESULTS);
+  if (completions)
+    g_strv_builder_addv (builder, (const char **)completions);
+  if (additional_results)
+    g_strv_builder_addv (builder, (const char **)additional_results);
+  g_strfreev (self->completions);
+  self->completions = g_strv_builder_end (builder);
+
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_COMPLETIONS]);
+}
+
+
+static const char *
+pos_completer_words_get_preedit (PosCompleter *iface)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (iface);
+
+  return self->preedit->str;
+}
+
+
+static void
+pos_completer_words_set_preedit (PosCompleter *iface, const char *preedit)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (iface);
+
+  if (g_strcmp0 (self->preedit->str, preedit) == 0)
+    return;
+
+  g_string_truncate (self->preedit, 0);
+  if (preedit) {
+    g_string_append (self->preedit, preedit);
+  } else {
+    g_clear_pointer (&self->completions, g_strfreev);
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_COMPLETIONS]);
+  }
+
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_PREEDIT]);
+}
+
+
+static void
+pos_completer_words_set_surrounding_text (PosCompleter *iface,
+                                          const char   *before_text,
+                                          const char   *after_text)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (iface);
+
+  pos_completer_base_set_surrounding_text (POS_COMPLETER_BASE (self), before_text, after_text);
+}
+
+
+static gboolean
+pos_completer_words_feed_symbol (PosCompleter *iface, const char *symbol)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (iface);
+  g_autofree char *preedit = g_strdup (self->preedit->str);
+  g_auto (GStrv) completions = NULL;
+
+  if (pos_completer_add_preedit (POS_COMPLETER (self), self->preedit, symbol)) {
+    PosCompleterBase *base = POS_COMPLETER_BASE (self);
+    int before = 0;
+
+    /* Only swap if preedit is 2 characters: symbol + space */
+    if (pos_completer_base_wants_punctuation_swap (base, symbol) && self->preedit->len == 2)
+      before = 1;
+
+    /* The word ends here, as the user typed it */
+    learn (self, preedit);
+
+    g_signal_emit_by_name (self, "commit-string", self->preedit->str, before, 0);
+    pos_completer_words_set_preedit (POS_COMPLETER (self), NULL);
+
+    /* Make sure enter is processed as raw keystroke */
+    if (g_strcmp0 (symbol, "KEY_ENTER") == 0)
+      return FALSE;
+
+    return TRUE;
+  }
+
+  /* preedit didn't change and wasn't committed so we didn't handle it */
+  if (g_strcmp0 (self->preedit->str, preedit) == 0)
+    return FALSE;
+
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_PREEDIT]);
+
+  if (self->words)
+    completions = pos_words_complete (self->words, self->preedit->str, self->max_completions);
+  pos_completer_words_set_completions (POS_COMPLETER (self), completions);
+
+  return TRUE;
+}
+
+
+typedef struct {
+  char *list;
+  char *learned;
+} LoadData;
+
+
+static void
+load_data_free (LoadData *data)
+{
+  g_free (data->list);
+  g_free (data->learned);
+  g_free (data);
+}
+
+
+static void
+load_in_thread (GTask *task, gpointer source, gpointer task_data, GCancellable *cancel)
+{
+  LoadData *data = task_data;
+  g_autoptr (PosWords) words = pos_words_new ();
+  g_autoptr (GError) err = NULL;
+
+  if (!pos_words_load_list (words, data->list, &err) ||
+      !pos_words_load_learned (words, data->learned, &err)) {
+    g_task_return_error (task, g_steal_pointer (&err));
+    return;
+  }
+  g_task_return_pointer (task, g_steal_pointer (&words), (GDestroyNotify)pos_words_free);
+}
+
+
+static void
+on_loaded (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (source);
+  g_autoptr (GError) err = NULL;
+  PosWords *words;
+
+  words = g_task_propagate_pointer (G_TASK (res), &err);
+  if (words == NULL) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Loading words failed: %s", err->message);
+    return;
+  }
+  /* The language changed while this one loaded */
+  if (g_task_get_cancellable (G_TASK (res)) != self->loading) {
+    pos_words_free (words);
+    return;
+  }
+
+  g_clear_object (&self->loading);
+  self->words = words;
+  g_debug ("%u words for '%s'", pos_words_get_n_words (words), self->lang);
+}
+
+
+static gboolean
+pos_completer_words_set_language (PosCompleter *completer,
+                                  const char   *lang,
+                                  const char   *region,
+                                  GError      **error)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (completer);
+  g_autofree char *pick = NULL;
+  g_autoptr (GTask) task = NULL;
+  LoadData *data;
+  char *list_name;
+
+  pick = pos_words_pick_language (POS_WORDS_DIR, lang, region, g_get_language_names ());
+  if (pick == NULL) {
+    g_set_error (error, POS_COMPLETER_ERROR, POS_COMPLETER_ERROR_LANG_INIT,
+                 "No word list for %s-%s", lang, region);
+    return FALSE;
+  }
+  if (g_strcmp0 (pick, self->lang) == 0)
+    return TRUE;
+
+  /* The words learned in the language so far go to its file */
+  save_learned (self);
+  g_cancellable_cancel (self->loading);
+  g_clear_object (&self->loading);
+  g_clear_pointer (&self->words, pos_words_free);
+  g_free (self->lang);
+  self->lang = g_steal_pointer (&pick);
+
+  data = g_new0 (LoadData, 1);
+  list_name = g_strdup_printf ("%s.words", self->lang);
+  data->list = g_build_filename (POS_WORDS_DIR, list_name, NULL);
+  g_free (list_name);
+  data->learned = learned_path (self->lang);
+
+  self->loading = g_cancellable_new ();
+  task = g_task_new (self, self->loading, on_loaded, NULL);
+  g_task_set_task_data (task, data, (GDestroyNotify)load_data_free);
+  g_task_set_return_on_cancel (task, TRUE);
+  g_task_run_in_thread (task, load_in_thread);
+
+  return TRUE;
+}
+
+
+static void
+pos_completer_words_set_property (GObject      *object,
+                                  guint         property_id,
+                                  const GValue *value,
+                                  GParamSpec   *pspec)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (object);
+
+  switch (property_id) {
+  case PROP_PREEDIT:
+    pos_completer_words_set_preedit (POS_COMPLETER (self), g_value_get_string (value));
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+pos_completer_words_get_property (GObject    *object,
+                                  guint       property_id,
+                                  GValue     *value,
+                                  GParamSpec *pspec)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (object);
+
+  switch (property_id) {
+  case PROP_NAME:
+    g_value_set_string (value, self->name);
+    break;
+  case PROP_PREEDIT:
+    g_value_set_string (value, self->preedit->str);
+    break;
+  case PROP_COMPLETIONS:
+    g_value_set_boxed (value, self->completions);
+    break;
+  case PROP_MODE_NAME:
+  case PROP_MODE_SYMBOL:
+    g_value_set_string (value, NULL);
+    break;
+  case PROP_MODE_MENU:
+  case PROP_MODE_ACTIONS:
+    g_value_set_object (value, NULL);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+pos_completer_words_dispose (GObject *object)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (object);
+
+  save_learned (self);
+  g_cancellable_cancel (self->loading);
+  g_clear_object (&self->loading);
+  g_clear_object (&self->settings);
+
+  G_OBJECT_CLASS (pos_completer_words_parent_class)->dispose (object);
+}
+
+
+static void
+pos_completer_words_finalize (GObject *object)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (object);
+
+  g_clear_pointer (&self->words, pos_words_free);
+  g_clear_pointer (&self->completions, g_strfreev);
+  g_clear_pointer (&self->lang, g_free);
+  g_string_free (self->preedit, TRUE);
+
+  G_OBJECT_CLASS (pos_completer_words_parent_class)->finalize (object);
+}
+
+
+static void
+pos_completer_words_class_init (PosCompleterWordsClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->get_property = pos_completer_words_get_property;
+  object_class->set_property = pos_completer_words_set_property;
+  object_class->dispose = pos_completer_words_dispose;
+  object_class->finalize = pos_completer_words_finalize;
+
+  g_object_class_override_property (object_class, PROP_NAME, "name");
+  props[PROP_NAME] = g_object_class_find_property (object_class, "name");
+
+  g_object_class_override_property (object_class, PROP_PREEDIT, "preedit");
+  props[PROP_PREEDIT] = g_object_class_find_property (object_class, "preedit");
+
+  g_object_class_override_property (object_class, PROP_COMPLETIONS, "completions");
+  props[PROP_COMPLETIONS] = g_object_class_find_property (object_class, "completions");
+
+  g_object_class_override_property (object_class, PROP_MODE_NAME, "mode-name");
+  props[PROP_MODE_NAME] = g_object_class_find_property (object_class, "mode-name");
+
+  g_object_class_override_property (object_class, PROP_MODE_SYMBOL, "mode-symbol");
+  props[PROP_MODE_SYMBOL] = g_object_class_find_property (object_class, "mode-symbol");
+
+  g_object_class_override_property (object_class, PROP_MODE_MENU, "mode-menu");
+  props[PROP_MODE_MENU] = g_object_class_find_property (object_class, "mode-menu");
+
+  g_object_class_override_property (object_class, PROP_MODE_ACTIONS, "mode-actions");
+  props[PROP_MODE_ACTIONS] = g_object_class_find_property (object_class, "mode-actions");
+}
+
+
+static gboolean
+pos_completer_words_initable_init (GInitable    *initable,
+                                   GCancellable *cancelable,
+                                   GError      **error)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (initable);
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = NULL;
+
+  if (source)
+    schema = g_settings_schema_source_lookup (source, KEYBOARD_SCHEMA, TRUE);
+  if (schema && g_settings_schema_has_key (schema, FORGET_KEY)) {
+    self->settings = g_settings_new (KEYBOARD_SCHEMA);
+    g_signal_connect_swapped (self->settings, "changed::" FORGET_KEY,
+                              G_CALLBACK (on_forget_learned_words), self);
+  }
+
+  return pos_completer_words_set_language (POS_COMPLETER (self),
+                                           POS_COMPLETER_DEFAULT_LANG,
+                                           POS_COMPLETER_DEFAULT_REGION,
+                                           error);
+}
+
+
+static void
+pos_completer_words_initable_interface_init (GInitableIface *iface)
+{
+  iface->init = pos_completer_words_initable_init;
+}
+
+
+static const char *
+pos_completer_words_get_name (PosCompleter *iface)
+{
+  PosCompleterWords *self = POS_COMPLETER_WORDS (iface);
+
+  return self->name;
+}
+
+
+static void
+pos_completer_words_interface_init (PosCompleterInterface *iface)
+{
+  iface->get_name = pos_completer_words_get_name;
+  iface->feed_symbol = pos_completer_words_feed_symbol;
+  iface->get_preedit = pos_completer_words_get_preedit;
+  iface->set_preedit = pos_completer_words_set_preedit;
+  iface->set_surrounding_text = pos_completer_words_set_surrounding_text;
+  iface->set_language = pos_completer_words_set_language;
+}
+
+
+static void
+pos_completer_words_init (PosCompleterWords *self)
+{
+  self->max_completions = MAX_COMPLETIONS;
+  self->preedit = g_string_new (NULL);
+  self->name = "words";
+}
+
+/**
+ * pos_completer_words_new:
+ * err: An error location
+ *
+ * Returns:(transfer full): A new completer
+ */
+PosCompleter *
+pos_completer_words_new (GError **err)
+{
+  return POS_COMPLETER (g_initable_new (POS_TYPE_COMPLETER_WORDS, NULL, err, NULL));
+}
