+/* Animate the microphone key of every osk for what dictation does */
+static void
+set_dictation_activity (PosInputSurface *self, const char *activity)
+{
+  /* May be called with the current activity itself: copy before freeing */
+  char *copy = g_strdup (activity);
+
+  g_free (self->dictate_activity);
+  self->dictate_activity = copy;
+
+  for (guint i = 0; i < self->osks->len; i++)
