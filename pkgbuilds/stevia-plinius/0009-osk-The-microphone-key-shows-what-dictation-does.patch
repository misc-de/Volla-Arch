+
+  g_clear_handle_id (&self->dictate_idle_id, g_source_remove);
+  if (!self->dictating && copy != NULL && g_strcmp0 (copy, "idle") != 0)
+    self->dictate_idle_id = g_timeout_add_seconds_once (DICTATE_IDLE_TIMEOUT_S,
+                                                        on_dictate_idle_timeout, self);
