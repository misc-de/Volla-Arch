 }
 
 
+/* What the dictation service does, see pos_osk_widget_set_dictation_activity() */
+typedef enum {
+  DICTATION_IDLE,
+  DICTATION_LOADING,
+  DICTATION_LISTENING,
+  DICTATION_SPEECH,
+  DICTATION_RECOGNIZING,
+} DictationActivity;
+
+/* The animation of the microphone key runs at most this often (it is small and calm) */
+#define DICTATION_FRAME_US (G_USEC_PER_SEC / 30)
+/* One breath of the ring while listening, one turn of the spinner (seconds) */
+#define DICTATION_BREATH_S 1.6
+#define DICTATION_SPIN_S 1.0
+
 /* Width of the microphone key while it is shown */
 #define DICTATION_KEY_WIDTH 1.0
 
@@ -607,6 +628,149 @@ apply_dictation (PosOskWidget *self)
 }
 
 
+/* The visible microphone key of the current layer, if any */
+static PosOskKey *
+get_dictation_key (PosOskWidget *self)
+{
+  PosOskWidgetRow *row;
+
+  if (self->layout.n_rows == 0)
+    return NULL;
+  row = pos_osk_widget_get_row (self, self->layout.n_rows - 1);
+  for (int k = 0; k < pos_osk_widget_row_get_num_keys (row); k++) {
+    PosOskKey *key = pos_osk_widget_row_get_key (row, k);
+
+    if (is_dictation_key (key) && pos_osk_key_get_width (key) > 0.0)
+      return key;
+  }
+  return NULL;
+}
+
+
+/* Redraw only the microphone key: the rest of the keyboard does not change */
+static void
+queue_draw_dictation_key (PosOskWidget *self)
+{
+  PosOskWidgetKeyboardLayer *layer = pos_osk_widget_get_current_layer (self);
+  PosOskKey *key = get_dictation_key (self);
+  const GdkRectangle *box;
+
+  if (key == NULL)
+    return;
+  box = pos_osk_key_get_box (key);
+  gtk_widget_queue_draw_area (GTK_WIDGET (self), box->x + layer->offset_x, box->y,
+                              box->width, box->height);
+}
+
+
+static gboolean
+dictation_mic_open (PosOskWidget *self)
+{
+  return self->dictation_activity == DICTATION_LOADING ||
+    self->dictation_activity == DICTATION_LISTENING ||
+    self->dictation_activity == DICTATION_SPEECH;
+}
+
+
+/*
+ * One step of the animation: the drawn loudness follows the service's, rising quickly
+ * and falling slowly like a level meter. Ends once dictation is idle and the ring is gone.
+ */
+static gboolean
+on_dictation_tick (GtkWidget *widget, GdkFrameClock *clock, gpointer user_data)
+{
+  PosOskWidget *self = POS_OSK_WIDGET (widget);
+  gint64 now = gdk_frame_clock_get_frame_time (clock);
+  double dt, target, rate;
+
+  if (now - self->dictation_frame < DICTATION_FRAME_US)
+    return G_SOURCE_CONTINUE;
+  dt = CLAMP ((now - self->dictation_frame) / (double) G_USEC_PER_SEC, 0.0, 0.1);
+  self->dictation_frame = now;
+
+  target = dictation_mic_open (self) ? self->dictation_level : 0.0;
+  rate = target > self->dictation_shown_level ? 18.0 : 5.0;
+  self->dictation_shown_level += (target - self->dictation_shown_level) * MIN (1.0, rate * dt);
+
+  queue_draw_dictation_key (self);
+
+  if (self->dictation_activity == DICTATION_IDLE && self->dictation_shown_level < 0.01) {
+    self->dictation_shown_level = 0.0;
+    self->dictation_tick = 0;
+    return G_SOURCE_REMOVE;
+  }
+  return G_SOURCE_CONTINUE;
+}
+
+
+/*
+ * Feedback on the microphone key, over its icon:
+ * - a ring that breathes while the microphone is open and grows with the voice,
+ * - a turning arc while the model loads or spoken text is being recognized.
+ */
+static void
+draw_dictation_feedback (PosOskWidget *self, PosOskKey *key, cairo_t *cr)
+{
+  const GdkRectangle *box = pos_osk_key_get_box (key);
+  double t = self->dictation_frame / (double) G_USEC_PER_SEC;
+  double icon_size, cx, cy, r0, rmax;
+  g_autofree char *style = NULL;
+  GtkStateFlags state;
+  GdkRGBA fg;
+
+  if (self->dictation_activity == DICTATION_IDLE && self->dictation_shown_level <= 0.0)
+    return;
+
+  /* The key's own foreground color, as its icon is drawn */
+  g_object_get (key, "style", &style, NULL);
+  if (style)
+    gtk_style_context_add_class (self->key_context, style);
+  state = gtk_style_context_get_state (self->key_context);
+  gtk_style_context_get_color (self->key_context, state, &fg);
+  if (style)
+    gtk_style_context_remove_class (self->key_context, style);
+
+  icon_size = MIN (KEY_ICON_SIZE * (self->key_scale / 100.0), box->height / 2.0);
+  cx = box->x + box->width / 2.0;
+  cy = box->y + box->height / 2.0;
+  r0 = icon_size * 0.7;
+  rmax = MAX (MIN (box->width, box->height) / 2.0 - 2.0, r0 + 2.0);
+
+  cairo_save (cr);
+  cairo_rectangle (cr, box->x, box->y, box->width, box->height);
+  cairo_clip (cr);
+
+  if (dictation_mic_open (self) || self->dictation_shown_level > 0.0) {
+    double breath = 0.5 + 0.5 * sin (t * 2.0 * G_PI / DICTATION_BREATH_S);
+    double grow = dictation_mic_open (self) ?
+      MAX (self->dictation_shown_level, 0.2 * breath) : self->dictation_shown_level;
+    double r = r0 + (rmax - 2.0 - r0) * grow;
+
+    cairo_new_path (cr);
+    cairo_arc (cr, cx, cy, r, 0.0, 2.0 * G_PI);
+    cairo_set_source_rgba (cr, fg.red, fg.green, fg.blue, fg.alpha * (0.10 + 0.15 * grow));
+    cairo_fill_preserve (cr);
+    cairo_set_line_width (cr, 1.5);
+    cairo_set_source_rgba (cr, fg.red, fg.green, fg.blue, fg.alpha * (0.35 + 0.45 * grow));
+    cairo_stroke (cr);
+  }
+
+  if (self->dictation_activity == DICTATION_LOADING ||
+      self->dictation_activity == DICTATION_RECOGNIZING) {
+    double a = fmod (t, DICTATION_SPIN_S) / DICTATION_SPIN_S * 2.0 * G_PI;
+
+    cairo_new_path (cr);
+    cairo_arc (cr, cx, cy, rmax - 1.0, a, a + 0.6 * G_PI);
+    cairo_set_line_width (cr, 2.0);
+    cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+    cairo_set_source_rgba (cr, fg.red, fg.green, fg.blue, fg.alpha * 0.9);
+    cairo_stroke (cr);
+  }
+
+  cairo_restore (cr);
+}
