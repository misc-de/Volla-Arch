diff --git a/src/pos-osk-widget.c b/src/pos-osk-widget.c
index fc407a5..2ae06db 100644
--- a/src/pos-osk-widget.c
+++ b/src/pos-osk-widget.c
@@ -161,6 +161,12 @@ struct _PosOskWidget {
   /* Speech to text: the microphone key is shown and/or on */
   gboolean             dictation;
   gboolean             dictation_active;
+  /* What the service does (DictationActivity) and the animation of the key for it */
+  guint                dictation_activity;
+  double               dictation_level;        /* last loudness from the service, 0 to 1 */
+  double               dictation_shown_level;  /* smoothed for drawing */
