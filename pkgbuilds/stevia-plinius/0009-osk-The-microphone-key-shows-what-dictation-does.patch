   for (int r = 0; r < self->layout.n_rows; r++) {
     PosOskWidgetRow *row = pos_osk_widget_get_row (self, r);
@@ -1754,7 +1922,11 @@ pos_osk_widget_draw (GtkWidget *widget, cairo_t *cr)
       /* Hidden keys (e.g. the microphone with dictation off) */
       if (pos_osk_key_get_width (key) <= 0.0)
         continue;
