+/* What the service does: loading, listening, speech, recognizing or idle */
+static void
+on_dictate_activity (GDBusConnection *bus, const char *sender, const char *path,
+                     const char *iface, const char *signal, GVariant *params, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+  const char *activity;
+
+  if (!g_variant_is_of_type (params, G_VARIANT_TYPE ("(s)")))
+    return;
+  g_variant_get (params, "(&s)", &activity);
+  set_dictation_activity (self, activity);
