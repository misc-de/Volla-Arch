+static void
+on_dictate_idle_timeout (gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  self->dictate_idle_id = 0;
+  if (!self->dictating)
+    set_dictation_activity (self, "idle");
