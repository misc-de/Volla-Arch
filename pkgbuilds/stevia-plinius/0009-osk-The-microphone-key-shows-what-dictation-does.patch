@@ -1769,6 +1941,10 @@ pos_osk_widget_finalize (GObject *object)
   PosOskWidget *self = POS_OSK_WIDGET (object);
 
   g_clear_handle_id (&self->repeat_id, g_source_remove);
+  if (self->dictation_tick) {
+    gtk_widget_remove_tick_callback (GTK_WIDGET (self), self->dictation_tick);
+    self->dictation_tick = 0;
+  }
   pos_osk_widget_layout_free (&self->layout);
   g_clear_object (&self->long_press);
   g_clear_pointer (&self->name, g_free);
@@ -2405,3 +2581,58 @@ pos_osk_widget_set_dictation_active (PosOskWidget *self, gboolean active)
 
   gtk_widget_queue_draw (GTK_WIDGET (self));
 }
+
+/**
+ * pos_osk_widget_set_dictation_activity:
+ * @self: The osk widget
+ * @activity: What the dictation service does: `idle`, `loading`, `listening`, `speech`
+ *   or `recognizing`
+ *
+ * Animates the microphone key so the user sees what dictation does: a ring that breathes
+ * while listening and follows the voice (see [method@OskWidget.set_dictation_level]), a
+ * turning arc while the model loads or text is recognized.
+ */
+void
+pos_osk_widget_set_dictation_activity (PosOskWidget *self, const char *activity)
+{
+  DictationActivity value = DICTATION_IDLE;
+
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  if (g_strcmp0 (activity, "loading") == 0)
+    value = DICTATION_LOADING;
+  else if (g_strcmp0 (activity, "listening") == 0)
+    value = DICTATION_LISTENING;
+  else if (g_strcmp0 (activity, "speech") == 0)
+    value = DICTATION_SPEECH;
+  else if (g_strcmp0 (activity, "recognizing") == 0)
+    value = DICTATION_RECOGNIZING;
+
+  if (self->dictation_activity == value)
+    return;
+  self->dictation_activity = value;
+  if (!dictation_mic_open (self))
+    self->dictation_level = 0.0;
+
+  if (value != DICTATION_IDLE && self->dictation_tick == 0) {
+    self->dictation_frame = g_get_monotonic_time ();
+    self->dictation_tick = gtk_widget_add_tick_callback (GTK_WIDGET (self), on_dictation_tick,
+                                                         NULL, NULL);
+  }
+  queue_draw_dictation_key (self);
+}
+
+/**
+ * pos_osk_widget_set_dictation_level:
+ * @self: The osk widget
+ * @level: Loudness of the microphone from 0 to 1
+ *
+ * The ring around the microphone key grows with it while the microphone is open.
+ */
+void
+pos_osk_widget_set_dictation_level (PosOskWidget *self, double level)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  self->dictation_level = dictation_mic_open (self) ? CLAMP (level, 0.0, 1.0) : 0.0;
+}
