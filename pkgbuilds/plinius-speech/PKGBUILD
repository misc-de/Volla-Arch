# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-speech
pkgver=0.1
pkgrel=5
pkgdesc="Speech output for the Plinius: one voice and rate for every speech output, and the caller announcement in a Bluetooth headset"
arch=(aarch64 x86_64)  # x86_64 for the KVM preview
# The service links libespeak-ng (GPL-3.0-or-later)
license=(GPL-3.0-or-later)
# Piper voices run on ONNX Runtime as Piper does (sherpa-onnx cannot load Piper 1.5 voices: their
# vowel clusters are tokens of two codepoints); espeak-ng turns text into phonemes; pw-cat plays;
# pactl and BlueZ for the caller announcement
depends=(glib2 glibc json-glib espeak-ng pipewire libpulse 'onnxruntime-plinius>=1.32.0'
	python python-gobject)
# The voices are packages of their own (plinius-speech-voices): the image has the default voice of
# its language, GNOME Settings (Sound > Speech Output) installs more through plinius-software
optdepends=('plinius-speech-voice-en-us-joe: the default voice for US English'
	'speech-dispatcher: speech output of apps (Orca, reading aloud in Firefox) with the same voice')
makedepends=(gcc pkgconf gettext)
_langs=(de es fr it nl pl pt ru)
backup=(etc/speech-dispatcher/modules/plinius.conf)
source=(plinius-speechd.c
	plinius-speak
	plinius-callannounce
	plinius-callannounce.desktop
	org.plinius.Speech1.service
	org.plinius.speech.gschema.xml
	plinius.conf
	voices.json
	"${_langs[@]/%/.po}")
sha256sums=('da647ff3eb5797f58d91fa3ab33ad348f67761de0bb232f9ba2b9a8afa6ddc21'
	'ee3404c58abf739b223cbdbbeb12ad3ec041df8fe6d66231d9e51568b4149000'
	'70c4edb4d4104b2f8321243e4e2317a808560d51cb4c397f1ff66536b5a2d767'
	'b4c51715817cfa357f825c07129aed6b34e532f35e038513a75c4ea9b205fb77'
