	'c48e844306067b977cc8d3703b71bc830743c789e3d259953886b0ccab2b236f')

build() {
	# shellcheck disable=SC2086,SC2046
	gcc $CPPFLAGS $CFLAGS -Wall -o plinius-speechd plinius-speechd.c \
		$(pkg-config --cflags --libs gio-unix-2.0 json-glib-1.0 espeak-ng libonnxruntime) -lm $LDFLAGS
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	install -Dm755 plinius-speechd plinius-speak plinius-callannounce -t "$pkgdir/usr/lib/plinius-speech"
	install -Dm644 org.plinius.Speech1.service -t "$pkgdir/usr/share/dbus-1/services"
	install -Dm644 org.plinius.speech.gschema.xml -t "$pkgdir/usr/share/glib-2.0/schemas"
	# All voices of the repository, installed or not, for Settings
	install -Dm644 voices.json -t "$pkgdir/usr/share/plinius-speech"
	install -dm755 "$pkgdir/usr/share/plinius-speech/voices"
	# Runs in the session: it follows the session's Calls and plays to its outputs
	install -Dm644 plinius-callannounce.desktop -t "$pkgdir/etc/xdg/autostart"
	# speech-dispatcher finds sd_* modules by itself and gives each its <name>.conf
	install -Dm644 plinius.conf -t "$pkgdir/etc/speech-dispatcher/modules"
	install -dm755 "$pkgdir/usr/lib/speech-dispatcher-modules"
	ln -s sd_generic "$pkgdir/usr/lib/speech-dispatcher-modules/sd_plinius"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-speech.mo"
	done
}
