# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=vibrator-ff-bridge
pkgver=0.5
pkgrel=2
pkgdesc="Force-feedback input device for feedbackd, backed by the vendor haptics FF device, sysfs or the AIDL vibrator HAL, and the vibrator for Android apps in the Waydroid container"
arch=(aarch64 x86_64)
license=(MIT)
depends=(glib2 libgbinder)
optdepends=('feedbackd: haptic feedback in Phosh and apps')
source=(vibrator-ff-bridge.c
	vibrator-ff-bridge.service
	72-vibrator-ff-bridge.rules
	LICENSE)
sha256sums=('164e50a0d5078a0b3f8ee37dfa61d77abee6ef5c4a1fca726e2a67987fb205bf'
	'8af7fe777ff6444794df593b30f001e92033c7a558130977b58039a6b42ecaf5'
	'4b816ddef57f9ac081531e8097e93c9a229beb64263e35030629351179e9aadc'
	'1f18c6c362e3c14577e914c06d551c588720f91959e6aa99a121b86863ffd076')

build() {
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o vibrator-ff-bridge vibrator-ff-bridge.c \
		$(pkg-config --cflags --libs gio-2.0 libgbinder) $LDFLAGS
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 vibrator-ff-bridge -t "$pkgdir/usr/bin"
	install -Dm644 vibrator-ff-bridge.service -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 72-vibrator-ff-bridge.rules -t "$pkgdir/usr/lib/udev/rules.d"
}
