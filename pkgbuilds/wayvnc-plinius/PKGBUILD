# Maintainer: misc-de <misc-de@users.noreply.github.com>
# Based on: Arch's PKGBUILD (wayvnc 0.10.2-1)

pkgname=wayvnc-plinius
pkgver=0.10.2
pkgrel=5
pkgdesc='VNC server for wlroots-based Wayland compositors, with the PIN wait of plinius-pinguard'
arch=(aarch64 x86_64)
url=https://github.com/any1/wayvnc
license=(ISC)
depends=(
	glibc
	jansson
	libaml.so
	libdrm
	libneatvnc.so
	libpixman-1.so
	libxkbcommon.so
	mesa
	pam
	# The module wayvnc.pam asks; it must know the "network" option
	'plinius-pinguard>=0.4'
	wayland
)
makedepends=(git meson ninja scdoc)
provides=("wayvnc=$pkgver")
conflicts=(wayvnc)
# Why not wayvnc from ALARM: its /etc/pam.d/wayvnc is the file PAM reads for the service name
# compiled into wayvnc, and it only knows pam_unix, so the PIN could be tried out over the
# network without any wait. A file of another package could not replace it.
# The commit of tag v$pkgver: a tag can be moved later, a commit hash cannot
_commit=bb837459c75fd3c267d48af170ac7ed2566f67e5
source=("wayvnc::git+https://github.com/any1/wayvnc.git#commit=$_commit"
	0001-output-management-A-resize-keeps-the-output-where-it-is.patch
	wayvnc.pam)
sha256sums=('SKIP'
	'e5f49c6d0e44cd4b1d3a71202e60c642a7d6288980915f97523159a849f443f6'
	'db099c0bd6a570de3b6d292daf6ae1c4a4e57c06cc6cb9666e38e6a48bf39578')

prepare() {
	# A viewer resizing the screen doesn't move it over the phone's
	patch -d wayvnc -Np1 -i "$srcdir/0001-output-management-A-resize-keeps-the-output-where-it-is.patch"
}

build() {
	arch-meson wayvnc build \
		-Dman-pages=enabled \
		-Dpam=enabled \
		-Dtests=false
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install -C build
	install -Dm644 wayvnc.pam "$pkgdir/etc/pam.d/wayvnc"
	install -Dm644 wayvnc/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
