#: app.py:31
msgid "Floppy Disk Images"
msgstr "Images de disquettes"

#: app.py:32
msgid "Disk 1 is enough, the other disks in its folder come along"
msgstr "La disquette 1 suffit, les autres de son dossier suivent"

#: app.py:34
msgid "CD Image"
msgstr "Image de CD"

#: app.py:34
msgid ".iso, or .cue with its tracks"
msgstr ".iso, ou .cue avec ses pistes"

#: app.py:36
msgid "ZIP Archive"
msgstr "Archive ZIP"

#: app.py:36
msgid "A packed game, such as a freeware download"
msgstr "Un jeu compressé, comme un téléchargement gratuit"

#: app.py:38
msgid "GOG Installer"
msgstr "Installateur GOG"

#: app.py:38
msgid "setup_….exe from GOG"
msgstr "setup_….exe de GOG"

#: app.py:40
msgid "Folder"
msgstr "Dossier"

#: app.py:40
msgid "The game's files, or a copy of its disks"
msgstr "Les fichiers du jeu, ou une copie de ses disques"

#: app.py:133 app.py:167
msgid "DOS Installer"
msgstr "DOS Installer"

#: app.py:149 app.py:158 app.py:383
msgid "Install a Game"
msgstr "Installer un jeu"

#: app.py:154
msgid "No Games Yet"
msgstr "Pas encore de jeux"

#: app.py:155
msgid "Install a DOS game from floppy disk images, a CD image, a ZIP archive, a GOG installer or a folder."
msgstr "Installez un jeu DOS depuis des images de disquettes, une image de CD, une archive ZIP, un installateur GOG ou un dossier."

#: app.py:174
msgid "Games"
msgstr "Jeux"

#: app.py:185 app.py:600
msgid "Play"
msgstr "Jouer"

#: app.py:188
msgid "Settings"
msgstr "Paramètres"

#: app.py:205
msgid "Uninstall Game"
msgstr "Désinstaller le jeu"

#: app.py:216
msgid "Controls"
msgstr "Commandes"

#: app.py:217
msgid "Touch Joystick"
msgstr "Joystick tactile"

#: app.py:218
msgid "Stick and buttons beside the picture"
msgstr "Stick et boutons à côté de l’image"

#: app.py:223
msgid "Arrow Keys"
msgstr "Flèches"

#: app.py:223
msgid "Number Pad"
msgstr "Pavé numérique"

#: app.py:225
msgid "Stick"
msgstr "Stick"

#: app.py:225
msgid "The keys it presses"
msgstr "Les touches qu’il envoie"

#: app.py:233
msgid "Mouse Speed"
msgstr "Vitesse de la souris"

#: app.py:234
msgid "How far a swipe moves the mouse, in percent"
msgstr "Distance parcourue par la souris lors d’un balayage, en pourcentage"

#: app.py:243
msgid "Game"
msgstr "Jeu"

#: app.py:247
msgid "Automatic"
msgstr "Automatique"

#: app.py:247
msgid "Slow (286)"
msgstr "Lent (286)"

#: app.py:247
msgid "Medium (386)"
msgstr "Moyen (386)"

#: app.py:247
msgid "Fast (486)"
msgstr "Rapide (486)"

#: app.py:248
msgid "Maximum"
msgstr "Maximum"

#: app.py:253
msgid "CPU Speed"
msgstr "Vitesse du processeur"

#: app.py:254
msgid "Slower if the game is too fast"
msgstr "Plus lent si le jeu va trop vite"

#: app.py:259
msgid "Sharp Pixels"
msgstr "Pixels nets"

#: app.py:260
msgid "The picture without smoothing"
msgstr "L’image sans lissage"

#: app.py:267
msgid "Game Setup"
msgstr "Configuration du jeu"

#: app.py:268
#, python-brace-format
msgid "Starts {program}, for sound and controls"
msgstr "Lance {program}, pour le son et les commandes"

#: app.py:300
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Impossible d’enregistrer : {error}"

#: app.py:313
#, python-brace-format
msgid "Could not start: {error}"
msgstr "Impossible de démarrer : {error}"

#: app.py:327
msgid "Its folder is deleted, saved games included."
msgstr "Son dossier est supprimé, sauvegardes comprises."

#: app.py:329
msgid "Its files are deleted. Saved games stay in ScummVM."
msgstr "Ses fichiers sont supprimés. Les sauvegardes restent dans ScummVM."

#: app.py:331
msgid "It is taken off the list; its files stay where they are."
msgstr "Il est retiré de la liste ; ses fichiers restent où ils sont."

#: app.py:332
#, python-brace-format
msgid "Remove “{title}”?"
msgstr "Supprimer « {title} » ?"

#: app.py:334 app.py:520 app.py:560
msgid "Cancel"
msgstr "Annuler"

#: app.py:335
msgid "Remove"
msgstr "Supprimer"

#: app.py:347
#, python-brace-format
msgid "Could not remove: {error}"
msgstr "Impossible de supprimer : {error}"

#: app.py:373
msgid "The DOS Installer finds the game by itself: it runs the installer if there is one and adds the game to the app grid with its icon."
msgstr "Le DOS Installer trouve le jeu tout seul : il lance l'installateur s'il y en a un et ajoute le jeu avec son icône à la grille des applications."

#: app.py:415
msgid "These files do not go together."
msgstr "Ces fichiers ne vont pas ensemble."

#: app.py:430
msgid "Getting Ready"
msgstr "Préparation"

#: app.py:436
msgid "Installing"
msgstr "Installation"

#: app.py:467
msgid "Insert Next Disk"
msgstr "Insérer la disquette suivante"

#: app.py:470
msgid "If the installer keeps asking for the same disk, insert the next one here."
msgstr "Si l'installateur redemande sans cesse la même disquette, insérez ici la suivante."

#: app.py:480
#, python-brace-format
msgid "Disk {number} of {total}"
msgstr "Disquette {number} sur {total}"

#: app.py:489
#, python-brace-format
msgid "Could not insert the disk: {error}"
msgstr "Impossible d'insérer la disquette : {error}"

#: app.py:505
#, python-brace-format
msgid "DOSBox opens in fullscreen and starts {program}."
msgstr "DOSBox s'ouvre en plein écran et lance {program}."

#: app.py:507
msgid "The keyboard opens by itself, in its Terminal layout: only that one reaches DOSBox."
msgstr "Le clavier s'ouvre tout seul, dans sa disposition Terminal : seule celle-ci parvient à DOSBox."

#: app.py:510
msgid "The disks change by themselves: when the installer asks for the next disk, press Enter. Should it ask again, switch to the DOS Installer and insert the next disk there."
msgstr "Les disquettes changent toutes seules : quand l'installateur demande la disquette suivante, appuyez sur Entrée. S'il la redemande, passez au DOS Installer et insérez-y la disquette suivante."

#: app.py:513
msgid "DOSBox closes when the installer is done."
msgstr "DOSBox se ferme quand l'installateur a terminé."

#: app.py:515
msgid "The Installer Needs a Keyboard"
msgstr "L'installateur a besoin d'un clavier"

#: app.py:519
msgid "Start the Installer"
msgstr "Lancer l'installateur"

#: app.py:524
msgid "Installer"
msgstr "Installateur"

#: app.py:536
msgid "ScummVM does not know this game, so it runs in DOSBox."
msgstr "ScummVM ne connaît pas ce jeu, il tourne donc dans DOSBox."

#: app.py:537
msgid "Name"
msgstr "Nom"

#: app.py:540 app.py:565
msgid "Start File"
msgstr "Fichier de démarrage"

#: app.py:554
msgid "No start file was found."
msgstr "Aucun fichier de démarrage trouvé."

#: app.py:558
msgid "Add the Game"
msgstr "Ajouter le jeu"

#: app.py:584
msgid "Installation Failed"
msgstr "Échec de l'installation"

#: app.py:585
msgid "OK"
msgstr "OK"

#: app.py:589
#, python-brace-format
msgid "“{title}” Is Installed"
msgstr "« {title} » est installé"

#: app.py:590
msgid "You find it in the app grid."
msgstr "Vous le trouverez dans la grille des applications."

#: app.py:601
msgid "Done"
msgstr "Terminé"

#: app.py:611
msgid "Installed"
msgstr "Installé"

#: install.py:119
msgid "Looking up the game"
msgstr "Recherche des informations du jeu"

#: install.py:122
msgid "Reading the disks"
msgstr "Lecture des disquettes"

#: install.py:129
msgid "Reading the CD"
msgstr "Lecture du CD"

#: install.py:132
msgid "Unpacking"
msgstr "Décompression"

#: install.py:145 install.py:186
msgid "Looking for the game"
msgstr "Recherche du jeu"

#: install.py:150 install.py:243
msgid "Copying the game"
msgstr "Copie du jeu"

#: install.py:168
#, python-brace-format
msgid "Installing {title}"
msgstr "Installation de {title}"

#: install.py:172
msgid "The installer is running"
msgstr "L'installateur est en cours"

#: install.py:184
msgid "The installer did not install anything."
msgstr "L'installateur n'a rien installé."

#: install.py:231
msgid "Adding the game"
msgstr "Ajout du jeu"

#: install.py:235
msgid "ScummVM did not take the game."
msgstr "ScummVM n'a pas pris le jeu."
