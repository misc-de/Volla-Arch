#: app.py:31
msgid "Floppy Disk Images"
msgstr "Imagens de disquete"

#: app.py:32
msgid "Disk 1 is enough, the other disks in its folder come along"
msgstr "Basta o disquete 1, os outros da sua pasta vêm junto"

#: app.py:34
msgid "CD Image"
msgstr "Imagem de CD"

#: app.py:34
msgid ".iso, or .cue with its tracks"
msgstr ".iso, ou .cue com as suas faixas"

#: app.py:36
msgid "ZIP Archive"
msgstr "Arquivo ZIP"

#: app.py:36
msgid "A packed game, such as a freeware download"
msgstr "Um jogo comprimido, como uma transferência freeware"

#: app.py:38
msgid "GOG Installer"
msgstr "Instalador GOG"

#: app.py:38
msgid "setup_….exe from GOG"
msgstr "setup_….exe da GOG"

#: app.py:40
msgid "Folder"
msgstr "Pasta"

#: app.py:40
msgid "The game's files, or a copy of its disks"
msgstr "Os ficheiros do jogo, ou uma cópia dos seus discos"

#: app.py:133 app.py:167
msgid "DOS Installer"
msgstr "DOS Installer"

#: app.py:149 app.py:158 app.py:383
msgid "Install a Game"
msgstr "Instalar um jogo"

#: app.py:154
msgid "No Games Yet"
msgstr "Ainda sem jogos"

#: app.py:155
msgid "Install a DOS game from floppy disk images, a CD image, a ZIP archive, a GOG installer or a folder."
msgstr "Instale um jogo DOS a partir de imagens de disquete, uma imagem de CD, um arquivo ZIP, um instalador GOG ou uma pasta."

#: app.py:174
msgid "Games"
msgstr "Jogos"

#: app.py:185 app.py:600
msgid "Play"
msgstr "Jogar"

#: app.py:188
msgid "Settings"
msgstr "Configurações"

#: app.py:205
msgid "Uninstall Game"
msgstr "Desinstalar o jogo"

#: app.py:216
msgid "Controls"
msgstr "Controlos"

#: app.py:217
msgid "Touch Joystick"
msgstr "Joystick de toque"

#: app.py:218
msgid "Stick and buttons beside the picture"
msgstr "Direcional e botões ao lado da imagem"

#: app.py:223
msgid "Arrow Keys"
msgstr "Setas"

#: app.py:223
msgid "Number Pad"
msgstr "Teclado numérico"

#: app.py:225
msgid "Stick"
msgstr "Stick"

#: app.py:225
msgid "The keys it presses"
msgstr "As teclas que carrega"

#: app.py:233
msgid "Mouse Speed"
msgstr "Velocidade do rato"

#: app.py:234
msgid "How far a swipe moves the mouse, in percent"
msgstr "Quanto um deslize move o rato, em percentagem"

#: app.py:243
msgid "Game"
msgstr "Jogo"

#: app.py:247
msgid "Automatic"
msgstr "Automática"

#: app.py:247
msgid "Slow (286)"
msgstr "Lenta (286)"

#: app.py:247
msgid "Medium (386)"
msgstr "Média (386)"

#: app.py:247
msgid "Fast (486)"
msgstr "Rápida (486)"

#: app.py:248
msgid "Maximum"
msgstr "Máxima"

#: app.py:253
msgid "CPU Speed"
msgstr "Velocidade da CPU"

#: app.py:254
msgid "Slower if the game is too fast"
msgstr "Mais lenta se o jogo correr depressa demais"

#: app.py:259
msgid "Sharp Pixels"
msgstr "Píxeis nítidos"

#: app.py:260
msgid "The picture without smoothing"
msgstr "A imagem sem suavização"

#: app.py:267
msgid "Game Setup"
msgstr "Configuração do jogo"

#: app.py:268
#, python-brace-format
msgid "Starts {program}, for sound and controls"
msgstr "Inicia {program}, para som e controlos"

#: app.py:300
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Não foi possível salvar: {error}"

#: app.py:313
#, python-brace-format
msgid "Could not start: {error}"
msgstr "Não foi possível iniciar: {error}"

#: app.py:327
msgid "Its folder is deleted, saved games included."
msgstr "A sua pasta é apagada, incluindo os jogos guardados."

#: app.py:329
msgid "Its files are deleted. Saved games stay in ScummVM."
msgstr "Os seus ficheiros são apagados. Os jogos guardados ficam no ScummVM."

#: app.py:331
msgid "It is taken off the list; its files stay where they are."
msgstr "É retirado da lista; os seus ficheiros ficam onde estão."

#: app.py:332
#, python-brace-format
msgid "Remove “{title}”?"
msgstr "Remover “{title}”?"

#: app.py:334 app.py:520 app.py:560
msgid "Cancel"
msgstr "Cancelar"

#: app.py:335
msgid "Remove"
msgstr "Remover"

#: app.py:347
#, python-brace-format
msgid "Could not remove: {error}"
msgstr "Não foi possível remover: {error}"

#: app.py:373
msgid "The DOS Installer finds the game by itself: it runs the installer if there is one and adds the game to the app grid with its icon."
msgstr "O DOS Installer encontra o jogo sozinho: executa o instalador, se houver, e adiciona o jogo com o seu ícone à grelha de aplicações."

#: app.py:415
msgid "These files do not go together."
msgstr "Estes ficheiros não pertencem ao mesmo jogo."

#: app.py:430
msgid "Getting Ready"
msgstr "A preparar"

#: app.py:436
msgid "Installing"
msgstr "A instalar"

#: app.py:467
msgid "Insert Next Disk"
msgstr "Inserir o disquete seguinte"

#: app.py:470
msgid "If the installer keeps asking for the same disk, insert the next one here."
msgstr "Se o instalador continuar a pedir o mesmo disquete, insira aqui o seguinte."

#: app.py:480
#, python-brace-format
msgid "Disk {number} of {total}"
msgstr "Disquete {number} de {total}"

#: app.py:489
#, python-brace-format
msgid "Could not insert the disk: {error}"
msgstr "Não foi possível inserir o disquete: {error}"

#: app.py:505
#, python-brace-format
msgid "DOSBox opens in fullscreen and starts {program}."
msgstr "O DOSBox abre em ecrã inteiro e inicia {program}."

#: app.py:507
msgid "The keyboard opens by itself, in its Terminal layout: only that one reaches DOSBox."
msgstr "O teclado abre sozinho, na disposição Terminal: só essa chega ao DOSBox."

#: app.py:510
msgid "The disks change by themselves: when the installer asks for the next disk, press Enter. Should it ask again, switch to the DOS Installer and insert the next disk there."
msgstr "Os disquetes mudam sozinhos: quando o instalador pedir o disquete seguinte, prima Enter. Se voltar a pedir, mude para o DOS Installer e insira lá o disquete seguinte."

#: app.py:513
msgid "DOSBox closes when the installer is done."
msgstr "O DOSBox fecha quando o instalador termina."

#: app.py:515
msgid "The Installer Needs a Keyboard"
msgstr "O instalador precisa de um teclado"

#: app.py:519
msgid "Start the Installer"
msgstr "Iniciar o instalador"

#: app.py:524
msgid "Installer"
msgstr "Instalador"

#: app.py:536
msgid "ScummVM does not know this game, so it runs in DOSBox."
msgstr "O ScummVM não conhece este jogo, por isso corre no DOSBox."

#: app.py:537
msgid "Name"
msgstr "Nome"

#: app.py:540 app.py:565
msgid "Start File"
msgstr "Ficheiro de arranque"

#: app.py:554
msgid "No start file was found."
msgstr "Nenhum ficheiro de arranque encontrado."

#: app.py:558
msgid "Add the Game"
msgstr "Adicionar o jogo"

#: app.py:584
msgid "Installation Failed"
msgstr "A instalação falhou"

#: app.py:585
msgid "OK"
msgstr "OK"

#: app.py:589
#, python-brace-format
msgid "“{title}” Is Installed"
msgstr "“{title}” está instalado"

#: app.py:590
msgid "You find it in the app grid."
msgstr "Encontra-o na grelha de aplicações."

#: app.py:601
msgid "Done"
msgstr "Concluído"

#: app.py:611
msgid "Installed"
msgstr "Instalado"

#: install.py:119
msgid "Looking up the game"
msgstr "A consultar o jogo"

#: install.py:122
msgid "Reading the disks"
msgstr "A ler os disquetes"

#: install.py:129
msgid "Reading the CD"
msgstr "A ler o CD"

#: install.py:132
msgid "Unpacking"
msgstr "A descomprimir"

#: install.py:145 install.py:186
msgid "Looking for the game"
msgstr "A procurar o jogo"

#: install.py:150 install.py:243
msgid "Copying the game"
msgstr "A copiar o jogo"

#: install.py:168
#, python-brace-format
msgid "Installing {title}"
msgstr "A instalar {title}"

#: install.py:172
msgid "The installer is running"
msgstr "O instalador está a correr"

#: install.py:184
msgid "The installer did not install anything."
msgstr "O instalador não instalou nada."

#: install.py:231
msgid "Adding the game"
msgstr "A adicionar o jogo"

#: install.py:235
msgid "ScummVM did not take the game."
msgstr "O ScummVM não aceitou o jogo."
