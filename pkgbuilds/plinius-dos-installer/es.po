#: app.py:31
msgid "Floppy Disk Images"
msgstr "Imágenes de disquete"

#: app.py:32
msgid "Disk 1 is enough, the other disks in its folder come along"
msgstr "Basta el disquete 1, los demás de su carpeta se añaden solos"

#: app.py:34
msgid "CD Image"
msgstr "Imagen de CD"

#: app.py:34
msgid ".iso, or .cue with its tracks"
msgstr ".iso, o .cue con sus pistas"

#: app.py:36
msgid "ZIP Archive"
msgstr "Archivo ZIP"

#: app.py:36
msgid "A packed game, such as a freeware download"
msgstr "Un juego comprimido, como una descarga gratuita"

#: app.py:38
msgid "GOG Installer"
msgstr "Instalador de GOG"

#: app.py:38
msgid "setup_….exe from GOG"
msgstr "setup_….exe de GOG"

#: app.py:40
msgid "Folder"
msgstr "Carpeta"

#: app.py:40
msgid "The game's files, or a copy of its disks"
msgstr "Los archivos del juego o una copia de sus discos"

#: app.py:133 app.py:167
msgid "DOS Installer"
msgstr "DOS Installer"

#: app.py:149 app.py:158 app.py:383
msgid "Install a Game"
msgstr "Instalar un juego"

#: app.py:154
msgid "No Games Yet"
msgstr "Aún no hay juegos"

#: app.py:155
msgid "Install a DOS game from floppy disk images, a CD image, a ZIP archive, a GOG installer or a folder."
msgstr "Instala un juego de DOS desde imágenes de disquete, una imagen de CD, un archivo ZIP, un instalador de GOG o una carpeta."

#: app.py:174
msgid "Games"
msgstr "Juegos"

#: app.py:185 app.py:600
msgid "Play"
msgstr "Jugar"

#: app.py:188
msgid "Settings"
msgstr "Ajustes"

#: app.py:205
msgid "Uninstall Game"
msgstr "Desinstalar el juego"

#: app.py:216
msgid "Controls"
msgstr "Controles"

#: app.py:217
msgid "Touch Joystick"
msgstr "Joystick táctil"

#: app.py:218
msgid "Stick and buttons beside the picture"
msgstr "Stick y botones junto a la imagen"

#: app.py:223
msgid "Arrow Keys"
msgstr "Flechas"

#: app.py:223
msgid "Number Pad"
msgstr "Teclado numérico"

#: app.py:225
msgid "Stick"
msgstr "Stick"

#: app.py:225
msgid "The keys it presses"
msgstr "Las teclas que pulsa"

#: app.py:233
msgid "Mouse Speed"
msgstr "Velocidad del ratón"

#: app.py:234
msgid "How far a swipe moves the mouse, in percent"
msgstr "Cuánto mueve el ratón un deslizamiento, en porcentaje"

#: app.py:243
msgid "Game"
msgstr "Juego"

#: app.py:247
msgid "Automatic"
msgstr "Automática"

#: app.py:247
msgid "Slow (286)"
msgstr "Lenta (286)"

#: app.py:247
msgid "Medium (386)"
msgstr "Media (386)"

#: app.py:247
msgid "Fast (486)"
msgstr "Rápida (486)"

#: app.py:248
msgid "Maximum"
msgstr "Máxima"

#: app.py:253
msgid "CPU Speed"
msgstr "Velocidad de CPU"

#: app.py:254
msgid "Slower if the game is too fast"
msgstr "Más lenta si el juego va demasiado rápido"

#: app.py:259
msgid "Sharp Pixels"
msgstr "Píxeles nítidos"

#: app.py:260
msgid "The picture without smoothing"
msgstr "La imagen sin suavizado"

#: app.py:267
msgid "Game Setup"
msgstr "Configuración del juego"

#: app.py:268
#, python-brace-format
msgid "Starts {program}, for sound and controls"
msgstr "Inicia {program}, para sonido y controles"

#: app.py:300
#, python-brace-format
msgid "Could not save: {error}"
msgstr "No se pudo guardar: {error}"

#: app.py:313
#, python-brace-format
msgid "Could not start: {error}"
msgstr "No se pudo iniciar: {error}"

#: app.py:327
msgid "Its folder is deleted, saved games included."
msgstr "Se borra su carpeta, incluidas las partidas guardadas."

#: app.py:329
msgid "Its files are deleted. Saved games stay in ScummVM."
msgstr "Se borran sus archivos. Las partidas guardadas se quedan en ScummVM."

#: app.py:331
msgid "It is taken off the list; its files stay where they are."
msgstr "Se quita de la lista; sus archivos se quedan donde están."

#: app.py:332
#, python-brace-format
msgid "Remove “{title}”?"
msgstr "¿Quitar «{title}»?"

#: app.py:334 app.py:520 app.py:560
msgid "Cancel"
msgstr "Cancelar"

#: app.py:335
msgid "Remove"
msgstr "Quitar"

#: app.py:347
#, python-brace-format
msgid "Could not remove: {error}"
msgstr "No se pudo quitar: {error}"

#: app.py:373
msgid "The DOS Installer finds the game by itself: it runs the installer if there is one and adds the game to the app grid with its icon."
msgstr "El DOS Installer encuentra el juego por sí solo: ejecuta el instalador si lo hay y añade el juego con su icono a la cuadrícula de aplicaciones."

#: app.py:415
msgid "These files do not go together."
msgstr "Estos archivos no van juntos."

#: app.py:430
msgid "Getting Ready"
msgstr "Preparando"

#: app.py:436
msgid "Installing"
msgstr "Instalando"

#: app.py:467
msgid "Insert Next Disk"
msgstr "Insertar el siguiente disquete"

#: app.py:470
msgid "If the installer keeps asking for the same disk, insert the next one here."
msgstr "Si el instalador sigue pidiendo el mismo disquete, inserta aquí el siguiente."

#: app.py:480
#, python-brace-format
msgid "Disk {number} of {total}"
msgstr "Disquete {number} de {total}"

#: app.py:489
#, python-brace-format
msgid "Could not insert the disk: {error}"
msgstr "No se pudo insertar el disquete: {error}"

#: app.py:505
#, python-brace-format
msgid "DOSBox opens in fullscreen and starts {program}."
msgstr "DOSBox se abre a pantalla completa e inicia {program}."

#: app.py:507
msgid "The keyboard opens by itself, in its Terminal layout: only that one reaches DOSBox."
msgstr "El teclado se abre solo, con la distribución Terminal: solo esa llega a DOSBox."

#: app.py:510
msgid "The disks change by themselves: when the installer asks for the next disk, press Enter. Should it ask again, switch to the DOS Installer and insert the next disk there."
msgstr "Los disquetes cambian solos: cuando el instalador pida el siguiente disquete, pulsa Intro. Si vuelve a pedirlo, cambia al DOS Installer e inserta allí el siguiente disquete."

#: app.py:513
msgid "DOSBox closes when the installer is done."
msgstr "DOSBox se cierra cuando el instalador termina."

#: app.py:515
msgid "The Installer Needs a Keyboard"
msgstr "El instalador necesita un teclado"

#: app.py:519
msgid "Start the Installer"
msgstr "Iniciar el instalador"

#: app.py:524
msgid "Installer"
msgstr "Instalador"

#: app.py:536
msgid "ScummVM does not know this game, so it runs in DOSBox."
msgstr "ScummVM no conoce este juego, así que se ejecuta en DOSBox."

#: app.py:537
msgid "Name"
msgstr "Nombre"

#: app.py:540 app.py:565
msgid "Start File"
msgstr "Archivo de inicio"

#: app.py:554
msgid "No start file was found."
msgstr "No se encontró ningún archivo de inicio."

#: app.py:558
msgid "Add the Game"
msgstr "Añadir el juego"

#: app.py:584
msgid "Installation Failed"
msgstr "La instalación falló"

#: app.py:585
msgid "OK"
msgstr "Aceptar"

#: app.py:589
#, python-brace-format
msgid "“{title}” Is Installed"
msgstr "«{title}» está instalado"

#: app.py:590
msgid "You find it in the app grid."
msgstr "Lo encontrarás en la cuadrícula de aplicaciones."

#: app.py:601
msgid "Done"
msgstr "Hecho"

#: app.py:611
msgid "Installed"
msgstr "Instalado"

#: install.py:119
msgid "Looking up the game"
msgstr "Consultando el juego"

#: install.py:122
msgid "Reading the disks"
msgstr "Leyendo los disquetes"

#: install.py:129
msgid "Reading the CD"
msgstr "Leyendo el CD"

#: install.py:132
msgid "Unpacking"
msgstr "Descomprimiendo"

#: install.py:145 install.py:186
msgid "Looking for the game"
msgstr "Buscando el juego"

#: install.py:150 install.py:243
msgid "Copying the game"
msgstr "Copiando el juego"

#: install.py:168
#, python-brace-format
msgid "Installing {title}"
msgstr "Instalando {title}"

#: install.py:172
msgid "The installer is running"
msgstr "El instalador está en marcha"

#: install.py:184
msgid "The installer did not install anything."
msgstr "El instalador no instaló nada."

#: install.py:231
msgid "Adding the game"
msgstr "Añadiendo el juego"

#: install.py:235
msgid "ScummVM did not take the game."
msgstr "ScummVM no aceptó el juego."
