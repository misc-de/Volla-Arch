#: app.py:31
msgid "Floppy Disk Images"
msgstr "Diskettenabbilder"

#: app.py:32
msgid "Disk 1 is enough, the other disks in its folder come along"
msgstr "Diskette 1 genügt, die anderen aus ihrem Ordner kommen mit"

#: app.py:34
msgid "CD Image"
msgstr "CD-Abbild"

#: app.py:34
msgid ".iso, or .cue with its tracks"
msgstr ".iso oder .cue mit ihren Spuren"

#: app.py:36
msgid "ZIP Archive"
msgstr "ZIP-Archiv"

#: app.py:36
msgid "A packed game, such as a freeware download"
msgstr "Ein gepacktes Spiel, etwa ein Freeware-Download"

#: app.py:38
msgid "GOG Installer"
msgstr "GOG-Installer"

#: app.py:38
msgid "setup_….exe from GOG"
msgstr "setup_….exe von GOG"

#: app.py:40
msgid "Folder"
msgstr "Ordner"

#: app.py:40
msgid "The game's files, or a copy of its disks"
msgstr "Die Dateien des Spiels oder eine Kopie seiner Disketten"

#: app.py:133 app.py:167
msgid "DOS Installer"
msgstr "DOS Installer"

#: app.py:149 app.py:158 app.py:383
msgid "Install a Game"
msgstr "Spiel installieren"

#: app.py:154
msgid "No Games Yet"
msgstr "Noch keine Spiele"

#: app.py:155
msgid "Install a DOS game from floppy disk images, a CD image, a ZIP archive, a GOG installer or a folder."
msgstr "Installiere ein DOS-Spiel aus Diskettenabbildern, einem CD-Abbild, einem ZIP-Archiv, einem GOG-Installer oder einem Ordner."

#: app.py:174
msgid "Games"
msgstr "Spiele"

#: app.py:185 app.py:600
msgid "Play"
msgstr "Spielen"

#: app.py:188
msgid "Settings"
msgstr "Einstellungen"

#: app.py:205
msgid "Uninstall Game"
msgstr "Spiel deinstallieren"

#: app.py:216
msgid "Controls"
msgstr "Steuerung"

#: app.py:217
msgid "Touch Joystick"
msgstr "Touch-Joystick"

#: app.py:218
msgid "Stick and buttons beside the picture"
msgstr "Stick und Tasten neben dem Bild"

#: app.py:223
msgid "Arrow Keys"
msgstr "Pfeiltasten"

#: app.py:223
msgid "Number Pad"
msgstr "Ziffernblock"

#: app.py:225
msgid "Stick"
msgstr "Stick"

#: app.py:225
msgid "The keys it presses"
msgstr "Die Tasten, die er drückt"

#: app.py:233
msgid "Mouse Speed"
msgstr "Mausgeschwindigkeit"

#: app.py:234
msgid "How far a swipe moves the mouse, in percent"
msgstr "Wie weit ein Wischen die Maus bewegt, in Prozent"

#: app.py:243
msgid "Game"
msgstr "Spiel"

#: app.py:247
msgid "Automatic"
msgstr "Automatisch"

#: app.py:247
msgid "Slow (286)"
msgstr "Langsam (286)"

#: app.py:247
msgid "Medium (386)"
msgstr "Mittel (386)"

#: app.py:247
msgid "Fast (486)"
msgstr "Schnell (486)"

#: app.py:248
msgid "Maximum"
msgstr "Maximum"

#: app.py:253
msgid "CPU Speed"
msgstr "CPU-Takt"

#: app.py:254
msgid "Slower if the game is too fast"
msgstr "Langsamer, wenn das Spiel zu schnell läuft"

#: app.py:259
msgid "Sharp Pixels"
msgstr "Scharfe Pixel"

#: app.py:260
msgid "The picture without smoothing"
msgstr "Das Bild ohne Glättung"

#: app.py:267
msgid "Game Setup"
msgstr "Setup des Spiels"

#: app.py:268
#, python-brace-format
msgid "Starts {program}, for sound and controls"
msgstr "Startet {program}, für Sound und Steuerung"

#: app.py:300
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Speichern fehlgeschlagen: {error}"

#: app.py:313
#, python-brace-format
msgid "Could not start: {error}"
msgstr "Start fehlgeschlagen: {error}"

#: app.py:327
msgid "Its folder is deleted, saved games included."
msgstr "Sein Ordner wird gelöscht, samt Spielständen."

#: app.py:329
msgid "Its files are deleted. Saved games stay in ScummVM."
msgstr "Seine Dateien werden gelöscht. Spielstände bleiben in ScummVM."

#: app.py:331
msgid "It is taken off the list; its files stay where they are."
msgstr "Es verschwindet aus der Liste; seine Dateien bleiben, wo sie sind."

#: app.py:332
#, python-brace-format
msgid "Remove “{title}”?"
msgstr "„{title}“ entfernen?"

#: app.py:334 app.py:520 app.py:560
msgid "Cancel"
msgstr "Abbrechen"

#: app.py:335
msgid "Remove"
msgstr "Entfernen"

#: app.py:347
#, python-brace-format
msgid "Could not remove: {error}"
msgstr "Entfernen fehlgeschlagen: {error}"

#: app.py:373
msgid "The DOS Installer finds the game by itself: it runs the installer if there is one and adds the game to the app grid with its icon."
msgstr "Der DOS Installer findet das Spiel selbst: Er startet den Installer, falls es einen gibt, und legt das Spiel mit seinem Icon in die App-Übersicht."

#: app.py:415
msgid "These files do not go together."
msgstr "Diese Dateien gehören nicht zusammen."

#: app.py:430
msgid "Getting Ready"
msgstr "Wird vorbereitet"

#: app.py:436
msgid "Installing"
msgstr "Installation"

#: app.py:467
msgid "Insert Next Disk"
msgstr "Nächste Diskette einlegen"

#: app.py:470
msgid "If the installer keeps asking for the same disk, insert the next one here."
msgstr "Fragt der Installer immer wieder nach derselben Diskette, lege hier die nächste ein."

#: app.py:480
#, python-brace-format
msgid "Disk {number} of {total}"
msgstr "Diskette {number} von {total}"

#: app.py:489
#, python-brace-format
msgid "Could not insert the disk: {error}"
msgstr "Diskette konnte nicht eingelegt werden: {error}"

#: app.py:505
#, python-brace-format
msgid "DOSBox opens in fullscreen and starts {program}."
msgstr "DOSBox öffnet sich im Vollbild und startet {program}."

#: app.py:507
msgid "The keyboard opens by itself, in its Terminal layout: only that one reaches DOSBox."
msgstr "Die Tastatur öffnet sich von selbst im Layout „Terminal“: Nur dieses erreicht DOSBox."

#: app.py:510
msgid "The disks change by themselves: when the installer asks for the next disk, press Enter. Should it ask again, switch to the DOS Installer and insert the next disk there."
msgstr "Die Disketten wechseln von selbst: Fragt der Installer nach der nächsten Diskette, drücke Enter. Fragt er noch einmal, wechsle zum DOS Installer und lege dort die nächste Diskette ein."

#: app.py:513
msgid "DOSBox closes when the installer is done."
msgstr "DOSBox schließt sich, wenn der Installer fertig ist."

#: app.py:515
msgid "The Installer Needs a Keyboard"
msgstr "Der Installer braucht eine Tastatur"

#: app.py:519
msgid "Start the Installer"
msgstr "Installer starten"

#: app.py:524
msgid "Installer"
msgstr "Installer"

#: app.py:536
msgid "ScummVM does not know this game, so it runs in DOSBox."
msgstr "ScummVM kennt dieses Spiel nicht, deshalb läuft es in DOSBox."

#: app.py:537
msgid "Name"
msgstr "Name"

#: app.py:540 app.py:565
msgid "Start File"
msgstr "Startdatei"

#: app.py:554
msgid "No start file was found."
msgstr "Keine Startdatei gefunden."

#: app.py:558
msgid "Add the Game"
msgstr "Spiel hinzufügen"

#: app.py:584
msgid "Installation Failed"
msgstr "Installation fehlgeschlagen"

#: app.py:585
msgid "OK"
msgstr "OK"

#: app.py:589
#, python-brace-format
msgid "“{title}” Is Installed"
msgstr "„{title}“ ist installiert"

#: app.py:590
msgid "You find it in the app grid."
msgstr "Du findest es in der App-Übersicht."

#: app.py:601
msgid "Done"
msgstr "Fertig"

#: app.py:611
msgid "Installed"
msgstr "Installiert"

#: install.py:119
msgid "Looking up the game"
msgstr "Spiel wird nachgeschlagen"

#: install.py:122
msgid "Reading the disks"
msgstr "Disketten werden gelesen"

#: install.py:129
msgid "Reading the CD"
msgstr "CD wird gelesen"

#: install.py:132
msgid "Unpacking"
msgstr "Wird entpackt"

#: install.py:145 install.py:186
msgid "Looking for the game"
msgstr "Spiel wird gesucht"

#: install.py:150 install.py:243
msgid "Copying the game"
msgstr "Spiel wird kopiert"

#: install.py:168
#, python-brace-format
msgid "Installing {title}"
msgstr "{title} wird installiert"

#: install.py:172
msgid "The installer is running"
msgstr "Der Installer läuft"

#: install.py:184
msgid "The installer did not install anything."
msgstr "Der Installer hat nichts installiert."

#: install.py:231
msgid "Adding the game"
msgstr "Spiel wird hinzugefügt"

#: install.py:235
msgid "ScummVM did not take the game."
msgstr "ScummVM hat das Spiel nicht übernommen."
