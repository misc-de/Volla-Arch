#: app.py:31
msgid "Floppy Disk Images"
msgstr "Obrazy dyskietek"

#: app.py:32
msgid "Disk 1 is enough, the other disks in its folder come along"
msgstr "Wystarczy dyskietka 1, pozostałe z jej folderu dołączą same"

#: app.py:34
msgid "CD Image"
msgstr "Obraz płyty CD"

#: app.py:34
msgid ".iso, or .cue with its tracks"
msgstr ".iso albo .cue z jego ścieżkami"

#: app.py:36
msgid "ZIP Archive"
msgstr "Archiwum ZIP"

#: app.py:36
msgid "A packed game, such as a freeware download"
msgstr "Spakowana gra, np. pobrana gra freeware"

#: app.py:38
msgid "GOG Installer"
msgstr "Instalator GOG"

#: app.py:38
msgid "setup_….exe from GOG"
msgstr "setup_….exe z GOG"

#: app.py:40
msgid "Folder"
msgstr "Folder"

#: app.py:40
msgid "The game's files, or a copy of its disks"
msgstr "Pliki gry albo kopia jej dysków"

#: app.py:133 app.py:167
msgid "DOS Installer"
msgstr "DOS Installer"

#: app.py:149 app.py:158 app.py:383
msgid "Install a Game"
msgstr "Zainstaluj grę"

#: app.py:154
msgid "No Games Yet"
msgstr "Brak gier"

#: app.py:155
msgid "Install a DOS game from floppy disk images, a CD image, a ZIP archive, a GOG installer or a folder."
msgstr "Zainstaluj grę DOS z obrazów dyskietek, obrazu płyty CD, archiwum ZIP, instalatora GOG lub folderu."

#: app.py:174
msgid "Games"
msgstr "Gry"

#: app.py:185 app.py:600
msgid "Play"
msgstr "Graj"

#: app.py:188
msgid "Settings"
msgstr "Ustawienia"

#: app.py:205
msgid "Uninstall Game"
msgstr "Odinstaluj grę"

#: app.py:216
msgid "Controls"
msgstr "Sterowanie"

#: app.py:217
msgid "Touch Joystick"
msgstr "Dotykowy joystick"

#: app.py:218
msgid "Stick and buttons beside the picture"
msgstr "Gałka i przyciski obok obrazu"

#: app.py:223
msgid "Arrow Keys"
msgstr "Strzałki"

#: app.py:223
msgid "Number Pad"
msgstr "Klawiatura numeryczna"

#: app.py:225
msgid "Stick"
msgstr "Drążek"

#: app.py:225
msgid "The keys it presses"
msgstr "Klawisze, które naciska"

#: app.py:233
msgid "Mouse Speed"
msgstr "Szybkość myszy"

#: app.py:234
msgid "How far a swipe moves the mouse, in percent"
msgstr "Jak daleko przesunięcie palcem porusza mysz, w procentach"

#: app.py:243
msgid "Game"
msgstr "Gra"

#: app.py:247
msgid "Automatic"
msgstr "Automatyczna"

#: app.py:247
msgid "Slow (286)"
msgstr "Wolna (286)"

#: app.py:247
msgid "Medium (386)"
msgstr "Średnia (386)"

#: app.py:247
msgid "Fast (486)"
msgstr "Szybka (486)"

#: app.py:248
msgid "Maximum"
msgstr "Maksymalna"

#: app.py:253
msgid "CPU Speed"
msgstr "Szybkość procesora"

#: app.py:254
msgid "Slower if the game is too fast"
msgstr "Wolniej, gdy gra działa za szybko"

#: app.py:259
msgid "Sharp Pixels"
msgstr "Ostre piksele"

#: app.py:260
msgid "The picture without smoothing"
msgstr "Obraz bez wygładzania"

#: app.py:267
msgid "Game Setup"
msgstr "Konfiguracja gry"

#: app.py:268
#, python-brace-format
msgid "Starts {program}, for sound and controls"
msgstr "Uruchamia {program}, dla dźwięku i sterowania"

#: app.py:300
#, python-brace-format
msgid "Could not save: {error}"
msgstr "Nie udało się zapisać: {error}"

#: app.py:313
#, python-brace-format
msgid "Could not start: {error}"
msgstr "Nie udało się uruchomić: {error}"

#: app.py:327
msgid "Its folder is deleted, saved games included."
msgstr "Jej folder zostanie usunięty razem z zapisami gry."

#: app.py:329
msgid "Its files are deleted. Saved games stay in ScummVM."
msgstr "Jej pliki zostaną usunięte. Zapisy gry pozostaną w ScummVM."

#: app.py:331
msgid "It is taken off the list; its files stay where they are."
msgstr "Zniknie z listy; jej pliki pozostaną na miejscu."

#: app.py:332
#, python-brace-format
msgid "Remove “{title}”?"
msgstr "Usunąć „{title}”?"

#: app.py:334 app.py:520 app.py:560
msgid "Cancel"
msgstr "Anuluj"

#: app.py:335
msgid "Remove"
msgstr "Usuń"

#: app.py:347
#, python-brace-format
msgid "Could not remove: {error}"
msgstr "Nie udało się usunąć: {error}"

#: app.py:373
msgid "The DOS Installer finds the game by itself: it runs the installer if there is one and adds the game to the app grid with its icon."
msgstr "DOS Installer sam znajduje grę: uruchamia instalator, jeśli istnieje, i dodaje grę z jej ikoną do siatki aplikacji."

#: app.py:415
msgid "These files do not go together."
msgstr "Te pliki do siebie nie pasują."

#: app.py:430
msgid "Getting Ready"
msgstr "Przygotowywanie"

#: app.py:436
msgid "Installing"
msgstr "Instalowanie"

#: app.py:467
msgid "Insert Next Disk"
msgstr "Włóż następną dyskietkę"

#: app.py:470
msgid "If the installer keeps asking for the same disk, insert the next one here."
msgstr "Jeśli instalator ciągle prosi o tę samą dyskietkę, włóż tutaj następną."

#: app.py:480
#, python-brace-format
msgid "Disk {number} of {total}"
msgstr "Dyskietka {number} z {total}"

#: app.py:489
#, python-brace-format
msgid "Could not insert the disk: {error}"
msgstr "Nie udało się włożyć dyskietki: {error}"

#: app.py:505
#, python-brace-format
msgid "DOSBox opens in fullscreen and starts {program}."
msgstr "DOSBox otworzy się na pełnym ekranie i uruchomi {program}."

#: app.py:507
msgid "The keyboard opens by itself, in its Terminal layout: only that one reaches DOSBox."
msgstr "Klawiatura otworzy się sama, w układzie Terminal: tylko on działa w DOSBox."

#: app.py:510
msgid "The disks change by themselves: when the installer asks for the next disk, press Enter. Should it ask again, switch to the DOS Installer and insert the next disk there."
msgstr "Dyskietki zmieniają się same: gdy instalator poprosi o następną dyskietkę, naciśnij Enter. Jeśli poprosi ponownie, przełącz się do DOS Installer i włóż tam następną dyskietkę."

#: app.py:513
msgid "DOSBox closes when the installer is done."
msgstr "DOSBox zamknie się po zakończeniu instalacji."

#: app.py:515
msgid "The Installer Needs a Keyboard"
msgstr "Instalator potrzebuje klawiatury"

#: app.py:519
msgid "Start the Installer"
msgstr "Uruchom instalator"

#: app.py:524
msgid "Installer"
msgstr "Instalator"

#: app.py:536
msgid "ScummVM does not know this game, so it runs in DOSBox."
msgstr "ScummVM nie zna tej gry, więc działa ona w DOSBox."

#: app.py:537
msgid "Name"
msgstr "Nazwa"

#: app.py:540 app.py:565
msgid "Start File"
msgstr "Plik startowy"

#: app.py:554
msgid "No start file was found."
msgstr "Nie znaleziono pliku startowego."

#: app.py:558
msgid "Add the Game"
msgstr "Dodaj grę"

#: app.py:584
msgid "Installation Failed"
msgstr "Instalacja nie powiodła się"

#: app.py:585
msgid "OK"
msgstr "OK"

#: app.py:589
#, python-brace-format
msgid "“{title}” Is Installed"
msgstr "„{title}” jest zainstalowana"

#: app.py:590
msgid "You find it in the app grid."
msgstr "Znajdziesz ją w siatce aplikacji."

#: app.py:601
msgid "Done"
msgstr "Gotowe"

#: app.py:611
msgid "Installed"
msgstr "Zainstalowano"

#: install.py:119
msgid "Looking up the game"
msgstr "Wyszukiwanie gry"

#: install.py:122
msgid "Reading the disks"
msgstr "Odczytywanie dyskietek"

#: install.py:129
msgid "Reading the CD"
msgstr "Odczytywanie płyty CD"

#: install.py:132
msgid "Unpacking"
msgstr "Rozpakowywanie"

#: install.py:145 install.py:186
msgid "Looking for the game"
msgstr "Szukanie gry"

#: install.py:150 install.py:243
msgid "Copying the game"
msgstr "Kopiowanie gry"

#: install.py:168
#, python-brace-format
msgid "Installing {title}"
msgstr "Instalowanie {title}"

#: install.py:172
msgid "The installer is running"
msgstr "Instalator działa"

#: install.py:184
msgid "The installer did not install anything."
msgstr "Instalator niczego nie zainstalował."

#: install.py:231
msgid "Adding the game"
msgstr "Dodawanie gry"

#: install.py:235
msgid "ScummVM did not take the game."
msgstr "ScummVM nie przyjął gry."
