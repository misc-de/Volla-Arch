build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	local lib="$pkgdir/usr/lib/plinius-dos-installer"
	install -Dm755 plinius-dos-installer -t "$pkgdir/usr/bin"
	for m in "${_modules[@]}"; do
		install -Dm644 "$m" "$lib/dosinstall/$m"
	done
	# The list of games for installing without a network; a newer signed one is fetched
	install -Dm644 presets.json -t "$lib/dosinstall"
	python -m compileall -q -d /usr/lib/plinius-dos-installer "$lib"
	install -Dm755 plinius-scummvm-launchers -t "$pkgdir/usr/bin"
	install -Dm644 plinius-scummvm-launchers.service plinius-scummvm-launchers.path \
		-t "$pkgdir/usr/lib/systemd/user"
	# Once per session, then on every change of the game list or the icon packs
	install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
	ln -s ../plinius-scummvm-launchers.service ../plinius-scummvm-launchers.path \
		"$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
	install -Dm644 org.plinius.DOSInstaller.desktop -t "$pkgdir/usr/share/applications"
	install -Dm644 org.plinius.DOSInstaller.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps"
	install -Dm644 org.plinius.DOSInstaller-symbolic.svg \
		-t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"
	install -Dm644 plinius-dos-installer-hide.hook -t "$pkgdir/usr/share/libalpm/hooks"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-dos-installer.mo"
	done
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
