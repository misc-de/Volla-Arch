# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-dos-installer
pkgver=0.1
pkgrel=11
pkgdesc="Installs MS-DOS games from floppy disk images, CDs, archives or GOG installers, each with a launcher and the game's icon"
arch=(any)
license=(MIT)
# One app instead of ScummVM and DOSBox side by side: the user picks the disks, a CD, a ZIP, a GOG
# installer or a folder, the rest happens by itself (docs/ROADMAP.md, Emulators).
# - Games ScummVM knows run there; the others in DOSBox 0.74 with the phone settings (fullscreen
#   in a 4:3 mode, usescancodes=false for Stevia's Terminal layout).
# - The fullscreen mode is 1440x1080 instead of the desktop size: sdl12-compat scales a fixed
#   mode into the window and DOSBox never hears of a turn, so a mode in the shape of the start
#   orientation left the picture small in the other one (0.1-7).
# - Doom and Wolfenstein 3D turn about 13 times faster by swiping, walk 4 times faster: DOSBox
#   sensitivity 300, Doom's mouse speed 9 and, for turning alone, the mouse driver's sideways
#   sensitivity at its highest (INT 33h 1Ah, set by a small program before the game; "mouse" in
#   a preset). A swipe across the picture had turned Doom by 63 degrees; tried on the phone (0.1-7).
# - A game's launcher starts plinius-touch-controls with DOSBox: stick and buttons beside the
#   4:3 picture (upright below it, lying left and right of it) send the keys; a preset may set
#   them ("touch": stick, buttons, small). The installers keep Stevia (0.1-7).
# - The touch controls can be switched off per game: a DOSBox game's row in the library folds
#   out a switch, kept as "controls" in plinius-game.json (on when missing); Remove moved from
#   the side of the row in there, only Play stays at the side (0.1-8).
# - Instead of folding out, a gear beside Play opens the game's own page: Touch Joystick, below
#   it Uninstall Game (0.1-9).
# - The game's page has more of DOSBox per game (0.1-10): under Controls the keys of the stick
#   (arrows, WASD, number pad) and the mouse speed, DOSBox's sensitivity from 10 to 1000 percent
#   (Doom and Wolfenstein 3D start at 300); under Game the CPU speed (auto, about a 286, 386 or
#   486, max), sharp pixels (output openglnb) and, when there is one beside the game, its own
#   setup (SETUP.EXE and the like), started with --setup. All of it is kept in plinius-game.json;
#   DOSBox's own value leaves a setting out.
# - Doom and Doom II get the keys 1 to 7 for their weapons below Esc and the keyboard button
#   (plinius-touch-controls --keys, 0.1-11), unless the game's settings name keys of their own.
# - Installers from floppies run with all disks unpacked into one folder (own FAT12/16 reader);
#   DOSBox 0.74 can only swap CD images, so the files that differ between the disks are swapped
#   once DOSBox read the current disk's own files (/proc/<pid>/fdinfo).
# - Icons: ScummVM's icon for the game, fetched once from github.com/scummvm/scummvm-icons
#   (GPL-2.0, the full packs are several hundred MB); DOS games get ScummVM's PC icon.
# - plinius-scummvm-launchers writes a launcher for every ScummVM game, also those added in
#   ScummVM itself; a user path unit runs it whenever ScummVM's game list or icons change.
# - ISO images are read with 7-Zip, GOG installers unpacked with innoextract.
# The modules lie flat next to this file (makepkg takes no local sources in subfolders) and go
# into the package dosinstall below /usr/lib/plinius-dos-installer.
# - DOSBox runs as app id "dosbox": Stevia keeps the Terminal layout for it (the only one SDL 1.2
#   understands) and is unfolded over D-Bus while an installer runs (0.1-2).
# - The search for a game starts in the home folder, later one level above the last game's
#   folder (0.1-2).
# The hook hides the launchers of ScummVM and DOSBox, also when they were installed first; they
# come back on removal.
depends=(python python-gobject gtk4 libadwaita dosbox scummvm 7zip innoextract
	# The signed list of games: gpgv and the key of the package repository
	gnupg plinius-keyring
	# The hook uses its launcher hiding script
	device-volla-ansuz
	# Stick and buttons on the screen while a game runs
	'plinius-touch-controls>=0.1-7')
makedepends=(gettext python)
install=plinius-dos-installer.install
_langs=(de es fr it nl pl pt ru)
_modules=(__init__.py __main__.py app.py dosbox.py dosgames.py fat.py finish.py floppies.py install.py
	keyboard.py library.py presets.py scummvm.py sources.py)
source=(plinius-dos-installer
	"${_modules[@]}"
	presets.json
	plinius-scummvm-launchers
	plinius-scummvm-launchers.service
	plinius-scummvm-launchers.path
	org.plinius.DOSInstaller.desktop
	org.plinius.DOSInstaller.svg
	org.plinius.DOSInstaller-symbolic.svg
	plinius-dos-installer-hide.hook
	"${_langs[@]/%/.po}"
	LICENSE)
