# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=libdbusaccess
pkgver=1.0.20
pkgrel=2
pkgdesc="D-Bus access policy library from Sailfish OS (used by nfcd)"
arch=(aarch64 x86_64)
url="https://github.com/sailfishos/libdbusaccess"
license=(BSD-3-Clause)
depends=(glib2 libglibutil)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('1e37ecd9e40304a23b5fc7ae71b0d7424e88ff348287b31a411f6f462c80e3ed')

build() {
	cd "$pkgname-$pkgver"
	make LIBDIR=/usr/lib KEEP_SYMBOLS=1 release pkgconfig
}

package() {
	cd "$pkgname-$pkgver"
	make LIBDIR=/usr/lib DESTDIR="$pkgdir" install-dev
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
