msgid "This username is available."
msgstr "Questo nome utente è disponibile."

msgid "Lower case letters, numbers, hyphens and underscores, starting with a letter, at most 32 characters."
msgstr "Lettere minuscole, numeri, trattini e trattini bassi, iniziando con una lettera, al massimo 32 caratteri."

msgid "A group with this name already exists."
msgstr "Esiste già un gruppo con questo nome."

msgid "A home folder with this name already exists."
msgstr "Esiste già una cartella home con questo nome."

msgid "Checking username…"
msgstr "Verifica del nome utente…"

