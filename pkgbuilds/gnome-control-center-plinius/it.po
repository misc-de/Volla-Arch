# Plinius: NFC panel (cc-nfc-panel.*)
msgid "Switching NFC failed"
msgstr "Impossibile cambiare lo stato dell’NFC"

msgid "Reads NFC tags and talks to cards and terminals held to the back of the phone. It only looks for them while the screen is on."
msgstr "Legge i tag NFC e comunica con carte e terminali avvicinati al retro del telefono. Cerca solo mentre lo schermo è acceso."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Sequenza di sblocco"

msgid "On"
msgstr "Attivo"

msgid "Off"
msgstr "Disattivo"

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "Con una sequenza di sblocco, la schermata di blocco accetta la sequenza o un’impronta digitale al posto del PIN. Inserisci il PIN per continuare."

msgid "PIN"
msgstr "PIN"

msgid "Continue"
msgstr "Continua"

msgid "Wrong PIN. Try again."
msgstr "PIN errato. Riprova."

msgid "Draw your current pattern."
msgstr "Disegna la sequenza attuale."

msgid "Wrong pattern. Try again."
msgstr "Sequenza errata. Riprova."

msgid "Too many wrong tries. Try again later."
msgstr "Troppi tentativi errati. Riprova più tardi."

msgid "Use PIN Instead"
msgstr "Usa invece il PIN"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Disegna una sequenza di sblocco. Collega almeno 6 punti."

msgid "Connect at least 6 points."
msgstr "Collega almeno 6 punti."

msgid "Draw the pattern again to confirm."
msgstr "Disegna di nuovo la sequenza per confermare."

msgid "The patterns do not match. Draw a new one."
msgstr "Le sequenze non corrispondono. Disegnane una nuova."

msgid "The pattern could not be saved."
msgstr "Impossibile salvare la sequenza."

msgid "The pattern could not be removed."
msgstr "Impossibile rimuovere la sequenza."

msgid "Remove Pattern"
msgstr "Rimuovi sequenza"

msgid "Draw Pattern"
msgstr "Disegna la sequenza"

msgid "Wrong Pattern"
msgstr "Sequenza errata"

msgid "Use PIN"
msgstr "Usa il PIN"

msgid "Use Pattern"
msgstr "Usa la sequenza"

