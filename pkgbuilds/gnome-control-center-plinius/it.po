# Device Security › Access Control (cc-plinius-security.c)
msgid "Access Control"
msgstr "Controllo degli accessi"

msgid "SELinux enforces its policy."
msgstr "SELinux applica la sua politica."

msgid "SELinux is on but only logs."
msgstr "SELinux è attivo, ma si limita a registrare."

msgid "No access control. A program that is taken over can reach everything its user can."
msgstr "Nessun controllo degli accessi. Un programma compromesso può raggiungere tutto ciò che raggiunge il suo utente."

msgid "AppArmor is on, but no program is confined yet."
msgstr "AppArmor è attivo, ma non limita ancora alcun programma."

msgid "Access control limits each confined program to what it needs, also when it runs as root: a service taken over through the network cannot read your data or reach other services."
msgstr "Il controllo degli accessi limita ogni programma confinato a ciò che gli serve, anche quando viene eseguito come root: un servizio compromesso tramite la rete non può leggere i tuoi dati né raggiungere altri servizi."

msgid "SELinux, enforcing"
msgstr "SELinux, applicato"

msgid "SELinux, only logging"
msgstr "SELinux, solo registrazione"

msgid "AppArmor"
msgstr "AppArmor"

msgid "In the Kernel"
msgstr "Nel kernel"

msgid "“Logging only”: the profile records what the service does and blocks nothing yet, until its rules are complete."
msgstr "«Solo registrazione»: il profilo registra ciò che fa il servizio e non blocca ancora nulla, finché le sue regole non sono complete."

msgid "Not loaded"
msgstr "Non caricato"

msgid "Enforced"
msgstr "Applicato"

msgid "Logging only"
msgstr "Solo registrazione"

msgid "AppArmor confines %u service; more only log what they do."
msgid_plural "AppArmor confines %u services; more only log what they do."
msgstr[0] "AppArmor limita %u servizio; altri registrano soltanto ciò che fanno."
msgstr[1] "AppArmor limita %u servizi; altri registrano soltanto ciò che fanno."

msgid "AppArmor watches %u service without blocking it yet."
msgid_plural "AppArmor watches %u services without blocking them yet."
msgstr[0] "AppArmor osserva %u servizio senza ancora bloccarlo."
msgstr[1] "AppArmor osserva %u servizi senza ancora bloccarli."

msgid "AppArmor confines %u service of the network and the radio."
msgid_plural "AppArmor confines %u services of the network and the radio."
msgstr[0] "AppArmor limita %u servizio di rete e radio."
msgstr[1] "AppArmor limita %u servizi di rete e radio."

msgid "No matching names"
msgstr "Nessun nome corrispondente"

msgid "No queries in the log"
msgstr "Nessuna richiesta nel registro"

msgid "The log starts anew with each restart; “Keep after Restart” in Settings keeps it"
msgstr "Il registro riparte a ogni riavvio; «Conserva dopo il riavvio» nelle Impostazioni lo mantiene"

