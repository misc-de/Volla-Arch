+/*
+ * Plinius: UFS storage appears as one drive with several LUNs (two 4 MB boot LUNs and the
+ * user area) and udisks reports the size of the first LUN; use the drive's largest LUN.
+ */
+static guint64
+get_drive_size (GList *objects, GDBusObject *drive_object, UDisksDrive *drive)
+{
+    const char *drive_path = g_dbus_object_get_object_path (drive_object);
+    guint64 size = udisks_drive_get_size (drive);
+    GList *l;
+
+    for (l = objects; l != NULL; l = l->next) {
+        UDisksObject *object = UDISKS_OBJECT (l->data);
+        UDisksBlock *block = udisks_object_peek_block (object);
+
+        if (block == NULL || udisks_object_peek_partition (object) != NULL)
+            continue;
+
+        if (g_strcmp0 (udisks_block_get_drive (block), drive_path) == 0)
+            size = MAX (size, udisks_block_get_size (block));
+    }
+
+    return size;
+}
