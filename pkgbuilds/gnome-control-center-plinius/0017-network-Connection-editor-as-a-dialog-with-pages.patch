-        gint pos = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (page), "position"));
+    for (i = 0; i < self->pages->len; i++) {
+        gint pos = GPOINTER_TO_INT (g_object_get_data (G_OBJECT (g_ptr_array_index (self->pages, i)), "position"));
         if (pos > position)
             break;
     }
+    g_ptr_array_insert (self->pages, i, page);
 
-    label = gtk_label_new (ce_page_get_title (page));
-
-    gtk_notebook_insert_page (self->notebook, GTK_WIDGET (page), label, i);
+    navigation_page = new_navigation_page (page);
+    row = adw_action_row_new ();
+    adw_preferences_row_set_title (ADW_PREFERENCES_ROW (row), ce_page_get_title (page));
+    gtk_list_box_row_set_activatable (GTK_LIST_BOX_ROW (row), TRUE);
