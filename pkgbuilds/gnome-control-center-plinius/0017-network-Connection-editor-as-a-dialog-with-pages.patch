+    g_object_set_data_full (G_OBJECT (row), "navigation-page", g_object_ref_sink (navigation_page),
+                            g_object_unref);
+    gtk_list_box_insert (self->pages_list, row, i);
 
     self->initializing_pages = g_slist_remove (self->initializing_pages, page);
 
@@ -767,7 +834,7 @@ vpn_type_activated (NetConnectionEditor *self, GtkWidget *row)
