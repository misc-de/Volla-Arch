 .../connection-editor/connection-editor.blp   | 125 ++++++++-------
 .../connection-editor/net-connection-editor.c | 143 +++++++++++++-----
 .../connection-editor/net-connection-editor.h |   2 +-
 panels/network/net-device-bluetooth.c         |   3 +-
 panels/network/net-device-ethernet.c          |   6 +-
 panels/network/net-device-wifi.c              |   3 +-
 panels/network/net-vpn.c                      |   3 +-
 8 files changed, 186 insertions(+), 102 deletions(-)

