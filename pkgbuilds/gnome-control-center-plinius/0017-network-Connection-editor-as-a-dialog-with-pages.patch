+/* A settings page as a navigation page of its own, with a header bar and back button */
+static AdwNavigationPage *
+new_navigation_page (CEPage *page)
+{
+    GtkWidget *toolbar = adw_toolbar_view_new ();
+
+    adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (toolbar), adw_header_bar_new ());
+    adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (toolbar), GTK_WIDGET (page));
+    return adw_navigation_page_new (toolbar, ce_page_get_title (page));
+}
+
+static void
+page_row_activated_cb (NetConnectionEditor *self, GtkListBoxRow *row)
+{
+    AdwNavigationPage *page = g_object_get_data (G_OBJECT (row), "navigation-page");
+
+    if (page != NULL)
+        adw_navigation_view_push (self->navigation_view, page);
+}
