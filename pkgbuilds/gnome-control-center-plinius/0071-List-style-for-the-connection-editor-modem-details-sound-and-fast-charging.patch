+static GtkEditable *
+find_editable_by_id (GtkWidget *widget, const char *id)
+{
+    GtkWidget *child;
+
+    if (GTK_IS_EDITABLE (widget) && g_strcmp0 (gtk_buildable_get_buildable_id (GTK_BUILDABLE (widget)), id) == 0)
+        return GTK_EDITABLE (widget);
+
+    for (child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child)) {
+        GtkEditable *editable = find_editable_by_id (child, id);
+
+        if (editable)
+            return editable;
+    }
+    return NULL;
+}
+
+static GtkEditable *
+personal_password_entry (NMAWs *sec)
+{
+    if (NMA_IS_WS_WPA_PSK (sec))
+        return find_editable_by_id (GTK_WIDGET (sec), "wpa_psk_entry");
+#if NM_CHECK_VERSION(1, 20, 6)
+    if (NMA_IS_WS_SAE (sec))
+        return find_editable_by_id (GTK_WIDGET (sec), "psk_entry");
+#endif
+    return NULL;
+}
+
+/* Plinius: the password row stands in for libnma's form of a personal type as long as the
+ * form's password field takes input. With "Ask for this password every time" libnma empties
+ * the field and takes the focus from it; its form, where the storage can be changed, is then
+ * shown instead */
+static gboolean
+password_row_replaces (NMAWs *sec)
+{
+    GtkEditable *entry = sec ? personal_password_entry (sec) : NULL;
+
+    return entry != NULL && gtk_widget_get_can_focus (GTK_WIDGET (entry)) &&
+           gtk_widget_get_focusable (GTK_WIDGET (entry));
+}
