+/* Plinius: the options of ce_page_setup_cloned_mac_combo () for Wi-Fi */
+static const char *cloned_mac_entries[][2] = { { "preserve", N_("Preserve") },
+                                               { "permanent", N_("Permanent") },
+                                               { "random", N_("Random") },
+                                               { "stable", N_("Stable") },
