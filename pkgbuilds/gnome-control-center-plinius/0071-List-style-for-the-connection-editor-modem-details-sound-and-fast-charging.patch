+
+static void
+mac_activated (GtkWidget *widget, const char *action_name, GVariant *parameter)
+{
+    CEPageWifi *self = CE_PAGE_WIFI (widget);
+
+    gtk_editable_set_text (GTK_EDITABLE (self->mac_row), g_variant_get_string (parameter, NULL));
+}
+
+static void
+cloned_mac_activated (GtkWidget *widget, const char *action_name, GVariant *parameter)
+{
+    CEPageWifi *self = CE_PAGE_WIFI (widget);
+    const gchar *id = g_variant_get_string (parameter, NULL);
+    gint i;
+
+    for (i = 0; i < G_N_ELEMENTS (cloned_mac_entries); i++) {
+        if (g_str_equal (id, cloned_mac_entries[i][0])) {
+            set_cloned_mac_option (self, cloned_mac_entries[i][0], cloned_mac_entries[i][1]);
+            return;
+        }
+    }
+}
