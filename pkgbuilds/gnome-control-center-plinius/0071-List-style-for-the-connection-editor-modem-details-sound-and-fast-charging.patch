+/* Plinius: libnma lays its forms out for a desktop window, the labels in a column left of the
+ * fields; the Enterprise form with its certificate choosers is wider than a phone. Every grid
+ * becomes one column, its cells in reading order: the label of a row above its field. Labels
+ * wrap, entries start narrow and take the width there is, lists cut their entries short with
+ * "…". libnma swaps the form of an EAP method when another one is picked, so this runs again
+ * when the form changes; a grid done once keeps its order */
+static int
+compare_grid_cells (gconstpointer a, gconstpointer b, gpointer layout)
+{
+    GtkGridLayoutChild *la = GTK_GRID_LAYOUT_CHILD (gtk_layout_manager_get_layout_child (layout, (GtkWidget *) a));
+    GtkGridLayoutChild *lb = GTK_GRID_LAYOUT_CHILD (gtk_layout_manager_get_layout_child (layout, (GtkWidget *) b));
+    int ra = gtk_grid_layout_child_get_row (la), rb = gtk_grid_layout_child_get_row (lb);
+
+    if (ra != rb)
+        return ra - rb;
+    return gtk_grid_layout_child_get_column (la) - gtk_grid_layout_child_get_column (lb);
+}
+
+static void
+ws_single_column (GtkWidget *widget)
+{
+    GtkWidget *child;
+
+    /* Popovers are not in the page; a combo box's insides are its own */
+    if (GTK_IS_POPOVER (widget))
+        return;
+    if (!GTK_IS_COMBO_BOX (widget)) {
+        for (child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child))
+            ws_single_column (child);
+    }
+
+    if (GTK_IS_GRID (widget) && !g_object_get_data (G_OBJECT (widget), "plinius-single-column")) {
+        GtkLayoutManager *layout = gtk_widget_get_layout_manager (widget);
+        g_autoptr(GPtrArray) cells = g_ptr_array_new ();
+
+        g_object_set_data (G_OBJECT (widget), "plinius-single-column", GINT_TO_POINTER (TRUE));
+        gtk_grid_set_row_homogeneous (GTK_GRID (widget), FALSE);
+
+        for (child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child))
+            g_ptr_array_add (cells, child);
+        g_ptr_array_sort_values_with_data (cells, compare_grid_cells, layout);
+
+        for (guint i = 0; i < cells->len; i++) {
+            GtkGridLayoutChild *lc;
+
+            child = g_ptr_array_index (cells, i);
+            lc = GTK_GRID_LAYOUT_CHILD (gtk_layout_manager_get_layout_child (layout, child));
+            if (GTK_IS_LABEL (child) && gtk_grid_layout_child_get_column (lc) == 0) {
+                gtk_label_set_xalign (GTK_LABEL (child), 0.0);
+                gtk_widget_set_halign (child, GTK_ALIGN_FILL);
+                /* Some room above a label, so it reads as the head of the field below */
+                if (i > 0)
+                    gtk_widget_set_margin_top (child, 6);
+            }
+            gtk_grid_layout_child_set_row (lc, i);
+            gtk_grid_layout_child_set_row_span (lc, 1);
+            gtk_grid_layout_child_set_column (lc, 0);
+            gtk_grid_layout_child_set_column_span (lc, 1);
+        }
+    }
+
+    if (GTK_IS_ENTRY (widget)) {
+        gtk_editable_set_width_chars (GTK_EDITABLE (widget), 8);
+        gtk_widget_set_hexpand (widget, TRUE);
+    } else if (GTK_IS_LABEL (widget)) {
+        GtkWidget *parent = gtk_widget_get_parent (widget);
+
+        if (GTK_IS_CHECK_BUTTON (parent))
+            parent = gtk_widget_get_parent (parent);
+        if (GTK_IS_GRID (parent) ||
+            (GTK_IS_BOX (parent) &&
+             gtk_orientable_get_orientation (GTK_ORIENTABLE (parent)) == GTK_ORIENTATION_VERTICAL)) {
+            gtk_label_set_wrap (GTK_LABEL (widget), TRUE);
+            gtk_label_set_wrap_mode (GTK_LABEL (widget), PANGO_WRAP_WORD_CHAR);
+        }
+    } else if (GTK_IS_COMBO_BOX (widget)) {
+        g_autoptr(GList) cells = NULL;
+
+        G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+        cells = gtk_cell_layout_get_cells (GTK_CELL_LAYOUT (widget));
+        G_GNUC_END_IGNORE_DEPRECATIONS
+        for (GList *l = cells; l; l = l->next) {
+            if (GTK_IS_CELL_RENDERER_TEXT (l->data))
+                g_object_set (l->data, "ellipsize", PANGO_ELLIPSIZE_END, NULL);
+        }
+    }
+}
