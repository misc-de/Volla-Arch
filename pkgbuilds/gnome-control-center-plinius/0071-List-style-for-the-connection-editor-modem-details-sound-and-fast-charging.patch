+/* Plinius: a suggestion in the menu of a row; menu labels take "_" as a mnemonic */
+static void
+append_suggestion (GMenu *menu, const gchar *action, const gchar *label, const gchar *target)
+{
+    g_auto(GStrv) parts = g_strsplit (label, "_", -1);
+    g_autofree gchar *escaped = g_strjoinv ("__", parts);
+    g_autoptr(GMenuItem) item = g_menu_item_new (escaped, NULL);
+
+    g_menu_item_set_action_and_target_value (item, action, g_variant_new_string (target));
+    g_menu_append_item (menu, item);
+}
+
+static void
+set_suggestions (GtkMenuButton *button, GMenu *menu)
+{
+    gtk_menu_button_set_menu_model (button, G_MENU_MODEL (menu));
+    gtk_widget_set_visible (GTK_WIDGET (button), g_menu_model_get_n_items (G_MENU_MODEL (menu)) > 0);
+}
+
+/* Plinius: ce_page_setup_mac_combo () for an entry row: the same addresses in its menu, in the
+ * same order, and the same text in the row */
+static void
+setup_mac_row (AdwEntryRow *row, GtkMenuButton *button, const gchar *action, const gchar *current_mac,
+               gchar **mac_list)
+{
+    g_autoptr(GMenu) menu = g_menu_new ();
+    gchar **m, *active_mac = NULL;
+    gint current_mac_len;
+
+    if (current_mac)
+        current_mac_len = strlen (current_mac);
+    else
+        current_mac_len = -1;
+
+    for (m = mac_list; m && *m; m++) {
+        if (current_mac && g_ascii_strncasecmp (*m, current_mac, current_mac_len) == 0
+            && ((*m)[current_mac_len] == '\0' || (*m)[current_mac_len] == ' '))
+            active_mac = *m;
+    }
+
+    if (current_mac && !active_mac)
+        append_suggestion (menu, action, current_mac, current_mac);
+    for (m = mac_list; m && *m; m++)
+        append_suggestion (menu, action, *m, *m);
+    set_suggestions (button, menu);
+
+    if (current_mac)
+        gtk_editable_set_text (GTK_EDITABLE (row), active_mac ? active_mac : current_mac);
+}
+
+static void
+set_cloned_mac_option (CEPageWifi *self, const gchar *id, const gchar *label)
+{
+    self->setting_cloned_mac = TRUE;
+    self->cloned_mac_id = id;
+    gtk_editable_set_text (GTK_EDITABLE (self->cloned_mac_row), _(label));
+    self->setting_cloned_mac = FALSE;
+}
+
+/* Plinius: ce_page_setup_cloned_mac_combo () for an entry row */
+static void
+setup_cloned_mac_row (CEPageWifi *self, const char *current)
+{
+    g_autoptr(GMenu) menu = g_menu_new ();
+    gint i, active = -1;
+
+    gtk_widget_set_tooltip_text (GTK_WIDGET (self->cloned_mac_row),
+                                 _("The MAC address entered here will be used as hardware address for "
+                 "the network device this connection is activated on. This feature is "
+                 "known as MAC cloning or spoofing. Example: 00:11:22:33:44:55"));
+
+    for (i = 0; i < G_N_ELEMENTS (cloned_mac_entries); i++) {
+        append_suggestion (menu, "ce-wifi.cloned-mac", _(cloned_mac_entries[i][1]), cloned_mac_entries[i][0]);
+        if (g_strcmp0 (current, cloned_mac_entries[i][0]) == 0)
+            active = i;
+    }
+    set_suggestions (self->cloned_mac_button, menu);
+
+    if (active != -1)
+        set_cloned_mac_option (self, cloned_mac_entries[active][0], cloned_mac_entries[active][1]);
+    else if (current && current[0])
+        gtk_editable_set_text (GTK_EDITABLE (self->cloned_mac_row), current);
+}
+
+/* Plinius: editing the text of an option leaves the option, as typing in the combo box did */
+static void
+cloned_mac_changed_cb (CEPageWifi *self)
+{
+    if (!self->setting_cloned_mac)
+        self->cloned_mac_id = NULL;
+}
+
+/* Plinius: ce_page_cloned_mac_get () */
+static gchar *
+cloned_mac_get (CEPageWifi *self)
+{
+    const gchar *text;
+
+    if (self->cloned_mac_id)
+        return g_strdup (self->cloned_mac_id);
+
+    text = gtk_editable_get_text (GTK_EDITABLE (self->cloned_mac_row));
+    if (text[0] == '\0')
+        return NULL;
+
+    return g_strdup (text);
+}
+
+/* Plinius: ce_page_cloned_mac_combo_valid () */
+static gboolean
+cloned_mac_valid (CEPageWifi *self)
+{
+    const gchar *text;
+
+    if (self->cloned_mac_id)
+        return TRUE;
+
+    text = gtk_editable_get_text (GTK_EDITABLE (self->cloned_mac_row));
+    return text[0] == '\0' || ce_page_address_is_valid (text);
+}
+
+static void
+bssid_activated (GtkWidget *widget, const char *action_name, GVariant *parameter)
+{
