 /* Plinius: the plugins lay their forms out for a desktop window, the labels in a column left
- * of the fields, which pushes the fields off a phone's screen. Every grid becomes one column,
- * its cells in reading order: the label of a row above its field. A row of a check button with fields after it ("Use custom gateway port" and a number)
- * stacks the fields below the check button, translations make such rows even longer. Entries start narrow and take the width
- * there is, lists cut their entries short with "…", tab rows scroll. Labels wrap where they
- * have the width of the column (in grids, vertical boxes and check buttons there), not in a row
- * of other widgets, which would hand them their minimum width, a word per line. */
+ * of the fields, which pushes the fields off a phone's screen and looks unlike the rest of
+ * Settings. vpn_form() puts them in the list style of Settings: the label/field pairs of the
+ * plugin's grids and boxes become rows of boxed lists, the label above its field; check buttons
+ * and other widgets are rows of their own. A bold label, or one above a section of its own,
+ * heads the lists after it; the tabs of a notebook follow one another, the title of each as
+ * the heading of its lists.
+ *
+ * The plugin's widgets move into the rows as they are, so the plugin's pointers and signals
+ * still reach them. Its grids and boxes stay where they were and hold the lists made of their
+ * cells; a grid or box of fields only (a certificate chooser) adds its rows to the list around
+ * it and waits emptied in a hidden box. A row shows and is sensitive as what it holds (a label
+ * shows only with its field) and as the containers its widgets came from; a list without a
+ * row to show hides with its heading. The plugins show and hide fields as the user picks
+ * options; when the plugin's form changes, widgets it added are put in rows as well. */
+#define FORM_KEY "plinius-form"              /* a converted container: the box of its lists */
+#define FORM_OWN_KEY "plinius-form-own"      /* a box of the form itself: FormOwn */
+#define FORM_ROW_KEY "plinius-form-row"      /* a row: its FormRow */
+#define FORM_HEADING_KEY "plinius-form-heading"  /* a list: a weak ref to its heading */
+#define FORM_INLINE_FORM_KEY "plinius-form-inline-form"  /* an emptied container: a weak ref */
+#define FORM_INLINE_LIST_KEY "plinius-form-inline-list"  /* to the form and list of its rows */
+
+typedef enum {
+    FORM_OWN_BOX = 1,
+    FORM_OWN_HEADING,
+    FORM_OWN_KEEPER,
+} FormOwn;
+
+typedef struct {
+    GtkWidget *widget;  /* a reference */
+    int row;
+    int column;
+} FormItem;
+
+typedef struct {
+    GtkWidget *field;   /* the field below the label, or NULL */
+    GPtrArray *widgets; /* the plugin's widgets in the row */
+    GPtrArray *gates;   /* GWeakRef: the emptied containers they came from */
+} FormRow;
+
+typedef struct {
+    GtkBox *form;
+    GtkWidget *list;    /* the list rows go to, NULL after a heading or a section */
+    GtkWidget *heading; /* the box of a heading for what follows */
+    GtkWidget *keeper;  /* hidden box of the emptied containers */
+} FormState;
+
+static void form_convert (GtkWidget *container);
+
+static void
+form_item_free (gpointer data)
+{
+    FormItem *item = data;
+
+    g_object_unref (item->widget);
+    g_free (item);
+}
+
+static void
+form_weak_ref_free (gpointer data)
+{
+    g_weak_ref_clear (data);
+    g_free (data);
+}
+
+static GWeakRef *
+form_weak_ref_new (gpointer object)
+{
+    GWeakRef *ref = g_new0 (GWeakRef, 1);
+
+    g_weak_ref_init (ref, object);
+    return ref;
+}
+
+static void
+form_row_free (gpointer data)
+{
+    FormRow *fr = data;
+
+    g_ptr_array_unref (fr->widgets);
+    g_ptr_array_unref (fr->gates);
+    g_free (fr);
+}
+
+static GtkWidget *
+form_own_box (FormOwn own, int spacing)
+{
+    GtkWidget *box = gtk_box_new (GTK_ORIENTATION_VERTICAL, spacing);
+
+    g_object_set_data (G_OBJECT (box), FORM_OWN_KEY, GINT_TO_POINTER (own));
+    return box;
+}
+
+/* Grids and vertical boxes hold a form, notebooks forms of their own */
+static gboolean
+form_is_container (GtkWidget *widget)
+{
+    if (g_object_get_data (G_OBJECT (widget), FORM_OWN_KEY))
+        return FALSE;
+    return GTK_IS_GRID (widget) || GTK_IS_NOTEBOOK (widget) ||
+           (G_TYPE_FROM_INSTANCE (widget) == GTK_TYPE_BOX &&
+            gtk_orientable_get_orientation (GTK_ORIENTABLE (widget)) == GTK_ORIENTATION_VERTICAL);
+}
+
+/* The headings of the plugins are bold, by markup or by attributes */
+static gboolean
+form_is_bold (GtkWidget *widget)
+{
+    PangoAttrList *attrs;
+    const char *text;
+    gboolean bold = FALSE;
+
+    if (!GTK_IS_LABEL (widget))
+        return FALSE;
+
+    text = gtk_label_get_label (GTK_LABEL (widget));
+    if (gtk_label_get_use_markup (GTK_LABEL (widget)) && text &&
+        (strstr (text, "<b>") || strstr (text, "weight=\"bold\"")))
+        return TRUE;
