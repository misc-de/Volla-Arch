From 8f24893a39511d78b2cbd41715368c677a24cd10 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 1 Nov 2026 19:26:21 +0100
Subject: [PATCH] location: Contribute to beaconDB below the location switch

A switch for furios-gps-contribute (misc-de/furios_gps): on, it sends nearby
Wi-Fi networks with a GPS fix to beaconDB, over Wi-Fi only. The group lives in
cc-plinius-beacondb.c; this only names the page and calls it.
---
 panels/privacy/location/cc-location-page.blp | 2 +-
 panels/privacy/location/cc-location-page.c   | 5 +++++
 panels/privacy/meson.build                   | 1 +
 3 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/panels/privacy/location/cc-location-page.blp b/panels/privacy/location/cc-location-page.blp
index 41ea56405..9db7494b3 100644
--- a/panels/privacy/location/cc-location-page.blp
+++ b/panels/privacy/location/cc-location-page.blp
@@ -9,7 +9,7 @@ template $CcLocationPage: Adw.NavigationPage {
     [top]
     Adw.HeaderBar {}
 
-    content: Adw.PreferencesPage {
+    content: Adw.PreferencesPage preferences_page {
       Adw.PreferencesGroup {
         Adw.SwitchRow location_row {
           title: _("_Automatic Device Location");
diff --git a/panels/privacy/location/cc-location-page.c b/panels/privacy/location/cc-location-page.c
index d2d7fe361..13741da67 100644
--- a/panels/privacy/location/cc-location-page.c
+++ b/panels/privacy/location/cc-location-page.c
@@ -19,6 +19,7 @@
  */
 
 #include "cc-location-page.h"
+#include "cc-plinius-beacondb.h"
 #include "cc-util.h"
 
 #include <gio/gdesktopappinfo.h>
@@ -30,6 +31,7 @@
 struct _CcLocationPage {
     AdwNavigationPage parent_instance;
 
+    AdwPreferencesPage *preferences_page;
     GtkListBox *location_apps_list_box;
     AdwSwitchRow *location_row;
 
@@ -339,6 +341,7 @@ cc_location_page_class_init (CcLocationPageClass *klass)
 
     gtk_widget_class_bind_template_child (widget_class, CcLocationPage, location_apps_list_box);
     gtk_widget_class_bind_template_child (widget_class, CcLocationPage, location_row);
+    gtk_widget_class_bind_template_child (widget_class, CcLocationPage, preferences_page);
 }
 
 static void
@@ -352,6 +355,8 @@ cc_location_page_init (CcLocationPage *self)
     self->cancellable = g_cancellable_new ();
 
     g_settings_bind (self->location_settings, LOCATION_ENABLED, self->location_row, "active", G_SETTINGS_BIND_DEFAULT);
+    /* Plinius: contributing to beaconDB, below the location switch */
+    cc_plinius_beacondb_setup (self->preferences_page, self->location_row);
 
     self->location_app_switches = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
     self->location_app_rows = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_object_unref);
diff --git a/panels/privacy/meson.build b/panels/privacy/meson.build
index 825c7b7f6..2f62b8a3f 100644
--- a/panels/privacy/meson.build
+++ b/panels/privacy/meson.build
@@ -45,6 +45,7 @@ sources = files(
   'firmware-security/cc-firmware-security-page.c',
   'firmware-security/cc-firmware-security-utils.c',
   'location/cc-location-page.c',
+  'location/cc-plinius-beacondb.c',
   'cc-plinius-crypt.c',
   'cc-plinius-security.c',
   'cc-privacy-panel.c',
