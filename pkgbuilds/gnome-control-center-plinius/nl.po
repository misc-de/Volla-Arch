msgstr "Leest NFC-tags en communiceert met kaarten en terminals die tegen de achterkant worden gehouden. Zoekt alleen zolang het scherm aan is."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Ontgrendelpatroon"

msgid "On"
msgstr "Aan"

msgid "Off"
msgstr "Uit"

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "Met een ontgrendelpatroon accepteert het vergrendelscherm het patroon of een vingerafdruk in plaats van de pincode. Voer je pincode in om verder te gaan."

msgid "PIN"
msgstr "Pincode"

msgid "Continue"
msgstr "Doorgaan"

msgid "Wrong PIN. Try again."
msgstr "Verkeerde pincode. Probeer het opnieuw."

msgid "Draw your current pattern."
msgstr "Teken je huidige patroon."

msgid "Wrong pattern. Try again."
msgstr "Verkeerd patroon. Probeer het opnieuw."

msgid "Too many wrong tries. Try again later."
msgstr "Te veel mislukte pogingen. Probeer het later opnieuw."

msgid "Use PIN Instead"
msgstr "Pincode gebruiken in plaats daarvan"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Teken een ontgrendelpatroon. Verbind minstens 6 punten."

msgid "Connect at least 6 points."
msgstr "Verbind minstens 6 punten."

msgid "Draw the pattern again to confirm."
msgstr "Teken het patroon nogmaals ter bevestiging."

msgid "The patterns do not match. Draw a new one."
msgstr "De patronen komen niet overeen. Teken een nieuw patroon."

msgid "The pattern could not be saved."
msgstr "Het patroon kon niet worden opgeslagen."

msgid "The pattern could not be removed."
msgstr "Het patroon kon niet worden verwijderd."

msgid "Remove Pattern"
msgstr "Patroon verwijderen"

msgid "Draw Pattern"
msgstr "Teken het patroon"

msgid "Wrong Pattern"
msgstr "Verkeerd patroon"

msgid "Use PIN"
msgstr "Pincode gebruiken"

msgid "Use Pattern"
msgstr "Patroon gebruiken"

