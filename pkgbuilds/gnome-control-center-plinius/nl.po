msgid "The display does not run on the graphics chip, or not at all."
msgstr "Het beeldscherm draait niet op de grafische chip, of helemaal niet."

#: cc-plinius-selftest.c
msgid "The speaker and microphone of the phone are missing."
msgstr "De luidspreker en microfoon van de telefoon ontbreken."

#: cc-plinius-selftest.c
msgid "No modem: no calls, messages or mobile data."
msgstr "Geen modem: geen gesprekken, berichten of mobiele data."

#: cc-plinius-selftest.c
msgid "The Wi-Fi adapter is missing."
msgstr "De wifi-adapter ontbreekt."

#: cc-plinius-selftest.c
msgid "The Bluetooth adapter is missing."
msgstr "De Bluetooth-adapter ontbreekt."

#: cc-plinius-selftest.c
msgid "Working"
msgstr "Werkt"

#: cc-plinius-selftest.c
msgid "Not checked: nobody was logged in."
