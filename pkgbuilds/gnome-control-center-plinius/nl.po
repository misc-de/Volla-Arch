msgstr "De laatste update kon niet worden gelezen."

#: cc-plinius-selftest.c
msgid "Last Update"
msgstr "Laatste update"

#: cc-plinius-selftest.c
msgid "_Take Back Update"
msgstr "Update _terugdraaien"

