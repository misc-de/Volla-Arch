From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 8 Nov 2026 19:40:00 +0100
Subject: [PATCH] users: A new password equal to the current one is refused in
 the dialog

Setting the same PIN again left the Change button on. passwd refused it
only after pam_plinius_crypt had tried the PIN on the LUKS header (about
1.5 s on the phone), so the button seemed to do nothing until the alert
"The old and new passwords are the same" came. The dialog had known it
all along: libpwquality reports the same password, but for a short PIN
the length hint wins, and "Passwords match" then replaced the hint below
the fields.

Now the dialog compares the new password with the current one itself.
If they are equal, Change stays off, the strength bar shows weak, and
the hint says that the new password must differ; "Passwords match" no
longer covers it.
---
 panels/system/users/cc-password-dialog.c | 27 +++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 3 deletions(-)

--- a/panels/system/users/cc-password-dialog.c
+++ b/panels/system/users/cc-password-dialog.c
@@ -69,6 +69,20 @@
 
 G_DEFINE_FINAL_TYPE (CcPasswordDialog, cc_password_dialog, ADW_TYPE_DIALOG)
 
+/* Plinius: TRUE if the new password is the current one. passwd refuses that only after
+ * pam_plinius_crypt has tried it on the LUKS header (about 1.5 s on the phone), and the hint
+ * below the fields was overwritten with "Passwords match", so the Change button seemed to do
+ * nothing. The dialog now catches it itself. */
+static gboolean
+same_as_old_password (CcPasswordDialog *self)
+{
+    const gchar *password = gtk_editable_get_text (GTK_EDITABLE (self->password_entry));
+    const gchar *old_password = gtk_editable_get_text (GTK_EDITABLE (self->old_password_entry));
+
+    return gtk_widget_get_visible (GTK_WIDGET (self->old_password_entry)) && strlen (password) > 0
+           && g_strcmp0 (password, old_password) == 0;
+}
+
 static gboolean
 update_password_strength (CcPasswordDialog *self)
 {
@@ -85,12 +99,20 @@
     username = act_user_get_user_name (self->user);
 
     pw_strength (password, old_password, username, &hint, &strength_level, &enforcing);
+    if (same_as_old_password (self)) {
+        /* Plinius: a short PIN gets the length hint first; say what really stops it */
+        hint = C_("Password hint", "The new password needs to be different from the old one");
+        strength_level = MIN (strength_level, 1);
+    }
 
     gtk_level_bar_set_value (self->strength_indicator, strength_level);
 
-    if (g_strcmp0 (hint, self->password_hint_text) != 0) {
+    /* Plinius: "Passwords (do not) match" may have replaced the label since; the hint about the
+     * current password is set again in any case */
+    if (g_strcmp0 (hint, self->password_hint_text) != 0 || same_as_old_password (self)) {
         cc_entry_feedback_update (self->password_hint_label,
                                   strength_level > 1 ? "check-outlined-symbolic" : "dialog-error-symbolic", hint);
+        g_free (self->password_hint_text);
         self->password_hint_text = g_strdup (hint);
     }
 
@@ -106,7 +128,7 @@
     /* Plinius: the phone's password is usually a short PIN, which libpwquality rates weak.
      * The hint above still says so, but any password other than an empty one is accepted. */
     (void) enforcing;
-    accept = strlen (password) > 0;
+    accept = strlen (password) > 0 && !same_as_old_password (self);
 
     verify = gtk_editable_get_text (GTK_EDITABLE (self->verify_entry));
     if (strlen (verify) == 0) {
@@ -251,7 +273,8 @@
     password = gtk_editable_get_text (GTK_EDITABLE (self->password_entry));
     verify = gtk_editable_get_text (GTK_EDITABLE (self->verify_entry));
 
-    if (strlen (verify) > 0) {
+    /* Plinius: keep the hint that the new password equals the current one */
+    if (strlen (verify) > 0 && !same_as_old_password (self)) {
         if (strcmp (password, verify) != 0) {
             gtk_widget_add_css_class (GTK_WIDGET (self->verify_entry), "error");
             cc_entry_feedback_update (self->password_hint_label, "dialog-error-symbolic", _("Passwords do not match"));
