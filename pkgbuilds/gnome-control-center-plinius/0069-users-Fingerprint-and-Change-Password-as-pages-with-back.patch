From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Mon, 9 Nov 2026 12:00:00 +0100
Subject: [PATCH] users: Fingerprint and Change Password as pages with back

Plinius, for the phone's thumb and the back swipe:

- Fingerprint: the row on Lock & Unlock and the dialog's list page are
  called "Fingerprint" (plinius-control-center domain) instead of
  "Fingerprint Authentication"; the row says "On" or "Off" like the
  unlock pattern and face unlock, not "Enabled". The dialog opens as a page of the window
  (shell/cc-plinius-dialog-pages.c no longer leaves it a sheet); the room
  for the sensor under the display is measured on the room itself, which
  is in the window, while a finger is enrolled. Its status pages are
  titled "Fingerprint" as well (a page needs a title), and "Add
  Fingerprint" takes the mnemonic of GNOME's translations instead of
  showing the underscore.
- Change Password: no "Cancel", back (the arrow and the back swipe)
  cancels; "Change" is a pill below the form. The strength bar shows
  only once a new password is typed, empty it looked like a stray line
  above the button.
---
 panels/system/users/cc-fingerprint-dialog.c | 19 +++++++++++---
 panels/system/users/cc-password-dialog.blp  | 40 +++++++++++++----------------
 panels/system/users/cc-password-dialog.c    |  2 ++
 panels/system/users/cc-user-page.c          |  7 +++--
 4 files changed, 40 insertions(+), 28 deletions(-)

diff --git a/panels/system/users/cc-fingerprint-dialog.c b/panels/system/users/cc-fingerprint-dialog.c
index 9a892d1d2..c694f15b2 100644
--- a/panels/system/users/cc-fingerprint-dialog.c
+++ b/panels/system/users/cc-fingerprint-dialog.c
@@ -639,7 +639,9 @@ get_udfps_top (void)
 static void
 update_udfps_space (CcFingerprintDialog *self)
 {
-    GtkNative *native = gtk_widget_get_native (GTK_WIDGET (self));
+    /* Plinius: as a page of the window (cc-plinius-dialog-pages.c) the dialog itself is in no
+     * window, the room at its bottom is */
+    GtkNative *native = gtk_widget_get_native (self->udfps_space);
     GdkSurface *surface = native ? gtk_native_get_surface (native) : NULL;
     GdkMonitor *monitor = NULL;
     GdkRectangle geometry;
@@ -671,7 +673,8 @@ setup_udfps (CcFingerprintDialog *self)
     self->udfps_space = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
     adw_toolbar_view_add_bottom_bar (ADW_TOOLBAR_VIEW (adw_dialog_get_child (ADW_DIALOG (self))),
                                      self->udfps_space);
-    g_signal_connect_swapped (self, "map", G_CALLBACK (update_udfps_space), self);
+    /* Shown while a finger is enrolled, measured then */
+    g_signal_connect_swapped (self->udfps_space, "map", G_CALLBACK (update_udfps_space), self);
 }
 
 static gboolean
@@ -1350,8 +1353,9 @@ on_stack_child_changed (CcFingerprintDialog *self)
 
     g_debug ("Fingerprint dialog child changed: %s", gtk_stack_get_visible_child_name (self->stack));
 
-    /* Set an empty string for status pages (stack pages with no title). */
-    adw_dialog_set_title (ADW_DIALOG (self), title ? title : "");
+    /* Plinius: as a page of the window a status page needs a title too (libadwaita warns about an
+     * empty one), "Fingerprint" as on the list page */
+    adw_dialog_set_title (ADW_DIALOG (self), title ? title : g_dgettext ("plinius-control-center", "Fingerprint"));
 
     gtk_widget_set_visible (GTK_WIDGET (self->back_button), FALSE);
     gtk_widget_set_visible (GTK_WIDGET (self->done_button), FALSE);
@@ -1384,6 +1388,13 @@ cc_fingerprint_dialog_init (CcFingerprintDialog *self)
 
     gtk_widget_init_template (GTK_WIDGET (self));
     setup_udfps (self);
+    /* Plinius: "Fingerprint" as on the row that leads here, from our own domain */
+    adw_status_page_set_title (ADW_STATUS_PAGE (self->no_fingerprints_enrolled_page),
+                               g_dgettext ("plinius-control-center", "Fingerprint"));
+    gtk_stack_page_set_title (gtk_stack_get_page (self->stack, self->prints_manager),
+                              g_dgettext ("plinius-control-center", "Fingerprint"));
+    /* GNOME's translations put a mnemonic into "Add Fingerprint", the row did not take it */
+    adw_preferences_row_set_use_underline (ADW_PREFERENCES_ROW (self->add_finger_button), TRUE);
 
     self->fingerprints_store = g_list_store_new (GTK_TYPE_STRING_OBJECT);
     adw_preferences_group_bind_model (self->prints_group, G_LIST_MODEL (self->fingerprints_store),
diff --git a/panels/system/users/cc-password-dialog.blp b/panels/system/users/cc-password-dialog.blp
index 2185a4c92..beafe71e6 100644
--- a/panels/system/users/cc-password-dialog.blp
+++ b/panels/system/users/cc-password-dialog.blp
@@ -8,31 +8,11 @@ template $CcPasswordDialog: Adw.Dialog {
 
   child: Adw.ToolbarView {
     [top]
+    /* Plinius: a page of the window, so back (the arrow and the back swipe) cancels and the
+     * confirming button sits below the form, where the thumb is */
     Adw.HeaderBar {
       show-start-title-buttons: false;
       show-end-title-buttons: false;
-
-      [start]
-      Button {
-        label: _("_Cancel");
-        receives-default: true;
-        use-underline: true;
-        valign: center;
-        clicked => $adw_dialog_force_close(template);
-      }
-
-      [end]
-      Button ok_button {
-        label: _("Ch_ange");
-        receives-default: true;
-        use-underline: true;
-        valign: center;
-        clicked => $ok_button_clicked_cb(template);
-
-        styles [
-          "suggested-action",
-        ]
-      }
     }
 
     Adw.PreferencesPage {
@@ -88,6 +68,7 @@ template $CcPasswordDialog: Adw.Dialog {
         }
 
         LevelBar strength_indicator {
+          visible: false;
           mode: continuous;
           max-value: 5;
           margin-top: 12;
@@ -133,6 +114,21 @@ template $CcPasswordDialog: Adw.Dialog {
           }
         }
       }
+
+      Adw.PreferencesGroup {
+        Button ok_button {
+          halign: center;
+          label: _("Ch_ange");
+          receives-default: true;
+          use-underline: true;
+          clicked => $ok_button_clicked_cb(template);
+
+          styles [
+            "pill",
+            "suggested-action",
+          ]
+        }
+      }
     }
   };
 }
diff --git a/panels/system/users/cc-password-dialog.c b/panels/system/users/cc-password-dialog.c
index 142a98755..7b9ce1144 100644
--- a/panels/system/users/cc-password-dialog.c
+++ b/panels/system/users/cc-password-dialog.c
@@ -106,6 +106,8 @@ update_password_strength (CcPasswordDialog *self)
     }
 
     gtk_level_bar_set_value (self->strength_indicator, strength_level);
+    /* Plinius: an empty bar above "Change" says nothing; it shows once a new password is typed */
+    gtk_widget_set_visible (GTK_WIDGET (self->strength_indicator), strlen (password) > 0);
 
     /* Plinius: "Passwords (do not) match" may have replaced the label since; the hint about the
      * current password is set again in any case */
diff --git a/panels/system/users/cc-user-page.c b/panels/system/users/cc-user-page.c
index 73360f0c3..81349eb41 100644
--- a/panels/system/users/cc-user-page.c
+++ b/panels/system/users/cc-user-page.c
@@ -399,10 +399,11 @@ update_fingerprint_row_state (CcUserPage *self, GParamSpec *spec, CcFingerprintM
 
     gtk_widget_set_sensitive (GTK_WIDGET (self->fingerprint_row), state != CC_FINGERPRINT_STATE_UPDATING);
 
+    /* Plinius: "On" and "Off" as the unlock pattern and face unlock below it */
     if (state == CC_FINGERPRINT_STATE_ENABLED)
-        cc_list_row_set_secondary_label (self->fingerprint_row, _("Enabled"));
+        cc_list_row_set_secondary_label (self->fingerprint_row, g_dgettext ("plinius-control-center", "On"));
     else if (state == CC_FINGERPRINT_STATE_DISABLED)
-        cc_list_row_set_secondary_label (self->fingerprint_row, _("Disabled"));
+        cc_list_row_set_secondary_label (self->fingerprint_row, g_dgettext ("plinius-control-center", "Off"));
 }
 
 static void
@@ -833,6 +834,8 @@ cc_user_page_set_user (CcUserPage *self, ActUser *user, GPermission *permission)
         adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->face_row),
                                        g_dgettext ("plinius-control-center", "Face Unlock"));
         update_face_row (self);
+        adw_preferences_row_set_title (ADW_PREFERENCES_ROW (self->fingerprint_row),
+                                       g_dgettext ("plinius-control-center", "Fingerprint"));
 
         if (!self->fingerprint_manager
             || g_strcmp0 (act_user_get_user_name (cc_fingerprint_manager_get_user (self->fingerprint_manager)),
