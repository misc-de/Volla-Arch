msgstr "Pour les services de streaming comme Netflix et Prime Video dans Firefox"

#. Translators: {version} is the Widevine version, e.g. 4.10.3112.0
msgid "Widevine {version} from Google"
msgstr "Widevine {version} de Google"

msgid "Not downloaded yet, tries again later"
msgstr "Pas encore téléchargé, nouvel essai plus tard"

