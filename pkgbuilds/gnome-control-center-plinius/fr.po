#: cc-plinius-selftest.c
msgid "One check failed."
msgid_plural "%u checks failed."
msgstr[0] "%u vérification a échoué."
msgstr[1] "%u vérifications ont échoué."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s goes back: one package returns to its earlier version. Restart the phone afterwards."
msgid_plural "The update of %s goes back: %u packages return to their earlier versions. Restart the phone afterwards."
msgstr[0] "La mise à jour du %s est annulée : %u paquet revient à sa version précédente. Redémarrez ensuite le téléphone."
msgstr[1] "La mise à jour du %s est annulée : %u paquets reviennent à leurs versions précédentes. Redémarrez ensuite le téléphone."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s changed one package. Its earlier version is still on the phone. If the problem began with this update, take it back. Asks for your PIN."
msgid_plural "The update of %s changed %u packages. Their earlier versions are still on the phone. If the problem began with this update, take it back. Asks for your PIN."
msgstr[0] "La mise à jour du %s a modifié %u paquet. Sa version précédente est encore sur le téléphone. Si le problème a commencé avec cette mise à jour, annulez-la. Demande votre code PIN."
msgstr[1] "La mise à jour du %s a modifié %u paquets. Leurs versions précédentes sont encore sur le téléphone. Si le problème a commencé avec cette mise à jour, annulez-la. Demande votre code PIN."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s cannot be taken back: the earlier version of one package is no longer on the phone."
msgid_plural "The update of %s cannot be taken back: the earlier versions of %u packages are no longer on the phone."
msgstr[0] "La mise à jour du %s ne peut pas être annulée : la version précédente de %u paquet n’est plus sur le téléphone."
msgstr[1] "La mise à jour du %s ne peut pas être annulée : les versions précédentes de %u paquets ne sont plus sur le téléphone."

