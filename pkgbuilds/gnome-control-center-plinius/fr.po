# Plinius: NFC panel (cc-nfc-panel.*)
msgid "Switching NFC failed"
msgstr "Impossible de changer l’état du NFC"

msgid "Reads NFC tags and talks to cards and terminals held to the back of the phone. It only looks for them while the screen is on."
msgstr "Lit les étiquettes NFC et communique avec les cartes et terminaux tenus au dos du téléphone. La recherche n’a lieu que lorsque l’écran est allumé."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Schéma de déverrouillage"

msgid "On"
msgstr "Activé"

msgid "Off"
msgstr "Désactivé"

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "Avec un schéma de déverrouillage, l’écran de verrouillage accepte le schéma ou une empreinte digitale à la place du code PIN. Saisissez votre code PIN pour continuer."

msgid "PIN"
msgstr "Code PIN"

msgid "Continue"
msgstr "Continuer"

msgid "Wrong PIN. Try again."
msgstr "Code PIN incorrect. Réessayez."

msgid "Draw your current pattern."
msgstr "Dessinez votre schéma actuel."

msgid "Wrong pattern. Try again."
msgstr "Schéma incorrect. Réessayez."

msgid "Too many wrong tries. Try again later."
msgstr "Trop d’essais incorrects. Réessayez plus tard."

msgid "Use PIN Instead"
msgstr "Utiliser le code PIN à la place"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Dessinez un schéma de déverrouillage. Reliez au moins 6 points."

msgid "Connect at least 6 points."
msgstr "Reliez au moins 6 points."

msgid "Draw the pattern again to confirm."
msgstr "Dessinez à nouveau le schéma pour confirmer."

msgid "The patterns do not match. Draw a new one."
msgstr "Les schémas ne correspondent pas. Dessinez-en un nouveau."

msgid "The pattern could not be saved."
msgstr "Le schéma n’a pas pu être enregistré."

msgid "The pattern could not be removed."
msgstr "Le schéma n’a pas pu être supprimé."

msgid "Remove Pattern"
msgstr "Supprimer le schéma"

msgid "Draw Pattern"
msgstr "Dessinez le schéma"

msgid "Wrong Pattern"
msgstr "Schéma incorrect"

msgid "Use PIN"
msgstr "Utiliser le code PIN"

msgid "Use Pattern"
msgstr "Utiliser le schéma"

