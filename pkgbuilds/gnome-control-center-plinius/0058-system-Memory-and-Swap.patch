Plinius: "Memory and Swap" in System.

A row above Hardware opens a page with the switch and size of the swap file, the threshold
(swappiness), what RAM and swap hold, the largest processes and a button that moves swap back into
RAM. The page (cc-plinius-swap.*) lives as a separate file in the package directory and is copied
to panels/system/ in prepare(); without plinius-swap the row stays hidden.

diff --git a/panels/system/cc-system-panel.blp b/panels/system/cc-system-panel.blp
index 6c48dd071..0882c6aac 100644
--- a/panels/system/cc-system-panel.blp
+++ b/panels/system/cc-system-panel.blp
@@ -47,6 +47,14 @@ template $CcSystemPanel: $CcPanel {
           activated => $on_secure_shell_row_clicked(template);
         }
 
+        // Plinius: title, subtitle and target in cc_plinius_swap_row_setup ()
+        $CcListRow swap_row {
+          icon-name: "drive-harddisk-symbolic";
+          show-arrow: true;
+          action-name: "navigation.push";
+          visible: false;
+        }
+
         // Plinius: title, subtitle and target in cc_plinius_hardware_row_setup ()
         $CcListRow hardware_row {
           icon-name: "phone-symbolic";
diff --git a/panels/system/cc-system-panel.c b/panels/system/cc-system-panel.c
