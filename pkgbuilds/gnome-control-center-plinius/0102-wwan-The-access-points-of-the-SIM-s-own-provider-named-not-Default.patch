From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Fri, 20 Nov 2026 10:40:00 +0100
Subject: [PATCH] wwan: The access points of the SIM's own provider, named, not "Default"

Mobile Network > Access Points listed "Vorgabe" (libnma's "Default" for
an entry of mobile-broadband-provider-info without a name), which could
not be deleted: it is a suggestion of the database, not saved on the
phone. It came from the wrong provider: several providers of the
database can share one network, and
nma_mobile_providers_database_lookup_3gpp_mcc_mnc () took another one
than the SIM's. Saved, its APN ended mobile data on the phone.

- The provider of the suggestions is the one of the network whose name
  is the SIM's operator name, else the network's operator name; without
  a match the lookup's provider as before.
- A suggestion without a name of its own shows its provider's name
  instead of "Default".
- A suggestion whose APN is saved already (with another name, user or
  password) is not listed beside the saved access point.
---
--- a/panels/wwan/cc-wwan-data.c
+++ b/panels/wwan/cc-wwan-data.c
@@ -140,6 +140,9 @@
     NMConnection *nm_connection;
     NMRemoteConnection *remote_connection;
 
+    /* Plinius: the provider of access_method, for an entry of the database without a name */
+    char *plinius_provider_name;
+
     gboolean modified;
 };
 
@@ -266,6 +269,67 @@
     return FALSE;
 }
 
+/*
+ * Plinius: several providers of the database can share a network, each with access points of its
+ * own. nma_mobile_providers_database_lookup_3gpp_mcc_mnc () takes one of them, not always the
+ * SIM's; an access point of the wrong one without a name showed as "Default" and,
+ * saved, ended mobile data. The provider whose name is the SIM's operator name, else the
+ * network's, comes first; without a match the lookup's provider as before.
+ */
+static NMAMobileProvider *
+plinius_lookup_provider (CcWwanData *self)
+{
+    MMModem3gpp *modem_3gpp = mm_object_peek_modem_3gpp (self->mm_object);
+    const char *names[] = {
+        self->sim ? mm_sim_get_operator_name (self->sim) : NULL,
+        modem_3gpp ? mm_modem_3gpp_get_operator_name (modem_3gpp) : NULL,
+    };
+    GHashTable *countries = nma_mobile_providers_database_get_countries (self->apn_db);
+
+    for (guint n = 0; n < G_N_ELEMENTS (names) && countries; n++) {
+        GHashTableIter iter;
+        gpointer country;
+
+        if (!names[n] || !*names[n])
+            continue;
+        g_hash_table_iter_init (&iter, countries);
+        while (g_hash_table_iter_next (&iter, NULL, &country)) {
+            for (GSList *l = nma_country_info_get_providers (country); l; l = l->next) {
+                NMAMobileProvider *provider = l->data;
+                const char **codes = nma_mobile_provider_get_3gpp_mcc_mnc (provider);
+
+                if (codes && g_strv_contains (codes, self->operator_code) &&
+                    g_ascii_strcasecmp (nma_mobile_provider_get_name (provider), names[n]) == 0)
+                    return provider;
+            }
+        }
+    }
+
+    return nma_mobile_providers_database_lookup_3gpp_mcc_mnc (self->apn_db, self->operator_code);
+}
+
+/* Plinius: a suggestion whose APN is saved already (other user or password, or a name of the
+ * user's own) is no second entry: it only stood beside the saved one */
+static gboolean
+plinius_apn_is_saved (CcWwanData *self, NMAMobileAccessMethod *access_method)
+{
+    guint n_items = g_list_model_get_n_items (G_LIST_MODEL (self->apn_list));
+
+    for (guint i = 0; i < n_items; i++) {
+        g_autoptr(CcWwanDataApn) apn = g_list_model_get_item (G_LIST_MODEL (self->apn_list), i);
+        NMSettingGsm *setting;
+
+        if (!apn->remote_connection)
+            continue;
+        setting = nm_connection_get_setting_gsm (NM_CONNECTION (apn->remote_connection));
+        if (setting && g_strcmp0 (nm_setting_gsm_get_apn (setting),
+                                  nma_mobile_access_method_get_3gpp_apn (access_method)) == 0)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
 static void
 wwan_data_update_apn_list_db (CcWwanData *self)
 {
@@ -288,7 +352,7 @@
     }
 
     if (!self->apn_provider)
-        self->apn_provider = nma_mobile_providers_database_lookup_3gpp_mcc_mnc (self->apn_db, self->operator_code);
+        self->apn_provider = plinius_lookup_provider (self);
 
     if (self->apn_provider)
         apn_methods = nma_mobile_provider_get_methods (self->apn_provider);
@@ -304,6 +368,12 @@
 
         apn = wwan_data_find_matching_apn (self, l->data);
 
+        /* Plinius: not beside a saved access point with the same APN */
+        if (!apn && plinius_apn_is_saved (self, l->data)) {
+            i--; /* the next suggestion takes this position */
+            continue;
+        }
+
         /* Prepend the item in order */
         if (!apn) {
             apn = cc_wwan_data_apn_new ();
@@ -312,6 +382,8 @@
         }
 
         apn->access_method = l->data;
+        g_free (apn->plinius_provider_name);
+        apn->plinius_provider_name = g_strdup (nma_mobile_provider_get_name (self->apn_provider));
     }
 }
 
@@ -1035,6 +1107,7 @@
 
     wwan_data_apn_reset (apn);
     g_clear_pointer (&apn->access_method, nma_mobile_access_method_unref);
+    g_free (apn->plinius_provider_name);
 
     G_OBJECT_CLASS (cc_wwan_data_parent_class)->finalize (object);
 }
@@ -1092,8 +1165,17 @@
     if (apn->remote_connection)
         return nm_connection_get_id (NM_CONNECTION (apn->remote_connection));
 
-    if (apn->access_method)
-        return nma_mobile_access_method_get_name (apn->access_method);
+    if (apn->access_method) {
+        const char *name = nma_mobile_access_method_get_name (apn->access_method);
+
+        /* Plinius: an entry without a name gets "Default" from libnma ("Vorgabe" in German),
+         * which says nothing; the provider's name says where it comes from */
+        if ((!name || !*name || g_str_equal (name, "Default") ||
+             g_str_equal (name, g_dgettext ("libnma", "Default"))) &&
+            apn->plinius_provider_name && *apn->plinius_provider_name)
+            return apn->plinius_provider_name;
+        return name;
+    }
 
     return "";
 }
