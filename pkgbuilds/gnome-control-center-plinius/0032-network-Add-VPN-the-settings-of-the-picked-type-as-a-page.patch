From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 31 Oct 2026 10:32:54 +0100
Subject: [PATCH] network: Add VPN, the settings of the picked type as a page
 of their own

Plinius: after picking a VPN type in "Add VPN" its settings replaced the
list of types on the same page, and back closed the whole editor. They
now open as a page above the list, with "Add" in its header bar; back
(button or swipe) leads to the list of types again and drops the
connection begun, another type can be picked. Back on the list closes
the editor.
---
 .../connection-editor/net-connection-editor.c | 78 +++++++++++++++++--
 1 file changed, 71 insertions(+), 7 deletions(-)

diff --git a/panels/network/connection-editor/net-connection-editor.c b/panels/network/connection-editor/net-connection-editor.c
index b4628eceb..f7bbfaed6 100644
--- a/panels/network/connection-editor/net-connection-editor.c
+++ b/panels/network/connection-editor/net-connection-editor.c
@@ -68,6 +68,9 @@ struct _NetConnectionEditor {
     GPtrArray *pages;
     /* "done" was emitted, or the changes are being applied: closing is no cancel anymore */
     gboolean finished;
+    /* Plinius: the settings of the VPN type picked in "Add VPN", a page above the list of types
+     * (pages_box and apply_button move there) */
+    AdwNavigationPage *config_page;
 
     NMClient *client;
     NMDevice *device;
@@ -173,6 +176,7 @@ eap_method_ca_cert_ignore_load (NMConnection *connection)
 
 static void page_changed (NetConnectionEditor *self);
 static void page_row_activated_cb (NetConnectionEditor *self, GtkListBoxRow *row);
+static void navigation_popped_cb (NetConnectionEditor *self, AdwNavigationPage *page);
 
 /* Shown as a page of the window's navigation (cc-plinius-dialog-pages.c): the dialog itself has
  * no parent then, its child moved into the page */
@@ -352,6 +356,8 @@ net_connection_editor_init (NetConnectionEditor *self)
     gtk_widget_init_template (GTK_WIDGET (self));
     self->pages = g_ptr_array_new ();
     g_signal_connect_object (self->toast_overlay, "map", G_CALLBACK (content_map_cb), self, G_CONNECT_SWAPPED);
+    g_signal_connect_object (self->navigation_view, "popped", G_CALLBACK (navigation_popped_cb), self,
+                             G_CONNECT_SWAPPED);
 }
 
 static void
@@ -359,6 +365,7 @@ net_connection_editor_finalize (GObject *object)
 {
     NetConnectionEditor *self = NET_CONNECTION_EDITOR (object);
 
+    g_clear_object (&self->config_page);
     g_clear_object (&self->connection);
     g_clear_object (&self->orig_connection);
     g_clear_object (&self->device);
@@ -528,7 +535,8 @@ validate (NetConnectionEditor *self)
     g_autofree gchar *apply_tooltip = NULL;
     gint i;
 
-    if (!editor_is_initialized (self))
+    /* Plinius: back at the list of VPN types there is no connection */
+    if (!editor_is_initialized (self) || !self->connection)
         goto done;
 
     valid = TRUE;
@@ -575,11 +583,13 @@ recheck_initialization (NetConnectionEditor *self)
     if (!editor_is_initialized (self))
         return;
 
-    gtk_stack_set_visible_child (self->toplevel_stack, self->pages_box);
+    /* Plinius: with a VPN type picked, the settings are on a page of their own above the list */
+    if (!self->config_page)
+        gtk_stack_set_visible_child (self->toplevel_stack, self->pages_box);
 
     g_idle_add_once (idle_validate, self);
 
-    if (self->is_new_connection)
+    if (self->is_new_connection && !self->config_page)
         adw_bin_set_child (self->add_connection_frame, NULL);
 }
 
@@ -819,13 +829,46 @@ complete_vpn_connection (NetConnectionEditor *self, NMConnection *connection, GT
     return connection;
 }
 
+/* Plinius: the settings of the picked VPN type go on a page above the list of types, with "Add"
+ * in its header bar; back (button or swipe) leads to the list again (navigation_popped_cb) */
+static void
+push_config_page (NetConnectionEditor *self, const gchar *title)
+{
+    if (!self->config_page) {
+        GtkWidget *toolbar = adw_toolbar_view_new ();
+        GtkWidget *header = adw_header_bar_new ();
+        GtkWidget *main_header = gtk_widget_get_ancestor (GTK_WIDGET (self->apply_button), ADW_TYPE_HEADER_BAR);
+
+        adw_header_bar_set_show_start_title_buttons (ADW_HEADER_BAR (header), FALSE);
+        adw_header_bar_set_show_end_title_buttons (ADW_HEADER_BAR (header), FALSE);
+
+        g_object_ref (self->apply_button);
+        adw_header_bar_remove (ADW_HEADER_BAR (main_header), GTK_WIDGET (self->apply_button));
+        adw_header_bar_pack_end (ADW_HEADER_BAR (header), GTK_WIDGET (self->apply_button));
+        g_object_unref (self->apply_button);
+
+        g_object_ref (self->pages_box);
+        gtk_stack_remove (self->toplevel_stack, self->pages_box);
+        adw_toolbar_view_set_content (ADW_TOOLBAR_VIEW (toolbar), self->pages_box);
+        g_object_unref (self->pages_box);
+
+        adw_toolbar_view_add_top_bar (ADW_TOOLBAR_VIEW (toolbar), header);
+        self->config_page = g_object_ref_sink (adw_navigation_page_new (toolbar, title));
+    }
+
+    adw_navigation_page_set_title (self->config_page, title);
+    adw_navigation_view_push (self->navigation_view, self->config_page);
+}
+
 static void
-finish_add_connection (NetConnectionEditor *self, NMConnection *connection)
+finish_add_connection (NetConnectionEditor *self, NMConnection *connection, const gchar *title)
 {
     gtk_widget_set_visible (GTK_WIDGET (self->apply_button), TRUE);
 
-    if (connection)
+    if (connection) {
+        push_config_page (self, title);
         net_connection_editor_set_connection (self, connection);
+    }
 }
 
 static void
@@ -858,7 +901,7 @@ vpn_import_complete (NMConnection *connection, gpointer user_data)
     g_object_set (s_con, NM_SETTING_CONNECTION_AUTOCONNECT, FALSE, NULL);
     nm_setting_connection_add_permission (s_con, "user", g_get_user_name (), NULL);
 
-    finish_add_connection (self, connection);
+    finish_add_connection (self, connection, _("Add VPN"));
 }
 
 static void
@@ -888,7 +931,7 @@ vpn_type_activated (NetConnectionEditor *self, GtkWidget *row)
     g_object_set (s_con, NM_SETTING_CONNECTION_AUTOCONNECT, FALSE, NULL);
     nm_setting_connection_add_permission (s_con, "user", g_get_user_name (), NULL);
 
-    finish_add_connection (self, connection);
+    finish_add_connection (self, connection, adw_preferences_row_get_title (ADW_PREFERENCES_ROW (row)));
 }
 
 static void
@@ -966,6 +1009,27 @@ net_connection_editor_add_connection (NetConnectionEditor *self)
     set_editor_title (self, _("Add VPN"));
 }
 
+/* Plinius: back from the settings of a VPN type to the list of types: the connection begun
+ * there is dropped, another type can be picked */
+static void
+navigation_popped_cb (NetConnectionEditor *self, AdwNavigationPage *page)
+{
+    if (page != self->config_page || self->finished)
+        return;
+
+    g_ptr_array_set_size (self->pages, 0);
+    g_clear_pointer (&self->initializing_pages, g_slist_free);
+    gtk_list_box_remove_all (self->pages_list);
+    adw_bin_set_child (self->inline_page, NULL);
+    gtk_widget_set_visible (GTK_WIDGET (self->inline_page), FALSE);
+    g_clear_object (&self->connection);
+    g_clear_object (&self->orig_connection);
+    self->is_new_connection = FALSE;
+    self->is_changed = FALSE;
+
+    net_connection_editor_add_connection (self);
+}
+
 static void
 permission_changed (NetConnectionEditor *self, NMClientPermission permission, NMClientPermissionResult result)
 {
-- 
2.55.0

