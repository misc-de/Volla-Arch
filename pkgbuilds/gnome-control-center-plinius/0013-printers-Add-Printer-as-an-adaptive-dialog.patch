diff --git a/panels/printers/pp-utils.c b/panels/printers/pp-utils.c
index 0185b2e..cdb41af 100644
--- a/panels/printers/pp-utils.c
+++ b/panels/printers/pp-utils.c
@@ -2913,3 +2913,33 @@ printer_name_is_valid (const gchar *str)
     const gchar *invalid_chars = " \t#/";
     return strlen (str) == strcspn (str, invalid_chars);
 }
+
+/* Plinius: a drop-down over a GtkStringList that fits a phone screen. The button
+ * ellipsizes the selected entry, so that a long option value does not make the
+ * printer options wider than the screen; the popup list wraps long entries
+ * instead, so that they stay readable in full. */
+#define PP_DROP_DOWN_ITEM_UI(mode)                                                        \
+    "<interface><template class='GtkListItem'><property name='child'>"                    \
+    "<object class='GtkLabel'><property name='xalign'>0</property>" mode                  \
+    "<binding name='label'><lookup name='string' type='GtkStringObject'>"                 \
+    "<lookup name='item'>GtkListItem</lookup></lookup></binding></object>"                \
+    "</property></template></interface>"
+
+GtkWidget *
+pp_string_drop_down_new (void)
+{
+    static const char button_ui[] = PP_DROP_DOWN_ITEM_UI ("<property name='ellipsize'>end</property>");
+    static const char list_ui[] = PP_DROP_DOWN_ITEM_UI ("<property name='wrap'>True</property>"
+                                                        "<property name='max-width-chars'>30</property>");
+    g_autoptr(GBytes) button_bytes = g_bytes_new_static (button_ui, sizeof (button_ui) - 1);
+    g_autoptr(GBytes) list_bytes = g_bytes_new_static (list_ui, sizeof (list_ui) - 1);
+    g_autoptr(GtkListItemFactory) button_factory = gtk_builder_list_item_factory_new_from_bytes (NULL, button_bytes);
+    g_autoptr(GtkListItemFactory) list_factory = gtk_builder_list_item_factory_new_from_bytes (NULL, list_bytes);
+    GtkWidget *dropdown;
+
+    dropdown = gtk_drop_down_new (G_LIST_MODEL (gtk_string_list_new (NULL)), NULL);
+    gtk_drop_down_set_factory (GTK_DROP_DOWN (dropdown), button_factory);
+    gtk_drop_down_set_list_factory (GTK_DROP_DOWN (dropdown), list_factory);
+
+    return dropdown;
+}
