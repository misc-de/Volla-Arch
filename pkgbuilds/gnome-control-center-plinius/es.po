msgstr "Error al renombrar"

msgid "Restarting failed"
msgstr "Error al reiniciar"

#, c-format
msgid "On restart, %1$s will be renamed to %2$s. After that, you log in as %2$s."
msgstr "Al reiniciar, %1$s se renombrará a %2$s. Después, iniciarás sesión como %2$s."

msgid "Undoing failed"
msgstr "Error al deshacer"

msgid "Change Username"
msgstr "Cambiar nombre de usuario"

msgid "_Cancel"
msgstr "_Cancelar"

msgid "_Rename"
msgstr "_Renombrar"

msgid "The name you log in with. Your home folder, groups, automatic login and references in your settings are renamed along with it. Password and PIN stay the same. The renaming happens at the next restart, before login."
msgstr "El nombre con el que inicias sesión. Tu carpeta personal, los grupos, el inicio de sesión automático y las referencias en tu configuración se renombran con él. La contraseña y el PIN no cambian. El cambio se realiza en el próximo reinicio, antes de iniciar sesión."

msgid "Current Username"
msgstr "Nombre de usuario actual"

msgid "_New Username"
msgstr "_Nuevo nombre de usuario"

msgid "Scheduled for the Next Restart"
msgstr "Programado para el próximo reinicio"

