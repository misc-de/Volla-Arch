#: cc-plinius-selftest.c
msgid "The last update could not be read."
msgstr "No se pudo leer la última actualización."

#: cc-plinius-selftest.c
msgid "Last Update"
msgstr "Última actualización"

#: cc-plinius-selftest.c
msgid "_Take Back Update"
msgstr "_Deshacer actualización"

#: cc-plinius-selftest.c
msgid "Taking back the update… Do not switch off the phone."
msgstr "Deshaciendo la actualización… No apague el teléfono."

#: cc-plinius-selftest.c
msgid "Looking for the last update…"
msgstr "Buscando la última actualización…"

#: cc-plinius-selftest.c
msgid "Problem Found"
msgstr "Problema encontrado"

#: cc-plinius-selftest.c
msgid "Everything Works"
msgstr "Todo funciona"

#: cc-plinius-selftest.c
msgid "All checks after the start were fine."
msgstr "Todas las comprobaciones tras el arranque fueron correctas."

#: cc-plinius-selftest.c
msgid "Not Checked Yet"
msgstr "Aún no comprobado"

#: cc-plinius-selftest.c
msgid "The self-test runs a few minutes after the phone starts."
msgstr "La autoprueba se ejecuta unos minutos después de arrancar el teléfono."

#: cc-plinius-selftest.c
msgid "Check _Again"
msgstr "_Comprobar de nuevo"

#: cc-plinius-selftest.c
msgid "Self-Test"
msgstr "Autoprueba"

#: cc-plinius-selftest.c
msgid "_Self-Test"
msgstr "_Autoprueba"

#: cc-plinius-selftest.c
msgid "Whether the phone's parts work after the start"
msgstr "Si las partes del teléfono funcionan tras el arranque"

#: cc-plinius-selftest.c
msgid "One check failed."
msgid_plural "%u checks failed."
msgstr[0] "Una comprobación falló."
msgstr[1] "%u comprobaciones fallaron."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s goes back: one package returns to its earlier version. Restart the phone afterwards."
msgid_plural "The update of %s goes back: %u packages return to their earlier versions. Restart the phone afterwards."
msgstr[0] "Se deshace la actualización del %s: un paquete vuelve a su versión anterior. Reinicie el teléfono después."
msgstr[1] "Se deshace la actualización del %s: %u paquetes vuelven a sus versiones anteriores. Reinicie el teléfono después."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s changed one package. Its earlier version is still on the phone. If the problem began with this update, take it back. Asks for your PIN."
msgid_plural "The update of %s changed %u packages. Their earlier versions are still on the phone. If the problem began with this update, take it back. Asks for your PIN."
msgstr[0] "La actualización del %s cambió un paquete. Su versión anterior sigue en el teléfono. Si el problema empezó con esta actualización, deshágala. Pide su PIN."
msgstr[1] "La actualización del %s cambió %u paquetes. Sus versiones anteriores siguen en el teléfono. Si el problema empezó con esta actualización, deshágala. Pide su PIN."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s cannot be taken back: the earlier version of one package is no longer on the phone."
msgid_plural "The update of %s cannot be taken back: the earlier versions of %u packages are no longer on the phone."
msgstr[0] "La actualización del %s no se puede deshacer: la versión anterior de un paquete ya no está en el teléfono."
msgstr[1] "La actualización del %s no se puede deshacer: las versiones anteriores de %u paquetes ya no están en el teléfono."
