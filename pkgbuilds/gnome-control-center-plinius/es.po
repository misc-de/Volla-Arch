msgid "This username is available."
msgstr "Este nombre de usuario está disponible."

msgid "Lower case letters, numbers, hyphens and underscores, starting with a letter, at most 32 characters."
msgstr "Letras minúsculas, números, guiones y guiones bajos, empezando por una letra, como máximo 32 caracteres."

msgid "A group with this name already exists."
msgstr "Ya existe un grupo con este nombre."

msgid "A home folder with this name already exists."
msgstr "Ya existe una carpeta personal con este nombre."

