msgstr "Lee etiquetas NFC y se comunica con tarjetas y terminales acercados a la parte trasera del teléfono. Solo busca mientras la pantalla está encendida."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Patrón de desbloqueo"

msgid "On"
msgstr "Activado"

msgid "Off"
msgstr "Desactivado"

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "Con un patrón de desbloqueo, la pantalla de bloqueo acepta el patrón o una huella digital en lugar del PIN. Introduce tu PIN para continuar."

msgid "PIN"
msgstr "PIN"

msgid "Continue"
msgstr "Continuar"

msgid "Wrong PIN. Try again."
msgstr "PIN incorrecto. Inténtalo de nuevo."

msgid "Draw your current pattern."
msgstr "Dibuja tu patrón actual."

msgid "Wrong pattern. Try again."
msgstr "Patrón incorrecto. Inténtalo de nuevo."

msgid "Too many wrong tries. Try again later."
msgstr "Demasiados intentos fallidos. Inténtalo más tarde."

msgid "Use PIN Instead"
msgstr "Usar el PIN en su lugar"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Dibuja un patrón de desbloqueo. Une al menos 6 puntos."

msgid "Connect at least 6 points."
msgstr "Une al menos 6 puntos."

msgid "Draw the pattern again to confirm."
msgstr "Vuelve a dibujar el patrón para confirmar."

msgid "The patterns do not match. Draw a new one."
msgstr "Los patrones no coinciden. Dibuja uno nuevo."

msgid "The pattern could not be saved."
msgstr "No se pudo guardar el patrón."

msgid "The pattern could not be removed."
msgstr "No se pudo quitar el patrón."

msgid "Remove Pattern"
msgstr "Quitar patrón"

msgid "Draw Pattern"
msgstr "Dibuja el patrón"

msgid "Wrong Pattern"
msgstr "Patrón incorrecto"

msgid "Use PIN"
msgstr "Usar PIN"

msgid "Use Pattern"
msgstr "Usar patrón"

