+static void
+update_username_row (CcUserPage *self)
+{
+    g_autofree gchar *pending = NULL;
+    g_autofree gchar *label = NULL;
+    gboolean available;
+
+    available = cc_username_dialog_available (self->user);
+    gtk_widget_set_visible (GTK_WIDGET (self->username_row), available);
+    if (!available)
+        return;
+
+    pending = cc_username_dialog_get_pending (self->user);
+    if (pending)
+        label = g_strdup_printf ("%s → %s", act_user_get_user_name (self->user), pending);
+    cc_list_row_set_secondary_label (self->username_row, label ? label : act_user_get_user_name (self->user));
+}
+
+static void
+change_username (CcUserPage *self)
+{
+    CcUsernameDialog *dialog = cc_username_dialog_new (self->user);
+
+    g_signal_connect_object (dialog, "closed", G_CALLBACK (update_username_row), self, G_CONNECT_SWAPPED);
+    adw_dialog_present (ADW_DIALOG (dialog), GTK_WIDGET (self));
+}
