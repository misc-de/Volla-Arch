+/**
+ * cc_background_chooser_open_current:
+ *
+ * Plinius: opens the section of the current background (video, 360° photo, own or GNOME's
+ * picture) and closes the others; the animated effect's section is open while there is one.
+ * Called each time the page is shown.
+ */
+void
+cc_background_chooser_open_current (CcBackgroundChooser *self)
+{
+    gboolean video, photo, own;
+
+    g_return_if_fail (CC_IS_BACKGROUND_CHOOSER (self));
+
+    video = cc_plinius_video_is_active ();
+    photo = !video && cc_plinius_panorama_is_active ();
+    own = !video && !photo && active_item_is_recent (self);
+
+    adw_expander_row_set_expanded (self->animated_row, cc_plinius_ambient_effect_label () != NULL);
+    adw_expander_row_set_expanded (self->video_row, video);
+    adw_expander_row_set_expanded (self->panorama_row, photo);
+    adw_expander_row_set_expanded (self->recent_row, own);
+    adw_expander_row_set_expanded (self->wallpapers_row, !video && !photo && !own);
+}
