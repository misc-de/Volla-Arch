+
+/* Plinius: whether the current picture is one of the own pictures */
+static gboolean
+active_item_is_recent (CcBackgroundChooser *self)
+{
+    GListModel *model = G_LIST_MODEL (bg_source_get_liststore (BG_SOURCE (self->recent_source)));
+    const char *uri;
+
+    if (!self->active_item || !(uri = cc_background_item_get_uri (self->active_item)))
+        return FALSE;
+
+    for (guint i = 0; i < g_list_model_get_n_items (model); i++) {
+        g_autoptr(CcBackgroundItem) item = g_list_model_get_item (model, i);
+
+        if (g_strcmp0 (cc_background_item_get_uri (item), uri) == 0)
+            return TRUE;
+    }
+    return FALSE;
