diff --git a/panels/network/cc-wifi-hotspot-dialog.c b/panels/network/cc-wifi-hotspot-dialog.c
index deb261036..d222c67f3 100644
--- a/panels/network/cc-wifi-hotspot-dialog.c
+++ b/panels/network/cc-wifi-hotspot-dialog.c
@@ -34,13 +34,18 @@
 #include "panel-common.h"
 #include "ui-helpers.h"
 
+/* Plinius: our own strings, in the gettext domain plinius-control-center (not GNOME's po/) */
+#define PLINIUS_DOMAIN "plinius-control-center"
+#define P_(String) g_dgettext (PLINIUS_DOMAIN, String)
+
 struct _CcWifiHotspotDialog {
     AdwDialog parent_instance;
 
+    AdwToolbarView *toolbar_view;
     GtkLabel *connection_label;
-    GtkEntry *name_entry;
+    AdwEntryRow *name_entry;
     GtkLabel *name_error_label;
-    GtkEntry *password_entry;
+    AdwEntryRow *password_entry;
     GtkLabel *password_error_label;
     GtkButton *ok_button;
 
@@ -95,6 +100,7 @@ wifi_hotspot_dialog_update_main_label (CcWifiHotspotDialog *self)
     g_assert (CC_IS_WIFI_HOTSPOT_DIALOG (self));
 
     gtk_label_set_markup (self->connection_label, "");
+    gtk_widget_set_visible (GTK_WIDGET (self->connection_label), FALSE);
 
     if (!self->device)
         return;
@@ -116,6 +122,7 @@ wifi_hotspot_dialog_update_main_label (CcWifiHotspotDialog *self)
                              "and it will not be possible to access the internet through Wi-Fi."),
                                ssid_text);
     gtk_label_set_markup (self->connection_label, label);
+    gtk_widget_set_visible (GTK_WIDGET (self->connection_label), TRUE);
 }
 
 static void
@@ -245,8 +252,15 @@ hotspot_entry_changed_cb (CcWifiHotspotDialog *self)
         widget_set_error (GTK_WIDGET (self->password_entry));
     }
 
+    /* Plinius: without the field's placeholder, the hint says what an empty password does */
+    if (valid_password && (!password || !*password))
+        password_error_label = P_("Left empty, a random password is made up.");
+
     gtk_label_set_label (self->name_error_label, ssid_error_label);
     gtk_label_set_label (self->password_error_label, password_error_label);
+    /* Plinius: below the list, only where there is something to say */
+    gtk_widget_set_visible (GTK_WIDGET (self->name_error_label), *ssid_error_label != '\0');
+    gtk_widget_set_visible (GTK_WIDGET (self->password_error_label), *password_error_label != '\0');
     gtk_widget_set_sensitive (GTK_WIDGET (self->ok_button), valid_ssid && valid_password);
 }
 
@@ -355,10 +369,11 @@ cc_wifi_hotspot_dialog_finalize (GObject *object)
     G_OBJECT_CLASS (cc_wifi_hotspot_dialog_parent_class)->finalize (object);
 }
 
+/* Plinius: as a page of the window (shell/cc-plinius-dialog-pages.c) only the dialog's content is
+ * shown, the dialog itself is never realized: the fields are filled when the content is */
 static void
-cc_wifi_hotspot_dialog_realize (GtkWidget *widget)
+cc_wifi_hotspot_dialog_content_realize_cb (CcWifiHotspotDialog *self)
 {
-    CcWifiHotspotDialog *self = (CcWifiHotspotDialog *) widget;
     g_warn_if_fail (self->device != NULL);
 
     gtk_widget_grab_focus (GTK_WIDGET (self->ok_button));
@@ -368,7 +383,8 @@ cc_wifi_hotspot_dialog_realize (GtkWidget *widget)
         if (self->host_name)
             gtk_editable_set_text (GTK_EDITABLE (self->name_entry), self->host_name);
 
-    GTK_WIDGET_CLASS (cc_wifi_hotspot_dialog_parent_class)->realize (widget);
+    /* the hints below the fields from the start, not only after a change */
+    hotspot_entry_changed_cb (self);
 }
 
 static void
@@ -407,14 +423,13 @@ cc_wifi_hotspot_dialog_class_init (CcWifiHotspotDialogClass *klass)
 
     object_class->finalize = cc_wifi_hotspot_dialog_finalize;
 
-    widget_class->realize = cc_wifi_hotspot_dialog_realize;
-
     gtk_widget_class_set_template_from_resource (widget_class,
                                                  "/org/gnome/control-center/network/cc-wifi-hotspot-dialog.ui");
 
     signals[SIGNAL_HOTSPOT_ENABLED] = g_signal_new ("hotspot-enabled", CC_TYPE_WIFI_HOTSPOT_DIALOG, G_SIGNAL_RUN_LAST,
                                                     0, NULL, NULL, NULL, G_TYPE_NONE, 0, NULL);
 
+    gtk_widget_class_bind_template_child (widget_class, CcWifiHotspotDialog, toolbar_view);
     gtk_widget_class_bind_template_child (widget_class, CcWifiHotspotDialog, connection_label);
     gtk_widget_class_bind_template_child (widget_class, CcWifiHotspotDialog, name_entry);
     gtk_widget_class_bind_template_child (widget_class, CcWifiHotspotDialog, name_error_label);
@@ -433,6 +448,10 @@ cc_wifi_hotspot_dialog_init (CcWifiHotspotDialog *self)
     self->cancellable = g_cancellable_new ();
 
     gtk_widget_init_template (GTK_WIDGET (self));
+
+    /* Plinius: realized as a dialog and as a page */
+    g_signal_connect_object (self->toolbar_view, "realize", G_CALLBACK (cc_wifi_hotspot_dialog_content_realize_cb),
+                             self, G_CONNECT_SWAPPED);
 }
 
