+  child: Adw.ToolbarView toolbar_view {
     [top]
-    /* Plinius: a page of the window, so back (the arrow and the back swipe) cancels and the
-     * confirming button sits below the form, where the thumb is */
     Adw.HeaderBar {
       show-start-title-buttons: false;
       show-end-title-buttons: false;
     }
 
-    content: Box {
-      orientation: vertical;
-      margin-top: 30;
-      margin-bottom: 30;
-      margin-start: 30;
-      margin-end: 30;
-      spacing: 20;
-
-      Label label {
-        wrap: true;
-        max-width-chars: 50;
-        label: _("Wi-Fi hotspot allows others to share your internet connection, by creating a Wi-Fi network that they can connect to. To do this, you must have an internet connection through a source other than Wi-Fi.");
-        xalign: 0.0;
-      }
+    content: Adw.PreferencesPage {
+      Adw.PreferencesGroup {
+        description: _("Wi-Fi hotspot allows others to share your internet connection, by creating a Wi-Fi network that they can connect to. To do this, you must have an internet connection through a source other than Wi-Fi.");
 
-      Label connection_label {
-        margin-bottom: 18;
-        wrap: true;
-        max-width-chars: 40;
-        use-markup: true;
-        xalign: 0.0;
-      }
