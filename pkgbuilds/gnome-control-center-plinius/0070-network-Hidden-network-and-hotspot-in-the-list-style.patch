-            row: 2;
-          }
-        }
-
-        Entry password_entry {
-          max-length: 64;
-          secondary-icon-name: "view-refresh-symbolic";
-          secondary-icon-tooltip-text: _("Generate Random Password");
-          placeholder-text: _("Autogenerate Password");
-          icon-press => $generate_password_clicked_cb(template);
-          changed => $hotspot_entry_changed_cb(template);
-
-          accessibility {
-            error-message: password_error_label;
-          }
-
-          layout {
-            column: 1;
-            row: 2;
-          }
-        }
-
         Label password_error_label {
-          halign: start;
-
-          layout {
-            column: 1;
-            row: 3;
-          }
+          visible: false;
+          margin-top: 6;
+          wrap: true;
+          xalign: 0.0;
 
           styles [
             "dim-label",
@@ -125,18 +89,19 @@ template $CcWifiHotspotDialog: Adw.Dialog {
         }
       }
 
-      Button ok_button {
-        halign: center;
-        margin-top: 12;
-        use-underline: true;
-        label: _("_Turn On");
-        receives-default: true;
-        clicked => $on_turn_on_button_clicked_cb(template);
-
-        styles [
-          "pill",
-          "suggested-action",
-        ]
+      Adw.PreferencesGroup {
+        Button ok_button {
+          halign: center;
+          use-underline: true;
+          label: _("_Turn On");
+          receives-default: true;
+          clicked => $on_turn_on_button_clicked_cb(template);
+
+          styles [
+            "pill",
+            "suggested-action",
+          ]
+        }
       }
