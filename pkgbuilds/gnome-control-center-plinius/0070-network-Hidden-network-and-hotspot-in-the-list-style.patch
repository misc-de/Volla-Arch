+          visible: false;
+          wrap: true;
+          use-markup: true;
+          xalign: 0.0;
 
-      Grid {
-        row-spacing: 6;
-        column-spacing: 12;
+          styles [
+            "dim-label",
+          ]
+        }
+      }
 
-        Label {
-          label: _("Network Name");
-          halign: end;
-          mnemonic-widget: name_entry;
+      Adw.PreferencesGroup {
+        Adw.EntryRow name_entry {
+          title: _("Network Name");
+          changed => $hotspot_entry_changed_cb(template);
 
-          layout {
-            column: 0;
-            row: 0;
+          accessibility {
+            error-message: name_error_label;
+            required: true;
           }
         }
 
-        Entry name_entry {
-          hexpand: true;
-          max-length: 64;
+        Adw.EntryRow password_entry {
+          title: _("Password");
           changed => $hotspot_entry_changed_cb(template);
 
           accessibility {
-            error-message: name_error_label;
-            required: true;
+            error-message: password_error_label;
           }
 
-          layout {
-            column: 1;
-            row: 0;
+          [suffix]
+          Button {
+            valign: center;
+            icon-name: "view-refresh-symbolic";
+            tooltip-text: _("Generate Random Password");
+            clicked => $generate_password_clicked_cb(template);
+
+            styles [
+              "flat",
+            ]
           }
         }
 
+        /* below the list: what is wrong, or that an empty password is made up */
         Label name_error_label {
-          halign: start;
-
-          layout {
-            column: 1;
-            row: 1;
-          }
+          visible: false;
+          margin-top: 6;
+          wrap: true;
+          xalign: 0.0;
 
           styles [
             "dim-label",
@@ -81,42 +76,11 @@ template $CcWifiHotspotDialog: Adw.Dialog {
           ]
         }
 
-        Label {
-          label: _("Password");
-          halign: end;
-          mnemonic-widget: password_entry;
-
-          layout {
