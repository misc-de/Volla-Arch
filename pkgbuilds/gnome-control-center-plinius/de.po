#: cc-plinius-selftest.c
msgid "Working"
msgstr "Funktioniert"

#: cc-plinius-selftest.c
msgid "Not checked: nobody was logged in."
msgstr "Nicht geprüft: niemand war angemeldet."

#: cc-plinius-selftest.c
#, c-format
msgid "Not started: %s"
msgstr "Nicht gestartet: %s"

#: cc-plinius-selftest.c
msgid "Not checked: not authorized"
msgstr "Nicht geprüft: nicht berechtigt"

#: cc-plinius-selftest.c
msgid "The self-test could not run"
msgstr "Der Selbsttest konnte nicht laufen"

#: cc-plinius-selftest.c
msgid "Checking…"
msgstr "Wird geprüft…"

#: cc-plinius-selftest.c
msgid "The update was taken back. Restart the phone to load the earlier versions."
msgstr "Das Update wurde zurückgenommen. Starten Sie das Telefon neu, um die früheren Versionen zu laden."

#: cc-plinius-selftest.c
msgid "Not taken back: not authorized."
msgstr "Nicht zurückgenommen: nicht berechtigt."

#: cc-plinius-selftest.c
#, c-format
msgid "Not taken back: the rollback stopped with status %d."
msgstr "Nicht zurückgenommen: die Rücknahme endete mit Status %d."

#: cc-plinius-selftest.c
#, c-format
msgid "Not taken back: %s"
msgstr "Nicht zurückgenommen: %s"

#: cc-plinius-selftest.c
msgid "Take Back the Last Update?"
msgstr "Letztes Update zurücknehmen?"

#: cc-plinius-selftest.c
msgid "_Take Back"
msgstr "_Zurücknehmen"

#: cc-plinius-selftest.c
msgid "There is no update to take back."
msgstr "Es gibt kein Update zum Zurücknehmen."

#: cc-plinius-selftest.c
msgid "The last update could not be read."
msgstr "Das letzte Update konnte nicht gelesen werden."

#: cc-plinius-selftest.c
msgid "Last Update"
msgstr "Letztes Update"

#: cc-plinius-selftest.c
msgid "_Take Back Update"
msgstr "Update _zurücknehmen"

#: cc-plinius-selftest.c
msgid "Taking back the update… Do not switch off the phone."
msgstr "Update wird zurückgenommen… Schalten Sie das Telefon nicht aus."

#: cc-plinius-selftest.c
msgid "Looking for the last update…"
msgstr "Letztes Update wird gesucht…"

#: cc-plinius-selftest.c
msgid "Problem Found"
msgstr "Problem gefunden"

#: cc-plinius-selftest.c
msgid "Everything Works"
msgstr "Alles funktioniert"

#: cc-plinius-selftest.c
msgid "All checks after the start were fine."
msgstr "Alle Prüfungen nach dem Start waren in Ordnung."

#: cc-plinius-selftest.c
msgid "Not Checked Yet"
msgstr "Noch nicht geprüft"

#: cc-plinius-selftest.c
msgid "The self-test runs a few minutes after the phone starts."
msgstr "Der Selbsttest läuft einige Minuten nach dem Start des Telefons."

#: cc-plinius-selftest.c
msgid "Check _Again"
msgstr "_Erneut prüfen"

#: cc-plinius-selftest.c
msgid "Self-Test"
msgstr "Selbsttest"

#: cc-plinius-selftest.c
msgid "_Self-Test"
msgstr "_Selbsttest"

#: cc-plinius-selftest.c
msgid "Whether the phone's parts work after the start"
msgstr "Ob die Teile des Telefons nach dem Start funktionieren"

#: cc-plinius-selftest.c
msgid "One check failed."
msgid_plural "%u checks failed."
msgstr[0] "Eine Prüfung ist fehlgeschlagen."
msgstr[1] "%u Prüfungen sind fehlgeschlagen."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s goes back: one package returns to its earlier version. Restart the phone afterwards."
msgid_plural "The update of %s goes back: %u packages return to their earlier versions. Restart the phone afterwards."
msgstr[0] "Das Update vom %s wird zurückgenommen: ein Paket kehrt zu seiner früheren Version zurück. Starten Sie das Telefon danach neu."
msgstr[1] "Das Update vom %s wird zurückgenommen: %u Pakete kehren zu ihren früheren Versionen zurück. Starten Sie das Telefon danach neu."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s changed one package. Its earlier version is still on the phone. If the problem began with this update, take it back. Asks for your PIN."
msgid_plural "The update of %s changed %u packages. Their earlier versions are still on the phone. If the problem began with this update, take it back. Asks for your PIN."
msgstr[0] "Das Update vom %s hat ein Paket geändert. Seine frühere Version ist noch auf dem Telefon. Wenn das Problem mit diesem Update begann, nehmen Sie es zurück. Fragt nach Ihrer PIN."
msgstr[1] "Das Update vom %s hat %u Pakete geändert. Ihre früheren Versionen sind noch auf dem Telefon. Wenn das Problem mit diesem Update begann, nehmen Sie es zurück. Fragt nach Ihrer PIN."

#: cc-plinius-selftest.c
#, c-format
msgid "The update of %s cannot be taken back: the earlier version of one package is no longer on the phone."
msgid_plural "The update of %s cannot be taken back: the earlier versions of %u packages are no longer on the phone."
msgstr[0] "Das Update vom %s lässt sich nicht zurücknehmen: die frühere Version eines Pakets ist nicht mehr auf dem Telefon."
msgstr[1] "Das Update vom %s lässt sich nicht zurücknehmen: die früheren Versionen von %u Paketen sind nicht mehr auf dem Telefon."
