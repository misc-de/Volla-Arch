msgstr[0] "AppArmor obserwuje %u usługę, jeszcze jej nie blokując."
msgstr[1] "AppArmor obserwuje %u usługi, jeszcze ich nie blokując."
msgstr[2] "AppArmor obserwuje %u usług, jeszcze ich nie blokując."

msgid "AppArmor confines %u service of the network and the radio."
msgid_plural "AppArmor confines %u services of the network and the radio."
msgstr[0] "AppArmor ogranicza %u usługę sieci i radia."
msgstr[1] "AppArmor ogranicza %u usługi sieci i radia."
msgstr[2] "AppArmor ogranicza %u usług sieci i radia."

