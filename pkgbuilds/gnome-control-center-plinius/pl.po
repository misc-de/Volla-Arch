# Device Security › Access Control (cc-plinius-security.c)
msgid "Access Control"
msgstr "Kontrola dostępu"

msgid "SELinux enforces its policy."
msgstr "SELinux egzekwuje swoją politykę."

msgid "SELinux is on but only logs."
msgstr "SELinux jest włączony, ale tylko zapisuje dziennik."

msgid "No access control. A program that is taken over can reach everything its user can."
msgstr "Brak kontroli dostępu. Przejęty program ma dostęp do wszystkiego, do czego ma dostęp jego użytkownik."

msgid "AppArmor is on, but no program is confined yet."
msgstr "AppArmor jest włączony, ale nie ogranicza jeszcze żadnego programu."

msgid "Access control limits each confined program to what it needs, also when it runs as root: a service taken over through the network cannot read your data or reach other services."
msgstr "Kontrola dostępu ogranicza każdy objęty nią program do tego, czego potrzebuje, także gdy działa jako root: usługa przejęta przez sieć nie odczyta twoich danych ani nie dotrze do innych usług."

msgid "SELinux, enforcing"
msgstr "SELinux, egzekwowanie"

msgid "SELinux, only logging"
msgstr "SELinux, tylko dziennik"

msgid "AppArmor"
msgstr "AppArmor"

msgid "In the Kernel"
msgstr "W jądrze"

msgid "“Logging only”: the profile records what the service does and blocks nothing yet, until its rules are complete."
msgstr "„Tylko dziennik”: profil zapisuje, co robi usługa, i jeszcze niczego nie blokuje, dopóki jego reguły nie będą kompletne."

msgid "Not loaded"
msgstr "Nie wczytano"

msgid "Enforced"
msgstr "Egzekwowany"

msgid "Logging only"
msgstr "Tylko dziennik"

msgid "AppArmor confines %u service; more only log what they do."
msgid_plural "AppArmor confines %u services; more only log what they do."
msgstr[0] "AppArmor ogranicza %u usługę; kolejne tylko zapisują, co robią."
msgstr[1] "AppArmor ogranicza %u usługi; kolejne tylko zapisują, co robią."
msgstr[2] "AppArmor ogranicza %u usług; kolejne tylko zapisują, co robią."

