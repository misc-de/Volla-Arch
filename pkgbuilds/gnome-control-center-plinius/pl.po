msgstr "Dodawanie, przełączanie i usuwanie profili"

msgid "eSIM Not Available"
msgstr "eSIM niedostępna"

msgid "_Try Again"
msgstr "Spróbuj _ponownie"

msgid "Profiles"
msgstr "Profile"

msgid "Only one profile can be active at a time."
msgstr "Naraz może być aktywny tylko jeden profil."

msgid "There are no profiles on this eSIM yet."
msgstr "Na tej eSIM nie ma jeszcze profili."

msgid "_Add Profile…"
msgstr "_Dodaj profil…"

msgid "eSIM Chip"
msgstr "Układ eSIM"

msgid "EID"
msgstr "EID"

msgid "Copy EID"
msgstr "Kopiuj EID"

msgid "EID copied"
msgstr "Skopiowano EID"

msgid "Free Memory"
msgstr "Wolna pamięć"

msgid "Specification"
msgstr "Specyfikacja"

msgid "Profile"
msgstr "Profil"

msgid "Label"
msgstr "Etykieta"

msgid "Shown instead of the network's name."
msgstr "Wyświetlana zamiast nazwy sieci."

msgid "Provider"
msgstr "Operator"

msgid "Profile Name"
msgstr "Nazwa profilu"

msgid "ICCID"
msgstr "ICCID"

msgid "Type"
msgstr "Rodzaj"

msgid "Active"
msgstr "Aktywny"

msgid "_Active"
msgstr "_Aktywny"

msgid "Test profile"
msgstr "Profil testowy"

msgid "Provisioning profile"
msgstr "Profil udostępniania"

msgid "Operator profile"
msgstr "Profil operatora"

msgid "_Delete Profile…"
msgstr "_Usuń profil…"

msgid "Delete Profile?"
msgstr "Usunąć profil?"

#, c-format
msgid "“%s” will be removed from the eSIM for good. To use it again, you need a new activation code from the provider."
msgstr "„%s” zostanie trwale usunięty z eSIM. Aby znów go używać, potrzebny jest nowy kod aktywacyjny od operatora."

msgid "Profile deleted"
msgstr "Usunięto profil"

msgid "Add Profile"
msgstr "Dodaj profil"

msgid "Enter the activation code from your provider. It starts with “LPA:1$”, the QR code from the provider contains the same text."
msgstr "Wpisz kod aktywacyjny od operatora. Zaczyna się od „LPA:1$”, kod QR od operatora zawiera ten sam tekst."

msgid "Activation Code"
msgstr "Kod aktywacyjny"

msgid "Confirmation Code (if required)"
msgstr "Kod potwierdzenia (jeśli wymagany)"

msgid "_Download Profile"
msgstr "_Pobierz profil"

msgid "Downloading the profile. This can take a minute."
msgstr "Pobieranie profilu. Może to potrwać minutę."

msgid "Profile added. Switch it on to use it."
msgstr "Dodano profil. Włącz go, aby z niego korzystać."

msgid "Done. The mobile network may take a moment to appear."
msgstr "Gotowe. Sieć komórkowa może pojawić się po chwili."

msgid "Reading the profiles failed"
msgstr "Nie udało się odczytać profili"

msgid "Switching the profile failed"
msgstr "Nie udało się przełączyć profilu"

msgid "Renaming the profile failed"
msgstr "Nie udało się zmienić nazwy profilu"

msgid "Deleting the profile failed"
msgstr "Nie udało się usunąć profilu"

msgid "Downloading the profile failed"
msgstr "Nie udało się pobrać profilu"

