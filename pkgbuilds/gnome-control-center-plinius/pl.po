msgid "A dimmed screen gets bright again, a dark one stays off"
msgstr "Przyciemniony ekran znów się rozjaśnia, wygaszony pozostaje wyłączony"

msgid "App Overview"
msgstr "Przegląd aplikacji"

msgid "Search"
msgstr "Wyszukiwanie"

msgid "Search field above the apps"
msgstr "Pole wyszukiwania nad aplikacjami"

msgid "App Names"
msgstr "Nazwy aplikacji"

msgid "Names under the app icons"
msgstr "Nazwy pod ikonami aplikacji"

msgid "Folders at the Bottom"
msgstr "Foldery na dole"

msgid "Folders in one row at the bottom edge, scrolling sideways"
msgstr "Foldery w jednym rzędzie na dole, przewijane w bok"

msgid "Mobile Apps Button"
msgstr "Przycisk „Aplikacje mobilne”"

msgid "Button that shows only the apps made for phones"
