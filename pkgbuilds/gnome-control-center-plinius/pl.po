# Plinius: NFC panel (cc-nfc-panel.*)
msgid "Switching NFC failed"
msgstr "Nie udało się przełączyć NFC"

msgid "Reads NFC tags and talks to cards and terminals held to the back of the phone. It only looks for them while the screen is on."
msgstr "Odczytuje tagi NFC i komunikuje się z kartami oraz terminalami przyłożonymi do tyłu telefonu. Szuka tylko przy włączonym ekranie."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Wzór odblokowania"

msgid "On"
msgstr "Włączony"

msgid "Off"
msgstr "Wyłączony"

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "Gdy ustawiony jest wzór odblokowania, ekran blokady przyjmuje wzór lub odcisk palca zamiast kodu PIN. Wpisz PIN, aby kontynuować."

msgid "PIN"
msgstr "PIN"

msgid "Continue"
msgstr "Dalej"

msgid "Wrong PIN. Try again."
msgstr "Nieprawidłowy PIN. Spróbuj ponownie."

msgid "Draw your current pattern."
msgstr "Narysuj obecny wzór."

msgid "Wrong pattern. Try again."
msgstr "Nieprawidłowy wzór. Spróbuj ponownie."

msgid "Too many wrong tries. Try again later."
msgstr "Zbyt wiele nieudanych prób. Spróbuj ponownie później."

msgid "Use PIN Instead"
msgstr "Użyj kodu PIN"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Narysuj wzór odblokowania. Połącz co najmniej 6 punktów."

msgid "Connect at least 6 points."
msgstr "Połącz co najmniej 6 punktów."

msgid "Draw the pattern again to confirm."
msgstr "Narysuj wzór ponownie, aby potwierdzić."

msgid "The patterns do not match. Draw a new one."
msgstr "Wzory nie są zgodne. Narysuj nowy."

msgid "The pattern could not be saved."
msgstr "Nie udało się zapisać wzoru."

msgid "The pattern could not be removed."
msgstr "Nie udało się usunąć wzoru."

msgid "Remove Pattern"
msgstr "Usuń wzór"

msgid "Draw Pattern"
msgstr "Narysuj wzór"

msgid "Wrong Pattern"
msgstr "Nieprawidłowy wzór"

msgid "Use PIN"
msgstr "Użyj kodu PIN"

msgid "Use Pattern"
msgstr "Użyj wzoru"

