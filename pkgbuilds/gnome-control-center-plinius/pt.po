msgstr "Lê etiquetas NFC e comunica com cartões e terminais encostados à parte de trás do telefone. Só procura enquanto o ecrã está ligado."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Padrão de desbloqueio"

msgid "On"
msgstr "Ativado"

msgid "Off"
msgstr "Desativado"

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "Com um padrão de desbloqueio, o ecrã de bloqueio aceita o padrão ou uma impressão digital em vez do PIN. Introduza o PIN para continuar."

msgid "PIN"
msgstr "PIN"

msgid "Continue"
msgstr "Continuar"

msgid "Wrong PIN. Try again."
msgstr "PIN incorreto. Tente novamente."

msgid "Draw your current pattern."
msgstr "Desenhe o padrão atual."

msgid "Wrong pattern. Try again."
msgstr "Padrão incorreto. Tente novamente."

msgid "Too many wrong tries. Try again later."
msgstr "Demasiadas tentativas erradas. Tente novamente mais tarde."

msgid "Use PIN Instead"
msgstr "Usar antes o PIN"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Desenhe um padrão de desbloqueio. Ligue pelo menos 6 pontos."

msgid "Connect at least 6 points."
msgstr "Ligue pelo menos 6 pontos."

msgid "Draw the pattern again to confirm."
msgstr "Desenhe o padrão novamente para confirmar."

msgid "The patterns do not match. Draw a new one."
msgstr "Os padrões não coincidem. Desenhe um novo."

msgid "The pattern could not be saved."
msgstr "Não foi possível guardar o padrão."

msgid "The pattern could not be removed."
msgstr "Não foi possível remover o padrão."

msgid "Remove Pattern"
msgstr "Remover padrão"

msgid "Draw Pattern"
msgstr "Desenhe o padrão"

msgid "Wrong Pattern"
msgstr "Padrão incorreto"

msgid "Use PIN"
msgstr "Usar PIN"

msgid "Use Pattern"
msgstr "Usar padrão"

