From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 1 Nov 2026 20:30:00 +0100
Subject: [PATCH] keyboard: Speech to text below the input sources

A switch for the microphone key of the on-screen keyboard (plinius-dictate,
setting org.plinius.dictate enabled). The group lives in cc-plinius-dictate.c;
this only names the page and calls it.
---
--- a/panels/keyboard/cc-keyboard-panel.blp
+++ b/panels/keyboard/cc-keyboard-panel.blp
@@ -8,7 +8,7 @@
     [top]
     Adw.HeaderBar {}
 
-    content: Adw.PreferencesPage {
+    content: Adw.PreferencesPage preferences_page {
       Adw.PreferencesGroup {
         title: _("Input Sources");
         description: _("Includes keyboard layouts and input methods");
--- a/panels/keyboard/cc-keyboard-panel.c
+++ b/panels/keyboard/cc-keyboard-panel.c
@@ -31,6 +31,7 @@
 #include "cc-keyboard-resources.h"
 #include "cc-keyboard-shortcut-page.h"
 #include "cc-list-row.h"
+#include "cc-plinius-dictate.h"
 #include "cc-xkb-modifier-page.h"
 
 #include "keyboard-shortcuts.h"
@@ -38,6 +39,7 @@
 struct _CcKeyboardPanel {
     CcPanel parent_instance;
 
+    AdwPreferencesPage *preferences_page;
     GtkCheckButton *per_window_source;
     GtkCheckButton *same_source;
     GSettings *keybindings_settings;
@@ -174,6 +176,7 @@
     gtk_widget_class_set_template_from_resource (widget_class,
                                                  "/org/gnome/control-center/keyboard/cc-keyboard-panel.ui");
 
+    gtk_widget_class_bind_template_child (widget_class, CcKeyboardPanel, preferences_page);
     gtk_widget_class_bind_template_child (widget_class, CcKeyboardPanel, input_switch_group);
     gtk_widget_class_bind_template_child (widget_class, CcKeyboardPanel, per_window_source);
     gtk_widget_class_bind_template_child (widget_class, CcKeyboardPanel, same_source);
@@ -216,6 +219,9 @@
 
     gtk_widget_init_template (GTK_WIDGET (self));
 
+    /* Plinius: speech to text in the on-screen keyboard, below the input sources */
+    cc_plinius_dictate_setup (self->preferences_page);
+
     self->input_source_settings = g_settings_new ("org.gnome.desktop.input-sources");
 
     /* "Input Source Switching" section */
--- a/panels/keyboard/meson.build
+++ b/panels/keyboard/meson.build
@@ -85,6 +85,7 @@
   'cc-keyboard-shortcut-group.c',
   'cc-keyboard-shortcut-page.c',
   'cc-keyboard-panel.c',
+  'cc-plinius-dictate.c',
   'cc-keyboard-item.c',
   'cc-keyboard-manager.c',
   'cc-keyboard-shortcut-editor.c',
