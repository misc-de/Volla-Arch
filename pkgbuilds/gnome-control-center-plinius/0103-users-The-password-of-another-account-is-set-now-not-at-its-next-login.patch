From 448439f60efafc7c4a2a0d0655d5b494162ebfd7 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 22 Nov 2026 09:01:26 +0100
Subject: [PATCH] users: The password of another account is set now, not at its
 next login

For another account the password dialog started with "set at next
login". accountsservice removes the password for it (passwd -d and
chage -d 0): until that login anybody holding the phone could use the
account, and Phosh's lock screen cannot ask for a new password.
plinius-greeter does not offer such an account a first start either.
The dialog now always sets the password at once and hides the choice.
---
 panels/system/users/cc-password-dialog.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/panels/system/users/cc-password-dialog.c b/panels/system/users/cc-password-dialog.c
index 7b9ce11..b215994 100644
--- a/panels/system/users/cc-password-dialog.c
+++ b/panels/system/users/cc-password-dialog.c
@@ -507,8 +507,11 @@ cc_password_dialog_new (ActUser *user)
 
         self->passwd_handler = passwd_init ();
     } else {
-        mode_change (self, ACT_USER_PASSWORD_MODE_SET_AT_LOGIN);
-        gtk_widget_set_visible (GTK_WIDGET (self->password_on_next_login_group), TRUE);
+        /* Another account gets its new password now. "Set at next login" would remove the
+         * password (passwd -d): until that login anybody holding the phone could use the
+         * account, and the lock screen has no way to ask for a new one */
+        mode_change (self, ACT_USER_PASSWORD_MODE_REGULAR);
+        gtk_widget_set_visible (GTK_WIDGET (self->password_on_next_login_group), FALSE);
 
         gtk_widget_set_visible (GTK_WIDGET (self->old_password_entry), FALSE);
         self->old_password_ok = TRUE;
