From: misc-de <misc-de@users.noreply.github.com>
Subject: [PATCH] bluetooth: Contacts, which devices may read them

cc-plinius-bt-contacts.c (a separate file of the package) is built with
the Bluetooth panel and adds a row "Contacts" at its bottom: a page with a
switch for each device that asked for the contacts over Bluetooth (PBAP),
kept in the file obexd of bluez-obex-plinius reads. Nothing shows without
bluez-obex-plinius. The toolbar view gets a name for the row.
---
diff --git a/panels/bluetooth/cc-bluetooth-panel.blp b/panels/bluetooth/cc-bluetooth-panel.blp
index a8bc8a766..fbd2f536f 100644
--- a/panels/bluetooth/cc-bluetooth-panel.blp
+++ b/panels/bluetooth/cc-bluetooth-panel.blp
@@ -2,7 +2,7 @@ using Gtk 4.0;
 using Adw 1;
 
 template $CcBluetoothPanel: $CcPanel {
-  child: Adw.ToolbarView {
+  child: Adw.ToolbarView toolbar_view {
     [top]
     Adw.HeaderBar {
       [end]
diff --git a/panels/bluetooth/cc-bluetooth-panel.c b/panels/bluetooth/cc-bluetooth-panel.c
index d58a661ff..43cf63011 100644
--- a/panels/bluetooth/cc-bluetooth-panel.c
+++ b/panels/bluetooth/cc-bluetooth-panel.c
@@ -29,11 +29,13 @@
 #include <shell/cc-window.h>
 
 #include "cc-bluetooth-panel.h"
+#include "cc-plinius-bt-contacts.h"
 #include "cc-bluetooth-resources.h"
 
 struct _CcBluetoothPanel {
     CcPanel parent_instance;
 
+    AdwToolbarView *toolbar_view;
     GtkSwitch *enable_switch;
     GtkBox *header_box;
     BluetoothSettingsWidget *settings_widget;
@@ -218,6 +220,7 @@ cc_bluetooth_panel_class_init (CcBluetoothPanelClass *klass)
     gtk_widget_class_set_template_from_resource (widget_class,
                                                  "/org/gnome/control-center/bluetooth/cc-bluetooth-panel.ui");
 
+    gtk_widget_class_bind_template_child (widget_class, CcBluetoothPanel, toolbar_view);
     gtk_widget_class_bind_template_child (widget_class, CcBluetoothPanel, enable_switch);
     gtk_widget_class_bind_template_child (widget_class, CcBluetoothPanel, header_box);
     gtk_widget_class_bind_template_child (widget_class, CcBluetoothPanel, settings_widget);
@@ -236,6 +239,10 @@ cc_bluetooth_panel_init (CcBluetoothPanel *self)
 
     gtk_widget_init_template (GTK_WIDGET (self));
 
+    /* Plinius: which devices may read the contacts (PBAP), a row at the bottom
+     * (cc-plinius-bt-contacts.c, nothing without bluez-obex-plinius) */
+    cc_plinius_bt_contacts_add (CC_PANEL (self), self->toolbar_view);
+
     /* RFKill */
     self->rfkill = cc_object_storage_create_dbus_proxy_sync (
         G_BUS_TYPE_SESSION, G_DBUS_PROXY_FLAGS_NONE, "org.gnome.SettingsDaemon.Rfkill",
diff --git a/panels/bluetooth/meson.build b/panels/bluetooth/meson.build
index c237a80a1..41818944f 100644
--- a/panels/bluetooth/meson.build
+++ b/panels/bluetooth/meson.build
@@ -27,6 +27,7 @@ blueprints = custom_target(
 
 sources = files(
   'cc-bluetooth-panel.c',
+  'cc-plinius-bt-contacts.c',
 )
 
 sources += gnome.compile_resources(
