diff --git a/panels/system/users/cc-users-page.blp b/panels/system/users/cc-users-page.blp
index 719013344..844d5cdc9 100644
--- a/panels/system/users/cc-users-page.blp
+++ b/panels/system/users/cc-users-page.blp
@@ -22,7 +22,9 @@ template $CcUsersPage: $CcPanel {
       }
     }
 
+    // Plinius: a phone has one user; no "Add User"
     Adw.ButtonRow add_user_button_row {
+      visible: false;
       title: _("_Add User");
       end-icon-name: "go-next-symbolic";
       use-underline: true;
