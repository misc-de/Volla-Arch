@@ -181,10 +180,8 @@ select_ppd_in_dialog (PpDetailsDialog *self)
         self->pp_ppd_selection_dialog =
             pp_ppd_selection_dialog_new (self->all_ppds_list, manufacturer, ppd_selection_dialog_response_cb, self);
 
-        toplevel = GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (self)));
