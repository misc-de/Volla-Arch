-
-        gtk_widget_set_visible (GTK_WIDGET (self->pp_ppd_selection_dialog), TRUE);
+        /* Plinius: an AdwDialog now, a page of the window */
+        adw_dialog_present (ADW_DIALOG (self->pp_ppd_selection_dialog), GTK_WIDGET (self));
     }
 }
 
diff --git a/panels/printers/pp-new-printer-dialog.c b/panels/printers/pp-new-printer-dialog.c
index 38d4e66..bb91346 100644
--- a/panels/printers/pp-new-printer-dialog.c
+++ b/panels/printers/pp-new-printer-dialog.c
@@ -1369,9 +1369,6 @@ ppd_selection_cb (GtkWindow *_dialog, gint response_id, gpointer user_data)
         }
     }
 
