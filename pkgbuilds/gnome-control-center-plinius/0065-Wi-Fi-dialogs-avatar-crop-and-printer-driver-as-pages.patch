-    gtk_window_set_transient_for (GTK_WINDOW (self->ppd_selection_dialog), NULL);
-
     self->user_callback (self, response_id, self->user_data);
 }
 
@@ -1403,12 +1400,9 @@ add_cb (PpNewPrinterDialog *self)
             self->new_device = pp_print_device_copy (device);
             self->ppd_selection_dialog = pp_ppd_selection_dialog_new (self->list, NULL, ppd_selection_cb, self);
 
-            /* The dialog is no window itself; the driver window belongs to the window showing it */
-            gtk_window_set_transient_for (GTK_WINDOW (self->ppd_selection_dialog),
-                                          GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (self))));
-
-            /* New device will be set at return from ppd selection */
-            gtk_widget_set_visible (GTK_WIDGET (self->ppd_selection_dialog), TRUE);
+            /* New device will be set at return from ppd selection. Plinius: an AdwDialog now, a
+             * page of the window above this one */
+            adw_dialog_present (ADW_DIALOG (self->ppd_selection_dialog), GTK_WIDGET (self));
         } else {
             self->new_device = pp_print_device_copy (device);
             self->user_callback (self, GTK_RESPONSE_OK, self->user_data);
@@ -1479,7 +1473,7 @@ pp_new_printer_dialog_dispose (GObject *object)
     g_clear_object (&self->samba_host);
 
     if (self->ppd_selection_dialog != NULL) {
-        gtk_window_destroy (GTK_WINDOW (self->ppd_selection_dialog));
