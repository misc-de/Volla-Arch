     }
 
diff --git a/panels/printers/pp-ppd-selection-dialog.blp b/panels/printers/pp-ppd-selection-dialog.blp
index 5d49e4a..faae2b3 100644
--- a/panels/printers/pp-ppd-selection-dialog.blp
