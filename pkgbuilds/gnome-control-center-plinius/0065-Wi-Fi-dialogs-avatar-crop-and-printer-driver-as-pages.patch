-      [start]
-      Button ppd_selection_cancel_button {
-        label: _("_Cancel");
-        use-underline: true;
-        clicked => $cancel_cb(template);
-      }
-
       [end]
       Button ppd_selection_select_button {
         label: _("_Select");
diff --git a/panels/printers/pp-ppd-selection-dialog.c b/panels/printers/pp-ppd-selection-dialog.c
index 39d2c3c..ff55b79 100644
--- a/panels/printers/pp-ppd-selection-dialog.c
+++ b/panels/printers/pp-ppd-selection-dialog.c
@@ -43,7 +43,9 @@ enum {
 };
 
 struct _PpPPDSelectionDialog {
-    AdwWindow parent_instance;
+    AdwDialog parent_instance;
+
+    gboolean answered; /* Plinius: the callback heard Select or Cancel already */
 
     GtkButton *ppd_selection_select_button;
     GtkTreeView *ppd_selection_manufacturers_treeview;
@@ -60,7 +62,7 @@ struct _PpPPDSelectionDialog {
     PPDList *list;
 };
 
-G_DEFINE_FINAL_TYPE (PpPPDSelectionDialog, pp_ppd_selection_dialog, ADW_TYPE_WINDOW)
+G_DEFINE_FINAL_TYPE (PpPPDSelectionDialog, pp_ppd_selection_dialog, ADW_TYPE_DIALOG)
 
 static void
 manufacturer_selection_changed_cb (PpPPDSelectionDialog *self)
@@ -241,13 +243,17 @@ select_cb (PpPPDSelectionDialog *self)
         }
     }
 
-    self->user_callback (GTK_WINDOW (self), GTK_RESPONSE_OK, self->user_data);
+    self->answered = TRUE;
+    self->user_callback ((GtkWindow *) self, GTK_RESPONSE_OK, self->user_data);
 }
 
 static void
 cancel_cb (PpPPDSelectionDialog *self)
 {
-    self->user_callback (GTK_WINDOW (self), GTK_RESPONSE_CANCEL, self->user_data);
+    if (self->answered)
+        return;
+    self->answered = TRUE;
+    self->user_callback ((GtkWindow *) self, GTK_RESPONSE_CANCEL, self->user_data);
 }
 
 PpPPDSelectionDialog *
@@ -270,15 +276,6 @@ pp_ppd_selection_dialog_new (PPDList *ppd_list, const gchar *manufacturer, UserR
     return self;
 }
 
-static gboolean
-pp_ppd_selection_dialog_close_request (GtkWindow *window)
-{
-    PpPPDSelectionDialog *self = PP_PPD_SELECTION_DIALOG (window);
-
-    cancel_cb (self);
-
-    return GDK_EVENT_STOP;
-}
 
 static void
 pp_ppd_selection_dialog_dispose (GObject *object)
@@ -295,7 +292,6 @@ pp_ppd_selection_dialog_dispose (GObject *object)
 void
 pp_ppd_selection_dialog_class_init (PpPPDSelectionDialogClass *klass)
 {
-    GtkWindowClass *window_class = GTK_WINDOW_CLASS (klass);
     GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
     GObjectClass *object_class = G_OBJECT_CLASS (klass);
 
@@ -310,15 +306,15 @@ pp_ppd_selection_dialog_class_init (PpPPDSelectionDialogClass *klass)
     gtk_widget_class_bind_template_callback (widget_class, cancel_cb);
 
     object_class->dispose = pp_ppd_selection_dialog_dispose;
-    window_class->close_request = pp_ppd_selection_dialog_close_request;
-
-    gtk_widget_class_add_binding_action (widget_class, GDK_KEY_Escape, GDK_NO_MODIFIER_MASK, "window.close", NULL);
 }
 
 void
 pp_ppd_selection_dialog_init (PpPPDSelectionDialog *self)
 {
     gtk_widget_init_template (GTK_WIDGET (self));
+
+    /* Plinius: back, the back swipe or Escape close it as a page; that answers Cancel */
+    g_signal_connect (self, "closed", G_CALLBACK (cancel_cb), NULL);
 }
 
