+cc_wwan_apn_view_changed_cb (CcWwanApnDialog *self)
+{
+    GtkWidget *view = gtk_stack_get_visible_child (self->apn_settings_stack);
+
+    adw_dialog_set_can_close (ADW_DIALOG (self), view != GTK_WIDGET (self->apn_edit_view));
+}
