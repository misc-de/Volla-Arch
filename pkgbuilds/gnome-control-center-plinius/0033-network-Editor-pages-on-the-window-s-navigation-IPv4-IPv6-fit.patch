diff --git a/panels/network/connection-editor/net-connection-editor.c b/panels/network/connection-editor/net-connection-editor.c
index f7bbfaed6..91da4063d 100644
--- a/panels/network/connection-editor/net-connection-editor.c
+++ b/panels/network/connection-editor/net-connection-editor.c
@@ -71,6 +71,11 @@ struct _NetConnectionEditor {
     /* Plinius: the settings of the VPN type picked in "Add VPN", a page above the list of types
      * (pages_box and apply_button move there) */
     AdwNavigationPage *config_page;
+    /* Plinius: as a page of the window's navigation the editor's own navigation is taken apart
+     * (flatten_into_page); kept here, it holds the first page. "popped" of the navigation the
+     * settings pages go on is connected. */
+    AdwNavigationView *own_navigation;
+    gboolean popped_connected;
 
     NMClient *client;
     NMDevice *device;
@@ -176,7 +181,6 @@ eap_method_ca_cert_ignore_load (NMConnection *connection)
 
 static void page_changed (NetConnectionEditor *self);
 static void page_row_activated_cb (NetConnectionEditor *self, GtkListBoxRow *row);
-static void navigation_popped_cb (NetConnectionEditor *self, AdwNavigationPage *page);
 
 /* Shown as a page of the window's navigation (cc-plinius-dialog-pages.c): the dialog itself has
  * no parent then, its child moved into the page */
@@ -195,19 +199,56 @@ close_editor (NetConnectionEditor *self)
         adw_dialog_force_close (ADW_DIALOG (self));
 }
 
-/* As a page "Cancel" becomes a back arrow, as on every other page. The header bar shows none of
- * its own: it belongs to the first page of the editor's own navigation. Leaving the page by the
- * back swipe cancels as well (net_connection_editor_closed). */
+/* As a page of the window's navigation (cc-plinius-dialog-pages.c) the editor's own navigation
+ * would sit inside it: then neither its header bar shows the window's back arrow nor does the back
+ * swipe work. So the first page's content goes straight into the page, and the settings pages go
+ * on the window's navigation (get_navigation). "Cancel" gives way to the back arrow; leaving by
+ * the arrow or the swipe cancels (net_connection_editor_closed). */
 static void
-content_map_cb (NetConnectionEditor *self)
+flatten_into_page (NetConnectionEditor *self)
 {
-    if (!is_page (self))
+    GtkWidget *parent = gtk_widget_get_parent (GTK_WIDGET (self->toast_overlay));
+    GtkWidget *content;
+
+    if (self->own_navigation || !ADW_IS_NAVIGATION_PAGE (parent) || !is_page (self))
         return;
 
-    gtk_button_set_icon_name (self->cancel_button, "go-previous-symbolic");
-    gtk_widget_set_tooltip_text (GTK_WIDGET (self->cancel_button), g_dgettext ("libadwaita", "Back"));
-    gtk_accessible_update_property (GTK_ACCESSIBLE (self->cancel_button),
-                                    GTK_ACCESSIBLE_PROPERTY_LABEL, g_dgettext ("libadwaita", "Back"), -1);
+    self->own_navigation = g_object_ref (self->navigation_view);
+    content = g_object_ref (adw_navigation_page_get_child (self->main_page));
+    adw_navigation_page_set_child (self->main_page, NULL);
+    adw_toast_overlay_set_child (self->toast_overlay, content);
+    g_object_unref (content);
+
+    gtk_widget_set_visible (GTK_WIDGET (self->cancel_button), FALSE);
+}
+
+/* The navigation the settings pages go on */
+static AdwNavigationView *
+get_navigation (NetConnectionEditor *self)
+{
+    GtkWidget *window_navigation;
+
+    if (!self->own_navigation)
+        return self->navigation_view;
+
+    window_navigation = gtk_widget_get_ancestor (GTK_WIDGET (self->toast_overlay), ADW_TYPE_NAVIGATION_VIEW);
+    return window_navigation ? ADW_NAVIGATION_VIEW (window_navigation) : self->navigation_view;
+}
+
+static void navigation_popped_cb (NetConnectionEditor *self, AdwNavigationPage *page);
+
+static void
+push_page (NetConnectionEditor *self, AdwNavigationPage *page)
+{
+    AdwNavigationView *navigation = get_navigation (self);
+
+    if (!self->popped_connected) {
+        g_signal_connect_object (navigation, "popped", G_CALLBACK (navigation_popped_cb), self,
+                                 G_CONNECT_SWAPPED);
+        self->popped_connected = TRUE;
+    }
+
+    adw_navigation_view_push (navigation, page);
 }
 
 /* Title of the dialog and of its first page (the back button of the settings pages shows it) */
@@ -355,8 +396,7 @@ net_connection_editor_init (NetConnectionEditor *self)
 {
     gtk_widget_init_template (GTK_WIDGET (self));
     self->pages = g_ptr_array_new ();
-    g_signal_connect_object (self->toast_overlay, "map", G_CALLBACK (content_map_cb), self, G_CONNECT_SWAPPED);
-    g_signal_connect_object (self->navigation_view, "popped", G_CALLBACK (navigation_popped_cb), self,
+    g_signal_connect_object (self->toast_overlay, "notify::parent", G_CALLBACK (flatten_into_page), self,
                              G_CONNECT_SWAPPED);
 }
 
@@ -366,6 +406,7 @@ net_connection_editor_finalize (GObject *object)
     NetConnectionEditor *self = NET_CONNECTION_EDITOR (object);
 
