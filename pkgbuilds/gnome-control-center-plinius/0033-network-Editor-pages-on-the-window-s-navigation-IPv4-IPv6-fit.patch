 .../network/connection-editor/ce-page-ip6.c   | 19 +++--
 panels/network/connection-editor/ip4-page.blp | 33 +++++----
 panels/network/connection-editor/ip6-page.blp | 37 +++++-----
 .../connection-editor/net-connection-editor.c | 69 +++++++++++++++----
 5 files changed, 117 insertions(+), 60 deletions(-)

