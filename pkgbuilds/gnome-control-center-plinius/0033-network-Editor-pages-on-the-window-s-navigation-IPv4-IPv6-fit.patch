     g_clear_object (&self->device);
@@ -610,7 +651,7 @@ page_row_activated_cb (NetConnectionEditor *self, GtkListBoxRow *row)
     AdwNavigationPage *page = g_object_get_data (G_OBJECT (row), "navigation-page");
 
     if (page != NULL)
-        adw_navigation_view_push (self->navigation_view, page);
+        push_page (self, page);
 }
 
 static void
@@ -857,7 +898,7 @@ push_config_page (NetConnectionEditor *self, const gchar *title)
     }
 
     adw_navigation_page_set_title (self->config_page, title);
-    adw_navigation_view_push (self->navigation_view, self->config_page);
+    push_page (self, self->config_page);
 }
 
