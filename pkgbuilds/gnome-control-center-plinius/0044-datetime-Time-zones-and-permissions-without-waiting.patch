From 28632d79d4a83798ce5eb7f63e8a4b7bdf5d7eb9 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 31 Oct 2026 22:12:32 +0100
Subject: [PATCH] datetime: Time zones and permissions without waiting

Plinius: the Date & Time page waited for two polkit checks (60-180 ms
each on the phone) and built an item for each of the ~420 time zones of
its time zone dialog, each with its own wall clock, settings object,
compiled pattern and a read of the zone's file.

The permissions now come asynchronously. Until they are there, the
rows that need them are insensitive, as without the permission, and the
lock banner stays hidden. A time zone item gets its wall clock, clock
format and UTC offset when a row of the dialog shows them; the pattern
is compiled once. The page's stall at opening drops from ~330 ms to
~90 ms.
---
 panels/system/datetime/cc-datetime-page.c | 59 +++++++++++---
 panels/system/datetime/cc-tz-item.c       | 95 ++++++++++++++++-------
 2 files changed, 116 insertions(+), 38 deletions(-)

diff --git a/panels/system/datetime/cc-datetime-page.c b/panels/system/datetime/cc-datetime-page.c
index 776854183..00f75ca1b 100644
--- a/panels/system/datetime/cc-datetime-page.c
+++ b/panels/system/datetime/cc-datetime-page.c
@@ -817,6 +817,50 @@ on_factory_bind_week_start_day (GtkSignalListItemFactory *factory, GtkListItem *
     }
 }
 
+/*
+ * Plinius: each polkit check takes 60-180 ms on the phone, and the page waited for two of them
+ * before it opened. Until the answers are there, the rows that need them are insensitive, as
+ * without the permission, and the lock banner stays hidden.
+ */
+static void
+permission_ready_cb (GObject *source_object, GAsyncResult *result, gpointer user_data)
+{
+    g_autoptr(GError) error = NULL;
+    GPermission *permission = polkit_permission_new_finish (result, &error);
+    CcDateTimePage *self;
+
+    if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        return;
+
+    self = CC_DATE_TIME_PAGE (user_data);
+    self->permission = permission;
+    if (self->permission != NULL) {
+        g_signal_connect_object (self->permission, "notify", G_CALLBACK (on_permission_changed), self,
+                                 G_CONNECT_SWAPPED);
+        cc_permission_infobar_set_permission (self->permission_infobar, self->permission);
+        gtk_widget_set_visible (GTK_WIDGET (self->permission_infobar), TRUE);
+    } else {
+        g_warning ("Your system does not have the '%s' PolicyKit files installed. Please check your installation",
+                   DATETIME_PERMISSION);
+    }
+    on_permission_changed (self);
+}
+
+static void
+tz_permission_ready_cb (GObject *source_object, GAsyncResult *result, gpointer user_data)
+{
+    g_autoptr(GError) error = NULL;
+    GPermission *permission = polkit_permission_new_finish (result, &error);
+    CcDateTimePage *self;
+
+    if (g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+        return;
+
+    self = CC_DATE_TIME_PAGE (user_data);
+    self->tz_permission = permission;
+    on_permission_changed (self);
+}
+
 static void
 cc_date_time_page_init (CcDateTimePage *self)
 {
@@ -839,17 +883,10 @@ cc_date_time_page_init (CcDateTimePage *self)
     gtk_list_box_set_sort_func (self->date_box, (GtkListBoxSortFunc) sort_date_box, self, NULL);
     gtk_list_box_invalidate_sort (self->date_box);
 
-    /* add the lock button */
-    self->permission = polkit_permission_new_sync (DATETIME_PERMISSION, NULL, NULL, NULL);
-    self->tz_permission = polkit_permission_new_sync (DATETIME_TZ_PERMISSION, NULL, NULL, NULL);
-    if (self->permission != NULL) {
-        g_signal_connect_object (self->permission, "notify", G_CALLBACK (on_permission_changed), self,
-                                 G_CONNECT_SWAPPED);
-    } else {
-        g_warning ("Your system does not have the '%s' PolicyKit files installed. Please check your installation",
-                   DATETIME_PERMISSION);
-    }
-    cc_permission_infobar_set_permission (self->permission_infobar, self->permission);
+    /* add the lock button; Plinius: without waiting for polkit (permission_ready_cb()) */
+    gtk_widget_set_visible (GTK_WIDGET (self->permission_infobar), FALSE);
+    polkit_permission_new (DATETIME_PERMISSION, NULL, self->cancellable, permission_ready_cb, self);
+    polkit_permission_new (DATETIME_TZ_PERMISSION, NULL, self->cancellable, tz_permission_ready_cb, self);
 
     self->location_settings = g_settings_new (LOCATION_SETTINGS);
     g_signal_connect_object (self->location_settings, "changed", G_CALLBACK (on_location_settings_changed), self,
diff --git a/panels/system/datetime/cc-tz-item.c b/panels/system/datetime/cc-tz-item.c
index bbc68f596..b81269ad5 100644
--- a/panels/system/datetime/cc-tz-item.c
+++ b/panels/system/datetime/cc-tz-item.c
@@ -70,6 +70,23 @@ enum {
 
 static GParamSpec *properties[N_PROPS];
 
+/*
+ * Plinius: the Date & Time page builds an item for each of the ~420 time zones (for its time zone
+ * dialog) when it opens, which held it up ~0.3 s on the phone. What only the dialog's visible rows
+ * show is now made when a row asks for it: the time with its own wall clock and settings, the UTC
+ * offset from reading the zone's file. The separator pattern is compiled once, not per zone.
+ */
+static GRegex *
+city_separator_regex (void)
+{
+    static GRegex *regex;
+
+    if (g_once_init_enter_pointer (&regex))
+        g_once_init_leave_pointer (&regex, g_regex_new ("[\\x{2044}\\x{2215}\\x{29f8}\\x{ff0f}/]", 0, 0, NULL));
+
+    return regex;
+}
+
 /* Adapted from cc-datetime-panel.c */
 static void
 generate_city_name (CcTzItem *self, TzLocation *loc)
@@ -80,13 +97,59 @@ generate_city_name (CcTzItem *self, TzLocation *loc)
     /* Load the translation for it */
     self->zone = g_strdup (dgettext (GETTEXT_PACKAGE_TIMEZONES, loc->zone));
     g_strdelimit (self->zone, "_", ' ');
-    split_translated = g_regex_split_simple ("[\\x{2044}\\x{2215}\\x{29f8}\\x{ff0f}/]", self->zone, 0, 0);
+    split_translated = g_regex_split (city_separator_regex (), self->zone, 0);
 
     length = g_strv_length (split_translated);
     self->country = gnome_get_country_from_code (loc->country, NULL);
     self->name = g_strdup (split_translated[length - 1]);
 }
 
+static void tz_item_clock_changed_cb (CcTzItem *self);
+
+/* Plinius: the zone's offset from its file, when a row shows it */
+static void
+tz_item_ensure_offset (CcTzItem *self)
+{
+    GString *offset;
+
+    if (self->offset)
+        return;
+
+    self->tz_info = tz_info_from_location (self->tz_location);
+    self->tz = g_time_zone_new_offset (self->tz_info->utc_offset);
+
+    offset = g_string_new (g_time_zone_get_identifier (self->tz));
+    /* Strip the seconds, eg: +05:30:00 -> +05:30 */
+    g_string_set_size (offset, offset->len - 3);
+    /* eg: +05:30 -> +0530*/
+    g_string_replace (offset, ":", "", 0);
+
+    /* If the timezone is UTC remove the time, which will always be [+]0000 */
+    if (g_str_has_suffix (offset->str, "0000"))
+        g_string_set_size (offset, 0);
+
+    /* eg: +0530 -> UTC+0530 */
+    g_string_prepend (offset, "UTC");
+
+    self->offset = g_string_free_and_steal (offset);
+}
+
+/* Plinius: a wall clock and the clock format, when a row shows the time */
+static void
+tz_item_ensure_clock (CcTzItem *self)
+{
+    if (self->wall_clock)
+        return;
+
+    self->desktop_settings = g_settings_new ("org.gnome.desktop.interface");
+    self->wall_clock = gnome_wall_clock_new ();
+
+    g_signal_connect_object (self->wall_clock, "notify::clock", G_CALLBACK (tz_item_clock_changed_cb), self,
+                             G_CONNECT_SWAPPED);
+    g_signal_connect_object (self->desktop_settings, "changed::clock-format", G_CALLBACK (tz_item_clock_changed_cb),
+                             self, G_CONNECT_SWAPPED);
+}
+
 static const char *
 tz_item_get_time (CcTzItem *self)
 {
@@ -98,6 +161,9 @@ tz_item_get_time (CcTzItem *self)
     if (self->time)
         return self->time;
 
+    tz_item_ensure_offset (self);
+    tz_item_ensure_clock (self);
+
     now = g_date_time_new_now (self->tz);
     format = g_settings_get_enum (self->desktop_settings, "clock-format");
 
@@ -137,6 +203,7 @@ cc_tz_item_get_property (GObject *object, guint prop_id, GValue *value, GParamSp
         break;
 
     case PROP_OFFSET:
+        tz_item_ensure_offset (self);
         g_value_set_string (value, self->offset);
         break;
 
@@ -199,45 +266,19 @@ cc_tz_item_class_init (CcTzItemClass *klass)
 static void
 cc_tz_item_init (CcTzItem *self)
 {
-    self->desktop_settings = g_settings_new ("org.gnome.desktop.interface");
-    self->wall_clock = gnome_wall_clock_new ();
-
-    g_signal_connect_object (self->wall_clock, "notify::clock", G_CALLBACK (tz_item_clock_changed_cb), self,
-                             G_CONNECT_SWAPPED);
-    g_signal_connect_object (self->desktop_settings, "changed::clock-format", G_CALLBACK (tz_item_clock_changed_cb),
-                             self, G_CONNECT_SWAPPED);
 }
 
 CcTzItem *
 cc_tz_item_new (TzLocation *location)
 {
     CcTzItem *self;
-    GString *offset;
 
     g_return_val_if_fail (location, NULL);
 
     self = g_object_new (CC_TYPE_TZ_ITEM, NULL);
     self->tz_location = location;
-    self->tz_info = tz_info_from_location (location);
     generate_city_name (self, location);
 
-    self->tz = g_time_zone_new_offset (self->tz_info->utc_offset);
-
-    offset = g_string_new (g_time_zone_get_identifier (self->tz));
-    /* Strip the seconds, eg: +05:30:00 -> +05:30 */
-    g_string_set_size (offset, offset->len - 3);
-    /* eg: +05:30 -> +0530*/
-    g_string_replace (offset, ":", "", 0);
-
-    /* If the timezone is UTC remove the time, which will always be [+]0000 */
-    if (g_str_has_suffix (offset->str, "0000"))
-        g_string_set_size (offset, 0);
-
-    /* eg: +0530 -> UTC+0530 */
-    g_string_prepend (offset, "UTC");
-
-    self->offset = g_string_free_and_steal (offset);
-
     return self;
 }
 
