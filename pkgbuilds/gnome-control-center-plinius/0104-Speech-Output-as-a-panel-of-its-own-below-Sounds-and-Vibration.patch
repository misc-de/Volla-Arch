From ed1fa63859f7e8b469dd64064c53ea55a7a0c51e Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:00:00 +0100
Subject: [PATCH] Speech Output as a panel of its own below Sounds and
 Vibration

Plinius: a panel "Speech Output" in the list right after Sounds and
Vibration: the voice of the system language (installed ones, more to
download through plinius-software, each one to listen to), the speech
rate, both for everything the phone says, and the switch for announcing
callers in a Bluetooth headset - the settings org.plinius.speech of
plinius-speech. The panel (cc-speech-panel.*) and its desktop file come as
separate files; it is only listed with plinius-speech.
---
 panels/meson.build        |  1 +
 panels/speech/meson.build | 20 ++++++++++++++++++++
 shell/cc-panel-list.c     |  1 +
 shell/cc-panel-loader.c   |  4 ++++
 4 files changed, 26 insertions(+)
 create mode 100644 panels/speech/meson.build

diff --git a/panels/meson.build b/panels/meson.build
index 356d590..eaaa7fe 100644
--- a/panels/meson.build
+++ b/panels/meson.build
@@ -24,6 +24,7 @@ panels = [
   'search',
   'sharing',
   'sound',
+  'speech',
   'streaming',
   'system',
   'universal-access',
diff --git a/panels/speech/meson.build b/panels/speech/meson.build
new file mode 100644
index 0000000..5d3f6ca
--- /dev/null
+++ b/panels/speech/meson.build
@@ -0,0 +1,20 @@
+# Plinius: Speech Output panel (plinius-speech). The sources and the desktop file (with its
+# translations) come as separate files of gnome-control-center-plinius.
+panels_list += cappletname
+
+install_data(
+  'gnome-speech-panel.desktop',
+  install_dir: control_center_desktopdir,
+)
+
+sources = files(
+  'cc-speech-panel.c',
+)
+
+panels_libs += static_library(
+  cappletname,
+  sources: sources,
+  include_directories: [ top_inc, common_inc ],
+  dependencies: common_deps + [ json_glib_dep ],
+  c_args: cflags,
+)
diff --git a/shell/cc-panel-list.c b/shell/cc-panel-list.c
index 2829756..f2801da 100644
--- a/shell/cc-panel-list.c
+++ b/shell/cc-panel-list.c
@@ -352,6 +352,7 @@ static const gchar *const panel_order[] = {
     "background",
     "sound",
     "feedback",
+    "speech",
     "power",
     "keyboard",
 
diff --git a/shell/cc-panel-loader.c b/shell/cc-panel-loader.c
index f59bafb..a820123 100644
--- a/shell/cc-panel-loader.c
+++ b/shell/cc-panel-loader.c
@@ -49,6 +49,8 @@ extern GType cc_usb_panel_get_type (void);
 extern void cc_usb_panel_static_init_func (void);
 extern GType cc_feedback_panel_get_type (void);
 extern void cc_feedback_panel_static_init_func (void);
+extern GType cc_speech_panel_get_type (void);
+extern void cc_speech_panel_static_init_func (void);
 extern GType cc_updates_panel_get_type (void);
 extern void cc_updates_panel_static_init_func (void);
 extern GType cc_background_panel_get_type (void);
@@ -133,6 +135,8 @@ static CcPanelLoaderVtable default_panels[] = {
     PANEL_TYPE ("search", cc_search_panel_get_type, NULL),
     PANEL_TYPE ("sharing", cc_sharing_panel_get_type, cc_sharing_panel_static_init_func),
     PANEL_TYPE ("sound", cc_sound_panel_get_type, NULL),
+    /* Plinius: Speech Output, below Sounds and Vibration (plinius-speech) */
+    PANEL_TYPE ("speech", cc_speech_panel_get_type, cc_speech_panel_static_init_func),
     /* Plinius: Sounds and Vibration, below Sound */
     PANEL_TYPE ("feedback", cc_feedback_panel_get_type, cc_feedback_panel_static_init_func),
     PANEL_TYPE ("streaming", cc_streaming_panel_get_type, cc_streaming_panel_static_init_func),
-- 
