 panels/background/cc-background-chooser.c   | 73 ++++++++++++++-------
 panels/background/cc-background-panel.blp   | 15 +++--
 panels/background/cc-background-panel.c     | 44 ++++++++-----
 4 files changed, 95 insertions(+), 46 deletions(-)

