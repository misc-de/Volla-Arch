@@ -475,11 +504,13 @@ cc_background_chooser_select_file (CcBackgroundChooser *self)
     toplevel = (GtkWindow *) gtk_widget_get_native (GTK_WIDGET (self));
 
     file_dialog = gtk_file_dialog_new ();
