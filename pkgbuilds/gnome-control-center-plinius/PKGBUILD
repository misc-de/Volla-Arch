# cc-streaming-panel.*, cc-usb-panel.*, cc-plinius-osk-style.*, cc-plinius-ssh.*,
# cc-desktop-vnc-panel.*, cc-plinius-text-focus.*, cc-plinius-swap.*, cc-plinius-hubs.*,
