	# Apps: the group Access on an app's page - Ask, Allow or Don't Allow for a camera on USB, a
	# security key and the network, with the attempts counted (plinius-appaccess), on top of
	# Required Permissions in one group (as GNOME has it without the daemon), as a file of its own
	cp "$srcdir"/cc-plinius-appaccess.{c,h} panels/applications/
	patch -Np1 -i "$srcdir/0088-applications-Access-to-a-USB-camera-a-security-key-and-the-network-per-app.patch"
	# Mobile Network: a label of one's own for each SIM card on its Network page, shown on the SIM
	# page instead of the network's name; the same key as the label of an eSIM profile
	# (org.plinius.sim, installed in package())
	patch -Np1 -i "$srcdir/0089-wwan-A-label-of-one-s-own-for-each-SIM-card.patch"
	# Accounts: Local Accounts as a list (one's own account by its username first, the others below)
	# with "Add" in the header bar; new accounts through plinius-add-user (IDs from 32012, the
	# device groups, the password in the same step), for plinius-greeter
	patch -Np1 -i "$srcdir/0090-users-Local-Accounts-with-one-s-own-account-first-Add-in-the-header-bar.patch"
	# Bluetooth: Contacts at the top (also with Bluetooth off), no explanation above the devices
	patch -Np1 -i "$srcdir/0091-bluetooth-Contacts-on-top-no-explanation-above-the-devices.patch"
	# Privacy: the same Contacts row below Cameras, a second way to the page
	patch -Np1 -i "$srcdir/0092-privacy-Contacts-below-Cameras.patch"
	# Wi-Fi: opening a known network, Delete (Forget) below the rows of its pages, not inside Details
	patch -Np1 -i "$srcdir/0093-network-Delete-below-the-pages-of-a-known-Wi-Fi-network.patch"
	# Mobile Network: the settings of an access point as entry and combo rows, Save below them
	patch -Np1 -i "$srcdir/0094-wwan-The-settings-of-an-access-point-in-the-list-style.patch"
	# Wi-Fi: no trash button in the list of saved networks, Delete only on a network's pages
	patch -Np1 -i "$srcdir/0095-network-No-trash-button-in-the-list-of-saved-Wi-Fi-networks.patch"
	# Sound: the FM tuner's sound (audio-hal-bridge, plinius.hidden) is no input to choose; the
	# radio app opens it by name (the same patch as phosh-plinius 0095)
	patch -d subprojects/gvc -Np1 -i "$srcdir/0096-gvc-Sources-marked-plinius.hidden-are-not-listed.patch"
	# Sound: no group "Sounds"; Volume Levels at the end of Output, the alert sound in Sounds and
	# Vibration (feedbackd plays it, phoc-plinius 0032 hands the bell to it)
	patch -Np1 -i "$srcdir/0097-sound-Volume-Levels-at-the-end-of-Output-no-group-Sounds.patch"
	# Location: "Faster GPS Fix" below the location switch (plinius-epo; nothing shows without it)
	cp "$srcdir"/cc-plinius-epo.{c,h} panels/privacy/location/
	patch -Np1 -i "$srcdir/0098-location-Faster-GPS-Fix-below-the-location-switch.patch"
	# Access Points: Delete (with a question) on the page of an access point saved on the phone
	patch -Np1 -i "$srcdir/0099-wwan-Delete-on-the-page-of-an-access-point.patch"
	# Mobile Network > Access Points: list and settings as pages, Save in the header bar, back swipe
	patch -Np1 -i "$srcdir/0100-wwan-Save-in-the-header-bar-of-an-access-point-back-swipe-to-the-list.patch"
	# System › Self-Test (plinius-health; nothing shows without it), the page as a file of its own
	cp "$srcdir"/cc-plinius-selftest.{c,h} panels/system/
	patch -Np1 -i "$srcdir/0101-system-Self-Test-what-the-check-after-the-start-found.patch"
	# Access points: the suggestions of the SIM's own provider, named, none beside a saved APN
	patch -Np1 -i "$srcdir/0102-wwan-The-access-points-of-the-SIM-s-own-provider-named-not-Default.patch"
	# The password of another account is set at once: "set at next login" removed it (passwd -d)
	# and left the account to whoever holds the phone until then
	patch -Np1 -i "$srcdir/0103-users-The-password-of-another-account-is-set-now-not-at-its-next-login.patch"
	# Speech Output: a panel of its own below Sounds and Vibration with the voice of the system
	# language (to listen to, download and remove through plinius-software), the speech rate (both
	# for everything the phone says) and the caller announcement of plinius-speech; listed with
	# plinius-speech only; the patch creates its meson.build
	patch -Np1 -i "$srcdir/0104-Speech-Output-as-a-panel-of-its-own-below-Sounds-and-Vibration.patch"
	# Privacy: Automatic Connections at the end, the update search (plinius-software's timer) and
	# NetworkManager's connection check with its server (plinius-connectivity-set)
	cp "$srcdir"/cc-plinius-connections.{c,h} panels/privacy/
	patch -Np1 -i "$srcdir/0105-privacy-Automatic-Connections-the-update-search-and-the-connection-check.patch"
	cp "$srcdir"/cc-speech-panel.{c,h} "$srcdir/gnome-speech-panel.desktop" panels/speech/
	# German: "WiFi" instead of "WLAN" in GNOME's own translation (msgstr lines only; the search
	# keyword "WLAN;" stays so that searching for it still finds the page)
	sed -i '/^msgstr/,/^$/{/^#/!s/WLAN\([^;]\)/WiFi\1/g}' po/de.po
}

build() {
	local meson_options=(
		-D documentation=true
		-D location-services=enabled
		-D malcontent=true
	)

	# Make libgxdp available
	export MESON_PACKAGE_CACHE_DIR="$srcdir"

	arch-meson gnome-control-center build "${meson_options[@]}"
	meson compile -C build

	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

# No check(): the tests need Xvfb and dbusmock, not sensible under qemu-user

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	meson install -C build --no-rebuild --destdir "$pkgdir"

	# Owned by the gnome-keybindings package from ALARM (a split package on Arch)
	rm -r "$pkgdir"/usr/share/gettext/its/gnome-keybindings.* \
		"$pkgdir/usr/share/gnome-control-center/keybindings" \
		"$pkgdir/usr/share/pkgconfig/gnome-keybindings.pc"
	rmdir --ignore-fail-on-non-empty -p "$pkgdir/usr/share/gettext/its" "$pkgdir/usr/share/pkgconfig"

	# Sidebar icons of the NFC, Streaming and USB panels (the latter two as in Phosh's tiles)
	install -Dm644 plinius-{nfc,cast,usb,vibration,speech}-symbolic.svg -t "$pkgdir/usr/share/icons/hicolor/symbolic/apps"

	# Labels of the SIM cards (Mobile Network and the eSIM page)
	install -Dm644 org.plinius.sim.gschema.xml -t "$pkgdir/usr/share/glib-2.0/schemas"

	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-control-center.mo"
	done
}
