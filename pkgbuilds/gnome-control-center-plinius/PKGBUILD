pkgname=gnome-control-center-plinius
pkgver=51.2.1
pkgrel=8
pkgdesc="GNOME Settings with the Plinius settings built in"
url="https://apps.gnome.org/Settings/"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
