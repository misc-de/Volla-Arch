license=(GPL-2.0-or-later MIT)
# Why a custom build: GNOME Settings has no plugins, all pages are compiled in.
# Our own settings should still live here, not in separate apps.
# Must follow the gnome-control-center version in ALARM (same GNOME version as
# gnome-settings-daemon and gnome-shell). Dependencies as in ALARM, plus plinius-account
# (plinius-rename-user for "Username", from 0.6 plinius-add-user for Add on Local Accounts),
# appstream (the app catalog under Apps > Explore) and gstreamer with gst-plugins-base (playbin,
# videoconvert, appsink: the thumbnails of the videos on the Background page).
depends=(
	accountsservice bolt cairo colord-gtk4 cups-pk-helper dconf fontconfig gcr-4 gdk-pixbuf2
	glib2 glibc gnome-bluetooth-3.0 gnome-color-manager gnome-desktop-4 gnome-keybindings
	gnome-online-accounts gnome-settings-daemon gnome-shell gnutls graphene
	gsettings-desktop-schemas gsound gst-plugins-good gtk4 hicolor-icon-theme json-glib krb5
	libadwaita libcolord libcups libepoxy libgcc libgoa libgtop libgudev libibus libmalcontent
	libmm-glib libnm libnma-gtk4 libpulse libpwquality libsecret libsoup3 libwacom libx11 libxi
	libxml2 pango polkit smbclient sound-theme-freedesktop tecla udisks2 upower wayland
	'plinius-account>=0.6' appstream gstreamer gst-plugins-base
)
makedepends=(blueprint-compiler docbook-xsl git glib2-devel meson modemmanager gettext)
optdepends=(
	'plinius-security: password ratings and known vulnerabilities on the Device Security page'
	'plinius-netlog: connections per app on the Device Security page and on each app'"'"'s page under Apps'
	'plinius-dnsfilter: DNS Filter on the Network page (blocklists, own rules, query log)'
	'plinius-ambient>=0.5: animated effect, 360° photos and videos as the background (Appearance > Background)'
	'gnome-remote-desktop: screen sharing'
	'gnome-user-share: WebDAV file sharing'
	'malcontent: application permission control'
	'networkmanager: network settings'
	'openssh: remote login'
	'power-profiles-daemon: power profiles'
	'rygel: media sharing'
	'system-config-printer: printer settings'
	'lpac>=2.3.0.r121.654215e-3: eSIM management in Mobile Network (with ofono-sailfish; -3 brings the GSMA CI roots for checking the server)'
	'plinius-assist: assistant button panel'
	'plinius-wake: wake up by double tap or tilt, brighten when picked up, on the Display page'
	'plinius-charge: charge limit and fast charging on the Power page'
	'plinius-energy: the page Battery Usage (estimated energy per app) on the Power page'
	'phosh-plinius: custom accent color on the Appearance page (org.plinius.appearance)'
	'plinius-face: Face Unlock on the Users page'
	'furios-gps-contribute: Contribute to beaconDB on the Location page'
	'plinius-epo: Faster GPS Fix on the Location page (orbit predictions for the GPS)'
	'feedbackd: Sounds and Vibration panel (sound and vibration of calls, messages, alarms, keyboard, alert sound)'
	'phoc-plinius>=0.59.0-3: the alert sound of Sounds and Vibration (phoc hands the bell of the apps to feedbackd)'
	'plinius-speech: Speech Output panel (voice and speech rate of everything the phone says, caller announcement)'
	'plinius-pinguard: Wait After Wrong PINs on the Screen Lock page'
	'schwupp: Streaming panel (settings for mirroring the screen to TVs)'
	'plinius-usb: USB panel (file sharing, network and internet for a computer)'
	'stevia-plinius: look of the on-screen keyboard on the Keyboard page'
	'plinius-ssh: allowed networks (USB, local, all) on the Secure Shell page'
	'plinius-desktop: Desktop over VNC with its taskbar edge on the Remote Access page'
	'plinius-swap: the page Memory and Swap in System'
	'plinius-health: the page Self-Test in System'
	'plinius-rollback: Take Back Update on the Self-Test page'
	'plinius-software: Explore and Remove under Apps, the panel Updates (System and Security)'
	'firefox: the tab Web Apps under Apps (websites as apps)'
	'chromium: Chromium as the browser of web apps (Apps > Web Apps)'
	'plinius-webapps: Search under Apps > Web Apps > Add (well-known websites with their settings)'
	'plinius-widevine: Protected Content (DRM) on the Privacy page'
	'mmsd4ofono>=1.3.2.20261111-4: the MMS switch of each SIM (Mobile Network)'
	'plinius-appaccess: Access on each app'"'"'s page under Apps (USB camera, security key, network: ask, allow or not, with the attempts)'
)
provides=("gnome-control-center=$pkgver")
conflicts=(gnome-control-center 'plinius-software<0.12-16')
# Our own strings are English, translated in *.po (gettext domain plinius-control-center,
# template plinius-control-center.pot); GNOME's own translations stay untouched.
_langs=(de fr es it pt nl pl ru)
