# cc-plinius-display.*, cc-plinius-buttons.*, cc-assistant-panel.*, cc-nfc-panel.*, cc-esim-dialog.*,
# cc-pattern-dialog.*, cc-plinius-battery.*, cc-plinius-crypt.*, cc-plinius-dialog-pages.c,
# cc-plinius-accent.*, cc-plinius-security.*, cc-plinius-ambient.*, cc-plinius-panorama.*, cc-face-dialog.*,
