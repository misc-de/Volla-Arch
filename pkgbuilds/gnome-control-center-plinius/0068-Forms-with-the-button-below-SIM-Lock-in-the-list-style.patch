diff --git a/panels/network/network-dialogs.c b/panels/network/network-dialogs.c
index 6c72d34f0..564261278 100644
--- a/panels/network/network-dialogs.c
+++ b/panels/network/network-dialogs.c
@@ -159,6 +159,68 @@ done:
  * that programs linking this file without the shell (tests) still link */
 extern gboolean cc_plinius_gtk_dialog_present_as_page (GtkDialog *dialog, GtkWidget *parent) __attribute__ ((weak));
 
+/* Plinius: the widget with the GtkBuilder id @id in @widget's tree, depth first */
+static GtkWidget *
+find_buildable (GtkWidget *widget, const char *id)
+{
+    GtkWidget *child;
+
+    for (child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child)) {
+        GtkWidget *found;
+
+        if (g_strcmp0 (gtk_buildable_get_buildable_id (GTK_BUILDABLE (child)), id) == 0)
+            return child;
+        found = find_buildable (child, id);
+        if (found)
+            return found;
+    }
+    return NULL;
+}
+
+/* Plinius: libnma's Wi-Fi dialog as a form page. Its large icon and the bold caption ("Hidden
+ * Wi-Fi network") only repeat the page's title, so they go; the explaining sentence stays,
+ * over the whole width. "Connect" (or "Create") moves below the form. The ids are libnma's
+ * wifi.ui; if they change, the dialog stays as it is. */
+static void
+tidy_wifi_dialog_page (GtkDialog *dialog)
+{
+    GtkWidget *content, *grid, *image, *caption;
+    g_autofree char *text = NULL;
+    const char *sentence;
+
+    /* read by cc_plinius_gtk_dialog_present_as_page() (CC_PLINIUS_CONFIRM_BELOW) */
+    g_object_set_data (G_OBJECT (dialog), "cc-plinius-confirm-below", GINT_TO_POINTER (TRUE));
+
+    G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+    content = gtk_dialog_get_content_area (dialog);
+    G_GNUC_END_IGNORE_DEPRECATIONS
+    grid = find_buildable (content, "wifi_dialog");
+    image = find_buildable (content, "image1");
+    caption = find_buildable (content, "caption_label");
+    if (!GTK_IS_GRID (grid) || !GTK_IS_IMAGE (image) || !GTK_IS_LABEL (caption) ||
+        gtk_widget_get_parent (image) != grid || gtk_widget_get_parent (caption) != grid)
+        return;
+
+    gtk_grid_remove (GTK_GRID (grid), image);
+
+    /* "<b>caption</b>\n\nsentence": keep the sentence, as plain text */
+    text = g_strdup (gtk_label_get_text (GTK_LABEL (caption)));
+    sentence = g_strstr_len (text, -1, "\n\n");
+    if (sentence) {
+        gtk_label_set_use_markup (GTK_LABEL (caption), FALSE);
+        gtk_label_set_text (GTK_LABEL (caption), sentence + 2);
+    }
+
+    /* the column of the icon is gone: the sentence starts where the form starts */
+    g_object_ref (caption);
+    gtk_grid_remove (GTK_GRID (grid), caption);
+    gtk_widget_set_margin_start (caption, 0);
+    gtk_widget_set_margin_end (caption, 0);
+    gtk_widget_set_margin_top (caption, 0);
+    gtk_grid_attach (GTK_GRID (grid), caption, 0, 0, 2, 1);
+    g_object_unref (caption);
+}
+
 static void
 show_wireless_dialog (GtkWidget *toplevel, NMClient *client, GtkWidget *dialog)
 {
@@ -176,6 +238,8 @@ show_wireless_dialog (GtkWidget *toplevel, NMClient *client, GtkWidget *dialog)
 
     /* Plinius: a page of the window with the back swipe, not a window of its own */
     G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+    if (cc_plinius_gtk_dialog_present_as_page && NMA_IS_WIFI_DIALOG (dialog))
+        tidy_wifi_dialog_page (GTK_DIALOG (dialog));
     if (cc_plinius_gtk_dialog_present_as_page &&
         cc_plinius_gtk_dialog_present_as_page (GTK_DIALOG (dialog), toplevel))
         return;
