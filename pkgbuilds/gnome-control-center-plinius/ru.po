# Plinius: assistant button on the Power page (cc-plinius-buttons.*)
msgid "Assistant Button"
msgstr "Кнопка ассистента"

msgid "“Custom” runs a program or script of your choice."
msgstr "«Своё» запускает выбранную программу или скрипт."

msgid "Short Press"
msgstr "Короткое нажатие"

msgid "Double Press"
msgstr "Двойное нажатие"

msgid "Long Press"
msgstr "Долгое нажатие"

msgid "Nothing"
msgstr "Ничего"

msgid "Torch"
msgstr "Фонарик"

msgid "Screenshot"
msgstr "Снимок экрана"

msgid "Camera"
msgstr "Камера"

msgid "Silent Mode"
msgstr "Беззвучный режим"

