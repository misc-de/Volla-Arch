# Plinius: NFC panel (cc-nfc-panel.*)
msgid "Switching NFC failed"
msgstr "Не удалось переключить NFC"

msgid "Reads NFC tags and talks to cards and terminals held to the back of the phone. It only looks for them while the screen is on."
msgstr "Читает NFC-метки и общается с картами и терминалами, поднесёнными к задней стороне телефона. Ищет их только при включённом экране."

# Plinius: unlock pattern (cc-pattern-dialog.*, users page; Phosh lock screen)
msgid "Unlock Pattern"
msgstr "Графический ключ"

msgid "On"
msgstr "Вкл."

msgid "Off"
msgstr "Выкл."

msgid "With an unlock pattern, the lock screen takes the pattern or a fingerprint instead of the PIN. Enter your PIN to continue."
msgstr "С графическим ключом экран блокировки принимает ключ или отпечаток пальца вместо PIN-кода. Введите PIN-код, чтобы продолжить."

msgid "PIN"
msgstr "PIN-код"

msgid "Continue"
msgstr "Продолжить"

msgid "Wrong PIN. Try again."
msgstr "Неверный PIN-код. Попробуйте ещё раз."

msgid "Draw your current pattern."
msgstr "Нарисуйте текущий графический ключ."

msgid "Wrong pattern. Try again."
msgstr "Неверный ключ. Попробуйте ещё раз."

msgid "Too many wrong tries. Try again later."
msgstr "Слишком много неудачных попыток. Попробуйте позже."

msgid "Use PIN Instead"
msgstr "Ввести PIN-код вместо ключа"

msgid "Draw an unlock pattern. Connect at least 6 points."
msgstr "Нарисуйте графический ключ. Соедините не менее 6 точек."

msgid "Connect at least 6 points."
msgstr "Соедините не менее 6 точек."

msgid "Draw the pattern again to confirm."
msgstr "Нарисуйте ключ ещё раз для подтверждения."

msgid "The patterns do not match. Draw a new one."
msgstr "Ключи не совпадают. Нарисуйте новый."

msgid "The pattern could not be saved."
msgstr "Не удалось сохранить ключ."

msgid "The pattern could not be removed."
msgstr "Не удалось удалить ключ."

msgid "Remove Pattern"
msgstr "Удалить ключ"

msgid "Draw Pattern"
msgstr "Нарисуйте ключ"

msgid "Wrong Pattern"
msgstr "Неверный ключ"

msgid "Use PIN"
msgstr "Ввести PIN-код"

msgid "Use Pattern"
msgstr "Использовать ключ"

# Plinius: test area of Graphics Tablets (pen or finger)
msgid "Pen"
msgstr "Перо"

msgid "Finger"
msgstr "Палец"

msgid "Battery Condition"
msgstr "Состояние батареи"

msgid "Health"
msgstr "Работоспособность"

msgid "Capacity compared to when the battery was new"
msgstr "Ёмкость по сравнению с новой батареей"

msgid "Full Charge"
msgstr "Полный заряд"

msgid "Charge Cycles"
msgstr "Циклы зарядки"

msgid "Temperature"
msgstr "Температура"

msgid "Voltage"
msgstr "Напряжение"

msgid "Power"
msgstr "Мощность"

msgid "Battery Type"
msgstr "Тип батареи"

msgid "Charging"
msgstr "Заряжается"

msgid "Discharging"
msgstr "Разряжается"

msgid "Fully charged"
msgstr "Полностью заряжена"

msgid "Charging paused"
msgstr "Зарядка приостановлена"

msgid "Lithium-ion"
msgstr "Литий-ионная"

msgid "Lithium polymer"
msgstr "Литий-полимерная"

msgid "Lithium iron phosphate"
msgstr "Литий-железо-фосфатная"

#, c-format
msgid "%.1f of %.1f Wh"
msgstr "%.1f из %.1f Вт·ч"

#, c-format
msgid "%.1f W, %s"
msgstr "%.1f Вт, %s"

msgid "Fast Charging"
msgstr "Быстрая зарядка"

msgid "Charges faster with a suitable charger. The battery gets warmer."
msgstr "Заряжает быстрее с подходящим зарядным устройством. Батарея сильнее нагревается."

#, c-format
msgid "Charging stops at %u %% and starts again at %u %%"
msgstr "Зарядка останавливается на %u %% и возобновляется на %u %%"

msgid "Always-On Display"
msgstr "Постоянно включённый экран"

msgid "Time and notifications on the dark screen at low power, not during calls"
msgstr "Время и уведомления на тёмном экране с низким энергопотреблением, не во время звонков"

msgid "Flip Cover"
msgstr "Чехол-книжка"

msgid "Closing the cover turns the screen off, opening it turns the screen on"
msgstr "Закрытие чехла выключает экран, открытие — включает"

msgid "_Close"
msgstr "_Закрыть"

msgid "Encrypted"
msgstr "Зашифровано"

msgid "The phone asks for the encryption password at every start. Without it, nobody can read the data."
msgstr "Телефон запрашивает пароль шифрования при каждом запуске. Без него никто не сможет прочитать данные."

msgid "Encryption at the Next Restart"
msgstr "Шифрование при следующем перезапуске"

msgid "At the next start the phone asks for a new encryption password, then encrypts. This takes a while, keep the phone charging."
msgstr "При следующем запуске телефон запросит новый пароль шифрования, а затем зашифрует данные. Это займёт некоторое время; держите телефон на зарядке."

msgid "Not Encrypted"
msgstr "Не зашифровано"

msgid "Whoever has the phone in hand can read the data from its storage."
msgstr "Любой, у кого телефон в руках, может прочитать данные из его памяти."

msgid "Not Available"
msgstr "Недоступно"

msgid "This system does not start with the encryption support, so it cannot be encrypted."
msgstr "Эта система запускается без поддержки шифрования, поэтому её нельзя зашифровать."

msgid "Encryption Not Possible"
msgstr "Шифрование невозможно"

msgid "Encryption Failed"
msgstr "Не удалось зашифровать"

msgid "Encrypt the Phone?"
msgstr "Зашифровать телефон?"

msgid "At the next restart the phone asks twice for a new encryption password and then encrypts the system. Depending on the amount of data this takes some minutes; keep the phone charging and do not switch it off.\n\nFrom then on the password is asked at every start. It cannot be recovered: without it, the data is lost. It must differ from the screen lock PIN."
msgstr "При следующем перезапуске телефон дважды запросит новый пароль шифрования, а затем зашифрует систему. В зависимости от объёма данных это займёт несколько минут; держите телефон на зарядке и не выключайте его.\n\nПосле этого пароль запрашивается при каждом запуске. Его нельзя восстановить: без него данные будут потеряны. Он должен отличаться от PIN-кода блокировки экрана."

msgid "_Encrypt at Restart"
msgstr "_Зашифровать при перезапуске"

msgid "Cancelling Failed"
msgstr "Не удалось отменить"

msgid "The new passwords do not match."
msgstr "Новые пароли не совпадают."

msgid "The current password is wrong."
msgstr "Текущий пароль неверен."

msgid "Changing the password. This takes a few seconds, do not switch the phone off."
msgstr "Пароль меняется. Это займёт несколько секунд, не выключайте телефон."

msgid "The new password is the screen lock PIN. Choose a different one, so that the PIN alone does not open the phone."
msgstr "Новый пароль совпадает с PIN-кодом блокировки экрана. Выберите другой, чтобы один PIN-код не открывал телефон."

msgid "Changing the password failed."
msgstr "Не удалось изменить пароль."

msgid "Change Password"
msgstr "Изменить пароль"

msgid "C_hange"
msgstr "_Изменить"

msgid "The password is asked at every start, on the keyboard shown there. It must differ from the screen lock PIN."
msgstr "Пароль запрашивается при каждом запуске на показанной там клавиатуре. Он должен отличаться от PIN-кода блокировки экрана."

msgid "Current Password"
msgstr "Текущий пароль"

msgid "New Password"
msgstr "Новый пароль"

msgid "Repeat New Password"
msgstr "Повторите новый пароль"

msgid "_Encrypt…"
msgstr "_Зашифровать…"

msgid "_Cancel Encryption"
msgstr "_Отменить шифрование"

msgid "Change _Password…"
msgstr "Изменить _пароль…"

msgid "Encryption"
msgstr "Шифрование"

msgid "_Encryption"
msgstr "_Шифрование"

msgid "Password at startup for the data on the phone"
msgstr "Пароль при запуске для данных на телефоне"

msgid "The new password is the encryption password. Choose a different one, so that the PIN alone does not open the phone."
msgstr "Новый пароль совпадает с паролем шифрования. Выберите другой, чтобы один PIN-код не открывал телефон."

msgid "Custom Color"
msgstr "Свой цвет"

msgid "_Select"
msgstr "_Выбрать"

# Device Security (cc-plinius-security.c)
msgid "Screen Lock"
msgstr "Блокировка экрана"

msgid "Unlock pattern of at least 6 points."
msgstr "Графический ключ не менее чем из 6 точек."

msgid "The PIN is not rated yet. Set it again to rate it."
msgstr "PIN-код ещё не оценён. Задайте его заново, чтобы оценить."

msgid "PIN of at least 6 digits."
msgstr "PIN-код не менее чем из 6 цифр."

msgid "The PIN is shorter than 6 digits. Choose a longer one."
msgstr "PIN-код короче 6 цифр. Выберите более длинный."

msgid "Wrong tries do not make the lock screen wait, a short PIN can be guessed by trying."
msgstr "Неудачные попытки не вызывают ожидания, короткий PIN-код можно подобрать."

msgid "Not available: plinius-crypt is not installed. Whoever has the phone in hand can read its data."
msgstr "Недоступно: plinius-crypt не установлен. Любой, у кого телефон в руках, может прочитать его данные."

msgid "Not encrypted. Whoever has the phone in hand can read its data."
msgstr "Не зашифровано. Любой, у кого телефон в руках, может прочитать его данные."

msgid "Encryption at the next restart. Until then the data can be read."
msgstr "Шифрование при следующем перезапуске. До тех пор данные можно прочитать."

msgid "Not encrypted, and this system cannot be encrypted: it does not start with the encryption support."
msgstr "Не зашифровано, и эту систему нельзя зашифровать: она запускается без поддержки шифрования."

msgid "Encrypted. The password is not rated yet. Change it once to rate it."
msgstr "Зашифровано. Пароль ещё не оценён. Измените его один раз, чтобы оценить."

msgid "Encrypted with a strong password."
msgstr "Зашифровано надёжным паролем."

msgid "Encrypted, but the password could be found with enough computing power. Choose 12 or more mixed characters or 5 random words."
msgstr "Зашифровано, но пароль можно подобрать при достаточной вычислительной мощности. Выберите 12 или более разных символов или 5 случайных слов."

msgid "Encrypted, but the password is a dictionary word or close to one. Change the password."
msgstr "Зашифровано, но пароль — словарное слово или почти. Измените пароль."

msgid "Encrypted, but the password is too short or too simple. Change the password."
msgstr "Зашифровано, но пароль слишком короткий или простой. Измените пароль."

msgid "Boot Chain"
msgstr "Цепочка загрузки"

msgid "Tampering detected: %s changed since the last accepted state."
msgstr "Обнаружено вмешательство: %s изменено с последнего подтверждённого состояния."

msgid "Bootloader, kernel and ramdisk are unchanged since the last accepted state."
msgstr "Загрузчик, ядро и ramdisk не менялись с последнего подтверждённого состояния."

msgid "Not checked at this start yet."
msgstr "При этом запуске ещё не проверено."

msgid "Bootloader"
msgstr "Загрузчик"

msgid "Unlocked, so that this system can start. Whoever has the phone in hand can start a different system; the encryption keeps the data safe, the boot chain check notices changes."
msgstr "Разблокирован, чтобы эта система могла запускаться. Тот, у кого телефон в руках, может запустить другую систему; шифрование защищает данные, проверка цепочки загрузки замечает изменения."

msgid "Software Sources"
msgstr "Источники программ"

msgid "The package settings cannot be read."
msgstr "Не удаётся прочитать настройки пакетов."

msgid "Packages without a valid signature are accepted (SigLevel in /etc/pacman.conf)."
msgstr "Принимаются пакеты без действительной подписи (SigLevel в /etc/pacman.conf)."

msgid "Updates are only installed with a valid signature."
msgstr "Обновления устанавливаются только с действительной подписью."

msgid "Not checked yet. The list is loaded four times a day."
msgstr "Ещё не проверено. Список загружается четыре раза в день."

msgid "No known vulnerabilities in the installed packages."
msgstr "В установленных пакетах нет известных уязвимостей."

msgid "%u known vulnerability in installed packages"
msgid_plural "%u known vulnerabilities in installed packages"
msgstr[0] "%u известная уязвимость в установленных пакетах"
msgstr[1] "%u известные уязвимости в установленных пакетах"
