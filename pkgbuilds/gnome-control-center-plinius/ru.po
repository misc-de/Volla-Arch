msgid "This username is available."
msgstr "Это имя пользователя свободно."

msgid "Lower case letters, numbers, hyphens and underscores, starting with a letter, at most 32 characters."
msgstr "Строчные латинские буквы, цифры, дефисы и подчёркивания, начиная с буквы, не более 32 символов."

msgid "A group with this name already exists."
msgstr "Группа с таким именем уже существует."

msgid "A home folder with this name already exists."
msgstr "Домашняя папка с таким именем уже существует."

msgid "Checking username…"
msgstr "Проверка имени пользователя…"

msgid "Renaming failed"
msgstr "Не удалось переименовать"

msgid "Restarting failed"
msgstr "Не удалось перезапустить"

#, c-format
msgid "On restart, %1$s will be renamed to %2$s. After that, you log in as %2$s."
msgstr "При перезапуске %1$s будет переименован в %2$s. После этого вы будете входить как %2$s."

msgid "Undoing failed"
msgstr "Не удалось отменить"

msgid "Change Username"
msgstr "Изменение имени пользователя"

msgid "_Cancel"
msgstr "_Отмена"

msgid "_Rename"
msgstr "_Переименовать"

msgid "The name you log in with. Your home folder, groups, automatic login and references in your settings are renamed along with it. Password and PIN stay the same. The renaming happens at the next restart, before login."
msgstr "Имя, под которым вы входите в систему. Домашняя папка, группы, автоматический вход и ссылки в ваших настройках будут переименованы вместе с ним. Пароль и PIN-код не изменятся. Переименование произойдёт при следующем перезапуске, до входа в систему."

msgid "Current Username"
msgstr "Текущее имя пользователя"

msgid "_New Username"
msgstr "_Новое имя пользователя"

msgid "Scheduled for the Next Restart"
msgstr "Запланировано на следующий перезапуск"

msgid "_Undo"
msgstr "Отменить _изменение"

msgid "Restart Now?"
msgstr "Перезапустить сейчас?"

msgid "_Later"
msgstr "_Позже"

msgid "_Restart"
msgstr "Пере_запустить"

msgid "Notch"
msgstr "Вырез"

msgid "Top bar icons make room for the camera"
msgstr "Значки верхней панели освобождают место для камеры"

msgid "Automatic"
msgstr "Автоматически"

msgid "None"
msgstr "Нет"

msgid "Left"
msgstr "Слева"

msgid "Center"
msgstr "По центру"

msgid "Right"
msgstr "Справа"

# Plinius: eSIM management (cc-esim-dialog.*, Mobile Network device page)
msgid "eSIM"
msgstr "eSIM"

msgid "_eSIM"
msgstr "_eSIM"

msgid "_Manage eSIM"
msgstr "_Управление eSIM"

msgid "Add, switch and delete profiles"
msgstr "Добавление, переключение и удаление профилей"

msgid "eSIM Not Available"
msgstr "eSIM недоступна"

msgid "_Try Again"
msgstr "_Повторить"

msgid "Profiles"
msgstr "Профили"

msgid "Only one profile can be active at a time."
msgstr "Одновременно может быть активен только один профиль."

msgid "There are no profiles on this eSIM yet."
msgstr "На этой eSIM пока нет профилей."

msgid "_Add Profile…"
msgstr "_Добавить профиль…"

msgid "eSIM Chip"
msgstr "Чип eSIM"

msgid "EID"
msgstr "EID"

msgid "Copy EID"
msgstr "Копировать EID"

msgid "EID copied"
msgstr "EID скопирован"

msgid "Free Memory"
msgstr "Свободная память"

msgid "Specification"
msgstr "Спецификация"

msgid "Profile"
msgstr "Профиль"

msgid "Label"
msgstr "Метка"

msgid "Shown instead of the network's name."
msgstr "Показывается вместо названия сети."

msgid "Provider"
msgstr "Оператор"

msgid "Profile Name"
msgstr "Имя профиля"

msgid "ICCID"
msgstr "ICCID"

msgid "Type"
msgstr "Тип"

msgid "Active"
msgstr "Активен"

msgid "_Active"
msgstr "_Активен"

msgid "Test profile"
msgstr "Тестовый профиль"

msgid "Provisioning profile"
msgstr "Профиль подготовки"

msgid "Operator profile"
msgstr "Профиль оператора"

msgid "_Delete Profile…"
msgstr "_Удалить профиль…"

msgid "Delete Profile?"
msgstr "Удалить профиль?"

#, c-format
msgid "“%s” will be removed from the eSIM for good. To use it again, you need a new activation code from the provider."
msgstr "«%s» будет окончательно удалён с eSIM. Чтобы снова им пользоваться, нужен новый код активации от оператора."

msgid "Profile deleted"
msgstr "Профиль удалён"

msgid "Add Profile"
msgstr "Добавить профиль"

msgid "Enter the activation code from your provider. It starts with “LPA:1$”, the QR code from the provider contains the same text."
msgstr "Введите код активации от оператора. Он начинается с «LPA:1$», QR-код оператора содержит тот же текст."

msgid "Activation Code"
msgstr "Код активации"

msgid "Confirmation Code (if required)"
msgstr "Код подтверждения (если нужен)"

msgid "_Download Profile"
msgstr "_Загрузить профиль"

msgid "Downloading the profile. This can take a minute."
msgstr "Профиль загружается. Это может занять минуту."

msgid "Profile added. Switch it on to use it."
msgstr "Профиль добавлен. Включите его, чтобы пользоваться."

msgid "Done. The mobile network may take a moment to appear."
msgstr "Готово. Мобильная сеть может появиться не сразу."

msgid "Reading the profiles failed"
msgstr "Не удалось прочитать профили"

msgid "Switching the profile failed"
msgstr "Не удалось переключить профиль"

msgid "Renaming the profile failed"
msgstr "Не удалось переименовать профиль"

msgid "Deleting the profile failed"
msgstr "Не удалось удалить профиль"

msgid "Downloading the profile failed"
msgstr "Не удалось загрузить профиль"

# Plinius: phone options on the Display page (cc-plinius-display.*), About
msgid "Rotation"
msgstr "Поворот"

msgid "Rotation Speed"
msgstr "Скорость поворота"

msgid "How long the phone must be held turned before the screen follows"
msgstr "Сколько телефон нужно держать повёрнутым, прежде чем экран повернётся"

msgid "Fast"
msgstr "Быстро"

msgid "Normal"
msgstr "Обычно"

msgid "Slow"
msgstr "Медленно"

msgid "Wake Up"
msgstr "Пробуждение"

msgid "The screen also comes on without the power button. Not while the phone is in a pocket."
msgstr "Экран включается и без кнопки питания. Но не тогда, когда телефон в кармане."

msgid "Double Tap"
msgstr "Двойное касание"

msgid "Tap the dark screen twice"
msgstr "Дважды коснитесь тёмного экрана"

msgid "Tilt"
msgstr "Наклон"

msgid "Pick the phone up from lying flat"
msgstr "Поднимите лежащий телефон"

msgid "Brighten When Picked Up"
msgstr "Ярче при поднятии"

msgid "A dimmed screen gets bright again, a dark one stays off"
msgstr "Затемнённый экран снова становится ярким, выключенный остаётся выключенным"

msgid "App Overview"
msgstr "Обзор приложений"

msgid "Search"
msgstr "Поиск"

msgid "Search field above the apps"
msgstr "Поле поиска над приложениями"

msgid "App Names"
msgstr "Названия приложений"

msgid "Names under the app icons"
msgstr "Названия под значками"

msgid "Folders at the Bottom"
msgstr "Папки внизу"

msgid "Folders in one row at the bottom edge, scrolling sideways"
msgstr "Папки в один ряд внизу, прокрутка вбок"

msgid "Mobile Apps Button"
msgstr "Кнопка «Мобильные приложения»"

msgid "Button that shows only the apps made for phones"
msgstr "Кнопка, показывающая только приложения для телефонов"

#, c-format
msgid "%s + %s SD"
msgstr "%s + %s SD"

msgid "Done. The network may take a moment."
msgstr "Готово. Сеть может появиться не сразу."

