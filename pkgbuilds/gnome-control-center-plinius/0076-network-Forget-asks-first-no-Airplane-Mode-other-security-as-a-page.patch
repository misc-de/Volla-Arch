diff --git a/panels/network/net-device-wifi.c b/panels/network/net-device-wifi.c
index 121aa2645..704a4664e 100644
--- a/panels/network/net-device-wifi.c
+++ b/panels/network/net-device-wifi.c
@@ -68,8 +68,6 @@ struct _NetDeviceWifi {
     AdwDialog *saved_networks_dialog;
     GtkStack *saved_networks_stack;
     AdwToastOverlay *saved_networks_toast_overlay;
-    AdwToast *saved_networks_undo_toast;
-    GPtrArray *saved_networks_forgotten_rows;
 
     AdwSwitchRow *device_enable_row;
     CcListRow *saved_network_row;
@@ -732,89 +730,67 @@ really_forget (gpointer data)
     nm_remote_connection_delete_async (connection, self->cancellable, really_forgotten, g_object_ref (self));
 }
 
-static void
-undo_forget (gpointer data)
+/* Whether a saved network other than @row is still listed */
+static gboolean
+other_rows_shown (CcWifiConnectionList *list, GtkWidget *row)
 {
-    CcWifiConnectionRow *row = CC_WIFI_CONNECTION_ROW (data);
-    NetDeviceWifi *self;
-
-    self = NET_DEVICE_WIFI (g_object_get_data (G_OBJECT (row), "net"));
+    GtkWidget *child;
 
-    gtk_widget_set_visible (GTK_WIDGET (row), TRUE);
+    for (child = gtk_widget_get_first_child (GTK_WIDGET (cc_wifi_connection_list_get_list_box (list))); child;
+         child = gtk_widget_get_next_sibling (child)) {
+        if (child != row && CC_IS_WIFI_CONNECTION_ROW (child) && gtk_widget_get_visible (child))
+            return TRUE;
+    }
 
-    cc_wifi_connection_list_thaw (self->saved_networks_list);
+    return FALSE;
 }
 
+/* Plinius: confirmed in the alert below, the network goes at once (no toast to undo it) */
 static void
-on_saved_networks_forget_dismissed (NetDeviceWifi *self)
+forget_confirmed_cb (NetDeviceWifi *self, const char *response, AdwAlertDialog *dialog)
 {
-    self->saved_networks_undo_toast = NULL;
+    CcWifiConnectionRow *row = g_object_get_data (G_OBJECT (dialog), "row");
 
-    /* Since the free function is set to either undo or really forget,
-       this always does the right thing */
-    g_clear_pointer (&self->saved_networks_forgotten_rows, g_ptr_array_unref);
-}
+    if (!row || !cc_wifi_connection_row_get_connection (row))
+        return;
 
-static void
-on_saved_networks_forget_undo (NetDeviceWifi *self)
-{
-    g_ptr_array_set_free_func (self->saved_networks_forgotten_rows, undo_forget);
-    gtk_stack_set_visible_child_name (self->saved_networks_stack, "saved-networks-page");
-}
+    cc_wifi_connection_list_freeze (self->saved_networks_list);
 
-static gboolean
-deleted_row_is_last (CcWifiConnectionList *list, GtkWidget *row)
-{
-    GtkListBox *listbox;
+    gtk_widget_set_visible (GTK_WIDGET (row), FALSE);
+    g_object_set_data (G_OBJECT (row), "net", self);
+    /* thawed when NetworkManager answers: then the list is built anew */
+    really_forget (row);
 
-    listbox = cc_wifi_connection_list_get_list_box (list);
-    return !gtk_list_box_get_row_at_index (listbox, 1) && !gtk_widget_get_visible (GTK_WIDGET (row));
+    if (!other_rows_shown (self->saved_networks_list, GTK_WIDGET (row)))
+        gtk_stack_set_visible_child_name (self->saved_networks_stack, "no-saved-networks-page");
 }
 
+/* Plinius: the trash button asks first; one tap was enough to lose a network and its password */
 static void
 forget_selected (NetDeviceWifi *self, CcWifiConnectionRow *row, CcWifiConnectionList *list)
 {
-    g_autofree gchar *message = NULL;
-
-    cc_wifi_connection_list_freeze (list);
-
-    gtk_widget_set_visible (GTK_WIDGET (row), FALSE);
-    g_object_set_data (G_OBJECT (row), "net", self);
-
-    /* Add row to the array of rows to be handled by the undo toast */
-    if (!self->saved_networks_forgotten_rows)
-        self->saved_networks_forgotten_rows = g_ptr_array_new_with_free_func (really_forget);
-
-    g_ptr_array_add (self->saved_networks_forgotten_rows, row);
-
-    /* If undo toast does not exist, create it, otherwise update title and extend timeout */
-    if (!self->saved_networks_undo_toast) {
-        message = g_strdup (_("Network deleted"));
-        self->saved_networks_undo_toast = adw_toast_new (message);
-        adw_toast_set_button_label (self->saved_networks_undo_toast, _("_Undo"));
+    NMConnection *connection = cc_wifi_connection_row_get_connection (row);
+    g_autofree gchar *heading = NULL;
+    AdwDialog *dialog;
 
-        g_signal_connect_swapped (self->saved_networks_undo_toast, "button-clicked",
-                                  G_CALLBACK (on_saved_networks_forget_undo), self);
-
-        g_signal_connect_swapped (self->saved_networks_undo_toast, "dismissed",
-                                  G_CALLBACK (on_saved_networks_forget_dismissed), self);
-    } else {
-        /* Translators: %d is the number of network connections deleted. */
-        message = g_strdup_printf (
-            ngettext ("%d network deleted", "%d networks deleted", self->saved_networks_forgotten_rows->len),
-            self->saved_networks_forgotten_rows->len);
-
-        adw_toast_set_title (self->saved_networks_undo_toast, message);
-
-        g_object_ref (self->saved_networks_undo_toast);
-    }
-
-    adw_toast_overlay_add_toast (self->saved_networks_toast_overlay, self->saved_networks_undo_toast);
+    if (!connection)
+        return;
 
-    if (deleted_row_is_last (list, GTK_WIDGET (row)))
-        gtk_stack_set_visible_child_name (self->saved_networks_stack, "no-saved-networks-page");
-    else
-        gtk_stack_set_visible_child_name (self->saved_networks_stack, "saved-networks-page");
+    /* Translators: "%s" is the name of the saved Wi-Fi network */
+    heading = g_strdup_printf (g_dgettext ("plinius-control-center", "Forget “%s”?"),
+                               nm_connection_get_id (connection));
+    dialog = adw_alert_dialog_new (heading,
+                                   g_dgettext ("plinius-control-center",
+                                               "Its password and settings will be deleted from this device."));
+    adw_alert_dialog_add_responses (ADW_ALERT_DIALOG (dialog), "cancel", _("_Cancel"), "forget", _("_Forget"), NULL);
+    adw_alert_dialog_set_response_appearance (ADW_ALERT_DIALOG (dialog), "forget", ADW_RESPONSE_DESTRUCTIVE);
+    adw_alert_dialog_set_default_response (ADW_ALERT_DIALOG (dialog), "cancel");
+    adw_alert_dialog_set_close_response (ADW_ALERT_DIALOG (dialog), "cancel");
+
+    /* the list may be built anew while the alert is open: the row stays alive for the answer */
+    g_object_set_data_full (G_OBJECT (dialog), "row", g_object_ref (row), g_object_unref);
+    g_signal_connect_object (dialog, "response::forget", G_CALLBACK (forget_confirmed_cb), self, G_CONNECT_SWAPPED);
+    adw_dialog_present (dialog, GTK_WIDGET (row));
 }
 
 static gint
