 panels/network/cc-wifi-panel.c   |  56 ++++++----------
 panels/network/net-device-wifi.c | 110 ++++++++++++-------------------
 panels/network/network-dialogs.c |  12 +---
 panels/network/network-dialogs.h |   3 -
 5 files changed, 69 insertions(+), 127 deletions(-)

diff --git a/panels/network/cc-wifi-panel.blp b/panels/network/cc-wifi-panel.blp
