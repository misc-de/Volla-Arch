@@ -77,6 +78,28 @@ struct _CcMousePanel {
 
 CC_PANEL_REGISTER (CcMousePanel, cc_mouse_panel)
 
+/* Plinius: a phone has neither until one is connected. Search finds the panel all the same. */
+static void
+update_visibility (GsdDeviceManager *manager, GsdDevice *device, gpointer user_data)
+{
+    CcApplication *application = CC_APPLICATION (g_application_get_default ());
+    g_autoptr(GList) devices =
+        gsd_device_manager_list_devices (manager, GSD_DEVICE_TYPE_MOUSE | GSD_DEVICE_TYPE_TOUCHPAD);
+
+    cc_shell_model_set_panel_visibility (cc_application_get_model (application), "mouse",
+                                         devices ? CC_PANEL_VISIBLE : CC_PANEL_VISIBLE_IN_SEARCH);
+}
+
+void
+cc_mouse_panel_static_init_func (void)
+{
+    GsdDeviceManager *manager = gsd_device_manager_get ();
+
+    g_signal_connect (manager, "device-added", G_CALLBACK (update_visibility), NULL);
+    g_signal_connect (manager, "device-removed", G_CALLBACK (update_visibility), NULL);
+    update_visibility (manager, NULL, NULL);
+}
