+/**
+ * cc_screen_page_move_groups:
+ * @self: a #CcScreenPage
+ * @to: the page to show the groups on
+ *
+ * Plinius: the lock options on the Lock & Unlock page, this page stays alive behind them.
+ */
+void
+cc_screen_page_move_groups (CcScreenPage *self, AdwPreferencesPage *to)
+{
+    AdwPreferencesGroup *groups[] = { self->lock_group, ADW_PREFERENCES_GROUP (self->screen_privacy_group) };
+
+    adw_preferences_group_set_title (self->lock_group, _("Screen Lock"));
+    for (gsize i = 0; i < G_N_ELEMENTS (groups); i++) {
+        g_object_ref (groups[i]);
+        adw_preferences_page_remove (self->preferences_page, groups[i]);
+        adw_preferences_page_add (to, groups[i]);
+        g_object_unref (groups[i]);
+
+        /* The wait after wrong PINs (plinius-pinguard), below the lock options */
+        if (groups[i] == self->lock_group)
+            cc_plinius_pinguard_setup (to);
+    }
+}
