+/* Plinius: the panel's texts instead of its desktop file's. NULL keeps what is there, @keywords
+ * (separated by semicolons) come on top. */
+void
+cc_shell_model_set_panel_labels (CcShellModel *model, const char *id, const char *name, const char *comment,
+                                 const char *keywords)
+{
+    GtkTreeIter iter;
+    gboolean valid = gtk_tree_model_get_iter_first (GTK_TREE_MODEL (model), &iter);
+
+    while (valid) {
+        g_autofree char *panel_id = NULL;
+
+        gtk_tree_model_get (GTK_TREE_MODEL (model), &iter, COL_ID, &panel_id, -1);
+        if (g_str_equal (id, panel_id))
+            break;
+        valid = gtk_tree_model_iter_next (GTK_TREE_MODEL (model), &iter);
+    }
+    if (!valid)
+        return;
+
+    if (name) {
+        g_autofree char *casefolded = cc_util_normalize_casefold_and_unaccent (name);
+
+        gtk_list_store_set (GTK_LIST_STORE (model), &iter, COL_NAME, name, COL_CASEFOLDED_NAME, casefolded, -1);
+    }
+    if (comment) {
+        g_autofree char *casefolded = cc_util_normalize_casefold_and_unaccent (comment);
+
+        gtk_list_store_set (GTK_LIST_STORE (model), &iter, COL_DESCRIPTION, comment, COL_CASEFOLDED_DESCRIPTION,
+                            casefolded, -1);
+    }
+    if (keywords) {
+        g_auto(GStrv) old = NULL;
+        g_auto(GStrv) added = g_strsplit (keywords, ";", -1);
+        g_autoptr(GStrvBuilder) builder = g_strv_builder_new ();
+        g_auto(GStrv) all = NULL;
+
+        gtk_tree_model_get (GTK_TREE_MODEL (model), &iter, COL_KEYWORDS, &old, -1);
+        if (old)
+            g_strv_builder_addv (builder, (const char **) old);
+        for (char **word = added; *word; word++)
+            if (**word)
+                g_strv_builder_take (builder, cc_util_normalize_casefold_and_unaccent (*word));
+        all = g_strv_builder_end (builder);
+        gtk_list_store_set (GTK_LIST_STORE (model), &iter, COL_KEYWORDS, all, -1);
+    }
+}
