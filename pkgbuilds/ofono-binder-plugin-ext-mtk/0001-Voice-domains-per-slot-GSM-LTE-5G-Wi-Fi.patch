+static
+void
+mtk_radio_ext_int_response(
+    MtkRadioExtRequest* req,
+    const RadioResponseInfo* info,
+    const GBinderReader* args)
+{
+    MtkRadioExtIntRequest* int_req = G_CAST(req, MtkRadioExtIntRequest, base);
+    GBinderReader reader;
+    gint32 value = 0;
+
+    gbinder_reader_copy(&reader, args);
+    if (!gbinder_reader_read_int32(&reader, &value) && !info->error) {
+        DBG("%s: response without a value", req->radio->slot);
+    }
+    if (int_req->complete) {
+        int_req->complete(req->radio, info->error, value, req->user_data);
+    }
+}
+
+/* Sends an IMS request with int arguments (after the serial, before the
+ * AIDL clientId). Requests the interface does not know (code -1, all HIDL
+ * versions for the Plinius additions) are not sent and return 0. */
+static
+guint
+mtk_radio_ext_int_args_request_submit(
+    MtkRadioExt* self,
+    MTK_RADIO_REQ req_id,
+    IMS_RADIO_RESP resp_id,
+    MtkRadioExtRequestHandlerFunc handler,
+    gsize req_size,
+    GCallback complete,
+    GDestroyNotify destroy,
+    void* user_data,
+    guint n_args,
+    const gint32* argv)
+{
+    const gint32 req_code = mtk_radio_ext_req_code_for(self, req_id);
+    const gint32 resp_code = mtk_radio_ext_resp_code_for(self, resp_id);
+    GBinderLocalRequest* args;
+    GBinderWriter writer;
+    MtkRadioExtRequest* req;
+    guint i, id;
+
+    if (!self || req_code < 0 || resp_code < 0 ||
+        self->iface_type != MTK_RADIO_IFACE_AIDL) {
+        return 0;
+    }
+
+    req = mtk_radio_ext_request_alloc(self, resp_code, handler, destroy,
+        user_data, req_size);
+    /* Both request types keep their completion right after the base */
+    ((MtkRadioExtResultRequest*)req)->complete =
+        (MtkRadioExtResultFunc)complete;
+    id = req->id;
+
+    args = gbinder_client_new_request2(self->client, req_code);
+    gbinder_local_request_init_writer(args, &writer);
+    gbinder_writer_append_int32(&writer, id);
+    for (i = 0; i < n_args; i++) {
+        gbinder_writer_append_int32(&writer, argv[i]);
+    }
+    if (self->iface && self->iface->client_id >= 0) {
+        gbinder_writer_append_int32(&writer, self->iface->client_id);
+    }
+    mtk_radio_ext_submit_request(req, req_code, id, MTK_AIDL_IMS, args);
+    gbinder_local_request_unref(args);
+    if (req->tx) {
+        return id;
+    }
+    g_hash_table_remove(self->requests, KEY(id));
+    return 0;
+}
+
+guint
+mtk_radio_ext_get_ims_cfg_resource_cap_value(
+    MtkRadioExt* self,
+    guint32 feature_id,
+    MtkRadioExtIntResultFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    const gint32 argv[] = { feature_id };
+
+    return mtk_radio_ext_int_args_request_submit(self,
+        MTK_RADIO_REQ_GET_IMS_CFG_RESOURCE_CAP_VALUE,
+        IMS_RADIO_RESP_GET_IMS_CFG_RESOURCE_CAP_VALUE,
+        mtk_radio_ext_int_response, sizeof(MtkRadioExtIntRequest),
+        G_CALLBACK(complete), destroy, user_data, G_N_ELEMENTS(argv), argv);
+}
+
+guint
+mtk_radio_ext_set_voice_domain_preference(
+    MtkRadioExt* self,
+    guint32 vdp,
+    MtkRadioExtResultFunc complete,
+    GDestroyNotify destroy,
+    void* user_data)
+{
+    const gint32 argv[] = { vdp };
+
+    return mtk_radio_ext_int_args_request_submit(self,
+        MTK_RADIO_REQ_SET_VOICE_DOMAIN_PREFERENCE,
+        IMS_RADIO_RESP_SET_VOICE_DOMAIN_PREFERENCE,
+        mtk_radio_ext_result_response, sizeof(MtkRadioExtResultRequest),
+        G_CALLBACK(complete), destroy, user_data, G_N_ELEMENTS(argv), argv);
+}
