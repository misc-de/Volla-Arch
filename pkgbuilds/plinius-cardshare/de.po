#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Eine Visitenkarte ist angekommen"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Zu Kontakten hinzufügen"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Bluetooth ist nicht verfügbar"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Bluetooth ist aus"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Visitenkarte"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Verwerfen"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "NFC ist nicht verfügbar"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "NFC ist nicht verfügbar, der QR-Code geht trotzdem"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Noch keine Karte gewählt. Wähle deine unter Einstellungen › NFC › Visitenkarte."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Visitenkarte wird geteilt"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "Das Adressbuch der Karte gibt es nicht mehr"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "Den Kontakt der Karte gibt es nicht mehr. Wähle ihn in den Einstellungen neu."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Diese Karte ist nicht mehr da"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Entsperre zuerst das Telefon"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Kontakt ohne Namen"
