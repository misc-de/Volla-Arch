#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Ha llegado una tarjeta de contacto"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Añadir a Contactos"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Bluetooth no está disponible"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Bluetooth está desactivado"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Tarjeta de contacto"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Descartar"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "NFC no está disponible"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "NFC no está disponible, el código QR sigue funcionando"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Aún no has elegido una tarjeta. Elige la tuya en Configuración › NFC › Tarjeta de contacto."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Compartiendo una tarjeta de contacto"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "La libreta de direcciones de la tarjeta ya no existe"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "El contacto de la tarjeta ya no existe. Elígelo de nuevo en Configuración."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Esta tarjeta ya no está"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Desbloquea primero el teléfono"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Contacto sin nombre"
