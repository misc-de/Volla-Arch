#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Er is een visitekaartje binnengekomen"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Toevoegen aan Contacten"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Bluetooth is niet beschikbaar"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Bluetooth staat uit"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Visitekaartje"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Negeren"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "NFC is niet beschikbaar"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "NFC is niet beschikbaar, de QR-code werkt wel"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Nog geen kaartje gekozen. Kies het jouwe in Instellingen › NFC › Visitekaartje."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Visitekaartje wordt gedeeld"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "Het adresboek van het kaartje bestaat niet meer"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "Het contact van het kaartje bestaat niet meer. Kies het opnieuw in Instellingen."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Dit kaartje is er niet meer"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Ontgrendel eerst de telefoon"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Contact zonder naam"
