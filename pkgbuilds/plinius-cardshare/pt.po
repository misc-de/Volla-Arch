#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Chegou um cartão de visita"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Adicionar aos contactos"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "O Bluetooth não está disponível"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "O Bluetooth está desligado"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Cartão de visita"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Descartar"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "O NFC não está disponível"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "O NFC não está disponível, o código QR continua a funcionar"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Ainda não escolheu um cartão. Escolha o seu em Definições › NFC › Cartão de visita."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "A partilhar um cartão de visita"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "O livro de endereços do cartão já não existe"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "O contacto do cartão já não existe. Escolha-o de novo nas Definições."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Este cartão já não está disponível"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Desbloqueie primeiro o telemóvel"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Contacto sem nome"
