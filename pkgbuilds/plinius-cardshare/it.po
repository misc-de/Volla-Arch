#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "È arrivato un biglietto da visita"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Aggiungi ai contatti"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Bluetooth non è disponibile"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Bluetooth è spento"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Biglietto da visita"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Scarta"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "NFC non è disponibile"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "NFC non è disponibile, il codice QR funziona comunque"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Nessun biglietto scelto. Scegli il tuo in Impostazioni › NFC › Biglietto da visita."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Condivisione di un biglietto da visita"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "La rubrica del biglietto non esiste più"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "Il contatto del biglietto non esiste più. Sceglilo di nuovo nelle Impostazioni."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Questo biglietto non c’è più"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Sblocca prima il telefono"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Contatto senza nome"
