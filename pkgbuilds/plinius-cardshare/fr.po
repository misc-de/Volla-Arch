#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Une carte de visite est arrivée"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Ajouter aux contacts"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Le Bluetooth n’est pas disponible"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Le Bluetooth est désactivé"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Carte de visite"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Ignorer"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "Le NFC n’est pas disponible"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "Le NFC n’est pas disponible, le code QR fonctionne quand même"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Aucune carte choisie. Choisissez la vôtre dans Paramètres › NFC › Carte de visite."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Partage d’une carte de visite"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "Le carnet d’adresses de la carte n’existe plus"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "Le contact de la carte n’existe plus. Choisissez-le à nouveau dans les Paramètres."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Cette carte n’est plus là"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Déverrouillez d’abord le téléphone"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Contact sans nom"
