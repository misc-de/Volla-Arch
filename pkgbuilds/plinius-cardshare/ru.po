#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Пришла визитка"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Добавить в контакты"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Bluetooth недоступен"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Bluetooth выключен"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Визитка"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Отклонить"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "NFC недоступен"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "NFC недоступен, QR-код всё равно работает"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Визитка ещё не выбрана. Выберите её в Настройки › NFC › Визитка."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Передача визитки"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "Адресной книги визитки больше нет"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "Контакта визитки больше нет. Выберите его заново в настройках."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Этой визитки больше нет"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Сначала разблокируйте телефон"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Контакт без имени"
