#: plinius-cardshare.py
msgid "A contact card came in"
msgstr "Przyszła wizytówka"

#: plinius-cardshare.py
msgid "Add to Contacts"
msgstr "Dodaj do kontaktów"

#: plinius-cardshare.py
msgid "Bluetooth is not available"
msgstr "Bluetooth jest niedostępny"

#: plinius-cardshare.py
msgid "Bluetooth is off"
msgstr "Bluetooth jest wyłączony"

#: plinius-cardshare.py
msgid "Contact Card"
msgstr "Wizytówka"

#: plinius-cardshare.py
msgid "Dismiss"
msgstr "Odrzuć"

#: plinius-cardshare.py
msgid "NFC is not available"
msgstr "NFC jest niedostępne"

#: plinius-cardshare.py
msgid "NFC is not available, the QR code still works"
msgstr "NFC jest niedostępne, kod QR nadal działa"

#: plinius-cardshare.py
msgid "No card chosen yet. Choose yours in Settings › NFC › Contact Card."
msgstr "Nie wybrano jeszcze wizytówki. Wybierz swoją w Ustawienia › NFC › Wizytówka."

#: plinius-cardshare.py
msgid "Sharing a contact card"
msgstr "Udostępnianie wizytówki"

#: plinius-cardshare.py
msgid "The address book of the card is gone"
msgstr "Książka adresowa wizytówki już nie istnieje"

#: plinius-cardshare.py
msgid "The contact of the card is gone. Choose it again in Settings."
msgstr "Kontakt wizytówki już nie istnieje. Wybierz go ponownie w Ustawieniach."

#: plinius-cardshare.py
msgid "This card is no longer there"
msgstr "Tej wizytówki już nie ma"

#: plinius-cardshare.py
msgid "Unlock the phone first"
msgstr "Najpierw odblokuj telefon"

#: plinius-cardshare.py
msgid "Unnamed contact"
msgstr "Kontakt bez nazwy"
