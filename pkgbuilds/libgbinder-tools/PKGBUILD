# Maintainer: misc-de <misc-de@users.noreply.github.com>

# The command line tools of libgbinder (binder-list, binder-ping, binder-call, binder-bridge), as
# Sailfish OS packages them; Arch's libgbinder ships the library only. Same version as that one.
# For checking from the host which Android binder services answer (docs/ROADMAP.md, phase 3).
pkgname=libgbinder-tools
pkgver=1.1.55
pkgrel=1
pkgdesc="Command line tools for Android binder (binder-list, binder-ping, binder-call)"
arch=(aarch64 x86_64)
url="https://github.com/mer-hybris/libgbinder"
license=(BSD-3-Clause)
# Linked against libgbinder.so.1 of the same version (Arch's libgbinder)
depends=(glib2 libglibutil "libgbinder=$pkgver")
_commit=84a423f5cff57abac5f39403619bc1e9faa28ccc
source=("git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
	cd libgbinder
	# The tools link against the library built in the tree
	make KEEP_SYMBOLS=1 release
	make -C tools KEEP_SYMBOLS=1 release
}

package() {
	cd libgbinder
	make -C tools DESTDIR="$pkgdir" install
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
