[Unit]
Description=Set up the kernel of a new system (plinius-kernel)
# A new system whose package kernel is not set up yet
ConditionPathExists=!/var/lib/plinius-kernel/installed
After=multi-user.target

[Service]
# simple, not oneshot: writing the boot partition and the card must not hold up the start
Type=simple
ExecStart=/usr/lib/plinius/kernel/plinius-kernel-install boot
# While it writes boot<slot> and the card it ignores SIGTERM; a restart then waits for the end
# (64 MiB to the boot partition, about 40 MiB to the card) instead of cutting it off
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
