# A new kernel of plinius-kernel: straight into the boot partition of the active slot (or the boot
# menu entry of an Arch on the memory card), the previous one kept as the fallback
# (plinius-kernel-install).
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/plinius/kernel/*/boot.img

[Action]
Description = Setting up the new kernel...
When = PostTransaction
Exec = /usr/lib/plinius/kernel/plinius-kernel-install hook
NeedsTargets
