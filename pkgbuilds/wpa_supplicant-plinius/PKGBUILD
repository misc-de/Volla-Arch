# Maintainer: misc-de <misc-de@users.noreply.github.com>
# Based on Arch's wpa_supplicant 2:2.12-2 (Morten Linderud, Bartłomiej Piotrowski,
# Thomas Bächler, loqs); patches 0001-0008 and wpa_supplicant_config are taken from there.

pkgname=wpa_supplicant-plinius
pkgver=2.12
pkgrel=5
epoch=2
pkgdesc="wpa_supplicant with a hotspot that MediaTek WLAN drivers accept"
arch=(aarch64)
url="https://w1.fi/wpa_supplicant/"
license=(BSD-3-Clause)
depends=(glibc libdbus libnl openssl pcsclite readline)
makedepends=(docbook-sgml docbook-utils git perl-sgmls)
# Why not wpa_supplicant from ALARM: NetworkManager offers WPA-PSK-SHA256 next to WPA-PSK
# for every WPA-PSK hotspot, also with PMF disabled. Stations then pick PSK-SHA256 and the
# Volla's WLAN driver (MediaTek gen4m) rejects every association with status 43 (invalid
# AKMP). Patch 0009 offers plain PSK in AP mode when PMF is off (docs/HARDWARE.md, Hotspot).
provides=("wpa_supplicant=$epoch:$pkgver")
conflicts=(wpa_supplicant)
# Commit of tag hostap_2_12: a tag can be moved later, a commit hash cannot
_commit=831364bf02710ad09c2f27d3efa92abeeb5634c0
source=(
	"git+https://git.w1.fi/hostap.git#commit=$_commit"
	wpa_supplicant_config
	0001-Enable-TLSv1.0-by-default.patch
	0002-Disable-Werror-for-eapol_test.patch
	0003-Allow-legacy-renegotiation-to-fix-PEAP-issues-with-s.patch
	0004-Tweak-D-Bus-systemd-service-activation-configuration.patch
	0005-Add-IgnoreOnIsolate-yes-to-keep-wpa-supplicant-runni.patch
	0006-Add-reload-support-to-the-systemd-unit-files.patch
	0007-nl80211-add-extra-ies-only-if-allowed-by-driver.patch
	0008-Revert-Mark-authorization-completed-on-driver-indica.patch
	0009-AP-No-PSK-SHA256-without-PMF.patch
	10-plinius-sandbox.conf
)
