<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The switches "Allowed Networks" in GNOME Settings › System › Desktop over VNC run
     pkexec /usr/lib/plinius-desktop/plinius-desktop-set allow|deny usb|local; argv1 picks the action. -->
<policyconfig>
  <vendor>Plinius</vendor>

  <!-- Opening the desktop to one more network: an administrator's PIN, every time (auth_admin, not
       _keep). The switch is for the whole phone, so an account without administrator rights
       must not open it for the others with its own PIN (attack review 2026-11-18, L15). The
       phone's first user is an administrator and confirms with its own PIN, as before. -->
  <action id="org.plinius.desktop.allow">
    <description>Allow desktop connections from a network</description>
    <message>Authentication is required to allow desktop connections from more networks</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/plinius-desktop/plinius-desktop-set</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">allow</annotate>
  </action>

  <!-- Closing a network only makes the phone safer: no password -->
  <action id="org.plinius.desktop.deny">
    <description>Stop desktop connections from a network</description>
    <message>Authentication is required to stop desktop connections from a network</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/plinius-desktop/plinius-desktop-set</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">deny</annotate>
  </action>
</policyconfig>
