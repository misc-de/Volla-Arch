build() {
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

package() {
	local lib=$pkgdir/usr/lib/plinius-desktop
	install -Dm755 -t "$lib" plinius-desktop-session plinius-desktop-keys plinius-desktop-set \
		desk-apps.py desk-apps-toggle desk-battery.py desk-network.py desk-settings.py \
		battery-status.sh wifi-status.sh fullscreen.sh
	install -Dm644 -t "$lib" desk_common.py
	install -Dm644 -t "$pkgdir/usr/share/plinius-desktop" waybar.jsonc waybar.css
	install -Dm644 -t "$pkgdir/usr/lib/systemd/user" plinius-desktop.socket plinius-desktop.service \
		plinius-desktop-cast.service
	install -Dm644 -t "$pkgdir/usr/lib/systemd/system" plinius-desktop-firewall.service
	# Enabled by the package: without it, a reboot would leave the port without firewall rules
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-desktop-firewall.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	install -Dm644 plinius-desktop.conf "$pkgdir/etc/plinius-desktop.conf"
	install -Dm644 -t "$pkgdir/usr/share/polkit-1/actions" org.plinius.desktop.policy
	# The bar's edge (org.plinius.desktop), set in GNOME Settings › Remote Access
	install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas" 50-plinius-desktop.gschema.override \
		org.plinius.desktop.gschema.xml
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-desktop.mo"
	done
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
