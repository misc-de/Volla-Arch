# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-desktop
pkgver=0.1
pkgrel=18
pkgdesc="A desktop on another computer's screen over VNC or on a TV, in the phone's own session: Phosh stays on the phone"
arch=(any)
license=(MIT)
# phoc makes the screen on request (0024), wayvnc checks the login through plinius-pinguard.
# The switches are in gnome-control-center-plinius (the panel Desktop over VNC).
# The desktop on a TV (0.1-17): plinius-desktop-cast.service makes the same screen without a VNC
# server; Schwupp starts it from the cast quick setting and shares the screen with the TV. VNC
# and TV show one desktop, the first session to end ends it for both (phoc has one virtual
# screen). The screen's name moved to $XDG_RUNTIME_DIR/plinius-desktop-screen, which outlives
# the VNC session's runtime directory.
depends=(bash glib2 gtk-layer-shell gtk3 iptables libpulse networkmanager openssl
	'phoc-plinius>=0.59.0-7' python python-cairo python-gobject systemd upower waybar
	'wayvnc-plinius>=0.10.2-1' wlr-randr wtype)
makedepends=(gettext)
backup=(etc/plinius-desktop.conf)
install=plinius-desktop.install
_langs=(de es fr it nl pl pt ru)
source=(plinius-desktop-session
	plinius-desktop-keys
	plinius-desktop-set
	desk_common.py
	desk-apps.py
	desk-apps-toggle
	desk-battery.py
	desk-network.py
	desk-settings.py
	battery-status.sh
	wifi-status.sh
	fullscreen.sh
	waybar.jsonc
	waybar.css
	plinius-desktop.socket
	plinius-desktop.service
	plinius-desktop-cast.service
	plinius-desktop-firewall.service
	plinius-desktop.conf
	org.plinius.desktop.policy
	50-plinius-desktop.gschema.override
	org.plinius.desktop.gschema.xml
	"${_langs[@]/%/.po}"
	LICENSE)
