+++ b/plugins/cast-quick-setting/meson.build
@@ -0,0 +1,48 @@
+# Plinius: mirror the screen to a TV through Schwupp (de.cais.Schwupp.Cast1)
+name = 'cast-quick-setting'
+
+cast_quick_setting_resources = gnome.compile_resources(
+  'phosh-plugin-cast-quick-setting-resources',
+  'phosh-plugin-cast-quick-setting.gresources.xml',
+  c_name: 'phosh_plugin_cast_quick_setting',
+)
+
+cast_quick_setting_plugin_sources = files(
+  'cast-quick-setting.c',
+  'phosh-plugin-cast-quick-setting.c',
+)
+
+phosh_cast_quick_setting_plugin = shared_module(
+  'phosh-plugin-cast-quick-setting',
+  cast_quick_setting_plugin_sources,
+  cast_quick_setting_resources,
+  c_args: [
+    '-DG_LOG_DOMAIN="phosh-plugin-@0@"'.format(name),
+    '-DPLUGIN_NAME="@0@"'.format(name),
+  ],
+  dependencies: plugin_dep,
+  install: true,
+  install_dir: plugins_dir,
+)
+
+pluginconf = configuration_data()
+pluginconf.set('name', name)
+pluginconf.set('plugins_dir', plugins_dir)
+
+i18n.merge_file(
+  input: configure_file(
+    input: name + '.desktop.in.in',
+    output: name + '.desktop.in',
+    configuration: pluginconf,
+  ),
+  output: name + '.plugin',
+  po_dir: meson.project_source_root() / 'po',
+  install: true,
+  install_dir: plugins_dir,
+  type: 'desktop',
+)
+
+install_data(
+  'icons/cast-quick-setting-symbolic.svg',
+  install_dir: phosh_plugin_icon_dir,
+)
diff --git a/plugins/cast-quick-setting/phosh-plugin-cast-quick-setting.c b/plugins/cast-quick-setting/phosh-plugin-cast-quick-setting.c
new file mode 100644
index 00000000..93fedbf7
--- /dev/null
+++ b/plugins/cast-quick-setting/phosh-plugin-cast-quick-setting.c
@@ -0,0 +1,39 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Based on the location quick setting plugin
+ */
+
+#include "cast-quick-setting.h"
+#include "phosh-plugin.h"
+
+#include <gio/gio.h>
+#include <gtk/gtk.h>
+
