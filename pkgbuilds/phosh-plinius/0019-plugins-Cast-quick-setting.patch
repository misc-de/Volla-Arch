diff --git a/plugins/cast-quick-setting/qs.ui b/plugins/cast-quick-setting/qs.ui
new file mode 100644
index 00000000..98ab9fe6
--- /dev/null
+++ b/plugins/cast-quick-setting/qs.ui
@@ -0,0 +1,100 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<interface>
+  <requires lib="gtk+" version="3.24"/>
+  <template class="PhoshCastQuickSetting" parent="PhoshQuickSetting">
+    <property name="status-icon">info</property>
+    <property name="status-page">status_page</property>
+    <signal name="clicked" handler="on_clicked" object="PhoshCastQuickSetting" swapped="yes"/>
+    <signal name="long-pressed" handler="on_settings_clicked" object="PhoshCastQuickSetting" swapped="yes"/>
+  </template>
+  <object class="PhoshStatusIcon" id="info">
+    <property name="visible">1</property>
+    <property name="pixel-size">16</property>
+    <property name="icon-name">cast-symbolic</property>
+    <property name="info" translatable="yes">Cast</property>
+  </object>
+  <object class="PhoshStatusPage" id="status_page">
+    <property name="visible">1</property>
+    <property name="title" translatable="yes">Cast</property>
+    <property name="header">spinner</property>
+    <property name="content">content</property>
+    <property name="footer">footer</property>
+    <signal name="map" handler="on_status_page_map" object="PhoshCastQuickSetting" swapped="yes"/>
+    <signal name="unmap" handler="on_status_page_unmap" object="PhoshCastQuickSetting" swapped="yes"/>
+  </object>
+  <object class="GtkSpinner" id="spinner">
+    <property name="visible">1</property>
+    <property name="margin-start">4</property>
+    <property name="margin-top">4</property>
+    <property name="margin-end">4</property>
+    <property name="margin-bottom">4</property>
+  </object>
+  <object class="GtkBox" id="content">
+    <property name="visible">1</property>
+    <property name="orientation">vertical</property>
+    <property name="spacing">12</property>
+    <child>
+      <object class="GtkStack" id="stack">
+        <property name="visible">1</property>
+        <property name="transition-type">crossfade</property>
+        <property name="vhomogeneous">0</property>
+        <child>
+          <object class="PhoshStatusPagePlaceholder" id="placeholder">
+            <property name="visible">1</property>
+            <property name="icon-name">cast-symbolic</property>
+          </object>
+          <packing>
+            <property name="name">empty</property>
+          </packing>
+        </child>
+        <child>
+          <object class="GtkListBox" id="list_box">
+            <property name="visible">1</property>
+            <property name="selection-mode">none</property>
+            <property name="hexpand">1</property>
+            <signal name="row-activated" handler="on_row_activated" object="PhoshCastQuickSetting" swapped="yes"/>
+            <style>
+              <class name="content"/>
+            </style>
+          </object>
+          <packing>
+            <property name="name">list</property>
+          </packing>
+        </child>
+      </object>
+    </child>
+    <!-- AirPlay: the code the TV shows on the first connection -->
+    <child>
+      <object class="GtkEntry" id="pin_entry">
+        <property name="visible">0</property>
+        <property name="input-purpose">digits</property>
+        <property name="placeholder-text" translatable="yes">Code shown on the TV</property>
+        <signal name="activate" handler="on_pin_activate" object="PhoshCastQuickSetting" swapped="yes"/>
+      </object>
+    </child>
+    <child>
+      <object class="GtkLabel" id="error_label">
+        <property name="visible">0</property>
+        <property name="wrap">1</property>
+        <property name="xalign">0</property>
+        <property name="selectable">1</property>
+        <style>
+          <class name="dim-label"/>
+        </style>
+      </object>
+    </child>
+  </object>
+  <object class="GtkButton" id="footer">
+    <property name="visible">1</property>
+    <property name="hexpand">1</property>
+    <property name="focus-on-click">0</property>
+    <signal name="clicked" handler="on_settings_clicked" object="PhoshCastQuickSetting" swapped="yes"/>
+    <child>
+      <object class="GtkLabel">
+        <property name="visible">1</property>
+        <property name="ellipsize">end</property>
+        <property name="label" translatable="yes">Cast Settings</property>
+      </object>
+    </child>
+  </object>
+</interface>
