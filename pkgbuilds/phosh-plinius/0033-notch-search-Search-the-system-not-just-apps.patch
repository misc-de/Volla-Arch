+/* Search providers */
+
+static int
+strv_index (GStrv strv, const char *str)
+{
+  for (int i = 0; strv && strv[i]; i++) {
+    if (g_str_equal (strv[i], str))
+      return i;
+  }
+  return -1;
 }
 
 
+static int
+compare_providers (gconstpointer a, gconstpointer b)
+{
+  const Provider *pa = *(Provider **)a;
+  const Provider *pb = *(Provider **)b;
+
+  if (pa->order != pb->order)
+    return pa->order < pb->order ? -1 : 1;
+
+  return g_utf8_collate (g_app_info_get_display_name (G_APP_INFO (pa->app)),
+                         g_app_info_get_display_name (G_APP_INFO (pb->app)));
+}
+
+
+/* The providers like GNOME Shell finds them: a key file each in
+ * $XDG_DATA_DIRS/gnome-shell/search-providers, switched on and ordered in GNOME Settings */
 static void
-on_row_activated (PhoshNotchSearch *self, GtkListBoxRow *row)
+load_providers (PhoshNotchSearch *self)
 {
-  launch_app (self, g_object_get_data (G_OBJECT (row), "app-info"));
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = NULL;
+  g_autoptr (GPtrArray) dirs = g_ptr_array_new ();
+  g_autoptr (GHashTable) seen = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, NULL);
+  g_auto (GStrv) enabled = NULL;
+  g_auto (GStrv) disabled = NULL;
+  g_auto (GStrv) sort_order = NULL;
+  const char * const *system_dirs = g_get_system_data_dirs ();
+
+  schema = source ? g_settings_schema_source_lookup (source, SEARCH_PROVIDERS_SCHEMA, TRUE) : NULL;
+  if (schema) {
+    g_autoptr (GSettings) settings = g_settings_new (SEARCH_PROVIDERS_SCHEMA);
+
+    if (g_settings_get_boolean (settings, "disable-external"))
+      return;
+
+    enabled = g_settings_get_strv (settings, "enabled");
+    disabled = g_settings_get_strv (settings, "disabled");
+    sort_order = g_settings_get_strv (settings, "sort-order");
+  }
+
+  g_ptr_array_add (dirs, (gpointer) g_get_user_data_dir ());
+  for (int i = 0; system_dirs[i]; i++)
+    g_ptr_array_add (dirs, (gpointer) system_dirs[i]);
+
+  for (guint i = 0; i < dirs->len; i++) {
+    g_autofree char *path = g_build_filename (g_ptr_array_index (dirs, i),
+                                              "gnome-shell", "search-providers", NULL);
+    g_autoptr (GDir) dir = g_dir_open (path, 0, NULL);
+    const char *name;
+
+    while (dir && (name = g_dir_read_name (dir))) {
+      g_autoptr (GKeyFile) keyfile = g_key_file_new ();
+      g_autofree char *file = g_build_filename (path, name, NULL);
+      g_autofree char *desktop_id = NULL, *bus_name = NULL, *object_path = NULL;
+      g_autoptr (GDesktopAppInfo) app = NULL;
+      gboolean default_disabled;
+      Provider *provider;
+      int order;
+
+      if (!g_str_has_suffix (name, ".ini") ||
+          !g_key_file_load_from_file (keyfile, file, G_KEY_FILE_NONE, NULL))
+        continue;
+
+      desktop_id = g_key_file_get_string (keyfile, SEARCH_PROVIDER_GROUP, "DesktopId", NULL);
+      bus_name = g_key_file_get_string (keyfile, SEARCH_PROVIDER_GROUP, "BusName", NULL);
+      object_path = g_key_file_get_string (keyfile, SEARCH_PROVIDER_GROUP, "ObjectPath", NULL);
+      if (!desktop_id || !bus_name || !object_path ||
+          g_key_file_get_integer (keyfile, SEARCH_PROVIDER_GROUP, "Version", NULL) < 2 ||
+          !g_dbus_is_name (bus_name) || !g_variant_is_object_path (object_path))
+        continue;
+
+      /* The user's own files come first and hide the system's */
+      if (g_hash_table_contains (seen, desktop_id))
+        continue;
+      g_hash_table_add (seen, g_strdup (desktop_id));
+
+      app = g_desktop_app_info_new (desktop_id);
+      if (!app || !g_app_info_should_show (G_APP_INFO (app)))
+        continue;
+
+      default_disabled = g_key_file_get_boolean (keyfile, SEARCH_PROVIDER_GROUP,
+                                                 "DefaultDisabled", NULL);
+      if (default_disabled ? strv_index (enabled, desktop_id) < 0 :
+                             strv_index (disabled, desktop_id) >= 0)
+        continue;
+
+      order = strv_index (sort_order, desktop_id);
+
+      provider = g_new0 (Provider, 1);
+      provider->self = self;
+      provider->app = g_steal_pointer (&app);
+      provider->bus_name = g_steal_pointer (&bus_name);
+      provider->object_path = g_steal_pointer (&object_path);
+      provider->order = order < 0 ? G_MAXINT : order;
+      provider->autostart = TRUE;
+      if (g_key_file_has_key (keyfile, SEARCH_PROVIDER_GROUP, "AutoStart", NULL))
+        provider->autostart = g_key_file_get_boolean (keyfile, SEARCH_PROVIDER_GROUP,
+                                                      "AutoStart", NULL);
+      g_ptr_array_add (self->providers, provider);
+      g_debug ("Search provider %s (%s)", desktop_id, provider->bus_name);
+    }
+  }
+
+  g_ptr_array_sort (self->providers, compare_providers);
+}
+
+
+static void
+provider_call (Provider           *provider,
+               const char         *method,
+               GVariant           *parameters,
+               const GVariantType *reply_type,
+               GCancellable       *cancellable,
+               GAsyncReadyCallback callback,
+               gpointer            user_data)
+{
+  g_dbus_connection_call (provider->self->bus,
+                          provider->bus_name,
+                          provider->object_path,
+                          SEARCH_PROVIDER_IFACE,
+                          method,
+                          parameters,
+                          reply_type,
+                          provider->autostart ? G_DBUS_CALL_FLAGS_NONE :
+                                                G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                          PROVIDER_TIMEOUT,
+                          cancellable,
+                          callback,
+                          user_data);
+}
+
+
+/* Hide a provider's results, the header row stays for the next ones */
+static void
+provider_clear (Provider *provider)
+{
+  g_autoptr (GList) rows = gtk_container_get_children (GTK_CONTAINER (provider->list));
+
+  for (GList *l = rows; l; l = l->next) {
+    if (!g_object_get_data (l->data, "header"))
+      gtk_widget_destroy (l->data);
+  }
+
+  gtk_widget_set_visible (provider->list, FALSE);
+}
