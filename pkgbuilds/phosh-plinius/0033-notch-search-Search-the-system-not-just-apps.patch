+/* A result's icon: GNOME Shell takes "icon", then "gicon", then "icon-data" */
+static GIcon *
+meta_icon (GVariantDict *meta)
+{
+  g_autoptr (GVariant) serialized = g_variant_dict_lookup_value (meta, "icon", NULL);
+  g_autoptr (GVariant) data = NULL;
+  g_autoptr (GVariant) pixels = NULL;
+  g_autoptr (GBytes) bytes = NULL;
+  const char *gicon;
+  int width, height, rowstride, bits, channels;
+  gboolean has_alpha;
+  gsize len;
+
+  if (serialized) {
+    GIcon *icon = g_icon_deserialize (serialized);
+
+    if (icon)
+      return icon;
+  }
+
+  if (g_variant_dict_lookup (meta, "gicon", "&s", &gicon)) {
+    GIcon *icon = g_icon_new_for_string (gicon, NULL);
+
+    if (icon)
+      return icon;
+  }
+
+  data = g_variant_dict_lookup_value (meta, "icon-data", G_VARIANT_TYPE ("(iiibiiay)"));
+  if (!data)
+    return NULL;
+
+  g_variant_get (data, "(iiibii@ay)", &width, &height, &rowstride, &has_alpha, &bits, &channels,
+                 &pixels);
+  len = g_variant_get_size (pixels);
+  /* Only what GdkPixbuf can take: 8 bit RGB(A), all rows inside the data */
+  if (width <= 0 || height <= 0 || bits != 8 || channels != (has_alpha ? 4 : 3) ||
+      rowstride < width * channels ||
+      len < (gsize) rowstride * (height - 1) + (gsize) width * channels)
+    return NULL;
+
+  bytes = g_variant_get_data_as_bytes (pixels);
+  return G_ICON (gdk_pixbuf_new_from_bytes (bytes, GDK_COLORSPACE_RGB, has_alpha, bits,
+                                            width, height, rowstride));
+}
+
+
+static GtkWidget *
+create_result_row (Provider *provider, const char *id, GVariant *meta_variant)
+{
+  GVariantDict meta;
+  g_autoptr (GIcon) icon = NULL;
+  const char *name = NULL, *description = NULL;
+  GtkWidget *row;
+
+  g_variant_dict_init (&meta, meta_variant);
+  g_variant_dict_lookup (&meta, "name", "&s", &name);
+  g_variant_dict_lookup (&meta, "description", "&s", &description);
+
+  icon = meta_icon (&meta);
+  if (!icon && g_app_info_get_icon (G_APP_INFO (provider->app)))
+    icon = g_object_ref (g_app_info_get_icon (G_APP_INFO (provider->app)));
+
+  row = create_row (icon, ICON_SIZE, name ?: id, description);
+  g_object_set_data_full (G_OBJECT (row), "result-id", g_strdup (id), g_free);
+  g_variant_dict_clear (&meta);
+
+  return row;
+}
+
+
+typedef struct {
+  Provider *provider;   /* valid unless the call was cancelled */
+  GStrv     ids;
+} MetasCall;
+
+
+static void
+on_result_metas (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  MetasCall *call = user_data;
+  g_auto (GStrv) ids = call->ids;
+  Provider *provider = call->provider;
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariant) metas = NULL;
+  g_autoptr (GHashTable) by_id = NULL;
+  guint n = 0;
+
+  g_free (call);
+
+  /* The search has moved on or closed, the provider may be gone */
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  provider_clear (provider);
+  if (!reply) {
+    g_debug ("%s: no result metas: %s", provider->bus_name, err->message);
+    update_scroller (provider->self);
+    return;
+  }
+
+  /* The metas may come in any order, the results keep the provider's */
+  by_id = g_hash_table_new_full (g_str_hash, g_str_equal, NULL, (GDestroyNotify) g_variant_unref);
+  metas = g_variant_get_child_value (reply, 0);
+  for (gsize i = 0; i < g_variant_n_children (metas); i++) {
+    GVariant *meta = g_variant_get_child_value (metas, i);
+    const char *id;
+
+    if (g_variant_lookup (meta, "id", "&s", &id))
+      g_hash_table_replace (by_id, (gpointer) id, meta);
+    else
+      g_variant_unref (meta);
+  }
+
+  for (int i = 0; ids[i]; i++) {
+    GVariant *meta = g_hash_table_lookup (by_id, ids[i]);
+
+    if (!meta)
+      continue;
+    gtk_container_add (GTK_CONTAINER (provider->list), create_result_row (provider, ids[i], meta));
+    n++;
+  }
+
+  gtk_widget_set_visible (provider->list, n > 0);
+  update_scroller (provider->self);
+}
+
+
+typedef struct {
+  Provider *provider;   /* valid unless the call was cancelled */
+  GStrv     terms;
+} SearchCall;
+
+
+static void
+on_result_set (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  SearchCall *call = user_data;
+  g_auto (GStrv) terms = call->terms;
+  Provider *provider = call->provider;
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  MetasCall *metas_call;
+  guint n;
+
+  g_free (call);
+
+  /* The search has moved on or closed, the provider may be gone */
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  if (!reply) {
+    g_debug ("%s: no results: %s", provider->bus_name, err->message);
+    /* E.g. Firefox: its provider only exists while Firefox runs */
+    if (g_error_matches (err, G_DBUS_ERROR, G_DBUS_ERROR_SERVICE_UNKNOWN) ||
+        g_error_matches (err, G_DBUS_ERROR, G_DBUS_ERROR_NAME_HAS_NO_OWNER))
+      provider->unavailable = TRUE;
+    provider_clear (provider);
+    update_scroller (provider->self);
+    return;
+  }
+
+  g_clear_pointer (&provider->result_set, g_strfreev);
+  g_variant_get (reply, "(^as)", &provider->result_set);
+  g_strfreev (provider->terms);
+  provider->terms = g_steal_pointer (&terms);
+
+  n = MIN (g_strv_length (provider->result_set), MAX_PROVIDER_RESULTS);
+  if (n == 0) {
+    provider_clear (provider);
+    update_scroller (provider->self);
+    return;
+  }
+
+  /* The results so far stay until their successors are there, the list does not flicker */
+  metas_call = g_new0 (MetasCall, 1);
+  metas_call->provider = provider;
+  metas_call->ids = g_new0 (char *, n + 1);
+  for (guint i = 0; i < n; i++)
+    metas_call->ids[i] = g_strdup (provider->result_set[i]);
+
+  provider_call (provider, "GetResultMetas",
+                 g_variant_new ("(^as)", metas_call->ids),
+                 G_VARIANT_TYPE ("(aa{sv})"),
+                 provider->self->cancellable,
+                 on_result_metas,
+                 metas_call);
+}
+
+
+/* Whether @terms only narrow @previous down, so the provider can search its last results */
+static gboolean
+terms_narrow_down (GStrv previous, GStrv terms)
+{
+  if (!previous || !previous[0] || g_strv_length (terms) < g_strv_length (previous))
+    return FALSE;
+
+  for (int i = 0; previous[i]; i++) {
+    if (!g_str_has_prefix (terms[i], previous[i]))
+      return FALSE;
+  }
+  return TRUE;
+}
+
+
+static void
+provider_search (Provider *provider, GStrv terms)
+{
+  SearchCall *call = g_new0 (SearchCall, 1);
+  GVariant *parameters;
+  const char *method;
+
+  call->provider = provider;
+  call->terms = g_strdupv (terms);
+
+  if (provider->result_set && terms_narrow_down (provider->terms, terms)) {
+    method = "GetSubsearchResultSet";
+    parameters = g_variant_new ("(^as^as)", provider->result_set, terms);
+  } else {
+    method = "GetInitialResultSet";
+    parameters = g_variant_new ("(^as)", terms);
+  }
+
+  provider_call (provider, method, parameters, G_VARIANT_TYPE ("(as)"),
+                 provider->self->cancellable, on_result_set, call);
+}
+
+
+/* After the provider handled the activation: bring a window of its app to the front.
+ * A running app gets no activation token from the provider interface and stays behind
+ * otherwise; the window of a starting app gets the focus anyway. */
+static void
+on_result_activated (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GDesktopAppInfo) info = user_data;
+  PhoshToplevelManager *toplevel_manager;
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (!reply) {
+    g_warning ("Activating a result of %s failed: %s", g_app_info_get_id (G_APP_INFO (info)),
+               err->message);
+    return;
+  }
+
+  toplevel_manager = phosh_shell_get_toplevel_manager (phosh_shell_get_default ());
+  for (guint i = 0; i < phosh_toplevel_manager_get_num_toplevels (toplevel_manager); i++) {
+    PhoshToplevel *toplevel = phosh_toplevel_manager_get_toplevel (toplevel_manager, i);
+    g_autoptr (GDesktopAppInfo) toplevel_info =
+      phosh_get_desktop_app_info_for_app_id (phosh_toplevel_get_app_id (toplevel));
+
+    if (toplevel_info && g_app_info_equal (G_APP_INFO (toplevel_info), G_APP_INFO (info))) {
+      phosh_toplevel_activate (toplevel, phosh_wayland_get_wl_seat (phosh_wayland_get_default ()));
+      return;
+    }
+  }
+}
+
+
+/* A result opens in its app; without @id (the header) the app searches itself */
+static void
+activate_result (PhoshNotchSearch *self, Provider *provider, const char *id)
+{
+  const char * const no_terms[] = { NULL };
+  const char * const *terms = provider->terms ? (const char * const *) provider->terms : no_terms;
+  guint32 timestamp = gtk_get_current_event_time ();
+
+  g_debug ("Activating %s of %s", id ?: "the search", provider->bus_name);
+  provider_call (provider,
+                 id ? "ActivateResult" : "LaunchSearch",
+                 id ? g_variant_new ("(s^asu)", id, terms, timestamp) :
+                      g_variant_new ("(^asu)", terms, timestamp),
+                 NULL,
+                 NULL,
+                 on_result_activated,
+                 g_object_ref (provider->app));
+
+  g_signal_emit (self, signals[APP_LAUNCHED], 0, provider->app);
+  close_search (self);
+}
+
+
+static void
+on_provider_row_activated (GtkListBox *list, GtkListBoxRow *row, Provider *provider)
+{
+  activate_result (provider->self, provider, g_object_get_data (G_OBJECT (row), "result-id"));
+}
+
+
+/* A provider's section: its app as header, below it the results */
+static void
+provider_add_section (PhoshNotchSearch *self, Provider *provider, GtkContainer *box)
+{
+  GtkWidget *header;
+
+  provider->list = gtk_list_box_new ();
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (provider->list), GTK_SELECTION_NONE);
+  gtk_style_context_add_class (gtk_widget_get_style_context (provider->list), "provider");
+  gtk_widget_set_no_show_all (provider->list, TRUE);
+  g_signal_connect (provider->list, "row-activated", G_CALLBACK (on_provider_row_activated), provider);
+
+  header = create_row (g_app_info_get_icon (G_APP_INFO (provider->app)), HEADER_ICON_SIZE,
+                       g_app_info_get_display_name (G_APP_INFO (provider->app)), NULL);
+  gtk_style_context_add_class (gtk_widget_get_style_context (header), "provider-header");
+  g_object_set_data (G_OBJECT (header), "header", GINT_TO_POINTER (TRUE));
+  gtk_container_add (GTK_CONTAINER (provider->list), header);
+
+  gtk_container_add (box, provider->list);
+}
+
+/* The search */
+
+static void
+on_search_changed (PhoshNotchSearch *self)
+{
+  g_autofree char *text = g_strstrip (g_strdup (gtk_entry_get_text (GTK_ENTRY (self->entry))));
+  g_auto (GStrv) terms = g_strsplit_set (text, " \t\n", -1);
+  g_autoptr (GStrvBuilder) builder = g_strv_builder_new ();
+  g_auto (GStrv) words = NULL;
+
+  /* Answers to the last terms are of no use anymore */
+  g_cancellable_cancel (self->cancellable);
+  g_clear_object (&self->cancellable);
+
+  update_apps (self, text);
+
+  for (int i = 0; terms[i]; i++) {
+    if (terms[i][0])
+      g_strv_builder_add (builder, terms[i]);
+  }
+  words = g_strv_builder_end (builder);
+
+  if (words[0])
+    self->cancellable = g_cancellable_new ();
+
+  for (guint i = 0; i < self->providers->len; i++) {
+    Provider *provider = g_ptr_array_index (self->providers, i);
+
+    if (!words[0])
+      provider_clear (provider);
+    else if (!provider->unavailable && self->bus)
+      provider_search (provider, words);
+  }
+
+  update_scroller (self);
+}
+
+
+/* Enter: the best app, else the first result */
+static void
+on_entry_activated (PhoshNotchSearch *self)
+{
+  GtkListBoxRow *row = gtk_list_box_get_row_at_index (GTK_LIST_BOX (self->apps), 0);
+
+  if (row) {
+    launch_app (self, g_object_get_data (G_OBJECT (row), "app-info"));
+    return;
+  }
+
+  for (guint i = 0; i < self->providers->len; i++) {
+    Provider *provider = g_ptr_array_index (self->providers, i);
+
+    /* Row 0 is the header */
+    row = gtk_list_box_get_row_at_index (GTK_LIST_BOX (provider->list), 1);
+    if (row && gtk_widget_get_visible (provider->list)) {
+      activate_result (self, provider, g_object_get_data (G_OBJECT (row), "result-id"));
+      return;
+    }
+  }
 }
 
 
