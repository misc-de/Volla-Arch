From bdcccb8fd957a5df971655fea2b450fc71e280dc Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 14 Nov 2026 19:01:53 +0100
Subject: [PATCH 86/87] plugins: Long presses open the tile's own page in GNOME
 Settings

Plinius: a long press of the contact card tile (and its footer) opened a
panel "contact-card" that does not exist; it is a page of the NFC panel,
so the tile now opens Settings > NFC > Contact Card. The Desktop tile
opens the page "Desktop over VNC" instead of the Remote Access overview,
and the hotspot tile, which had no long press, opens the Wi-Fi panel with
the hotspot's page ("Turn On Wi-Fi Hotspot?"; gnome-control-center-plinius
0086), or with the running hotspot's facts.
---
 plugins/cardshare-quick-setting/qs.ui    | 4 ++--
 plugins/desktop-vnc-quick-setting/qs.ui  | 2 +-
 plugins/wifi-hotspot-quick-setting/qs.ui | 3 +++
 3 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/plugins/cardshare-quick-setting/qs.ui b/plugins/cardshare-quick-setting/qs.ui
index a6f13c4c..4bff60c1 100644
--- a/plugins/cardshare-quick-setting/qs.ui
+++ b/plugins/cardshare-quick-setting/qs.ui
@@ -7,7 +7,7 @@
     <signal name="clicked" handler="on_clicked" object="PhoshCardshareQuickSetting" swapped="yes"/>
     <!-- The Contact Card page of GNOME Settings: which contact, which fields -->
     <property name="long-press-action-name">panel.launch-panel</property>
-    <property name="long-press-action-target">(&quot;contact-card&quot;, [&lt;&quot;&quot;&gt;])</property>
+    <property name="long-press-action-target">(&quot;nfc&quot;, [&lt;&quot;contact-card&quot;&gt;])</property>
   </template>
   <object class="PhoshStatusIcon" id="info">
     <property name="visible">1</property>
@@ -202,7 +202,7 @@
     <property name="hexpand">1</property>
     <property name="focus-on-click">0</property>
     <property name="action-name">panel.launch-panel</property>
-    <property name="action-target">(&quot;contact-card&quot;, [&lt;&quot;&quot;&gt;])</property>
+    <property name="action-target">(&quot;nfc&quot;, [&lt;&quot;contact-card&quot;&gt;])</property>
     <child>
       <object class="GtkLabel">
         <property name="visible">1</property>
diff --git a/plugins/desktop-vnc-quick-setting/qs.ui b/plugins/desktop-vnc-quick-setting/qs.ui
index d5ff7c7e..54ed5fdc 100644
--- a/plugins/desktop-vnc-quick-setting/qs.ui
+++ b/plugins/desktop-vnc-quick-setting/qs.ui
@@ -6,7 +6,7 @@
     <signal name="clicked" handler="on_clicked" object="PhoshDesktopVncQuickSetting" swapped="yes"/>
     <!-- The page of GNOME Settings -->
     <property name="long-press-action-name">panel.launch-panel</property>
-    <property name="long-press-action-target">(&quot;desktop-vnc&quot;, [&lt;&quot;&quot;&gt;])</property>
+    <property name="long-press-action-target">(&quot;desktop-vnc&quot;, [&lt;&quot;plinius-vnc&quot;&gt;])</property>
   </template>
   <object class="PhoshStatusIcon" id="info">
     <property name="visible">1</property>
diff --git a/plugins/wifi-hotspot-quick-setting/qs.ui b/plugins/wifi-hotspot-quick-setting/qs.ui
index 039c2725..afb1a995 100644
--- a/plugins/wifi-hotspot-quick-setting/qs.ui
+++ b/plugins/wifi-hotspot-quick-setting/qs.ui
@@ -5,6 +5,9 @@
     <property name="status-icon">info</property>
     <property name="status-page">status_page</property>
     <signal name="clicked" handler="on_clicked" object="PhoshWifiHotspotQuickSetting" swapped="yes"/>
+    <!-- Plinius: the hotspot's page in GNOME Settings ("Turn On Wi-Fi Hotspot?") -->
+    <property name="long-press-action-name">panel.launch-panel</property>
+    <property name="long-press-action-target">(&quot;wifi&quot;, [&lt;&quot;hotspot&quot;&gt;])</property>
   </template>
   <object class="PhoshStatusIcon" id="info">
     <property name="visible">1</property>
