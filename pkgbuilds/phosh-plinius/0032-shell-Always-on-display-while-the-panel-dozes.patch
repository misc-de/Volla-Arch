diff --git a/src/monitor-manager.c b/src/monitor-manager.c
index c80cfff4..eb2854dc 100644
--- a/src/monitor-manager.c
+++ b/src/monitor-manager.c
@@ -86,6 +86,8 @@ typedef struct _PhoshMonitorManager
   uint32_t zwlr_output_serial;
 
   GCancellable            *cancel;
+
+  gboolean                 doze_allowed; /* Plinius: always-on display instead of off */
 } PhoshMonitorManager;
 
 G_DEFINE_TYPE_WITH_CODE (PhoshMonitorManager,
@@ -1680,10 +1682,46 @@ phosh_monitor_manager_set_power_save_mode (PhoshMonitorManager       *self,
 {
   g_return_if_fail (PHOSH_IS_MONITOR_MANAGER (self));
 
+  for (int i = 0; i < self->monitors->len; i++) {
+    PhoshMonitor *monitor = g_ptr_array_index (self->monitors, i);
+    PhoshMonitorPowerSaveMode m = mode;
+
+    /* Plinius: the built-in panel dozes as always-on display instead of going off */
+    if (m == PHOSH_MONITOR_POWER_SAVE_MODE_OFF && self->doze_allowed &&
+        phosh_monitor_is_builtin (monitor))
+      m = PHOSH_MONITOR_POWER_SAVE_MODE_DOZE;
+
+    phosh_monitor_set_power_save_mode (monitor, m);
+  }
+}
+
+/**
+ * phosh_monitor_manager_set_doze_allowed:
+ * @self: a #PhoshMonitorManager
+ * @allowed: Whether the built-in panel may doze
+ *
+ * Whether a built-in panel that is to go off shows the always-on display in a
+ * low-power mode instead (Plinius). Takes effect with the next power save mode.
+ * A dozing panel goes off right away when it is no longer allowed.
+ */
+void
+phosh_monitor_manager_set_doze_allowed (PhoshMonitorManager *self, gboolean allowed)
+{
+  g_return_if_fail (PHOSH_IS_MONITOR_MANAGER (self));
+
+  if (self->doze_allowed == allowed)
+    return;
+  self->doze_allowed = allowed;
+
+  if (allowed)
+    return;
+
   for (int i = 0; i < self->monitors->len; i++) {
     PhoshMonitor *monitor = g_ptr_array_index (self->monitors, i);
 
-    phosh_monitor_set_power_save_mode (monitor, mode);
+    if (phosh_monitor_is_configured (monitor) &&
+        phosh_monitor_get_power_save_mode (monitor) == PHOSH_MONITOR_POWER_SAVE_MODE_DOZE)
+      phosh_monitor_set_power_save_mode (monitor, PHOSH_MONITOR_POWER_SAVE_MODE_OFF);
   }
 }
 
