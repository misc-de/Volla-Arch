diff --git a/src/monitor/monitor.h b/src/monitor/monitor.h
index 30763dd8..530a2511 100644
--- a/src/monitor/monitor.h
+++ b/src/monitor/monitor.h
@@ -98,12 +98,15 @@ typedef struct _PhoshMonitorMode
  * PhoshMonitorPowerSaveMode:
  * @PHOSH_MONITOR_POWER_SAVE_MODE_ON: The monitor is on
  * @PHOSH_MONITOR_POWER_SAVE_MODE_OFF: The monitor is off (saving power)
+ * @PHOSH_MONITOR_POWER_SAVE_MODE_DOZE: The monitor shows the always-on display in a
+ *   low-power mode (Plinius). For the shell the screen is blanked then.
  *
  * The power save mode of a monitor
  */
 typedef enum _PhoshMonitorPowerSaveMode {
   PHOSH_MONITOR_POWER_SAVE_MODE_OFF = 0,
   PHOSH_MONITOR_POWER_SAVE_MODE_ON  = 1,
+  PHOSH_MONITOR_POWER_SAVE_MODE_DOZE = 2,
 } PhoshMonitorPowerSaveMode;
 
