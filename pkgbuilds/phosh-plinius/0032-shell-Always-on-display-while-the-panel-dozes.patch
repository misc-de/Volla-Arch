diff --git a/src/aod.c b/src/aod.c
new file mode 100644
index 00000000..5c038143
--- /dev/null
+++ b/src/aod.c
@@ -0,0 +1,337 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+/*
+ * PhoshAod: the always-on display (Plinius). While the built-in OLED dozes in its
+ * low-power mode (phoc's power mode "doze", MediaTek DOZE_ACTIVE), this black overlay
+ * shows the time, the date, the battery and the apps with notifications.
+ *
+ * Power: an OLED only spends power on lit pixels, so almost everything stays black and
+ * the text is grey. Nothing animates: phoc switches the CRTC off a second after the last
+ * frame and the panel keeps the picture on its own, so a new frame should only come
+ * once a minute with the clock. Against burn-in the content moves a little each minute.
+ *
+ * While it is shown, $XDG_RUNTIME_DIR/plinius-aod exists: plinius-suspend then wakes the
+ * phone at each full minute for the clock.
+ */
+
+#define G_LOG_DOMAIN "phosh-aod"
+
+#include "phosh-config.h"
+#include "aod.h"
+#include "battery-info.h"
+#include "layersurface-priv.h"
+#include "notifications/notify-manager.h"
+#include "notifications/notification-source.h"
+#include "shell-priv.h"
+#include "wall-clock-priv.h"
+
+#include <glib/gstdio.h>
+
+/* Most app icons shown before a "+N" */
+#define AOD_MAX_ICONS 5
+/* How far the content moves against burn-in, in logical pixels */
+#define AOD_SHIFT_X 24
+#define AOD_SHIFT_Y 40
+/* Where the content starts, as fraction of the height */
+#define AOD_TOP 0.22
+
+enum {
+  PROP_0,
+  PROP_MONITOR,
+  PROP_LAST_PROP,
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+struct _PhoshAod {
+  PhoshLayerSurface      parent;
+
+  PhoshMonitor          *monitor;
+  GtkWidget             *box;
+  GtkWidget             *lbl_clock;
+  GtkWidget             *lbl_date;
+  GtkWidget             *box_icons;
+
+  PhoshNotificationList *notifications;
+  char                  *flag_file;
+};
+
+G_DEFINE_TYPE (PhoshAod, phosh_aod, PHOSH_TYPE_LAYER_SURFACE)
+
+static const char aod_css[] =
+  "window.phosh-aod { background-color: black; }\n"
+  ".phosh-aod-clock { color: #b4b4b4; font-size: 76px; font-weight: 300;"
+  "  font-feature-settings: \"tnum\"; }\n"
+  ".phosh-aod-date { color: #8c8c8c; font-size: 17px; }\n"
+  ".phosh-aod-info { color: #8c8c8c; font-size: 15px; }\n"
+  ".phosh-aod-info image { color: #8c8c8c; -gtk-icon-effect: dim; }\n";
+
+
+static void
+move_content (PhoshAod *self)
+{
+  int height, dx, dy;
+
+  /* A new random place each minute, within a small box around the middle */
+  dx = g_random_int_range (-AOD_SHIFT_X, AOD_SHIFT_X + 1);
+  dy = g_random_int_range (0, AOD_SHIFT_Y + 1);
+
+  height = gtk_widget_get_allocated_height (GTK_WIDGET (self));
+  if (height <= 1 && self->monitor)
+    height = self->monitor->logical.height;
+
+  /* halign center: an uneven start and end margin moves the box sideways */
+  gtk_widget_set_margin_start (self->box, MAX (dx, 0) * 2);
+  gtk_widget_set_margin_end (self->box, MAX (-dx, 0) * 2);
+  gtk_widget_set_margin_top (self->box, (int)(height * AOD_TOP) + dy);
+}
+
+
+static void
+on_wall_clock_changed (PhoshAod *self, GParamSpec *pspec, PhoshWallClock *wall_clock)
+{
+  g_autofree char *stripped = NULL;
+  g_autofree char *date = NULL;
+  const char *time;
+
+  time = phosh_wall_clock_get_clock (wall_clock, TRUE);
+  stripped = phosh_wall_clock_strip_am_pm (wall_clock, time);
+  gtk_label_set_text (GTK_LABEL (self->lbl_clock), stripped);
+
+  date = phosh_wall_clock_local_date (wall_clock);
+  gtk_label_set_text (GTK_LABEL (self->lbl_date), date);
+
+  move_content (self);
+}
+
+
+static void
+on_notifications_changed (PhoshAod *self)
+{
+  g_autoptr (GPtrArray) names = g_ptr_array_new_with_free_func (g_free);
+  guint n_sources, n_icons = 0, n_more = 0;
+  GList *children;
+
+  children = gtk_container_get_children (GTK_CONTAINER (self->box_icons));
+  for (GList *l = children; l; l = l->next)
+    gtk_widget_destroy (l->data);
+  g_list_free (children);
+
+  if (!self->notifications)
+    return;
+
+  /* One icon per app (source), the newest apps first */
+  n_sources = g_list_model_get_n_items (G_LIST_MODEL (self->notifications));
+  for (guint i = 0; i < n_sources; i++) {
+    g_autoptr (PhoshNotificationSource) source =
+      g_list_model_get_item (G_LIST_MODEL (self->notifications), i);
+    g_autoptr (PhoshNotification) notification = NULL;
+    GIcon *icon;
+    GtkWidget *image;
+
+    if (g_list_model_get_n_items (G_LIST_MODEL (source)) == 0)
+      continue;
+
+    if (n_icons == AOD_MAX_ICONS) {
+      n_more++;
+      continue;
+    }
+
+    notification = g_list_model_get_item (G_LIST_MODEL (source), 0);
+    icon = phosh_notification_get_app_icon (notification);
+    if (icon)
+      image = gtk_image_new_from_gicon (icon, GTK_ICON_SIZE_LARGE_TOOLBAR);
+    else
+      image = gtk_image_new_from_icon_name ("preferences-system-notifications-symbolic",
+                                            GTK_ICON_SIZE_LARGE_TOOLBAR);
+    gtk_image_set_pixel_size (GTK_IMAGE (image), 22);
+    gtk_widget_show (image);
+    gtk_container_add (GTK_CONTAINER (self->box_icons), image);
+    n_icons++;
+  }
+
+  if (n_more) {
+    g_autofree char *more = g_strdup_printf ("+%u", n_more);
+    GtkWidget *label = gtk_label_new (more);
+
+    gtk_widget_show (label);
+    gtk_container_add (GTK_CONTAINER (self->box_icons), label);
+  }
+  gtk_widget_set_visible (self->box_icons, n_icons > 0);
+}
+
+
+static void
+phosh_aod_set_property (GObject      *obj,
+                        guint         prop_id,
+                        const GValue *value,
+                        GParamSpec   *pspec)
+{
+  PhoshAod *self = PHOSH_AOD (obj);
+
+  switch (prop_id) {
+  case PROP_MONITOR:
+    g_set_object (&self->monitor, g_value_get_object (value));
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (obj, prop_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_aod_get_property (GObject    *obj,
+                        guint       prop_id,
+                        GValue     *value,
+                        GParamSpec *pspec)
+{
+  PhoshAod *self = PHOSH_AOD (obj);
+
+  switch (prop_id) {
+  case PROP_MONITOR:
+    g_value_set_object (value, self->monitor);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (obj, prop_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_aod_dispose (GObject *object)
+{
+  PhoshAod *self = PHOSH_AOD (object);
+
+  if (self->flag_file) {
+    g_unlink (self->flag_file);
+    g_clear_pointer (&self->flag_file, g_free);
+  }
+  g_clear_object (&self->notifications);
+  g_clear_object (&self->monitor);
+
+  G_OBJECT_CLASS (phosh_aod_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_aod_constructed (GObject *object)
+{
+  PhoshAod *self = PHOSH_AOD (object);
+  PhoshWayland *wl = phosh_wayland_get_default ();
+  PhoshWallClock *wall_clock = phosh_wall_clock_get_default ();
+  PhoshNotifyManager *notify_manager = phosh_notify_manager_get_default ();
+  const char *runtime_dir;
+  GtkWidget *info, *battery;
+
+  if (self->monitor == NULL)
+    self->monitor = g_object_ref (phosh_shell_get_primary_monitor (phosh_shell_get_default ()));
+
+  g_object_set (PHOSH_LAYER_SURFACE (self),
+                "layer-shell", phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                "wl-output", phosh_monitor_get_wl_output (self->monitor),
+                "anchor", ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT,
+                "layer", ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+                "kbd-interactivity", FALSE,
+                "exclusive-zone", -1,
+                "namespace", "phosh aod",
+                NULL);
+
+  G_OBJECT_CLASS (phosh_aod_parent_class)->constructed (object);
+
+  gtk_style_context_add_class (gtk_widget_get_style_context (GTK_WIDGET (self)), "phosh-aod");
+
+  self->box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 4);
+  gtk_widget_set_halign (self->box, GTK_ALIGN_CENTER);
+  gtk_widget_set_valign (self->box, GTK_ALIGN_START);
+
+  self->lbl_clock = gtk_label_new (NULL);
+  gtk_style_context_add_class (gtk_widget_get_style_context (self->lbl_clock), "phosh-aod-clock");
+  gtk_container_add (GTK_CONTAINER (self->box), self->lbl_clock);
+
+  self->lbl_date = gtk_label_new (NULL);
+  gtk_style_context_add_class (gtk_widget_get_style_context (self->lbl_date), "phosh-aod-date");
+  gtk_container_add (GTK_CONTAINER (self->box), self->lbl_date);
+
+  /* Battery and the apps with notifications in one row under the date */
+  info = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 14);
+  gtk_widget_set_halign (info, GTK_ALIGN_CENTER);
+  gtk_widget_set_margin_top (info, 18);
+  gtk_style_context_add_class (gtk_widget_get_style_context (info), "phosh-aod-info");
+  battery = phosh_battery_info_new ();
+  g_object_set (battery, "show-detail", TRUE, NULL);
+  gtk_container_add (GTK_CONTAINER (info), battery);
+  self->box_icons = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 10);
+  gtk_widget_set_no_show_all (self->box_icons, TRUE);
+  gtk_container_add (GTK_CONTAINER (info), self->box_icons);
+  gtk_container_add (GTK_CONTAINER (self->box), info);
+
+  gtk_widget_show_all (self->box);
+  gtk_container_add (GTK_CONTAINER (self), self->box);
+
+  g_signal_connect_object (wall_clock, "notify::time",
+                           G_CALLBACK (on_wall_clock_changed), self, G_CONNECT_SWAPPED);
+  on_wall_clock_changed (self, NULL, wall_clock);
+
+  if (notify_manager) {
+    self->notifications = g_object_ref (phosh_notify_manager_get_list (notify_manager));
+    g_signal_connect_object (self->notifications, "items-changed",
+                             G_CALLBACK (on_notifications_changed), self, G_CONNECT_SWAPPED);
+  }
+  on_notifications_changed (self);
+
+  /* Tell plinius-suspend to wake the phone for the clock */
+  runtime_dir = g_get_user_runtime_dir ();
+  if (runtime_dir) {
+    g_autoptr (GError) err = NULL;
+
+    self->flag_file = g_build_filename (runtime_dir, "plinius-aod", NULL);
+    if (!g_file_set_contents (self->flag_file, "", 0, &err))
+      g_warning ("Failed to create %s: %s", self->flag_file, err->message);
+  }
+}
+
+
+static void
+phosh_aod_class_init (PhoshAodClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  g_autoptr (GtkCssProvider) provider = gtk_css_provider_new ();
+
+  object_class->get_property = phosh_aod_get_property;
+  object_class->set_property = phosh_aod_set_property;
+  object_class->constructed = phosh_aod_constructed;
+  object_class->dispose = phosh_aod_dispose;
+
+  props[PROP_MONITOR] =
+    g_param_spec_object ("monitor", "", "",
+                         PHOSH_TYPE_MONITOR,
+                         G_PARAM_CONSTRUCT_ONLY | G_PARAM_READWRITE | G_PARAM_STATIC_STRINGS);
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+
+  /* Above Phosh's own style sheet, which has no rules for these classes */
+  gtk_css_provider_load_from_data (provider, aod_css, -1, NULL);
+  gtk_style_context_add_provider_for_screen (gdk_screen_get_default (),
+                                             GTK_STYLE_PROVIDER (provider),
+                                             GTK_STYLE_PROVIDER_PRIORITY_APPLICATION + 1);
+}
+
+
+static void
+phosh_aod_init (PhoshAod *self)
+{
+}
+
+
+PhoshAod *
+phosh_aod_new (PhoshMonitor *monitor)
+{
+  return g_object_new (PHOSH_TYPE_AOD, "monitor", monitor, NULL);
+}
