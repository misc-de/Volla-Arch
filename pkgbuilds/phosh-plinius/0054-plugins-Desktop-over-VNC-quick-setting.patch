--- /dev/null
+++ b/plugins/desktop-vnc-quick-setting/meson.build
@@ -0,0 +1,48 @@
+# Plinius: the desktop over VNC on and off, through plinius-desktop's socket unit
+name = 'desktop-vnc-quick-setting'
+
+desktop_vnc_quick_setting_resources = gnome.compile_resources(
+  'phosh-plugin-desktop-vnc-quick-setting-resources',
+  'phosh-plugin-desktop-vnc-quick-setting.gresources.xml',
+  c_name: 'phosh_plugin_desktop_vnc_quick_setting',
+)
+
+desktop_vnc_quick_setting_plugin_sources = files(
+  'desktop-vnc-quick-setting.c',
+  'phosh-plugin-desktop-vnc-quick-setting.c',
+)
+
+phosh_desktop_vnc_quick_setting_plugin = shared_module(
+  'phosh-plugin-desktop-vnc-quick-setting',
+  desktop_vnc_quick_setting_plugin_sources,
+  desktop_vnc_quick_setting_resources,
+  c_args: [
+    '-DG_LOG_DOMAIN="phosh-plugin-@0@"'.format(name),
+    '-DPLUGIN_NAME="@0@"'.format(name),
+  ],
+  dependencies: plugin_dep,
+  install: true,
+  install_dir: plugins_dir,
+)
+
+pluginconf = configuration_data()
+pluginconf.set('name', name)
+pluginconf.set('plugins_dir', plugins_dir)
+
+i18n.merge_file(
+  input: configure_file(
+    input: name + '.desktop.in.in',
+    output: name + '.desktop.in',
+    configuration: pluginconf,
+  ),
+  output: name + '.plugin',
+  po_dir: meson.project_source_root() / 'po',
+  install: true,
+  install_dir: plugins_dir,
+  type: 'desktop',
+)
+
+install_data(
+  'icons/desktop-vnc-quick-setting-symbolic.svg',
+  install_dir: phosh_plugin_icon_dir,
+)
