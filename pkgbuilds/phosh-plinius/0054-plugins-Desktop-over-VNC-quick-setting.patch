diff --git a/plugins/desktop-vnc-quick-setting/desktop-vnc-quick-setting.c b/plugins/desktop-vnc-quick-setting/desktop-vnc-quick-setting.c
new file mode 100644
index 00000000..62e144df
--- /dev/null
+++ b/plugins/desktop-vnc-quick-setting/desktop-vnc-quick-setting.c
@@ -0,0 +1,151 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "desktop-vnc-quick-setting.h"
+#include "plugin-shell.h"
+#include "quick-setting.h"
+#include "status-icon.h"
+
+#include <glib/gi18n.h>
+
+/* The strings live in plinius-desktop's translations: without that package the tile is hidden */
+#define DOMAIN "plinius-desktop"
+#define SOCKET_UNIT "plinius-desktop.socket"
+#define SET_TOOL "/usr/lib/plinius-desktop/plinius-desktop-set"
+
+/**
+ * PhoshDesktopVncQuickSetting:
+ *
+ * The desktop over VNC on and off: enables the user's socket unit of plinius-desktop, so a
+ * VNC viewer on another computer can connect and log in. The tile tells when one is connected. It
+ * only goes on while the phone is unlocked, switching off always works and also ends a running
+ * session. A long press opens the page in GNOME Settings.
+ */
+struct _PhoshDesktopVncQuickSetting {
+  PhoshQuickSetting  parent;
+
+  PhoshStatusIcon   *info;
+
+  GFile             *enabled_file;
+  GFile             *client_file;
+  GFileMonitor      *enabled_monitor;
+  GFileMonitor      *client_monitor;
+};
+G_DEFINE_TYPE (PhoshDesktopVncQuickSetting, phosh_desktop_vnc_quick_setting, PHOSH_TYPE_QUICK_SETTING);
+
+
+static void
+update (PhoshDesktopVncQuickSetting *self)
+{
+  gboolean enabled = g_file_query_exists (self->enabled_file, NULL);
+  gboolean connected = g_file_query_exists (self->client_file, NULL);
+
+  phosh_quick_setting_set_active (PHOSH_QUICK_SETTING (self), enabled);
+  phosh_status_icon_set_info (self->info,
+                              g_dgettext (DOMAIN, connected ? "VNC Desktop connected" : "VNC Desktop"));
+}
+
+
+static void
+on_systemctl_done (GObject *source, GAsyncResult *result, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+
+  if (!g_subprocess_wait_check_finish (G_SUBPROCESS (source), result, &err) &&
+      !g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+    g_warning ("systemctl failed: %s", err->message);
+  }
+}
+
+
+static void
+on_clicked (PhoshDesktopVncQuickSetting *self)
+{
+  g_autoptr (GSubprocess) process = NULL;
+  g_autoptr (GError) err = NULL;
+  gboolean enable = !g_file_query_exists (self->enabled_file, NULL);
+
+  /* Nobody opens the phone to the network from the lock screen */
+  if (enable && phosh_shell_get_locked (phosh_shell_get_default ()))
+    return;
+
+  process = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_SILENCE | G_SUBPROCESS_FLAGS_STDERR_SILENCE,
+                              &err, "systemctl", "--user", enable ? "enable" : "disable", "--now",
+                              SOCKET_UNIT, NULL);
+  if (!process) {
+    g_warning ("Cannot run systemctl: %s", err->message);
+    return;
+  }
+  /* The monitors tell when it's done */
+  g_subprocess_wait_check_async (process, NULL, on_systemctl_done, NULL);
+}
+
+
+static GFileMonitor *
+watch (PhoshDesktopVncQuickSetting *self, GFile *file)
+{
+  g_autoptr (GError) err = NULL;
+  GFileMonitor *monitor = g_file_monitor_file (file, G_FILE_MONITOR_NONE, NULL, &err);
+
+  if (!monitor) {
+    g_warning ("Cannot watch %s: %s", g_file_peek_path (file), err->message);
+    return NULL;
+  }
+  g_signal_connect_object (monitor, "changed", G_CALLBACK (update), self, G_CONNECT_SWAPPED);
+  return monitor;
+}
+
+
+static void
+phosh_desktop_vnc_quick_setting_dispose (GObject *object)
+{
+  PhoshDesktopVncQuickSetting *self = PHOSH_DESKTOP_VNC_QUICK_SETTING (object);
+
+  g_clear_object (&self->enabled_monitor);
+  g_clear_object (&self->client_monitor);
+  g_clear_object (&self->enabled_file);
+  g_clear_object (&self->client_file);
+
+  G_OBJECT_CLASS (phosh_desktop_vnc_quick_setting_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_desktop_vnc_quick_setting_class_init (PhoshDesktopVncQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_desktop_vnc_quick_setting_dispose;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/desktop-vnc-quick-setting/qs.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshDesktopVncQuickSetting, info);
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+}
+
+
+static void
+phosh_desktop_vnc_quick_setting_init (PhoshDesktopVncQuickSetting *self)
+{
+  g_autofree char *enabled = g_build_filename (g_get_user_config_dir (), "systemd", "user",
+                                               "graphical-session.target.wants", SOCKET_UNIT, NULL);
+  g_autofree char *client = g_build_filename (g_get_user_runtime_dir (), "plinius-desktop", "client", NULL);
+
+  gtk_widget_init_template (GTK_WIDGET (self));
+  gtk_icon_theme_add_resource_path (gtk_icon_theme_get_default (),
+                                    "/mobi/phosh/plugins/desktop-vnc-quick-setting/icons");
+
+  /* No tile without the package */
+  gtk_widget_set_no_show_all (GTK_WIDGET (self), TRUE);
+  gtk_widget_set_visible (GTK_WIDGET (self), g_file_test (SET_TOOL, G_FILE_TEST_IS_EXECUTABLE));
+
+  self->enabled_file = g_file_new_for_path (enabled);
+  self->client_file = g_file_new_for_path (client);
+  self->enabled_monitor = watch (self, self->enabled_file);
+  self->client_monitor = watch (self, self->client_file);
+  update (self);
+}
