From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Thu, 5 Nov 2026 20:58:59 +0100
Subject: [PATCH] shell: The overview opens when the phone's last window left
 for another screen

Plinius: the overview only opened once no window existed at all. A window
brought from the phone to the desktop over VNC still exists, so the phone was
left with just its wallpaper. Toplevels now keep track of their outputs, which
wlr-foreign-toplevel has always reported, and the shell opens the overview when
the phone's last window went to another screen or closed there.
---
 src/shell.c    | 46 ++++++++++++++++++++++++++++++++++++++++++++++
 src/toplevel.c | 31 +++++++++++++++++++++++++++++++
 src/toplevel.h |  1 +
 3 files changed, 78 insertions(+)

diff --git a/src/shell.c b/src/shell.c
index 35d252ff..c4aff2ef 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -177,6 +177,7 @@ typedef struct {
   PhoshCallsManager          *calls_manager;
   PhoshMonitor               *primary_monitor;
   PhoshMonitor               *builtin_monitor;
+  gboolean                    phone_has_toplevel;
   PhoshMonitorManager        *monitor_manager;
   PhoshLockscreenManager     *lockscreen_manager;
   PhoshIdleManager           *idle_manager;
@@ -827,6 +828,44 @@ phosh_shell_finalize (GObject *object)
 }
 
 
+/* The overview opens when the phone's last window went to another screen or closed there */
+static void
+update_phone_has_toplevel (PhoshShell *self, PhoshToplevelManager *toplevel_manager)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  PhoshMonitor *monitor = phosh_shell_get_builtin_monitor (self) ?:
+    phosh_shell_get_primary_monitor (self);
+  gboolean had_toplevel = priv->phone_has_toplevel;
+
+  if (!monitor)
+    return;
+
+  priv->phone_has_toplevel = FALSE;
+  for (guint i = 0; i < phosh_toplevel_manager_get_num_toplevels (toplevel_manager); i++) {
+    PhoshToplevel *toplevel = phosh_toplevel_manager_get_toplevel (toplevel_manager, i);
+
+    if (phosh_toplevel_is_on_output (toplevel, monitor->wl_output)) {
+      priv->phone_has_toplevel = TRUE;
+      break;
+    }
+  }
+
+  if (had_toplevel && !priv->phone_has_toplevel &&
+      phosh_monitor_manager_get_num_monitors (priv->monitor_manager) > 1)
+    phosh_home_set_state (PHOSH_HOME (priv->home), PHOSH_HOME_STATE_UNFOLDED);
+}
+
+
+static void
+on_toplevel_changed (PhoshShell *self, PhoshToplevel *unused, PhoshToplevelManager *toplevel_manager)
+{
+  g_return_if_fail (PHOSH_IS_SHELL (self));
+  g_return_if_fail (PHOSH_IS_TOPLEVEL_MANAGER (toplevel_manager));
+
+  update_phone_has_toplevel (self, toplevel_manager);
+}
+
+
 static void
 on_num_toplevels_changed (PhoshShell           *self,
                           GParamSpec           *pspec,
@@ -841,6 +880,8 @@ on_num_toplevels_changed (PhoshShell           *self,
   /* all toplevels gone, show the overview */
   if (!phosh_toplevel_manager_get_num_toplevels (toplevel_manager))
     phosh_home_set_state (PHOSH_HOME (priv->home), PHOSH_HOME_STATE_UNFOLDED);
+
+  update_phone_has_toplevel (self, toplevel_manager);
 }
 
 
@@ -1024,6 +1065,11 @@ setup_idle_cb (PhoshShell *self)
                            G_CALLBACK (on_toplevel_added),
                            self,
                            G_CONNECT_SWAPPED);
+  g_signal_connect_object (priv->toplevel_manager,
+                           "toplevel-changed",
+                           G_CALLBACK (on_toplevel_changed),
+                           self,
+                           G_CONNECT_SWAPPED);
 
   /* Screen saver manager needs lock screen manager */
   priv->screen_saver_manager = phosh_screen_saver_manager_new (priv->lockscreen_manager);
diff --git a/src/toplevel.c b/src/toplevel.c
index ec54d917..68c559c4 100644
--- a/src/toplevel.c
+++ b/src/toplevel.c
@@ -44,6 +44,8 @@ struct _PhoshToplevel {
   gboolean configured, activated, maximized, fullscreen;
   char *title;
   char *app_id;
+  /* Only compared, never dereferenced: a screen that is gone can stay listed */
+  GPtrArray *outputs;
 };
 
 G_DEFINE_TYPE (PhoshToplevel, phosh_toplevel, G_TYPE_OBJECT);
@@ -88,6 +90,12 @@ handle_zwlr_foreign_toplevel_handle_output_enter (void
                                                   struct zwlr_foreign_toplevel_handle_v1 *handle,
                                                   struct wl_output                       *output)
 {
+  PhoshToplevel *self = data;
+
+  g_return_if_fail (PHOSH_IS_TOPLEVEL (self));
+
+  if (output && !g_ptr_array_find (self->outputs, output, NULL))
+    g_ptr_array_add (self->outputs, output);
 }
 
 
@@ -96,6 +104,11 @@ handle_zwlr_foreign_toplevel_handle_output_leave (void
                                                   struct zwlr_foreign_toplevel_handle_v1 *handle,
                                                   struct wl_output                       *output)
 {
+  PhoshToplevel *self = data;
+
+  g_return_if_fail (PHOSH_IS_TOPLEVEL (self));
+
+  g_ptr_array_remove (self->outputs, output);
 }
 
 
@@ -204,6 +217,7 @@ phosh_toplevel_finalize (GObject *object)
 
   g_clear_pointer (&self->app_id, g_free);
   g_clear_pointer (&self->title, g_free);
+  g_clear_pointer (&self->outputs, g_ptr_array_unref);
 
   G_OBJECT_CLASS (phosh_toplevel_parent_class)->finalize (object);
 }
@@ -370,6 +384,7 @@ phosh_toplevel_class_init (PhoshToplevelClass *klass)
 static void
 phosh_toplevel_init (PhoshToplevel *self)
 {
+  self->outputs = g_ptr_array_new ();
 }
 
 
@@ -470,3 +485,19 @@ phosh_toplevel_fullscreen (PhoshToplevel *self, gboolean fullscreen)
   else
     zwlr_foreign_toplevel_handle_v1_unset_fullscreen (self->handle);
 }
+
+
+/**
+ * phosh_toplevel_is_on_output:
+ * @self: The toplevel
+ * @output: The output to check
+ *
+ * Returns: Whether the toplevel shows on the given output
+ */
+gboolean
+phosh_toplevel_is_on_output (PhoshToplevel *self, struct wl_output *output)
+{
+  g_return_val_if_fail (PHOSH_IS_TOPLEVEL (self), FALSE);
+
+  return g_ptr_array_find (self->outputs, output, NULL);
+}
diff --git a/src/toplevel.h b/src/toplevel.h
index d7ecd021..419341ec 100644
--- a/src/toplevel.h
+++ b/src/toplevel.h
@@ -22,6 +22,7 @@ gboolean phosh_toplevel_is_configured (PhoshToplevel *self);
 gboolean phosh_toplevel_is_activated (PhoshToplevel *self);
 gboolean phosh_toplevel_is_maximized (PhoshToplevel *self);
 gboolean phosh_toplevel_is_fullscreen (PhoshToplevel *self);
+gboolean phosh_toplevel_is_on_output (PhoshToplevel *self, struct wl_output *output);
 void phosh_toplevel_activate (PhoshToplevel *self, struct wl_seat *seat);
 void phosh_toplevel_close (PhoshToplevel *self);
 void phosh_toplevel_fullscreen (PhoshToplevel *self, gboolean fullscreen);
