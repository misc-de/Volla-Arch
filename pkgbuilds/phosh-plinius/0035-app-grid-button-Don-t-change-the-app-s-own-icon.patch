diff --git a/src/app-grid-folder-button.c b/src/app-grid-folder-button.c
index ad105a23..848de6d1 100644
--- a/src/app-grid-folder-button.c
+++ b/src/app-grid-folder-button.c
@@ -90,7 +90,6 @@ build_2x2_grid_icon (PhoshAppGridFolderButton *self)
 {
   GListModel *apps;
   g_autoptr (GAppInfo) app_info = NULL;
-  GIcon *icon;
 
   gtk_grid_remove_row (self->grid, 1);
   gtk_grid_remove_row (self->grid, 0);
@@ -101,19 +100,15 @@ build_2x2_grid_icon (PhoshAppGridFolderButton *self)
        i < 4 && (app_info = g_list_model_get_item (apps, i)) != NULL;
        i++) {
     GtkWidget *image = NULL;
+    g_autoptr (GIcon) icon = NULL;
     app_info = g_list_model_get_item (apps, i);
 
-    icon = g_app_info_get_icon (app_info);
+    icon = phosh_app_grid_button_get_app_icon (app_info);
 
-    if (icon == NULL) {
+    if (icon == NULL)
       image = gtk_image_new_from_icon_name (PHOSH_APP_UNKNOWN_ICON, -1);
-    } else {
-      if (G_IS_THEMED_ICON (icon)) {
-        g_themed_icon_append_name (G_THEMED_ICON (icon),
-                                   PHOSH_APP_UNKNOWN_ICON);
-      }
+    else
       image = gtk_image_new_from_gicon (icon, -1);
-    }
 
     /* app-grid-button uses 64px for its icon.
      * Our grid has two rows and two columns, with 8px for spacing.
diff --git a/tests/test-app-grid-button.c b/tests/test-app-grid-button.c
index 890efd06..5aaefef0 100644
--- a/tests/test-app-grid-button.c
+++ b/tests/test-app-grid-button.c
@@ -10,6 +10,8 @@
 #include "favorite-list-model.h"
 #include "metainfo-cache.h"
 
+#include <gio/gdesktopappinfo.h>
+
 
 static void
 test_phosh_app_grid_button_new (void)
@@ -38,6 +40,55 @@ test_phosh_app_grid_button_new (void)
 }
 
 
+static void
+test_phosh_app_grid_button_app_icon (void)
+{
+  g_autoptr (GKeyFile) keyfile = g_key_file_new ();
+  g_autoptr (GDesktopAppInfo) info = NULL;
+  g_autoptr (GIcon) icon = NULL;
+  g_autoptr (GIcon) icon2 = NULL;
+  g_auto (GStrv) names_before = NULL;
+  g_auto (GStrv) names_after = NULL;
+  g_auto (GStrv) names_shown = NULL;
+  GtkWidget *btn1, *btn2;
+
+  g_assert_true (g_key_file_load_from_data (keyfile,
+                                            "[Desktop Entry]\n"
+                                            "Type=Application\n"
+                                            "Name=Foo\n"
+                                            /* Must be in PATH, else there is no app info */
+                                            "Exec=true\n"
+                                            "Icon=com.example.foo\n",
+                                            -1, G_KEY_FILE_NONE, NULL));
+  info = g_desktop_app_info_new_from_keyfile (keyfile);
+  g_assert_nonnull (info);
+
+  g_object_get (g_app_info_get_icon (G_APP_INFO (info)), "names", &names_before, NULL);
+  g_assert_cmpstrv (names_before, ((const char *[]) { "com.example.foo", NULL }));
+
+  /* Buttons for the same app, as each opening of a folder makes */
+  btn1 = phosh_app_grid_button_new (G_APP_INFO (info));
+  btn2 = phosh_app_grid_button_new (G_APP_INFO (info));
+
+  /* The app's own icon stays as it is */
+  g_object_get (g_app_info_get_icon (G_APP_INFO (info)), "names", &names_after, NULL);
+  g_assert_cmpstrv (names_after, names_before);
+
+  /* The icon shown falls back to the unknown app icon, once */
+  icon = phosh_app_grid_button_get_app_icon (G_APP_INFO (info));
+  g_object_get (icon, "names", &names_shown, NULL);
+  g_assert_cmpstrv (names_shown,
+                    ((const char *[]) { "com.example.foo", PHOSH_APP_UNKNOWN_ICON, NULL }));
+
+  /* An equal icon each time, so GTK's icon cache finds it again */
+  icon2 = phosh_app_grid_button_get_app_icon (G_APP_INFO (info));
+  g_assert_true (g_icon_equal (icon, icon2));
+
+  gtk_widget_destroy (btn1);
+  gtk_widget_destroy (btn2);
+}
+
+
 static void
 test_phosh_app_grid_button_new_favorite (void)
 {
@@ -347,6 +398,7 @@ main (int   argc,
   gtk_test_init (&argc, &argv, NULL);
 
   g_test_add_func("/phosh/app-grid-button/new", test_phosh_app_grid_button_new);
+  g_test_add_func("/phosh/app-grid-button/app_icon", test_phosh_app_grid_button_app_icon);
   g_test_add_func("/phosh/app-grid-button/new_favorite", test_phosh_app_grid_button_new_favorite);
   g_test_add_func("/phosh/app-grid-button/set_app_info", test_phosh_app_grid_button_set_app_info);
   g_test_add_func("/phosh/app-grid-button/set_mode", test_phosh_app_grid_button_set_mode);
