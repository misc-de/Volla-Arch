From 1ec61d781c656c9fc3c6590d789fdfa7a37cc622 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Mon, 2 Nov 2026 17:52:53 +0100
Subject: [PATCH 35/37] app-grid-button: Don't change the app's own icon

Each new button appended "app-icon-unknown" to the themed icon of its
app info, which belongs to the app info and is shared by every button
for that app. Folder buttons are made anew each time a folder opens,
so the icon's list of names grew with every opening: after three
openings it was "org.gnome.Console", "app-icon-unknown",
"app-icon-unknown", "app-icon-unknown".

GTK keys its icon cache by these names, so a folder's icons never
came from the cache and were all rendered again in the first frame of
the slide to the folder page. On a phone (scale 3, SVG icons) that is
20-60 ms per icon, the slide visibly jumps.

Take a copy of the icon with the fallback appended instead and use it
in the folder button's preview too.

Signed-off-by: misc-de <misc-de@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/app-grid-button.c        | 68 ++++++++++++++++++++++++++++++++++++++------
 src/app-grid-button.h        |  1 +
 src/app-grid-folder-button.c | 13 +++------
 tests/test-app-grid-button.c | 52 +++++++++++++++++++++++++++++++++
 4 files changed, 116 insertions(+), 18 deletions(-)

diff --git a/src/app-grid-button.c b/src/app-grid-button.c
index 3f0faae0..c1a06345 100644
--- a/src/app-grid-button.c
+++ b/src/app-grid-button.c
@@ -741,7 +741,7 @@ phosh_app_grid_button_set_app_info (PhoshAppGridButton *self,
 {
   PhoshFavoriteListModel *list = NULL;
   PhoshAppGridButtonPrivate *priv;
-  GIcon *icon;
+  g_autoptr (GIcon) icon = NULL;
   const char *name;
 
   g_return_if_fail (PHOSH_IS_APP_GRID_BUTTON (self));
@@ -772,16 +772,11 @@ phosh_app_grid_button_set_app_info (PhoshAppGridButton *self,
     name = g_app_info_get_name (G_APP_INFO (priv->info));
     phosh_app_grid_base_button_set_label (PHOSH_APP_GRID_BASE_BUTTON (self), name);
 
-    icon = g_app_info_get_icon (priv->info);
-    if (G_UNLIKELY (icon == NULL)) {
+    icon = phosh_app_grid_button_get_app_icon (priv->info);
+    if (G_UNLIKELY (icon == NULL))
       gtk_image_set_from_icon_name (GTK_IMAGE (priv->icon), PHOSH_APP_UNKNOWN_ICON, -1);
-    } else {
-      if (G_IS_THEMED_ICON (icon)) {
-        g_themed_icon_append_name (G_THEMED_ICON (icon),
-                                   PHOSH_APP_UNKNOWN_ICON);
-      }
+    else
       gtk_image_set_from_gicon (GTK_IMAGE (priv->icon), icon, -1);
-    }
 
     gtk_widget_set_sensitive (GTK_WIDGET (self), TRUE);
 
@@ -828,6 +823,61 @@ phosh_app_grid_button_set_app_info (PhoshAppGridButton *self,
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_APP_INFO]);
 }
 
+/**
+ * phosh_app_grid_button_get_app_icon:
+ * @info: An app info
+ *
+ * Get the icon to show for an app: for a themed icon a copy that falls back to
+ * %PHOSH_APP_UNKNOWN_ICON. The app info's own icon is left as it is: appending the
+ * fallback to it on every new button made its list of names grow, so GTK's icon
+ * cache (keyed by these names) never matched and every button rendered its icon
+ * anew.
+ *
+ * Returns:(transfer full)(nullable): The icon or %NULL if the app has none
+ */
+GIcon *
+phosh_app_grid_button_get_app_icon (GAppInfo *info)
+{
+  GIcon *icon;
+  g_auto (GStrv) names = NULL;
+  g_autoptr (GStrvBuilder) builder = NULL;
+  g_auto (GStrv) new_names = NULL;
+  gboolean use_default_fallbacks;
+  guint n;
+
+  g_return_val_if_fail (G_IS_APP_INFO (info), NULL);
+
+  icon = g_app_info_get_icon (info);
+  if (icon == NULL)
+    return NULL;
+
+  if (!G_IS_THEMED_ICON (icon))
+    return g_object_ref (icon);
+
+  /* The names the icon was made with: g_themed_icon_get_names() also has the
+   * symbolic variants GThemedIcon adds itself */
+  g_object_get (icon,
+                "names", &names,
+                "use-default-fallbacks", &use_default_fallbacks,
+                NULL);
+  n = names ? g_strv_length (names) : 0;
+  /* Nothing to add when the app's icon falls back to it already */
+  if (n > 0 && g_str_equal (names[n - 1], PHOSH_APP_UNKNOWN_ICON))
+    return g_object_ref (icon);
+
+  /* Same as g_themed_icon_append_name() on the app's icon, but on a copy */
+  builder = g_strv_builder_new ();
+  if (names)
+    g_strv_builder_addv (builder, (const char **) names);
+  g_strv_builder_add (builder, PHOSH_APP_UNKNOWN_ICON);
+  new_names = g_strv_builder_end (builder);
+
+  return g_object_new (G_TYPE_THEMED_ICON,
+                       "names", new_names,
+                       "use-default-fallbacks", use_default_fallbacks,
+                       NULL);
+}
+
 /**
  * phosh_app_grid_button_get_app_info:
  * @self: An app grid button
diff --git a/src/app-grid-button.h b/src/app-grid-button.h
index eeedb35b..023d647b 100644
--- a/src/app-grid-button.h
+++ b/src/app-grid-button.h
@@ -48,6 +48,7 @@ GtkWidget             *phosh_app_grid_button_new           (GAppInfo
 GtkWidget             *phosh_app_grid_button_new_favorite  (GAppInfo               *info);
 void                   phosh_app_grid_button_set_app_info  (PhoshAppGridButton     *self,
                                                             GAppInfo               *info);
+GIcon                 *phosh_app_grid_button_get_app_icon  (GAppInfo               *info);
 GAppInfo              *phosh_app_grid_button_get_app_info  (PhoshAppGridButton     *self);
 gboolean               phosh_app_grid_button_is_favorite   (PhoshAppGridButton     *self);
