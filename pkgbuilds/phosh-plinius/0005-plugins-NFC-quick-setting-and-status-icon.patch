diff --git a/plugins/nfc-quick-setting/meson.build b/plugins/nfc-quick-setting/meson.build
new file mode 100644
index 00000000..d85aa8cf
--- /dev/null
+++ b/plugins/nfc-quick-setting/meson.build
@@ -0,0 +1,48 @@
+# Plinius: NFC through nfcd (org.sailfishos.nfc.Settings)
+name = 'nfc-quick-setting'
+
+nfc_quick_setting_resources = gnome.compile_resources(
+  'phosh-plugin-nfc-quick-setting-resources',
+  'phosh-plugin-nfc-quick-setting.gresources.xml',
+  c_name: 'phosh_plugin_nfc_quick_setting',
+)
+
+nfc_quick_setting_plugin_sources = files(
+  'nfc-quick-setting.c',
+  'phosh-plugin-nfc-quick-setting.c',
+)
+
+phosh_nfc_quick_setting_plugin = shared_module(
+  'phosh-plugin-nfc-quick-setting',
+  nfc_quick_setting_plugin_sources,
+  nfc_quick_setting_resources,
+  c_args: [
+    '-DG_LOG_DOMAIN="phosh-plugin-@0@"'.format(name),
+    '-DPLUGIN_NAME="@0@"'.format(name),
+  ],
+  dependencies: plugin_dep,
+  install: true,
+  install_dir: plugins_dir,
+)
+
+pluginconf = configuration_data()
+pluginconf.set('name', name)
+pluginconf.set('plugins_dir', plugins_dir)
+
+i18n.merge_file(
+  input: configure_file(
+    input: name + '.desktop.in.in',
+    output: name + '.desktop.in',
+    configuration: pluginconf,
+  ),
+  output: name + '.plugin',
+  po_dir: meson.project_source_root() / 'po',
+  install: true,
+  install_dir: plugins_dir,
+  type: 'desktop',
+)
+
+install_data(
+  'icons/nfc-quick-setting-symbolic.svg',
+  install_dir: phosh_plugin_icon_dir,
+)
diff --git a/plugins/nfc-quick-setting/nfc-quick-setting.c b/plugins/nfc-quick-setting/nfc-quick-setting.c
new file mode 100644
index 00000000..0951fc3c
--- /dev/null
+++ b/plugins/nfc-quick-setting/nfc-quick-setting.c
@@ -0,0 +1,175 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nfc-quick-setting.h"
+#include "quick-setting.h"
+#include "status-icon.h"
+
+#include <glib/gi18n.h>
+
+#define NFC_SETTINGS_NAME "org.sailfishos.nfc.settings"
+#define NFC_SETTINGS_PATH "/"
+#define NFC_SETTINGS_INTERFACE "org.sailfishos.nfc.Settings"
+
+/**
+ * PhoshNfcQuickSetting:
+ *
+ * A quick setting to switch NFC on/off through nfcd (org.sailfishos.nfc.Settings).
+ * Insensitive while nfcd is not running.
+ */
+struct _PhoshNfcQuickSetting {
+  PhoshQuickSetting  parent;
+
+  PhoshStatusIcon   *info;
+  GDBusProxy        *proxy;
+  GCancellable      *cancel;
+};
+G_DEFINE_TYPE (PhoshNfcQuickSetting, phosh_nfc_quick_setting, PHOSH_TYPE_QUICK_SETTING);
+
+
+static void
+update (PhoshNfcQuickSetting *self, gboolean enabled)
+{
+  phosh_quick_setting_set_active (PHOSH_QUICK_SETTING (self), enabled);
+  phosh_status_icon_set_icon_name (self->info, enabled ? "nfc-symbolic" : "nfc-disabled-symbolic");
+  phosh_status_icon_set_info (self->info, enabled ? _("NFC On") : _("NFC Off"));
+}
+
+
+static void
+on_get_enabled (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PhoshNfcQuickSetting *self;
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  gboolean enabled;
+
+  reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (!reply) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_debug ("Failed to get NFC state: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_NFC_QUICK_SETTING (user_data);
+  g_variant_get (reply, "(b)", &enabled);
+  update (self, enabled);
+}
+
+
+static void
+on_name_owner_changed (PhoshNfcQuickSetting *self)
+{
+  g_autofree char *owner = g_dbus_proxy_get_name_owner (self->proxy);
+
+  gtk_widget_set_sensitive (GTK_WIDGET (self), owner != NULL);
+  if (owner)
+    g_dbus_proxy_call (self->proxy, "GetEnabled", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                       self->cancel, on_get_enabled, self);
+}
+
+
+static void
+on_signal (PhoshNfcQuickSetting *self, const char *sender, const char *signal, GVariant *params)
+{
+  gboolean enabled;
+
+  if (g_strcmp0 (signal, "EnabledChanged") != 0)
+    return;
+  g_variant_get (params, "(b)", &enabled);
+  update (self, enabled);
+}
+
+
+static void
+on_set_enabled (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+
+  /* nfcd only allows the group "privileged" */
+  if (!reply && !g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    g_warning ("Failed to switch NFC: %s", err->message);
+}
+
+
+static void
+on_clicked (PhoshNfcQuickSetting *self)
+{
+  gboolean active = phosh_quick_setting_get_active (PHOSH_QUICK_SETTING (self));
+
+  if (!self->proxy)
+    return;
+  /* The tile follows EnabledChanged */
+  g_dbus_proxy_call (self->proxy, "SetEnabled", g_variant_new ("(b)", !active),
+                     G_DBUS_CALL_FLAGS_NONE, -1, self->cancel, on_set_enabled, self);
+}
+
+
+static void
+on_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PhoshNfcQuickSetting *self;
+  g_autoptr (GError) err = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (res, &err);
+
+  if (!proxy) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Failed to reach nfcd: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_NFC_QUICK_SETTING (user_data);
+  self->proxy = proxy;
+  g_signal_connect_object (proxy, "g-signal", G_CALLBACK (on_signal), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (on_name_owner_changed), self,
+                           G_CONNECT_SWAPPED);
+  on_name_owner_changed (self);
+}
+
+
+static void
+phosh_nfc_quick_setting_dispose (GObject *object)
+{
+  PhoshNfcQuickSetting *self = PHOSH_NFC_QUICK_SETTING (object);
+
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  g_clear_object (&self->proxy);
+
+  G_OBJECT_CLASS (phosh_nfc_quick_setting_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_nfc_quick_setting_class_init (PhoshNfcQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_nfc_quick_setting_dispose;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/nfc-quick-setting/qs.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshNfcQuickSetting, info);
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+}
+
+
+static void
+phosh_nfc_quick_setting_init (PhoshNfcQuickSetting *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+  gtk_icon_theme_add_resource_path (gtk_icon_theme_get_default (),
+                                    "/mobi/phosh/plugins/nfc-quick-setting/icons");
+
+  self->cancel = g_cancellable_new ();
+  update (self, FALSE);
+  gtk_widget_set_sensitive (GTK_WIDGET (self), FALSE);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+                            NULL, NFC_SETTINGS_NAME, NFC_SETTINGS_PATH, NFC_SETTINGS_INTERFACE,
+                            self->cancel, on_proxy_ready, self);
+}
