diff --git a/plugins/nfc-status-icon/nfc-status-icon.c b/plugins/nfc-status-icon/nfc-status-icon.c
new file mode 100644
index 00000000..b8c9d26e
--- /dev/null
+++ b/plugins/nfc-status-icon/nfc-status-icon.c
@@ -0,0 +1,128 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nfc-status-icon.h"
+
+#define NFC_SETTINGS_NAME "org.sailfishos.nfc.settings"
+#define NFC_SETTINGS_PATH "/"
+#define NFC_SETTINGS_INTERFACE "org.sailfishos.nfc.Settings"
+
+/**
+ * PhoshNfcStatusIcon:
+ *
+ * An NFC symbol in the top bar while NFC is switched on (nfcd, org.sailfishos.nfc.Settings).
+ */
+struct _PhoshNfcStatusIcon {
+  PhoshStatusIcon parent;
+
+  GDBusProxy     *proxy;
+  GCancellable   *cancel;
+};
+G_DEFINE_TYPE (PhoshNfcStatusIcon, phosh_nfc_status_icon, PHOSH_TYPE_STATUS_ICON);
+
+
+static void
+on_get_enabled (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  gboolean enabled;
+
+  reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  if (!reply) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_debug ("Failed to get NFC state: %s", err->message);
+    return;
+  }
+
+  g_variant_get (reply, "(b)", &enabled);
+  gtk_widget_set_visible (GTK_WIDGET (user_data), enabled);
+}
+
+
+static void
+on_name_owner_changed (PhoshNfcStatusIcon *self)
+{
+  g_autofree char *owner = g_dbus_proxy_get_name_owner (self->proxy);
+
+  if (!owner) {
+    gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+    return;
+  }
+  g_dbus_proxy_call (self->proxy, "GetEnabled", NULL, G_DBUS_CALL_FLAGS_NONE, -1,
+                     self->cancel, on_get_enabled, self);
+}
+
+
+static void
+on_signal (PhoshNfcStatusIcon *self, const char *sender, const char *signal, GVariant *params)
+{
+  gboolean enabled;
+
+  if (g_strcmp0 (signal, "EnabledChanged") != 0)
+    return;
+  g_variant_get (params, "(b)", &enabled);
+  gtk_widget_set_visible (GTK_WIDGET (self), enabled);
+}
+
+
+static void
+on_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PhoshNfcStatusIcon *self;
+  g_autoptr (GError) err = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (res, &err);
+
+  if (!proxy) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Failed to reach nfcd: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_NFC_STATUS_ICON (user_data);
+  self->proxy = proxy;
+  g_signal_connect_object (proxy, "g-signal", G_CALLBACK (on_signal), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (on_name_owner_changed), self,
+                           G_CONNECT_SWAPPED);
+  on_name_owner_changed (self);
+}
+
+
+static void
+phosh_nfc_status_icon_dispose (GObject *object)
+{
+  PhoshNfcStatusIcon *self = PHOSH_NFC_STATUS_ICON (object);
+
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  g_clear_object (&self->proxy);
+
+  G_OBJECT_CLASS (phosh_nfc_status_icon_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_nfc_status_icon_class_init (PhoshNfcStatusIconClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = phosh_nfc_status_icon_dispose;
+}
+
+
+static void
+phosh_nfc_status_icon_init (PhoshNfcStatusIcon *self)
+{
+  gtk_icon_theme_add_resource_path (gtk_icon_theme_get_default (),
+                                    "/mobi/phosh/plugins/nfc-status-icon/icons");
+  phosh_status_icon_set_icon_name (PHOSH_STATUS_ICON (self), "nfc-symbolic");
+  gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+
+  self->cancel = g_cancellable_new ();
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM, G_DBUS_PROXY_FLAGS_DO_NOT_LOAD_PROPERTIES,
+                            NULL, NFC_SETTINGS_NAME, NFC_SETTINGS_PATH, NFC_SETTINGS_INTERFACE,
+                            self->cancel, on_proxy_ready, self);
+}
