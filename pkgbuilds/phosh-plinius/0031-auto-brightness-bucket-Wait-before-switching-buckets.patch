From 1d0bb080430825a9246200c19d6843e1fb150a76 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Mon, 2 Nov 2026 11:28:48 +0100
Subject: [PATCH] auto-brightness-bucket: Wait before switching buckets

Outdoors a shadow or a slight tilt of the phone crosses bucket borders
all the time and the display kept changing its brightness although the
light hardly changed.

Like Android a new bucket now only counts once the light stayed in it:
4 s for brighter, 8 s for darker. Going back into the current bucket
in between drops the change. When auto brightness stops (the display
goes off) the tracker is reset, so the first level after the display
comes back on applies at once.
---
 src/auto-brightness-bucket.c        | 118 +++++++++++++++++++++++++++++++++---
 src/auto-brightness-bucket.h        |   1 +
 src/brightness-manager.c            |   3 +
 tests/test-auto-brightness-bucket.c |  45 ++++++++++++++
 4 files changed, 158 insertions(+), 9 deletions(-)

diff --git a/src/auto-brightness-bucket.c b/src/auto-brightness-bucket.c
index 722fcf2a..30993e89 100644
--- a/src/auto-brightness-bucket.c
+++ b/src/auto-brightness-bucket.c
@@ -47,12 +47,29 @@ static Bucket buckets[] = {
 };
 
 
+/*
+ * Plinius: a new bucket only counts once the light stayed there for a while.
+ * Outdoors a shadow or a slight tilt of the phone crosses bucket borders all
+ * the time and the display kept changing its brightness. Like Android
+ * (config_autoBrightness{Brightening,Darkening}LightDebounce) brightening
+ * waits less than darkening: a too dark display is worse than a too bright
+ * one.
+ */
+#define BRIGHTEN_DEBOUNCE 4 /* s */
+#define DARKEN_DEBOUNCE   8 /* s */
+
+
 struct _PhoshAutoBrightnessBucket {
   GObject               parent;
 
   PhoshBacklight       *backlight;
   double                brightness;
   uint                  index;
+
+  /* Plinius: debouncing, see BRIGHTEN_DEBOUNCE */
+  gboolean              fresh;         /* next level applies at once */
+  uint                  pending_index; /* bucket of the last level outside the current one */
+  guint                 pending_id;    /* timer until pending_index applies */
 };
 
 
@@ -74,16 +91,9 @@ is_in_bucket (uint index, double level)
 }
 
 
-static void
-auto_brightness_bucket_add_ambient_level (PhoshAutoBrightness *auto_brightness, double level)
+static uint
+find_bucket (uint index, double level)
 {
-  PhoshAutoBrightnessBucket *self = PHOSH_AUTO_BRIGHTNESS_BUCKET (auto_brightness);
-  uint index;
-
-  if (is_in_bucket (self->index, level))
-    return;
-
-  index = self->index;
   if (level < buckets[index].min) {
     for (; index > 0; index--) {
       if (is_in_bucket (index, level))
@@ -96,6 +106,13 @@ auto_brightness_bucket_add_ambient_level (PhoshAutoBrightness *auto_brightness,
     }
   }
 
+  return index;
+}
+
+
+static void
+set_index (PhoshAutoBrightnessBucket *self, uint index)
+{
   self->brightness = buckets[index].brightness;
 
   if (self->index == index)
@@ -106,6 +123,70 @@ auto_brightness_bucket_add_ambient_level (PhoshAutoBrightness *auto_brightness,
 }
 
 
+static gboolean
+on_pending_timeout (gpointer user_data)
+{
+  PhoshAutoBrightnessBucket *self = PHOSH_AUTO_BRIGHTNESS_BUCKET (user_data);
+
+  self->pending_id = 0;
+  g_debug ("Light stayed in bucket %u, switching from %u", self->pending_index, self->index);
+  set_index (self, self->pending_index);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+auto_brightness_bucket_add_ambient_level (PhoshAutoBrightness *auto_brightness, double level)
+{
+  PhoshAutoBrightnessBucket *self = PHOSH_AUTO_BRIGHTNESS_BUCKET (auto_brightness);
+  gboolean brighter, was_brighter;
+  uint index;
+
+  if (is_in_bucket (self->index, level)) {
+    /* Back where we are: whatever was pending was a short change only */
+    if (self->pending_id)
+      g_debug ("Light back in bucket %u at %.1f lux", self->index, level);
+    g_clear_handle_id (&self->pending_id, g_source_remove);
+    self->fresh = FALSE;
+    return;
+  }
+
+  index = find_bucket (self->index, level);
+
+  /* First level after the display came on: no reason to wait */
+  if (self->fresh) {
+    self->fresh = FALSE;
+    g_clear_handle_id (&self->pending_id, g_source_remove);
+    set_index (self, index);
+    return;
+  }
+
+  if (index == self->index) {
+    /* Outside of the bucket's range but no better one (beyond the last bucket) */
+    g_clear_handle_id (&self->pending_id, g_source_remove);
+    return;
+  }
+
+  brighter = index > self->index;
+  if (self->pending_id) {
+    was_brighter = self->pending_index > self->index;
+    if (brighter == was_brighter) {
+      /* Same direction: keep the running time, apply the latest bucket */
+      self->pending_index = index;
+      return;
+    }
+    g_clear_handle_id (&self->pending_id, g_source_remove);
+  }
+
+  g_debug ("Light at %.1f lux left bucket %u for %u, waiting", level, self->index, index);
+  self->pending_index = index;
+  self->pending_id = g_timeout_add_seconds (brighter ? BRIGHTEN_DEBOUNCE : DARKEN_DEBOUNCE,
+                                            on_pending_timeout, self);
+  g_source_set_name_by_id (self->pending_id, "[phosh] auto-brightness-debounce");
+}
+
+
 static double
 auto_brightness_bucket_get_brightness (PhoshAutoBrightness *auto_brightness)
 {
@@ -179,6 +260,7 @@ phosh_auto_brightness_bucket_dispose (GObject *object)
 {
   PhoshAutoBrightnessBucket *self = PHOSH_AUTO_BRIGHTNESS_BUCKET (object);
 
+  g_clear_handle_id (&self->pending_id, g_source_remove);
   g_clear_object (&self->backlight);
 
   G_OBJECT_CLASS (phosh_auto_brightness_bucket_parent_class)->dispose (object);
@@ -207,6 +289,7 @@ phosh_auto_brightness_bucket_init (PhoshAutoBrightnessBucket *self)
 {
   self->brightness = 0.55;
   self->index = 3;
+  self->fresh = TRUE;
 }
 
 
@@ -215,3 +298,20 @@ phosh_auto_brightness_bucket_new (void)
 {
   return g_object_new (PHOSH_TYPE_AUTO_BRIGHTNESS_BUCKET, NULL);
 }
+
+/**
+ * phosh_auto_brightness_bucket_reset:
+ * @self: The bucket tracker
+ *
+ * Plinius: forget a pending change and take the next ambient level at once.
+ * Used when auto brightness stops, e.g. while the display is off: when it
+ * comes back on the light is likely different and nothing should wait.
+ */
+void
+phosh_auto_brightness_bucket_reset (PhoshAutoBrightnessBucket *self)
+{
+  g_return_if_fail (PHOSH_IS_AUTO_BRIGHTNESS_BUCKET (self));
+
+  g_clear_handle_id (&self->pending_id, g_source_remove);
+  self->fresh = TRUE;
+}
diff --git a/src/auto-brightness-bucket.h b/src/auto-brightness-bucket.h
index f1b01de1..e461f67e 100644
--- a/src/auto-brightness-bucket.h
+++ b/src/auto-brightness-bucket.h
@@ -18,5 +18,6 @@ G_DECLARE_FINAL_TYPE (PhoshAutoBrightnessBucket, phosh_auto_brightness_bucket,
                       PHOSH, AUTO_BRIGHTNESS_BUCKET, GObject)
 
 PhoshAutoBrightnessBucket *phosh_auto_brightness_bucket_new (void);
+void                       phosh_auto_brightness_bucket_reset (PhoshAutoBrightnessBucket *self);
 
 G_END_DECLS
diff --git a/src/brightness-manager.c b/src/brightness-manager.c
index 2f8cc73b..71a382be 100644
--- a/src/brightness-manager.c
+++ b/src/brightness-manager.c
@@ -363,6 +363,9 @@ on_ambient_auto_brightness_changed (PhoshBrightnessManager *self,
                                                           BRIGHTNESS_KEY_AUTO_BRIGHTNESS_OFFSET);
     set_auto_brightness_tracker (self);
     on_auto_brightness_changed (self);
+  } else if (self->auto_brightness.tracker) {
+    /* Plinius: e.g. display off, take the light at once when it comes back */
+    phosh_auto_brightness_bucket_reset (PHOSH_AUTO_BRIGHTNESS_BUCKET (self->auto_brightness.tracker));
   }
 }
 
diff --git a/tests/test-auto-brightness-bucket.c b/tests/test-auto-brightness-bucket.c
index a16a7f6d..ad969744 100644
--- a/tests/test-auto-brightness-bucket.c
+++ b/tests/test-auto-brightness-bucket.c
@@ -9,6 +9,38 @@
 #include "auto-brightness-bucket.h"
 
 
+static void
+on_brightness_changed (GMainLoop *loop)
+{
+  g_main_loop_quit (loop);
+}
+
+
+static gboolean
+on_too_late (gpointer user_data)
+{
+  g_assert_not_reached ();
+  return G_SOURCE_REMOVE;
+}
+
+
+/* Plinius: run the main loop until the debounced bucket change happens */
+static void
+wait_for_brightness (PhoshAutoBrightnessBucket *bucket)
+{
+  g_autoptr (GMainLoop) loop = g_main_loop_new (NULL, FALSE);
+  gulong handler;
+  guint timeout;
+
+  handler = g_signal_connect_swapped (bucket, "notify::brightness",
+                                      G_CALLBACK (on_brightness_changed), loop);
+  timeout = g_timeout_add_seconds (10, on_too_late, NULL);
+  g_main_loop_run (loop);
+  g_source_remove (timeout);
+  g_signal_handler_disconnect (bucket, handler);
+}
+
+
 static void
 test_phosh_auto_brightness_bucket_brightness (void)
 {
@@ -20,6 +52,8 @@ test_phosh_auto_brightness_bucket_brightness (void)
   brightness = phosh_auto_brightness_get_brightness (auto_brightness);
   g_assert_cmpfloat_with_epsilon (brightness, 0.55, DBL_EPSILON);
 
+  /* Plinius: after a reset the next level applies at once */
+  phosh_auto_brightness_bucket_reset (bucket);
   phosh_auto_brightness_add_ambient_level (auto_brightness, 8000.0);
   brightness = phosh_auto_brightness_get_brightness (auto_brightness);
   g_assert_cmpfloat_with_epsilon (brightness, 1.3, DBL_EPSILON);
@@ -28,7 +62,17 @@ test_phosh_auto_brightness_bucket_brightness (void)
   brightness = phosh_auto_brightness_get_brightness (auto_brightness);
   g_assert_cmpfloat_with_epsilon (brightness, 1.3, DBL_EPSILON);
 
+  /* Plinius: a short change doesn't count */
+  phosh_auto_brightness_add_ambient_level (auto_brightness, 0.0);
+  brightness = phosh_auto_brightness_get_brightness (auto_brightness);
+  g_assert_cmpfloat_with_epsilon (brightness, 1.3, DBL_EPSILON);
+  phosh_auto_brightness_add_ambient_level (auto_brightness, 8000.0);
+  brightness = phosh_auto_brightness_get_brightness (auto_brightness);
+  g_assert_cmpfloat_with_epsilon (brightness, 1.3, DBL_EPSILON);
+
+  /* Plinius: one that stays does, after a while */
   phosh_auto_brightness_add_ambient_level (auto_brightness, 0.0);
+  wait_for_brightness (bucket);
   brightness = phosh_auto_brightness_get_brightness (auto_brightness);
   g_assert_cmpfloat_with_epsilon (brightness, 0.1, DBL_EPSILON);
 
@@ -37,6 +81,7 @@ test_phosh_auto_brightness_bucket_brightness (void)
   g_assert_cmpfloat_with_epsilon (brightness, 0.1, DBL_EPSILON);
 
   phosh_auto_brightness_add_ambient_level (auto_brightness, 11.0);
+  wait_for_brightness (bucket);
   brightness = phosh_auto_brightness_get_brightness (auto_brightness);
   g_assert_cmpfloat_with_epsilon (brightness, 0.25, DBL_EPSILON);
 
