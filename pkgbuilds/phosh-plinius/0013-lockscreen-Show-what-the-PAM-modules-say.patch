From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 31 Oct 2026 02:40:00 +0100
Subject: [PATCH] lockscreen: Show what the PAM modules say

Plinius: the conversation dropped PAM error and info messages ("TBD").
PhoshAuth now keeps the last one of a try (phosh_auth_get_message) and
the lock screen shows it after a wrong PIN instead of "Enter Passcode",
e.g. "Too many wrong PINs. Next try in 5 minutes." from
pam_plinius_pinguard. Without a message nothing changes.
---
 src/auth.c       | 44 +++++++++++++++++++++++++++++++++++++++-----
 src/auth.h       |  1 +
 src/lockscreen.c |  6 ++++--
 3 files changed, 44 insertions(+), 7 deletions(-)

diff --git a/src/auth.c b/src/auth.c
index 44236081..cd9a4997 100644
--- a/src/auth.c
+++ b/src/auth.c
@@ -23,8 +23,16 @@ typedef struct _PhoshAuth {
   GObject       parent;
 
   pam_handle_t *pamh;
+  /* Plinius: the last message of the PAM modules in the last try */
+  char         *message;
 } PhoshAuth;
 
+/* What the conversation needs: the answer to give and where to keep messages */
+typedef struct {
+  const char *authtok;
+  PhoshAuth  *self;
+} ConvData;
+
 
 G_DEFINE_TYPE (PhoshAuth, phosh_auth, G_TYPE_OBJECT)
 
@@ -35,7 +43,7 @@ pam_conversation_cb (int                        num_msg,
                      struct pam_response      **resp,
                      void                      *appdata_ptr)
 {
-  const char *authtok = appdata_ptr;
+  ConvData *data = appdata_ptr;
   int ret = PAM_CONV_ERR;
   g_autofree struct pam_response *pam_resp = g_new0 (struct pam_response, num_msg);
 
@@ -46,11 +54,16 @@ pam_conversation_cb (int                        num_msg,
     switch (msg[i]->msg_style) {
     case PAM_PROMPT_ECHO_OFF:
     case PAM_PROMPT_ECHO_ON:
-      pam_resp[i].resp = g_strdup (authtok);
+      pam_resp[i].resp = g_strdup (data->authtok);
+      ret = PAM_SUCCESS;
+      break;
+    case PAM_ERROR_MSG:
+    case PAM_TEXT_INFO:
+      /* Plinius: kept for the lock screen, e.g. the wait after wrong PINs (plinius-pinguard) */
+      g_free (data->self->message);
+      data->self->message = g_strdup (msg[i]->msg);
       ret = PAM_SUCCESS;
       break;
-    case PAM_ERROR_MSG: /* TBD */
-    case PAM_TEXT_INFO: /* TBD */
     default:
       break;
     }
@@ -70,11 +83,14 @@ authenticate (PhoshAuth *self, const char *authtok)
   int ret;
   gboolean authenticated = FALSE;
   const char *username;
+  ConvData data = { .authtok = authtok, .self = self };
   const struct pam_conv conv = {
     .conv = pam_conversation_cb,
-    .appdata_ptr = (void*)authtok,
+    .appdata_ptr = &data,
   };
 
+  g_clear_pointer (&self->message, g_free);
+
   if (self->pamh == NULL) {
     username = g_get_user_name ();
     ret = pam_start ("phosh", username, &conv, &self->pamh);
@@ -142,6 +158,7 @@ phosh_auth_finalize (GObject *object)
       g_warning ("pam_end error %s", pam_strerror (self->pamh, ret));
     self->pamh = NULL;
   }
+  g_free (self->message);
 
   parent_class->finalize (object);
 }
@@ -193,3 +210,20 @@ phosh_auth_authenticate_finish (PhoshAuth     *self,
   g_return_val_if_fail (g_task_is_valid (result, self), FALSE);
   return g_task_propagate_boolean (G_TASK (result), error);
 }
+
+
+/**
+ * phosh_auth_get_message:
+ * @self: The auth object
+ *
+ * Plinius: the last message the PAM modules sent during the last try, if any; e.g.
+ * "Too many wrong PINs. Next try in 5 minutes." from pam_plinius_pinguard.
+ *
+ * Returns: (nullable): the message
+ */
+const char *
+phosh_auth_get_message (PhoshAuth *self)
+{
+  g_return_val_if_fail (PHOSH_IS_AUTH (self), NULL);
+  return self->message;
+}
diff --git a/src/auth.h b/src/auth.h
index b6c5cb87..2de25749 100644
--- a/src/auth.h
+++ b/src/auth.h
@@ -24,4 +24,5 @@ void     phosh_auth_authenticate_async (PhoshAuth           *self,
 gboolean phosh_auth_authenticate_finish (PhoshAuth     *self,
                                          GAsyncResult  *result,
                                          GError       **error);
+const char *phosh_auth_get_message (PhoshAuth *self);
 
diff --git a/src/lockscreen.c b/src/lockscreen.c
index 7841b109..da676482 100644
--- a/src/lockscreen.c
+++ b/src/lockscreen.c
@@ -501,8 +501,10 @@ on_auth_authenticate_ready (GObject *source_object, GAsyncResult *result, gpoint
     /* For a PIN the end of the shake animation does this (finish_shake_entry) */
     gtk_widget_set_sensitive (GTK_WIDGET (self), TRUE);
   } else {
-    /* give visual feedback on error */
-    phosh_lockscreen_set_unlock_status (self, _("Enter Passcode"));
+    /* give visual feedback on error; Plinius: with what the PAM modules said, e.g. the wait */
+    const char *message = phosh_auth_get_message (auth);
+
+    phosh_lockscreen_set_unlock_status (self, message ? message : _("Enter Passcode"));
     phosh_lockscreen_shake_pin_entry (self);
     phosh_keypad_distribute (PHOSH_KEYPAD (priv->keypad));
   }
