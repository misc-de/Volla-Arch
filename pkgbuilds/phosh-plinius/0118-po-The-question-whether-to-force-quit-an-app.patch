diff --git a/po/de.po b/po/de.po
index 92810d38..70336bc0 100644
--- a/po/de.po
+++ b/po/de.po
@@ -1739,3 +1739,35 @@ msgstr "Link läuft – tippen zum Beenden"
 
 msgid "Stop casting to this TV"
 msgstr "Streaming auf diesen Fernseher beenden"
+
+#. Plinius: the title of the question after holding an app's card while swiping it away
+#: src/overview.c
+#, c-format
+msgid "Force Quit %s?"
+msgstr "%s zwangsweise beenden?"
+
+#. Plinius: the question whether to force quit an app
+#: src/overview.c
+msgid "The app ends at once. Anything not saved is lost."
+msgstr "Die App wird sofort beendet. Nicht Gespeichertes geht verloren."
+
+#. Plinius: the title when no running process of an app to force quit was found
+#: src/overview.c
+#, c-format
+msgid "Cannot Force Quit %s"
+msgstr "%s lässt sich nicht zwangsweise beenden"
+
+#. Plinius: no app to force quit
+#: src/overview.c
+msgid "No running process of the app was found."
+msgstr "Es wurde kein laufender Prozess der App gefunden."
+
+#. Plinius: the button of the dialog that found no app to force quit
+#: src/overview.c
+msgid "Close"
+msgstr "Schließen"
+
+#. Plinius: the button that kills an app that does not close
+#: src/overview.c
+msgid "Force Quit"
+msgstr "Beenden erzwingen"
