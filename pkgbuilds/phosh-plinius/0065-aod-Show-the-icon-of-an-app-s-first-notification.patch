From 7c920917fc9bda6b395a95ef34e10be11e96f689 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 7 Nov 2026 00:47:03 +0100
Subject: [PATCH] aod: Show the icon of an app's first notification

The list announces a new source before the notification is in it. The
always-on display then saw it empty, skipped it, and nothing told it
about the notification afterwards: the first message of an app that
arrived during the always-on display stayed without an icon. Look at the
list once the addition is through.
---
 src/aod.c | 30 ++++++++++++++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/src/aod.c b/src/aod.c
index fa9fa55b..55f02238 100644
--- a/src/aod.c
+++ b/src/aod.c
@@ -56,6 +56,7 @@ struct _PhoshAod {
   GtkWidget             *box_icons;
 
   PhoshNotificationList *notifications;
+  guint                  update_icons_id;
   char                  *flag_file;
 };
 
@@ -111,7 +112,7 @@ on_wall_clock_changed (PhoshAod *self, GParamSpec *pspec, PhoshWallClock *wall_c
 
 
 static void
-on_notifications_changed (PhoshAod *self)
+update_icons (PhoshAod *self)
 {
   g_autoptr (GPtrArray) names = g_ptr_array_new_with_free_func (g_free);
   guint n_sources, n_icons = 0, n_more = 0;
@@ -166,6 +167,30 @@ on_notifications_changed (PhoshAod *self)
 }
 
 
+static gboolean
+on_update_icons_idle (gpointer data)
+{
+  PhoshAod *self = PHOSH_AOD (data);
+
+  self->update_icons_id = 0;
+  update_icons (self);
+
+  return G_SOURCE_REMOVE;
+}
+
+
+/* The list announces an app's new source before the first notification is in it */
+static void
+on_notifications_changed (PhoshAod *self)
+{
+  if (self->update_icons_id)
+    return;
+
+  self->update_icons_id = g_idle_add (on_update_icons_idle, self);
+  g_source_set_name_by_id (self->update_icons_id, "[phosh-aod] update icons");
+}
+
+
 static void
 phosh_aod_set_property (GObject      *obj,
                         guint         prop_id,
@@ -213,6 +238,7 @@ phosh_aod_dispose (GObject *object)
     g_unlink (self->flag_file);
     g_clear_pointer (&self->flag_file, g_free);
   }
+  g_clear_handle_id (&self->update_icons_id, g_source_remove);
   g_clear_object (&self->notifications);
   g_clear_object (&self->monitor);
 
@@ -292,7 +318,7 @@ phosh_aod_constructed (GObject *object)
     g_signal_connect_object (self->notifications, "items-changed",
                              G_CALLBACK (on_notifications_changed), self, G_CONNECT_SWAPPED);
   }
-  on_notifications_changed (self);
+  update_icons (self);
 
   /* Tell plinius-suspend to wake the phone for the clock */
   runtime_dir = g_get_user_runtime_dir ();
