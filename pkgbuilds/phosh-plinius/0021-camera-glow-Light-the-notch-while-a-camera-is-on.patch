From b0b5968f673d484ed073d18ff89915e3b3beee99 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sat, 31 Oct 2026 15:47:26 +0100
Subject: [PATCH] camera-glow: Light the notch while a camera is on

Plinius: a white glow around the notch while a camera streams, so that
nobody films unnoticed. camera-hal-bridge tells on the session bus
whether a camera is on (org.plinius.CameraBridge, property Active).

The glow is a soft white disc behind the camera hole on an overlay layer
surface; the hole has no pixels, so a ring of light shows around it.
It fades in and out, takes no input (the notch stays tappable for the
search) and shows on the lock screen too. Without a notch in the top bar
there is no glow.
---
 src/camera-glow.c | 287 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 src/camera-glow.h |  19 ++++
 src/meson.build   |   1 +
 src/shell.c       |   5 +
 4 files changed, 312 insertions(+)

diff --git a/src/camera-glow.c b/src/camera-glow.c
new file mode 100644
index 00000000..673bf0b7
--- /dev/null
+++ b/src/camera-glow.c
@@ -0,0 +1,287 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-camera-glow"
+
+#include "phosh-config.h"
+
+#include "camera-glow.h"
+#include "layersurface.h"
+#include "layout-manager.h"
+#include "shell-priv.h"
+
+#include <math.h>
+
+/**
+ * PhoshCameraGlow:
+ *
+ * Plinius: a white glow around the notch while a camera is on, so that nobody films
+ * unnoticed. camera-hal-bridge tells on the session bus whether a camera streams
+ * (org.plinius.CameraBridge, property Active).
+ *
+ * The glow is a soft white disc behind the camera hole. The hole itself has no pixels,
+ * so what shows is a ring of light around it, wherever exactly the hole sits in the
+ * notch. The surface takes no input: the notch stays tappable. Without a notch in the
+ * top bar (no panel data, phone turned) there is no glow.
+ */
+
+#define BRIDGE_NAME      "org.plinius.CameraBridge"
+#define BRIDGE_PATH      "/org/plinius/CameraBridge"
+#define BRIDGE_INTERFACE "org.plinius.CameraBridge"
+
+#define GLOW_SPREAD 5     /* how far the light reaches beyond the notch, logical px */
+#define FADE_US     300000
+
+struct _PhoshCameraGlow {
+  GObject           parent;
+
+  GDBusProxy       *proxy;
+  GCancellable     *cancel;
+
+  GtkWidget        *surface;   /* while shown or fading out */
+  GdkRectangle      notch;     /* in surface coordinates */
+  double            level;     /* 0 … 1, how bright the glow is now */
+  gboolean          on;        /* where the fade goes */
+  guint             tick_id;
+  gint64            last_frame;
+};
+
+G_DEFINE_TYPE (PhoshCameraGlow, phosh_camera_glow, G_TYPE_OBJECT)
+
+
+static gboolean
+on_draw (PhoshCameraGlow *self, cairo_t *cr, GtkWidget *area)
+{
+  double cx = self->notch.x + self->notch.width / 2.0;
+  double cy = self->notch.y + self->notch.height / 2.0;
+  double inner = MIN (self->notch.width, self->notch.height) / 2.0;
+  double outer = inner + GLOW_SPREAD;
+  cairo_pattern_t *glow = cairo_pattern_create_radial (cx, cy, 0, cx, cy, outer);
+  double edge = inner / outer;
+
+  /* Full light up to the notch's edge, then a soft falloff */
+  cairo_pattern_add_color_stop_rgba (glow, 0.0, 1, 1, 1, self->level);
+  cairo_pattern_add_color_stop_rgba (glow, edge, 1, 1, 1, self->level);
+  cairo_pattern_add_color_stop_rgba (glow, edge + (1 - edge) * 0.35, 1, 1, 1, 0.45 * self->level);
+  cairo_pattern_add_color_stop_rgba (glow, 1.0, 1, 1, 1, 0);
+
+  cairo_set_operator (cr, CAIRO_OPERATOR_SOURCE);
+  cairo_set_source_rgba (cr, 0, 0, 0, 0);
+  cairo_paint (cr);
+  cairo_set_operator (cr, CAIRO_OPERATOR_OVER);
+  cairo_set_source (cr, glow);
+  cairo_arc (cr, cx, cy, outer, 0, 2 * G_PI);
+  cairo_fill (cr);
+  cairo_pattern_destroy (glow);
+
+  return GDK_EVENT_STOP;
+}
+
+
+/* No input at all: taps go to the top bar and the notch below */
+static void
+on_surface_realized (GtkWidget *surface)
+{
+  cairo_region_t *region = cairo_region_create ();
+
+  gtk_widget_input_shape_combine_region (surface, region);
+  cairo_region_destroy (region);
+}
+
+
+static void
+destroy_surface (PhoshCameraGlow *self)
+{
+  if (self->tick_id && self->surface)
+    gtk_widget_remove_tick_callback (self->surface, self->tick_id);
+  self->tick_id = 0;
+  g_clear_pointer (&self->surface, gtk_widget_destroy);
+  self->level = 0;
+}
+
+
+/* Not from the surface's own tick callback: GTK still uses the widget after it */
+static gboolean
+on_faded_out (gpointer user_data)
+{
+  PhoshCameraGlow *self = PHOSH_CAMERA_GLOW (user_data);
+
+  if (!self->on && self->level <= 0)
+    destroy_surface (self);
+  g_object_unref (self);
+  return G_SOURCE_REMOVE;
+}
+
+
+static gboolean
+on_tick (GtkWidget *surface, GdkFrameClock *clock, gpointer user_data)
+{
+  PhoshCameraGlow *self = PHOSH_CAMERA_GLOW (user_data);
+  gint64 now = gdk_frame_clock_get_frame_time (clock);
+  double step = self->last_frame ? (double)(now - self->last_frame) / FADE_US : 0;
+
+  self->last_frame = now;
+  self->level = CLAMP (self->level + (self->on ? step : -step), 0, 1);
+  gtk_widget_queue_draw (surface);
+
+  if (self->on && self->level >= 1) {
+    self->tick_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+  if (!self->on && self->level <= 0) {
+    self->tick_id = 0;
+    g_idle_add (on_faded_out, g_object_ref (self));
+    return G_SOURCE_REMOVE;
+  }
+  return G_SOURCE_CONTINUE;
+}
+
+
+static void
+start_fade (PhoshCameraGlow *self)
+{
+  if (self->tick_id || !self->surface)
+    return;
+  self->last_frame = 0;
+  self->tick_id = gtk_widget_add_tick_callback (self->surface, on_tick, self, NULL);
+}
+
+
+static gboolean
+create_surface (PhoshCameraGlow *self)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  PhoshMonitor *monitor = phosh_shell_get_builtin_monitor (shell);
+  PhoshWayland *wl = phosh_wayland_get_default ();
+  GdkRectangle notch;
+  GtkWidget *area;
+  int left;
+
+  if (!monitor ||
+      !phosh_layout_manager_get_top_bar_notch (phosh_shell_get_layout_manager (shell), &notch))
+    return FALSE;
+
+  /* The surface covers the notch and the light around it */
+  left = MAX (0, notch.x - GLOW_SPREAD);
+  self->notch = (GdkRectangle) {
+    .x = notch.x - left,
+    .y = notch.y,
+    .width = notch.width,
+    .height = notch.height,
+  };
+
+  self->surface = g_object_new (PHOSH_TYPE_LAYER_SURFACE,
+                                "layer-shell", phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                                "wl-output", phosh_monitor_get_wl_output (monitor),
+                                "anchor", ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT,
+                                "layer", ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+                                "kbd-interactivity", FALSE,
+                                /* Over the top bar, not below its exclusive zone */
+                                "exclusive-zone", -1,
+                                "margin-left", left,
+                                "width", self->notch.x + notch.width + GLOW_SPREAD,
+                                "height", notch.y + notch.height + GLOW_SPREAD,
+                                "namespace", "phosh camera-glow",
+                                NULL);
+  gtk_widget_set_name (self->surface, "camera-glow");
+  g_signal_connect (self->surface, "realize", G_CALLBACK (on_surface_realized), NULL);
+
+  area = gtk_drawing_area_new ();
+  g_signal_connect_object (area, "draw", G_CALLBACK (on_draw), self, G_CONNECT_SWAPPED);
+  gtk_container_add (GTK_CONTAINER (self->surface), area);
+  gtk_widget_show_all (self->surface);
+
+  return TRUE;
+}
+
+
+static void
+update (PhoshCameraGlow *self)
+{
+  g_autoptr (GVariant) active = NULL;
+  gboolean on;
+
+  if (self->proxy)
+    active = g_dbus_proxy_get_cached_property (self->proxy, "Active");
+  on = active && g_variant_is_of_type (active, G_VARIANT_TYPE_BOOLEAN) &&
+    g_variant_get_boolean (active);
+
+  if (on == self->on)
+    return;
+  self->on = on;
+  g_debug ("Camera %s", on ? "on" : "off");
+
+  if (on && !self->surface && !create_surface (self))
+    return;
+  start_fade (self);
+}
+
+
+static void
+on_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PhoshCameraGlow *self;
+  g_autoptr (GError) err = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (res, &err);
+
+  if (!proxy) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Failed to watch the camera bridge: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_CAMERA_GLOW (user_data);
+  self->proxy = proxy;
+  /* A bridge that goes away (crash, restart) also turns the glow off */
+  g_signal_connect_object (proxy, "g-properties-changed", G_CALLBACK (update), self,
+                           G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (update), self,
+                           G_CONNECT_SWAPPED);
+  update (self);
+}
+
+
+static void
+phosh_camera_glow_dispose (GObject *object)
+{
+  PhoshCameraGlow *self = PHOSH_CAMERA_GLOW (object);
+
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  g_clear_object (&self->proxy);
+  destroy_surface (self);
+
+  G_OBJECT_CLASS (phosh_camera_glow_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_camera_glow_class_init (PhoshCameraGlowClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+  object_class->dispose = phosh_camera_glow_dispose;
+}
+
+
+static void
+phosh_camera_glow_init (PhoshCameraGlow *self)
+{
+  self->cancel = g_cancellable_new ();
+  /* Watch without starting anything: the bridge is a user service of its own */
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION,
+                            G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                            NULL, BRIDGE_NAME, BRIDGE_PATH, BRIDGE_INTERFACE,
+                            self->cancel, on_proxy_ready, self);
+}
+
+
+PhoshCameraGlow *
+phosh_camera_glow_new (void)
+{
+  return g_object_new (PHOSH_TYPE_CAMERA_GLOW, NULL);
+}
