-/* Plinius: width of a box's visible children (the box's own padding is the layout's) */
+/* Plinius: width of a box's first visible children (the box's own padding is the layout's) */
 static int
-get_content_width (GtkWidget *box)
+get_first_children_width (GtkWidget *box, guint max)
 {
   g_autoptr (GList) children = gtk_container_get_children (GTK_CONTAINER (box));
   int spacing = gtk_box_get_spacing (GTK_BOX (box));
   int width = 0, n = 0;
+  guint i = 0;
 
-  for (GList *l = children; l; l = l->next) {
+  for (GList *l = children; l && i < max; l = l->next, i++) {
     int nat;
 
     if (!gtk_widget_get_visible (l->data))
@@ -1252,6 +1255,57 @@ get_content_width (GtkWidget *box)
 }
 
 
+static int
+get_content_width (GtkWidget *box)
+{
+  return get_first_children_width (box, G_MAXUINT);
+}
+
+
+/* Modem and Wi-Fi come first in the network box (top-panel.ui) */
+#define NETWORK_LEFT_ICONS 2
+#define NETWORK_SPLIT_MARGIN 4 /* px */
+
+/*
+ * Plinius: the network box is too wide for the room between a clock on the left and the notch as
+ * soon as a few icons show, and then all of it jumps past the notch. So the two icons that show
+ * nearly always, modem and Wi-Fi, stay there when they fit; the others go to the front of the
+ * indicators. Always these two, so that nothing moves when another icon comes or goes.
+ */
+static void
+split_network_box (PhoshTopPanel *self, gboolean split)
+{
+  g_autoptr (GList) children = NULL;
+  guint i = 0;
+
+  if (split == (self->network_moved != NULL))
+    return;
+
+  if (!split) {
+    for (i = 0; i < self->network_moved->len; i++) {
+      GtkWidget *child = g_ptr_array_index (self->network_moved, i);
+
+      gtk_container_remove (GTK_CONTAINER (self->box_indicators), child);
+      gtk_box_pack_start (GTK_BOX (self->box_network), child, FALSE, FALSE, 0);
+    }
+    g_clear_pointer (&self->network_moved, g_ptr_array_unref);
+    return;
+  }
+
+  self->network_moved = g_ptr_array_new_with_free_func (g_object_unref);
+  children = gtk_container_get_children (GTK_CONTAINER (self->box_network));
+  for (GList *l = children; l; l = l->next, i++) {
+    if (i < NETWORK_LEFT_ICONS)
+      continue;
+
+    g_ptr_array_add (self->network_moved, g_object_ref (l->data));
+    gtk_container_remove (GTK_CONTAINER (self->box_network), l->data);
+    gtk_box_pack_start (GTK_BOX (self->box_indicators), l->data, FALSE, FALSE, 0);
+    gtk_box_reorder_child (GTK_BOX (self->box_indicators), l->data, self->network_moved->len - 1);
+  }
+}
+
+
 /*
  * Plinius: tell the layout manager what the clock and the icon boxes need. Runs after
  * every allocation of the top bar; the layout only changes when the sizes do. The clock
@@ -1263,12 +1317,17 @@ report_widths (gpointer data)
   PhoshTopPanel *self = PHOSH_TOP_PANEL (data);
   PhoshLayoutManager *layout_manager = phosh_shell_get_layout_manager (phosh_shell_get_default ());
   PangoLayout *layout = gtk_label_get_layout (GTK_LABEL (self->lbl_clock));
-  int clock = 0;
+  int clock = 0, room, left;
 
   self->report_widths_id = 0;
   if (layout)
     pango_layout_get_pixel_size (layout, &clock, NULL);
 
+  room = phosh_layout_manager_get_top_bar_left_room (layout_manager, clock);
+  left = get_first_children_width (self->box_network, NETWORK_LEFT_ICONS);
+  /* A little more room to move them there than to keep them, or a minute's clock could flip it */
+  split_network_box (self, room >= left + (self->network_moved ? 0 : NETWORK_SPLIT_MARGIN));
+
   phosh_layout_manager_set_top_bar_widths (layout_manager,
                                            clock,
                                            get_content_width (self->box_network),
