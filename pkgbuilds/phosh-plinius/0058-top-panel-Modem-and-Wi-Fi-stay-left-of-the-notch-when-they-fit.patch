From: misc-de <misc-de@users.noreply.github.com>
Subject: [PATCH] top-panel: Modem and Wi-Fi stay left of the notch when they fit

Plinius: with the clock on the left, the whole network box moved past the notch as soon as it did
not fit beside the clock, which one more icon was enough for, although there was room for the two
that show nearly all the time. They stay on the left now if they fit, and the other network
icons go to the front of the indicators.
---
 src/layout-manager.c | 31 ++++++++++++++++++++++++
 src/layout-manager.h |  2 ++
 src/top-panel.c      | 67 ++++++++++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 96 insertions(+), 4 deletions(-)

diff --git a/src/layout-manager.c b/src/layout-manager.c
index d6014e58..265a5bbb 100644
--- a/src/layout-manager.c
+++ b/src/layout-manager.c
@@ -692,6 +692,37 @@ phosh_layout_manager_get_box_shifts (PhoshLayoutManager *self,
 }
 
 
+/**
+ * phosh_layout_manager_get_top_bar_left_room:
+ * @self: The layout manager
+ * @clock: The width of the clock
+ *
+ * Plinius: how much room a clock at the left edge leaves before the notch, so the top bar can
+ * tell which icons fit there.
+ *
+ * Returns: The room in pixels, -1 if the clock is not at the left of a notch
+ */
+int
+phosh_layout_manager_get_top_bar_left_room (PhoshLayoutManager *self, int clock)
+{
+  GdkRectangle notch;
+
+  g_return_val_if_fail (PHOSH_IS_LAYOUT_MANAGER (self), -1);
+
+  if (self->layout != PHOSH_SHELL_LAYOUT_DEVICE || self->builtin == NULL)
+    return -1;
+  if (phosh_monitor_get_transform (self->builtin) != PHOSH_MONITOR_TRANSFORM_NORMAL)
+    return -1;
+  if (self->clock_pos != PHOSH_LAYOUT_CLOCK_POS_LEFT)
+    return -1;
+  if (!get_top_bar_notch (self, phosh_monitor_get_fractional_scale (self->builtin), &notch))
+    return -1;
+
+  return notch.x - PHOSH_TOP_BAR_CUTOUT_MIN_PADDING -
+    ((int) self->corner_shift + clock + CLOCK_SIDE_PADDING);
+}
+
+
 /**
  * phosh_layout_manager_get_side_box_shift:
  * @self: The layout manager
