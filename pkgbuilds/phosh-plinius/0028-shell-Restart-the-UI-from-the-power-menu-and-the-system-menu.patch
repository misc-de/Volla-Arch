diff --git a/src/shell.c b/src/shell.c
index 9dc4e16a..da2d957a 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -156,6 +156,7 @@ typedef struct {
   PhoshCameraGlow            *camera_glow; /* Plinius: lights the notch while a camera is on */
   gboolean                    overview_visible;
   GPtrArray                  *faders; /* for final fade out */
+  gboolean                    restart_requested; /* Plinius: quit so that systemd starts us again */
   GStrv log_domains;
 
   PhoshOsdWindow             *osd;
@@ -2589,6 +2590,60 @@ phosh_shell_get_default (void)
   return instance;
 }
 
+static gboolean
+on_restart_timeout (gpointer unused)
+{
+  g_message ("Quitting so that the shell gets started again");
+  gtk_main_quit ();
+
+  return G_SOURCE_REMOVE;
+}
+
+/**
+ * phosh_shell_restart:
+ * @self: The shell
+ *
+ * Restart the shell (Plinius): fade out and quit with a failure status.
+ * The systemd user unit (`Restart=on-failure`) then starts the shell
+ * again while the compositor and the running apps stay. Like at every
+ * start without a display manager the new shell comes up locked.
+ */
+void
+phosh_shell_restart (PhoshShell *self)
+{
+  PhoshShellPrivate *priv;
+  guint id;
+
+  g_return_if_fail (PHOSH_IS_SHELL (self));
+  priv = phosh_shell_get_instance_private (self);
+
+  if (priv->restart_requested)
+    return;
+
+  priv->restart_requested = TRUE;
+  phosh_shell_fade_out (self, 0);
+  /* Give the faders a moment to cover the screen */
+  id = g_timeout_add (500, on_restart_timeout, NULL);
+  g_source_set_name_by_id (id, "[PhoshShell] restart");
+}
+
+/**
+ * phosh_shell_get_restart_requested:
+ * @self: The shell
+ *
+ * Returns: %TRUE if the shell quits to get started again (Plinius)
+ */
+gboolean
+phosh_shell_get_restart_requested (PhoshShell *self)
+{
+  PhoshShellPrivate *priv;
+
+  g_return_val_if_fail (PHOSH_IS_SHELL (self), FALSE);
+  priv = phosh_shell_get_instance_private (self);
+
+  return priv->restart_requested;
+}
+
 void
 phosh_shell_fade_out (PhoshShell *self, guint timeout)
 {
