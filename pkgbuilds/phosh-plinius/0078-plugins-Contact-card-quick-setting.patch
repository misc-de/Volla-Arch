+#include "cardshare-quick-setting.h"
+#include "plugin-shell.h"
+#include "quick-setting.h"
+#include "status-icon.h"
+#include "status-page.h"
+
+#include <handy.h>
+#include <glib/gi18n.h>
+#include <qrcodegen.h>
+
+#define CARDSHARE_BUS_NAME "org.plinius.CardShare"
+#define CARDSHARE_OBJECT_PATH "/org/plinius/CardShare"
+#define CARDSHARE_INTERFACE "org.plinius.CardShare"
+
+/* Large enough for a phone camera at arm's length, small enough for the status page to keep
+ * its footer on a 360 x 800 screen */
+#define QR_CODE_SIZE 176
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (cairo_t, cairo_destroy)
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (cairo_surface_t, cairo_surface_destroy)
+
+/**
+ * PhoshCardshareQuickSetting:
+ *
+ * The own contact card for another phone, and cards from others, through plinius-cardshare
+ * (org.plinius.CardShare on the session bus). "Share My Card" offers the card for a while
+ * over NFC (the phone emulates a tag) and as a QR code on the status page; "Receive a Card"
+ * waits for an NFC tag with a card and for a card pushed over Bluetooth. Received cards are
+ * listed until added to the contacts or dismissed.
+ *
+ * The service does the work and puts NFC and Bluetooth back as they were; the tile shows
+ * its state. Nothing starts while the phone is locked. A long press and the footer open
+ * the page in GNOME Settings where the own contact and its fields are chosen.
+ */
+struct _PhoshCardshareQuickSetting {
+  PhoshQuickSetting  parent;
+
+  PhoshStatusIcon   *info;
+  PhoshStatusPage   *status_page;
+  GtkStack          *stack;
+  GtkListBox        *choices;
+  HdyActionRow      *share_row;
+  HdyActionRow      *receive_row;
+  GtkImage          *qr_image;
+  GtkLabel          *share_hint;
+  GtkLabel          *receive_hint;
+  GtkWidget         *session_box;
+  GtkProgressBar    *progress;
+  GtkLabel          *remaining_label;
+  GtkListBox        *received_list;
+  GtkLabel          *locked_label;
+  GtkLabel          *message_label;
+
+  GDBusProxy        *proxy;
+  GCancellable      *cancel;
+  /* What the QR code shows, to draw it only when the card changes */
+  char              *qr_text;
+  /* Last result of an action (added to contacts, card read), shown below the page */
+  char              *message;
+};
+G_DEFINE_TYPE (PhoshCardshareQuickSetting, phosh_cardshare_quick_setting, PHOSH_TYPE_QUICK_SETTING);
+
+
+static cairo_surface_t *
+qr_from_text (const char *text, int size, int scale)
+{
+  uint8_t qr_code[qrcodegen_BUFFER_LEN_FOR_VERSION (qrcodegen_VERSION_MAX)];
+  uint8_t temp_buf[qrcodegen_BUFFER_LEN_FOR_VERSION (qrcodegen_VERSION_MAX)];
+  g_autoptr (cairo_t) cr = NULL;
+  cairo_surface_t *surface;
+  int pixel_size, qr_size, padding;
+
+  if (!qrcodegen_encodeText (text, temp_buf, qr_code, qrcodegen_Ecc_LOW,
+                             qrcodegen_VERSION_MIN, qrcodegen_VERSION_MAX,
+                             qrcodegen_Mask_AUTO, FALSE))
+    return NULL;
+
+  surface = cairo_image_surface_create (CAIRO_FORMAT_RGB24, size * scale, size * scale);
+  cairo_surface_set_device_scale (surface, scale, scale);
+  cr = cairo_create (surface);
+  cairo_set_antialias (cr, CAIRO_ANTIALIAS_NONE);
+
+  /* White, also in the dark style: scanners expect dark modules on light ground */
+  cairo_set_source_rgba (cr, 1, 1, 1, 1);
+  cairo_rectangle (cr, 0, 0, size, size);
+  cairo_fill (cr);
+
+  qr_size = qrcodegen_getSize (qr_code);
+  pixel_size = MAX (1, size / qr_size);
+  padding = (size - qr_size * pixel_size) / 2;
+  /* Keep a quiet zone of a few modules around the code */
+  if (pixel_size > 2 && padding < 2 * pixel_size) {
+    pixel_size--;
+    padding = (size - qr_size * pixel_size) / 2;
+  }
+
+  cairo_set_source_rgba (cr, 0, 0, 0, 1);
+  for (int row = 0; row < qr_size; row++) {
+    for (int column = 0; column < qr_size; column++) {
+      if (qrcodegen_getModule (qr_code, column, row)) {
+        cairo_rectangle (cr, column * pixel_size + padding, row * pixel_size + padding,
+                         pixel_size, pixel_size);
+      }
+    }
+  }
+  cairo_fill (cr);
+
+  return surface;
+}
+
+
+static char *
+get_string (PhoshCardshareQuickSetting *self, const char *name)
+{
+  g_autoptr (GVariant) value = NULL;
+
+  if (self->proxy)
+    value = g_dbus_proxy_get_cached_property (self->proxy, name);
+  if (!value || !g_variant_is_of_type (value, G_VARIANT_TYPE_STRING))
+    return g_strdup ("");
+  return g_variant_dup_string (value, NULL);
+}
+
+
+static guint
+get_uint (PhoshCardshareQuickSetting *self, const char *name)
+{
+  g_autoptr (GVariant) value = NULL;
+
+  if (self->proxy)
+    value = g_dbus_proxy_get_cached_property (self->proxy, name);
+  if (!value || !g_variant_is_of_type (value, G_VARIANT_TYPE_UINT32))
+    return 0;
+  return g_variant_get_uint32 (value);
+}
+
+
+static GStrv
+get_strv (PhoshCardshareQuickSetting *self, const char *name)
+{
+  g_autoptr (GVariant) value = NULL;
+
+  if (self->proxy)
+    value = g_dbus_proxy_get_cached_property (self->proxy, name);
+  if (!value || !g_variant_is_of_type (value, G_VARIANT_TYPE_STRING_ARRAY))
+    return g_new0 (char *, 1);
+  return g_variant_dup_strv (value, NULL);
+}
+
+
+static void
+set_message (PhoshCardshareQuickSetting *self, const char *message)
+{
+  g_free (self->message);
+  self->message = g_strdup (message);
+}
+
+
+static void on_import_clicked (GtkButton *button, PhoshCardshareQuickSetting *self);
+static void on_dismiss_clicked (GtkButton *button, PhoshCardshareQuickSetting *self);
+
+
+static void
+update_received (PhoshCardshareQuickSetting *self)
+{
+  g_autoptr (GVariant) value = NULL;
+  g_autoptr (GList) rows = gtk_container_get_children (GTK_CONTAINER (self->received_list));
+  GVariantIter iter;
+  const char *id, *name, *detail;
+  gboolean any = FALSE;
+
+  for (GList *l = rows; l; l = l->next)
+    gtk_widget_destroy (l->data);
+
+  if (self->proxy)
+    value = g_dbus_proxy_get_cached_property (self->proxy, "Received");
+  if (value && g_variant_is_of_type (value, G_VARIANT_TYPE ("a(sss)"))) {
+    g_variant_iter_init (&iter, value);
+    while (g_variant_iter_next (&iter, "(&s&s&s)", &id, &name, &detail)) {
+      GtkWidget *row = hdy_action_row_new ();
+      /* Icon buttons: the name needs the room of the row */
+      GtkWidget *add = gtk_button_new_from_icon_name ("list-add-symbolic", GTK_ICON_SIZE_BUTTON);
+      GtkWidget *dismiss = gtk_button_new_from_icon_name ("window-close-symbolic",
+                                                          GTK_ICON_SIZE_BUTTON);
+
+      hdy_preferences_row_set_title (HDY_PREFERENCES_ROW (row), name);
+      hdy_action_row_set_subtitle (HDY_ACTION_ROW (row), detail);
+      hdy_action_row_set_icon_name (HDY_ACTION_ROW (row), "avatar-default-symbolic");
+
+      gtk_widget_set_valign (add, GTK_ALIGN_CENTER);
+      gtk_widget_set_tooltip_text (add, _("Add to Contacts"));
+      gtk_style_context_add_class (gtk_widget_get_style_context (add), "suggested-action");
+      g_object_set_data_full (G_OBJECT (add), "card-id", g_strdup (id), g_free);
+      g_signal_connect (add, "clicked", G_CALLBACK (on_import_clicked), self);
+
+      gtk_widget_set_valign (dismiss, GTK_ALIGN_CENTER);
+      gtk_widget_set_tooltip_text (dismiss, _("Dismiss"));
+      gtk_style_context_add_class (gtk_widget_get_style_context (dismiss), "flat");
+      g_object_set_data_full (G_OBJECT (dismiss), "card-id", g_strdup (id), g_free);
+      g_signal_connect (dismiss, "clicked", G_CALLBACK (on_dismiss_clicked), self);
+
+      gtk_container_add (GTK_CONTAINER (row), add);
+      gtk_container_add (GTK_CONTAINER (row), dismiss);
+      gtk_widget_show_all (row);
+      gtk_container_add (GTK_CONTAINER (self->received_list), row);
+      any = TRUE;
+    }
+  }
+  gtk_widget_set_visible (GTK_WIDGET (self->received_list), any);
+}
+
+
+static void
+update (PhoshCardshareQuickSetting *self)
+{
+  g_autofree char *state = get_string (self, "State");
+  g_autofree char *card_name = get_string (self, "CardName");
+  g_autofree char *card_text = get_string (self, "CardText");
+  g_autofree char *bt_name = get_string (self, "BluetoothName");
+  g_autofree char *error = get_string (self, "Error");
+  g_autofree char *remaining_text = NULL;
+  g_auto (GStrv) channels = get_strv (self, "Channels");
+  guint remaining = get_uint (self, "Remaining");
+  guint duration = get_uint (self, "Duration");
+  gboolean locked = phosh_shell_get_locked (phosh_shell_get_default ());
+  gboolean sharing = g_strcmp0 (state, "sharing") == 0;
+  gboolean receiving = g_strcmp0 (state, "receiving") == 0;
+  gboolean nfc = g_strv_contains ((const char * const *) channels, "nfc");
+  gboolean bluetooth = g_strv_contains ((const char * const *) channels, "bluetooth");
+  const char *message;
+
+  /* Tile: what runs, and for how long */
+  phosh_quick_setting_set_active (PHOSH_QUICK_SETTING (self), sharing || receiving);
+  if (sharing || receiving) {
+    /* Translators: the tile while sharing or receiving, short (the tile is narrow) */
+    g_autofree char *text = g_strdup_printf (_("%u s left"), remaining);
+    phosh_status_icon_set_info (self->info, text);
+  } else {
+    /* Translators: the tile, short (the tile is narrow) */
+    phosh_status_icon_set_info (self->info, _("My Card"));
+  }
+
+  /* Status page */
+  gtk_stack_set_visible_child_name (self->stack, sharing ? "sharing" :
+                                    receiving ? "receiving" : "idle");
+  hdy_action_row_set_subtitle (self->share_row,
+                               *card_name ? card_name : _("No card chosen yet"));
+  gtk_widget_set_sensitive (GTK_WIDGET (self->choices), !locked);
+  gtk_widget_set_visible (GTK_WIDGET (self->locked_label), locked && !sharing && !receiving);
+
+  if (sharing && g_strcmp0 (card_text, self->qr_text) != 0) {
+    g_autoptr (cairo_surface_t) surface = NULL;
+
+    g_free (self->qr_text);
+    self->qr_text = g_strdup (card_text);
+    surface = qr_from_text (card_text, QR_CODE_SIZE,
+                            gtk_widget_get_scale_factor (GTK_WIDGET (self->qr_image)));
+    gtk_image_set_from_surface (self->qr_image, surface);
+  } else if (!sharing && self->qr_text) {
+    g_clear_pointer (&self->qr_text, g_free);
+    gtk_image_clear (self->qr_image);
+  }
+  gtk_label_set_text (self->share_hint, nfc ?
+                      _("Hold the other phone to the back of this one, or let it scan the code") :
+                      _("Let the other phone scan the code"));
+
+  if (bluetooth) {
+    g_autofree char *hint = NULL;
+
+    /* Translators: %s is the phone's Bluetooth name */
+    hint = g_strdup_printf (_("Hold an NFC card to the back of the phone. From another phone, "
+                              "share the contact over Bluetooth to “%s”."), bt_name);
+    gtk_label_set_text (self->receive_hint, hint);
+  } else if (nfc) {
+    gtk_label_set_text (self->receive_hint, _("Hold an NFC card to the back of the phone"));
+  } else {
+    gtk_label_set_text (self->receive_hint, _("Neither NFC nor Bluetooth is available"));
+  }
+
+  gtk_widget_set_visible (self->session_box, sharing || receiving);
+  gtk_progress_bar_set_fraction (self->progress,
+                                 duration ? (double) remaining / duration : 0.0);
+  /* Translators: seconds left while sharing or receiving */
+  remaining_text = g_strdup_printf (_("%u s left"), remaining);
+  gtk_label_set_text (self->remaining_label, remaining_text);
+
+  /* A problem of the service first, then the last result */
+  message = *error ? error : self->message;
+  gtk_label_set_text (self->message_label, message ? message : "");
+  gtk_widget_set_visible (GTK_WIDGET (self->message_label), message && *message);
+}
+
+
+static void
+on_properties_changed (PhoshCardshareQuickSetting *self, GVariant *changed, GStrv invalidated)
+{
+  g_autoptr (GVariant) received = g_variant_lookup_value (changed, "Received", NULL);
+  g_autoptr (GVariant) state = g_variant_lookup_value (changed, "State", NULL);
+
+  /* A new session starts without the result of the last one; the end of a session keeps
+   * it (e.g. "Your card was read", which comes just before) */
+  if (state && g_strcmp0 (g_variant_get_string (state, NULL), "idle") != 0)
+    set_message (self, NULL);
+  if (received)
+    update_received (self);
+  update (self);
+}
+
+
+static void
+on_name_owner_changed (PhoshCardshareQuickSetting *self)
+{
+  update_received (self);
+  update (self);
+}
+
+
+static void
+on_call_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  PhoshCardshareQuickSetting *self;
+
+  if (g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  self = PHOSH_CARDSHARE_QUICK_SETTING (user_data);
+  if (err) {
+    g_dbus_error_strip_remote_error (err);
+    g_warning ("Contact card: %s", err->message);
+    set_message (self, err->message);
+  } else if (reply && g_variant_is_of_type (reply, G_VARIANT_TYPE ("(s)"))) {
+    /* Import: the name of the added contact */
+    const char *name;
+    g_autofree char *text = NULL;
+
+    g_variant_get (reply, "(&s)", &name);
+    /* Translators: %s is the name of a received contact */
+    text = g_strdup_printf (_("“%s” added to Contacts"), name);
+    set_message (self, text);
+  }
+  update (self);
+}
+
+
+static void
+call (PhoshCardshareQuickSetting *self, const char *method, GVariant *params)
+{
+  if (!self->proxy) {
+    if (params)
+      g_variant_unref (g_variant_ref_sink (params));
+    return;
+  }
+
+  set_message (self, NULL);
+  /* Share and Receive switch NFC on and wait until it polls: a few seconds */
+  g_dbus_proxy_call (self->proxy, method, params, G_DBUS_CALL_FLAGS_NONE, 20000,
+                     self->cancel, on_call_done, self);
+}
+
+
+static void
+on_import_clicked (GtkButton *button, PhoshCardshareQuickSetting *self)
+{
+  const char *id = g_object_get_data (G_OBJECT (button), "card-id");
+
+  gtk_widget_set_sensitive (GTK_WIDGET (button), FALSE);
+  call (self, "Import", g_variant_new ("(s)", id));
+}
+
+
+static void
+on_dismiss_clicked (GtkButton *button, PhoshCardshareQuickSetting *self)
+{
+  const char *id = g_object_get_data (G_OBJECT (button), "card-id");
+
+  call (self, "Dismiss", g_variant_new ("(s)", id));
+}
+
+
+static void
+on_choice_activated (PhoshCardshareQuickSetting *self, GtkListBoxRow *row)
+{
+  if (row == GTK_LIST_BOX_ROW (self->share_row))
+    call (self, "Share", NULL);
+  else if (row == GTK_LIST_BOX_ROW (self->receive_row))
+    call (self, "Receive", NULL);
+}
+
+
+static void
+on_extend_clicked (PhoshCardshareQuickSetting *self)
+{
+  call (self, "Extend", NULL);
+}
+
+
+static void
+on_stop_clicked (PhoshCardshareQuickSetting *self)
+{
+  call (self, "Stop", NULL);
+}
+
+
+static void
+on_clicked (PhoshCardshareQuickSetting *self)
+{
+  /* A tap on the running tile stops it, otherwise it offers the two choices */
+  if (phosh_quick_setting_get_active (PHOSH_QUICK_SETTING (self))) {
+    call (self, "Stop", NULL);
+    return;
+  }
+  g_signal_emit_by_name (self, "show-status");
+}
+
+
+static void
+on_signal (PhoshCardshareQuickSetting *self, const char *sender, const char *signal_name,
+           GVariant *params)
+{
+  if (g_strcmp0 (signal_name, "CardRead") == 0) {
+    set_message (self, _("Your card was read"));
+    update (self);
+  }
+}
+
+
+static void
+on_showing_status (PhoshCardshareQuickSetting *self)
+{
+  if (!self->proxy || !phosh_quick_setting_get_showing_status (PHOSH_QUICK_SETTING (self)))
+    return;
+
+  /* The service exits when idle; a ping starts it so the page shows the chosen card */
+  g_dbus_proxy_call (self->proxy, "org.freedesktop.DBus.Peer.Ping", NULL,
+                     G_DBUS_CALL_FLAGS_NONE, 5000, self->cancel, NULL, NULL);
+}
+
+
+static void
+on_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PhoshCardshareQuickSetting *self;
+  g_autoptr (GError) err = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (res, &err);
+
+  if (!proxy) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Failed to create the plinius-cardshare proxy: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_CARDSHARE_QUICK_SETTING (user_data);
+  self->proxy = proxy;
+  g_signal_connect_object (proxy, "g-properties-changed", G_CALLBACK (on_properties_changed),
+                           self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "g-signal", G_CALLBACK (on_signal), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (on_name_owner_changed),
+                           self, G_CONNECT_SWAPPED);
+  on_name_owner_changed (self);
+  on_showing_status (self);
+}
+
+
+static void
+phosh_cardshare_quick_setting_dispose (GObject *object)
+{
+  PhoshCardshareQuickSetting *self = PHOSH_CARDSHARE_QUICK_SETTING (object);
+
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  g_clear_object (&self->proxy);
+
+  G_OBJECT_CLASS (phosh_cardshare_quick_setting_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_cardshare_quick_setting_finalize (GObject *object)
+{
+  PhoshCardshareQuickSetting *self = PHOSH_CARDSHARE_QUICK_SETTING (object);
+
+  g_free (self->qr_text);
+  g_free (self->message);
+
+  G_OBJECT_CLASS (phosh_cardshare_quick_setting_parent_class)->finalize (object);
+}
+
+
+static void
+phosh_cardshare_quick_setting_class_init (PhoshCardshareQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_cardshare_quick_setting_dispose;
+  object_class->finalize = phosh_cardshare_quick_setting_finalize;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/cardshare-quick-setting/qs.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, info);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, status_page);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, stack);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, choices);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, share_row);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, receive_row);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, qr_image);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, share_hint);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, receive_hint);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, session_box);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, progress);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, remaining_label);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, received_list);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, locked_label);
+  gtk_widget_class_bind_template_child (widget_class, PhoshCardshareQuickSetting, message_label);
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+  gtk_widget_class_bind_template_callback (widget_class, on_choice_activated);
+  gtk_widget_class_bind_template_callback (widget_class, on_extend_clicked);
+  gtk_widget_class_bind_template_callback (widget_class, on_stop_clicked);
+}
+
+
+static void
+phosh_cardshare_quick_setting_init (PhoshCardshareQuickSetting *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+  gtk_icon_theme_add_resource_path (gtk_icon_theme_get_default (),
+                                    "/mobi/phosh/plugins/cardshare-quick-setting/icons");
+
+  g_signal_connect_object (phosh_shell_get_default (), "notify::locked", G_CALLBACK (update),
+                           self, G_CONNECT_SWAPPED);
+  g_signal_connect (self, "notify::showing-status", G_CALLBACK (on_showing_status), NULL);
+
+  self->cancel = g_cancellable_new ();
+  update (self);
+  /* Auto-start allowed: the service starts on the first call and exits when idle */
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SESSION,
+                            G_DBUS_PROXY_FLAGS_NONE,
+                            NULL, CARDSHARE_BUS_NAME, CARDSHARE_OBJECT_PATH,
+                            CARDSHARE_INTERFACE,
+                            self->cancel, on_proxy_ready, self);
+}
