diff --git a/plugins/cardshare-quick-setting/meson.build b/plugins/cardshare-quick-setting/meson.build
new file mode 100644
index 00000000..08853ed9
--- /dev/null
+++ b/plugins/cardshare-quick-setting/meson.build
@@ -0,0 +1,48 @@
+# Plinius: the own contact card over NFC, QR code and Bluetooth, through plinius-cardshare (org.plinius.CardShare)
+name = 'cardshare-quick-setting'
+
+cardshare_quick_setting_resources = gnome.compile_resources(
+  'phosh-plugin-cardshare-quick-setting-resources',
+  'phosh-plugin-cardshare-quick-setting.gresources.xml',
+  c_name: 'phosh_plugin_cardshare_quick_setting',
+)
+
+cardshare_quick_setting_plugin_sources = files(
+  'cardshare-quick-setting.c',
+  'phosh-plugin-cardshare-quick-setting.c',
+)
+
+phosh_cardshare_quick_setting_plugin = shared_module(
+  'phosh-plugin-cardshare-quick-setting',
+  cardshare_quick_setting_plugin_sources,
+  cardshare_quick_setting_resources,
+  c_args: [
+    '-DG_LOG_DOMAIN="phosh-plugin-@0@"'.format(name),
+    '-DPLUGIN_NAME="@0@"'.format(name),
+  ],
+  dependencies: [plugin_dep, dependency('qrcodegen')],
+  install: true,
+  install_dir: plugins_dir,
+)
+
+pluginconf = configuration_data()
+pluginconf.set('name', name)
+pluginconf.set('plugins_dir', plugins_dir)
+
+i18n.merge_file(
+  input: configure_file(
+    input: name + '.desktop.in.in',
+    output: name + '.desktop.in',
+    configuration: pluginconf,
+  ),
+  output: name + '.plugin',
+  po_dir: meson.project_source_root() / 'po',
+  install: true,
+  install_dir: plugins_dir,
+  type: 'desktop',
+)
+
+install_data(
+  'icons/cardshare-quick-setting-symbolic.svg',
+  install_dir: phosh_plugin_icon_dir,
+)
