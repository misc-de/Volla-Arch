diff --git a/plugins/cardshare-quick-setting/qs.ui b/plugins/cardshare-quick-setting/qs.ui
new file mode 100644
index 00000000..a6f13c4c
--- /dev/null
+++ b/plugins/cardshare-quick-setting/qs.ui
@@ -0,0 +1,214 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<interface>
+  <requires lib="gtk+" version="3.24"/>
+  <template class="PhoshCardshareQuickSetting" parent="PhoshQuickSetting">
+    <property name="status-icon">info</property>
+    <property name="status-page">status_page</property>
+    <signal name="clicked" handler="on_clicked" object="PhoshCardshareQuickSetting" swapped="yes"/>
+    <!-- The Contact Card page of GNOME Settings: which contact, which fields -->
+    <property name="long-press-action-name">panel.launch-panel</property>
+    <property name="long-press-action-target">(&quot;contact-card&quot;, [&lt;&quot;&quot;&gt;])</property>
+  </template>
+  <object class="PhoshStatusIcon" id="info">
+    <property name="visible">1</property>
+    <property name="pixel-size">16</property>
+    <property name="icon-name">contact-card-symbolic</property>
+    <property name="info" translatable="yes">My Card</property>
+  </object>
+  <object class="PhoshStatusPage" id="status_page">
+    <property name="visible">1</property>
+    <property name="title" translatable="yes">Contact Card</property>
+    <property name="content">content</property>
+    <property name="footer">footer</property>
+  </object>
+  <object class="GtkBox" id="content">
+    <property name="visible">1</property>
+    <property name="orientation">vertical</property>
+    <property name="spacing">12</property>
+    <child>
+      <object class="GtkStack" id="stack">
+        <property name="visible">1</property>
+        <property name="vhomogeneous">0</property>
+        <property name="transition-type">crossfade</property>
+        <!-- Nothing runs: the two choices -->
+        <child>
+          <object class="GtkListBox" id="choices">
+            <property name="visible">1</property>
+            <property name="selection-mode">none</property>
+            <property name="hexpand">1</property>
+            <signal name="row-activated" handler="on_choice_activated" object="PhoshCardshareQuickSetting" swapped="yes"/>
+            <style>
+              <class name="content"/>
+            </style>
+            <child>
+              <object class="HdyActionRow" id="share_row">
+                <property name="visible">1</property>
+                <property name="activatable">1</property>
+                <property name="icon-name">send-to-symbolic</property>
+                <property name="title" translatable="yes">Share My Card</property>
+                <property name="subtitle-lines">1</property>
+              </object>
+            </child>
+            <child>
+              <object class="HdyActionRow" id="receive_row">
+                <property name="visible">1</property>
+                <property name="activatable">1</property>
+                <property name="icon-name">contact-new-symbolic</property>
+                <property name="title" translatable="yes">Receive a Card</property>
+                <property name="subtitle" translatable="yes">Over NFC or Bluetooth</property>
+              </object>
+            </child>
+          </object>
+          <packing>
+            <property name="name">idle</property>
+          </packing>
+        </child>
+        <!-- Sharing: the card as a QR code, NFC at the same time -->
+        <child>
+          <object class="GtkBox">
+            <property name="visible">1</property>
+            <property name="orientation">vertical</property>
+            <property name="spacing">12</property>
+            <child>
+              <object class="GtkImage" id="qr_image">
+                <property name="visible">1</property>
+                <property name="halign">center</property>
+                <style>
+                  <class name="cardshare-qr"/>
+                </style>
+              </object>
+            </child>
+            <child>
+              <object class="GtkLabel" id="share_hint">
+                <property name="visible">1</property>
+                <property name="wrap">1</property>
+                <property name="justify">center</property>
+              </object>
+            </child>
+          </object>
+          <packing>
+            <property name="name">sharing</property>
+          </packing>
+        </child>
+        <!-- Receiving: NFC and Bluetooth wait for a card -->
+        <child>
+          <object class="GtkBox">
+            <property name="visible">1</property>
+            <property name="orientation">vertical</property>
+            <property name="spacing">12</property>
+            <child>
+              <object class="GtkImage">
+                <property name="visible">1</property>
+                <property name="icon-name">contact-card-symbolic</property>
+                <property name="pixel-size">64</property>
+                <style>
+                  <class name="dim-label"/>
+                </style>
+              </object>
+            </child>
+            <child>
+              <object class="GtkLabel" id="receive_hint">
+                <property name="visible">1</property>
+                <property name="wrap">1</property>
+                <property name="justify">center</property>
+              </object>
+            </child>
+          </object>
+          <packing>
+            <property name="name">receiving</property>
+          </packing>
+        </child>
+      </object>
+    </child>
+    <!-- Time left, more time, stop -->
+    <child>
+      <object class="GtkBox" id="session_box">
+        <property name="visible">0</property>
+        <property name="orientation">vertical</property>
+        <property name="spacing">6</property>
+        <child>
+          <object class="GtkProgressBar" id="progress">
+            <property name="visible">1</property>
+          </object>
+        </child>
+        <child>
+          <object class="GtkBox">
+            <property name="visible">1</property>
+            <property name="spacing">6</property>
+            <child>
+              <object class="GtkLabel" id="remaining_label">
+                <property name="visible">1</property>
+                <property name="hexpand">1</property>
+                <property name="xalign">0</property>
+                <style>
+                  <class name="dim-label"/>
+                  <class name="numeric"/>
+                </style>
+              </object>
+            </child>
+            <child>
+              <object class="GtkButton">
+                <property name="visible">1</property>
+                <property name="label" translatable="yes">+30 s</property>
+                <signal name="clicked" handler="on_extend_clicked" object="PhoshCardshareQuickSetting" swapped="yes"/>
+              </object>
+            </child>
+            <child>
+              <object class="GtkButton">
+                <property name="visible">1</property>
+                <property name="label" translatable="yes">Stop</property>
+                <signal name="clicked" handler="on_stop_clicked" object="PhoshCardshareQuickSetting" swapped="yes"/>
+              </object>
+            </child>
+          </object>
+        </child>
+      </object>
+    </child>
+    <!-- Cards that came in, until added or dismissed -->
+    <child>
+      <object class="GtkListBox" id="received_list">
+        <property name="visible">0</property>
+        <property name="selection-mode">none</property>
+        <property name="hexpand">1</property>
+        <style>
+          <class name="content"/>
+        </style>
+      </object>
+    </child>
+    <child>
+      <object class="GtkLabel" id="locked_label">
+        <property name="visible">0</property>
+        <property name="wrap">1</property>
+        <property name="xalign">0</property>
+        <property name="label" translatable="yes">Unlock the phone to share or receive a card</property>
+        <style>
+          <class name="dim-label"/>
+        </style>
+      </object>
+    </child>
+    <child>
+      <object class="GtkLabel" id="message_label">
+        <property name="visible">0</property>
+        <property name="wrap">1</property>
+        <property name="xalign">0</property>
+        <style>
+          <class name="dim-label"/>
+        </style>
+      </object>
+    </child>
+  </object>
+  <object class="GtkButton" id="footer">
+    <property name="visible">1</property>
+    <property name="hexpand">1</property>
+    <property name="focus-on-click">0</property>
+    <property name="action-name">panel.launch-panel</property>
+    <property name="action-target">(&quot;contact-card&quot;, [&lt;&quot;&quot;&gt;])</property>
+    <child>
+      <object class="GtkLabel">
+        <property name="visible">1</property>
+        <property name="ellipsize">end</property>
+        <property name="label" translatable="yes">Card Settings</property>
+      </object>
+    </child>
+  </object>
+</interface>
