+ */
+
+#pragma once
+
+#include "status-icon.h"
+
+#include <gtk/gtk.h>
+
+G_BEGIN_DECLS
+
+#define PHOSH_TYPE_AIRPLANE_INFO (phosh_airplane_info_get_type ())
