diff --git a/src/airplane-info.c b/src/airplane-info.c
new file mode 100644
index 00000000..c3464f2a
--- /dev/null
+++ b/src/airplane-info.c
@@ -0,0 +1,247 @@
+/*
+ * Copyright (C) 2026 The Phosh Developers
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-airplane-info"
+
+#include "phosh-config.h"
+
+#include "airplane-info.h"
+#include "util.h"
+
+#include "dbus/gsd-rfkill-dbus.h"
+
+#include <glib/gi18n.h>
+
+#define BUS_NAME "org.gnome.SettingsDaemon.Rfkill"
+#define OBJECT_PATH "/org/gnome/SettingsDaemon/Rfkill"
+
+/**
+ * PhoshAirplaneInfo:
+ *
+ * A widget to display and switch airplane mode
+ *
+ * #PhoshAirplaneInfo follows gnome-settings-daemon's rfkill plugin. Its
+ * `AirplaneMode` blocks all rfkill switches (Wi-Fi, Bluetooth) and switches
+ * NetworkManager's `WwanEnabled` off, which disables the modems through
+ * ModemManager. #PhoshAirplaneInfo:enabled is whether airplane mode is on
+ * (in software or by a hardware switch), #PhoshAirplaneInfo:present whether
+ * gnome-settings-daemon offers it.
+ */
+
+enum {
+  PROP_0,
+  PROP_ENABLED,
+  PROP_PRESENT,
+  PROP_LAST_PROP
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+
+struct _PhoshAirplaneInfo {
+  PhoshStatusIcon  parent;
+
+  gboolean         enabled;
+  gboolean         present;
+  PhoshDBusRfkill *proxy;
+  GCancellable    *cancel;
+};
+G_DEFINE_TYPE (PhoshAirplaneInfo, phosh_airplane_info, PHOSH_TYPE_STATUS_ICON);
+
+
+static void
+phosh_airplane_info_get_property (GObject    *object,
+                                  guint       property_id,
+                                  GValue     *value,
+                                  GParamSpec *pspec)
+{
+  PhoshAirplaneInfo *self = PHOSH_AIRPLANE_INFO (object);
+
+  switch (property_id) {
+  case PROP_ENABLED:
+    g_value_set_boolean (value, self->enabled);
+    break;
+  case PROP_PRESENT:
+    g_value_set_boolean (value, self->present);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+sync_state (PhoshAirplaneInfo *self)
+{
+  g_autofree char *owner = NULL;
+  gboolean enabled, present;
+
+  owner = g_dbus_proxy_get_name_owner (G_DBUS_PROXY (self->proxy));
+  present = owner && phosh_dbus_rfkill_get_should_show_airplane_mode (self->proxy);
+  enabled = present &&
+    (phosh_dbus_rfkill_get_airplane_mode (self->proxy) ||
+     phosh_dbus_rfkill_get_hardware_airplane_mode (self->proxy));
+
+  g_debug ("Airplane mode present: %d, enabled: %d", present, enabled);
+
+  if (self->present != present) {
+    self->present = present;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_PRESENT]);
+  }
+
+  if (self->enabled != enabled) {
+    self->enabled = enabled;
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_ENABLED]);
+  }
+}
+
+
+static void
+on_proxy_new_for_bus_finish (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  PhoshAirplaneInfo *self;
+  PhoshDBusRfkill *proxy;
+  g_autoptr (GError) err = NULL;
+
+  proxy = phosh_dbus_rfkill_proxy_new_for_bus_finish (res, &err);
+  if (!proxy) {
+    phosh_dbus_service_error_warn (err, "Failed to get gsd rfkill proxy");
+    return;
+  }
+
+  self = PHOSH_AIRPLANE_INFO (user_data);
+  self->proxy = proxy;
+
+  g_object_connect (self->proxy,
+                    "swapped-object-signal::notify::airplane-mode",
+                    G_CALLBACK (sync_state), self,
+                    "swapped-object-signal::notify::hardware-airplane-mode",
+                    G_CALLBACK (sync_state), self,
+                    "swapped-object-signal::notify::should-show-airplane-mode",
+                    G_CALLBACK (sync_state), self,
+                    "swapped-object-signal::notify::g-name-owner",
+                    G_CALLBACK (sync_state), self,
+                    NULL);
+  sync_state (self);
+}
+
+
+static void
+phosh_airplane_info_idle_init (PhoshStatusIcon *icon)
+{
+  PhoshAirplaneInfo *self = PHOSH_AIRPLANE_INFO (icon);
+
+  phosh_dbus_rfkill_proxy_new_for_bus (G_BUS_TYPE_SESSION,
+                                       G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                                       BUS_NAME,
+                                       OBJECT_PATH,
+                                       self->cancel,
+                                       on_proxy_new_for_bus_finish,
+                                       self);
+}
+
+
+static void
+phosh_airplane_info_dispose (GObject *object)
+{
+  PhoshAirplaneInfo *self = PHOSH_AIRPLANE_INFO (object);
+
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+
+  if (self->proxy) {
+    g_signal_handlers_disconnect_by_data (self->proxy, self);
+    g_clear_object (&self->proxy);
+  }
+
+  G_OBJECT_CLASS (phosh_airplane_info_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_airplane_info_class_init (PhoshAirplaneInfoClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  PhoshStatusIconClass *status_icon_class = PHOSH_STATUS_ICON_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_airplane_info_dispose;
+  object_class->get_property = phosh_airplane_info_get_property;
+
+  status_icon_class->idle_init = phosh_airplane_info_idle_init;
+
+  gtk_widget_class_set_css_name (widget_class, "phosh-airplane-info");
+
+  /**
+   * PhoshAirplaneInfo:enabled:
+   *
+   * Whether airplane mode is on
+   */
+  props[PROP_ENABLED] =
+    g_param_spec_boolean ("enabled", "", "",
+                          FALSE,
+                          G_PARAM_READABLE | G_PARAM_STATIC_STRINGS | G_PARAM_EXPLICIT_NOTIFY);
+  /**
+   * PhoshAirplaneInfo:present:
+   *
+   * Whether airplane mode can be switched
+   */
+  props[PROP_PRESENT] =
+    g_param_spec_boolean ("present", "", "",
+                          FALSE,
+                          G_PARAM_READABLE | G_PARAM_STATIC_STRINGS | G_PARAM_EXPLICIT_NOTIFY);
+
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+}
+
+
+static void
+phosh_airplane_info_init (PhoshAirplaneInfo *self)
+{
+  self->cancel = g_cancellable_new ();
+
+  phosh_status_icon_set_icon_name (PHOSH_STATUS_ICON (self), "airplane-mode-symbolic");
+  /* Plinius: the tile's name; whether it is on shows in the accent color, not in words */
+  phosh_status_icon_set_info (PHOSH_STATUS_ICON (self), _("Airplane Mode"));
+}
+
+
+GtkWidget *
+phosh_airplane_info_new (void)
+{
+  return g_object_new (PHOSH_TYPE_AIRPLANE_INFO, NULL);
+}
+
+
+gboolean
+phosh_airplane_info_get_enabled (PhoshAirplaneInfo *self)
+{
+  g_return_val_if_fail (PHOSH_IS_AIRPLANE_INFO (self), FALSE);
+
+  return self->enabled;
+}
+
+/**
+ * phosh_airplane_info_set_enabled:
+ * @self: The airplane info
+ * @enabled: Whether to switch airplane mode on
+ *
+ * Switches airplane mode through gnome-settings-daemon: on blocks Wi-Fi and
+ * Bluetooth and disables the modems, off unblocks them again. The
+ * #PhoshAirplaneInfo:enabled property follows once gnome-settings-daemon
+ * reports the new state.
+ */
+void
+phosh_airplane_info_set_enabled (PhoshAirplaneInfo *self, gboolean enabled)
+{
+  g_return_if_fail (PHOSH_IS_AIRPLANE_INFO (self));
+
+  if (!self->proxy || !self->present)
+    return;
+
+  g_debug ("Switching airplane mode %s", enabled ? "on" : "off");
+  phosh_dbus_rfkill_set_airplane_mode (self->proxy, enabled);
+}
