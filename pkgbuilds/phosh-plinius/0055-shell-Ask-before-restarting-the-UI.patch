diff --git a/src/end-session-dialog.c b/src/end-session-dialog.c
index 474ecfa4..b824d032 100644
--- a/src/end-session-dialog.c
+++ b/src/end-session-dialog.c
@@ -192,6 +192,12 @@ end_session_dialog_update (PhoshEndSessionDialog *self)
                                              seconds),
                                    seconds);
     break;
+  case PHOSH_END_SESSION_ACTION_RESTART_UI:
+    /* Plinius: no countdown, without an answer nothing happens */
+    title = _("Restart UI");
+    description = g_strdup (_("Do you really want to restart the interface? "
+                              "Open apps keep running and the phone gets locked."));
+    break;
   default:
     g_return_if_reached ();
   }
@@ -199,7 +205,9 @@ end_session_dialog_update (PhoshEndSessionDialog *self)
   phosh_system_modal_dialog_set_title (PHOSH_SYSTEM_MODAL_DIALOG (self), title);
 
   gtk_label_set_label (GTK_LABEL (self->lbl_subtitle), description);
-  gtk_button_set_label (GTK_BUTTON (self->btn_confirm), title);
+  /* Plinius: the title of the restart question is too long for half of the dialog */
+  gtk_button_set_label (GTK_BUTTON (self->btn_confirm),
+                        self->action == PHOSH_END_SESSION_ACTION_RESTART_UI ? _("Restart") : title);
 }
 
 
