--- a/src/shell-priv.h
+++ b/src/shell-priv.h
@@ -130,6 +130,7 @@ void                  phosh_shell_show_notification (PhoshShell             *sel
                                                      int                     timeout);
 
 /* Plinius: restart the shell through its systemd user unit */
+void                 phosh_shell_ask_restart            (PhoshShell *self);
 void                 phosh_shell_restart                (PhoshShell *self);
 gboolean             phosh_shell_get_restart_requested  (PhoshShell *self);
 
diff --git a/src/shell.c b/src/shell.c
index 948a3c8c..4cae9ff2 100644
--- a/src/shell.c
+++ b/src/shell.c
@@ -46,6 +46,7 @@
 #include "docked-info.h"
 #include "docked-manager.h"
 #include "emergency-calls-manager.h"
+#include "end-session-dialog.h"
 #include "fader.h"
 #include "aod.h"
 #include "feedbackinfo.h"
@@ -160,6 +161,7 @@ typedef struct {
   gboolean                    overview_visible;
   GPtrArray                  *faders; /* for final fade out */
   gboolean                    restart_requested; /* Plinius: quit so that systemd starts us again */
+  PhoshEndSessionDialog      *restart_dialog; /* Plinius: asks before the restart */
   GStrv log_domains;
 
   PhoshOsdWindow             *osd;
@@ -611,6 +613,10 @@ set_locked (PhoshShell *self, gboolean locked)
     return;
 
   priv->locked = locked;
+  /* Plinius: the question about a restart doesn't outlive the unlocked session */
+  if (locked && priv->restart_dialog)
+    g_clear_pointer ((PhoshSystemModalDialog **)&priv->restart_dialog,
+                     phosh_system_modal_dialog_close);
   phosh_shell_set_state (self, PHOSH_STATE_LOCKED, priv->locked);
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_LOCKED]);
 
@@ -738,6 +744,7 @@ phosh_shell_dispose (GObject *object)
   panels_dispose (self);
   g_clear_pointer (&priv->faders, g_ptr_array_unref);
 
+  g_clear_pointer (&priv->restart_dialog, phosh_cp_widget_destroy);
   g_clear_pointer (&priv->notification_banner, phosh_cp_widget_destroy);
 
   /* dispose managers in opposite order of declaration */
@@ -2701,6 +2708,49 @@ on_restart_timeout (gpointer unused)
   return G_SOURCE_REMOVE;
 }
 
+static void
+on_restart_dialog_closed (PhoshShell *self, PhoshEndSessionDialog *dialog)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  gboolean confirmed;
+
+  /* Already answered or closed by locking: a tap while it fades out counts for nothing */
+  if (priv->restart_dialog != dialog)
+    return;
+
+  confirmed = phosh_end_session_dialog_get_action_confirmed (dialog);
+  g_clear_pointer ((PhoshSystemModalDialog **)&priv->restart_dialog,
+                   phosh_system_modal_dialog_close);
+
+  if (confirmed)
+    phosh_shell_restart (self);
+}
+
+/**
+ * phosh_shell_ask_restart:
+ * @self: The shell
+ *
+ * Ask whether to restart the shell (Plinius) and do so if confirmed, see
+ * phosh_shell_restart(). Unlike a power off there is no countdown.
+ */
+void
+phosh_shell_ask_restart (PhoshShell *self)
+{
+  PhoshShellPrivate *priv;
+
+  g_return_if_fail (PHOSH_IS_SHELL (self));
+  priv = phosh_shell_get_instance_private (self);
+
+  if (priv->restart_dialog || priv->restart_requested)
+    return;
+
+  priv->restart_dialog = PHOSH_END_SESSION_DIALOG (
+    phosh_end_session_dialog_new (PHOSH_END_SESSION_ACTION_RESTART_UI, 0, NULL));
+  g_signal_connect_object (priv->restart_dialog, "closed",
+                           G_CALLBACK (on_restart_dialog_closed), self, G_CONNECT_SWAPPED);
+  gtk_widget_set_visible (GTK_WIDGET (priv->restart_dialog), TRUE);
+}
+
 /**
  * phosh_shell_restart:
  * @self: The shell
diff --git a/src/top-panel.c b/src/top-panel.c
index ae14837a..b9520fae 100644
--- a/src/top-panel.c
+++ b/src/top-panel.c
@@ -273,7 +273,7 @@ on_restart_shell_action (GSimpleAction *action,
 
   /* Plinius: only the shell, the compositor and the apps keep running */
   phosh_top_panel_fold (self);
-  phosh_shell_restart (phosh_shell_get_default ());
+  phosh_shell_ask_restart (phosh_shell_get_default ());
 }
 
 
