 /**
- * get_cutout_shifts:
+ * get_top_bar_layout:
  * @self: The layout manager
+ * @pad: The padding at both edges (at least the corner shift)
+ * @network:(out): Padding at the first child (the network box or the clock on the left)
+ * @indicators:(out): Padding at the last child (the indicators box or the clock on the right)
+ * @side:(out): Padding of the icon box next to a clock that moved to the left or right
  *
- * Get the shifts for network and indicator box.
+ * Plinius: place the clock and the two icon boxes around a notch.
  *
- * If the network box can't be left aligned due to the built-in
- * display having a notch shift it to the right. Similar for the
- * indicators but shift them to the left.
+ * Upstream assumes a 40 px clock and a fixed number of icons. The top bar reports the widths
+ * its clock (which can carry the weekday, the date and the calendar week) and its icon
+ * boxes really take, so the whole row is laid out from those: the clock stays in the center
+ * if it fits beside the notch, otherwise it moves to the side where everything fits (or
+ * overlaps the least). An icon box that would reach under the notch is pushed past it.
  *
  * We assume the panel uses its native orientation.
+ *
+ * Returns: The clock position
  */
-static void
-get_cutout_shifts (PhoshLayoutManager *self, guint *network, guint *indicators)
+static PhoshLayoutClockPosition
+get_top_bar_layout (PhoshLayoutManager *self, guint padding, guint *network, guint *indicators, guint *side)
 {
-  GListModel *cutouts;
+  GdkRectangle notch;
   float scale;
-  GdkRectangle indicators_box = indicators_box_rect;
-  GdkRectangle network_box = network_box_rect;
-  guint width;
+  int pad = padding;
+  int width, cw, nw, iw, nl, nr, left, right;
+  int overlap_left = 0, overlap_right = 0, side_left = 0, side_right = 0;
+  int ind_left = 0, net_right = 0;
 
-  if (self->layout != PHOSH_SHELL_LAYOUT_DEVICE)
-    goto out;
+  *network = *indicators = *side = 0;
 
-  if (self->builtin == NULL)
-    goto out;
+  if (self->layout != PHOSH_SHELL_LAYOUT_DEVICE || self->builtin == NULL)
+    return PHOSH_LAYOUT_CLOCK_POS_CENTER;
 
-  if (phosh_monitor_get_transform (self->builtin) != PHOSH_MONITOR_TRANSFORM_NORMAL)
-    goto out;
+  if (phosh_monitor_get_transform (self->builtin) != PHOSH_MONITOR_TRANSFORM_NORMAL) {
+    /* TODO: we can do better here */
+    return PHOSH_LAYOUT_CLOCK_POS_CENTER;
+  }
 
   scale = phosh_monitor_get_fractional_scale (self->builtin);
-  width = self->builtin->logical.width;
-
-  network_box.x = PHOSH_TOP_BAR_MIN_PADDING;
-  indicators_box.x = width - indicators_box.width - PHOSH_TOP_BAR_MIN_PADDING;
+  if (!get_top_bar_notch (self, scale, &notch))
+    return PHOSH_LAYOUT_CLOCK_POS_CENTER;
+
+  width = self->builtin->width / scale;
+  /* Until the top bar reported its sizes, use upstream's assumptions */
+  cw = self->clock_width >= 0 ? self->clock_width : center_clock_rect.width;
+  nw = self->network_width >= 0 ? self->network_width : network_box_rect.width;
+  iw = self->indicators_width >= 0 ? self->indicators_width : indicators_box_rect.width;
+  /* Keep a little distance to the notch */
+  nl = notch.x - PHOSH_TOP_BAR_CUTOUT_MIN_PADDING;
+  nr = notch.x + notch.width + PHOSH_TOP_BAR_CUTOUT_MIN_PADDING;
+
+  g_debug ("Top bar notch %d-%d, clock %d, network %d, indicators %d, width %d",
+           nl, nr, cw, nw, iw, width);
+
+  /* The clock in the center, the icon boxes at the edges or past the notch */
+  left = (width - cw) / 2;
+  right = left + cw;
+  if (right <= nl || left >= nr) {
+    if (pad + nw > nl && pad < nr)
+      *network = nr;
+    if (width - pad - iw < nr && width - pad > nl)
+      *indicators = width - nl;
+    return PHOSH_LAYOUT_CLOCK_POS_CENTER;
+  }
 
-  cutouts = gm_display_panel_get_cutouts (self->panel);
-  for (int i = 0; i < g_list_model_get_n_items (cutouts); i++) {
-    g_autoptr (GmCutout) cutout = g_list_model_get_item (cutouts, i);
-    const GmRect *phys_bounds = gm_cutout_get_bounds (cutout);
-    GdkRectangle bounds;
-    int available_space;
-
-    bounds = (GdkRectangle) {
-      .x = floor (phys_bounds->x / scale),
-      .y = floor (phys_bounds->y / scale),
-      .width = ceil (phys_bounds->width / scale),
-      .height = ceil (phys_bounds->height / scale),
-    };
+  /* The clock on the left, the network box after it (the clock gets extra padding there) */
+  right = pad + cw + CLOCK_SIDE_PADDING;
+  if (right > nl) {
+    overlap_left = right - nl;
+  } else if (right + nw > nl) {
+    side_left = nr - right;
+    overlap_left = MAX (0, nr + nw - (width - pad - iw));
+  }
+  if (width - pad - iw < nr && width - pad > nl)
+    ind_left = width - nl;
+
+  /* The clock on the right, the indicators box before it */
+  left = width - pad - cw - CLOCK_SIDE_PADDING;
+  if (left < nr) {
+    overlap_right = nr - left;
+  } else if (left - iw < nr) {
+    side_right = left - nl;
+    overlap_right = MAX (0, pad + nw - (nl - iw));
+  }
+  if (pad + nw > nl && pad < nr)
+    net_right = nr;
 
-    available_space = ((width - center_clock_rect.width) / 2) - (bounds.x + bounds.width) -
-      CORNER_CUTOUT_SHIFT_THRESHOLD;
-    if (gdk_rectangle_intersect (&bounds, &network_box, NULL) && available_space > 0)
-      *network = bounds.x + bounds.width + PHOSH_TOP_BAR_CUTOUT_MIN_PADDING;
+  if (overlap_left > 0 && overlap_right > 0)
+    g_warning ("No clock placement found to fully avoid notch (left: %d, right: %d)",
+               overlap_left, overlap_right);
 
-    available_space = ((width - center_clock_rect.width) / 2) - (width - bounds.x) -
-      CORNER_CUTOUT_SHIFT_THRESHOLD;
-    if (gdk_rectangle_intersect (&bounds, &indicators_box, NULL) && available_space > 0)
-      *indicators = (self->builtin->width / scale - bounds.x) + PHOSH_TOP_BAR_CUTOUT_MIN_PADDING;
+  if (overlap_left <= overlap_right) {
+    *side = side_left;
+    *indicators = ind_left;
+    return PHOSH_LAYOUT_CLOCK_POS_LEFT;
   }
 
- out:
-  *network = MAX (*network, PHOSH_TOP_BAR_MIN_PADDING);
-  *indicators = MAX (*indicators, PHOSH_TOP_BAR_MIN_PADDING);
-
-  g_debug ("Network box: %d, indicators shift: %d", *network, *indicators);
+  *side = side_right;
+  *network = net_right;
+  return PHOSH_LAYOUT_CLOCK_POS_RIGHT;
 }
 
 /**
@@ -309,7 +349,8 @@ G_GNUC_END_IGNORE_DEPRECATIONS
 /*
  * Plinius: builds the panel from the notch setting: a square around the camera hole at
  * the top edge (left, center or right), or no cutout at all. Rounded corners still come
- * from the device's panel data, if gmobile knows the device.
+ * from the device's panel data, if gmobile knows the device. "auto" takes the panel data
+ * of the device package (PLINIUS_PANEL_FILE), else gmobile's, else no cutout.
  */
 static void
 update_notch_panel (PhoshLayoutManager *self)
@@ -331,7 +372,15 @@ update_notch_panel (PhoshLayoutManager *self)
   top = NOTCH_TOP_MM * px_per_mm;
 
   notch = g_settings_get_string (self->plinius_settings, NOTCH_KEY);
-  if (g_str_equal (notch, "left"))
+  if (g_str_equal (notch, "auto")) {
+    GmDisplayPanel *known = self->file_panel ?: self->device_panel;
+
+    if (known) {
+      g_set_object (&self->panel, known);
+      g_debug ("Notch 'auto': %s", gm_display_panel_get_name (known));
+      return;
+    }
+  } else if (g_str_equal (notch, "left"))
     x = NOTCH_SIDE_MM * px_per_mm;
   else if (g_str_equal (notch, "center"))
     x = (monitor->width - size) / 2;
@@ -366,12 +415,13 @@ static void
 update_layout (PhoshLayoutManager *self)
 {
   PhoshLayoutClockPosition pos;
-  guint corner_shift, clock_box_shift = 0;
+  guint corner_shift, clock_box_shift = 0, side_box_shift = 0;
   guint network_box_shift = 0, indicators_box_shift = 0;
 
   corner_shift = get_corner_shift (self);
-  get_cutout_shifts (self, &network_box_shift, &indicators_box_shift);
-  pos = get_clock_pos (self, &clock_box_shift);
+  pos = get_top_bar_layout (self, corner_shift, &network_box_shift, &indicators_box_shift,
+                            &side_box_shift);
+  clock_box_shift = get_clock_box_shift (self);
 
   indicators_box_shift = MAX (indicators_box_shift, corner_shift);
   network_box_shift = MAX (network_box_shift, corner_shift);
@@ -379,6 +429,7 @@ update_layout (PhoshLayoutManager *self)
   if (self->corner_shift == corner_shift &&
       self->network_box_shift == network_box_shift &&
       self->indicators_box_shift == indicators_box_shift &&
+      self->side_box_shift == side_box_shift &&
       self->clock_pos == pos &&
       self->clock_box_shift == clock_box_shift) {
     return;
@@ -389,6 +440,7 @@ update_layout (PhoshLayoutManager *self)
   self->corner_shift = corner_shift;
   self->network_box_shift = network_box_shift;
   self->indicators_box_shift = indicators_box_shift;
+  self->side_box_shift = side_box_shift;
 
   g_signal_emit (self, signals[LAYOUT_CHANGED], 0);
 }
@@ -476,6 +528,7 @@ phosh_layout_manager_finalize (GObject *object)
   g_clear_object (&self->plinius_settings);
   g_clear_object (&self->panel);
   g_clear_object (&self->device_panel);
+  g_clear_object (&self->file_panel);
 
   G_OBJECT_CLASS (phosh_layout_manager_parent_class)->finalize (object);
 }
@@ -496,6 +549,33 @@ phosh_layout_manager_class_init (PhoshLayoutManagerClass *klass)
 }
 
 
+/* Plinius: the panel data of the device package, from the first data dir that has it */
+static GmDisplayPanel *
+load_file_panel (void)
+{
+  const char * const *dirs = g_get_system_data_dirs ();
+
+  for (int i = 0; dirs[i]; i++) {
+    g_autofree char *path = g_build_filename (dirs[i], PLINIUS_PANEL_FILE, NULL);
+    g_autofree char *data = NULL;
+    g_autoptr (GError) err = NULL;
+    GmDisplayPanel *panel;
+
+    if (!g_file_get_contents (path, &data, NULL, NULL))
+      continue;
+
+    panel = gm_display_panel_new_from_data (data, &err);
+    if (panel == NULL)
+      g_warning ("Failed to read panel data %s: %s", path, err ? err->message : "unknown");
+    else
+      g_debug ("Panel data from %s", path);
+    return panel;
+  }
+
+  return NULL;
+}
+
+
 static void
 phosh_layout_manager_init (PhoshLayoutManager *self)
 {
@@ -509,6 +589,7 @@ phosh_layout_manager_init (PhoshLayoutManager *self)
   self->network_box_shift = PHOSH_TOP_BAR_MIN_PADDING;
   self->indicators_box_shift = PHOSH_TOP_BAR_MIN_PADDING;
   self->corner_shift = PHOSH_TOP_BAR_MIN_PADDING;
+  self->clock_width = self->network_width = self->indicators_width = -1;
 
   self->settings = g_settings_new ("mobi.phosh.shell");
   g_signal_connect_object (self->settings, "changed::" SHELL_LAYOUT_KEY,
@@ -524,6 +605,9 @@ phosh_layout_manager_init (PhoshLayoutManager *self)
     g_set_object (&self->panel, self->device_panel);
   }
 
+  /* Plinius: the device package can describe the panel (cutouts) in gmobile's format */
+  self->file_panel = load_file_panel ();
+
   /* Plinius: with the notch setting the panel is built once the built-in monitor is known */
   if (source)
     schema = g_settings_schema_source_lookup (source, PLINIUS_DISPLAY_SCHEMA, TRUE);
@@ -606,3 +690,50 @@ phosh_layout_manager_get_box_shifts (PhoshLayoutManager *self,
   *indicators_shift = self->indicators_box_shift;
   *settings_shift = self->corner_shift;
 }
+
+
+/**
+ * phosh_layout_manager_get_side_box_shift:
+ * @self: The layout manager
+ *
+ * Plinius: padding of the icon box next to a clock that moved to the left or right
+ * (the network box or the indicators box), so the icons stay clear of the notch.
+ *
+ * Returns: The padding in pixels
+ */
+guint
+phosh_layout_manager_get_side_box_shift (PhoshLayoutManager *self)
+{
+  g_return_val_if_fail (PHOSH_IS_LAYOUT_MANAGER (self), 0);
+
+  return self->side_box_shift;
+}
+
+
+/**
+ * phosh_layout_manager_set_top_bar_widths:
+ * @self: The layout manager
+ * @clock: Width of the clock's text
+ * @network: Width of the network box's content
+ * @indicators: Width of the indicators box's content
+ *
+ * Plinius: the top bar reports the widths (in GTK coordinates, without the paddings the
+ * layout adds) that its clock and icon boxes need, so the layout can avoid the notch
+ * with the real sizes instead of assumptions.
+ */
+void
+phosh_layout_manager_set_top_bar_widths (PhoshLayoutManager *self, int clock, int network, int indicators)
+{
+  g_return_if_fail (PHOSH_IS_LAYOUT_MANAGER (self));
+
+  if (self->clock_width == clock && self->network_width == network &&
+      self->indicators_width == indicators)
+    return;
+
+  self->clock_width = clock;
+  self->network_width = network;
+  self->indicators_width = indicators;
+
+  if (self->builtin && phosh_monitor_is_configured (self->builtin) && self->panel)
+    update_layout (self);
+}
