From 5c0382ff22fcea49a7256775d2f4bb98773fee86 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Thu, 29 Oct 2026 18:02:00 +0100
Subject: [PATCH] layout-manager: Lay the top bar out from the real sizes and
 panel data

Plinius: upstream assumes a 40 px clock and a fixed number of icons when it
places the top bar around a notch. With the weekday, the date and the calendar
week the clock is far wider, so a clock moved to the left pushed the network
icons under the camera.

The top bar now reports the widths its clock and icon boxes really need, and
the layout manager places the clock in the center if it fits beside the notch,
otherwise at the side that fits; an icon box that would end up under the notch
is padded past it (new side box shift, CSS on the named boxes).

The notch setting gains "auto" (the default): the panel comes from the device
package (/usr/share/plinius/display-panel.json, gmobile's format), else from
gmobile, else there is no cutout. Left/center/right stay as manual estimates.
---
 src/layout-manager.c | 359 +++++++++++++++++++++++++++++++++++----------------
 src/layout-manager.h |   5 +
 src/top-panel.c      |  98 +++++++++++++-
 src/ui/top-panel.ui  |   4 +
 4 files changed, 349 insertions(+), 117 deletions(-)

diff --git a/src/layout-manager.c b/src/layout-manager.c
index 0d30f049..bf6a2549 100644
--- a/src/layout-manager.c
+++ b/src/layout-manager.c
@@ -52,6 +52,7 @@ struct _PhoshLayoutManager {
 
   GmDisplayPanel             *panel;
   GmDisplayPanel             *device_panel;
+  GmDisplayPanel             *file_panel;
   GSettings                  *settings;
   GSettings                  *plinius_settings;
 
@@ -60,6 +61,11 @@ struct _PhoshLayoutManager {
   guint                       clock_box_shift;
   guint                       corner_shift;
   guint                       network_box_shift;
+  guint                       side_box_shift;
+  /* Plinius: what the top bar's clock and icon boxes need, -1 until reported */
+  int                         clock_width;
+  int                         network_width;
+  int                         indicators_width;
   guint                       indicators_box_shift;
 
   PhoshMonitor               *builtin;
@@ -72,6 +78,11 @@ G_DEFINE_TYPE (PhoshLayoutManager, phosh_layout_manager, G_TYPE_OBJECT)
 /* Height of the clock box */
 #define CLOCK_BOX_HEIGHT 16 /* px */
 
+/* Plinius: padding of the top bar clock when it moved to the left or right (common.css) */
+#define CLOCK_SIDE_PADDING 6 /* px */
+/* Plinius: panel data of the device in gmobile's format, shipped by the device package */
+#define PLINIUS_PANEL_FILE "plinius/display-panel.json"
+
 /* The minimum space needed when shifting the indicator area due to a
  * cutout. This is less than the `*_box_rect.width` as the clock will
  * just be shifted by GTK in those cases */
@@ -95,57 +106,76 @@ static const GdkRectangle indicators_box_rect = {
   .height = PHOSH_TOP_BAR_HEIGHT
 };
 
+/*
+ * Plinius: the cutouts the top bar has to avoid, as one rectangle in GTK coordinates
+ * (scaled). Only cutouts that reach into the top bar count.
+ *
+ * Returns: %TRUE if there is such a cutout
+ */
+static gboolean
+get_top_bar_notch (PhoshLayoutManager *self, float scale, GdkRectangle *notch)
+{
+  GListModel *cutouts;
+  GdkRectangle top_bar = { .x = 0, .y = 0, .height = PHOSH_TOP_BAR_HEIGHT };
+  gboolean found = FALSE;
+
+  top_bar.width = self->builtin->width / scale;
+  cutouts = gm_display_panel_get_cutouts (self->panel);
+  for (int i = 0; i < g_list_model_get_n_items (cutouts); i++) {
+    g_autoptr (GmCutout) cutout = g_list_model_get_item (cutouts, i);
+    const GmRect *bounds = gm_cutout_get_bounds (cutout);
+    GdkRectangle rect = {
+      .x = floor (bounds->x / scale),
+      .y = floor (bounds->y / scale),
+      .width = ceil (bounds->width / scale),
+      .height = ceil (bounds->height / scale),
+    };
+
+    if (!gdk_rectangle_intersect (&rect, &top_bar, NULL))
+      continue;
+
+    if (found)
+      gdk_rectangle_union (notch, &rect, notch);
+    else
+      *notch = rect;
+    found = TRUE;
+  }
+
+  return found;
+}
