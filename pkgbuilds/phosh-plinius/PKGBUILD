# Maintainer: misc-de <misc-de@users.noreply.github.com>
# Based on: Arch's PKGBUILD (phosh 0.59.0-1); ALARM builds it unchanged.

pkgname=phosh-plinius
pkgver=0.59.0
pkgrel=33
pkgdesc="Phosh mobile shell with a restart button, NFC, cast and USB switches and settings for the notch, the app overview and the calendar week"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
# Debug symbols in a -debug package (ALARM's makepkg.conf has !debug): perf names Phosh's functions
options=(debug)
url="https://gitlab.gnome.org/World/Phosh/phosh"
license=(GPL-3.0-or-later)
# Why a custom build: a long press on the power button opens Phosh's power menu, which only
# offers power off, lock, screenshot and emergency call. A phone also needs "Restart" there.
# gmobile has no panel data for the Plinius, so the top bar takes the panel data from the
# device package (display-panel.json) or the notch position from GNOME Settings
# (org.plinius.display, see pkgbuilds/gnome-control-center-plinius), and lays the clock and
# the icons out from their real widths.
# The app overview takes its layout options from there too (search, app names, folder dock).
# A tap on the notch opens a minimal search of apps, settings, contacts, events and the other
# GNOME search providers (org.plinius.display notch-search).
# The cast quick setting mirrors the screen to a TV or sends the sound to a speaker through
# Schwupp (pkgbuilds/schwupp).
# VPN auth dialogs without the external UI mode (OpenConnect) get their own window, as in
# GNOME Shell; before, Phosh refused them.
# While a camera is on, the notch glows white (camera-hal-bridge tells it on the session bus).
# The USB quick setting chooses what an attached computer gets (pkgbuilds/plinius-usb).
# The contact card quick setting ("My Card") shares the own card over NFC and a QR code and takes
# cards in (pkgbuilds/plinius-cardshare).
# On a satellite network the cellular icon shows a satellite (pkgbuilds/plinius-satellite).
# Every access question, of the portals and of plinius-appaccess, asks with Allow Once, Always
# Allow and Don't Allow.
# Must follow the phosh version in ALARM (same phoc version, see pkgbuilds/phoc-plinius).
# Dependencies as in ALARM. phoc-plinius >= 0.59.0-1: Phosh 0.59 draws the overview's thumbnails
# through phoc and uses the newer layer-shell-effects protocol; the doze power mode of the
# always-on display needs our phoc patches too. phoc-plinius >= 0.59.0-8: with 0106 the OSK stays
# on when docked, phoc 0038 keeps it on the phone's panel.
depends=(
	appstream at-spi2-core bash cairo callaudiod dconf evince evolution-data-server feedbackd fribidi gcr
	gdk-pixbuf2 glib2 glibc gnome-bluetooth-3.0 gnome-desktop gnome-session gnome-shell
	gsettings-desktop-schemas gtk3 gtk4 hicolor-icon-theme iio-sensor-proxy json-glib libadwaita
	libgcc libgmobile libgudev libhandy libical libmm-glib libnm libpipewire libpulse libsecret
	libsoup3 pam pango
	# gtk3-plinius: scrolling the app grid follows the finger, it jumped back and forth by whole rows
	'gtk3-plinius>=1:3.24.52-1'
	# libhandy-plinius 1.8.3-3 draws a held card where the finger is (0076)
	'libhandy-plinius>=1.8.3-3' 'phoc-plinius>=0.59.0-8' phosh-osk-provider 'plinius-pattern>=0.3' polkit qrcodegen systemd-libs upower wayland xdg-desktop-portal-gtk
	xdg-desktop-portal-phosh xdg-desktop-portal-wlr
)
makedepends=(git glib2-devel meson python-docutils wayland-protocols)
provides=("phosh=$pkgver")
# Since 0.59 the settings are in mobi.phosh.shell; an older phosh-mobile-settings looks for sm.puri.phosh
conflicts=(phosh 'phosh-mobile-settings<0.59.0')
