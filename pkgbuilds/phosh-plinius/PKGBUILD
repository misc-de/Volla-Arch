prepare() {
	ln -s "$srcdir/libcall-ui" phosh/subprojects/libcall-ui
	ln -s "$srcdir/guidog-gvc" phosh/subprojects/gvc
	meson subprojects checkout --sourcedir phosh
	local callui
	callui=$(git -C "$srcdir/libcall-ui" rev-parse HEAD)
	if [[ $callui != "$_callui_commit" ]]; then
		error "libcall-ui's tag points to $callui, not to $_callui_commit"
		return 1
	fi
	# Long press on the power button: "Restart" next to "Power Off"
	patch -d phosh -Np1 -i "$srcdir/0001-power-menu-Add-a-restart-button.patch"
	# Notch position from GNOME Settings (org.plinius.display): the top bar avoids the camera
	patch -d phosh -Np1 -i "$srcdir/0002-layout-manager-Take-the-notch-position-from-the-settings.patch"
	# App overview: search, app names and a folder dock from GNOME Settings (org.plinius.display)
	patch -d phosh -Np1 -i "$srcdir/0003-app-grid-Search-app-names-and-a-folder-dock-from-the.patch"
	# Top bar: calendar week left of the clock and after the date when "Week Numbers" is on
	patch -d phosh -Np1 -i "$srcdir/0004-top-panel-Show-the-calendar-week.patch"
	# NFC: quick setting and top bar symbol (nfcd)
	patch -d phosh -Np1 -i "$srcdir/0005-plugins-NFC-quick-setting-and-status-icon.patch"
	# Top bar: just the week number left of the clock
	patch -d phosh -Np1 -i "$srcdir/0006-top-panel-Only-the-week-number-left-of-the-clock.patch"
	# Top bar: clock and icons laid out from their real widths and the device's panel data
	# (/usr/share/plinius/display-panel.json from device-volla-ansuz), notch "auto"
	patch -d phosh -Np1 -i "$srcdir/0007-layout-manager-Lay-the-top-bar-out-from-the-real-siz.patch"
	# Lock screen: "Slide up to unlock" above an under-display fingerprint sensor while the
	# fingerprint target shows (biomd identifying or enrolling)
	patch -d phosh -Np1 -i "$srcdir/0008-lockscreen-Keep-the-slide-hint-clear-of-an-under-display.patch"
	# Displays: mode and scale from Settings survive a restart (~/.config/phosh/phoc.ini)
	patch -d phosh -Np1 -i "$srcdir/0009-monitor-manager-Keep-mode-and-scale-across-sessions.patch"
	# Lock screen: unlock pattern (plinius-pattern) instead of the PIN when the user has one
	patch -d phosh -Np1 -i "$srcdir/0010-lockscreen-Unlock-with-a-pattern.patch"
	# Hotspot on ap0 when the WLAN driver runs it on an interface of its own (MediaTek)
	patch -d phosh -Np1 -i "$srcdir/0011-wifi-manager-Hotspot-on-an-AP-only-interface.patch"
	# Lock screen: keypad and pattern pad grow with the screen (phone at a scale below 3)
	patch -d phosh -Np1 -i "$srcdir/0012-lockscreen-Keypad-and-pattern-pad-use-the-room-of-the-screen.patch"
	# Lock screen: what the PAM modules say after a wrong PIN, e.g. the wait (plinius-pinguard)
	patch -d phosh -Np1 -i "$srcdir/0013-lockscreen-Show-what-the-PAM-modules-say.patch"
	# Lock screen: in the dark style the dark variant of the background chosen in GNOME Settings
	patch -d phosh -Np1 -i "$srcdir/0014-lockscreen-manager-Dark-variant-of-the-background.patch"
	# Accent color: a color of the user's choice from GNOME Settings (org.plinius.appearance)
	patch -d phosh -Np1 -i "$srcdir/0015-style-manager-A-custom-accent-color-from-the-settings.patch"
	# Idle dimming: fade down and back up instead of jumping
	patch -d phosh -Np1 -i "$srcdir/0016-brightness-manager-Fade-when-dimming-and-undimming.patch"
	# Lock screen: the unlock page centered on the screen, clear of the fingerprint sensor
	patch -d phosh -Np1 -i "$srcdir/0017-lockscreen-Center-the-unlock-page-on-the-screen.patch"
	# Notch: a tap on it unfolds a minimal app search, a tap next to it or on it closes it
	patch -d phosh -Np1 -i "$srcdir/0018-notch-search-Search-apps-from-the-notch.patch"
	# Cast quick setting: mirror to a TV or send the sound to a speaker, through Schwupp
	patch -d phosh -Np1 -i "$srcdir/0019-plugins-Cast-quick-setting.patch"
	# VPN: auth dialogs that bring their own window (OpenConnect) instead of refusing them
	patch -d phosh -Np1 -i "$srcdir/0020-network-auth-manager-Auth-dialogs-with-their-own-window.patch"
	# Notch: a white glow around the camera hole while a camera is on (camera-hal-bridge >= 0.5)
	patch -d phosh -Np1 -i "$srcdir/0021-camera-glow-Light-the-notch-while-a-camera-is-on.patch"
	# USB quick setting: file sharing, network and internet for an attached computer (plinius-usb)
	patch -d phosh -Np1 -i "$srcdir/0022-plugins-USB-quick-setting.patch"
	# Torch quick setting: follows the torch when the assistant button or plinius-torch's timeout
	# switches it (change uevent from plinius-torch >= 0.4)
	patch -d phosh -Np1 -i "$srcdir/0023-torch-manager-Follow-changes-made-by-others.patch"
	# Dual SIM: the status icon follows the modem with a SIM, not whichever modem came first
	patch -d phosh -Np1 -i "$srcdir/0024-wwan-mm-Prefer-a-modem-with-a-SIM.patch"
	# Brightness slider: shows the real brightness with auto brightness too, not an offset
	# in the middle; moving it sets the offset to the auto brightness
	patch -d phosh -Np1 -i "$srcdir/0025-brightness-manager-Show-the-brightness-on-the-slider.patch"
	# Lock screen at startup: tell logind once its session proxy is there, else LockedHint stays
	# false until the second lock and the first PIN unlock goes unseen (face unlock)
	patch -d phosh -Np1 -i "$srcdir/0026-screen-saver-manager-Send-the-locked-hint-once-logind-is-there.patch"
	# Sound devices (gvc): a Bluetooth headset once per direction under its own name, hands-free
	# ports and codecs not offered (calls and recordings switch by themselves, audio-hal-bridge)
	patch -d phosh/subprojects/gvc -Np1 -i "$srcdir/0027-gvc-A-Bluetooth-headset-is-one-device-per-direction.patch"
	# "Restart UI" in the power menu and the system menu: the shell quits with a failure status and
	# systemd starts it again, compositor and apps stay; the system menu no longer cuts its labels
	patch -d phosh -Np1 -i "$srcdir/0028-shell-Restart-the-UI-from-the-power-menu-and-the-system-menu.patch"
	# Torch: switches on at the brightness picked with its slider (org.plinius.torch from
	# plinius-torch >= 0.5), not at the brightness the camera app last gave the LED
	patch -d phosh -Np1 -i "$srcdir/0029-torch-manager-Keep-the-torch-s-own-brightness.patch"
	# Phosh crashed when a car kit with hands-free only connected: gvc used a stream's active
	# port without checking it is among the stream's ports
	patch -d phosh/subprojects/gvc -Np1 -i "$srcdir/0030-gvc-No-crash-when-a-stream-s-active-port-is-unknown.patch"
	# Phosh crashed when a headset connected or switched to hands-free: the hands-free port
	# (no UI device, 0027) kept the card's freed profiles; every port takes the new ones
	patch -d phosh/subprojects/gvc -Np1 -i "$srcdir/0069-gvc-Hands-free-ports-take-the-new-profiles-of-the-card.patch"
	# The FM tuner's sound (audio-hal-bridge, plinius.hidden) is no input in the sound menu;
	# the radio app opens it by name (the same patch as gnome-control-center-plinius 0096)
	patch -d phosh/subprojects/gvc -Np1 -i "$srcdir/0095-gvc-Sources-marked-plinius.hidden-are-not-listed.patch"
	# Without gnome-software the AppStream pool served nothing, but every change of the
	# AppStream data reloaded the whole Flathub catalog and kept ~60 MB each time
	patch -d phosh -Np1 -i "$srcdir/0070-metainfo-cache-No-AppStream-pool-without-GNOME-Software.patch"
	# Auto brightness: a new brightness step only once the light stayed there (4 s brighter,
	# 8 s darker), outdoors shadows and tilting kept the display changing all the time
	patch -d phosh -Np1 -i "$srcdir/0031-auto-brightness-bucket-Wait-before-switching-buckets.patch"
	# Always-on display: with the setting on, the built-in OLED dozes instead of going off and
	# shows the time, the date, the battery and the apps with notifications (phoc-plinius >= 23)
	patch -d phosh -Np1 -i "$srcdir/0032-shell-Always-on-display-while-the-panel-dozes.patch"
	# Notch search: also settings, contacts, calendar events, the calculator and the other GNOME
	# search providers (org.gnome.Shell.SearchProvider2), switched and ordered in GNOME Settings
	patch -d phosh -Np1 -i "$srcdir/0033-notch-search-Search-the-system-not-just-apps.patch"
	# The camera glow follows the camera when the screen turns (sides in landscape, bottom upside down)
	patch -d phosh -Np1 -i "$srcdir/0034-camera-glow-Follow-the-camera-when-the-screen-turns.patch"
	# Folders open without a jump. 0035/0036 are for upstream (docs/upstream/phosh/app-icon-fallback):
	# every button appended the fallback to the app's own icon, its names grew on each opening
	# and GTK's icon cache never matched; and the folder preview leaked app infos.
	patch -d phosh -Np1 -i "$srcdir/0035-app-grid-button-Don-t-change-the-app-s-own-icon.patch"
	patch -d phosh -Np1 -i "$srcdir/0036-app-grid-folder-button-Don-t-leak-the-app-infos-of-t.patch"
	# The icons of apps in folders are loaded ahead in a thread, a folder opened again keeps its buttons
	patch -d phosh -Np1 -i "$srcdir/0037-app-grid-Load-the-icons-of-folder-apps-ahead-and-kee.patch"
	# Cast and USB quick settings: footer and long press open the Streaming and USB pages of
	# GNOME Settings (gnome-control-center-plinius 51.1-35), not Schwupp's window
	patch -d phosh -Np1 -i "$srcdir/0038-plugins-Cast-and-USB-settings-in-GNOME-Settings.patch"
	# The apps in a folder are listed by name (casefolded, then collated), not in the order
	# they came
	patch -d phosh -Np1 -i "$srcdir/0039-folder-info-List-a-folder-s-apps-by-name.patch"
	# A failed screencopy (e.g. a screenshot while the screen is locked) released nothing, so
	# every later screenshot was refused as "already in progress" until Phosh restarted
	patch -d phosh -Np1 -i "$srcdir/0040-screenshot-manager-Release-the-frames-when-a-screenc.patch"
	# Folders at the bottom (folder dock) stay as tall as in the grid: the vexpand of their icon
	# grid made the dock take half of the free height
	patch -d phosh -Np1 -i "$srcdir/0041-app-grid-Folders-at-the-bottom-keep-their-size.patch"
	# The output of a layer surface is known in constructed(): the lock screen put its
	# background on no output, with a second screen phoc placed it there and dropped Phosh
	# ("Layer surface not on same output") on every lock
	patch -d phosh -Np1 -i "$srcdir/0042-layersurface-Know-the-output-while-subclasses-are-co.patch"
	# A second screen (e.g. virtual over VNC) shows the time, asks to unlock on the phone and
	# takes the PIN itself instead of an empty shield
	patch -d phosh -Np1 -i "$srcdir/0043-lockshield-Unlock-on-the-phone-or-with-the-PIN-on-a-second-screen.patch"
	# The always-on display lies over the top bar and over a lock screen that comes up while dozing;
	# a starting Phosh removes the flag a crashed one left behind
	patch -d phosh -Np1 -i "$srcdir/0044-shell-The-always-on-display-stays-on-top-of-everything.patch"
	# The emergency menu can be reached from the unlock page. It only opens the menu, nothing dials
	patch -d phosh -Np1 -i "$srcdir/0045-lockscreen-An-emergency-button-next-to-the-unlock-button.patch"
	# With gnome-calls-plinius the menu shows "Calling…" while it dials and opens again on a failure
	patch -d phosh -Np1 -i "$srcdir/0046-emergency-menu-Tell-how-the-call-is-going.patch"
	# "Calling…" in all languages, "Emergency" also in Spanish and Italian
	patch -d phosh -Np1 -i "$srcdir/0047-po-Emergency-and-Calling-on-the-lock-screen-and-in-the-menu.patch"
	# The menu has its own keys, the on-screen keyboard only covered the call button
	patch -d phosh -Np1 -i "$srcdir/0048-emergency-menu-The-dial-pad-doesnt-ask-for-the-on-screen-keyboard.patch"
	# In an emergency the menu fills the screen instead of being a card in the middle
	patch -d phosh -Np1 -i "$srcdir/0049-emergency-menu-Fill-the-whole-screen.patch"
	# The always-on display made anew when the phone locks stays in place
	patch -d phosh -Np1 -i "$srcdir/0050-aod-The-same-place-for-the-whole-minute.patch"
	# A swipe sideways closes the emergency menu, and never places a call
	patch -d phosh -Np1 -i "$srcdir/0051-emergency-menu-A-swipe-closes-it.patch"
	# Nothing moves behind the clock in the settings: it is part of their black card
	patch -d phosh -Np1 -i "$srcdir/0052-top-panel-The-clock-row-is-part-of-the-black-card.patch"
	# Room below the volume slider and below the last tile
	patch -d phosh -Np1 -i "$srcdir/0053-settings-Room-below-the-sliders-and-the-quick-settings.patch"
	# The desktop over VNC on and off (plinius-desktop); hidden without that package
	patch -d phosh -Np1 -i "$srcdir/0054-plugins-Desktop-over-VNC-quick-setting.patch"
	# "Restart UI" asks first, like "Power Off" and "Restart"
	patch -d phosh -Np1 -i "$srcdir/0055-shell-Ask-before-restarting-the-UI.patch"
	# All brightness changes in steps too small to see, the slider and the keys too
	patch -d phosh -Np1 -i "$srcdir/0056-brightness-manager-Smooth-transitions.patch"
	# The glow charges around the camera hole when a camera goes on, and runs back when it goes off
	patch -d phosh -Np1 -i "$srcdir/0057-camera-glow-Charge-the-ring-around-the-camera.patch"
	# Modem and Wi-Fi stay left of the notch when they fit there, the other network icons go to the right
	patch -d phosh -Np1 -i "$srcdir/0058-top-panel-Modem-and-Wi-Fi-stay-left-of-the-notch-when-they-fit.patch"
	# Emergency below Unlock, with an empty line in between
	patch -d phosh -Np1 -i "$srcdir/0059-lockscreen-The-emergency-button-below-the-unlock-button.patch"
	# A window on the desktop over VNC keeps the phone's overview open
	patch -d phosh -Np1 -i "$srcdir/0060-shell-A-window-on-another-screen-keeps-the-phone-s-overview-open.patch"
	# A window on the desktop over VNC gets the keyboard
	patch -d phosh -Np1 -i "$srcdir/0061-home-With-a-second-screen-the-open-overview-leaves-the-keyboard-alone.patch"
	# The overview opens when the phone's last window went to the desktop over VNC
	patch -d phosh -Np1 -i "$srcdir/0062-shell-The-overview-opens-when-the-phone-s-last-window-left-for-another-screen.patch"
	# The emergency button sits in the lower left corner, beside the fingerprint sensor
	patch -d phosh -Np1 -i "$srcdir/0063-lockscreen-The-emergency-button-at-the-bottom-edge.patch"
	# The always-on display: notification icons in a row of their own, below the battery
	patch -d phosh -Np1 -i "$srcdir/0064-aod-The-notification-icons-in-a-row-of-their-own.patch"
	# The icon of an app's first notification also shows up during the always-on display
	patch -d phosh -Np1 -i "$srcdir/0065-aod-Show-the-icon-of-an-app-s-first-notification.patch"
	# The splash ends with the app's window, also when the app doesn't report its startup id
	patch -d phosh -Np1 -i "$srcdir/0066-app-tracker-A-window-of-the-app-ends-its-splash.patch"
	# Always-on display: the notification icons three times as large (66 px), easier to see
	patch -d phosh -Np1 -i "$srcdir/0067-aod-Notification-icons-three-times-as-large.patch"
	# The volume keys: a slider at their edge as on Android, swiped inwards the volume per role
	# (media, calls, ringtone, notifications, alarm) as shares of the output volume
	patch -d phosh -Np1 -i "$srcdir/0068-volume-osd-Sliders-at-the-keys-edge-the-volume-per-role.patch"
	# Overview: the running apps above the app grid (default) or below it
	# (org.plinius.display overview-running-apps, GNOME Settings > Appearance)
	patch -d phosh -Np1 -i "$srcdir/0072-overview-The-running-apps-above-or-below-the-app-grid.patch"
	# On a satellite network (plinius-satellite, org.plinius.Satellite) the cellular icon shows a
	# satellite and "SAT" instead of the bars and the access technology
	patch -d phosh -Np1 -i "$srcdir/0073-wwan-info-A-satellite-instead-of-the-bars-while-on-a-satellite.patch"
	# Overview: running apps below the grid keep the size they have above it, as far from the
	# bottom edge as they are from the top otherwise, and close with a swipe down
	patch -d phosh -Np1 -i "$srcdir/0074-overview-Running-apps-below-the-grid-keep-their-size-and-close-downwards.patch"
	# Tapping a notification also folds the overview, so the app it opens is in front
	patch -d phosh -Np1 -i "$srcdir/0075-notifications-Tapping-a-notification-also-folds-the-overview.patch"
	# Holding a running app for a second gives a short vibration, then the card follows the
	# finger in the overview order
	patch -d phosh -Np1 -i "$srcdir/0076-overview-Hold-a-running-app-for-a-second-to-move-it-in-the-order.patch"
	# "Restart Phosh" instead of "Restart UI" in the system menu, the power menu and the question:
	# only the shell restarts, the compositor and the apps keep running
	patch -d phosh -Np1 -i "$srcdir/0077-shell-Restart-Phosh-instead-of-Restart-UI.patch"
	# Contact card: share the own card over NFC and a QR code, receive cards over NFC and
	# Bluetooth, through plinius-cardshare (quick setting "My Card")
	patch -d phosh -Np1 -i "$srcdir/0078-plugins-Contact-card-quick-setting.patch"
	# Lock screen: after a wrong pattern what the PAM modules say, e.g. the wait (plinius-pinguard
	# counts wrong patterns like wrong PINs since plinius-pattern 0.4)
	patch -d phosh -Np1 -i "$srcdir/0079-lockscreen-Show-what-the-PAM-modules-say-after-a-wrong-pattern.patch"
	# Quick settings: the tile's name instead of "On"/"Off" (the accent color says that), Bluetooth's
	# device count translated
	patch -d phosh -Np1 -i "$srcdir/0080-quick-settings-The-tile-s-name-instead-of-On-and-Off.patch"
	# Quick settings: no battery tile while the top bar shows the percentage; an "Airplane Mode"
	# tile after it or in its place (gsd-rfkill: Wi-Fi, Bluetooth and the modem via WwanEnabled),
	# the only switch for it since GNOME Settings' Wi-Fi page lost its own
	patch -d phosh -Np1 -i "$srcdir/0081-quick-settings-Airplane-mode-in-place-of-the-battery-tile.patch"
	# USB quick setting: the webcam and "Power the Device" (a power role swap through
	# plinius-usb 0.4) in its list, as in GNOME Settings; toggling a function keeps the webcam
	patch -d phosh -Np1 -i "$srcdir/0082-plugins-USB-Webcam-and-powering-the-connected-device.patch"
	# Translations of the strings of 0081 and 0082
	patch -d phosh -Np1 -i "$srcdir/0083-po-Airplane-Mode-and-the-USB-tile-s-new-rows.patch"
	# A long press on a folder offers "Dissolve Folder", its apps go back to the main grid;
	# German: "Aus Ordner lösen" and "Ordner auflösen"
	patch -d phosh -Np1 -i "$srcdir/0085-app-grid-Dissolve-a-folder-from-its-long-press-menu.patch"
	# Long presses: Contact Card opens Settings > NFC > Contact Card, Desktop the page "Desktop
	# over VNC", the hotspot tile the hotspot's page (gnome-control-center-plinius 0086)
	patch -d phosh -Np1 -i "$srcdir/0086-plugins-Long-presses-open-the-tile-s-own-page-in-GNOME-Settings.patch"
	# Quick settings: Mobile Data right after Wi-Fi (end of the top row), the hotspot in the place
	# of Bluetooth
	patch -d phosh -Np1 -i "$srcdir/0087-quick-settings-Mobile-data-and-the-hotspot-up-among-the-first-tiles.patch"
	# System menu and power menu: Log Out (asking first) with more than one account, greetd then
	# shows plinius-greeter's account picker; the power menu's buttons as rows, not squares
	patch -d phosh -Np1 -i "$srcdir/0088-shell-Log-Out-with-a-second-account-power-menu-buttons-in-rows.patch"
	# Quick settings: the SIM card's label from GNOME Settings (org.plinius.sim) instead of the
	# name the network gives, e.g. the operator's name or a greeting
	patch -d phosh -Np1 -i "$srcdir/0089-wwan-mm-The-SIM-card-s-own-label-instead-of-the-network-s-name.patch"
	# Landscape: the home bar is 32 px instead of 15 px high on the phone's own panel. The
	# touchscreen drops or moves presses in its outer ~20 px at the long edges, so long presses
	# (keyboard) and taps missed the thin bar; further in it is accurate
	patch -d phosh -Np1 -i "$srcdir/0090-home-A-taller-home-bar-while-the-phone-is-turned.patch"
	# Since 0.58 the long presses of the cellular, Wi-Fi, Bluetooth and VPN tiles and the footers of
	# the Wi-Fi, Bluetooth and sound pages open phosh-mobile-settings; they open GNOME Settings
	# again. Feedback, Caffeine and the top bar's settings button stay with phosh-mobile-settings
	patch -d phosh -Np1 -i "$srcdir/0091-quick-settings-Settings-open-in-GNOME-Settings-again.patch"
	# Power menu: the buttons one below the other in a single column, icon and label at the left
	patch -d phosh -Np1 -i "$srcdir/0092-power-menu-The-buttons-one-below-the-other.patch"
	# App grid: icons fade out softly where the grid scrolls on, e.g. under the running apps,
	# instead of ending at a hard edge
	patch -d phosh -Np1 -i "$srcdir/0093-app-grid-Icons-fade-out-where-the-grid-scrolls-on.patch"
	# With running apps the grid gets a 40 px band at the cards' edge (the cards get that much
	# lower); icons stay fully visible on the grid and fade out in the band, replacing 0093's fade
	patch -d phosh -Np1 -i "$srcdir/0094-overview-Icons-fade-out-in-a-band-at-the-running-apps-cards.patch"
	# The band is erased after drawing the grid once, not drawn a second time through a group
	patch -d phosh -Np1 -i "$srcdir/0096-app-grid-Fade-the-band-without-drawing-the-grid-twice.patch"
	# Cards of running apps: the thumbnail is scaled once, not for every frame of the overview
	patch -d phosh -Np1 -i "$srcdir/0097-activity-A-card-s-thumbnail-is-scaled-once-not-for-every-frame.patch"
	# The camera icon takes its first state without a transition, so it does not flash up at startup
	patch -d phosh -Np1 -i "$srcdir/0098-camera-status-icon-No-icon-flashing-up-at-startup.patch"
	# Cards of running apps: a thumbnail is asked for once a layout is done, only for a new size
	patch -d phosh -Np1 -i "$srcdir/0099-overview-A-card-s-thumbnail-is-asked-for-once-per-layout.patch"
	# Cards of running apps: their size once per layout, the band as a margin, not a second allocation
	patch -d phosh -Np1 -i "$srcdir/0100-overview-The-cards-get-their-size-once-per-layout.patch"
	# App icons from a file (no GTK cache) are loaded once per size and scale, not for every render
	patch -d phosh -Np1 -i "$srcdir/0101-app-grid-button-An-icon-from-a-file-is-loaded-once.patch"
	# The first folder's page gets its buttons ahead, file icons are preloaded too
	patch -d phosh -Np1 -i "$srcdir/0102-app-grid-The-first-folder-s-page-is-built-ahead.patch"
	# A card shows the on-screen keyboard below a window it shortened, not an empty third
	patch -d phosh -Np1 -i "$srcdir/0103-overview-A-card-shows-the-on-screen-keyboard-below-the-window.patch"
	# With mode and scale saved in Settings, phoc started with the user's old copy of the system
	# phoc.ini, so device updates of it (the light sensor of phoc-plinius 0034) never arrived:
	# phosh-session merges the current system file with mode and scale of that copy
	patch -d phosh -Np1 -i "$srcdir/0104-phosh-session-Device-updates-of-phoc.ini-reach-a-user-with-saved-modes.patch"
	# The app grid and an open folder scroll without a scrollbar at the side
	patch -d phosh -Np1 -i "$srcdir/0105-app-grid-No-scrollbar-at-the-side-of-the-grid-and-of-a-folder.patch"
	# Docking (the desktop over VNC) no longer turns the OSK off: the phone needs it on its own
	# panel, phoc keeps it there (phoc-plinius 0038)
	patch -d phosh -Np1 -i "$srcdir/0106-docked-manager-The-OSK-stays-on-when-docked.patch"
	# With the desktop on a second screen, a PIN or password an app asks for shows on the
	# screen of the focused window, not always on the phone
	patch -d phosh -Np1 -i "$srcdir/0107-shell-A-prompt-shows-on-the-screen-where-the-action-.patch"
	# Power menu: two columns while the screen is wider than high (landscape)
	patch -d phosh -Np1 -i "$srcdir/0108-power-menu-Two-columns-while-the-screen-is-wider-tha.patch"
	# Every access question (camera, location, screenshot, … of the portals and plinius-appaccess's
	# USB cameras, security keys and network) asks with Allow Once, Always Allow and Don't Allow,
	# one below the other; Allow Once removes the grant xdg-desktop-portal stores for it again
	patch -d phosh -Np1 -i "$srcdir/0109-portal-access-manager-Allow-Once-Always-Allow-and-Don-t-Allow.patch"
	# Translations of the three buttons
	patch -d phosh -Np1 -i "$srcdir/0110-po-Allow-Once-Always-Allow-and-Don-t-Allow.patch"
	# An access dialog whose request goes away (xdg-desktop-portal closes it, or the caller
	# leaves the bus) closes, so the next access question can show
	patch -d phosh -Np1 -i "$srcdir/0111-portal-access-manager-A-request-that-goes-away-close.patch"
	# Apps geoclue lets the agent decide (Flatpak apps that talk to geoclue directly; geoclue
	# asks for no native app) get the three buttons too; Always Allow and Don't Allow are
	# remembered in the permission store as for the portal (GNOME Settings' Location page)
	patch -d phosh -Np1 -i "$srcdir/0112-location-manager-Remember-the-location-answers-of-na.patch"
	# A TV's row in the cast quick setting gets a button for each thing Schwupp can send it (screen,
	# YouTube link, video, desktop through plinius-desktop-cast), the one in use marked
	patch -d phosh -Np1 -i "$srcdir/0113-cast-quick-setting-Buttons-per-TV-for-what-Schwupp-can-send.patch"
	# The cast quick setting in the eight languages (it was English everywhere)
	patch -d phosh -Np1 -i "$srcdir/0114-po-The-cast-quick-setting.patch"
	# Lock screen: "Slide up to unlock" halfway between the arrow and the fingerprint target
	patch -d phosh -Np1 -i "$srcdir/0115-lockscreen-The-slide-hint-halfway-between-the-arrow-.patch"
	# Always-on display: half the light in the dark (its own claim of the light sensor)
	patch -d phosh -Np1 -i "$srcdir/0116-aod-Half-the-light-in-the-dark.patch"
	# German: "WiFi" instead of "WLAN" in Phosh's own translation (msgstr lines only)
	sed -i '/^msgstr/,/^$/{/^#/!s/WLAN\([^;]\)/WiFi\1/g}' phosh/po/de.po
}

build() {
	arch-meson phosh build \
		--libexecdir=/usr/lib/phosh \
		-D phoc_tests=disabled \
		-D man=true
	meson compile -C build
}

package() {
	meson install -C build --destdir "$pkgdir"
	install -Dm644 "$srcdir/phosh.pam" "$pkgdir/etc/pam.d/phosh"
	# Schema of the notch setting; gnome-control-center-plinius shows its row only with it
	install -Dm644 "$srcdir/org.plinius.display.gschema.xml" -t "$pkgdir/usr/share/glib-2.0/schemas"
	# Schema of the custom accent color, read by Phosh and phoc; gnome-control-center-plinius
	# shows its button only with it
	install -Dm644 "$srcdir/org.plinius.appearance.gschema.xml" -t "$pkgdir/usr/share/glib-2.0/schemas"
	# The NFC, cast and USB plugins switched on in the quick settings and the top bar
	install -Dm644 "$srcdir/91-phosh-plinius.gschema.override" -t "$pkgdir/usr/share/glib-2.0/schemas"
	# "Restart UI": restart the shell without ending the session (see the file)
	# The system phoc.ini with the user's mode and scale, for phosh-session (0104)
	install -Dm755 "$srcdir/phoc-ini-merge" -t "$pkgdir/usr/lib/phosh/plinius"
	install -Dm644 "$srcdir/mobi.phosh.Shell-restart-direct.conf" \
		"$pkgdir/usr/lib/systemd/user/mobi.phosh.Shell.service.d/plinius-restart-direct.conf"
}
