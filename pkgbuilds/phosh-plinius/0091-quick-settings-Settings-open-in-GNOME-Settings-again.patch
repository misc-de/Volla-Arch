From: misc-de <misc-de@users.noreply.github.com>
Subject: [PATCH] quick-settings: Settings open in GNOME Settings again

Plinius: since 0.58 the long presses of the cellular, Wi-Fi, Bluetooth
and VPN tiles and the footers of the Wi-Fi and Bluetooth pages and of the
sound settings open phosh-mobile-settings. GNOME Settings has these
pages (with our own additions such as SIM labels, hotspot and VPN
editor), so they open there again. Feedback, Caffeine and the top bar's
settings button stay with phosh-mobile-settings, which has settings
GNOME Settings doesn't know.

---
 src/ui/audio-settings.ui   | 2 +-
 src/ui/bt-status-page.ui   | 2 +-
 src/ui/quick-settings.ui   | 8 ++++----
 src/ui/wifi-status-page.ui | 2 +-
 4 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/src/ui/audio-settings.ui b/src/ui/audio-settings.ui
index cbb7ec9e..efb5243d 100644
--- a/src/ui/audio-settings.ui
+++ b/src/ui/audio-settings.ui
@@ -128,7 +128,7 @@
                 <child>
                   <object class="GtkButton">
                     <property name="visible">1</property>
-                    <property name="action-name">panel.launch-mobile-panel</property>
+                    <property name="action-name">panel.launch-panel</property>
                     <property name="action-target">(&quot;sound&quot;, [&lt;&quot;&quot;&gt;])</property>
                     <child>
                       <object class="GtkLabel">
diff --git a/src/ui/bt-status-page.ui b/src/ui/bt-status-page.ui
index 5bb7776a..8eb94ea6 100644
--- a/src/ui/bt-status-page.ui
+++ b/src/ui/bt-status-page.ui
@@ -44,7 +44,7 @@
   <object class="GtkButton" id="footer">
     <property name="visible">1</property>
     <property name="hexpand">1</property>
-    <property name="action-name">panel.launch-mobile-panel</property>
+    <property name="action-name">panel.launch-panel</property>
     <property name="action-target">(&quot;bluetooth&quot;, [&lt;&quot;&quot;&gt;])</property>
     <property name="focus-on-click">0</property>
     <child>
diff --git a/src/ui/quick-settings.ui b/src/ui/quick-settings.ui
index ed2f8191..5de222db 100644
--- a/src/ui/quick-settings.ui
+++ b/src/ui/quick-settings.ui
@@ -12,7 +12,7 @@
             <property name="visible">1</property>
             <property name="sensitive" bind-source="wwaninfo" bind-property="present" bind-flags="sync-create"/>
             <property name="status-icon">wwaninfo</property>
-            <property name="long-press-action-name">panel.launch-mobile-panel</property>
+            <property name="long-press-action-name">panel.launch-panel</property>
             <property name="long-press-action-target">(&quot;wwan&quot;, [&lt;&quot;&quot;&gt;])</property>
             <signal name="clicked" handler="on_wwan_clicked" object="PhoshQuickSettings" swapped="yes"/>
           </object>
@@ -24,7 +24,7 @@
             <property name="sensitive" bind-source="wifiinfo" bind-property="present" bind-flags="sync-create"/>
             <property name="status-icon">wifiinfo</property>
             <property name="status-page">wifi_status_page</property>
-            <property name="long-press-action-name">panel.launch-mobile-panel</property>
+            <property name="long-press-action-name">panel.launch-panel</property>
             <property name="long-press-action-target">(&quot;wifi&quot;, [&lt;&quot;&quot;&gt;])</property>
             <signal name="clicked" handler="on_wifi_clicked" object="PhoshQuickSettings" swapped="yes"/>
           </object>
@@ -36,7 +36,7 @@
             <property name="sensitive" bind-source="btinfo" bind-property="present" bind-flags="sync-create"/>
             <property name="status-icon">btinfo</property>
             <property name="status-page">bt_status_page</property>
-            <property name="long-press-action-name">panel.launch-mobile-panel</property>
+            <property name="long-press-action-name">panel.launch-panel</property>
             <property name="long-press-action-target">(&quot;bluetooth&quot;, [&lt;&quot;&quot;&gt;])</property>
             <signal name="clicked" handler="on_bt_clicked" object="PhoshQuickSettings" swapped="yes"/>
           </object>
@@ -102,7 +102,7 @@
           <object class="PhoshQuickSetting">
             <property name="visible" bind-source="vpninfo" bind-property="present" bind-flags="sync-create"/>
             <property name="status-icon">vpninfo</property>
-            <property name="long-press-action-name">panel.launch-mobile-panel</property>
+            <property name="long-press-action-name">panel.launch-panel</property>
             <property name="long-press-action-target">(&quot;network&quot;, [&lt;&quot;&quot;&gt;])</property>
             <signal name="clicked" handler="on_vpn_clicked" object="PhoshQuickSettings" swapped="yes"/>
           </object>
diff --git a/src/ui/wifi-status-page.ui b/src/ui/wifi-status-page.ui
index dc3621ee..49cba647 100644
--- a/src/ui/wifi-status-page.ui
+++ b/src/ui/wifi-status-page.ui
@@ -80,7 +80,7 @@
     <property name="visible">1</property>
     <property name="hexpand">1</property>
     <property name="focus-on-click">0</property>
-    <property name="action-name">panel.launch-mobile-panel</property>
+    <property name="action-name">panel.launch-panel</property>
     <property name="action-target">(&quot;wifi&quot;, [&lt;&quot;&quot;&gt;])</property>
     <child>
       <object class="GtkLabel">
