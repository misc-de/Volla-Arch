diff --git a/src/portal-access-manager.c b/src/portal-access-manager.c
index 36b2194e..e12f9520 100644
--- a/src/portal-access-manager.c
+++ b/src/portal-access-manager.c
@@ -9,10 +9,10 @@
 #define G_LOG_DOMAIN "phosh-portal-access-manager"
 
 #include "access-once.h"
+#include "access-request.h"
 #include "app-auth-prompt.h"
 #include "dbus/portal-dbus.h"
 #include "portal-access-manager.h"
-#include "portal-request.h"
 #include "shell-priv.h"
 #include "util.h"
 
@@ -26,12 +26,14 @@
  * Implements org.freedesktop.impl.portal
  *
  * Plinius: every access dialog asks with "Allow Once", "Always Allow" and "Don't Allow"; what
- * becomes of "Allow Once" in xdg-desktop-portal's permission store is in access-once.c.
+ * becomes of "Allow Once" in xdg-desktop-portal's permission store is in access-once.c. A
+ * request that goes away while its dialog is open (closed, or the caller left the bus) closes
+ * the dialog (access-request.c), so the next question can show.
  */
 
 typedef struct _PhoshPortalAccessManager {
   PhoshDBusImplPortalAccessSkeleton access_portal;
-  PhoshPortalRequest               *request;
+  PhoshAccessRequest               *request;
   int                               dbus_name_id;
   PhoshAppAuthPrompt               *app_auth_prompt;
   GDBusMethodInvocation            *invocation;
@@ -56,7 +58,7 @@ on_access_dialog_closed (PhoshPortalAccessManager *self)
   GVariant *choices = NULL;
   PhoshAccessChoice choice = phosh_app_auth_prompt_get_choice (GTK_WIDGET (self->app_auth_prompt));
 
-  g_clear_object (&self->request);
+  g_clear_pointer (&self->request, phosh_access_request_free);
 
   choices = phosh_app_auth_prompt_get_selected_choices (GTK_WIDGET (self->app_auth_prompt));
   phosh_access_once_complete (self->invocation, self->app_id, self->options, choice, choices);
@@ -70,6 +72,27 @@ on_access_dialog_closed (PhoshPortalAccessManager *self)
 }
 
 
+/* Plinius: the request went away unanswered: close the dialog, answer as ended */
+static void
+on_request_gone (gpointer user_data, const char *why)
+{
+  PhoshPortalAccessManager *self = PHOSH_PORTAL_ACCESS_MANAGER (user_data);
+
+  g_debug ("Access request of %s %s, closing its dialog", self->app_id, why);
+  g_clear_pointer (&self->request, phosh_access_request_free);
+  phosh_access_request_cancel (self->invocation);
+  self->invocation = NULL;
+  g_clear_pointer (&self->app_id, g_free);
+  g_clear_pointer (&self->options, g_variant_unref);
+
+  if (self->app_auth_prompt != NULL) {
+    g_signal_handlers_disconnect_by_func (self->app_auth_prompt, on_access_dialog_closed, self);
+    gtk_widget_set_visible (GTK_WIDGET (self->app_auth_prompt), FALSE);
+  }
+  g_clear_pointer (&self->app_auth_prompt, phosh_cp_widget_destroy);
+}
+
+
 static gboolean
 handle_access_dialog (PhoshDBusImplPortalAccess *object,
                       GDBusMethodInvocation     *invocation,
@@ -81,15 +104,10 @@ handle_access_dialog (PhoshDBusImplPortalAccess *object,
                       const char                *arg_body,
                       GVariant                  *arg_options)
 {
-  const char *sender;
   g_autoptr (GIcon) icon = NULL;
   GVariant *choices = NULL;
   GVariant *icon_variant = g_variant_lookup_value (arg_options, "icon", G_VARIANT_TYPE_STRING);
   PhoshPortalAccessManager *self = PHOSH_PORTAL_ACCESS_MANAGER (object);
-  g_autoptr (PhoshPortalRequest) request = NULL;
-
-  sender = g_dbus_method_invocation_get_sender (invocation);
-  request = phosh_portal_request_new (sender, arg_app_id, arg_handle);
 
   if (self->app_auth_prompt != NULL) {
     return FALSE;
@@ -109,7 +127,6 @@ handle_access_dialog (PhoshDBusImplPortalAccess *object,
   self->choices = choices;
   self->app_id = g_strdup (arg_app_id);
   self->options = g_variant_ref (arg_options);
-  self->request = g_steal_pointer (&request);
   /* Plinius: the three buttons (or those the caller names) instead of grant and deny */
   self->app_auth_prompt = PHOSH_APP_AUTH_PROMPT (
     phosh_app_auth_prompt_new_with_buttons (icon,
@@ -130,7 +147,8 @@ handle_access_dialog (PhoshDBusImplPortalAccess *object,
                           self->app_auth_prompt, "visible",
                           G_BINDING_SYNC_CREATE | G_BINDING_INVERT_BOOLEAN);
 
-  phosh_portal_request_export (self->request, g_dbus_method_invocation_get_connection (invocation));
+  /* Plinius: the request object at the handle; closed, or its caller gone, the dialog goes */
+  self->request = phosh_access_request_new (invocation, arg_handle, on_request_gone, self);
   return TRUE;
 }
 
@@ -198,7 +216,7 @@ phosh_portal_access_manager_dispose (GObject *object)
   PhoshPortalAccessManager *self = PHOSH_PORTAL_ACCESS_MANAGER (object);
 
   g_clear_pointer (&self->app_auth_prompt, phosh_cp_widget_destroy);
-  g_clear_object (&self->request);
+  g_clear_pointer (&self->request, phosh_access_request_free);
   g_clear_pointer (&self->app_id, g_free);
   g_clear_pointer (&self->options, g_variant_unref);
 
