From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 22 Nov 2026 12:00:00 +0100
Subject: [PATCH] portal-access-manager: A request that goes away closes its
 dialog

Plinius: an access dialog stayed open when its request went away, and
while it was open every later AccessDialog failed (handle_access_dialog
returns FALSE, the caller gets UnknownMethod) until someone tapped it.
Measured on the phone: xdg-desktop-portal calls
org.freedesktop.impl.portal.Request.Close on Phosh's request object
when the app closes its request, and PhoshPortalRequest's Close only
unexported it. A direct caller of AccessDialog (plinius-appaccess's
agent) may also leave the bus while its question is open.

access-request.c exports the request object at the handle itself and
watches the caller's unique name. Close, or the caller gone, closes the
dialog and answers the call with response 2 ("plinius-choice" "cancel"):
nothing is granted, nothing written to the permission store and no
"Allow Once" clean-up started. The next question shows again.
---
 src/access-request.c        | 153 ++++++++++++++++++++++++++++++++++++
 src/access-request.h        |  33 ++++++++
 src/meson.build             |   2 +
 src/portal-access-manager.c |  42 +++++++---
 4 files changed, 218 insertions(+), 12 deletions(-)
 create mode 100644 src/access-request.c
 create mode 100644 src/access-request.h

diff --git a/src/access-request.c b/src/access-request.c
new file mode 100644
index 00000000..8da70515
--- /dev/null
+++ b/src/access-request.c
@@ -0,0 +1,153 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-access-request"
+
+#include "access-request.h"
+
+/**
+ * SECTION:access-request
+ *
+ * Plinius: the request of an open access dialog (org.freedesktop.impl.portal.Access).
+ *
+ * The request goes away before it is answered in two ways: xdg-desktop-portal calls
+ * org.freedesktop.impl.portal.Request.Close on the request object at the handle (the app
+ * closed its request or left), or the caller itself leaves the bus (a caller that asks
+ * AccessDialog directly, as plinius-appaccess's agent). Either way the dialog must go, or it
+ * stays open and blocks every later question.
+ *
+ * A #PhoshAccessRequest exports the request object at the handle on the connection of the
+ * call and watches the caller's unique name; whichever comes first calls the gone function,
+ * once. phosh_access_request_cancel() then answers the call as ended (response 2).
+ */
+
+#define REQUEST_INTERFACE "org.freedesktop.impl.portal.Request"
+
+static const char introspection[] =
+  "<node><interface name='" REQUEST_INTERFACE "'><method name='Close'/></interface></node>";
+
+struct _PhoshAccessRequest {
+  GDBusConnection            *bus;
+  char                       *handle;
+  guint                       registration;
+  guint                       watch;
+  PhoshAccessRequestGoneFunc  gone;
+  gpointer                    user_data;
+};
+
+
+static void
+request_gone (PhoshAccessRequest *self, const char *why)
+{
+  PhoshAccessRequestGoneFunc gone = self->gone;
+
+  if (gone == NULL)
+    return;
+
+  g_debug ("Request %s %s", self->handle, why);
+  self->gone = NULL;
+  /* The gone function may free the request */
+  gone (self->user_data, why);
+}
+
+
+static void
+on_method_call (GDBusConnection       *bus,
+                const char            *sender,
+                const char            *path,
+                const char            *iface,
+                const char            *method,
+                GVariant              *params,
+                GDBusMethodInvocation *invocation,
+                gpointer               user_data)
+{
+  /* Close is the interface's only method; GDBus refuses others */
+  g_dbus_method_invocation_return_value (invocation, NULL);
+  request_gone (user_data, "closed");
+}
+
+
+static void
+on_name_vanished (GDBusConnection *bus, const char *name, gpointer user_data)
+{
+  request_gone (user_data, "vanished");
+}
+
+
+/**
+ * phosh_access_request_new:
+ * @invocation: the pending AccessDialog call
+ * @handle: its request handle (an object path)
+ * @gone: called when the request goes away before it is answered
+ * @user_data: for @gone
+ *
+ * Returns: the request; free it with phosh_access_request_free() once answered or gone
+ */
+PhoshAccessRequest *
+phosh_access_request_new (GDBusMethodInvocation      *invocation,
+                          const char                 *handle,
+                          PhoshAccessRequestGoneFunc  gone,
+                          gpointer                    user_data)
+{
+  static const GDBusInterfaceVTable vtable = { on_method_call, NULL, NULL, { 0 } };
+  g_autoptr (GDBusNodeInfo) info = g_dbus_node_info_new_for_xml (introspection, NULL);
+  g_autoptr (GError) err = NULL;
+  PhoshAccessRequest *self = g_new0 (PhoshAccessRequest, 1);
+  const char *sender = g_dbus_method_invocation_get_sender (invocation);
+
+  self->bus = g_object_ref (g_dbus_method_invocation_get_connection (invocation));
+  self->handle = g_strdup (handle);
+  self->gone = gone;
+  self->user_data = user_data;
+
+  if (handle && g_variant_is_object_path (handle)) {
+    self->registration = g_dbus_connection_register_object (self->bus, handle, info->interfaces[0],
+                                                            &vtable, self, NULL, &err);
+    if (self->registration == 0)
+      g_warning ("Could not export request %s: %s", handle, err->message);
+  } else {
+    g_warning ("Request handle '%s' is no object path", handle ? handle : "");
+  }
+
+  /* A caller without a name (a peer-to-peer connection) cannot vanish but with it */
+  if (sender)
+    self->watch = g_bus_watch_name_on_connection (self->bus, sender, G_BUS_NAME_WATCHER_FLAGS_NONE,
+                                                  NULL, on_name_vanished, self, NULL);
+  return self;
+}
+
+
+void
+phosh_access_request_free (PhoshAccessRequest *self)
+{
+  if (self == NULL)
+    return;
+
+  if (self->registration)
+    g_dbus_connection_unregister_object (self->bus, self->registration);
+  g_clear_handle_id (&self->watch, g_bus_unwatch_name);
+  g_clear_object (&self->bus);
+  g_free (self->handle);
+  g_free (self);
+}
+
+
+/**
+ * phosh_access_request_cancel:
+ * @invocation: the AccessDialog call
+ *
+ * Answers the call as ended without an answer of the user (response 2): nothing is to be
+ * granted or stored.
+ */
+void
+phosh_access_request_cancel (GDBusMethodInvocation *invocation)
+{
+  g_autoptr (GVariantDict) results = g_variant_dict_new (NULL);
+
+  g_variant_dict_insert (results, "plinius-choice", "s", "cancel");
+  g_dbus_method_invocation_return_value (invocation,
+                                         g_variant_new ("(u@a{sv})", 2, g_variant_dict_end (results)));
+}
diff --git a/src/access-request.h b/src/access-request.h
new file mode 100644
index 00000000..0aff7b74
--- /dev/null
+++ b/src/access-request.h
@@ -0,0 +1,33 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+typedef struct _PhoshAccessRequest PhoshAccessRequest;
+
+/**
+ * PhoshAccessRequestGoneFunc:
+ * @user_data: the data given to phosh_access_request_new()
+ * @why: "closed" (Request.Close) or "vanished" (the caller left the bus)
+ *
+ * The request went away before it was answered. Called at most once.
+ */
+typedef void (*PhoshAccessRequestGoneFunc) (gpointer user_data, const char *why);
+
+PhoshAccessRequest *phosh_access_request_new (GDBusMethodInvocation      *invocation,
+                                              const char                 *handle,
+                                              PhoshAccessRequestGoneFunc  gone,
+                                              gpointer                    user_data);
+void                phosh_access_request_free (PhoshAccessRequest *self);
+void                phosh_access_request_cancel (GDBusMethodInvocation *invocation);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (PhoshAccessRequest, phosh_access_request_free)
+
+G_END_DECLS
