diff --git a/plugins/caffeine-quick-setting/caffeine-quick-setting.c b/plugins/caffeine-quick-setting/caffeine-quick-setting.c
index e60845cd..8e387032 100644
--- a/plugins/caffeine-quick-setting/caffeine-quick-setting.c
+++ b/plugins/caffeine-quick-setting/caffeine-quick-setting.c
@@ -302,12 +302,13 @@ transform_to_label (GBinding     *binding,
   gboolean inhibited = g_value_get_boolean (from_value);
 
   if (!inhibited) {
-    g_value_set_string (to_value, C_("caffeine-disabled", "Off"));
+    /* Plinius: the tile's name; whether it is on shows in the accent color, not in words */
+    g_value_set_string (to_value, _("Caffeine"));
   } else if (self->update_id) {
     g_autofree char *label = cui_call_format_duration ((uint) self->remaining);
     g_value_set_string (to_value, label);
   } else {
-    g_value_set_string (to_value, C_("caffeine-enabled", "On"));
+    g_value_set_string (to_value, _("Caffeine"));
   }
 
   return TRUE;
