+++ b/plugins/location-quick-setting/location-quick-setting.c
@@ -88,7 +88,9 @@ transform_to_label (GBinding     *binding,
   gboolean enabled = g_value_get_boolean (from_value);
   const char *label;
 
-  label = enabled ? _("Location On") : _("Location Off");
+  /* Plinius: the tile's name; whether it is on shows in the accent color, not in words */
+  (void) enabled;
+  label = _("Location");
   g_value_set_string (to_value, label);
   return TRUE;
 }
