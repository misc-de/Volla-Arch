diff --git a/plugins/usb-quick-setting/meson.build b/plugins/usb-quick-setting/meson.build
new file mode 100644
index 00000000..9017f251
--- /dev/null
+++ b/plugins/usb-quick-setting/meson.build
@@ -0,0 +1,48 @@
+# Plinius: what a computer gets over USB, through plinius-usb (org.plinius.Usb)
+name = 'usb-quick-setting'
+
+usb_quick_setting_resources = gnome.compile_resources(
+  'phosh-plugin-usb-quick-setting-resources',
+  'phosh-plugin-usb-quick-setting.gresources.xml',
+  c_name: 'phosh_plugin_usb_quick_setting',
+)
+
+usb_quick_setting_plugin_sources = files(
+  'usb-quick-setting.c',
+  'phosh-plugin-usb-quick-setting.c',
+)
+
+phosh_usb_quick_setting_plugin = shared_module(
+  'phosh-plugin-usb-quick-setting',
+  usb_quick_setting_plugin_sources,
+  usb_quick_setting_resources,
+  c_args: [
+    '-DG_LOG_DOMAIN="phosh-plugin-@0@"'.format(name),
+    '-DPLUGIN_NAME="@0@"'.format(name),
+  ],
+  dependencies: plugin_dep,
+  install: true,
+  install_dir: plugins_dir,
+)
+
+pluginconf = configuration_data()
+pluginconf.set('name', name)
+pluginconf.set('plugins_dir', plugins_dir)
+
+i18n.merge_file(
+  input: configure_file(
+    input: name + '.desktop.in.in',
+    output: name + '.desktop.in',
+    configuration: pluginconf,
+  ),
+  output: name + '.plugin',
+  po_dir: meson.project_source_root() / 'po',
+  install: true,
+  install_dir: plugins_dir,
+  type: 'desktop',
+)
+
+install_data(
+  'icons/usb-quick-setting-symbolic.svg',
+  install_dir: phosh_plugin_icon_dir,
+)
