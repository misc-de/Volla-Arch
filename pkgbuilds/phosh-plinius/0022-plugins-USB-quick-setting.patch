diff --git a/plugins/usb-quick-setting/usb-quick-setting.c b/plugins/usb-quick-setting/usb-quick-setting.c
new file mode 100644
index 00000000..bc8a7c37
--- /dev/null
+++ b/plugins/usb-quick-setting/usb-quick-setting.c
@@ -0,0 +1,295 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "usb-quick-setting.h"
+#include "plugin-shell.h"
+#include "quick-setting.h"
+#include "status-icon.h"
+#include "status-page.h"
+
+#include <handy.h>
+#include <glib/gi18n.h>
+
+#define USB_BUS_NAME "org.plinius.Usb"
+#define USB_OBJECT_PATH "/org/plinius/Usb"
+#define USB_INTERFACE "org.plinius.Usb"
+
+/**
+ * PhoshUsbQuickSetting:
+ *
+ * What an attached computer gets over USB, through plinius-usb (org.plinius.Usb):
+ * file sharing, a USB network and internet through the phone. The tile only shows
+ * while a computer is attached; nothing is on unless chosen (charging only).
+ * Functions only go on while the phone is unlocked, switching off always works.
+ */
+struct _PhoshUsbQuickSetting {
+  PhoshQuickSetting  parent;
+
+  PhoshStatusIcon   *info;
+  PhoshStatusPage   *status_page;
+  GtkWidget         *mtp_row;
+  GtkSwitch         *mtp_switch;
+  GtkSwitch         *ncm_switch;
+  GtkSwitch         *gateway_switch;
+  GtkLabel          *locked_label;
+  GtkLabel          *error_label;
+
+  GDBusProxy        *proxy;
+  GCancellable      *cancel;
+  /* Switches set from the service's state, not by the user */
+  gboolean           updating;
+};
+G_DEFINE_TYPE (PhoshUsbQuickSetting, phosh_usb_quick_setting, PHOSH_TYPE_QUICK_SETTING);
+
+
+static gboolean
+get_bool (PhoshUsbQuickSetting *self, const char *name)
+{
+  g_autoptr (GVariant) value = NULL;
+
+  if (self->proxy)
+    value = g_dbus_proxy_get_cached_property (self->proxy, name);
+  return value && g_variant_is_of_type (value, G_VARIANT_TYPE_BOOLEAN) &&
+    g_variant_get_boolean (value);
+}
+
+
+static GStrv
+get_strv (PhoshUsbQuickSetting *self, const char *name)
+{
+  g_autoptr (GVariant) value = NULL;
+
+  if (self->proxy)
+    value = g_dbus_proxy_get_cached_property (self->proxy, name);
+  if (!value || !g_variant_is_of_type (value, G_VARIANT_TYPE_STRING_ARRAY))
+    return g_new0 (char *, 1);
+  return g_variant_dup_strv (value, NULL);
+}
+
+
+static gboolean
+is_locked (void)
+{
+  return phosh_shell_get_locked (phosh_shell_get_default ());
+}
+
+
+static void
+update (PhoshUsbQuickSetting *self)
+{
+  g_autofree char *owner = NULL;
+  g_auto (GStrv) functions = get_strv (self, "Functions");
+  g_auto (GStrv) available = get_strv (self, "AvailableFunctions");
+  g_autoptr (GVariant) error = NULL;
+  gboolean mtp = g_strv_contains ((const char * const *) functions, "mtp");
+  gboolean ncm = g_strv_contains ((const char * const *) functions, "ncm");
+  gboolean gateway = g_strv_contains ((const char * const *) functions, "gateway");
+  gboolean locked = is_locked ();
+  const char *text;
+
+  if (self->proxy) {
+    owner = g_dbus_proxy_get_name_owner (self->proxy);
+    error = g_dbus_proxy_get_cached_property (self->proxy, "Error");
+  }
+
+  /* Only while a computer is attached */
+  gtk_widget_set_visible (GTK_WIDGET (self), owner && get_bool (self, "Connected"));
+
+  /* Tile: what the computer gets; the gateway includes the network */
+  phosh_quick_setting_set_active (PHOSH_QUICK_SETTING (self), mtp || ncm);
+  if (mtp && gateway)
+    text = _("Files + Internet");
+  else if (mtp && ncm)
+    text = _("Files + Network");
+  else if (mtp)
+    text = _("File Sharing");
+  else if (gateway)
+    text = _("Internet Sharing");
+  else if (ncm)
+    text = _("USB Network");
+  else
+    text = _("Charging Only");
+  phosh_status_icon_set_info (self->info, text);
+
+  /* Status page: switches show the state; while locked only what is on can be switched */
+  self->updating = TRUE;
+  gtk_switch_set_active (self->mtp_switch, mtp);
+  gtk_switch_set_active (self->ncm_switch, ncm);
+  gtk_switch_set_active (self->gateway_switch, gateway);
+  self->updating = FALSE;
+  gtk_widget_set_sensitive (GTK_WIDGET (self->mtp_switch), mtp || !locked);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->ncm_switch), ncm || !locked);
+  gtk_widget_set_sensitive (GTK_WIDGET (self->gateway_switch), gateway || !locked);
+  gtk_widget_set_visible (self->mtp_row,
+                          g_strv_contains ((const char * const *) available, "mtp"));
+  gtk_widget_set_visible (GTK_WIDGET (self->locked_label), locked);
+
+  if (error && g_variant_is_of_type (error, G_VARIANT_TYPE_STRING) &&
+      *g_variant_get_string (error, NULL)) {
+    gtk_label_set_text (self->error_label, g_variant_get_string (error, NULL));
+    gtk_widget_set_visible (GTK_WIDGET (self->error_label), TRUE);
+  } else {
+    gtk_widget_set_visible (GTK_WIDGET (self->error_label), FALSE);
+  }
+}
+
+
+static void
+on_set_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &err);
+  PhoshUsbQuickSetting *self;
+
+  if (reply || g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  self = PHOSH_USB_QUICK_SETTING (user_data);
+  g_warning ("Failed to set the USB functions: %s", err->message);
+  /* Back to what the service has, and say why (e.g. locked meanwhile) */
+  update (self);
+  g_dbus_error_strip_remote_error (err);
+  gtk_label_set_text (self->error_label, err->message);
+  gtk_widget_set_visible (GTK_WIDGET (self->error_label), TRUE);
+}
+
+
+static void
+set_functions (PhoshUsbQuickSetting *self, gboolean mtp, gboolean ncm, gboolean gateway)
+{
+  GVariantBuilder builder;
+
+  if (!self->proxy)
+    return;
+
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("as"));
+  if (mtp)
+    g_variant_builder_add (&builder, "s", "mtp");
+  if (ncm)
+    g_variant_builder_add (&builder, "s", "ncm");
+  if (gateway)
+    g_variant_builder_add (&builder, "s", "gateway");
+
+  gtk_widget_set_visible (GTK_WIDGET (self->error_label), FALSE);
+  /* Rebuilding the gadget takes a moment (File Sharing starts its responder) */
+  g_dbus_proxy_call (self->proxy, "SetFunctions", g_variant_new ("(as)", &builder),
+                     G_DBUS_CALL_FLAGS_NONE, 10000, self->cancel, on_set_done, self);
+}
+
+
+static void
+on_switch_toggled (PhoshUsbQuickSetting *self, GParamSpec *pspec, GtkSwitch *toggled)
+{
+  gboolean mtp, ncm, gateway;
+
+  if (self->updating)
+    return;
+
+  mtp = gtk_switch_get_active (self->mtp_switch);
+  ncm = gtk_switch_get_active (self->ncm_switch);
+  gateway = gtk_switch_get_active (self->gateway_switch);
+
+  /* Internet for the computer runs over the USB network */
+  if (toggled == self->gateway_switch && gateway)
+    ncm = TRUE;
+  else if (toggled == self->ncm_switch && !ncm)
+    gateway = FALSE;
+
+  set_functions (self, mtp, ncm, gateway);
+}
+
+
+static void
+on_clicked (PhoshUsbQuickSetting *self)
+{
+  /* Off is always allowed: back to charging only */
+  if (phosh_quick_setting_get_active (PHOSH_QUICK_SETTING (self))) {
+    set_functions (self, FALSE, FALSE, FALSE);
+    return;
+  }
+  /* Nothing to switch back on in one go: show the choice */
+  g_signal_emit_by_name (self, "show-status");
+}
+
+
+static void
+on_proxy_ready (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  PhoshUsbQuickSetting *self;
+  g_autoptr (GError) err = NULL;
+  GDBusProxy *proxy = g_dbus_proxy_new_for_bus_finish (res, &err);
+
+  if (!proxy) {
+    if (!g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+      g_warning ("Failed to create the plinius-usb proxy: %s", err->message);
+    return;
+  }
+
+  self = PHOSH_USB_QUICK_SETTING (user_data);
+  self->proxy = proxy;
+  g_signal_connect_object (proxy, "g-properties-changed", G_CALLBACK (update), self,
+                           G_CONNECT_SWAPPED);
+  g_signal_connect_object (proxy, "notify::g-name-owner", G_CALLBACK (update), self,
+                           G_CONNECT_SWAPPED);
+  update (self);
+}
+
+
+static void
+phosh_usb_quick_setting_dispose (GObject *object)
+{
+  PhoshUsbQuickSetting *self = PHOSH_USB_QUICK_SETTING (object);
+
+  g_cancellable_cancel (self->cancel);
+  g_clear_object (&self->cancel);
+  g_clear_object (&self->proxy);
+
+  G_OBJECT_CLASS (phosh_usb_quick_setting_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_usb_quick_setting_class_init (PhoshUsbQuickSettingClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_usb_quick_setting_dispose;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/usb-quick-setting/qs.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, info);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, status_page);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, mtp_row);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, mtp_switch);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, ncm_switch);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, gateway_switch);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, locked_label);
+  gtk_widget_class_bind_template_child (widget_class, PhoshUsbQuickSetting, error_label);
+  gtk_widget_class_bind_template_callback (widget_class, on_clicked);
+  gtk_widget_class_bind_template_callback (widget_class, on_switch_toggled);
+}
+
+
+static void
+phosh_usb_quick_setting_init (PhoshUsbQuickSetting *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+  gtk_icon_theme_add_resource_path (gtk_icon_theme_get_default (),
+                                    "/mobi/phosh/plugins/usb-quick-setting/icons");
+  /* Visibility follows the cable, a show_all of the quick settings must not override it */
+  gtk_widget_set_no_show_all (GTK_WIDGET (self), TRUE);
+
+  g_signal_connect_object (phosh_shell_get_default (), "notify::locked", G_CALLBACK (update),
+                           self, G_CONNECT_SWAPPED);
+
+  self->cancel = g_cancellable_new ();
+  update (self);
+  g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM,
+                            G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START,
+                            NULL, USB_BUS_NAME, USB_OBJECT_PATH, USB_INTERFACE,
+                            self->cancel, on_proxy_ready, self);
+}
