+
+/**
+ * phosh_layout_manager_get_top_bar_notch:
+ * @self: The layout manager
+ * @notch: (out): The notch in the top bar (GTK coordinates)
+ *
+ * Plinius: where the notch reaches into the top bar, e.g. so that a tap on it can be
+ * told from a tap elsewhere on the bar.
+ *
+ * Returns: %TRUE if the built-in display is upright and has a notch in the top bar
+ */
+gboolean
+phosh_layout_manager_get_top_bar_notch (PhoshLayoutManager *self, GdkRectangle *notch)
+{
+  g_return_val_if_fail (PHOSH_IS_LAYOUT_MANAGER (self), FALSE);
+  g_return_val_if_fail (notch, FALSE);
+
+  if (self->layout != PHOSH_SHELL_LAYOUT_DEVICE || self->builtin == NULL || self->panel == NULL)
+    return FALSE;
+
+  if (phosh_monitor_get_transform (self->builtin) != PHOSH_MONITOR_TRANSFORM_NORMAL)
+    return FALSE;
+
+  return get_top_bar_notch (self, phosh_monitor_get_fractional_scale (self->builtin), notch);
+}
