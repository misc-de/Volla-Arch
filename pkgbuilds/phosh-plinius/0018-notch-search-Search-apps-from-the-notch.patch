+/* Plinius: how far next to the notch a tap still counts as a tap on it */
+#define NOTCH_TAP_SLOP 32
+/* Without a notch the middle of the bar takes its place */
+#define NOTCH_TAP_FALLBACK_WIDTH 80
+
+static gboolean
+is_on_notch (PhoshTopPanel *self, double x)
+{
+  PhoshLayoutManager *layout_manager = phosh_shell_get_layout_manager (phosh_shell_get_default ());
+  GdkRectangle notch;
+
+  if (!phosh_layout_manager_get_top_bar_notch (layout_manager, &notch)) {
+    notch.width = NOTCH_TAP_FALLBACK_WIDTH;
+    notch.x = (gtk_widget_get_allocated_width (GTK_WIDGET (self)) - notch.width) / 2;
+  }
+
+  return x >= notch.x - NOTCH_TAP_SLOP && x < notch.x + notch.width + NOTCH_TAP_SLOP;
+}
