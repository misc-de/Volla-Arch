diff --git a/src/notch-search.c b/src/notch-search.c
new file mode 100644
index 00000000..8825743d
--- /dev/null
+++ b/src/notch-search.c
@@ -0,0 +1,451 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-notch-search"
+
+#include "phosh-config.h"
+
+#include "app-tracker.h"
+#include "layout-manager.h"
+#include "notch-search.h"
+#include "shell-priv.h"
+
+#include <gio/gdesktopappinfo.h>
+#include <glib/gi18n.h>
+#include <handy.h>
+
+/**
+ * PhoshNotchSearch:
+ *
+ * Plinius: a minimal app search that unfolds from the notch when the notch is tapped.
+ * It covers the whole screen so that a tap next to the search, or on the notch again,
+ * closes it.
+ */
+
+#define MAX_RESULTS     6
+#define ICON_SIZE       32
+#define CARD_MARGIN     4    /* distance of the card to the screen's sides (and top without notch) */
+#define CARD_MAX_WIDTH  420
+#define REVEAL_DURATION 180  /* ms */
+#define STEM_TOP_RADIUS 8    /* the stem flows out of the screen's top edge with this radius */
+#define STEM_CARD_RADIUS 12  /* and into the card with this one */
+
+enum {
+  PROP_0,
+  PROP_MONITOR,
+  PROP_LAST_PROP,
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+enum {
+  APP_LAUNCHED,
+  N_SIGNALS
+};
+static guint signals[N_SIGNALS] = { 0 };
+
+struct _PhoshNotchSearch {
+  PhoshLayerSurface parent;
+
+  PhoshMonitor     *monitor;
+
+  GtkWidget        *revealer;
+  GtkWidget        *card;
+  GtkWidget        *entry;
+  GtkWidget        *results;
+
+  GtkGesture       *click_gesture;
+  gboolean          close_on_release;
+
+  /* The notch's left edge and width inside the stem's drawing area */
+  int               stem_notch_x;
+  int               stem_notch_width;
+};
+
+G_DEFINE_TYPE (PhoshNotchSearch, phosh_notch_search, PHOSH_TYPE_LAYER_SURFACE)
+
+
+static void
+close_search (PhoshNotchSearch *self)
+{
+  gtk_widget_destroy (GTK_WIDGET (self));
+}
+
+
+static void
+launch_app (PhoshNotchSearch *self, GAppInfo *info)
+{
+  PhoshAppTracker *app_tracker = phosh_shell_get_app_tracker (phosh_shell_get_default ());
+
+  g_debug ("Launching %s", g_app_info_get_id (info));
+  phosh_app_tracker_launch_app_info (app_tracker, info);
+  g_signal_emit (self, signals[APP_LAUNCHED], 0, info);
+  close_search (self);
+}
+
+
+static GtkWidget *
+create_result_row (GAppInfo *info)
+{
+  GtkWidget *row, *box, *icon, *label;
+  GIcon *gicon = g_app_info_get_icon (info);
+
+  box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 12);
+
+  icon = gicon ? gtk_image_new_from_gicon (gicon, GTK_ICON_SIZE_DND) :
+    gtk_image_new_from_icon_name ("application-x-executable", GTK_ICON_SIZE_DND);
+  gtk_image_set_pixel_size (GTK_IMAGE (icon), ICON_SIZE);
+  gtk_container_add (GTK_CONTAINER (box), icon);
+
+  label = gtk_label_new (g_app_info_get_display_name (info));
+  gtk_label_set_ellipsize (GTK_LABEL (label), PANGO_ELLIPSIZE_END);
+  gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+  gtk_container_add (GTK_CONTAINER (box), label);
+
+  row = gtk_list_box_row_new ();
+  gtk_container_add (GTK_CONTAINER (row), box);
+  g_object_set_data_full (G_OBJECT (row), "app-info", g_object_ref (info), g_object_unref);
+  gtk_widget_show_all (row);
+
+  return row;
+}
+
+
+/* GLib's desktop file index ranks the hits in groups, best group first */
+static void
+update_results (PhoshNotchSearch *self)
+{
+  g_autoptr (GList) rows = gtk_container_get_children (GTK_CONTAINER (self->results));
+  g_autofree char *text = g_strstrip (g_strdup (gtk_entry_get_text (GTK_ENTRY (self->entry))));
+  char ***groups;
+  guint n = 0;
+
+  for (GList *l = rows; l; l = l->next)
+    gtk_widget_destroy (l->data);
+
+  groups = text[0] ? g_desktop_app_info_search (text) : NULL;
+  for (int i = 0; groups && groups[i]; i++) {
+    for (int j = 0; groups[i][j] && n < MAX_RESULTS; j++) {
+      g_autoptr (GDesktopAppInfo) info = g_desktop_app_info_new (groups[i][j]);
+
+      if (info == NULL || !g_app_info_should_show (G_APP_INFO (info)))
+        continue;
+
+      gtk_container_add (GTK_CONTAINER (self->results), create_result_row (G_APP_INFO (info)));
+      n++;
+    }
+    g_strfreev (groups[i]);
+  }
+  g_free (groups);
+
+  gtk_widget_set_visible (self->results, n > 0);
+}
+
+
+static void
+on_entry_activated (PhoshNotchSearch *self)
+{
+  GtkListBoxRow *row = gtk_list_box_get_row_at_index (GTK_LIST_BOX (self->results), 0);
+
+  if (row)
+    launch_app (self, g_object_get_data (G_OBJECT (row), "app-info"));
+}
+
+
+static void
+on_row_activated (PhoshNotchSearch *self, GtkListBoxRow *row)
+{
+  launch_app (self, g_object_get_data (G_OBJECT (row), "app-info"));
+}
+
+
+/* Whether a press at @x, @y (surface coordinates) closes the search */
+static gboolean
+is_outside (PhoshNotchSearch *self, double x, double y)
+{
+  GtkAllocation card;
+  int cx, cy;
+
+  /* The notch and its stem lie outside the card, so a tap on them closes too */
+  gtk_widget_get_allocation (self->card, &card);
+  if (!gtk_widget_translate_coordinates (GTK_WIDGET (self), self->card, x, y, &cx, &cy))
+    return TRUE;
+
+  return cx < 0 || cy < 0 || cx >= card.width || cy >= card.height;
+}
+
+
+static void
+on_pressed (PhoshNotchSearch *self, int n_press, double x, double y)
+{
+  self->close_on_release = is_outside (self, x, y);
+
+  /* Keep the press away from the entry and the results */
+  if (self->close_on_release)
+    gtk_gesture_set_state (self->click_gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+}
+
+
+static void
+on_released (PhoshNotchSearch *self, int n_press, double x, double y)
+{
+  if (self->close_on_release)
+    close_search (self);
+}
+
+
+/* The stem: as wide as the notch, with concave curves into the screen's top edge and into the
+ * card, so notch, stem and card read as one shape */
+static gboolean
+on_stem_draw (PhoshNotchSearch *self, cairo_t *cr, GtkWidget *stem)
+{
+  GtkStyleContext *context = gtk_widget_get_style_context (stem);
+  double h = gtk_widget_get_allocated_height (stem);
+  double x0 = self->stem_notch_x;
+  double x1 = x0 + self->stem_notch_width;
+  /* Both curves have to fit, with a straight piece between them */
+  double rt = MIN (STEM_TOP_RADIUS, h / 3);
+  double rb = MIN (STEM_CARD_RADIUS, h / 3);
+  GdkRGBA color;
+
+  gtk_style_context_get_color (context, gtk_style_context_get_state (context), &color);
+  gdk_cairo_set_source_rgba (cr, &color);
+
+  cairo_move_to (cr, x0 - rt, 0);
+  cairo_line_to (cr, x1 + rt, 0);
+  cairo_arc_negative (cr, x1 + rt, rt, rt, -G_PI / 2, G_PI);
+  cairo_line_to (cr, x1, h - rb);
+  cairo_arc_negative (cr, x1 + rb, h - rb, rb, G_PI, G_PI / 2);
+  cairo_line_to (cr, x0 - rb, h);
+  cairo_arc_negative (cr, x0 - rb, h - rb, rb, G_PI / 2, 0);
+  cairo_line_to (cr, x0, rt);
+  cairo_arc_negative (cr, x0 - rt, rt, rt, 0, -G_PI / 2);
+  cairo_close_path (cr);
+  cairo_fill (cr);
+
+  return GDK_EVENT_PROPAGATE;
+}
+
+
+static gboolean
+on_key_press (PhoshNotchSearch *self, GdkEventKey *event)
+{
+  if (event->keyval != GDK_KEY_Escape)
+    return GDK_EVENT_PROPAGATE;
+
+  close_search (self);
+  return GDK_EVENT_STOP;
+}
+
+
+static void
+phosh_notch_search_set_property (GObject      *object,
+                                 guint         property_id,
+                                 const GValue *value,
+                                 GParamSpec   *pspec)
+{
+  PhoshNotchSearch *self = PHOSH_NOTCH_SEARCH (object);
+
+  switch (property_id) {
+  case PROP_MONITOR:
+    g_set_object (&self->monitor, g_value_get_object (value));
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_notch_search_get_property (GObject    *object,
+                                 guint       property_id,
+                                 GValue     *value,
+                                 GParamSpec *pspec)
+{
+  PhoshNotchSearch *self = PHOSH_NOTCH_SEARCH (object);
+
+  switch (property_id) {
+  case PROP_MONITOR:
+    g_value_set_object (value, self->monitor);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+
+static void
+phosh_notch_search_map (GtkWidget *widget)
+{
+  PhoshNotchSearch *self = PHOSH_NOTCH_SEARCH (widget);
+
+  GTK_WIDGET_CLASS (phosh_notch_search_parent_class)->map (widget);
+
+  /* The notch was tapped to search, so the entry takes the input right away */
+  gtk_revealer_set_reveal_child (GTK_REVEALER (self->revealer), TRUE);
+  gtk_widget_grab_focus (self->entry);
+}
+
+
+static void
+phosh_notch_search_dispose (GObject *object)
+{
+  PhoshNotchSearch *self = PHOSH_NOTCH_SEARCH (object);
+
+  g_clear_object (&self->click_gesture);
+  g_clear_object (&self->monitor);
+
+  G_OBJECT_CLASS (phosh_notch_search_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_notch_search_constructed (GObject *object)
+{
+  PhoshNotchSearch *self = PHOSH_NOTCH_SEARCH (object);
+  PhoshShell *shell = phosh_shell_get_default ();
+  PhoshWayland *wl = phosh_wayland_get_default ();
+  GtkWidget *clamp, *inner, *box;
+  GdkRectangle notch;
+  gboolean has_notch;
+
+  g_object_set (PHOSH_LAYER_SURFACE (self),
+                "layer-shell", phosh_wayland_get_zwlr_layer_shell_v1 (wl),
+                "wl-output", phosh_monitor_get_wl_output (self->monitor),
+                "anchor", ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT |
+                ZWLR_LAYER_SURFACE_V1_ANCHOR_RIGHT,
+                "layer", ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+                "kbd-interactivity", TRUE,
+                "exclusive-zone", -1,
+                "namespace", "phosh notch-search",
+                NULL);
+
+  self->card = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_style_context_add_class (gtk_widget_get_style_context (self->card), "card");
+
+  self->entry = gtk_search_entry_new ();
+  gtk_entry_set_placeholder_text (GTK_ENTRY (self->entry), _("Search apps…"));
+  gtk_container_add (GTK_CONTAINER (self->card), self->entry);
+  g_signal_connect_swapped (self->entry, "search-changed", G_CALLBACK (update_results), self);
+  g_signal_connect_swapped (self->entry, "activate", G_CALLBACK (on_entry_activated), self);
+
+  self->results = gtk_list_box_new ();
+  gtk_list_box_set_selection_mode (GTK_LIST_BOX (self->results), GTK_SELECTION_NONE);
+  gtk_widget_set_no_show_all (self->results, TRUE);
+  gtk_container_add (GTK_CONTAINER (self->card), self->results);
+  g_signal_connect_swapped (self->results, "row-activated", G_CALLBACK (on_row_activated), self);
+
+  clamp = hdy_clamp_new ();
+  hdy_clamp_set_maximum_size (HDY_CLAMP (clamp), CARD_MAX_WIDTH);
+  hdy_clamp_set_tightening_threshold (HDY_CLAMP (clamp), CARD_MAX_WIDTH);
+  gtk_container_add (GTK_CONTAINER (clamp), self->card);
+
+  /* The card opens right below the notch; a stem as wide as the notch joins the two. Its
+   * drawing area is wider than the notch by the curves on both sides. */
+  inner = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  has_notch = phosh_layout_manager_get_top_bar_notch (phosh_shell_get_layout_manager (shell), &notch);
+  if (has_notch) {
+    GtkWidget *stem = gtk_drawing_area_new ();
+    int curve = MAX (STEM_TOP_RADIUS, STEM_CARD_RADIUS);
+    int start = MAX (0, notch.x - CARD_MARGIN - curve);
+
+    self->stem_notch_x = notch.x - CARD_MARGIN - start;
+    self->stem_notch_width = notch.width;
+    gtk_style_context_add_class (gtk_widget_get_style_context (stem), "notch-stem");
+    gtk_widget_set_halign (stem, GTK_ALIGN_START);
+    gtk_widget_set_margin_start (stem, start);
+    gtk_widget_set_size_request (stem, self->stem_notch_x + notch.width + curve,
+                                 notch.y + notch.height);
+    g_signal_connect_swapped (stem, "draw", G_CALLBACK (on_stem_draw), self);
+    gtk_container_add (GTK_CONTAINER (inner), stem);
+  }
+  gtk_container_add (GTK_CONTAINER (inner), clamp);
+
+  self->revealer = gtk_revealer_new ();
+  gtk_revealer_set_transition_type (GTK_REVEALER (self->revealer),
+                                    GTK_REVEALER_TRANSITION_TYPE_SLIDE_DOWN);
+  gtk_revealer_set_transition_duration (GTK_REVEALER (self->revealer), REVEAL_DURATION);
+  gtk_container_add (GTK_CONTAINER (self->revealer), inner);
+
+  box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_set_valign (self->revealer, GTK_ALIGN_START);
+  g_object_set (self->revealer,
+                "margin-top", has_notch ? 0 : CARD_MARGIN,
+                "margin-start", CARD_MARGIN,
+                "margin-end", CARD_MARGIN,
+                NULL);
+  gtk_container_add (GTK_CONTAINER (box), self->revealer);
+  gtk_widget_show_all (box);
+  gtk_container_add (GTK_CONTAINER (self), box);
+
+  /* Capture phase: sees the presses before the entry and the results do */
+  self->click_gesture = gtk_gesture_multi_press_new (GTK_WIDGET (self));
+  gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (self->click_gesture), 0);
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (self->click_gesture),
+                                              GTK_PHASE_CAPTURE);
+  g_signal_connect_swapped (self->click_gesture, "pressed", G_CALLBACK (on_pressed), self);
+  g_signal_connect_swapped (self->click_gesture, "released", G_CALLBACK (on_released), self);
+
+  g_signal_connect (self, "key-press-event", G_CALLBACK (on_key_press), NULL);
+
+  G_OBJECT_CLASS (phosh_notch_search_parent_class)->constructed (object);
+}
+
+
+static void
+phosh_notch_search_class_init (PhoshNotchSearchClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->set_property = phosh_notch_search_set_property;
+  object_class->get_property = phosh_notch_search_get_property;
+  object_class->constructed = phosh_notch_search_constructed;
+  object_class->dispose = phosh_notch_search_dispose;
+  widget_class->map = phosh_notch_search_map;
+
+  props[PROP_MONITOR] =
+    g_param_spec_object ("monitor", "", "",
+                         PHOSH_TYPE_MONITOR,
+                         G_PARAM_READWRITE | G_PARAM_CONSTRUCT_ONLY | G_PARAM_STATIC_STRINGS);
+
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+
+  /**
+   * PhoshNotchSearch::app-launched:
+   * @self: The notch search
+   * @info: The launched app
+   *
+   * An app was started from the search (which then closes).
+   */
+  signals[APP_LAUNCHED] = g_signal_new ("app-launched",
+                                        G_TYPE_FROM_CLASS (klass),
+                                        G_SIGNAL_RUN_LAST,
+                                        0, NULL, NULL, NULL,
+                                        G_TYPE_NONE,
+                                        1,
+                                        G_TYPE_APP_INFO);
+
+  gtk_widget_class_set_css_name (widget_class, "phosh-notch-search");
+}
+
+
+static void
+phosh_notch_search_init (PhoshNotchSearch *self)
+{
+}
+
+
+GtkWidget *
+phosh_notch_search_new (PhoshMonitor *monitor)
+{
+  g_return_val_if_fail (PHOSH_IS_MONITOR (monitor), NULL);
+
+  return g_object_new (PHOSH_TYPE_NOTCH_SEARCH, "monitor", monitor, NULL);
+}
