diff --git a/src/plinius-force-quit.c b/src/plinius-force-quit.c
new file mode 100644
index 00000000..fce1b0b9
--- /dev/null
+++ b/src/plinius-force-quit.c
@@ -0,0 +1,370 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-force-quit"
+
+#include "phosh-config.h"
+
+#include "plinius-force-quit.h"
+
+#include <signal.h>
+#include <string.h>
+
+/*
+ * Plinius: force quit an app whose window does not close.
+ *
+ * Phosh, GLib and the desktop start every app in a systemd user unit of its own:
+ * app-gnome-org.gnome.Console-1234.scope (app-flatpak-..., app-desktop-...), an app activated
+ * through D-Bus in dbus-:1.2-org.gnome.Settings@1.service. Force quitting kills every process
+ * of the units that belong to exactly the app's id, so a terminal is never hit for an app
+ * started from it. An Android app runs under Android's user IDs in the Waydroid container: it
+ * is stopped by Waydroid's helper (am force-stop) through pkexec.
+ */
+
+#define SYSTEMD_NAME  "org.freedesktop.systemd1"
+#define SYSTEMD_PATH  "/org/freedesktop/systemd1"
+#define SYSTEMD_IFACE "org.freedesktop.systemd1.Manager"
+#define TIMEOUT_MS    5000
+
+#ifndef PLINIUS_ANDROID_STOP_HELPER
+#define PLINIUS_ANDROID_STOP_HELPER "/usr/lib/waydroid-plinius/waydroid-plinius-stop-app"
+#endif
+#define ANDROID_PREFIX "waydroid."
+#ifndef PLINIUS_OWN_CGROUP
+#define PLINIUS_OWN_CGROUP "/proc/self/cgroup"
+#endif
+
+
+static char *
+unescape_unit_name (const char *escaped, gsize len)
+{
+  GString *out = g_string_sized_new (len);
+
+  for (gsize i = 0; i < len; i++) {
+    if (escaped[i] == '\\' && i + 3 < len && escaped[i + 1] == 'x' &&
+        g_ascii_isxdigit (escaped[i + 2]) && g_ascii_isxdigit (escaped[i + 3])) {
+      g_string_append_c (out, (char) (g_ascii_xdigit_value (escaped[i + 2]) * 16 +
+                                      g_ascii_xdigit_value (escaped[i + 3])));
+      i += 3;
+    } else {
+      g_string_append_c (out, escaped[i]);
+    }
+  }
+  return g_string_free (out, FALSE);
+}
+
+
+/**
+ * phosh_plinius_force_quit_unit_app_id:
+ * @unit: A unit's name as systemd lists it (escaped)
+ *
+ * The app a unit runs: app-<launcher>-<app id>-<random>.scope,
+ * app-<launcher>-<app id>@<random>.service or dbus-<bus name>-<app id>@<n>.service. The app
+ * id's own "-" are escaped (\x2d), so the parts are told apart by the plain ones.
+ *
+ * Returns:(nullable)(transfer full): The app id, %NULL for any other unit
+ */
+char *
+phosh_plinius_force_quit_unit_app_id (const char *unit)
+{
+  const char *start, *end;
+
+  g_return_val_if_fail (unit, NULL);
+
+  if (g_str_has_prefix (unit, "dbus-") && g_str_has_suffix (unit, ".service")) {
+    /* Past the bus name, which has no "-" */
+    start = strchr (unit + strlen ("dbus-"), '-');
+    if (start == NULL)
+      return NULL;
+    start++;
+    end = strchr (start, '@');
+    if (end == NULL)
+      end = g_strrstr (start, ".service");
+  } else if (g_str_has_prefix (unit, "app-") &&
+             (g_str_has_suffix (unit, ".scope") || g_str_has_suffix (unit, ".service"))) {
+    /* Past the launcher (gnome, desktop, flatpak, ...) */
+    start = strchr (unit + strlen ("app-"), '-');
+    if (start == NULL)
+      return NULL;
+    start++;
+    if (g_str_has_suffix (start, ".scope")) {
+      /* The random part at the end: app-gnome-<app id>-<pid>.scope */
+      end = strrchr (start, '-');
+    } else {
+      end = strchr (start, '@');
+      if (end == NULL)
+        end = g_strrstr (start, ".service");
+    }
+  } else {
+    return NULL;
+  }
+
+  /* One part too many: not a unit of an app */
+  if (end == NULL || end <= start || memchr (start, '-', end - start))
+    return NULL;
+
+  return unescape_unit_name (start, end - start);
+}
+
+
+/**
+ * phosh_plinius_force_quit_android_package:
+ * @app_id: A window's app id
+ *
+ * The Android package of a window of Waydroid's multi-window mode (waydroid.<package>),
+ * checked as Waydroid's helper does: two or more parts of letters, digits and underscores,
+ * each starting with a letter.
+ *
+ * Returns:(nullable)(transfer full): The package, %NULL for any other app
+ */
+char *
+phosh_plinius_force_quit_android_package (const char *app_id)
+{
+  const char *package;
+  gboolean part_start = TRUE;
+  guint parts = 1;
+
+  if (app_id == NULL || !g_str_has_prefix (app_id, ANDROID_PREFIX))
+    return NULL;
+
+  package = app_id + strlen (ANDROID_PREFIX);
+  if (strlen (package) > 255)
+    return NULL;
+
+  for (const char *c = package; *c; c++) {
+    if (part_start) {
+      if (!g_ascii_isalpha (*c))
+        return NULL;
+      part_start = FALSE;
+    } else if (*c == '.') {
+      part_start = TRUE;
+      parts++;
+    } else if (!g_ascii_isalnum (*c) && *c != '_') {
+      return NULL;
+    }
+  }
+
+  if (part_start || parts < 2)
+    return NULL;
+
+  return g_strdup (package);
+}
+
+
+/* The unit Phosh itself runs in, never to be killed */
+static char *
+own_unit (void)
+{
+  g_autofree char *contents = NULL;
+  char *newline, *unit;
+
+  if (!g_file_get_contents (PLINIUS_OWN_CGROUP, &contents, NULL, NULL))
+    return NULL;
+
+  newline = strchr (contents, '\n');
+  if (newline)
+    *newline = '\0';
+  unit = strrchr (contents, '/');
+
+  return unit ? g_strdup (unit + 1) : NULL;
+}
+
+
+static void
+on_list_units_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GTask) task = G_TASK (user_data);
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GVariantIter) iter = NULL;
+  g_autoptr (GStrvBuilder) units = g_strv_builder_new ();
+  g_autofree char *own = own_unit ();
+  const char * const *app_ids = g_task_get_task_data (task);
+  const char *name, *active;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (reply == NULL) {
+    g_task_return_error (task, g_steal_pointer (&err));
+    return;
+  }
+
+  g_variant_get (reply, "(a(ssssssouso))", &iter);
+  while (g_variant_iter_next (iter, "(&s&s&s&s&s&s&ou&s&o)",
+                              &name, NULL, NULL, &active, NULL, NULL, NULL, NULL, NULL, NULL)) {
+    g_autofree char *app_id = NULL;
+
+    if (g_strcmp0 (active, "inactive") == 0 || g_strcmp0 (active, "failed") == 0)
+      continue;
+    if (g_strcmp0 (name, own) == 0)
+      continue;
+
+    app_id = phosh_plinius_force_quit_unit_app_id (name);
+    if (app_id && g_strv_contains (app_ids, app_id)) {
+      g_debug ("%s runs %s", name, app_id);
+      g_strv_builder_add (units, name);
+    }
+  }
+
+  g_task_return_pointer (task, g_strv_builder_end (units), (GDestroyNotify) g_strfreev);
+}
+
+
+static void
+on_bus_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GTask) task = G_TASK (user_data);
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GDBusConnection) bus = NULL;
+  GCancellable *cancellable = g_task_get_cancellable (task);
+  const char *states[] = { NULL };
+  const char *patterns[] = { "app-*.scope", "app-*.service", "dbus-*.service", NULL };
+
+  bus = g_bus_get_finish (res, &err);
+  if (bus == NULL) {
+    g_task_return_error (task, g_steal_pointer (&err));
+    return;
+  }
+
+  g_dbus_connection_call (bus, SYSTEMD_NAME, SYSTEMD_PATH, SYSTEMD_IFACE, "ListUnitsByPatterns",
+                          g_variant_new ("(^as^as)", states, patterns),
+                          G_VARIANT_TYPE ("(a(ssssssouso))"),
+                          G_DBUS_CALL_FLAGS_NONE, TIMEOUT_MS,
+                          cancellable, on_list_units_done, g_steal_pointer (&task));
+}
+
+
+/**
+ * phosh_plinius_force_quit_find:
+ * @app_ids: The ids the app goes by (the window's, the desktop file's without .desktop)
+ * @cancellable: (nullable): To cancel the search
+ * @callback: Called with the result
+ * @user_data: For the callback
+ *
+ * Look for the running units of the user's systemd that run exactly one of @app_ids.
+ */
+void
+phosh_plinius_force_quit_find (const char * const  *app_ids,
+                               GCancellable        *cancellable,
+                               GAsyncReadyCallback  callback,
+                               gpointer             user_data)
+{
+  GTask *task;
+
+  g_return_if_fail (app_ids);
+
+  task = g_task_new (NULL, cancellable, callback, user_data);
+  g_task_set_source_tag (task, phosh_plinius_force_quit_find);
+  g_task_set_task_data (task, g_strdupv ((GStrv) app_ids), (GDestroyNotify) g_strfreev);
+
+  g_bus_get (G_BUS_TYPE_SESSION, cancellable, on_bus_done, task);
+}
+
+
+/**
+ * phosh_plinius_force_quit_find_finish:
+ * @res: The result
+ * @error: The error
+ *
+ * Returns:(transfer full): The units found, maybe none, %NULL on error
+ */
+GStrv
+phosh_plinius_force_quit_find_finish (GAsyncResult *res, GError **error)
+{
+  g_return_val_if_fail (g_task_is_valid (res, NULL), NULL);
+
+  return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+
+static void
+on_kill_unit_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autofree char *unit = user_data;
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GVariant) reply = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (reply == NULL)
+    g_warning ("Failed to force quit %s: %s", unit, err->message);
+  else
+    g_message ("Force quit %s", unit);
+}
+
+
+/**
+ * phosh_plinius_force_quit_kill:
+ * @units: Units from phosh_plinius_force_quit_find()
+ *
+ * Kill every process of @units (SIGKILL): the app gets no chance to save anything.
+ */
+void
+phosh_plinius_force_quit_kill (const char * const *units)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GDBusConnection) bus = NULL;
+
+  if (units == NULL || units[0] == NULL)
+    return;
+
+  bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &err);
+  if (bus == NULL) {
+    g_warning ("Failed to force quit, no session bus: %s", err->message);
+    return;
+  }
+
+  for (guint i = 0; units[i]; i++) {
+    g_dbus_connection_call (bus, SYSTEMD_NAME, SYSTEMD_PATH, SYSTEMD_IFACE, "KillUnit",
+                            g_variant_new ("(ssi)", units[i], "all", SIGKILL),
+                            NULL, G_DBUS_CALL_FLAGS_NONE, TIMEOUT_MS, NULL,
+                            on_kill_unit_done, g_strdup (units[i]));
+  }
+}
+
+
+static void
+on_android_stopped (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autofree char *package = user_data;
+  g_autoptr (GError) err = NULL;
+
+  if (!g_subprocess_wait_check_finish (G_SUBPROCESS (source), res, &err))
+    g_warning ("Failed to force quit %s: %s", package, err->message);
+  else
+    g_message ("Force quit %s", package);
+}
+
+
+/**
+ * phosh_plinius_force_quit_android:
+ * @package: An Android package from phosh_plinius_force_quit_android_package()
+ * @error: The error
+ *
+ * Stop an Android app the Android way, by Waydroid's helper through pkexec. The helper's
+ * polkit action needs no PIN in the active session.
+ *
+ * Returns: %FALSE if the helper could not be started
+ */
+gboolean
+phosh_plinius_force_quit_android (const char *package, GError **error)
+{
+  g_autoptr (GSubprocess) helper = NULL;
+
+  g_return_val_if_fail (package, FALSE);
+
+  if (!g_file_test (PLINIUS_ANDROID_STOP_HELPER, G_FILE_TEST_IS_EXECUTABLE)) {
+    g_set_error (error, G_IO_ERROR, G_IO_ERROR_NOT_FOUND,
+                 "%s is not installed", PLINIUS_ANDROID_STOP_HELPER);
+    return FALSE;
+  }
+
+  helper = g_subprocess_new (G_SUBPROCESS_FLAGS_STDOUT_SILENCE, error,
+                             "pkexec", PLINIUS_ANDROID_STOP_HELPER, package, NULL);
+  if (helper == NULL)
+    return FALSE;
+
+  g_subprocess_wait_check_async (helper, NULL, on_android_stopped, g_strdup (package));
+  return TRUE;
+}
