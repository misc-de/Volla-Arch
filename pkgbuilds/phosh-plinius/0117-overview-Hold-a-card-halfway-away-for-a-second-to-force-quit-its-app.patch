+/*
+ * Plinius: a card swiped at least halfway away and held there for a second asks whether to
+ * force quit its app, for an app that does not close its window when asked to. The card goes
+ * back once released. Asked only once the app's units are known: without one there is nothing
+ * to quit, and the dialog says so.
+ */
+static void
+plinius_fq_close (PhoshOverview *self)
+{
+  PhoshOverviewPrivate *priv = phosh_overview_get_instance_private (self);
+
+  g_cancellable_cancel (priv->plinius_fq_cancel);
+  g_clear_object (&priv->plinius_fq_cancel);
+  if (priv->plinius_fq_dialog) {
+    phosh_system_modal_dialog_close (PHOSH_SYSTEM_MODAL_DIALOG (priv->plinius_fq_dialog));
+    priv->plinius_fq_dialog = NULL;
+  }
+  g_clear_pointer (&priv->plinius_fq_units, g_strfreev);
+  g_clear_pointer (&priv->plinius_fq_package, g_free);
+  g_clear_weak_pointer (&priv->plinius_fq_activity);
+}
+
+
+static void
+on_plinius_fq_confirmed (PhoshOverview *self)
+{
+  PhoshOverviewPrivate *priv = phosh_overview_get_instance_private (self);
+  g_autoptr (GError) err = NULL;
+
+  /* A tap while the dialog fades out counts for nothing */
+  if (priv->plinius_fq_dialog == NULL)
+    return;
+
+  if (priv->plinius_fq_package) {
+    g_debug ("Force quitting Android app %s", priv->plinius_fq_package);
+    if (!phosh_plinius_force_quit_android (priv->plinius_fq_package, &err))
+      g_warning ("Failed to force quit %s: %s", priv->plinius_fq_package, err->message);
+  } else {
+    phosh_plinius_force_quit_kill ((const char * const *) priv->plinius_fq_units);
+  }
+
+  plinius_fq_close (self);
+}
+
+
+static void
+on_plinius_fq_locked (PhoshOverview *self, GParamSpec *pspec, PhoshShell *shell)
+{
+  /* The question doesn't outlive the unlocked session */
+  if (phosh_shell_get_locked (shell))
+    plinius_fq_close (self);
+}
+
+
+static void
+plinius_fq_ask (PhoshOverview *self, gboolean found)
+{
+  PhoshOverviewPrivate *priv = phosh_overview_get_instance_private (self);
+  PhoshActivity *activity = priv->plinius_fq_activity;
+  PhoshToplevel *toplevel = g_object_get_data (G_OBJECT (activity), "toplevel");
+  GAppInfo *info = phosh_activity_get_app_info (activity);
+  g_autofree char *title = NULL;
+  const char *name = NULL;
+  GtkWidget *label, *button;
+
+  if (info)
+    name = g_app_info_get_display_name (info);
+  if (name == NULL && toplevel)
+    name = phosh_toplevel_get_title (toplevel);
+  if (name == NULL || *name == '\0')
+    name = phosh_activity_get_app_id (activity);
+
+  priv->plinius_fq_dialog = phosh_system_modal_dialog_new ();
+  if (found) {
+    /* Translators: the title of the question after holding an app's card while swiping it away */
+    title = g_strdup_printf (_("Force Quit %s?"), name);
+    label = gtk_label_new (_("The app ends at once. Anything not saved is lost."));
+  } else {
+    /* Translators: the title when no running process of an app to force quit was found */
+    title = g_strdup_printf (_("Cannot Force Quit %s"), name);
+    label = gtk_label_new (_("No running process of the app was found."));
+  }
+  phosh_system_modal_dialog_set_title (PHOSH_SYSTEM_MODAL_DIALOG (priv->plinius_fq_dialog), title);
+  gtk_label_set_line_wrap (GTK_LABEL (label), TRUE);
+  gtk_label_set_justify (GTK_LABEL (label), GTK_JUSTIFY_CENTER);
+  gtk_label_set_max_width_chars (GTK_LABEL (label), 30);
+  gtk_widget_set_visible (label, TRUE);
+  phosh_system_modal_dialog_set_content (PHOSH_SYSTEM_MODAL_DIALOG (priv->plinius_fq_dialog), label);
+
+  button = gtk_button_new_with_label (found ? _("Cancel") : _("Close"));
+  gtk_widget_set_visible (button, TRUE);
+  g_signal_connect_object (button, "clicked", G_CALLBACK (plinius_fq_close), self, G_CONNECT_SWAPPED);
+  phosh_system_modal_dialog_add_button (PHOSH_SYSTEM_MODAL_DIALOG (priv->plinius_fq_dialog), button, -1);
+
+  if (found) {
+    /* Translators: the button that kills an app that does not close */
+    button = gtk_button_new_with_label (_("Force Quit"));
+    gtk_style_context_add_class (gtk_widget_get_style_context (button), "destructive-action");
+    gtk_widget_set_visible (button, TRUE);
+    g_signal_connect_object (button, "clicked", G_CALLBACK (on_plinius_fq_confirmed), self,
+                             G_CONNECT_SWAPPED);
+    phosh_system_modal_dialog_add_button (PHOSH_SYSTEM_MODAL_DIALOG (priv->plinius_fq_dialog),
+                                          button, -1);
+  }
+
+  g_signal_connect_object (priv->plinius_fq_dialog, "dialog-canceled",
+                           G_CALLBACK (plinius_fq_close), self, G_CONNECT_SWAPPED);
+  gtk_widget_set_visible (priv->plinius_fq_dialog, TRUE);
+}
+
+
+static void
+on_plinius_fq_found (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_auto (GStrv) units = NULL;
+  PhoshOverview *self;
+  PhoshOverviewPrivate *priv;
+
+  units = phosh_plinius_force_quit_find_finish (res, &err);
+  /* Cancelled: the overview or the card went away, or the phone locked */
+  if (g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return;
+
+  self = PHOSH_OVERVIEW (user_data);
+  priv = phosh_overview_get_instance_private (self);
+  g_clear_object (&priv->plinius_fq_cancel);
+
+  if (err)
+    g_warning ("Failed to look for the units of the app: %s", err->message);
+
+  if (priv->plinius_fq_activity == NULL) {
+    plinius_fq_close (self);
+    return;
+  }
+
+  priv->plinius_fq_units = g_steal_pointer (&units);
+  plinius_fq_ask (self, priv->plinius_fq_units && priv->plinius_fq_units[0]);
+}
+
+
+static void
+on_plinius_force_quit (PhoshOverview *self, PhoshActivity *activity)
+{
+  PhoshOverviewPrivate *priv = phosh_overview_get_instance_private (self);
+  PhoshShell *shell = phosh_shell_get_default ();
+  GAppInfo *info = phosh_activity_get_app_info (activity);
+  const char *app_id = phosh_activity_get_app_id (activity);
+  g_autoptr (GStrvBuilder) ids = NULL;
+  g_auto (GStrv) app_ids = NULL;
+
+  /* A card of a running app, one question at a time */
+  if (g_object_get_data (G_OBJECT (activity), "toplevel") == NULL || app_id == NULL)
+    return;
+  if (priv->plinius_fq_dialog || priv->plinius_fq_cancel)
+    return;
+
+  phosh_trigger_feedback ("button-pressed", FALSE);
+  g_set_weak_pointer (&priv->plinius_fq_activity, activity);
+
+  if (priv->plinius_fq_locked_id == 0) {
+    priv->plinius_fq_locked_id = g_signal_connect_object (shell, "notify::locked",
+                                                          G_CALLBACK (on_plinius_fq_locked),
+                                                          self, G_CONNECT_SWAPPED);
+  }
+
+  /* An Android app: Waydroid stops it */
+  priv->plinius_fq_package = phosh_plinius_force_quit_android_package (app_id);
+  if (priv->plinius_fq_package) {
+    plinius_fq_ask (self, TRUE);
+    return;
+  }
+
+  ids = g_strv_builder_new ();
+  g_strv_builder_add (ids, app_id);
+  if (info && g_app_info_get_id (info)) {
+    g_autofree char *id = g_strdup (g_app_info_get_id (info));
+
+    if (g_str_has_suffix (id, ".desktop"))
+      id[strlen (id) - strlen (".desktop")] = '\0';
+    if (g_strcmp0 (id, app_id))
+      g_strv_builder_add (ids, id);
+  }
+  app_ids = g_strv_builder_end (ids);
+
+  priv->plinius_fq_cancel = g_cancellable_new ();
+  phosh_plinius_force_quit_find ((const char * const *) app_ids, priv->plinius_fq_cancel,
+                                 on_plinius_fq_found, self);
+}
+
