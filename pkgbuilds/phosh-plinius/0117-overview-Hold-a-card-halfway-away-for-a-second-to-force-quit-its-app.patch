diff --git a/src/swipe-away-bin.c b/src/swipe-away-bin.c
index 2ccf0927..a86bd2c8 100644
--- a/src/swipe-away-bin.c
+++ b/src/swipe-away-bin.c
@@ -14,6 +14,7 @@
 
 enum {
   REMOVED,
+  PLINIUS_HELD,
   N_SIGNALS
 };
 static guint signals[N_SIGNALS] = { 0 };
@@ -46,8 +47,22 @@ struct _PhoshSwipeAwayBin {
   gboolean         enabled;
   /* Plinius: a vertical swipe takes the child downwards instead of upwards */
   gboolean         downwards;
+  /* Plinius: held at least halfway away for a while: ::plinius-held instead of removing */
+  gboolean         hold_to_ask;
+  guint            hold_id;
+  double           hold_progress;
+  gboolean         held;
 };
 
+/*
+ * Plinius: how far the child has to be swiped away (of the swipe's distance) and how long it
+ * has to stay there, give or take PLINIUS_HOLD_SLACK, before ::plinius-held
+ */
+#define PLINIUS_HOLD_PROGRESS 0.5
+#define PLINIUS_HOLD_SLACK    0.08
+#define PLINIUS_HOLD_MS       1000
+
+
 static void phosh_swipe_away_bin_swipeable_init (HdySwipeableInterface *iface);
 
 G_DEFINE_TYPE_WITH_CODE (PhoshSwipeAwayBin, phosh_swipe_away_bin, GTK_TYPE_EVENT_BOX,
@@ -118,12 +133,68 @@ animate (PhoshSwipeAwayBin *self,
 }
 
 
+/* Plinius hold: held halfway away and kept there for a second, the child comes back */
+static void
+on_hold_timeout (gpointer data)
+{
+  PhoshSwipeAwayBin *self = PHOSH_SWIPE_AWAY_BIN (data);
+
+  self->hold_id = 0;
+  self->held = TRUE;
+  g_signal_emit (self, signals[PLINIUS_HELD], 0);
+}
+
+
+static void
+update_hold (PhoshSwipeAwayBin *self)
+{
+  if (!self->hold_to_ask || self->held)
+    return;
+
+  if (ABS (self->progress) < PLINIUS_HOLD_PROGRESS) {
+    g_clear_handle_id (&self->hold_id, g_source_remove);
+    return;
+  }
+
+  /* Still moving: the time starts again where the finger is now */
+  if (self->hold_id && ABS (self->progress - self->hold_progress) <= PLINIUS_HOLD_SLACK)
+    return;
+
+  g_clear_handle_id (&self->hold_id, g_source_remove);
+  self->hold_progress = self->progress;
+  self->hold_id = g_timeout_add_once (PLINIUS_HOLD_MS, on_hold_timeout, self);
+  g_source_set_name_by_id (self->hold_id, "[SwipeAwayBin] hold");
+}
+
+
+static void
+reset_hold (PhoshSwipeAwayBin *self)
+{
+  g_clear_handle_id (&self->hold_id, g_source_remove);
+  self->held = FALSE;
+}
+
+
+/* The swipe ended: whether it was held, so the child goes back instead of where it was going */
+static gboolean
+end_hold (PhoshSwipeAwayBin *self)
+{
+  gboolean held = self->held;
+
+  reset_hold (self);
+  return held;
+}
+/* Plinius hold end */
+
+
 static void
 begin_swipe_cb (PhoshSwipeAwayBin *self)
 {
   if (!self->enabled)
     return;
 
+  reset_hold (self);
+
   if (self->animation)
     phosh_animation_stop (self->animation);
 }
@@ -137,6 +208,7 @@ update_swipe_cb (PhoshSwipeAwayBin *self,
     return;
 
   set_progress (self, progress);
+  update_hold (self);
 }
 
 
@@ -148,6 +220,12 @@ end_swipe_cb (PhoshSwipeAwayBin *self,
   if (!self->enabled)
     return;
 
+  /* Plinius: held, it asks instead: the child goes back where it was */
+  if (end_hold (self)) {
+    animate (self, 300, 0, PHOSH_ANIMATION_TYPE_EASE_OUT_CUBIC);
+    return;
+  }
+
   animate (self, duration, to, PHOSH_ANIMATION_TYPE_EASE_OUT_CUBIC);
 }
 
@@ -176,6 +254,7 @@ phosh_swipe_away_bin_finalize (GObject *object)
 
   g_object_unref (self->tracker);
   g_clear_pointer (&self->animation, phosh_animation_unref);
+  g_clear_handle_id (&self->hold_id, g_source_remove);
 
   G_OBJECT_CLASS (phosh_swipe_away_bin_parent_class)->finalize (object);
 }
@@ -408,6 +487,23 @@ phosh_swipe_away_bin_class_init (PhoshSwipeAwayBinClass *klass)
                   NULL,
                   G_TYPE_NONE,
                   0);
+
+  /**
+   * PhoshSwipeAwayBin::plinius-held:
+   *
+   * Plinius: with hold-to-ask on, the child was swiped at least halfway away and held there
+   * for a second. Once released it goes back instead of being removed.
+   */
+  signals[PLINIUS_HELD] =
+    g_signal_new ("plinius-held",
+                  G_TYPE_FROM_CLASS (klass),
+                  G_SIGNAL_RUN_LAST,
+                  0,
+                  NULL,
+                  NULL,
+                  NULL,
+                  G_TYPE_NONE,
+                  0);
 }
 
 
@@ -535,6 +631,8 @@ phosh_swipe_away_bin_set_enabled (PhoshSwipeAwayBin *self,
   self->enabled = enabled;
   /* Plinius: not only ignore a swipe, a disabled bin must not be in the way of its content */
   hdy_swipe_tracker_set_enabled (self->tracker, enabled);
+  if (!enabled)
+    reset_hold (self);
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_ENABLED]);
 }
 
@@ -662,3 +760,22 @@ phosh_swipe_away_bin_set_downwards (PhoshSwipeAwayBin *self,
   self->downwards = downwards;
   update_orientation (self);
 }
+
+
+/**
+ * phosh_swipe_away_bin_set_hold_to_ask:
+ * @self: The swipe away bin
+ * @hold_to_ask: Whether holding the child halfway away asks instead of removing it
+ *
+ * Plinius: the cards of the running apps ask whether to force quit an app that is held halfway
+ * away for a second, see #PhoshSwipeAwayBin::plinius-held.
+ */
+void
+phosh_swipe_away_bin_set_hold_to_ask (PhoshSwipeAwayBin *self, gboolean hold_to_ask)
+{
+  g_return_if_fail (PHOSH_IS_SWIPE_AWAY_BIN (self));
+
+  self->hold_to_ask = !!hold_to_ask;
+  if (!self->hold_to_ask)
+    reset_hold (self);
+}
