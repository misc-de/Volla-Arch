+msgid "Do you really want to restart Phosh? Open apps keep running and the phone gets locked."
+msgstr "Phosh wirklich neu starten? Geöffnete Apps laufen weiter und das Telefon wird gesperrt."
 
 #~ msgid "In %u day"
 #~ msgid_plural "In %u days"
