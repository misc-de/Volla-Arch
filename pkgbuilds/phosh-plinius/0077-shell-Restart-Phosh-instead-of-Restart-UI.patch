 #. Plinius: restart only the shell
 #: src/ui/power-menu.ui
-msgid "Restart UI"
-msgstr "Oberfläche neu starten"
+msgid "Restart Phosh"
+msgstr "Phosh neu starten"
 
 #. Plinius: restart only the shell
 #: src/ui/top-panel.ui
