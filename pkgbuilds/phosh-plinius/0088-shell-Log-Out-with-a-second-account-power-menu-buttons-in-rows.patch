+static void
+on_logout_activated (GSimpleAction *action, GVariant *param, gpointer data)
+{
+  PhoshPowerMenuManager *self = PHOSH_POWER_MENU_MANAGER (data);
+  PhoshSessionManager *sm = phosh_shell_get_session_manager (phosh_shell_get_default ());
+
+  g_return_if_fail (PHOSH_IS_POWER_MENU_MANAGER (self));
+
+  /* Plinius: to switch accounts, plinius-greeter shows once the session ended; asks first */
+  close_menu (self);
+  phosh_session_manager_logout (sm);
+}
