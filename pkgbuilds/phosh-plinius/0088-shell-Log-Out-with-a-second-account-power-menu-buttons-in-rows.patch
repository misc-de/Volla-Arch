   show_suspend = locked && g_action_get_enabled (suspend_action);
   phosh_power_menu_set_show_suspend (self->dialog, show_suspend);
+  /* Plinius: Log Out only with another account to switch to */
+  phosh_power_menu_set_show_logout (self->dialog, phosh_util_plinius_has_other_accounts ());
 
   gtk_widget_set_visible (GTK_WIDGET (self->dialog), TRUE);
 }
@@ -191,6 +207,9 @@ on_shell_locked_changed (PhoshPowerMenuManager *self, GParamSpec *pspec, PhoshSh
   g_simple_action_set_enabled (G_SIMPLE_ACTION (action), !locked);
   action = g_action_map_lookup_action (G_ACTION_MAP (self->menu_actions), "restart-shell");
   g_simple_action_set_enabled (G_SIMPLE_ACTION (action), !locked);
+  /* Plinius: nobody logs the owner out from the lock screen */
+  action = g_action_map_lookup_action (G_ACTION_MAP (self->menu_actions), "logout");
+  g_simple_action_set_enabled (G_SIMPLE_ACTION (action), !locked);
 }
 
 
