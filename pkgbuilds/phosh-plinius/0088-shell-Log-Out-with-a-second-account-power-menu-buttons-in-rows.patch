diff --git a/src/util.c b/src/util.c
index 25386ee6..88570d0e 100644
--- a/src/util.c
+++ b/src/util.c
@@ -38,6 +38,7 @@
 #include <fcntl.h>
 
 #include <math.h>
+#include <pwd.h>
 
 static gboolean have_gnome_software = -1;
 
@@ -1512,3 +1513,61 @@ phosh_util_systemd_unit_set_active_finish (GDBusProxy *unit, GAsyncResult *res,
 
   return g_task_propagate_boolean (G_TASK (res), err);
 }
+
+
+/*
+ * Plinius: more than one account one can log in with, by the rule of plinius-greeter
+ * (plinius_greeter_accounts.py): a user ID between UID_MIN and UID_MAX of /etc/login.defs and a
+ * shell listed in /etc/shells other than nologin or false. Read anew at each call, so an account
+ * added in Settings counts at once (the system menu and the power menu ask when they open).
+ */
+/**
+ * phosh_util_plinius_has_other_accounts:
+ *
+ * Returns: %TRUE with more than one account one can log in with
+ */
+gboolean
+phosh_util_plinius_has_other_accounts (void)
+{
+  g_autofree char *defs = NULL;
+  g_autofree char *shells_text = NULL;
+  g_auto (GStrv) shells = NULL;
+  gint64 uid_min = 1000, uid_max = 60000;
+  struct passwd *pw;
+  guint n = 0;
+
+  if (g_file_get_contents ("/etc/login.defs", &defs, NULL, NULL)) {
+    g_auto (GStrv) lines = g_strsplit (defs, "\n", -1);
+
+    for (guint i = 0; lines[i]; i++) {
+      g_auto (GStrv) parts = g_strsplit_set (g_strstrip (lines[i]), " \t", 2);
+
+      if (!parts[0] || !parts[1])
+        continue;
+      if (g_str_equal (parts[0], "UID_MIN"))
+        uid_min = g_ascii_strtoll (g_strstrip (parts[1]), NULL, 10);
+      else if (g_str_equal (parts[0], "UID_MAX"))
+        uid_max = g_ascii_strtoll (g_strstrip (parts[1]), NULL, 10);
+    }
+  }
+  if (!g_file_get_contents ("/etc/shells", &shells_text, NULL, NULL))
+    return FALSE;
+  shells = g_strsplit (shells_text, "\n", -1);
+
+  setpwent ();
+  while ((pw = getpwent ()) != NULL && n < 2) {
+    if (pw->pw_uid < uid_min || pw->pw_uid > uid_max || !pw->pw_shell)
+      continue;
+    if (g_str_has_suffix (pw->pw_shell, "/nologin") || g_str_has_suffix (pw->pw_shell, "/false"))
+      continue;
+    for (guint i = 0; shells[i]; i++) {
+      if (g_str_equal (g_strstrip (shells[i]), pw->pw_shell)) {
+        n++;
+        break;
+      }
+    }
+  }
+  endpwent ();
+
+  return n > 1;
+}
