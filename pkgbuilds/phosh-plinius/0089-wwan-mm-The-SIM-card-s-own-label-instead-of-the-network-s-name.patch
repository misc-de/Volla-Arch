From 4c5b93c2cb3d5ca3d0eaf65cf9be823937865786 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Sun, 15 Nov 2026 15:45:45 +0100
Subject: [PATCH] wwan-mm: The SIM card's own label instead of the network's
 name

GNOME Settings > Mobile Network keeps a label of one's own for each SIM
card (org.plinius.sim, key labels: ICCID without the filler F -> text).
Show it as the operator in the quick settings and follow changes at
once; without a label, or without the schema, the name the network
gives stays.
---
 src/wwan/phosh-wwan-mm.c | 139 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 135 insertions(+), 4 deletions(-)

diff --git a/src/wwan/phosh-wwan-mm.c b/src/wwan/phosh-wwan-mm.c
index ef6ba80a..e0c75e68 100644
--- a/src/wwan/phosh-wwan-mm.c
+++ b/src/wwan/phosh-wwan-mm.c
@@ -20,6 +20,10 @@
 
 #define BUS_NAME "org.freedesktop.ModemManager1"
 
+/* Labels of one's own for the SIM cards, set in GNOME Settings > Mobile Network */
+#define SIM_SCHEMA "org.plinius.sim"
+#define SIM_LABELS_KEY "labels"
+
 /**
  * PhoshWWanMM:
  *
@@ -60,6 +64,10 @@ typedef struct _PhoshWWanMM {
   gboolean                        present;
   gboolean                        enabled;
   char                           *operator;
+  char                           *network_operator;
+  char                           *sim_path;
+  char                           *sim_id;
+  GSettings                      *sim_settings;
 
   GListStore                     *cbms;
 } PhoshWWanMM;
@@ -124,6 +132,63 @@ phosh_wwan_mm_update_access_tec (PhoshWWanMM *self)
 }
 
 
+/* Settings keeps the ICCID without the filler F of a 19-digit one, in upper case */
+static char *
+sim_label_key (const char *iccid)
+{
+  char *key;
+  gsize len;
+
+  if (iccid == NULL)
+    return NULL;
+
+  key = g_strstrip (g_ascii_strup (iccid, -1));
+  len = strlen (key);
+  while (len > 0 && key[len - 1] == 'F')
+    key[--len] = '\0';
+
+  if (len == 0)
+    g_clear_pointer (&key, g_free);
+
+  return key;
+}
+
+
+/* The user's label for the SIM card, if any */
+static char *
+phosh_wwan_mm_dup_sim_label (PhoshWWanMM *self)
+{
+  g_autofree char *key = sim_label_key (self->sim_id);
+  g_autoptr (GVariant) labels = NULL;
+  const char *label;
+
+  if (self->sim_settings == NULL || key == NULL)
+    return NULL;
+
+  labels = g_settings_get_value (self->sim_settings, SIM_LABELS_KEY);
+  if (!g_variant_lookup (labels, key, "&s", &label) || *label == '\0')
+    return NULL;
+
+  return g_strdup (label);
+}
+
+
+/* The label of the SIM card, else the name the network gives */
+static void
+phosh_wwan_mm_refresh_operator (PhoshWWanMM *self)
+{
+  g_autofree char *label = phosh_wwan_mm_dup_sim_label (self);
+  const char *operator = label ?: self->network_operator;
+
+  if (g_strcmp0 (operator, self->operator)) {
+    g_debug ("Showing operator as '%s'", operator);
+    g_free (self->operator);
+    self->operator = g_strdup (operator);
+    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_OPERATOR]);
+  }
+}
+
+
 static void
 phosh_wwan_mm_update_operator (PhoshWWanMM *self)
 {
@@ -133,12 +198,56 @@ phosh_wwan_mm_update_operator (PhoshWWanMM *self)
   g_return_if_fail (self->modem_3gpp);
   operator = mm_modem_3gpp_get_operator_name (self->modem_3gpp);
 
-  if (g_strcmp0 (operator, self->operator)) {
+  if (g_strcmp0 (operator, self->network_operator)) {
     g_debug("Operator is '%s'", operator);
-    g_free (self->operator);
-    self->operator = g_strdup (operator);
-    g_object_notify_by_pspec (G_OBJECT (self), props[PROP_OPERATOR]);
+    g_free (self->network_operator);
+    self->network_operator = g_strdup (operator);
   }
+  phosh_wwan_mm_refresh_operator (self);
+}
+
+
+static void
+on_sim_ready (GObject *source_object, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (MMSim) sim = NULL;
+  PhoshWWanMM *self;
+
+  sim = mm_modem_get_sim_finish (MM_MODEM (source_object), res, &err);
+  if (!sim) {
+    phosh_async_error_warn (err, "Failed to get the SIM card");
+    return;
+  }
+
+  self = PHOSH_WWAN_MM (user_data);
+  /* Meanwhile another modem or SIM card */
+  if (g_strcmp0 (mm_sim_get_path (sim), self->sim_path))
+    return;
+
+  g_free (self->sim_id);
+  self->sim_id = mm_sim_dup_identifier (sim);
+  g_debug ("SIM card at %s identified", self->sim_path);
+  phosh_wwan_mm_refresh_operator (self);
+}
+
+
+/* The SIM card's ICCID, the key of its label */
+static void
+phosh_wwan_mm_update_sim_id (PhoshWWanMM *self, const char *sim_path)
+{
+  if (!g_strcmp0 (sim_path, self->sim_path))
+    return;
+
+  g_free (self->sim_path);
+  self->sim_path = g_strdup (sim_path);
+  g_clear_pointer (&self->sim_id, g_free);
+  phosh_wwan_mm_refresh_operator (self);
+
+  if (self->sim_path == NULL)
+    return;
+
+  mm_modem_get_sim (self->modem, self->cancel, on_sim_ready, self);
 }
 
 
@@ -174,6 +283,7 @@ phosh_wwan_mm_update_sim_status (PhoshWWanMM *self)
   self->sim = !!g_strcmp0 (sim, "/");
   g_debug ("SIM is %spresent", self->sim ? "" : "not ");
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_SIM]);
+  phosh_wwan_mm_update_sim_id (self, self->sim ? sim : NULL);
 }
 
 
@@ -330,6 +440,9 @@ phosh_wwan_mm_destroy_modem (PhoshWWanMM *self)
   self->sim = FALSE;
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_SIM]);
 
+  g_clear_pointer (&self->sim_path, g_free);
+  g_clear_pointer (&self->sim_id, g_free);
+  g_clear_pointer (&self->network_operator, g_free);
   g_clear_pointer (&self->operator, g_free);
   g_object_notify_by_pspec (G_OBJECT (self), props[PROP_OPERATOR]);
 }
@@ -704,6 +817,10 @@ phosh_wwan_mm_dispose (GObject *object)
 
   g_clear_object (&self->connection);
 
+  if (self->sim_settings)
+    g_signal_handlers_disconnect_by_data (self->sim_settings, self);
+  g_clear_object (&self->sim_settings);
+
   G_OBJECT_CLASS (phosh_wwan_mm_parent_class)->dispose (object);
 }
 
@@ -868,8 +985,22 @@ on_bus_get_ready (GObject *source_object, GAsyncResult *res, gpointer user_data)
 static void
 phosh_wwan_mm_init (PhoshWWanMM *self)
 {
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = NULL;
+
   self->cancel = g_cancellable_new ();
 
+  /* The labels come with GNOME Settings, without it the network's name stays */
+  if (source)
+    schema = g_settings_schema_source_lookup (source, SIM_SCHEMA, TRUE);
+  if (schema) {
+    self->sim_settings = g_settings_new_full (schema, NULL, NULL);
+    g_signal_connect_swapped (self->sim_settings,
+                              "changed::" SIM_LABELS_KEY,
+                              G_CALLBACK (phosh_wwan_mm_refresh_operator),
+                              self);
+  }
+
   g_bus_get (G_BUS_TYPE_SYSTEM,
              self->cancel,
              on_bus_get_ready,
