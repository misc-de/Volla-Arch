From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: misc-de <misc-de@users.noreply.github.com>
Date: Fri, 30 Oct 2026 01:19:20 +0100
Subject: [PATCH] lockscreen: Unlock with a pattern

A user who has set an unlock pattern (plinius-pattern, grid size and hash
in ~/.config/plinius/unlock-pattern) gets a pattern pad of that size (3x3
to 6x6 points) on the unlock page instead of the PIN entry: either PIN or
pattern, pam_plinius_pattern refuses the PIN on the lock screen while a
pattern is set (the fingerprint still unlocks). The drawn pattern goes to
PAM as the answer to the password prompt, marked with
"\x01plinius-pattern:" so that pam_plinius_pattern checks it and pam_unix
never sees it. A pattern file that the PAM module would not accept (wrong
owner, writable by others, no hash) counts as no pattern, so the PIN entry
stays and nobody is locked out.

PhoshPatternPad picks each point once, takes the grid points a line jumps
over (as on Android), shows a wrong pattern in red for a moment and reports
while a finger is down, so the lock screen keeps its carousel from taking
the drawing as a swipe. It hands out "grid:points" (points numbered row by
row from 0). Its strings come from the plinius-control-center domain, like
the calendar week.

Without a pattern nothing changes.
---
 src/lockscreen.c  | 148 ++++++++++++++++++
 src/meson.build   |   1 +
 src/pattern-pad.c | 436 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 src/pattern-pad.h |  23 +++
 4 files changed, 608 insertions(+)

diff --git a/src/lockscreen.c b/src/lockscreen.c
index 447673e7..dbb9516a 100644
--- a/src/lockscreen.c
+++ b/src/lockscreen.c
@@ -20,6 +20,7 @@
 #include "notifications/notify-manager.h"
 #include "notifications/notification-frame.h"
 #include "osk-manager.h"
+#include "pattern-pad.h"
 #include "shell-priv.h"
 #include "util.h"
 #include "widget-box.h"
@@ -28,6 +29,9 @@
 #include "gmobile.h"
 
 #include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <glib/gstdio.h>
 #include <glib/gi18n.h>
 #include <math.h>
 
@@ -53,6 +57,19 @@
 
 #define LOCKSCREEN_SMALL_DISPLAY 700
 
+/*
+ * Unlock pattern (plinius-pattern): the pattern pad answers the password prompt with this marker
+ * and the pattern; pam_plinius_pattern in /etc/pam.d/phosh checks it. Only shown when the user
+ * has set a pattern (GNOME Settings writes grid size and hash to PATTERN_FILE in the home
+ * directory), and then instead of the PIN entry.
+ */
+#define PATTERN_PREFIX "\x01plinius-pattern:"
+#define PATTERN_FILE   ".config/plinius/unlock-pattern"
+/* "Wrong Pattern" shows this long, then the request to draw again */
+#define PATTERN_STATUS_SECONDS 2
+/* Our own strings come from GNOME Settings' Plinius domain, like the calendar week */
+#define PLINIUS_DOMAIN "plinius-control-center"
+
 /**
  * PhoshLockscreen:
  *
@@ -121,6 +138,10 @@ typedef struct {
   GtkWidget          *entry_pin;
   GtkGesture         *long_press_del_gesture;
   GtkWidget          *lbl_unlock_status;
+  /* Unlock pattern: the pad, shown instead of the PIN entry when the user has a pattern */
+  GtkWidget          *pattern_pad;
+  gboolean            pattern_mode;
+  guint               pattern_status_id;
   GtkWidget          *btn_submit;
   GtkWidget          *btn_keyboard;
   guint               idle_timer;
@@ -337,6 +358,9 @@ clear_input (PhoshLockscreen *self, gboolean clear_all)
     gtk_editable_delete_text (GTK_EDITABLE (priv->entry_pin), 0, -1);
   else
     g_signal_emit_by_name (priv->entry_pin, "backspace", NULL);
+
+  if (clear_all && priv->pattern_pad)
+    phosh_pattern_pad_clear (PHOSH_PATTERN_PAD (priv->pattern_pad));
 }
 
 
@@ -420,6 +444,19 @@ focus_pin_entry (PhoshLockscreen *self, gboolean enable_osk)
 }
 
 
+static gboolean
+restore_pattern_status (gpointer user_data)
+{
+  PhoshLockscreen *self = PHOSH_LOCKSCREEN (user_data);
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+
+  priv->pattern_status_id = 0;
+  if (priv->auth == NULL)
+    phosh_lockscreen_set_unlock_status (self, g_dgettext (PLINIUS_DOMAIN, "Draw Pattern"));
+  return G_SOURCE_REMOVE;
+}
+
+
 static void
 on_auth_authenticate_ready (GObject *source_object, GAsyncResult *result, gpointer user_data)
 {
@@ -438,6 +475,13 @@ on_auth_authenticate_ready (GObject *source_object, GAsyncResult *result, gpoint
 
   if (authenticated) {
     g_signal_emit (self, signals[LOCKSCREEN_UNLOCK], 0);
+  } else if (priv->pattern_mode) {
+    phosh_lockscreen_set_unlock_status (self, g_dgettext (PLINIUS_DOMAIN, "Wrong Pattern"));
+    phosh_pattern_pad_show_error (PHOSH_PATTERN_PAD (priv->pattern_pad));
+    g_clear_handle_id (&priv->pattern_status_id, g_source_remove);
+    priv->pattern_status_id = g_timeout_add_seconds (PATTERN_STATUS_SECONDS, restore_pattern_status, self);
+    /* For a PIN the end of the shake animation does this (finish_shake_entry) */
+    gtk_widget_set_sensitive (GTK_WIDGET (self), TRUE);
   } else {
     /* give visual feedback on error */
     phosh_lockscreen_set_unlock_status (self, _("Enter Passcode"));
@@ -1015,6 +1059,108 @@ on_biomd_proxy_ready (GObject *source_object, GAsyncResult *res, gpointer user_d
 }
 
 
+/* Keep the carousel from taking the finger's path as a swipe, and the page from timing out */
+static void
+on_pattern_drawing_changed (PhoshLockscreen *self, GParamSpec *pspec, PhoshPatternPad *pad)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+
+  priv->last_input = g_get_monotonic_time ();
+  hdy_carousel_set_interactive (HDY_CAROUSEL (priv->carousel),
+                                !phosh_pattern_pad_get_drawing (pad));
+}
+
+
+static void
+on_pattern_entered (PhoshLockscreen *self, const char *pattern, PhoshPatternPad *pad)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+  g_autofree char *answer = NULL;
+
+  priv->last_input = g_get_monotonic_time ();
+
+  /* A single point is a tap, not a pattern */
+  if (strchr (pattern, '.') == NULL || priv->auth != NULL) {
+    phosh_pattern_pad_clear (pad);
+    return;
+  }
+
+  answer = g_strconcat (PATTERN_PREFIX, pattern, NULL);
+  phosh_lockscreen_set_unlock_status (self, _("Checking…"));
+  gtk_widget_set_sensitive (GTK_WIDGET (self), FALSE);
+
+  priv->auth = PHOSH_AUTH (phosh_auth_new ());
+  phosh_auth_authenticate_async (priv->auth,
+                                 answer,
+                                 NULL,
+                                 on_auth_authenticate_ready,
+                                 g_object_ref (self));
+}
+
+
+/*
+ * The user's pattern grid size, or 0 if no pattern is set. Same checks as pam_plinius_pattern:
+ * a regular file of the user, writable by nobody else, a grid size of 3 to 6 on the first line
+ * and a hash on the second. Anything else counts as no pattern, so the PIN unlocks: a broken
+ * file must never lock the user out.
+ */
+static int
+get_pattern_grid (void)
+{
+  g_autofree char *path = g_build_filename (g_get_home_dir (), PATTERN_FILE, NULL);
+  g_autofree char *contents = NULL;
+  g_auto (GStrv) lines = NULL;
+  GStatBuf st;
+  int grid;
+
+  if (g_lstat (path, &st) != 0 || !S_ISREG (st.st_mode) || st.st_uid != getuid () ||
+      (st.st_mode & (S_IWGRP | S_IWOTH)))
+    return 0;
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return 0;
+
+  lines = g_strsplit (contents, "\n", 3);
+  if (g_strv_length (lines) < 2 || lines[1][0] == '\0')
+    return 0;
+  grid = (int) g_ascii_strtoll (lines[0], NULL, 10);
+  return grid >= 3 && grid <= 6 ? grid : 0;
+}
+
+
+/*
+ * With a pattern the unlock page shows only the pattern pad: the PIN does not unlock the screen
+ * then (pam_plinius_pattern refuses it), only the pattern or the fingerprint.
+ */
+static void
+setup_pattern (PhoshLockscreen *self)
+{
+  PhoshLockscreenPrivate *priv = phosh_lockscreen_get_instance_private (self);
+  int grid = get_pattern_grid ();
+
+  if (grid == 0)
+    return;
+
+  priv->pattern_mode = TRUE;
+  priv->pattern_pad = phosh_pattern_pad_new ();
+  phosh_pattern_pad_set_grid (PHOSH_PATTERN_PAD (priv->pattern_pad), grid);
+  gtk_widget_set_margin_top (priv->pattern_pad, 12);
+  gtk_widget_set_margin_bottom (priv->pattern_pad, 12);
+  gtk_widget_show (priv->pattern_pad);
+  gtk_box_pack_start (GTK_BOX (priv->box_unlock), priv->pattern_pad, FALSE, FALSE, 0);
+  /* Right below the status label */
+  gtk_box_reorder_child (GTK_BOX (priv->box_unlock), priv->pattern_pad, 1);
+  g_signal_connect_object (priv->pattern_pad, "entered",
+                           G_CALLBACK (on_pattern_entered), self, G_CONNECT_SWAPPED);
+  g_signal_connect_object (priv->pattern_pad, "notify::drawing",
+                           G_CALLBACK (on_pattern_drawing_changed), self, G_CONNECT_SWAPPED);
+
+  gtk_widget_hide (priv->entry_pin);
+  gtk_widget_hide (priv->keypad_revealer);
+  gtk_widget_hide (gtk_widget_get_parent (priv->btn_submit));
+  phosh_lockscreen_set_unlock_status (self, g_dgettext (PLINIUS_DOMAIN, "Draw Pattern"));
+}
+
+
 static void
 phosh_lockscreen_constructed (GObject *object)
 {
@@ -1125,6 +1271,7 @@ phosh_lockscreen_constructed (GObject *object)
   on_info_reveal_child_changed (self);
 
   phosh_lockscreen_add_background (self);
+  setup_pattern (self);
 
   priv->cancel = g_cancellable_new ();
   g_dbus_proxy_new_for_bus (G_BUS_TYPE_SYSTEM,
@@ -1168,6 +1315,7 @@ phosh_lockscreen_dispose (GObject *object)
   g_clear_object (&priv->cancel);
   g_clear_object (&priv->biomd);
   g_clear_object (&priv->notification_settings);
+  g_clear_handle_id (&priv->pattern_status_id, g_source_remove);
   g_clear_handle_id (&priv->idle_timer, g_source_remove);
   g_clear_object (&priv->calls_manager);
   g_clear_pointer (&priv->active, g_free);
