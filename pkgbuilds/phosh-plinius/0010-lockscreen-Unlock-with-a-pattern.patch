diff --git a/src/pattern-pad.c b/src/pattern-pad.c
new file mode 100644
index 00000000..f1b51f81
--- /dev/null
+++ b/src/pattern-pad.c
@@ -0,0 +1,436 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-pattern-pad"
+
+#include "phosh-config.h"
+
+#include "pattern-pad.h"
+
+#include <math.h>
+
+/**
+ * PhoshPatternPad:
+ *
+ * A grid of 3x3 to 6x6 points to unlock with a pattern
+ *
+ * The finger connects points; each point counts once and a line across unused points of the
+ * grid takes those in between, as on Android. When the finger lifts, #PhoshPatternPad::entered
+ * hands out the pattern as "grid:points", the points numbered row by row from 0 at the top left
+ * ("3:0.1.2.4.6.7.8" is a Z on a 3x3 grid, see plinius-pattern). The pattern stays on screen
+ * until it is cleared, or shown in red for a moment by phosh_pattern_pad_show_error().
+ *
+ * #PhoshPatternPad:drawing is true while a finger is down, so that the lock screen can keep its
+ * carousel from taking the drag as a swipe.
+ */
+
+#define MIN_GRID            3
+#define MAX_GRID            6
+#define MAX_POINTS          (MAX_GRID * MAX_GRID)
+/* Side length of the pad in logical pixels; larger grids get a little more room */
+#define PAD_SIZE            270
+#define PAD_SIZE_LARGE      320
+/* Radius of a point, of a picked point, and of the area that picks it, relative to a cell */
+#define DOT_RADIUS          0.07
+#define PICKED_RADIUS       0.15
+#define HIT_RADIUS          0.32
+#define LINE_WIDTH          0.045
+#define ERROR_TIMEOUT_MS    1000
+
+enum {
+  PROP_0,
+  PROP_DRAWING,
+  PROP_LAST_PROP
+};
+static GParamSpec *props[PROP_LAST_PROP];
+
+enum {
+  ENTERED,
+  N_SIGNALS
+};
+static guint signals[N_SIGNALS];
+
+struct _PhoshPatternPad {
+  GtkDrawingArea  parent;
+
+  GtkGesture     *drag;
+  double          start_x, start_y;
+  /* The finger's position while drawing, for the line from the last point to it */
+  double          finger_x, finger_y;
+  gboolean        drawing;
+
+  /* Points per side, and the points picked so far (row by row from 0), in order */
+  int             grid;
+  int             points[MAX_POINTS];
+  int             n_points;
+  gboolean        error;
+  guint           error_id;
+};
+
+G_DEFINE_TYPE (PhoshPatternPad, phosh_pattern_pad, GTK_TYPE_DRAWING_AREA)
+
+
+static void
+phosh_pattern_pad_get_property (GObject    *object,
+                                guint       property_id,
+                                GValue     *value,
+                                GParamSpec *pspec)
+{
+  PhoshPatternPad *self = PHOSH_PATTERN_PAD (object);
+
+  switch (property_id) {
+  case PROP_DRAWING:
+    g_value_set_boolean (value, self->drawing);
+    break;
+  default:
+    G_OBJECT_WARN_INVALID_PROPERTY_ID (object, property_id, pspec);
+    break;
+  }
+}
+
+/* Size of a cell and the grid's top left corner, the grid centered in the allocation */
+static double
+get_geometry (PhoshPatternPad *self, double *x0, double *y0)
+{
+  int width = gtk_widget_get_allocated_width (GTK_WIDGET (self));
+  int height = gtk_widget_get_allocated_height (GTK_WIDGET (self));
+  double cell = MIN (width, height) / (double) self->grid;
+
+  *x0 = (width - self->grid * cell) / 2;
+  *y0 = (height - self->grid * cell) / 2;
+  return cell;
+}
+
+
+static void
+get_point_center (PhoshPatternPad *self, int point, double *x, double *y)
+{
+  double x0, y0, cell = get_geometry (self, &x0, &y0);
+
+  *x = x0 + (point % self->grid + 0.5) * cell;
+  *y = y0 + (point / self->grid + 0.5) * cell;
+}
+
+
+static gboolean
+is_picked (PhoshPatternPad *self, int point)
+{
+  for (int i = 0; i < self->n_points; i++) {
+    if (self->points[i] == point)
+      return TRUE;
+  }
+  return FALSE;
+}
+
+
+static void
+pick (PhoshPatternPad *self, int point)
+{
+  if (self->n_points < MAX_POINTS && !is_picked (self, point))
+    self->points[self->n_points++] = point;
+}
+
+
+static int gcd (int a, int b);
+
+/* Pick the point under the finger, and unused points that the line jumps over */
+static void
+pick_at (PhoshPatternPad *self, double x, double y)
+{
+  double x0, y0, cell = get_geometry (self, &x0, &y0);
+
+  for (int point = 0; point < self->grid * self->grid; point++) {
+    double cx, cy;
+
+    get_point_center (self, point, &cx, &cy);
+    if (hypot (x - cx, y - cy) > HIT_RADIUS * cell || is_picked (self, point))
+      continue;
+
+    if (self->n_points > 0) {
+      int last = self->points[self->n_points - 1];
+      int dcol = point % self->grid - last % self->grid;
+      int drow = point / self->grid - last / self->grid;
+      int steps = gcd (abs (dcol), abs (drow));
+
+      /* Grid points exactly on the line from the last point, in order */
+      for (int i = 1; i < steps; i++)
+        pick (self, last + (drow / steps) * i * self->grid + (dcol / steps) * i);
+    }
+    pick (self, point);
+    return;
+  }
+}
+
+
+static int
+gcd (int a, int b)
+{
+  while (b) {
+    int t = a % b;
+
+    a = b;
+    b = t;
+  }
+  return a;
+}
+
+
+static void
+set_drawing (PhoshPatternPad *self, gboolean drawing)
+{
+  if (self->drawing == drawing)
+    return;
+
+  self->drawing = drawing;
+  g_object_notify_by_pspec (G_OBJECT (self), props[PROP_DRAWING]);
+}
+
+
+static void
+on_drag_begin (PhoshPatternPad *self, double x, double y, GtkGestureDrag *gesture)
+{
+  phosh_pattern_pad_clear (self);
+  gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+
+  self->start_x = self->finger_x = x;
+  self->start_y = self->finger_y = y;
+  set_drawing (self, TRUE);
+  pick_at (self, x, y);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static void
+on_drag_update (PhoshPatternPad *self, double offset_x, double offset_y, GtkGestureDrag *gesture)
+{
+  self->finger_x = self->start_x + offset_x;
+  self->finger_y = self->start_y + offset_y;
+  pick_at (self, self->finger_x, self->finger_y);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static void
+on_drag_end (PhoshPatternPad *self, double offset_x, double offset_y, GtkGestureDrag *gesture)
+{
+  g_autoptr (GString) pattern = g_string_new (NULL);
+
+  set_drawing (self, FALSE);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+
+  if (self->n_points == 0)
+    return;
+
+  g_string_printf (pattern, "%d:", self->grid);
+  for (int i = 0; i < self->n_points; i++)
+    g_string_append_printf (pattern, i ? ".%d" : "%d", self->points[i]);
+  g_signal_emit (self, signals[ENTERED], 0, pattern->str);
+}
+
+
+static gboolean
+phosh_pattern_pad_draw (GtkWidget *widget, cairo_t *cr)
+{
+  PhoshPatternPad *self = PHOSH_PATTERN_PAD (widget);
+  GtkStyleContext *context = gtk_widget_get_style_context (widget);
+  double x0, y0, cell = get_geometry (self, &x0, &y0);
+  GdkRGBA color;
+
+  gtk_style_context_get_color (context, gtk_style_context_get_state (context), &color);
+  if (self->error)
+    gdk_rgba_parse (&color, "#e01b24");
+
+  /* The line through the picked points, and on to the finger while drawing */
+  if (self->n_points > 0) {
+    double x, y;
+
+    cairo_set_source_rgba (cr, color.red, color.green, color.blue, color.alpha * 0.6);
+    cairo_set_line_width (cr, LINE_WIDTH * cell);
+    cairo_set_line_cap (cr, CAIRO_LINE_CAP_ROUND);
+    cairo_set_line_join (cr, CAIRO_LINE_JOIN_ROUND);
+    for (int i = 0; i < self->n_points; i++) {
+      get_point_center (self, self->points[i], &x, &y);
+      if (i == 0)
+        cairo_move_to (cr, x, y);
+      else
+        cairo_line_to (cr, x, y);
+    }
+    if (self->drawing)
+      cairo_line_to (cr, self->finger_x, self->finger_y);
+    cairo_stroke (cr);
+  }
+
+  for (int point = 0; point < self->grid * self->grid; point++) {
+    double x, y;
+
+    get_point_center (self, point, &x, &y);
+    cairo_set_source_rgba (cr, color.red, color.green, color.blue, color.alpha);
+    cairo_arc (cr, x, y, DOT_RADIUS * cell, 0, 2 * G_PI);
+    cairo_fill (cr);
+    if (is_picked (self, point)) {
+      cairo_set_line_width (cr, LINE_WIDTH * cell * 0.6);
+      cairo_arc (cr, x, y, PICKED_RADIUS * cell, 0, 2 * G_PI);
+      cairo_stroke (cr);
+    }
+  }
+
+  return GDK_EVENT_PROPAGATE;
+}
+
+
+static void
+phosh_pattern_pad_dispose (GObject *object)
+{
+  PhoshPatternPad *self = PHOSH_PATTERN_PAD (object);
+
+  g_clear_handle_id (&self->error_id, g_source_remove);
+  g_clear_object (&self->drag);
+
+  G_OBJECT_CLASS (phosh_pattern_pad_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_pattern_pad_class_init (PhoshPatternPadClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->get_property = phosh_pattern_pad_get_property;
+  object_class->dispose = phosh_pattern_pad_dispose;
+  widget_class->draw = phosh_pattern_pad_draw;
+
+  /**
+   * PhoshPatternPad:drawing:
+   *
+   * Whether a finger is drawing a pattern right now
+   */
+  props[PROP_DRAWING] =
+    g_param_spec_boolean ("drawing", "", "",
+                          FALSE,
+                          G_PARAM_READABLE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS);
+  g_object_class_install_properties (object_class, PROP_LAST_PROP, props);
+
+  /**
+   * PhoshPatternPad::entered:
+   * @self: The pattern pad
+   * @pattern: The pattern as "grid:points", e.g. "3:0.1.2.4.6.7.8"
+   *
+   * The finger lifted after picking at least one point
+   */
+  signals[ENTERED] = g_signal_new ("entered",
+                                   G_TYPE_FROM_CLASS (klass),
+                                   G_SIGNAL_RUN_LAST,
+                                   0, NULL, NULL, NULL,
+                                   G_TYPE_NONE, 1, G_TYPE_STRING);
+
+  gtk_widget_class_set_css_name (widget_class, "phosh-pattern-pad");
+}
+
+
+static void
+phosh_pattern_pad_init (PhoshPatternPad *self)
+{
+  self->grid = MIN_GRID;
+  gtk_widget_set_size_request (GTK_WIDGET (self), PAD_SIZE, PAD_SIZE);
+  gtk_widget_set_halign (GTK_WIDGET (self), GTK_ALIGN_CENTER);
+  gtk_widget_add_events (GTK_WIDGET (self),
+                         GDK_BUTTON_PRESS_MASK | GDK_BUTTON_RELEASE_MASK |
+                         GDK_BUTTON_MOTION_MASK | GDK_TOUCH_MASK);
+
+  self->drag = gtk_gesture_drag_new (GTK_WIDGET (self));
+  gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (self->drag), GTK_PHASE_BUBBLE);
+  g_signal_connect_swapped (self->drag, "drag-begin", G_CALLBACK (on_drag_begin), self);
+  g_signal_connect_swapped (self->drag, "drag-update", G_CALLBACK (on_drag_update), self);
+  g_signal_connect_swapped (self->drag, "drag-end", G_CALLBACK (on_drag_end), self);
+}
+
+
+GtkWidget *
+phosh_pattern_pad_new (void)
+{
+  return g_object_new (PHOSH_TYPE_PATTERN_PAD, NULL);
+}
+
+/**
+ * phosh_pattern_pad_set_grid:
+ * @self: The pattern pad
+ * @grid: Points per side, 3 to 6
+ *
+ * Sets the size of the grid; clears the pad
+ */
+void
+phosh_pattern_pad_set_grid (PhoshPatternPad *self, int grid)
+{
+  int size;
+
+  g_return_if_fail (PHOSH_IS_PATTERN_PAD (self));
+
+  self->grid = CLAMP (grid, MIN_GRID, MAX_GRID);
+  size = self->grid > 4 ? PAD_SIZE_LARGE : PAD_SIZE;
+  gtk_widget_set_size_request (GTK_WIDGET (self), size, size);
+  phosh_pattern_pad_clear (self);
+}
+
+/**
+ * phosh_pattern_pad_get_drawing:
+ * @self: The pattern pad
+ *
+ * Returns: Whether a finger is drawing a pattern right now
+ */
+gboolean
+phosh_pattern_pad_get_drawing (PhoshPatternPad *self)
+{
+  g_return_val_if_fail (PHOSH_IS_PATTERN_PAD (self), FALSE);
+
+  return self->drawing;
+}
+
+
+static gboolean
+on_error_timeout (gpointer user_data)
+{
+  PhoshPatternPad *self = PHOSH_PATTERN_PAD (user_data);
+
+  self->error_id = 0;
+  phosh_pattern_pad_clear (self);
+  return G_SOURCE_REMOVE;
+}
+
+/**
+ * phosh_pattern_pad_show_error:
+ * @self: The pattern pad
+ *
+ * Shows the last pattern in red for a moment, then clears it
+ */
+void
+phosh_pattern_pad_show_error (PhoshPatternPad *self)
+{
+  g_return_if_fail (PHOSH_IS_PATTERN_PAD (self));
+
+  self->error = TRUE;
+  g_clear_handle_id (&self->error_id, g_source_remove);
+  self->error_id = g_timeout_add (ERROR_TIMEOUT_MS, on_error_timeout, self);
+  g_source_set_name_by_id (self->error_id, "[PhoshPatternPad] error");
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+/**
+ * phosh_pattern_pad_clear:
+ * @self: The pattern pad
+ *
+ * Takes the pattern off the pad
+ */
+void
+phosh_pattern_pad_clear (PhoshPatternPad *self)
+{
+  g_return_if_fail (PHOSH_IS_PATTERN_PAD (self));
+
+  self->n_points = 0;
+  self->error = FALSE;
+  g_clear_handle_id (&self->error_id, g_source_remove);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
