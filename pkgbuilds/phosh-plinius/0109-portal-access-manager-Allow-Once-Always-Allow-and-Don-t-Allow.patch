+static void
+answer_with (PhoshAppAuthPrompt *self, PhoshAccessChoice choice)
+{
+  self->choice = choice;
+  self->grant_access = phosh_access_choice_to_response (choice) == 0;
+
+  g_signal_emit (self, signals[CLOSED], 0);
+  phosh_system_modal_dialog_close (PHOSH_SYSTEM_MODAL_DIALOG (self));
+}
+
+
+static void
+on_btn_once_clicked (PhoshAppAuthPrompt *self, GtkButton *btn)
+{
+  answer_with (self, PHOSH_ACCESS_CHOICE_ONCE);
+}
+
+
+static void
+on_btn_always_clicked (PhoshAppAuthPrompt *self, GtkButton *btn)
+{
+  answer_with (self, PHOSH_ACCESS_CHOICE_ALWAYS);
+}
+
+
+static void
+on_btn_never_clicked (PhoshAppAuthPrompt *self, GtkButton *btn)
+{
+  answer_with (self, PHOSH_ACCESS_CHOICE_NEVER);
+}
+
+
 static void
 on_dialog_canceled (PhoshAppAuthPrompt *self)
 {
@@ -301,7 +350,38 @@ phosh_app_auth_prompt_constructed (GObject *object)
 
   G_OBJECT_CLASS (phosh_app_auth_prompt_parent_class)->constructed (object);
 
