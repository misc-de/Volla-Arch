diff --git a/src/access-once.c b/src/access-once.c
new file mode 100644
index 00000000..ff34f2dd
--- /dev/null
+++ b/src/access-once.c
@@ -0,0 +1,341 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-access-once"
+
+#include "access-once.h"
+
+/**
+ * SECTION:access-once
+ *
+ * Plinius: the answers of the access dialog (org.freedesktop.impl.portal.Access) with the
+ * buttons "Allow Once", "Always Allow" and "Don't Allow".
+ *
+ * xdg-desktop-portal (1.22) knows only granted (response 0) and denied (1), and after its
+ * dialog it stores the answer for good in the permission store, as the app's entry of
+ * one table and id:
+ *
+ * - camera: table "devices", id "camera", "yes" or "no", written only if the app had no entry
+ * - location: table "location", id "location", the accuracy ("EXACT", "NONE") and the time of
+ *   the last use; asked only without an entry, written after every dialog
+ * - screenshot and wallpaper: tables and ids "screenshot" and "wallpaper", "yes" or "no",
+ *   written only if the app had no entry
+ * - background: asked only while the entry says "ask", nothing written after the dialog
+ *
+ * "Always Allow" answers granted and "Don't Allow" denied; xdg-desktop-portal stores them as
+ * before. "Allow Once" answers granted, and the dialog closed without a button (swiped away)
+ * denied, but for both the entry xdg-desktop-portal writes then is deleted again, so the app
+ * is asked anew next time.
+ *
+ * Which entry that is, only the permission store's Changed signal tells (emitted for every
+ * table on every change, with all apps of that id). Before answering, the app's entries of
+ * the tables above are looked up; the first Changed for one of them, within a short time after
+ * the answer, that has an entry of the app it lacked before, is that write: the app's
+ * permission there is deleted (DeletePermission). Limits: the same app getting a new entry in
+ * one of these tables by other means within that time (another portal of it asking at the same
+ * moment) loses that one instead; a write later than that time (an overloaded phone) stays.
+ * An entry the app had already is never touched, e.g. the location's time of the last use.
+ *
+ * A caller that handles "Allow Once" itself (plinius-appaccess) says so with the option
+ * "plinius-once" (b); its permission store entries are left alone. It may also name the
+ * buttons to show with "plinius-buttons" (as: "once", "always", "never"; default all three).
+ * Every answer carries the button in "plinius-choice" (s: "once", "always", "never" or
+ * "cancel").
+ */
+
+#define PERMISSION_STORE_NAME      "org.freedesktop.impl.portal.PermissionStore"
+#define PERMISSION_STORE_PATH      "/org/freedesktop/impl/portal/PermissionStore"
+#define PERMISSION_STORE_INTERFACE "org.freedesktop.impl.portal.PermissionStore"
+
+/* How long after the answer the entry xdg-desktop-portal writes is waited for */
+#ifndef ACCESS_ONCE_WINDOW_MS
+#define ACCESS_ONCE_WINDOW_MS 10000
+#endif
+#define ACCESS_ONCE_LOOKUP_MS 2000
+
+/* The entries xdg-desktop-portal 1.22 writes after its access dialog: table, id */
+static const char *const watched[][2] = {
+  { "devices", "camera" },
+  { "location", "location" },
+  { "screenshot", "screenshot" },
+  { "wallpaper", "wallpaper" },
+};
+#define N_WATCHED G_N_ELEMENTS (watched)
+
+typedef struct {
+  GDBusConnection       *bus;
+  char                  *app_id;
+  GDBusMethodInvocation *invocation;    /* until answered */
+  GVariant              *reply;
+  guint                  pending;       /* lookups not back yet */
+  gboolean               had[N_WATCHED];
+  guint                  subscription;
+  guint                  timeout_id;
+} AccessOnce;
+
+static const struct {
+  const char        *name;
+  PhoshAccessChoice  choice;
+} button_names[] = {
+  { "once", PHOSH_ACCESS_CHOICE_ONCE },
+  { "always", PHOSH_ACCESS_CHOICE_ALWAYS },
+  { "never", PHOSH_ACCESS_CHOICE_NEVER },
+};
+
+/**
+ * phosh_access_choice_buttons:
+ * @options: the a{sv} of AccessDialog
+ *
+ * Returns: the buttons to show, from "plinius-buttons"; all three without it or without a
+ * known name in it
+ */
+guint
+phosh_access_choice_buttons (GVariant *options)
+{
+  g_autofree const char **names = NULL;
+  guint buttons = 0;
+
+  if (options && g_variant_lookup (options, "plinius-buttons", "^a&s", &names)) {
+    for (const char **n = names; *n; n++) {
+      for (guint i = 0; i < G_N_ELEMENTS (button_names); i++) {
+        if (g_str_equal (*n, button_names[i].name))
+          buttons |= button_names[i].choice;
+      }
+    }
+  }
+  return buttons ? buttons : PHOSH_ACCESS_CHOICE_ALL;
+}
+
+
+const char *
+phosh_access_choice_to_string (PhoshAccessChoice choice)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (button_names); i++) {
+    if (button_names[i].choice == choice)
+      return button_names[i].name;
+  }
+  return "cancel";
+}
+
+/* The portal's response: 0 granted, 1 denied (the user cancelled) */
+guint
+phosh_access_choice_to_response (PhoshAccessChoice choice)
+{
+  return (choice == PHOSH_ACCESS_CHOICE_ONCE || choice == PHOSH_ACCESS_CHOICE_ALWAYS) ? 0 : 1;
+}
+
+
+static void
+access_once_free (AccessOnce *self)
+{
+  if (self->subscription)
+    g_dbus_connection_signal_unsubscribe (self->bus, self->subscription);
+  g_clear_handle_id (&self->timeout_id, g_source_remove);
+  g_clear_pointer (&self->reply, g_variant_unref);
+  g_clear_object (&self->bus);
+  g_free (self->app_id);
+  g_free (self);
+}
+
+
+static gboolean
+on_window_over (gpointer user_data)
+{
+  AccessOnce *self = user_data;
+
+  g_debug ("No new permission of %s to forget", self->app_id);
+  self->timeout_id = 0;
+  access_once_free (self);
+  return G_SOURCE_REMOVE;
+}
+
+
+static void
+on_deleted (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autofree char *what = user_data;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GError) err = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (reply)
+    g_debug ("Allowed once, forgot %s", what);
+  else
+    g_warning ("Could not forget %s: %s", what, err->message);
+}
+
+
+static int
+watched_index (const char *table, const char *id)
+{
+  for (guint i = 0; i < N_WATCHED; i++) {
+    if (g_str_equal (table, watched[i][0]) && g_str_equal (id, watched[i][1]))
+      return i;
+  }
+  return -1;
+}
+
+
+static gboolean
+has_app (GVariant *permissions, const char *app_id)
+{
+  g_autoptr (GVariant) perms = g_variant_lookup_value (permissions, app_id, G_VARIANT_TYPE_STRING_ARRAY);
+
+  return perms != NULL;
+}
+
+
+static void
+on_changed (GDBusConnection *bus,
+            const char      *sender,
+            const char      *path,
+            const char      *iface,
+            const char      *signal,
+            GVariant        *params,
+            gpointer         user_data)
+{
+  AccessOnce *self = user_data;
+  const char *table, *id;
+  gboolean deleted;
+  g_autoptr (GVariant) permissions = NULL;
+  int i;
+
+  if (!g_variant_is_of_type (params, G_VARIANT_TYPE ("(ssbva{sas})")))
+    return;
+  g_variant_get (params, "(&s&sbv@a{sas})", &table, &id, &deleted, NULL, &permissions);
+  i = watched_index (table, id);
+  if (i < 0 || deleted || !has_app (permissions, self->app_id))
+    return;
+
+  /* Not answered yet: not from the dialog, an entry the app had already */
+  if (self->invocation || self->had[i]) {
+    self->had[i] = TRUE;
+    return;
+  }
+
+  g_dbus_connection_call (self->bus,
+                          PERMISSION_STORE_NAME,
+                          PERMISSION_STORE_PATH,
+                          PERMISSION_STORE_INTERFACE,
+                          "DeletePermission",
+                          g_variant_new ("(sss)", table, id, self->app_id),
+                          NULL,
+                          G_DBUS_CALL_FLAGS_NONE,
+                          -1,
+                          NULL,
+                          on_deleted,
+                          g_strdup_printf ("%s/%s of %s", table, id, self->app_id));
+  access_once_free (self);
+}
+
+
+static void
+answer (AccessOnce *self)
+{
+  g_dbus_method_invocation_return_value (self->invocation, g_steal_pointer (&self->reply));
+  self->invocation = NULL;
+  self->timeout_id = g_timeout_add (ACCESS_ONCE_WINDOW_MS, on_window_over, self);
+}
+
+
+typedef struct {
+  AccessOnce *self;
+  guint       index;
+} Lookup;
+
+
+static void
+on_looked_up (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autofree Lookup *lookup = user_data;
+  AccessOnce *self = lookup->self;
+  g_autoptr (GVariant) reply = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, NULL);
+  /* No entry for the id (or no permission store): the app had none */
+  if (reply) {
+    g_autoptr (GVariant) permissions = g_variant_get_child_value (reply, 0);
+
+    if (has_app (permissions, self->app_id))
+      self->had[lookup->index] = TRUE;
+  }
+  if (--self->pending == 0)
+    answer (self);
+}
+
+
+/**
+ * phosh_access_once_complete:
+ * @invocation: the AccessDialog call to answer
+ * @app_id: the app it asks for
+ * @options: its a{sv}
+ * @choice: the button pressed
+ * @choices: the dialog's choices (a(ss))
+ *
+ * Answers the AccessDialog call. For "Allow Once" and a cancelled dialog the entry
+ * xdg-desktop-portal then writes is deleted again, unless the caller handles that itself
+ * ("plinius-once").
+ */
+void
+phosh_access_once_complete (GDBusMethodInvocation *invocation,
+                            const char            *app_id,
+                            GVariant              *options,
+                            PhoshAccessChoice      choice,
+                            GVariant              *choices)
+{
+  g_autoptr (GVariantDict) results = g_variant_dict_new (NULL);
+  gboolean caller_handles = FALSE;
+  GVariant *reply;
+  AccessOnce *self;
+
+  g_variant_dict_insert_value (results, "choices", choices);
+  g_variant_dict_insert (results, "plinius-choice", "s", phosh_access_choice_to_string (choice));
+  reply = g_variant_new ("(u@a{sv})", phosh_access_choice_to_response (choice),
+                         g_variant_dict_end (results));
+
+  if (options)
+    g_variant_lookup (options, "plinius-once", "b", &caller_handles);
+  if (caller_handles || (choice != PHOSH_ACCESS_CHOICE_ONCE && choice != PHOSH_ACCESS_CHOICE_CANCEL)) {
+    g_dbus_method_invocation_return_value (invocation, reply);
+    return;
+  }
+
+  self = g_new0 (AccessOnce, 1);
+  self->bus = g_object_ref (g_dbus_method_invocation_get_connection (invocation));
+  self->app_id = g_strdup (app_id ? app_id : "");
+  self->invocation = invocation;
+  self->reply = g_variant_ref_sink (reply);
+  /* Before the lookups: a change while they run is no write of the dialog's answer either */
+  self->subscription = g_dbus_connection_signal_subscribe (self->bus,
+                                                           PERMISSION_STORE_NAME,
+                                                           PERMISSION_STORE_INTERFACE,
+                                                           "Changed",
+                                                           PERMISSION_STORE_PATH,
+                                                           NULL,
+                                                           G_DBUS_SIGNAL_FLAGS_NONE,
+                                                           on_changed,
+                                                           self,
+                                                           NULL);
+  self->pending = N_WATCHED;
+  for (guint i = 0; i < N_WATCHED; i++) {
+    Lookup *lookup = g_new (Lookup, 1);
+
+    lookup->self = self;
+    lookup->index = i;
+    g_dbus_connection_call (self->bus,
+                            PERMISSION_STORE_NAME,
+                            PERMISSION_STORE_PATH,
+                            PERMISSION_STORE_INTERFACE,
+                            "Lookup",
+                            g_variant_new ("(ss)", watched[i][0], watched[i][1]),
+                            G_VARIANT_TYPE ("(a{sas}v)"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            ACCESS_ONCE_LOOKUP_MS,
+                            NULL,
+                            on_looked_up,
+                            lookup);
+  }
+}
