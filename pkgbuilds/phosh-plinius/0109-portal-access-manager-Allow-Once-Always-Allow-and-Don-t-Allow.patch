new file mode 100644
index 00000000..6d84b2cc
--- /dev/null
+++ b/src/access-once.h
@@ -0,0 +1,41 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include <gio/gio.h>
+
+G_BEGIN_DECLS
+
+/**
+ * PhoshAccessChoice:
+ * @PHOSH_ACCESS_CHOICE_CANCEL: the dialog was closed without a button (swiped away)
+ * @PHOSH_ACCESS_CHOICE_ONCE: "Allow Once"
+ * @PHOSH_ACCESS_CHOICE_ALWAYS: "Always Allow"
+ * @PHOSH_ACCESS_CHOICE_NEVER: "Don't Allow"
+ *
+ * The answers of an access dialog with the three buttons; as flags, the buttons it shows.
+ */
+typedef enum {
+  PHOSH_ACCESS_CHOICE_CANCEL = 0,
+  PHOSH_ACCESS_CHOICE_ONCE   = 1 << 0,
+  PHOSH_ACCESS_CHOICE_ALWAYS = 1 << 1,
+  PHOSH_ACCESS_CHOICE_NEVER  = 1 << 2,
+} PhoshAccessChoice;
+
+#define PHOSH_ACCESS_CHOICE_ALL \
+  (PHOSH_ACCESS_CHOICE_ONCE | PHOSH_ACCESS_CHOICE_ALWAYS | PHOSH_ACCESS_CHOICE_NEVER)
+
+guint       phosh_access_choice_buttons (GVariant *options);
+const char *phosh_access_choice_to_string (PhoshAccessChoice choice);
+guint       phosh_access_choice_to_response (PhoshAccessChoice choice);
+void        phosh_access_once_complete (GDBusMethodInvocation *invocation,
+                                        const char            *app_id,
+                                        GVariant              *options,
+                                        PhoshAccessChoice      choice,
+                                        GVariant              *choices);
+
+G_END_DECLS
