From: misc-de <misc-de@users.noreply.github.com>
Subject: [PATCH] layout-manager: Take the notch position from the settings

Plinius: gmobile has no panel data for the Plinius, so the top bar does not know
about the camera hole. GNOME Settings (gnome-control-center-plinius) offers
"Notch: None / Left / Center / Right" in org.plinius.display; from that the
layout manager builds a panel with a square cutout around the camera, and the
existing logic moves the clock and the icons out of the way. Without the schema
(shipped by phosh-plinius) nothing changes.

---
 src/layout-manager.c | 106 +++++++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 102 insertions(+), 4 deletions(-)

diff --git a/src/layout-manager.c b/src/layout-manager.c
index e36d970f..0d30f049 100644
--- a/src/layout-manager.c
+++ b/src/layout-manager.c
@@ -21,6 +21,16 @@
 
 #define SHELL_LAYOUT_KEY "shell-layout"
 
+/* Plinius: the notch position comes from Settings (schema shipped by phosh-plinius) */
+#define PLINIUS_DISPLAY_SCHEMA "org.plinius.display"
+#define NOTCH_KEY "notch"
+/* Camera hole of a typical punch-hole display, in mm */
+#define NOTCH_SIZE_MM 4.0
+#define NOTCH_TOP_MM 1.5
+#define NOTCH_SIDE_MM 4.0
+/* Pixel density if the panel doesn't report its size (about 400 ppi) */
+#define NOTCH_FALLBACK_PX_PER_MM 16.0
+
 enum {
   LAYOUT_CHANGED,
   N_SIGNALS
@@ -41,7 +51,9 @@ struct _PhoshLayoutManager {
   GObject                     parent;
 
   GmDisplayPanel             *panel;
+  GmDisplayPanel             *device_panel;
   GSettings                  *settings;
+  GSettings                  *plinius_settings;
 
   PhoshShellLayout            layout;
   PhoshLayoutClockPosition    clock_pos;
@@ -294,6 +306,62 @@ G_GNUC_END_IGNORE_DEPRECATIONS
 }
 
 
+/*
+ * Plinius: builds the panel from the notch setting: a square around the camera hole at
+ * the top edge (left, center or right), or no cutout at all. Rounded corners still come
+ * from the device's panel data, if gmobile knows the device.
+ */
+static void
+update_notch_panel (PhoshLayoutManager *self)
+{
+  g_autoptr (GError) err = NULL;
+  g_autofree char *notch = NULL;
+  g_autofree char *cutout = NULL;
+  g_autofree char *json = NULL;
+  PhoshMonitor *monitor = self->builtin;
+  double px_per_mm, size, top, x = -1;
+  int radius = 0;
+
+  if (self->plinius_settings == NULL || monitor == NULL)
+    return;
+
+  px_per_mm = monitor->width_mm > 0 ? (double) monitor->width / monitor->width_mm :
+    NOTCH_FALLBACK_PX_PER_MM;
+  size = NOTCH_SIZE_MM * px_per_mm;
+  top = NOTCH_TOP_MM * px_per_mm;
+
+  notch = g_settings_get_string (self->plinius_settings, NOTCH_KEY);
+  if (g_str_equal (notch, "left"))
+    x = NOTCH_SIDE_MM * px_per_mm;
+  else if (g_str_equal (notch, "center"))
+    x = (monitor->width - size) / 2;
+  else if (g_str_equal (notch, "right"))
+    x = monitor->width - NOTCH_SIDE_MM * px_per_mm - size;
+
+  if (x >= 0) {
+    cutout = g_strdup_printf ("{ \"name\": \"notch\", \"path\": \"M %d %d H %d V %d H %d Z\" }",
+                              (int) x, (int) top, (int) (x + size), (int) (top + size), (int) x);
+  }
+
+  if (self->device_panel) {
+G_GNUC_BEGIN_IGNORE_DEPRECATIONS
+    radius = gm_display_panel_get_border_radius (self->device_panel);
+G_GNUC_END_IGNORE_DEPRECATIONS
+  }
+
+  json = g_strdup_printf ("{ \"name\": \"Plinius\", \"x-res\": %d, \"y-res\": %d, "
+                          "\"border-radius\": %d, \"cutouts\": [ %s ] }",
+                          monitor->width, monitor->height, radius, cutout ?: "");
+  g_clear_object (&self->panel);
+  self->panel = gm_display_panel_new_from_data (json, &err);
+  if (self->panel == NULL) {
+    g_warning ("Failed to build panel for notch '%s': %s", notch, err ? err->message : "unknown");
+    g_set_object (&self->panel, self->device_panel);
+  }
+  g_debug ("Notch '%s': %s", notch, json);
+}
+
+
 static void
 update_layout (PhoshLayoutManager *self)
 {
@@ -332,6 +400,11 @@ on_builtin_monitor_configured (PhoshLayoutManager *self, PhoshMonitor *monitor)
   g_return_if_fail (PHOSH_IS_LAYOUT_MANAGER (self));
   g_return_if_fail (PHOSH_IS_MONITOR (monitor));
 
+  /* Plinius: the notch square depends on the panel's resolution */
+  update_notch_panel (self);
+  if (self->panel == NULL)
+    return;
+
   update_layout (self);
 }
 
@@ -345,7 +418,6 @@ on_builtin_monitor_changed (PhoshLayoutManager *self,
 
   g_return_if_fail (PHOSH_IS_LAYOUT_MANAGER (self));
   g_return_if_fail (PHOSH_IS_SHELL (shell));
-  g_return_if_fail (GM_IS_DISPLAY_PANEL (self->panel));
 
   monitor = phosh_shell_get_builtin_monitor (shell);
   if (self->builtin == monitor)
@@ -379,11 +451,21 @@ on_shell_layout_changed (PhoshLayoutManager *self)
   self->layout = layout;
   g_debug ("New layout is %d", layout);
 
-  if (self->builtin && phosh_monitor_is_configured (self->builtin))
+  if (self->builtin && phosh_monitor_is_configured (self->builtin) && self->panel)
     update_layout (self);
 }
 
 
+static void
+on_notch_changed (PhoshLayoutManager *self)
+{
+  g_return_if_fail (PHOSH_IS_LAYOUT_MANAGER (self));
+
+  if (self->builtin && phosh_monitor_is_configured (self->builtin))
+    on_builtin_monitor_configured (self, self->builtin);
+}
+
+
 static void
 phosh_layout_manager_finalize (GObject *object)
 {
@@ -391,7 +473,9 @@ phosh_layout_manager_finalize (GObject *object)
 
   self->builtin = NULL;
   g_clear_object (&self->settings);
+  g_clear_object (&self->plinius_settings);
   g_clear_object (&self->panel);
+  g_clear_object (&self->device_panel);
 
   G_OBJECT_CLASS (phosh_layout_manager_parent_class)->finalize (object);
 }
@@ -419,6 +503,8 @@ phosh_layout_manager_init (PhoshLayoutManager *self)
   g_auto (GStrv) compatibles = NULL;
   PhoshShell *shell = phosh_shell_get_default ();
   g_autoptr (GmDeviceInfo) info = NULL;
+  GSettingsSchemaSource *source = g_settings_schema_source_get_default ();
+  g_autoptr (GSettingsSchema) schema = NULL;
 
   self->network_box_shift = PHOSH_TOP_BAR_MIN_PADDING;
   self->indicators_box_shift = PHOSH_TOP_BAR_MIN_PADDING;
@@ -434,10 +520,22 @@ phosh_layout_manager_init (PhoshLayoutManager *self)
   compatibles = gm_device_tree_get_compatibles (NULL, &err);
   if (compatibles != NULL) {
     info = gm_device_info_new ((const char * const *)compatibles);
-    g_set_object (&self->panel, gm_device_info_get_display_panel (info));
+    g_set_object (&self->device_panel, gm_device_info_get_display_panel (info));
+    g_set_object (&self->panel, self->device_panel);
+  }
+
+  /* Plinius: with the notch setting the panel is built once the built-in monitor is known */
+  if (source)
+    schema = g_settings_schema_source_lookup (source, PLINIUS_DISPLAY_SCHEMA, TRUE);
+  if (schema) {
+    self->plinius_settings = g_settings_new_full (schema, NULL, NULL);
+    g_signal_connect_object (self->plinius_settings, "changed::" NOTCH_KEY,
+                             G_CALLBACK (on_notch_changed),
+                             self,
+                             G_CONNECT_SWAPPED);
   }
 
-  if (self->panel) {
+  if (self->panel || self->plinius_settings) {
     g_signal_connect_swapped (shell, "notify::builtin-monitor",
                               G_CALLBACK (on_builtin_monitor_changed),
                               self);
