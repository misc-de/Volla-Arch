+/**
+ * phosh_shell_get_active_window_monitor:
+ * @self: The shell singleton
+ *
+ * The monitor of the window that has the focus. A prompt an app asks for (a PIN, a password)
+ * goes there, so with the desktop on a second screen it shows where the action was taken.
+ * A window on two monitors counts for the primary one.
+ *
+ * Returns:(transfer none)(nullable): The monitor, %NULL without an active window
+ */
+PhoshMonitor *
+phosh_shell_get_active_window_monitor (PhoshShell *self)
+{
+  return phosh_shell_get_app_monitor (self, NULL);
+}
+
+
+/* The monitor a toplevel shows on; one on two monitors counts for the primary one */
+static PhoshMonitor *
+toplevel_monitor (PhoshShell *self, PhoshToplevel *toplevel)
+{
+  PhoshShellPrivate *priv = phosh_shell_get_instance_private (self);
+  PhoshMonitor *found = NULL;
+
+  for (guint j = 0; j < phosh_monitor_manager_get_num_monitors (priv->monitor_manager); j++) {
+    PhoshMonitor *monitor = phosh_monitor_manager_get_monitor (priv->monitor_manager, j);
+    struct wl_output *output = phosh_monitor_get_wl_output (monitor);
+
+    if (output == NULL || !phosh_toplevel_is_on_output (toplevel, output))
+      continue;
+
+    if (monitor == priv->primary_monitor)
+      return monitor;
+    if (found == NULL)
+      found = monitor;
+  }
+  return found;
+}
+
+
+static gboolean
+same_app_id (const char *a, const char *b)
+{
+  g_autofree char *a_id = NULL, *b_id = NULL;
+
+  if (a == NULL || b == NULL)
+    return FALSE;
+
+  a_id = g_str_has_suffix (a, ".desktop") ? g_strndup (a, strlen (a) - strlen (".desktop")) : g_strdup (a);
+  b_id = g_str_has_suffix (b, ".desktop") ? g_strndup (b, strlen (b) - strlen (".desktop")) : g_strdup (b);
+  return g_strcmp0 (a_id, b_id) == 0;
+}
+
+
+/**
+ * phosh_shell_get_app_monitor:
+ * @self: The shell singleton
+ * @app_id:(nullable): The app's id, %NULL for the window that has the focus
+ *
+ * The monitor of an app's window: the active one of its windows, else the first one that
+ * shows somewhere. A prompt an app asks for (a PIN, a password) goes there, so with the
+ * desktop on a second screen it shows where the action was taken.
+ *
+ * Returns:(transfer none)(nullable): The monitor, %NULL without such a window
+ */
+PhoshMonitor *
+phosh_shell_get_app_monitor (PhoshShell *self, const char *app_id)
+{
+  PhoshShellPrivate *priv;
+  PhoshToplevelManager *toplevel_manager;
+  PhoshMonitor *fallback = NULL;
+
+  g_return_val_if_fail (PHOSH_IS_SHELL (self), NULL);
+  priv = phosh_shell_get_instance_private (self);
+
+  toplevel_manager = phosh_shell_get_toplevel_manager (self);
+  if (toplevel_manager == NULL || priv->monitor_manager == NULL)
+    return NULL;
+
+  for (guint i = 0; i < phosh_toplevel_manager_get_num_toplevels (toplevel_manager); i++) {
+    PhoshToplevel *toplevel = phosh_toplevel_manager_get_toplevel (toplevel_manager, i);
+    PhoshMonitor *monitor;
+
+    if (app_id && !same_app_id (app_id, phosh_toplevel_get_app_id (toplevel)))
+      continue;
+
+    if (phosh_toplevel_is_activated (toplevel))
+      return toplevel_monitor (self, toplevel);
+
+    if (app_id && fallback == NULL && (monitor = toplevel_monitor (self, toplevel)))
+      fallback = monitor;
+  }
+
+  return fallback;
+}
+
