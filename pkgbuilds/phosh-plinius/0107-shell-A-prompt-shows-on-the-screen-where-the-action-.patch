+/* systemd's escaping in unit names: \x2d for "-" and so on */
+static char *
+unescape_unit_name (const char *escaped, gsize len)
+{
+  GString *out = g_string_sized_new (len);
+
+  for (gsize i = 0; i < len; i++) {
+    if (escaped[i] == '\\' && i + 3 < len && escaped[i + 1] == 'x' &&
+        g_ascii_isxdigit (escaped[i + 2]) && g_ascii_isxdigit (escaped[i + 3])) {
+      g_string_append_c (out, (char) (g_ascii_xdigit_value (escaped[i + 2]) * 16 +
+                                      g_ascii_xdigit_value (escaped[i + 3])));
+      i += 3;
+    } else {
+      g_string_append_c (out, escaped[i]);
+    }
+  }
+  return g_string_free (out, FALSE);
+}
+
+
+/**
+ * app_id_of_pid:
+ * @pid: A process
+ *
+ * The app a process belongs to, from the unit it runs in: an app activated through D-Bus runs
+ * in dbus-:1.2-org.gnome.Settings@1.service, an app started by GLib, Phosh or the desktop in
+ * app-gnome-org.gnome.Console-1234.scope (app-desktop-..., app-flatpak-...). A helper the app
+ * started (pkexec) runs in the same unit.
+ *
+ * Returns:(nullable): The app id
+ */
+static char *
+app_id_of_pid (pid_t pid)
+{
+  g_autofree char *path = g_strdup_printf ("/proc/%d/cgroup", (int) pid);
+  g_autofree char *contents = NULL;
+  const char *unit, *start, *end;
+  char *newline;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return NULL;
+
+  /* cgroup v2: "0::/user.slice/.../<unit>" */
+  newline = strchr (contents, '\n');
+  if (newline)
+    *newline = '\0';
+  unit = strrchr (contents, '/');
+  if (unit == NULL)
+    return NULL;
+  unit++;
+
+  if (g_str_has_prefix (unit, "dbus-")) {
+    /* Past the bus name, which has no "-" */
+    start = strchr (unit + strlen ("dbus-"), '-');
+    if (start == NULL)
+      return NULL;
+    start++;
+    end = strchr (start, '@');
+    if (end == NULL)
+      end = g_strrstr (start, ".service");
+  } else if (g_str_has_prefix (unit, "app-")) {
+    /* Past the launcher (gnome, desktop, flatpak, ...) */
+    start = strchr (unit + strlen ("app-"), '-');
+    if (start == NULL)
+      return NULL;
+    start++;
+    end = strchr (start, '@');
+    if (end == NULL && g_str_has_suffix (start, ".scope")) {
+      /* The pid at the end: app-gnome-<app id>-<pid>.scope */
+      end = strrchr (start, '-');
+    }
+  } else {
+    return NULL;
+  }
+
+  if (end == NULL || end <= start)
+    return NULL;
+
+  return unescape_unit_name (start, end - start);
+}
+
+
+/*
+ * Where the action was taken: Phosh's own (a quick setting on the phone) asks on the primary
+ * monitor, an app asks on the monitor of its window, e.g. the desktop on a second screen. The
+ * window that has the focus is the fallback: while a layer surface of Phosh (the open top
+ * panel, the lock screen) has the keyboard no window is active.
+ */
+static PhoshMonitor *
+prompt_monitor (PolkitDetails *details)
+{
+  PhoshShell *shell = phosh_shell_get_default ();
+  const char *subject_pid = details ? polkit_details_lookup (details, "polkit.subject-pid") : NULL;
+  PhoshMonitor *monitor = NULL;
+
+  if (subject_pid) {
+    pid_t pid = (pid_t) g_ascii_strtoll (subject_pid, NULL, 10);
+    g_autofree char *app_id = NULL;
+
+    if (pid == getpid ())
+      return NULL;
+
+    app_id = app_id_of_pid (pid);
+    g_debug ("Prompt for pid %d, app %s", (int) pid, app_id);
+    if (app_id)
+      monitor = phosh_shell_get_app_monitor (shell, app_id);
+  }
+
+  return monitor ?: phosh_shell_get_active_window_monitor (shell);
+}
+
