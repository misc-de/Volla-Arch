@@ -0,0 +1,43 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include <gio/gio.h>
+#include "access-once.h"
+
+G_BEGIN_DECLS
+
+/**
+ * PhoshLocationPermission:
+ * @PHOSH_LOCATION_PERMISSION_ASK: nothing remembered that answers: ask the user
+ * @PHOSH_LOCATION_PERMISSION_ALLOW: remembered as allowed at the level asked for, or a finer one
+ * @PHOSH_LOCATION_PERMISSION_DENY: remembered as denied
+ */
+typedef enum {
+  PHOSH_LOCATION_PERMISSION_ASK,
+  PHOSH_LOCATION_PERMISSION_ALLOW,
+  PHOSH_LOCATION_PERMISSION_DENY,
+} PhoshLocationPermission;
+
+guint                   phosh_location_level_from_string (const char *name);
+const char             *phosh_location_level_to_string (guint level);
+PhoshLocationPermission phosh_location_permission_decide (GVariant   *permissions,
+                                                          const char *app_id,
+                                                          guint       level);
+void                    phosh_location_permission_lookup (const char          *app_id,
+                                                          guint                level,
+                                                          GCancellable        *cancellable,
+                                                          GAsyncReadyCallback  callback,
+                                                          gpointer             user_data);
+PhoshLocationPermission phosh_location_permission_lookup_finish (GAsyncResult  *res,
+                                                                 gboolean      *can_store,
