diff --git a/src/location-permission.c b/src/location-permission.c
new file mode 100644
index 00000000..9b6e2378
--- /dev/null
+++ b/src/location-permission.c
@@ -0,0 +1,298 @@
+/*
+ * Copyright (C) 2026 misc-de
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#define G_LOG_DOMAIN "phosh-location-permission"
+
+#include "location-permission.h"
+
+/**
+ * SECTION:location-permission
+ *
+ * Plinius: the location answers of native apps (geoclue's AuthorizeApp), remembered in the
+ * permission store as xdg-desktop-portal (1.22, location.c) remembers those of Flatpak apps:
+ * table "location", id "location", the app's entry [accuracy, last use]. The accuracy is one of
+ * NONE, COUNTRY, CITY, NEIGHBORHOOD, STREET and EXACT (an unknown one counts as NONE, as there),
+ * the last use is g_get_monotonic_time() in microseconds as xdg-desktop-portal writes it. GNOME
+ * Settings lists these entries on its Location page by the desktop id (without ".desktop") and
+ * switches them between EXACT and NONE; the key of a native app is its desktop id, as geoclue
+ * names it.
+ *
+ * - entry NONE: denied without asking
+ * - entry at the level asked for or a finer one: allowed without asking
+ * - no entry, an entry of a coarser level, or one with fewer than two fields (ignored as by
+ *   xdg-desktop-portal): asked
+ *
+ * After the question "Always Allow" stores the level asked for, "Don't Allow" stores NONE;
+ * "Allow Once" and a dialog swiped away store nothing.
+ */
+
+#define PERMISSION_STORE_NAME      "org.freedesktop.impl.portal.PermissionStore"
+#define PERMISSION_STORE_PATH      "/org/freedesktop/impl/portal/PermissionStore"
+#define PERMISSION_STORE_INTERFACE "org.freedesktop.impl.portal.PermissionStore"
+#define PERMISSION_STORE_NOT_FOUND "org.freedesktop.portal.Error.NotFound"
+#define PERMISSION_TABLE           "location"
+#define PERMISSION_ID              "location"
+
+#define LOOKUP_TIMEOUT_MS 2000
+
+/* geoclue's GClueAccuracyLevel, by xdg-desktop-portal's names */
+static const struct {
+  const char *name;
+  guint       level;
+} levels[] = {
+  { "NONE", 0 },
+  { "COUNTRY", 1 },
+  { "CITY", 4 },
+  { "NEIGHBORHOOD", 5 },
+  { "STREET", 6 },
+  { "EXACT", 8 },
+};
+
+/* The lookup's result as an int of the task: the decision, and whether to store */
+#define CAN_STORE 0x10
+
+
+guint
+phosh_location_level_from_string (const char *name)
+{
+  for (guint i = 0; i < G_N_ELEMENTS (levels); i++) {
+    if (g_strcmp0 (name, levels[i].name) == 0)
+      return levels[i].level;
+  }
+  g_debug ("Unknown accuracy '%s', taken as NONE", name ? name : "");
+  return 0;
+}
+
+
+/* The name of the level, or of the next coarser one geoclue knows */
+const char *
+phosh_location_level_to_string (guint level)
+{
+  const char *name = levels[0].name;
+
+  for (guint i = 0; i < G_N_ELEMENTS (levels); i++) {
+    if (levels[i].level <= level)
+      name = levels[i].name;
+  }
+  return name;
+}
+
+
+/**
+ * phosh_location_permission_decide:
+ * @permissions: (nullable): the table's entries (a{sas})
+ * @app_id: the app's desktop id
+ * @level: the accuracy it asks for
+ *
+ * Returns: what the app's entry says
+ */
+PhoshLocationPermission
+phosh_location_permission_decide (GVariant *permissions, const char *app_id, guint level)
+{
+  g_autofree const char **perms = NULL;
+  guint stored;
+
+  if (permissions == NULL || !g_variant_lookup (permissions, app_id, "^a&s", &perms))
+    return PHOSH_LOCATION_PERMISSION_ASK;
+  if (g_strv_length ((char **) perms) < 2)
+    return PHOSH_LOCATION_PERMISSION_ASK;
+
+  stored = phosh_location_level_from_string (perms[0]);
+  if (stored == 0)
+    return PHOSH_LOCATION_PERMISSION_DENY;
+  return stored >= level ? PHOSH_LOCATION_PERMISSION_ALLOW : PHOSH_LOCATION_PERMISSION_ASK;
+}
+
+
+typedef struct {
+  char  *app_id;
+  guint  level;
+} LookupData;
+
+
+static void
+lookup_data_free (gpointer data)
+{
+  LookupData *lookup = data;
+
+  g_free (lookup->app_id);
+  g_free (lookup);
+}
+
+
+static void
+on_looked_up (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (GTask) task = user_data;
+  LookupData *lookup = g_task_get_task_data (task);
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GError) err = NULL;
+  g_autofree char *remote = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (reply) {
+    g_autoptr (GVariant) permissions = g_variant_get_child_value (reply, 0);
+
+    g_task_return_int (task, CAN_STORE | phosh_location_permission_decide (permissions,
+                                                                           lookup->app_id,
+                                                                           lookup->level));
+    return;
+  }
+  if (g_error_matches (err, G_IO_ERROR, G_IO_ERROR_CANCELLED)) {
+    g_task_return_error (task, g_steal_pointer (&err));
+    return;
+  }
+
+  remote = g_dbus_error_get_remote_error (err);
+  if (g_strcmp0 (remote, PERMISSION_STORE_NOT_FOUND) == 0) {
+    /* No app has an entry yet */
+    g_task_return_int (task, CAN_STORE | PHOSH_LOCATION_PERMISSION_ASK);
+    return;
+  }
+
+  g_debug ("No permission store, asking without remembering: %s", err->message);
+  g_task_return_int (task, PHOSH_LOCATION_PERMISSION_ASK);
+}
+
+
+/**
+ * phosh_location_permission_lookup:
+ * @app_id: the app's desktop id
+ * @level: the accuracy it asks for
+ * @cancellable: (nullable): to cancel the lookup
+ * @callback: called with the result
+ * @user_data: for @callback
+ *
+ * Looks the app's entry up in the permission store (on the session bus).
+ */
+void
+phosh_location_permission_lookup (const char          *app_id,
+                                  guint                level,
+                                  GCancellable        *cancellable,
+                                  GAsyncReadyCallback  callback,
+                                  gpointer             user_data)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GDBusConnection) bus = NULL;
+  GTask *task = g_task_new (NULL, cancellable, callback, user_data);
+  LookupData *lookup = g_new0 (LookupData, 1);
+
+  lookup->app_id = g_strdup (app_id);
+  lookup->level = level;
+  g_task_set_task_data (task, lookup, lookup_data_free);
+
+  bus = g_bus_get_sync (G_BUS_TYPE_SESSION, cancellable, &err);
+  if (bus == NULL) {
+    g_debug ("No session bus, asking without remembering: %s", err->message);
+    g_task_return_int (task, PHOSH_LOCATION_PERMISSION_ASK);
+    g_object_unref (task);
+    return;
+  }
+
+  g_dbus_connection_call (bus,
+                          PERMISSION_STORE_NAME,
+                          PERMISSION_STORE_PATH,
+                          PERMISSION_STORE_INTERFACE,
+                          "Lookup",
+                          g_variant_new ("(ss)", PERMISSION_TABLE, PERMISSION_ID),
+                          G_VARIANT_TYPE ("(a{sas}v)"),
+                          G_DBUS_CALL_FLAGS_NONE,
+                          LOOKUP_TIMEOUT_MS,
+                          cancellable,
+                          on_looked_up,
+                          task);
+}
+
+
+/**
+ * phosh_location_permission_lookup_finish:
+ * @res: the result
+ * @can_store: (out): whether the permission store answered, so an answer can be stored
+ * @error: set when cancelled
+ *
+ * Returns: what the entry says; %PHOSH_LOCATION_PERMISSION_ASK without one
+ */
+PhoshLocationPermission
+phosh_location_permission_lookup_finish (GAsyncResult *res, gboolean *can_store, GError **error)
+{
+  gssize result = g_task_propagate_int (G_TASK (res), error);
+
+  if (result < 0) {
+    *can_store = FALSE;
+    return PHOSH_LOCATION_PERMISSION_ASK;
+  }
+  *can_store = !!(result & CAN_STORE);
+  return result & ~CAN_STORE;
+}
+
+
+static void
+on_stored (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autofree char *what = user_data;
+  g_autoptr (GVariant) reply = NULL;
+  g_autoptr (GError) err = NULL;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), res, &err);
+  if (reply)
+    g_debug ("Remembered %s", what);
+  else
+    g_warning ("Could not remember %s: %s", what, err->message);
+}
+
+
+/**
+ * phosh_location_permission_store:
+ * @app_id: the app's desktop id
+ * @level: the accuracy it asked for
+ * @choice: the button pressed
+ *
+ * Remembers the answer: "Always Allow" as @level (at least COUNTRY), "Don't Allow" as NONE,
+ * with the time of now as the last use.
+ *
+ * Returns: whether an entry is written (not for "Allow Once" or a cancelled dialog)
+ */
+gboolean
+phosh_location_permission_store (const char *app_id, guint level, PhoshAccessChoice choice)
+{
+  g_autoptr (GError) err = NULL;
+  g_autoptr (GDBusConnection) bus = NULL;
+  g_autofree char *last_use = NULL;
+  const char *accuracy;
+  const char *perms[3];
+
+  if (choice == PHOSH_ACCESS_CHOICE_ALWAYS)
+    accuracy = phosh_location_level_to_string (MAX (level, levels[1].level));
+  else if (choice == PHOSH_ACCESS_CHOICE_NEVER)
+    accuracy = levels[0].name;
+  else
+    return FALSE;
+
+  bus = g_bus_get_sync (G_BUS_TYPE_SESSION, NULL, &err);
+  if (bus == NULL) {
+    g_warning ("Could not remember %s for %s: %s", accuracy, app_id, err->message);
+    return FALSE;
+  }
+
+  last_use = g_strdup_printf ("%" G_GINT64_FORMAT, g_get_monotonic_time ());
+  perms[0] = accuracy;
+  perms[1] = last_use;
+  perms[2] = NULL;
+  g_dbus_connection_call (bus,
+                          PERMISSION_STORE_NAME,
+                          PERMISSION_STORE_PATH,
+                          PERMISSION_STORE_INTERFACE,
+                          "SetPermission",
+                          g_variant_new ("(sbss^as)", PERMISSION_TABLE, TRUE, PERMISSION_ID,
+                                         app_id, perms),
+                          NULL,
+                          G_DBUS_CALL_FLAGS_NONE,
+                          -1,
+                          NULL,
+                          on_stored,
+                          g_strdup_printf ("%s for %s", accuracy, app_id));
+  return TRUE;
+}
