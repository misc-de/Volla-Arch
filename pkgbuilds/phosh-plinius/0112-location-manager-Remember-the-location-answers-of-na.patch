+static void
+show_prompt (PhoshLocationManager *self, AuthorizeRequest *request, gboolean can_store)
+{
+  PhoshDBusGeoClue2Agent *object = PHOSH_DBUS_GEO_CLUE2_AGENT (self);
+  GAppInfo *app_info = G_APP_INFO (request->app_info);
+  g_autofree char *body = NULL;
+  g_autofree char *subtitle = NULL;
+
+  /* Cancel any ongoing prompt */
