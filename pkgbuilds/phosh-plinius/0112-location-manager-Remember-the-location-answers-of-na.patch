+
+  if (self->invocation) {
+    phosh_dbus_geo_clue2_agent_complete_authorize_app (
+      object,
+      self->invocation,
+      FALSE,
+      request->level);
+  }
+
+  self->req_level = request->level;
+  self->invocation = request->invocation;
+  g_free (self->desktop_id);
+  self->desktop_id = g_strdup (request->desktop_id);
+  self->can_store = can_store;
+  subtitle = g_strdup_printf (_("Allow '%s' to access your location information?"),
+                              g_app_info_get_display_name (app_info));
+
+  body = g_desktop_app_info_get_string (request->app_info, "X-Geoclue-Reason");
+  /* Plinius: Allow Once, Always Allow and Don't Allow instead of Yes and No */
+  self->prompt = phosh_app_auth_prompt_new_with_buttons (g_app_info_get_icon (app_info),
+                                                         _("Geolocation"),
+                                                         subtitle, body,
+                                                         PHOSH_ACCESS_CHOICE_ALL, NULL);
+  g_signal_connect_object (self->prompt,
+                           "closed",
+                           G_CALLBACK (on_app_auth_prompt_closed),
+                           self,
+                           G_CONNECT_SWAPPED);
+
+  /* Show widget when not locked and keep that in sync */
+  g_object_bind_property (phosh_shell_get_default (), "locked",
+                          self->prompt, "visible",
+                          G_BINDING_SYNC_CREATE | G_BINDING_INVERT_BOOLEAN);
+}
+
+
+static void
+on_permission_looked_up (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+  g_autoptr (AuthorizeRequest) request = user_data;
+  g_autoptr (GError) err = NULL;
+  PhoshLocationPermission permission;
+  gboolean can_store;
+
+  permission = phosh_location_permission_lookup_finish (res, &can_store, &err);
+  if (err) {
+    /* Cancelled: the manager is going away, self is not to be touched */
+    g_dbus_method_invocation_return_value (request->invocation,
+                                           g_variant_new ("(bu)", FALSE, request->level));
+    return;
+  }
+
+  if (permission != PHOSH_LOCATION_PERMISSION_ASK) {
+    gboolean allowed = permission == PHOSH_LOCATION_PERMISSION_ALLOW;
+
+    g_debug ("Remembered for %s: %s", request->desktop_id, allowed ? "allowed" : "denied");
+    phosh_dbus_geo_clue2_agent_complete_authorize_app (PHOSH_DBUS_GEO_CLUE2_AGENT (request->self),
+                                                       request->invocation,
+                                                       allowed,
+                                                       request->level);
+    return;
+  }
+
+  show_prompt (request->self, request, can_store);
+}
