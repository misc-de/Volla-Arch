build() {
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o plinius-usb plinius-usb.c \
		$(pkg-config --cflags --libs gio-unix-2.0 gudev-1.0) $LDFLAGS
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o plinius-usb-prompt plinius-usb-prompt.c \
		$(pkg-config --cflags --libs gio-unix-2.0) $LDFLAGS
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter \
		-o plinius-usb-webcam plinius-usb-webcam.c \
		$(pkg-config --cflags --libs gio-unix-2.0 gstreamer-1.0) $LDFLAGS
	for l in "${_langs[@]}"; do
		msgfmt --check -o "$l.mo" "$l.po"
	done
}

check() {
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -o test-pogo-port test-pogo-port.c $LDFLAGS
	./test-pogo-port
}

package() {
	install -Dm755 plinius-usb plinius-usb-prompt plinius-usb-webcam -t "$pkgdir/usr/bin"
	install -Dm644 plinius-usb.service -t "$pkgdir/usr/lib/systemd/system"
	# Enabled by the package: it is the SSH access over USB too
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../plinius-usb.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
	# The question about the port, in the session of whoever is signed in
	install -Dm644 plinius-usb-prompt.service -t "$pkgdir/usr/lib/systemd/user"
	install -d "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
	ln -s ../plinius-usb-prompt.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
	# The webcam's stream, in the session too: the cameras are in the user's PipeWire
	install -Dm644 plinius-usb-webcam.service -t "$pkgdir/usr/lib/systemd/user"
	ln -s ../plinius-usb-webcam.service "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/"
	install -Dm644 org.plinius.Usb.conf -t "$pkgdir/usr/share/dbus-1/system.d"
	install -Dm644 40-plinius-usb.network -t "$pkgdir/usr/lib/systemd/network"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	for l in "${_langs[@]}"; do
		install -Dm644 "$l.mo" "$pkgdir/usr/share/locale/$l/LC_MESSAGES/plinius-usb.mo"
	done
}
