# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-usb
pkgver=0.4
pkgrel=8
pkgdesc="USB functions of the Volla Phone Plinius for a computer: file sharing, network, internet and webcam, chosen in the quick settings; whether the phone charges or powers the connected device; which port is active when a pogo accessory is attached"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
license=(MIT)
# dnsmasq: DNS for the computer while it gets internet; iptables-legacy: its NAT (the GKI
# kernel has no nf_tables). systemd-networkd: address and DHCP of usb0.
depends=(glib2 libgudev systemd dnsmasq iptables)
makedepends=(gettext gstreamer)
# Webcam: uvcsink and intervideo* (bad), jpegenc/videoflip/capssetter (good), videoconvert and
# videoscale (base), pipewiresrc; the cameras come from camera-hal-bridge
optdepends=('umtp-responder: File Sharing (MTP)'
	'gst-plugins-bad-libs: Webcam'
	'gst-plugins-good: Webcam'
	'gst-plugins-base: Webcam'
	'gst-plugin-pipewire: Webcam'
	'camera-hal-bridge: Webcam')
# The NCM gadget and usb0's network file were part of the device package up to 0.5-38
conflicts=('device-volla-ansuz<0.5-39')
_langs=(de es fr it nl pl pt ru)
source=(plinius-usb.c
	plinius-usb-prompt.c
	plinius-usb-webcam.c
	pogo-port.h
	test-pogo-port.c
	plinius-usb.service
	plinius-usb-prompt.service
	plinius-usb-webcam.service
	org.plinius.Usb.conf
	40-plinius-usb.network
	"${_langs[@]/%/.po}"
	LICENSE)
sha256sums=('e8764c6db138e2e4f25f527bdb44e4e191c29f6ce7b57c1c4536eae206f5d4ba'
