[Unit]
Description=USB functions for a computer (file sharing, network, internet, webcam) and the power direction
After=sys-kernel-config.mount
# Took over from the device package's NCM-only gadget
Conflicts=plinius-usb-gadget.service

[Service]
Type=dbus
BusName=org.plinius.Usb
ExecStart=/usr/bin/plinius-usb
Restart=on-failure
RestartSec=3
# Preset from the USB quick setting
StateDirectory=plinius-usb

# Sandbox (docs/DIENSTE-HAERTEN.md). Capabilities: mounting FunctionFS (SYS_ADMIN), the NAT
# rules (NET_ADMIN, NET_RAW), dnsmasq on port 53 and its switch to nobody, umtprd serving the
# user's home with the user's IDs. The home stays writable for umtprd, and the default umask
# keeps the files a computer copies over readable as before. FunctionFS is mounted inside the
# service's own mount namespace, umtprd as its child sees it there.
# CAP_SYS_PTRACE with CAP_KILL: finding and ending the processes that still hold the webcam node
# before the gadget goes, which waits for it otherwise (webcam_release); without it the user's
# processes are invisible here (ProtectProc=invisible) and their fds unreadable. CAP_SYS_ADMIN
# is already more than that.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_FSETID CAP_KILL CAP_SYS_PTRACE
RuntimeDirectory=plinius-usb
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
PrivateTmp=yes
PrivateIPC=yes
DevicePolicy=closed
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0022
ProtectKernelTunables=yes
ReadWritePaths=/sys/kernel/config /sys/usb/pogo_state /proc/sys/net/ipv4/ip_forward /run/systemd/network
# The power role of USB-C (powering the device): the port's real path, optional (KVM preview)
ReadWritePaths=-/sys/devices/platform/rt-pd-manager/typec/port0/power_role
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallFilter=@mount

[Install]
WantedBy=multi-user.target
