pkgname=plinius-progress
pkgver=0.1
pkgrel=17
pkgdesc="Full-screen progress and message view for the initramfs, in the look of unl0kr"
arch=(aarch64 x86_64)
url="https://gitlab.postmarketos.org/postmarketOS/buffybox"
# Own files MIT; the binary contains BuffyBox (GPL-3.0-or-later), LVGL (MIT) and Adwaita Sans
# (OFL-1.1)
license=(GPL-3.0-or-later MIT OFL-1.1)
# Uses the configuration of unl0kr (/etc/unl0kr.conf.d) for backend, theme, background and quirks
depends=(glibc libinih libinput systemd-libs libxkbcommon libdrm libevdev "buffybox>=3.6.0-9")
makedepends=(git meson)
# Built inside the BuffyBox source tree for its shared display/input/theme code;
# tag, lvgl commit and patches as in pkgbuilds/buffybox (the 00*.patch files are copies; those only
# unl0kr needs, as 0009-0012, are left out)
_bbx_tag=3.6.0
# Commit of that tag: a tag can be moved later, a commit hash cannot
_bbx_commit=d0f52495f7f3afa8839eef4b19f43f4ca1243107
_lvgl_commit=85aa60d18b3d5e5588d7b247abf90198f07c8a63
source=(
	"git+$url.git#commit=$_bbx_commit"
	"git+https://github.com/lvgl/lvgl.git#commit=$_lvgl_commit"
	plinius-progress.c
	meson.build
	0001-themes-make-the-text-cursor-of-the-Breezy-themes-2-d.patch
	0002-unl0kr-add-placeholder-for-the-text-of-the-empty-pas.patch
	0003-fonts-add-Cyrillic-U-0400-U-04FF-to-the-built-in-fon.patch
	0004-unl0kr-add-a-Russian-keyboard-layout.patch
