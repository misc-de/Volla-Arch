prepare() {
	cd buffybox
	git submodule init
	git config submodule.lvgl.url "$srcdir/lvgl"
	git -c protocol.file.allow=always submodule update
	# The patches of pkgbuilds/buffybox, so both build the same tree (theme, font, layouts)
	local p
	for p in "$srcdir"/00*.patch; do
		git apply "$p"
	done

	mkdir -p plinius-progress
	cp "$srcdir/plinius-progress.c" "$srcdir/meson.build" unl0kr/sq2lv_layouts.[ch] plinius-progress/
	# unl0kr's LVGL configuration plus the bar widget
	sed 's/^#define LV_USE_BAR        0$/#define LV_USE_BAR        1/' unl0kr/lv_conf.h \
		> plinius-progress/lv_conf.h
	grep -q '^#define LV_USE_BAR        1$' plinius-progress/lv_conf.h
	echo "subdir('plinius-progress')" >> meson.build
}

build() {
	arch-meson buffybox build \
		-Dlvgl_backends=framebuffer,drm \
		-Dman=false \
		-Dsystemd=false
	meson compile -C build plinius-progress
}

package() {
	install -Dm644 LICENSE buffybox/shared/fonts/AdwaitaSans-LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	# --no-rebuild: build() made the one target; without it install builds the whole BuffyBox tree
	meson install -C build --destdir "$pkgdir" --tags plinius-progress --no-rebuild
}
