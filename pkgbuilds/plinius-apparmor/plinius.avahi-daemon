# SPDX-License-Identifier: MIT
# AppArmor profile of the phone (plinius-apparmor), entered through AppArmorProfile= in the
# service's systemd drop-in. Starting profile in complain mode: it logs what the service does
# beyond these rules; the rules are completed from those messages (tools/aa-denials.sh) before
# the profile goes to enforce. attach_disconnected: the services run in mount namespaces of
# their own (ProtectSystem=, PrivateTmp=); without it AppArmor refuses their paths outside it,
# even in complain mode ("Failed name lookup - disconnected path": no D-Bus, no journal).
abi <abi/4.0>,
include <tunables/global>

# avahi-daemon: mDNS on Wi-Fi and USB. Enforced since 0.1-3: the rules below hold everything it
# did in complain mode over three boots (11.–12.11.2026, 1119 messages: netlink, sd_notify).
profile plinius.avahi-daemon flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/dbus-strict>
  capability chown, capability setuid, capability setgid, capability sys_chroot,
  capability dac_override,
  network inet dgram, network inet6 dgram, network netlink raw,
  # Address and link changes (rtnetlink as a datagram socket)
  network netlink dgram,
  # sd_notify: READY=1 and its status line (Type=dbus with NotifyAccess)
  /run/systemd/notify w,
  /usr/bin/avahi-daemon mr,
  /etc/avahi/{,**} r,
  /run/avahi-daemon/{,**} rwk,
}
