# Maintainer: misc-de <misc-de@users.noreply.github.com>
# Based on: Arch's PKGBUILD (phosh-tour 0.59.0-1); ALARM builds it unchanged.

pkgname=phosh-tour-plinius
pkgver=0.59.0
pkgrel=2
pkgdesc="Phosh Tour with pages for what phosh-plinius adds: long presses on tiles, pattern, fingerprint and face, the emergency button, force quit, the app order, the notch search, the volume per sound, the camera light and the always-on display"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
url="https://gitlab.gnome.org/World/Phosh/phosh-tour"
license=(GPL-3.0-or-later)
# Why a custom build: the tour starts on the first login and explains Phosh's gestures, but
# none of the ones phosh-plinius adds, so they stay unknown. Nine pages in the tour's own look
# (240x400 pictures of a phone, the finger as a blue dot) explain them next to the page about
# the same part of Phosh, and the power menu page shows our list with Restart and Restart Phosh.
# Must follow the phosh-tour version in ALARM.
# Dependencies as in ALARM; gettext (msgcat) comes with base-devel.
depends=(dconf glib2 glibc gtk4 hicolor-icon-theme libadwaita libgcc libgmobile)
makedepends=(git glib2-devel meson)
provides=("phosh-tour=$pkgver")
conflicts=(phosh-tour)
# Phones with phosh-tour from ALARM take this one with their next update
replaces=(phosh-tour)
# Commit of tag v$pkgver: a tag can be moved later, a commit hash cannot
_commit=f89dd54f58432f5696ea3955e93a8f1ff823f666
_pages=(
	always-on.svg arrange-apps.svg camera-light.svg emergency-button.svg force-quit.svg
	long-press-tile.svg notch-search.svg power-menu.svg unlock-ways.svg volume-roles.svg
)
_langs=(de es fr it nl pl pt pt_BR ru)
source=(
	"git+$url.git#commit=$_commit"
	0001-window-Pages-for-what-Phosh-on-the-Plinius-adds.patch
	"${_pages[@]}"
	"${_langs[@]/%/.po}"
)
