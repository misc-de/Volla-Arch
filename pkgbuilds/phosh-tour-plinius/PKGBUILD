prepare() {
	cd phosh-tour
	# The pages for what phosh-plinius adds, each after the page about the same part of Phosh,
	# and the power menu page with a picture and words for the list it is now
	patch -Np1 -i "$srcdir/0001-window-Pages-for-what-Phosh-on-the-Plinius-adds.patch"
	# Their pictures, at the resource path pages/plinius/ that the patch names
	install -Dm644 -t data/pages/plinius "${_pages[@]/#/$srcdir/}"
	# Their translations join phosh-tour's own: msgcat keeps phosh-tour's header and entries
	# and adds ours (also for the few strings phosh-tour left untranslated, such as the arrows'
	# tooltips). phosh-tour has no Spanish: our es.po translates the whole tour and becomes a
	# language of its own.
	local lang
	for lang in "${_langs[@]}"; do
		if [[ -e po/$lang.po ]]; then
			msgcat --use-first -o "po/$lang.po" "po/$lang.po" "$srcdir/$lang.po"
		else
			cp "$srcdir/$lang.po" "po/$lang.po"
			echo "$lang" >> po/LINGUAS
		fi
	done
}

build() {
	arch-meson phosh-tour build
	meson compile -C build
}

check() {
	meson test -C build --print-errorlogs
}

package() {
	meson install -C build --no-rebuild --destdir "$pkgdir"
}
