# Based on Arch's waydroid 1.6.3-1 (George Hu)

pkgname=waydroid-plinius
_pkgname=waydroid
pkgver=1.6.3
pkgrel=12
pkgdesc="A container-based approach to boot a full Android system on a regular Linux system (Plinius: the phone's devices and NFC stay as they are, Android gets the phone's hardware through the HAL bridges)"
arch=('any')
url="https://waydro.id/"
license=('GPL-3.0-or-later' 'MIT')
depends=(
	'lxc'
	'python'
	'python-gbinder>=1.3.0'
	'python-gobject'
	'nftables'
	'dnsmasq'
	'gtk3'
	'python-dbus'
	'pulse-native-provider'
	# The battery and NFC for Android: only of use with Waydroid
	'health-hal-bridge'
	'nfc-hal-bridge'
)
optdepends=('python-pyclip: clipboard manager support')
provides=("waydroid=$pkgver")
conflicts=(waydroid)
install=waydroid-plinius.install
# Commit of tag 1.6.3: a tag can be moved later, a commit hash cannot
_commit=5b7e2e71be3f6bfaaaab3b461251dacaf1ce4991
