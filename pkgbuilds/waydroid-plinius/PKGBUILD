prepare() {
	# On Halium the vendor's device permissions stay (no 777 on media, graphics and DMA heap nodes)
	patch -d "$_pkgname" -Np1 -i "$srcdir/0001-container-On-Halium-keep-the-vendor-s-device-permiss.patch"
	# On Halium the phone's own nfcd keeps running
	patch -d "$_pkgname" -Np1 -i "$srcdir/0002-container-On-Halium-never-stop-the-host-s-nfcd.patch"
	# bind_host_egl = False keeps the image's EGL libraries (software rendering without the
	# vendor's graphics HALs)
	patch -d "$_pkgname" -Np1 -i "$srcdir/0003-images-Option-to-keep-the-image-s-EGL-libraries.patch"
	# The host's binder as host_binder: the vendor's AIDL graphics allocator and camera provider
	# reach Android through it
	patch -d "$_pkgname" -Np1 -i "$srcdir/0004-lxc-On-Halium-pass-the-host-s-binder-as-host_binder.patch"
}

package() {
	DESTDIR="$pkgdir" USE_NFTABLES=1 make -C "$_pkgname" install

	# Byte-compile Python files during the packaging process instead of at runtime
	python -m compileall -o 0 -o 1 -p / -s "$pkgdir" "$pkgdir/usr/lib/waydroid/tools/"

	install -Dm755 waydroid-plinius-setup waydroid-plinius-screen waydroid-plinius-stop-app \
		-t "$pkgdir/usr/lib/waydroid-plinius"
	# GNOME Usage quits an Android app through it (pkexec, no PIN for the active session)
	install -Dm644 org.plinius.waydroid.policy -t "$pkgdir/usr/share/polkit-1/actions"
	install -Dm644 waydroid-plinius-screen.service -t "$pkgdir/usr/lib/systemd/system"
	install -Dm644 50-plinius.conf -t "$pkgdir/usr/lib/systemd/system/waydroid-container.service.d"
	install -Dm644 display_settings.xml -t "$pkgdir/usr/share/waydroid-plinius"
	install -Dm644 plinius-sensors.xml plinius-gnss.xml plinius-vibrator.xml plinius-health.xml \
		plinius-nfc.xml \
		-t "$pkgdir/usr/share/waydroid-plinius/vintf"
}
