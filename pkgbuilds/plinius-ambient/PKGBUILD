# Maintainer: misc-de <misc-de@users.noreply.github.com>

pkgname=plinius-ambient
pkgver=0.5
pkgrel=8
pkgdesc="Animated effects over the Phosh background: snow, dust in the light, fireflies, rain, balls rolling with the tilt, water running with the tilt, a 360° photo turning with the phone or a looping video or GIF as the background under them"
arch=(aarch64 x86_64)  # x86_64 only for the KVM preview
license=(MIT)
# libglvnd: EGL/GLES 2 (on the phone through libhybris). gdk-pixbuf2: the 360° photo and animated GIFs (through glycin).
# phoc-plinius draws the effect with Phosh's background (without it, the surface would lie hidden under the app grid's
# background). The video: gstreamer and gst-plugins-base-libs (libgstapp, libgstvideo; uridecodebin, typefind,
# videoconvert, appsink), gst-plugins-good (qtdemux for MP4/MOV, matroskademux for MKV/WebM, vp9dec in software).
depends=(glib2 gdk-pixbuf2 wayland libglvnd 'phoc-plinius>=0.57.0-14' gstreamer gst-plugins-base-libs gst-plugins-good)
makedepends=(wayland-protocols wlr-protocols)
optdepends=('sensor-proxy-bridge>=0.9: balls and water follow the tilt, water also the movement, the 360° photo the orientation (with 0.8 through the magnetometer, lagging)'
	'muga: setting a 360° photo as the background'
	'gnome-control-center-plinius: choosing the effect, the 360° photo and the video'
	'plinius-vdec: videos in H.264, H.265 and VP9 decoded in hardware'
	'gst-plugins-bad-libs: h264parse, h265parse and vp9parse, which hand the videos to plinius-vdec (without them H.264 and H.265 do not play at all on the phone)'
	'gst-libav: software decoding of further video formats')
source=(plinius-ambient.c
	effects.c
	effects.h
	render.c
	render.h
	panorama.c
	panorama.h
	layered.c
	layered.h
	video.c
	video.h
	plinius-ambient.desktop
	org.plinius.ambient.gschema.xml
	LICENSE)
sha256sums=('23276e5a17451542aad2d4c65f9f40c5c8b102836c29c534015973f15da763a2'
            '9646dce5030033246f96862146cfb4a4854c279b0a8ec7811420f33226e82575'
