build() {
	local wlr=/usr/share/wlr-protocols/unstable wp=/usr/share/wayland-protocols/stable
	local xml
	for xml in "$wlr/wlr-layer-shell-unstable-v1.xml" \
		"$wp/viewporter/viewporter.xml" \
		"$wp/xdg-shell/xdg-shell.xml"; do  # layer-shell refers to xdg_popup
		wayland-scanner client-header "$xml" "$(basename "$xml" .xml)-client-protocol.h"
		wayland-scanner private-code "$xml" "$(basename "$xml" .xml)-protocol.c"
	done
	# shellcheck disable=SC2046
	${CC:-cc} $CFLAGS $CPPFLAGS -std=gnu11 -Wall -Wextra -Wno-unused-parameter -I. \
		-o plinius-ambient plinius-ambient.c effects.c render.c panorama.c layered.c video.c ./*-protocol.c \
		$(pkg-config --cflags --libs gio-unix-2.0 gdk-pixbuf-2.0 gstreamer-1.0 gstreamer-app-1.0 gstreamer-video-1.0 \
			wayland-client wayland-egl egl glesv2) -lm $LDFLAGS
}

package() {
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
	install -Dm755 plinius-ambient -t "$pkgdir/usr/bin"
	# Runs in the session, next to Phosh
	install -Dm644 plinius-ambient.desktop -t "$pkgdir/etc/xdg/autostart"
	install -Dm644 org.plinius.ambient.gschema.xml -t "$pkgdir/usr/share/glib-2.0/schemas"
}
