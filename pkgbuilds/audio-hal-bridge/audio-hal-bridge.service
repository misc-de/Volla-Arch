[Unit]
Description=Vendor audio HAL as PipeWire speaker, earpiece and microphone
# The device package adds the libhybris environment for the vendor's HAL via drop-in
After=pipewire.service
BindsTo=pipewire.service

[Service]
ExecStart=/usr/bin/audio-hal-bridge
Restart=on-failure
RestartSec=3

[Install]
WantedBy=pipewire.service
