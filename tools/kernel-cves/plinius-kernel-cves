#!/usr/bin/python3
"""Lists the published vulnerabilities of the Linux kernel CNA that affect a phone's kernel.

Runs on the project server four times a day (plinius-kernel-cves.timer). The data is the CNA's own
repository (https://git.kernel.org/pub/scm/linux/security/vulns.git), one record per CVE:
  CVE-*.dyad  pairs "vulnerable version:git id:fixed version:git id" per stable branch
              (0 for "since the start" or "not fixed"),
  CVE-*.cvss  the CNA's CVSS vector, for part of the records,
  CVE-*.json  the CVE record, with the files the fix touches ("programFiles").

For every kernel there is a manifest MANIFESTS/<release>.files (tools/kernel-files.py: the
source files its configuration builds, uploaded by tools/publish-kernel-cves.sh). A CVE is
listed for that kernel when its version is in an affected range and at least one of the
named files is built (a record without files counts as built).

A kernel built from a git history can also have MANIFESTS/<release>.commits: the commit ids in
it and the upstream ids its backports name ("commit X upstream", "cherry picked from commit X").
Kernels like the Android Common Kernel carry fixes ahead of their version number; a CVE with
any of its fix commits in that list is not listed but counted as fixed in the tree.
MANIFESTS/<release>.missing names the opposite: commits that are ancestors of the kernel (merged
from a stable branch) whose changes it did not take, e.g. to keep the module interface. A CVE
fixed by one of them is listed although the version says fixed ("fixed": "<version> (not taken)").

The result is OUT/<release>.json, which the phones fetch (plinius-cve-update) over HTTPS:

  {"version": 1, "generated": UNIX_TIME, "source": URL, "commit": GIT_ID,
   "release": "6.1.145-g...", "kernel": "6.1.145",
   "counts": {"affected": N, "built": N, "fixed_in_tree": N}, "fixed_in_tree": [CVE, ...],
   "issues": [{"cve", "title", "fixed", "branch_fixed", "cvss", "score"}, ...]}

"affected" counts every CVE of the version, "built" those in built code (the listed ones);
both leave out the ones fixed in the tree, which "fixed_in_tree" names (only with a commit list).
"fixed" is the first version with the fix; "branch_fixed" is false when the fix exists only in
newer branches and this branch has none. The list only adds issues on the phone; whether one
is fixed or harmless there is said by the signed assessments, never by this list.

Usage: plinius-kernel-cves [--fetch] VULNS_REPO MANIFESTS OUT
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
import tempfile
import time

VULNS_URL = "https://git.kernel.org/pub/scm/linux/security/vulns.git"


# ----- versions -----

def parse_version(text):
    """(major, minor, sublevel or None) of "6.1.145", "6.2" or "6.2-rc3"; None for "0"."""
    m = re.match(r"^(\d+)\.(\d+)(?:\.(\d+))?", text or "")
    if not m or text == "0":
        return None
    return int(m.group(1)), int(m.group(2)), (int(m.group(3)) if m.group(3) else None)


def affected(pairs, kernel):
    """For kernel (major, minor, sublevel): None if not affected, else (first fixed version
    or None, True if that fix is in the kernel's own branch)."""
    branch = kernel[:2]

    def starts_before(v):
        # v: None (since the start), a mainline release, or a stable release
        if v is None:
            return True
        if v[2] is None:
            return v[:2] <= branch
        return v[:2] == branch and v[2] <= kernel[2]

    in_branch = []
    others = []
    for v_text, f_text in pairs:
        v, f = parse_version(v_text), parse_version(f_text)
        if v is not None and v[2] is not None and v[:2] != branch:
            continue  # introduced by a backport into another branch
        if f is not None and f[2] is not None and f[:2] == branch:
            in_branch.append((v, f, f_text))
        elif f is None and v is not None and v[2] is not None:
            in_branch.append((v, None, None))  # introduced in this branch, never fixed here
        else:
            others.append((v, f, f_text))
    if in_branch:
        for v, f, f_text in in_branch:
            if starts_before(v) and (f is None or kernel[2] < f[2]):
                return (f_text, f is not None)
        return None
    # No pair for this branch: affected if the bug predates it and the fix came later
    best = None
    for v, f, f_text in others:
        if not starts_before(v):
            continue
        if f is None:
            return (None, False)
        if f[2] is None and f[:2] <= branch:
            continue  # fixed before the branch was made
        if f[2] is not None and f[:2] < branch:
            continue  # a fix in an older stable branch says nothing about this one
        key = (f[0], f[1], -1 if f[2] is None else f[2])
        if best is None or key < best[0]:
            best = (key, f_text)
    return (best[1], False) if best else None


# ----- CVSS 3.x base score -----

WEIGHTS = {"AV": {"N": 0.85, "A": 0.62, "L": 0.55, "P": 0.2}, "AC": {"L": 0.77, "H": 0.44},
           "UI": {"N": 0.85, "R": 0.62}, "CIA": {"H": 0.56, "L": 0.22, "N": 0.0}}


def roundup(x):
    i = round(x * 100000)
    return i / 100000.0 if i % 10000 == 0 else (math.floor(i / 10000) + 1) / 10.0


def cvss_score(vector):
    try:
        if not vector.startswith("CVSS:3."):
            return None
        m = dict(p.split(":", 1) for p in vector.split("/")[1:])
        changed = m["S"] == "C"
        pr = {"N": 0.85, "L": 0.68 if changed else 0.62, "H": 0.5 if changed else 0.27}[m["PR"]]
        iss = 1 - math.prod(1 - WEIGHTS["CIA"][m[k]] for k in ("C", "I", "A"))
        impact = 7.52 * (iss - 0.029) - 3.25 * (iss - 0.02) ** 15 if changed else 6.42 * iss
        exploit = 8.22 * WEIGHTS["AV"][m["AV"]] * WEIGHTS["AC"][m["AC"]] * pr * WEIGHTS["UI"][m["UI"]]
        if impact <= 0:
            return 0.0
        total = impact + exploit
        return roundup(min(1.08 * total if changed else total, 10))
    except (KeyError, ValueError):
        return None


# ----- records -----

def read_record(base):
    """(pairs, vector or None, title, program files, fix commit ids) of one CVE, or None if
    unreadable."""
    fixes = set()
    fix_versions = {}
    try:
        with open(base + ".dyad", encoding="utf-8") as f:
            pairs = []
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split(":")
                if len(parts) == 4:
                    pairs.append((parts[0], parts[2]))
                    if re.fullmatch(r"[0-9a-f]{40}", parts[3]):
                        fixes.add(parts[3])
                        fix_versions[parts[3]] = parts[2]
    except OSError:
        return None
    vector = None
    try:
        with open(base + ".cvss", encoding="utf-8") as f:
            for token in f.readline().split():
                if token.startswith("CVSS:"):
                    vector = token
    except OSError:
        pass
    title, files = "", set()
    try:
        with open(base + ".json", encoding="utf-8") as f:
            cna = json.load(f)["containers"]["cna"]
        title = cna.get("title") or ""
        for a in cna.get("affected", []):
            files.update(a.get("programFiles", []))
    except (OSError, ValueError, KeyError):
        pass
    return pairs, vector, title, sorted(files), fixes, fix_versions


def read_commits(path):
    """The commit ids of a kernel's history, or None without a list."""
    try:
        with open(path, encoding="utf-8") as f:
            return {line.strip() for line in f if re.fullmatch(r"[0-9a-f]{40}", line.strip())}
    except OSError:
        return None


def read_manifest(path):
    with open(path, encoding="utf-8") as f:
        files = {line.strip() for line in f if line.strip() and not line.startswith("#")}
    return files, {os.path.dirname(p) for p in files}


def in_built_code(files, manifest):
    built, dirs = manifest
    if not files:
        return True
    sources = [p for p in files if not p.endswith(".h")]
    if sources:
        # A fix that touches code decides by that code; the headers it changes along with it
        # (include/linux/ism.h next to drivers/s390/net/ism_drv.c) belong to the same code
        return any(p in built for p in sources)
    for p in files:
        if p.endswith(".h"):
            # A header is part of the kernel when anything built includes it; known for sure
            # only for the shared include trees, otherwise by a built file next to it
            if p.startswith("include/") or "/include/" in p or os.path.dirname(p) in dirs:
                return True
    return False


def kernel_of(release):
    v = parse_version(release)
    return v if v and v[2] is not None else None


def generate(repo, manifests, out):
    commit = subprocess.run(["git", "-C", repo, "rev-parse", "HEAD"], capture_output=True,
                            text=True, check=True).stdout.strip()
    kernels = {}
    for name in sorted(os.listdir(manifests)):
        if not name.endswith(".files"):
            continue
        release = name[:-len(".files")]
        k = kernel_of(release)
        if k is None:
            print(f"plinius-kernel-cves: {name}: no kernel version in the name, skipped", file=sys.stderr)
            continue
        commits = read_commits(os.path.join(manifests, release + ".commits"))
        missing = read_commits(os.path.join(manifests, release + ".missing")) or set()
        kernels[release] = (k, read_manifest(os.path.join(manifests, name)), commits, missing, [],
                            [0, 0, 0], [])
    if not kernels:
        print("plinius-kernel-cves: no manifests", file=sys.stderr)
        return 1

    published = os.path.join(repo, "cve", "published")
    for year in sorted(os.listdir(published)):
        ydir = os.path.join(published, year)
        if not os.path.isdir(ydir):
            continue
        for name in sorted(os.listdir(ydir)):
            if not name.endswith(".dyad"):
                continue
            cve = name[:-len(".dyad")]
            record = read_record(os.path.join(ydir, cve))
            if record is None:
                continue
            pairs, vector, title, files, fixes, fix_versions = record
            for k, manifest, commits, missing, issues, counts, in_tree in kernels.values():
                hit = affected(pairs, k)
                not_taken = fixes & missing
                if hit is None and not_taken:
                    # fixed by version, but the fixing commit's change is not in the tree
                    v = sorted(fix_versions[c] for c in not_taken)[0]
                    hit = (v + " (not taken)", True)
                if hit is None:
                    continue
                if commits and (fixes - missing) & commits and not not_taken:
                    counts[2] += 1
                    in_tree.append(cve)
                    continue
                counts[0] += 1
                if not in_built_code(files, manifest):
                    continue
                counts[1] += 1
                issues.append({"cve": cve, "title": title, "fixed": hit[0], "branch_fixed": hit[1],
                               "cvss": vector, "score": cvss_score(vector) if vector else None})

    os.makedirs(out, exist_ok=True)
    now = int(time.time())
    for release, (k, _, commits, missing, issues, counts, in_tree) in kernels.items():
        data = {"version": 1, "generated": now, "source": VULNS_URL, "commit": commit,
                "release": release, "kernel": "%d.%d.%d" % k,
                "counts": {"affected": counts[0], "built": counts[1]}, "issues": issues}
        if commits is not None:
            data["counts"]["fixed_in_tree"] = counts[2]
            data["fixed_in_tree"] = in_tree
        fd, tmp = tempfile.mkstemp(dir=out, prefix=".kernel-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
        os.chmod(tmp, 0o644)
        os.replace(tmp, os.path.join(out, release + ".json"))
        print(f"plinius-kernel-cves: {release}: {counts[0]} CVEs for {data['kernel']}, "
              f"{counts[1]} in built code, {counts[2]} fixed in the tree (vulns {commit[:12]})")
    return 0


def fetch(repo):
    """Brings the shallow clone of the CNA repository to the newest commit."""
    if not os.path.isdir(os.path.join(repo, ".git")):
        subprocess.run(["git", "clone", "-q", "--depth", "1", VULNS_URL, repo], check=True)
        return
    subprocess.run(["git", "-C", repo, "fetch", "-q", "--depth", "1", "origin", "master"], check=True)
    subprocess.run(["git", "-C", repo, "reset", "-q", "--hard", "FETCH_HEAD"], check=True)
    # Each shallow fetch leaves the previous tree behind; keep the clone at one commit
    subprocess.run(["git", "-C", repo, "reflog", "expire", "--expire=now", "--all"], check=True)
    subprocess.run(["git", "-C", repo, "gc", "-q", "--prune=now"], check=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--fetch", action="store_true", help="update the CNA repository first")
    ap.add_argument("repo")
    ap.add_argument("manifests")
    ap.add_argument("out")
    args = ap.parse_args()
    if args.fetch:
        fetch(args.repo)
    return generate(args.repo, args.manifests, args.out)


if __name__ == "__main__":
    sys.exit(main())
